{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unstaticlabs.com/schemas/agent/qa-environment-v1.schema.json",
  "title": "USL worktree QA environment status v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "identifier", "worktree", "branch", "head_sha", "compose_project", "profile", "database", "health", "ownership", "urls", "authentication", "isolation", "cleanup"],
  "properties": {
    "schema": {"const": "usl-qa-environment/v1"},
    "identifier": {"type": "string", "minLength": 1},
    "worktree": {"type": "string", "minLength": 1},
    "branch": {"type": "string", "minLength": 1},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "compose_project": {"type": "string", "pattern": "^usl-odoo-qa-[0-9a-f]{8}$"},
    "profile": {"type": ["string", "null"]},
    "database": {"const": "odoo_dev"},
    "health": {"enum": ["ready", "partial", "stopped", "absent", "unavailable"]},
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "owners"],
      "properties": {
        "state": {"enum": ["unused", "owned", "foreign", "mixed", "unavailable"]},
        "owners": {"$ref": "#/$defs/string_list"}
      }
    },
    "urls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_odoo", "local_documents", "remote_https"],
      "properties": {
        "local_odoo": {"type": "string", "minLength": 1},
        "local_documents": {"type": "string", "minLength": 1},
        "remote_https": {"type": ["string", "null"]}
      }
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "login_command", "secrets_in_output"],
      "properties": {
        "provider": {"const": "Pocket ID QA tenant"},
        "login_command": {"type": "string", "minLength": 1},
        "secrets_in_output": {"const": false}
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["database", "filestore", "compose_project", "shared_seed_read_only"],
      "properties": {
        "database": {"const": true},
        "filestore": {"const": true},
        "compose_project": {"const": true},
        "shared_seed_read_only": {"const": true}
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "command"],
      "properties": {
        "owner": {"const": "Lead Developer after merge and CI"},
        "command": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "string_list": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  }
}
