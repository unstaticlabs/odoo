{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unstaticlabs.com/schemas/agent/feature-handoff-v1.schema.json",
  "title": "USL Feature Developer handoff v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "feature",
    "goal",
    "changes",
    "decisions",
    "migration",
    "verification",
    "qa",
    "resources",
    "integration",
    "known_issues",
    "unverified_assumptions",
    "release",
    "readiness"
  ],
  "properties": {
    "schema": {"const": "usl-feature-handoff/v1"},
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "branch", "base", "base_sha", "head_sha", "worktree", "developer_github_login", "pull_request", "product_task"],
      "properties": {
        "identifier": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "branch": {"type": "string", "minLength": 1},
        "base": {"type": "string", "minLength": 1},
        "base_sha": {"$ref": "#/$defs/sha"},
        "head_sha": {"$ref": "#/$defs/sha"},
        "worktree": {"type": "string", "minLength": 1},
        "developer_github_login": {"type": ["string", "null"]},
        "pull_request": {"type": ["string", "null"]},
        "product_task": {"type": ["string", "null"]}
      }
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "acceptance"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "acceptance": {"$ref": "#/$defs/nonempty_string_list"}
      }
    },
    "changes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modules", "paths", "user_facing", "database_schema_changed", "configuration_changed", "dependencies_changed"],
      "properties": {
        "modules": {"$ref": "#/$defs/string_list"},
        "paths": {"$ref": "#/$defs/string_list"},
        "user_facing": {"type": "boolean"},
        "database_schema_changed": {"type": "boolean"},
        "configuration_changed": {"type": "boolean"},
        "dependencies_changed": {"type": "boolean"}
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision", "alternatives", "rationale"],
        "properties": {
          "decision": {"type": "string", "minLength": 1},
          "alternatives": {"$ref": "#/$defs/alternatives"},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "modules_to_upgrade", "forward", "recovery", "data_loss_risk", "irreversible"],
      "properties": {
        "required": {"type": "boolean"},
        "modules_to_upgrade": {"$ref": "#/$defs/string_list"},
        "forward": {"$ref": "#/$defs/string_list"},
        "recovery": {"$ref": "#/$defs/string_list"},
        "data_loss_risk": {"enum": ["none", "low", "medium", "high"]},
        "irreversible": {"type": "boolean"}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automated", "manual"],
      "properties": {
        "automated": {"type": "array", "items": {"$ref": "#/$defs/check"}},
        "manual": {"type": "array", "items": {"$ref": "#/$defs/journey"}}
      }
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "profile", "status", "url", "environment", "authentication"],
      "properties": {
        "required": {"type": "boolean"},
        "profile": {"type": ["string", "null"]},
        "status": {"enum": ["not-required", "not-run", "ready", "failed", "blocked"]},
        "url": {"type": ["string", "null"]},
        "environment": {"type": ["string", "null"]},
        "authentication": {"type": ["string", "null"]}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preserved", "removed", "cleanup"],
      "properties": {
        "preserved": {"$ref": "#/$defs/string_list"},
        "removed": {"$ref": "#/$defs/string_list"},
        "cleanup": {"$ref": "#/$defs/string_list"}
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concerns", "overlaps", "documentation"],
      "properties": {
        "concerns": {"$ref": "#/$defs/string_list"},
        "overlaps": {"$ref": "#/$defs/string_list"},
        "documentation": {"$ref": "#/$defs/string_list"}
      }
    },
    "known_issues": {"$ref": "#/$defs/string_list"},
    "unverified_assumptions": {"$ref": "#/$defs/string_list"},
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["special_steps", "rollback_notes", "post_merge_checks"],
      "properties": {
        "special_steps": {"$ref": "#/$defs/string_list"},
        "rollback_notes": {"$ref": "#/$defs/string_list"},
        "post_merge_checks": {"$ref": "#/$defs/string_list"}
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "rationale", "blockers"],
      "properties": {
        "status": {"enum": ["READY TO MERGE", "READY TO MERGE WITH DOCUMENTED FOLLOW-UP", "NOT READY TO MERGE"]},
        "rationale": {"type": "string", "minLength": 1},
        "blockers": {"$ref": "#/$defs/string_list"}
      }
    }
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "string_list": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "nonempty_string_list": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "alternatives": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "result", "notes"],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "result": {"enum": ["passed", "failed", "blocked", "not-run"]},
        "notes": {"type": "string"}
      }
    },
    "journey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["journey", "result", "evidence", "notes"],
      "properties": {
        "journey": {"type": "string", "minLength": 1},
        "result": {"enum": ["passed", "failed", "blocked", "not-run"]},
        "evidence": {"$ref": "#/$defs/string_list"},
        "notes": {"type": "string"}
      }
    }
  }
}
