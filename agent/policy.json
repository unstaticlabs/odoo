{
  "schema": "usl-agent-policy/v1",
  "development_branch": "19-usl",
  "workflow_phase": "migration-transition",
  "branch_prefixes": [
    "codex/",
    "feat/",
    "fix/",
    "chore/"
  ],
  "enforcement": {
    "branch_worktree": "advisory",
    "commit_attribution": "advisory"
  },
  "github": {
    "repository": "unstaticlabs/odoo",
    "agent_login": "elio-usl",
    "credential_transport": "isolated-https",
    "merge_queue": {
      "ruleset": "USL Distribution",
      "required_status_checks": [],
      "check_response_timeout_minutes": 120,
      "grouping_strategy": "ALLGREEN",
      "max_entries_to_build": 2,
      "max_entries_to_merge": 1,
      "merge_method": "MERGE",
      "min_entries_to_merge": 1,
      "min_entries_to_merge_wait_minutes": 0
    }
  },
  "qa": {
    "compose_project_prefix": "usl-odoo-qa-",
    "database": "odoo_dev",
    "default_profile": "full",
    "remote_https": false
  },
  "production": {
    "deployment_owner": "ci",
    "continuous_deployment_enabled": false,
    "transition_runbook_exception": "The governed one-off production cutover remains a human-authorized operations procedure until admission."
  }
}
