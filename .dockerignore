# Docker images are self-contained for deployment, but only the paths copied by
# Dockerfile belong in the build context. Private dumps, filestores and
# repository metadata must never be transferred to the builder. Custom add-ons,
# OCA add-ons and user docs enter the context only for the product stage; the
# dev/test stages keep using Compose bind mounts.
*

!.dockerignore
!Dockerfile
!MANIFEST.in
!odoo-bin
!requirements.txt
!setup.py
!scripts/
scripts/*
!scripts/cohort-runtime
!operations/
!operations/**

!addons/
!addons/**
!debian/
!debian/odoo.conf
!docker/
!docker/**
!deploy/
deploy/*
!deploy/documents/
deploy/documents/*
!deploy/documents/paperless-ngx/
!deploy/documents/paperless-ngx/**
!odoo/
!odoo/**
!setup/
!setup/**

# Product-stage payloads. usl_bootstrap is a test-only fixture and must never
# ship in a product image; OCA vendor checkouts enter without their Git state.
!custom-addons/
!custom-addons/**
!docs/
docs/*
!docs/users/
!docs/users/**
!oca-addons/
!oca-addons/**
!oca-src/
!oca-src/**
oca-src/**/.git
oca-src/**/.git/**
!services/
!services/usl-sign-dss/
!services/usl-sign-dss/**

# Translation catalogs. The distribution activates only English and French
# (custom-addons/usl_locale), so only the .pot templates and the en*, fr and
# fr_* catalogs enter the image. Odoo reads <module>/i18n/<lang>.po and
# <module>/i18n_extra/<lang>.po when a language is activated; a language
# without a catalog stays untranslated until the image is rebuilt with its
# .po files.
**/i18n/*.po
!**/i18n/en*.po
!**/i18n/fr.po
!**/i18n/fr_*.po
**/i18n_extra/*.po
!**/i18n_extra/en*.po
!**/i18n_extra/fr.po
!**/i18n_extra/fr_*.po

# usl_bootstrap is a test-only fixture. Keep this rule last so that no later
# exception adds one of its files back.
custom-addons/usl_bootstrap/
