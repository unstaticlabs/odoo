{
  "name": "Odoo 19 Community",
  "dockerComposeFile": [
    "../compose.yaml"
  ],
  "service": "devcontainer",
  "runServices": [
    "db",
    "devcontainer"
  ],
  "workspaceFolder": "/workspace/odoo",
  "remoteUser": "odoo",
  "overrideCommand": false,
  "shutdownAction": "stopCompose",
  "forwardPorts": [
    8069,
    8072
  ],
  "portsAttributes": {
    "8069": {
      "label": "Odoo HTTP",
      "onAutoForward": "notify"
    },
    "8072": {
      "label": "Odoo gevent/websocket"
    }
  },
  "containerEnv": {
    "PYTHONPATH": "/workspace/odoo"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.debugpy",
        "charliermarsh.ruff",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-xml",
        "tamasfe.even-better-toml"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.unittestEnabled": false,
        "ruff.nativeServer": "on",
        "ruff.configuration": "/workspace/odoo/ruff.toml",
        "editor.formatOnSave": false
      }
    }
  },
  "postCreateCommand": "mkdir -p custom-addons && odoo --version && python --version && ruff --version"
}
