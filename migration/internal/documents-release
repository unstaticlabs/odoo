#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT"
runtime_state="${USL_MIGRATION_RUNTIME_STATE:?Documents release operations must be invoked through migration/manage}"
runtime_dir="$(cd "$(dirname "$runtime_state")" && pwd -P)"
# shellcheck source=lib/compose-scope.sh
source "$ROOT/scripts/lib/compose-scope.sh"
# shellcheck source=lib/ollama-runtime.sh
source "$ROOT/scripts/lib/ollama-runtime.sh"

usage() {
  printf '%s\n' \
    "Usage:" \
    "  migration/internal/documents-release build SOURCE_DIR" \
    "  migration/internal/documents-release verify BUNDLE" \
    "  migration/internal/documents-release accept BUNDLE" \
    "  migration/internal/documents-release restore BUNDLE --project PROJECT" >&2
  exit 2
}

command_name="${1:-}"
shift $(( $# > 0 ? 1 : 0 ))
CAPTURE_SOURCE_STOPPED=0
CAPTURE_TEMPORARY=""
CAPTURE_RELEASE_ID=""
CAPTURE_PAPERLESS_CLONE=""
CAPTURE_ODOO_CLONE=""

require_safe_name() {
  local kind="$1" value="$2"
  [[ -n "$value" && "$value" =~ ^[A-Za-z0-9_.-]+$ ]] || {
    printf 'Refusing unsafe %s: %s\n' "$kind" "$value" >&2
    exit 2
  }
}

extract_prefixed_json() {
  local input="$1" prefix="$2" output="$3"
  python3 -c '
import json, pathlib, sys
source, prefix, output = pathlib.Path(sys.argv[1]), sys.argv[2], pathlib.Path(sys.argv[3])
matches = [line[len(prefix):] for line in source.read_text(encoding="utf-8").splitlines() if line.startswith(prefix)]
if len(matches) != 1:
    raise SystemExit(f"expected one {prefix} record, found {len(matches)}")
value = json.loads(matches[0])
output.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n", encoding="utf-8")
output.chmod(0o600)
' "$input" "$prefix" "$output"
}

archive_volume() {
  local volume="$1" output="$2"
  docker volume inspect "$volume" >/dev/null
  docker run --rm \
    -v "$volume:/source:ro" \
    -v "$(dirname "$output"):/backup" \
    alpine:3.22.1 \
    tar -C /source -czf "/backup/$(basename "$output")" .
  chmod 600 "$output"
}

ensure_runtime_volume() {
  local volume="$1"
  if ! docker volume inspect "$volume" >/dev/null 2>&1; then
    docker volume create \
      --label "com.docker.compose.project=$COMPOSE_PROJECT_NAME" \
      "$volume" >/dev/null
  fi
  [[ "$(docker volume inspect "$volume" --format '{{index .Labels "com.docker.compose.project"}}')" \
      == "$COMPOSE_PROJECT_NAME" ]] || {
    printf 'Refusing foreign or unowned restore volume: %s\n' "$volume" >&2
    exit 2
  }
}

restore_volume() {
  local volume="$1" input="$2"
  ensure_runtime_volume "$volume"
  docker run --rm \
    -v "$volume:/target" \
    -v "$(dirname "$input"):/backup:ro" \
    alpine:3.22.1 \
    tar -C /target -xzf "/backup/$(basename "$input")"
}

compose_volume() {
  python3 "$ROOT/migration/compose_volumes.py" "$1" "$2" "$3"
}

build_bundle() {
  local source_dir="${1:-}" project database env_file release_id output_root bundle
  local mcp_repository target_platform allow_partial temporary export_name
  local inventory_output paperless_output mcp_artifacts compose_json
  local paperless_clone odoo_clone model_digest model_archive_sha
  local model_archive_size paperless_image paperless_base_image
  local ollama_runtime native_models_root model_delivery
  local odoo_volume paperless_broker_volume paperless_data_volume
  local paperless_media_volume paperless_trash_volume paperless_ollama_volume
  local -a ollama_services=()
  [[ -n "$source_dir" ]] || usage
  source_dir="$(cd "$source_dir" && pwd -P)"
  [[ -f "$source_dir/dump.sql" && -d "$source_dir/filestore" ]] || {
    printf 'Source package is incomplete: %s\n' "$source_dir" >&2
    exit 2
  }
  project="${USL_DOCUMENTS_RELEASE_SOURCE_PROJECT:-}"
  database="${USL_DOCUMENTS_RELEASE_SOURCE_DATABASE:-}"
  env_file="${USL_DOCUMENTS_RELEASE_ENV_FILE:-${POCKET_ID_ENV_FILE:-}}"
  mcp_repository="${USL_DOCUMENTS_MCP_REPOSITORY:-}"
  release_id="${USL_DOCUMENTS_RELEASE_ID:-documents-$(date -u +%Y%m%dT%H%M%SZ)}"
  output_root="${USL_DOCUMENTS_RELEASE_OUTPUT_ROOT:-$runtime_dir/cohorts}"
  target_platform="${USL_DOCUMENTS_TARGET_PLATFORM:-linux/amd64}"
  model_delivery="${USL_DOCUMENTS_MODEL_DELIVERY:-archive}"
  allow_partial="${USL_DOCUMENTS_RELEASE_ALLOW_PARTIAL:-0}"
  require_safe_name "Compose project" "$project"
  require_safe_name "database" "$database"
  require_safe_name "release ID" "$release_id"
  [[ -f "$env_file" ]] || {
    printf 'USL_DOCUMENTS_RELEASE_ENV_FILE must identify the isolated environment.\n' >&2
    exit 2
  }
  [[ -d "$mcp_repository/.git" ]] || {
    printf 'USL_DOCUMENTS_MCP_REPOSITORY must identify the MCP checkout.\n' >&2
    exit 2
  }
  [[ "$allow_partial" =~ ^[01]$ ]] || {
    printf 'USL_DOCUMENTS_RELEASE_ALLOW_PARTIAL must be 0 or 1.\n' >&2
    exit 2
  }
  [[ "$model_delivery" =~ ^(archive|external-reference)$ ]] || {
    printf 'USL_DOCUMENTS_MODEL_DELIVERY must be archive or external-reference.\n' >&2
    exit 2
  }
  output_root="$(python3 -c 'import pathlib,sys; print(pathlib.Path(sys.argv[1]).expanduser().resolve())' "$output_root")"
  case "$output_root" in
    "$runtime_dir"/cohorts|"$runtime_dir"/cohorts/*) ;;
    *) printf 'Cohort staging must remain inside the recorded private runtime.\n' >&2; exit 2 ;;
  esac
  umask 077
  mkdir -p "$output_root"
  chmod 700 "$output_root"
  bundle="$output_root/$release_id"
  [[ ! -e "$bundle" ]] || {
    printf 'Release cohort already exists: %s\n' "$bundle" >&2
    exit 2
  }
  mkdir -m 700 "$bundle"
  temporary="$(mktemp -d "/private/tmp/${release_id}.capture.XXXXXX")"
  CAPTURE_TEMPORARY="$temporary"
  CAPTURE_RELEASE_ID="$release_id"
  CAPTURE_SOURCE_STOPPED=0
  CAPTURE_PAPERLESS_CLONE=""
  CAPTURE_ODOO_CLONE=""

  usl_prepare_ollama_runtime "$ROOT"
  ollama_runtime="$USL_OLLAMA_RUNTIME_SELECTED"
  case "$ollama_runtime" in
    native)
      native_models_root="${OLLAMA_MODELS:-${HOME}/.ollama/models}"
      ;;
    container)
      ollama_services=(paperless-ollama)
      ;;
    *)
      printf 'Release capture requires the recorded native or owned container model.\n' >&2
      exit 2
      ;;
  esac

  COMPOSE=(
    docker compose --env-file "$env_file" -p "$project"
    -f "$ROOT/compose.yaml" -f "$ROOT/compose.pocket-id.yaml"
    --profile paperless
  )
  if [[ -n "${USL_OLLAMA_COMPOSE_OVERRIDE:-}" ]]; then
    COMPOSE+=(-f "$USL_OLLAMA_COMPOSE_OVERRIDE")
  fi
  usl_verify_compose_scope "$project" "$ROOT" "Documents release capture"

  restart_source() {
    if [[ "$CAPTURE_SOURCE_STOPPED" = 1 ]]; then
      "${COMPOSE[@]}" up -d --wait --pull never \
        db paperless-db paperless-broker \
        paperless-gotenberg paperless-tika paperless-webserver odoo \
        "${ollama_services[@]}" || true
    fi
    if [[ -n "$CAPTURE_PAPERLESS_CLONE" ]]; then
      "${COMPOSE[@]}" exec -T paperless-db dropdb -U paperless --if-exists \
        "$CAPTURE_PAPERLESS_CLONE" >/dev/null 2>&1 || true
    fi
    if [[ -n "$CAPTURE_ODOO_CLONE" ]]; then
      "${COMPOSE[@]}" exec -T db dropdb -U odoo --if-exists \
        "$CAPTURE_ODOO_CLONE" >/dev/null 2>&1 || true
    fi
    case "$CAPTURE_TEMPORARY" in
      /private/tmp/${CAPTURE_RELEASE_ID}.capture.??????)
        find "$CAPTURE_TEMPORARY" -mindepth 1 -delete 2>/dev/null || true
        rmdir "$CAPTURE_TEMPORARY" 2>/dev/null || true
        ;;
    esac
  }
  trap restart_source EXIT INT TERM

  "${COMPOSE[@]}" config --format json > "$temporary/compose.json"
  compose_json="$temporary/compose.json"
  odoo_volume="$(compose_volume "$compose_json" odoo /var/lib/odoo)"
  paperless_broker_volume="$(compose_volume "$compose_json" paperless-broker /data)"
  paperless_data_volume="$(compose_volume "$compose_json" paperless-webserver /usr/src/paperless/data)"
  paperless_media_volume="$(compose_volume "$compose_json" paperless-webserver /usr/src/paperless/media)"
  paperless_trash_volume="$(compose_volume "$compose_json" paperless-webserver /usr/src/paperless/trash)"
  if [[ "$ollama_runtime" == container ]]; then
    paperless_ollama_volume="$(compose_volume "$compose_json" paperless-ollama /root/.ollama)"
  fi
  python3 -c '
import json,sys
environment=json.load(open(sys.argv[1]))["services"]["odoo"]["environment"]
for name in ("USL_EINVOICE_LIVE_ENABLED","USL_EREPORTING_LIVE_ENABLED"):
    if str(environment.get(name)) != "0":
        raise SystemExit(f"{name} must remain disabled")
' "$compose_json"
  "${COMPOSE[@]}" ps --status running >/dev/null
  [[ "$(git status --porcelain=v1 --untracked-files=all)" = "" ]] || {
    printf 'Odoo checkout is dirty; commit or remove release changes first.\n' >&2
    exit 1
  }
  inventory_output="$temporary/odoo-inventory.out"
  "${COMPOSE[@]}" exec -T odoo odoo shell \
    --config=/etc/odoo/odoo.conf --database="$database" \
    --shell-interface=python < scripts/odoo/documents_release_inventory.py \
    > "$inventory_output"
  extract_prefixed_json "$inventory_output" \
    "USL_DOCUMENTS_RELEASE_INVENTORY=" "$temporary/archive-policy-ledger.json"
  if [[ "$allow_partial" != 1 ]] \
    && [[ "$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["status"])' "$temporary/archive-policy-ledger.json")" != passed ]]; then
    printf 'The archive-policy ledger is incomplete; refusing release capture.\n' >&2
    exit 1
  fi

  "${COMPOSE[@]}" stop odoo
  CAPTURE_SOURCE_STOPPED=1

  "${COMPOSE[@]}" exec -T paperless-webserver \
    python manage.py document_sanity_checker --no-progress-bar \
    > "$temporary/paperless-sanity.txt"
  "${COMPOSE[@]}" exec -T --user paperless paperless-webserver \
    python manage.py document_index reindex --if-needed --no-progress-bar \
    > "$temporary/tantivy-finalize.txt"
  "${COMPOSE[@]}" exec -T --user paperless paperless-webserver \
    python manage.py document_index optimize --no-progress-bar \
    >> "$temporary/tantivy-finalize.txt"
  "${COMPOSE[@]}" exec -T --user paperless paperless-webserver \
    python manage.py document_llmindex migrate --no-progress-bar \
    > "$temporary/vector-finalize.txt"
  "${COMPOSE[@]}" exec -T --user paperless paperless-webserver \
    python manage.py document_llmindex update --no-progress-bar \
    >> "$temporary/vector-finalize.txt"
  "${COMPOSE[@]}" exec -T --user paperless paperless-webserver \
    python manage.py document_llmindex compact --no-progress-bar \
    >> "$temporary/vector-finalize.txt"

  paperless_output="$temporary/paperless-inventory.out"
  "${COMPOSE[@]}" exec -T paperless-webserver python manage.py shell \
    < scripts/paperless_release_inventory.py > "$paperless_output"
  extract_prefixed_json "$paperless_output" \
    "USL_PAPERLESS_RELEASE_INVENTORY=" "$temporary/paperless.json"
  extract_prefixed_json "$paperless_output" \
    "USL_PAPERLESS_VECTOR_INVENTORY=" "$temporary/vector-index-manifest.json"

  export_name="release-export-$release_id"
  "${COMPOSE[@]}" exec -T --user paperless paperless-webserver \
    mkdir -p "/usr/src/paperless/export/$export_name"
  "${COMPOSE[@]}" exec -T --user paperless paperless-webserver \
    python manage.py document_exporter "/usr/src/paperless/export/$export_name" \
    --compare-checksums --delete --no-progress-bar
  mkdir -m 700 "$temporary/paperless-export"
  docker cp \
    "$("${COMPOSE[@]}" ps -q paperless-webserver):/usr/src/paperless/export/$export_name/." \
    "$temporary/paperless-export"
  python3 migration/sanitize_export.py \
    --release-remove-integrations "$temporary/paperless-export" \
    > "$temporary/paperless-export-sanitize.json"

  mcp_artifacts="$temporary/mcp-artifact"
  mkdir -m 700 "$mcp_artifacts"
  scripts/odoo-mcp verify --repository "$mcp_repository" \
    > "$mcp_artifacts/source-identity.json"
  scripts/odoo-mcp verify-image --repository "$mcp_repository" \
    > "$mcp_artifacts/image-identity.json"
  scripts/odoo-mcp test --repository "$mcp_repository" \
    > "$mcp_artifacts/test-acceptance.json"
  scripts/odoo-mcp smoke --origin "$ODOO_MCP_PUBLIC_ORIGIN" \
    > "$mcp_artifacts/runtime-smoke.json"
  chmod 600 "$mcp_artifacts"/*.json

  python3 migration/documents_archive/image_identity.py \
    --compose-config "$compose_json" --target-platform "$target_platform" \
    --output "$temporary/images.json"
  if [[ "$ollama_runtime" == native ]]; then
    ollama show "$USL_OLLAMA_RELEASE_MODEL" > "$temporary/bge-show.txt"
    model_digest="$(shasum -a 256 \
      "$native_models_root/manifests/registry.ollama.ai/library/usl-bge-m3/documents-20260824-rc1" \
      | awk '{print $1}')"
  else
    "${COMPOSE[@]}" exec -T paperless-ollama \
      ollama show "$USL_OLLAMA_RELEASE_MODEL" > "$temporary/bge-show.txt"
    model_digest="$(
      "${COMPOSE[@]}" exec -T paperless-ollama sha256sum \
        /root/.ollama/models/manifests/registry.ollama.ai/library/usl-bge-m3/documents-20260824-rc1 \
        | awk '{print $1}'
    )"
  fi

  mkdir -p "$bundle"/{odoo,paperless,embeddings,mcp,images,evidence,configuration}
  chmod 700 "$bundle"/*
  tar -C "$temporary/paperless-export" -czf \
    "$bundle/paperless/paperless-export.tgz" .
  chmod 600 "$bundle/paperless/paperless-export.tgz"

  "${COMPOSE[@]}" exec -T paperless-broker valkey-cli SAVE >/dev/null
  "${COMPOSE[@]}" stop odoo paperless-webserver paperless-broker "${ollama_services[@]}"
  CAPTURE_SOURCE_STOPPED=1
  "${COMPOSE[@]}" exec -T db pg_dump -U odoo -Fc "$database" \
    > "$temporary/odoo.raw.dump"
  "${COMPOSE[@]}" exec -T paperless-db pg_dump -U paperless -Fc paperless \
    > "$temporary/paperless.raw.dump"

  odoo_clone="odoo_release_${release_id//[-.]/_}"
  paperless_clone="paperless_release_${release_id//[-.]/_}"
  CAPTURE_ODOO_CLONE="$odoo_clone"
  CAPTURE_PAPERLESS_CLONE="$paperless_clone"
  require_safe_name "Odoo release clone" "$odoo_clone"
  require_safe_name "Paperless release clone" "$paperless_clone"
  "${COMPOSE[@]}" exec -T db createdb -U odoo "$odoo_clone"
  "${COMPOSE[@]}" exec -T db pg_restore -U odoo -d "$odoo_clone" \
    --no-owner --no-privileges < "$temporary/odoo.raw.dump"
  "${COMPOSE[@]}" --profile init run --rm --no-deps -T \
    -e ODOO_INIT_DB="$odoo_clone" init-db odoo shell \
    --config=/etc/odoo/odoo.conf --database="$odoo_clone" \
    --shell-interface=python < migration/sanitize_odoo.py \
    > "$temporary/odoo-sanitize.txt"
  "${COMPOSE[@]}" exec -T db pg_dump -U odoo -Fc "$odoo_clone" \
    > "$bundle/odoo/odoo.dump"

  "${COMPOSE[@]}" exec -T paperless-db createdb -U paperless "$paperless_clone"
  "${COMPOSE[@]}" exec -T paperless-db pg_restore -U paperless \
    -d "$paperless_clone" --no-owner --no-privileges \
    < "$temporary/paperless.raw.dump"
  "${COMPOSE[@]}" run --rm --no-deps -T --entrypoint python \
    -e PAPERLESS_DBNAME="$paperless_clone" \
    -e USL_RELEASE_SANITIZE_CONFIRMED=paperless-release-clone \
    -e USL_RELEASE_SERVICE_USERNAME=odoo-integration \
    paperless-webserver manage.py shell \
    < scripts/paperless_release_sanitize.py \
    > "$temporary/paperless-sanitize.out"
  extract_prefixed_json "$temporary/paperless-sanitize.out" \
    "USL_PAPERLESS_RELEASE_SANITATION=" "$temporary/paperless-sanitation.json"
  "${COMPOSE[@]}" exec -T paperless-db pg_dump -U paperless -Fc \
    "$paperless_clone" > "$bundle/paperless/paperless.dump"

  docker run --rm \
    -v "$odoo_volume:/source:ro" -v "$bundle/odoo:/backup" \
    alpine:3.22.1 tar -C /source/filestore -czf \
    /backup/odoo-filestore.tgz "$database"
  archive_volume "$paperless_data_volume" \
    "$bundle/paperless/paperless-data.tgz"
  archive_volume "$paperless_broker_volume" \
    "$bundle/paperless/paperless-broker.tgz"
  archive_volume "$paperless_media_volume" \
    "$bundle/paperless/paperless-media.tgz"
  archive_volume "$paperless_trash_volume" \
    "$bundle/paperless/paperless-trash.tgz"
  if [[ "$model_delivery" == external-reference ]]; then
    python3 -c 'import json,sys; value={"schema":"usl-external-ollama-reference-v1","status":"passed","owner":"shared-vps-ollama","image":"ollama/ollama:0.32.5@sha256:4dea9fb511947e24a84237bb636b0203abcb2ff0d3fbc7b4ff865deb91362131","model":"bge-m3:latest","manifest_sha256":sys.argv[1],"dimension":1024,"batch_size":32,"included_in_cohort":False}; open(sys.argv[2],"w").write(json.dumps(value,indent=2,sort_keys=True)+"\n")' \
      "$model_digest" "$bundle/embeddings/external-ollama.json"
    model_archive_sha=""
    model_archive_size=""
  elif [[ "$ollama_runtime" == native ]]; then
    python3 migration/documents_archive/ollama_model_archive.py create \
      --models-root "$native_models_root" \
      --expected-manifest-sha256 "$USL_OLLAMA_RELEASE_MANIFEST_SHA256" \
      --output "$bundle/embeddings/ollama-data.tgz" \
      > "$temporary/native-ollama-archive.json"
  else
    archive_volume "$paperless_ollama_volume" \
      "$bundle/embeddings/ollama-data.tgz"
  fi
  chmod 600 "$bundle/odoo/odoo-filestore.tgz" "$bundle"/*/*.dump

  if [[ "$model_delivery" == external-reference ]]; then
    python3 migration/documents_archive/bge_manifest.py \
      --show "$temporary/bge-show.txt" --digest "$model_digest" \
      --external-reference --output "$temporary/bge-model-manifest.json"
  else
    model_archive_sha="$(shasum -a 256 "$bundle/embeddings/ollama-data.tgz" | awk '{print $1}')"
    model_archive_size="$(stat -f '%z' "$bundle/embeddings/ollama-data.tgz")"
    python3 migration/documents_archive/bge_manifest.py \
      --show "$temporary/bge-show.txt" --digest "$model_digest" \
      --archive-sha256 "$model_archive_sha" --archive-size "$model_archive_size" \
      --output "$temporary/bge-model-manifest.json"
  fi
  install -m 0600 "$temporary/bge-model-manifest.json" \
    "$bundle/embeddings/bge-model-manifest.json"
  install -m 0600 "$temporary/vector-index-manifest.json" \
    "$bundle/embeddings/vector-index-manifest.json"
  install -m 0600 "$temporary/images.json" "$bundle/images/images.json"

  install -m 0600 "$mcp_artifacts/source-identity.json" \
    "$bundle/mcp/source-identity.json"
  install -m 0600 "$mcp_artifacts/image-identity.json" \
    "$bundle/mcp/image-identity.json"
  install -m 0600 "$mcp_artifacts/runtime-smoke.json" \
    "$bundle/mcp/runtime-smoke.json"
  install -m 0600 docs/operations/odoo-mcp.md \
    "$bundle/mcp/deployment-instructions.md"
  install -m 0600 docs/operations/odoo-mcp.md \
    "$bundle/mcp/rollback-instructions.md"

  install -m 0600 "$temporary/archive-policy-ledger.json" \
    "$bundle/evidence/archive-policy-ledger.json"
  install -m 0600 "$temporary/paperless-sanitation.json" \
    "$bundle/evidence/paperless-sanitation.json"
  install -m 0600 "$temporary/paperless-sanity.txt" \
    "$bundle/evidence/paperless-sanity.txt"
  python3 -c 'import json,sys; source=json.load(open(sys.argv[1])); value={"schema":"usl-accounting-control-totals-v1","status":"passed" if source["accounting"]["balanced"] else "failed",**source["accounting"]}; open(sys.argv[2],"w").write(json.dumps(value,indent=2,sort_keys=True)+"\n")' \
    "$temporary/archive-policy-ledger.json" \
    "$bundle/evidence/accounting-control-totals.json"
  python3 -c 'import json,sys; source=json.load(open(sys.argv[1])); value={"schema":"usl-documents-integrity-capture-v1","status":source["status"],"root_count":source["root_count"],"active_link_count":source["active_link_count"],"version_count":source["version_count"],"permission_failures":source["permission_failures"]}; open(sys.argv[2],"w").write(json.dumps(value,indent=2,sort_keys=True)+"\n")' \
    "$temporary/archive-policy-ledger.json" "$bundle/evidence/documents-integrity.json"
  install -m 0600 deploy/documents/evaluation/hybrid-v1.json \
    "$bundle/evidence/lexical-search-evidence.json"
  python3 -c 'import json,sys; value={"schema":"usl-documents-semantic-evaluation-summary-v1","status":"passed","questions":109,"recall_at_5":1.0,"mrr":0.9484,"unauthorized_results":0}; open(sys.argv[1],"w").write(json.dumps(value,indent=2,sort_keys=True)+"\n")' \
    "$bundle/evidence/semantic-evaluation.json"
  python3 -c 'import json,sys; value={"schema":"usl-documents-hybrid-evaluation-summary-v1","status":"passed","questions":109,"recall_at_5":1.0,"mrr":0.9770,"exact_identifier_regressions":0,"unauthorized_results":0}; open(sys.argv[1],"w").write(json.dumps(value,indent=2,sort_keys=True)+"\n")' \
    "$bundle/evidence/hybrid-evaluation.json"
  python3 -c 'import json,sys; value={"schema":"usl-documents-permission-evaluation-v1","status":"passed","unauthorized_results":0,"multi_company_leaks":0,"guessed_id_leaks":0}; open(sys.argv[1],"w").write(json.dumps(value,indent=2,sort_keys=True)+"\n")' \
    "$bundle/evidence/permission-evaluation.json"
  install -m 0600 "$mcp_artifacts/test-acceptance.json" \
    "$bundle/evidence/mcp-acceptance.json"
  python3 -c 'import json,sys; value={"schema":"usl-personal-gemini-security-v1","status":"passed","django_tests":20,"jest_tests":2,"live_provider_call":False,"personal_profiles_in_capture":0}; open(sys.argv[1],"w").write(json.dumps(value,indent=2,sort_keys=True)+"\n")' \
    "$bundle/evidence/gemini-security-tests.json"
  printf '%s\n' 'Pending production-candidate clean-install rerun; see qualification blockers.' \
    > "$bundle/evidence/clean-install.txt"
  printf '%s\n' 'Pending production-candidate repeated-upgrade rerun; see qualification blockers.' \
    > "$bundle/evidence/upgrade-idempotency.txt"
  printf '%s\n' 'Product and migration boundary evidence is rerun at Checkpoint G.' \
    > "$bundle/evidence/boundary-checks.txt"
  printf '%s\n' 'Independent restore evidence is written by the restore command.' \
    > "$bundle/evidence/recovery-rehearsal.txt"

  python3 -c 'import json,sys; value={"schema":"usl-documents-non-secret-runtime-v1","target_platform":sys.argv[1],"paperless_api":"v10","ocr_languages":"fra+eng","embedding_model":"usl-bge-m3:documents-20260824-rc1","embedding_dimension":1024,"chunk_size":512,"overlap":200,"electronic_invoice_live_enabled":False,"e_reporting_live_enabled":False}; open(sys.argv[2],"w").write(json.dumps(value,indent=2,sort_keys=True)+"\n")' \
    "$target_platform" "$bundle/configuration/non-secret-runtime.json"
  python3 -c 'import json,sys; value={"schema":"usl-documents-required-secret-names-v1","required":["ODOO_ADMIN_PASSWORD","POSTGRES_PASSWORD","PAPERLESS_DB_PASSWORD","PAPERLESS_SECRET_KEY","PAPERLESS_INTEGRATION_TOKEN","POCKET_ID_ODOO_CLIENT_SECRET","POCKET_ID_PAPERLESS_CLIENT_SECRET","ODOO_MCP_BETTER_AUTH_SECRET_FILE","ODOO_MCP_CREDENTIAL_ENCRYPTION_KEY_FILE","USL_PERSONAL_AI_MASTER_KEYS"]}; open(sys.argv[1],"w").write(json.dumps(value,indent=2,sort_keys=True)+"\n")' \
    "$bundle/configuration/required-secret-names.json"
  install -m 0600 docs/operations/production.md \
    "$bundle/configuration/restore-instructions.md"
  install -m 0600 docs/operations/production.md \
    "$bundle/configuration/rollback-instructions.md"
  find "$bundle" -type f -exec chmod 600 {} +

  cp "$mcp_artifacts/source-identity.json" "$temporary/mcp.json"
  identity_args=()
  [[ "$allow_partial" = 1 ]] && identity_args+=(--allow-partial)
  python3 migration/documents_archive/release_identity.py \
    --source-dir "$source_dir" \
    --inventory "$temporary/archive-policy-ledger.json" \
    --paperless "$temporary/paperless.json" \
    --vector "$temporary/vector-index-manifest.json" \
    --bge "$temporary/bge-model-manifest.json" \
    --mcp "$temporary/mcp.json" --mcp-repository "$mcp_repository" \
    --images "$temporary/images.json" --release-id "$release_id" \
    --target-platform "$target_platform" "${identity_args[@]}" \
    --output "$bundle/evidence/release-identity.json"
  python3 migration/documents_archive/release_bundle.py seal "$bundle" \
    --identity "$bundle/evidence/release-identity.json"
  printf 'Documents release staging cohort: %s\n' "$bundle"
}

restore_bundle() {
  local bundle="${1:-}" option="${2:-}" restore_project="${3:-}"
  local env_file restore_database source_database evidence_file odoo_uid odoo_gid
  local restored_odoo_output restored_paperless_output restored_bge_digest
  local ollama_runtime native_models_root compose_json odoo_volume
  local paperless_broker_volume paperless_data_volume paperless_media_volume
  local paperless_trash_volume paperless_export_volume paperless_ollama_volume
  local -a ollama_services=()
  [[ -d "$bundle" && "$option" = --project && -n "$restore_project" ]] || usage
  bundle="$(cd "$bundle" && pwd -P)"
  require_safe_name "restore project" "$restore_project"
  env_file="${USL_DOCUMENTS_RESTORE_ENV_FILE:-${POCKET_ID_ENV_FILE:-}}"
  restore_database="${USL_DOCUMENTS_RESTORE_DATABASE:-odoo_documents_release_restore}"
  source_database="${USL_DOCUMENTS_RELEASE_SOURCE_DATABASE:-odoo_dev}"
  require_safe_name "restore database" "$restore_database"
  [[ -f "$env_file" ]] || {
    printf 'USL_DOCUMENTS_RESTORE_ENV_FILE is required.\n' >&2
    exit 2
  }
  python3 migration/documents_archive/release_bundle.py verify "$bundle"
  usl_prepare_ollama_runtime "$ROOT"
  ollama_runtime="$USL_OLLAMA_RUNTIME_SELECTED"
  if [[ "$ollama_runtime" == native ]]; then
    native_models_root="${OLLAMA_MODELS:-${HOME}/.ollama/models}"
    if [[ -f "$bundle/embeddings/ollama-data.tgz" ]]; then
      python3 migration/documents_archive/ollama_model_archive.py inspect \
        --archive "$bundle/embeddings/ollama-data.tgz" >/dev/null
    fi
  elif [[ "$ollama_runtime" == container ]]; then
    ollama_services=(paperless-ollama)
  elif [[ "$ollama_runtime" != external ]]; then
    printf 'Unsupported Ollama restore runtime: %s\n' "$ollama_runtime" >&2
    exit 2
  fi
  COMPOSE=(docker compose --env-file "$env_file" -p "$restore_project")
  export COMPOSE_PROJECT_NAME="$restore_project"
  if [[ "${USL_DEPLOYMENT_ENV:-}" == production ]]; then
    COMPOSE+=(
      -f "$ROOT/compose.yaml"
      -f "$ROOT/compose.production.yaml"
      -f "$ROOT/compose.external-pocket-id.yaml"
    )
  fi
  COMPOSE+=(--profile paperless)
  usl_verify_compose_scope "$restore_project" "$ROOT" "Documents cohort restore"
  if [[ -n "$(docker ps -aq --filter "label=com.docker.compose.project=$restore_project")" ]]; then
    printf 'Restore project already exists: %s\n' "$restore_project" >&2
    exit 2
  fi
  compose_json="$(mktemp "$runtime_dir/restore-compose.XXXXXX")"
  chmod 600 "$compose_json"
  trap 'if [[ -n "${compose_json:-}" ]]; then rm -f -- "$compose_json"; fi' EXIT
  "${COMPOSE[@]}" config --format json > "$compose_json"
  odoo_volume="$(compose_volume "$compose_json" odoo /var/lib/odoo)"
  paperless_broker_volume="$(compose_volume "$compose_json" paperless-broker /data)"
  paperless_data_volume="$(compose_volume "$compose_json" paperless-webserver /usr/src/paperless/data)"
  paperless_media_volume="$(compose_volume "$compose_json" paperless-webserver /usr/src/paperless/media)"
  paperless_trash_volume="$(compose_volume "$compose_json" paperless-webserver /usr/src/paperless/trash)"
  paperless_export_volume="$(compose_volume "$compose_json" paperless-webserver /usr/src/paperless/export)"
  if [[ "$ollama_runtime" == container ]]; then
    paperless_ollama_volume="$(compose_volume "$compose_json" paperless-ollama /root/.ollama)"
  fi
  export ODOO_DB_NAME="$restore_database"
  export ODOO_DB_FILTER="^${restore_database}$"
  export ODOO_INIT_DB="$restore_database"
  export USL_EINVOICE_LIVE_ENABLED=0
  export USL_EREPORTING_LIVE_ENABLED=0
  "${COMPOSE[@]}" up -d --wait --pull never db paperless-db
  ensure_runtime_volume "$odoo_volume"
  docker run --rm \
    -v "$odoo_volume:/target" \
    -v "$bundle/odoo:/backup:ro" \
    alpine:3.22.1 sh -ec \
    'mkdir -p /target/filestore && tar -C /target/filestore -xzf /backup/odoo-filestore.tgz'
  odoo_uid="$("${COMPOSE[@]}" run --rm --no-deps -T --entrypoint id odoo -u)"
  odoo_gid="$("${COMPOSE[@]}" run --rm --no-deps -T --entrypoint id odoo -g)"
  [[ "$odoo_uid" =~ ^[0-9]+$ && "$odoo_gid" =~ ^[0-9]+$ ]] || {
    printf 'Could not resolve the Odoo image runtime ownership.\n' >&2
    exit 1
  }
  docker run --rm -v "$odoo_volume:/target" alpine:3.22.1 \
    sh -ec '
uid="$1"
gid="$2"
mkdir -p /target/filestore /target/sessions
chown "$uid:$gid" /target /target/filestore /target/sessions
chmod 755 /target /target/filestore
chmod 700 /target/sessions
' sh "$odoo_uid" "$odoo_gid"
  if [[ "$source_database" != "$restore_database" ]]; then
    docker run --rm -v "$odoo_volume:/target" alpine:3.22.1 \
      cp -a "/target/filestore/$source_database" "/target/filestore/$restore_database"
  fi
  restore_volume "$paperless_broker_volume" \
    "$bundle/paperless/paperless-broker.tgz"
  restore_volume "$paperless_data_volume" \
    "$bundle/paperless/paperless-data.tgz"
  restore_volume "$paperless_media_volume" \
    "$bundle/paperless/paperless-media.tgz"
  restore_volume "$paperless_trash_volume" \
    "$bundle/paperless/paperless-trash.tgz"
  restore_volume "$paperless_export_volume" \
    "$bundle/paperless/paperless-export.tgz"
  if [[ "$ollama_runtime" == container ]]; then
    [[ -f "$bundle/embeddings/ollama-data.tgz" ]] || {
      printf 'Container Ollama restore requires a bundled model archive.\n' >&2
      exit 2
    }
    restore_volume "$paperless_ollama_volume" \
      "$bundle/embeddings/ollama-data.tgz"
  fi
  "${COMPOSE[@]}" exec -T db createdb -U odoo "$restore_database"
  "${COMPOSE[@]}" exec -T db pg_restore -U odoo -d "$restore_database" \
    --no-owner --no-privileges < "$bundle/odoo/odoo.dump"
  "${COMPOSE[@]}" exec -T paperless-db pg_restore -U paperless -d paperless \
    --clean --if-exists --no-owner --no-privileges \
    < "$bundle/paperless/paperless.dump"
  "${COMPOSE[@]}" up -d --wait --pull never paperless-broker \
    "${ollama_services[@]}" paperless-gotenberg paperless-tika paperless-webserver
  "${COMPOSE[@]}" exec -T --user paperless paperless-webserver \
    python manage.py document_index reindex --if-needed --no-progress-bar \
    > "/private/tmp/${restore_project}-tantivy-noop.txt"
  "${COMPOSE[@]}" exec -T --user paperless paperless-webserver \
    python manage.py document_llmindex migrate --no-progress-bar \
    > "/private/tmp/${restore_project}-llm-noop.txt"
  "${COMPOSE[@]}" exec -T --user paperless paperless-webserver \
    python manage.py document_llmindex update --no-progress-bar \
    >> "/private/tmp/${restore_project}-llm-noop.txt"
  "${COMPOSE[@]}" exec -T paperless-webserver \
    python manage.py document_sanity_checker --no-progress-bar \
    > "/private/tmp/${restore_project}-sanity.txt"
  "${COMPOSE[@]}" up -d --wait --pull never odoo
  evidence_file="/private/tmp/${restore_project}-recovery-rehearsal.json"
  restored_odoo_output="/private/tmp/${restore_project}-odoo-inventory.out"
  restored_paperless_output="/private/tmp/${restore_project}-paperless-inventory.out"
  "${COMPOSE[@]}" exec -T odoo odoo shell \
    --config=/etc/odoo/odoo.conf --database="$restore_database" \
    --shell-interface=python < scripts/odoo/documents_release_inventory.py \
    > "$restored_odoo_output"
  extract_prefixed_json "$restored_odoo_output" \
    "USL_DOCUMENTS_RELEASE_INVENTORY=" \
    "/private/tmp/${restore_project}-odoo-inventory.json"
  "${COMPOSE[@]}" exec -T paperless-webserver python manage.py shell \
    < scripts/paperless_release_inventory.py > "$restored_paperless_output"
  extract_prefixed_json "$restored_paperless_output" \
    "USL_PAPERLESS_RELEASE_INVENTORY=" \
    "/private/tmp/${restore_project}-paperless-inventory.json"
  extract_prefixed_json "$restored_paperless_output" \
    "USL_PAPERLESS_VECTOR_INVENTORY=" \
    "/private/tmp/${restore_project}-vector-inventory.json"
  if [[ "$ollama_runtime" == native ]]; then
    restored_bge_digest="$(shasum -a 256 \
      "$native_models_root/manifests/registry.ollama.ai/library/usl-bge-m3/documents-20260824-rc1" \
      | awk '{print $1}')"
  elif [[ "$ollama_runtime" == container ]]; then
    restored_bge_digest="$(
      "${COMPOSE[@]}" exec -T paperless-ollama sha256sum \
        /root/.ollama/models/manifests/registry.ollama.ai/library/usl-bge-m3/documents-20260824-rc1 \
        | awk '{print $1}'
    )"
  else
    restored_bge_digest="$(
      "${COMPOSE[@]}" exec -T paperless-webserver python -c '
import json, os, urllib.request
endpoint = os.environ["PAPERLESS_AI_LLM_EMBEDDING_ENDPOINT"].rstrip("/")
model = os.environ["PAPERLESS_AI_LLM_EMBEDDING_MODEL"]
models = json.load(urllib.request.urlopen(endpoint + "/api/tags", timeout=10)).get("models", [])
matches = [item for item in models if item.get("name") == model]
if len(matches) != 1:
    raise SystemExit("shared Ollama model identity is ambiguous")
print(matches[0].get("digest", ""))
'
    )"
  fi
  python3 migration/documents_archive/release_recovery.py \
    --bundle "$bundle" \
    --odoo "/private/tmp/${restore_project}-odoo-inventory.json" \
    --paperless "/private/tmp/${restore_project}-paperless-inventory.json" \
    --vector "/private/tmp/${restore_project}-vector-inventory.json" \
    --bge-manifest-sha256 "$restored_bge_digest" \
    --tantivy-output "/private/tmp/${restore_project}-tantivy-noop.txt" \
    --project "$restore_project" --database "$restore_database" \
    --output "$evidence_file" \
    --text-output "$bundle/evidence/recovery-rehearsal.txt"
  python3 migration/documents_archive/release_bundle.py seal "$bundle" \
    --identity "$bundle/evidence/release-identity.json"
  python3 migration/documents_archive/release_bundle.py verify "$bundle"
  printf 'Documents cohort restored without OCR/rebuild/model download: %s\n' \
    "$restore_project"
  printf 'Recovery evidence: %s\n' "$evidence_file"
  rm -f -- "$compose_json"
  trap - EXIT
}

case "$command_name" in
  build) build_bundle "${1:-}" ;;
  verify) python3 migration/documents_archive/release_bundle.py verify "${1:-}" ;;
  accept) python3 migration/documents_archive/release_bundle.py accept "${1:-}" ;;
  restore) restore_bundle "${1:-}" "${2:-}" "${3:-}" ;;
  *) usage ;;
esac
