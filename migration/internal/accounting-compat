#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT"

if [[ -z "${USL_MIGRATION_RUNTIME_STATE:-}" ]]; then
  printf 'Accounting migration commands must be invoked through migration/manage.\n' >&2
  exit 2
fi

exec python3 -m accounting_compat.cli "$@"
