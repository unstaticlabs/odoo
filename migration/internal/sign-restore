#!/usr/bin/env bash
set -euo pipefail
export COMPOSE_IGNORE_ORPHANS=1

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT"
source "$ROOT/scripts/lib/compose-scope.sh"
source "$ROOT/scripts/lib/migration-addons.sh"
source "$ROOT/scripts/lib/ollama-runtime.sh"

command_name="${1:-all}"
compose_project="${COMPOSE_PROJECT_NAME:?migration/manage did not resolve COMPOSE_PROJECT_NAME}"
target_database="${ODOO_DEV_DB:?migration/manage did not resolve ODOO_DEV_DB}"
source_database=odoo_online_source_saas_19_3
source_dump_dir="${USL_ONLINE_DUMP_DIR:?migration/manage did not resolve USL_ONLINE_DUMP_DIR}"
canonical_env_file="${POCKET_ID_ENV_FILE:?migration/manage did not provide its temporary identity environment}"
paperless_port="${PAPERLESS_HTTP_PORT:?migration/manage did not resolve PAPERLESS_HTTP_PORT}"
odoo_port="${ODOO_HTTP_PORT:?migration/manage did not resolve ODOO_HTTP_PORT}"
odoo_gevent_port="${ODOO_GEVENT_PORT:?migration/manage did not resolve ODOO_GEVENT_PORT}"
if [[ "$target_database" != odoo_dev ]]; then
  printf 'Canonical Sign restoration is reserved for odoo_dev.\n' >&2
  exit 2
fi
case "$target_database" in
  ""|odoo_online_source_saas_19_3|*[!A-Za-z0-9_]*)
    printf 'Refusing protected or unsafe Sign migration target %s.\n' "$target_database" >&2
    exit 2
    ;;
esac
usl_verify_compose_scope "$compose_project" "$ROOT" "Sign restoration"
if [[ ! -f "$source_dump_dir/dump.sql" || ! -d "$source_dump_dir/filestore" || ! -d "$source_dump_dir/sign" ]]; then
  printf 'The Odoo Online dump, filestore, or Sign export folder is missing under %s.\n' "$source_dump_dir" >&2
  exit 2
fi
source_dump_dir="$(cd "$source_dump_dir" && pwd -P)"
source_sha256="$(shasum -a 256 "$source_dump_dir/dump.sql" | awk '{print $1}')"
[[ "$source_sha256" == "${USL_MIGRATION_SOURCE_SHA256:?migration/manage did not resolve the source checksum}" ]] || {
  printf 'Sign source checksum differs from the recorded runtime.\n' >&2; exit 2;
}
source_snapshot="source-${source_sha256:0:12}"

export USL_ONLINE_DUMP_DIR="$source_dump_dir"
export PAPERLESS_HTTP_PORT="$paperless_port"
export PAPERLESS_PUBLIC_URL="${PAPERLESS_PUBLIC_URL:?migration/manage did not resolve PAPERLESS_PUBLIC_URL}"
export PAPERLESS_ALLOWED_HOSTS="${PAPERLESS_ALLOWED_HOSTS:-localhost,127.0.0.1,paperless-webserver,paperless.localhost}"
export PAPERLESS_CORS_ALLOWED_HOSTS="${PAPERLESS_CORS_ALLOWED_HOSTS:-$PAPERLESS_PUBLIC_URL}"
export PAPERLESS_CSRF_TRUSTED_ORIGINS="${PAPERLESS_CSRF_TRUSTED_ORIGINS:-$PAPERLESS_PUBLIC_URL}"
export PAPERLESS_EMPTY_TRASH_DELAY=36500
export ODOO_HTTP_PORT="$odoo_port"
export ODOO_GEVENT_PORT="$odoo_gevent_port"
export ODOO_DB_NAME="$target_database"
export ODOO_DB_FILTER="^${target_database}$"
export PAPERLESS_INTERNAL_URL=http://paperless-webserver:8000
export USL_POCKET_ID_ENABLED=0
export USL_EINVOICE_LIVE_ENABLED=0
export USL_EREPORTING_LIVE_ENABLED=0

usl_prepare_ollama_runtime "$ROOT"
if [[ -n "$USL_OLLAMA_COMPOSE_OVERRIDE" ]]; then
  # Supplying even one CLI -f makes Compose ignore an inherited COMPOSE_FILE.
  # Extend the environment value instead so governed reconstruction keeps its
  # private network override, while standalone Sign restores still load the
  # repository base file before the native Ollama override.
  export COMPOSE_FILE="$ROOT/compose.yaml:$USL_OLLAMA_COMPOSE_OVERRIDE"
fi
compose=(docker compose -p "$compose_project")
compose+=(--env-file "$canonical_env_file")

start_dependencies() {
  "${compose[@]}" --profile accounting-compat up -d --wait accounting-source-db db
  "${compose[@]}" --profile paperless up -d --wait --pull never \
    paperless-preflight paperless-db paperless-broker paperless-trash-init \
    paperless-gotenberg paperless-tika paperless-webserver
  local source_status
  source_status="$(
    "${compose[@]}" exec -T -e PGOPTIONS='-c default_transaction_read_only=on' \
      accounting-source-db psql -U "${ACCOUNTING_SOURCE_POSTGRES_USER:-odoo}" \
      -d "$source_database" -Atc \
      "SELECT current_setting('transaction_read_only'), count(*) FROM sign_request"
  )"
  [[ "$source_status" == "on|8" ]] || {
    printf 'Expected eight requests in a read-only Sign source; got %s.\n' "$source_status" >&2
    exit 1
  }
}

require_target() {
  local installed
  installed="$(
    "${compose[@]}" exec -T db psql -U "${ODOO_DB_USER:-odoo}" -d "$target_database" -Atc \
      "SELECT count(*) FROM ir_module_module WHERE name IN ('usl_sign','usl_documents') AND state='installed'"
  )"
  [[ "$installed" == 2 ]] || {
    printf 'Target %s must already contain the reconstructed identities and installed USL Sign/Documents modules.\n' "$target_database" >&2
    exit 2
  }
}

require_documents_target() {
  local installed
  installed="$(
    "${compose[@]}" exec -T db psql -U "${ODOO_DB_USER:-odoo}" -d "$target_database" -Atc \
      "SELECT count(*) FROM ir_module_module WHERE name='usl_documents' AND state='installed'"
  )"
  [[ "$installed" == 1 ]] || {
    printf 'Target %s must contain reconstructed identities and USL Documents before installing Sign.\n' "$target_database" >&2
    exit 2
  }
}

install_product() {
  local operation="--init=usl_sign"
  if [[ "$(
    "${compose[@]}" exec -T db psql -U "${ODOO_DB_USER:-odoo}" -d "$target_database" -Atc \
      "SELECT count(*) FROM ir_module_module WHERE name='usl_sign' AND state='installed'"
  )" == 1 ]]; then
    operation="--update=usl_sign"
  fi
  "${compose[@]}" --profile project-migration run --rm \
    -e ODOO_INIT_DB="$target_database" project-migration \
    odoo --config=/etc/odoo/odoo.conf --addons-path="$USL_MIGRATION_ADDONS_PATH" \
    --database="$target_database" "$operation" --without-demo=true \
    --stop-after-init --log-level=warn
}

provision_archive_identity() {
  local setup
  setup="$(
    "${compose[@]}" --profile paperless exec -T paperless-webserver \
      python manage.py shell \
      < migration/documents_archive/scripts/paperless_migration_access.py
  )"
  sign_paperless_token="$(sed -n 's/^DOCUMENTS_PAPERLESS_TOKEN=//p' <<<"$setup" | tail -n 1)"
  sign_paperless_service_user_id="$(
    sed -n 's/^DOCUMENTS_PAPERLESS_SERVICE_USER_ID=//p' <<<"$setup" | tail -n 1
  )"
  [[ -n "$sign_paperless_token" && "$sign_paperless_service_user_id" =~ ^[0-9]+$ ]] || {
    printf 'Could not provision the scoped Paperless migration identity.\n' >&2
    exit 1
  }
}

deprovision_archive_identity() {
  if [[ -z "${sign_paperless_token:-}" ]]; then
    return
  fi
  "${compose[@]}" --profile paperless exec -T paperless-webserver \
    python manage.py shell \
    < migration/documents_archive/scripts/paperless_migration_access_cleanup.py \
    >/dev/null
  sign_paperless_token=""
}

cleanup_sign_restore() {
  local cleanup_status=0 status=$?
  trap - EXIT
  set +e
  deprovision_archive_identity
  cleanup_status=$?
  set -e
  if ((status)); then
    exit "$status"
  fi
  exit "$cleanup_status"
}

run_shell() {
  local script_path="$1"
  "${compose[@]}" --profile project-migration run --rm -T \
    -e SIGN_SOURCE_DB_HOST="${SIGN_SOURCE_DB_HOST:-accounting-source-db}" \
    -e SIGN_SOURCE_DB_PORT="${SIGN_SOURCE_DB_PORT:-5432}" \
    -e SIGN_SOURCE_DB_USER="${SIGN_SOURCE_DB_USER:-odoo}" \
    -e SIGN_SOURCE_DB_PASSWORD="${SIGN_SOURCE_DB_PASSWORD:-odoo}" \
    -e SIGN_SOURCE_DATABASE="$source_database" \
    -e SIGN_SOURCE_FILESTORE=/mnt/accounting-source/filestore \
    -e SIGN_EXPORT_DIRECTORY=/mnt/accounting-source/sign \
    -e SIGN_SOURCE_SNAPSHOT="$source_snapshot" \
    -e SIGN_SOURCE_DUMP_SHA256="$source_sha256" \
    -e SIGN_PAPERLESS_URL=http://paperless-webserver:8000 \
    -e SIGN_PAPERLESS_PUBLIC_URL="$PAPERLESS_PUBLIC_URL" \
    -e SIGN_PAPERLESS_TOKEN="$sign_paperless_token" \
    -e SIGN_PAPERLESS_SERVICE_USER_ID="$sign_paperless_service_user_id" \
    -e SIGN_RESTORE_TIMEOUT="${SIGN_RESTORE_TIMEOUT:-900}" \
    project-migration odoo shell --config=/etc/odoo/odoo.conf \
    --addons-path="$USL_MIGRATION_ADDONS_PATH" --database="$target_database" \
    --shell-interface=python < "$script_path"
}

run_stage() {
  local script_path="$1"
  local evidence_dir="$ROOT/artifacts/migration/private/sign-restore/$source_snapshot"
  mkdir -p "$evidence_dir"
  run_shell "$script_path" | tee "$evidence_dir/$(basename "$script_path" .py).log"
}

case "$command_name" in
  status)
    "${compose[@]}" ps
    exit
    ;;
  prepare-target)
    start_dependencies
    require_documents_target
    install_product
    exit
    ;;
esac

start_dependencies
require_target
provision_archive_identity
trap cleanup_sign_restore EXIT
case "$command_name" in
  import)
    run_stage migration/sign_restore/scripts/run_restore.py
    ;;
  validate)
    run_stage migration/sign_restore/scripts/validate_restore.py
    ;;
  finalize)
    run_stage migration/sign_restore/scripts/finalize_restore.py
    run_stage migration/sign_restore/scripts/validate_product_boundary.py
    scripts/check-product-migration-boundary
    ;;
  all)
    run_stage migration/sign_restore/scripts/run_restore.py
    run_stage migration/sign_restore/scripts/validate_restore.py
    run_stage migration/sign_restore/scripts/run_restore.py
    run_stage migration/sign_restore/scripts/validate_restore.py
    run_stage migration/sign_restore/scripts/finalize_restore.py
    run_stage migration/sign_restore/scripts/validate_product_boundary.py
    scripts/check-product-migration-boundary
    ;;
  *)
    printf 'Usage: migration/internal/sign-restore [prepare-target|import|validate|finalize|all|status]\n' >&2
    exit 2
    ;;
esac
