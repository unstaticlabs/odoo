#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo_root"
source "$repo_root/scripts/lib/compose-scope.sh"
source "$repo_root/scripts/lib/migration-addons.sh"

command_name="${1:-all}"
compose_project="${COMPOSE_PROJECT_NAME:?migration/manage did not resolve COMPOSE_PROJECT_NAME}"
target_database="${ODOO_DEV_DB:?migration/manage did not resolve ODOO_DEV_DB}"
test_database="${PLATFORM_BILLING_TEST_DATABASE:-odoo_test_platform_billing_restore}"
source_dump_dir="${USL_ONLINE_DUMP_DIR:-$repo_root/usl-online-dump}"
source_dump_sha=""
source_snapshot=""
migration_addons_path="$USL_MIGRATION_ADDONS_PATH"

case "$target_database" in
    odoo_online_source_saas_19_3)
        echo "Refusing the read-only source database as a target."
        exit 2
        ;;
    ""|*[!A-Za-z0-9_]*)
        echo "Refusing unsafe target database name: $target_database"
        exit 2
        ;;
esac
case "$test_database" in
    ""|"$target_database"|*[!A-Za-z0-9_]*)
        echo "Refusing unsafe platform billing test database: $test_database"
        exit 2
        ;;
esac

verify_workspace() {
    usl_verify_compose_scope \
        "$compose_project" "$repo_root" "Platform Billing restoration"
    if [[ "$PWD" != "$repo_root" ]]; then
        echo "Docker operation refused outside $repo_root."
        exit 2
    fi
    local container_id
    while IFS= read -r container_id; do
        [[ -z "$container_id" ]] && continue
        local project_label working_dir_label running
        project_label="$(docker inspect --format '{{ index .Config.Labels "com.docker.compose.project" }}' "$container_id")"
        working_dir_label="$(docker inspect --format '{{ index .Config.Labels "com.docker.compose.project.working_dir" }}' "$container_id")"
        running="$(docker inspect --format '{{.State.Running}}' "$container_id")"
        # Governed one-off rehearsals may intentionally keep a stopped
        # container with only the project/service labels as evidence.  They
        # own no active runtime endpoint and must not make a read-only product
        # boundary reconcile or delete preserved evidence.
        if [[ -z "$working_dir_label" && "$running" == false ]]; then
            continue
        fi
        if [[ "$project_label" != "$compose_project" || "$working_dir_label" != "$repo_root" ]]; then
            echo "Compose label mismatch on container $container_id."
            echo "Expected project=$compose_project working_dir=$repo_root."
            exit 2
        fi
    done < <(
        docker ps -aq \
            --filter "label=com.docker.compose.project=$compose_project"
    )
}

compose() {
    verify_workspace
    docker compose -p "$compose_project" "$@"
}

require_source() {
    if [[ ! -f "$source_dump_dir/dump.sql" || ! -d "$source_dump_dir/filestore" ]]; then
        echo "Source dump or filestore is missing under $source_dump_dir."
        exit 2
    fi
    source_dump_sha="$(shasum -a 256 "$source_dump_dir/dump.sql" | cut -d ' ' -f 1)"
    source_snapshot="source-${source_dump_sha:0:12}"
    if ! compose ps --status running --services | grep -qx accounting-source-db; then
        echo "The dedicated accounting-source-db service is not running."
        echo "Restore it through the isolated Accounting reconstruction first."
        exit 2
    fi
}

export USL_ONLINE_DUMP_DIR="$source_dump_dir"
export USL_EINVOICE_LIVE_ENABLED=0
export USL_EREPORTING_LIVE_ENABLED=0

product_was_running=0
if [[ "$command_name" != product-validate ]] \
    && compose ps --status running --services | grep -qx odoo; then
    product_was_running=1
    compose stop odoo >/dev/null
fi

restore_product_service() {
    if ((product_was_running)); then
        compose up -d --wait odoo
    fi
}
trap restore_product_service EXIT INT TERM

module_operations() {
    local init_modules=()
    local update_modules=()
    local module_name
    for module_name in "$@"; do
        if compose exec -T db \
            psql -U "${ODOO_DB_USER:-odoo}" -d "$target_database" -Atc \
            "SELECT 1 FROM ir_module_module WHERE name = '$module_name' AND state = 'installed'" \
            | grep -qx 1; then
            update_modules+=("$module_name")
        else
            init_modules+=("$module_name")
        fi
    done
    local operations=()
    if ((${#init_modules[@]})); then
        operations+=("--init=$(IFS=,; echo "${init_modules[*]}")")
    fi
    if ((${#update_modules[@]})); then
        operations+=("--update=$(IFS=,; echo "${update_modules[*]}")")
    fi
    compose --profile platform-billing-migration run --rm \
        -e ODOO_INIT_DB="$target_database" \
        platform-billing-migration \
        odoo --config=/etc/odoo/odoo.conf \
        --addons-path="$migration_addons_path" \
        --database="$target_database" \
        "${operations[@]}" \
        --without-demo=true \
        --stop-after-init
}

install_modules() {
    module_operations \
        usl_platform_billing \
        rebuild_account_migration \
        usl_platform_billing_restore
}

run_shell() {
    local script_path="$1"
    local evidence_name="${2:-}"
    local evidence_path=""
    if [[ -n "$evidence_name" ]]; then
        evidence_path="/mnt/platform-billing-evidence/$evidence_name"
    fi
    compose --profile platform-billing-migration run --rm \
        -e PLATFORM_BILLING_SOURCE_DB_HOST=accounting-source-db \
        -e PLATFORM_BILLING_SOURCE_DB_PORT=5432 \
        -e PLATFORM_BILLING_SOURCE_DB_USER="${PLATFORM_BILLING_SOURCE_DB_USER:-odoo}" \
        -e PLATFORM_BILLING_SOURCE_DB_PASSWORD="${PLATFORM_BILLING_SOURCE_DB_PASSWORD:-odoo}" \
        -e PLATFORM_BILLING_SOURCE_DATABASE="${PLATFORM_BILLING_SOURCE_DATABASE:-odoo_online_source_saas_19_3}" \
        -e PLATFORM_BILLING_SOURCE_SNAPSHOT="${PLATFORM_BILLING_SOURCE_SNAPSHOT:-$source_snapshot}" \
        -e PLATFORM_BILLING_SOURCE_DUMP_SHA256="$source_dump_sha" \
        -e "PLATFORM_BILLING_EVIDENCE_PATH=$evidence_path" \
        platform-billing-migration \
        odoo shell --config=/etc/odoo/odoo.conf \
        --addons-path="$migration_addons_path" \
        --database="$target_database" \
        --shell-interface=python \
        < "$script_path"
}

import_history() {
    require_source
    run_shell \
        migration/platform_billing_restore/addons/usl_platform_billing_restore/scripts/run_restore.py \
        latest-restore.json
}

validate_history() {
    require_source
    run_shell \
        migration/platform_billing_restore/addons/usl_platform_billing_restore/scripts/validate_restore.py
}

finalize_history() {
    run_shell \
        migration/platform_billing_restore/addons/usl_platform_billing_restore/scripts/finalize_restore.py
    if [[ "${PLATFORM_BILLING_RESTORE_DEFER_PRODUCT_FINALIZE:-0}" != "1" ]]; then
        finalize_product_schema
        validate_product_boundary
    fi
}

finalize_product_schema() {
    compose --profile init run --rm \
        -e ODOO_INIT_DB="$target_database" \
        init-db \
        odoo shell --config=/etc/odoo/odoo.conf \
        --database="$target_database" \
        --shell-interface=python \
        < migration/platform_billing_restore/scripts/finalize_schema.py
}

validate_product_boundary() {
    if [[ -n "$(compose ps --status running -q odoo)" ]]; then
        compose exec -T odoo \
            odoo shell --config=/etc/odoo/odoo.conf \
            --database="$target_database" --shell-interface=python \
            < migration/platform_billing_restore/scripts/validate_product_boundary.py
    else
        compose --profile init run --rm -T --no-deps \
            -e ODOO_INIT_DB="$target_database" init-db \
            odoo shell --config=/etc/odoo/odoo.conf \
            --database="$target_database" --shell-interface=python \
            < migration/platform_billing_restore/scripts/validate_product_boundary.py
    fi
}

cleanup_test_database() {
    compose exec -T \
        -e TEST_DATABASE="$test_database" \
        db sh -c \
        'dropdb --if-exists --force -U "$POSTGRES_USER" "$TEST_DATABASE"'
    compose --profile platform-billing-migration run --rm \
        --entrypoint sh \
        -e TEST_DATABASE="$test_database" \
        platform-billing-migration -c '
          directory="/var/lib/odoo/filestore/$TEST_DATABASE"
          if [ -d "$directory" ]; then
            find "$directory" -mindepth 1 -delete
            rmdir "$directory"
          fi
        '
}

test_restore() {
    local status=0
    cleanup_test_database
    # The production migration image deliberately excludes browser and HTTP
    # mocking dependencies.  Build and use the repository test image here so
    # dependencies' own test modules can be imported during a clean registry
    # initialization (notably OCA auth_oidc's `responses` dependency).
    compose build odoo
    compose --profile test build test
    compose --profile test run --rm \
        --volume "$repo_root/migration/platform_billing_restore/addons:/mnt/platform-billing-migration-addons:ro" \
        -e ODOO_INIT_DB="$test_database" \
        -e "ODOO_DB_FILTER=^${test_database}$" \
        test \
        odoo --config=/etc/odoo/odoo.conf \
        --addons-path="$migration_addons_path" \
        --database="$test_database" \
        --init=usl_platform_billing_restore \
        --without-demo=true \
        --test-enable \
        --test-tags=/usl_platform_billing_restore \
        --stop-after-init \
        --log-level=test || status=$?
    cleanup_test_database
    return "$status"
}

case "$command_name" in
    install)
        install_modules
        ;;
    import)
        import_history
        ;;
    validate)
        validate_history
        ;;
    idempotence)
        import_history
        validate_history
        ;;
    finalize)
        finalize_history
        ;;
    schema-finalize)
        finalize_product_schema
        validate_product_boundary
        ;;
    product-validate)
        validate_product_boundary
        ;;
    test)
        test_restore
        ;;
    all)
        install_modules
        import_history
        validate_history
        import_history
        validate_history
        finalize_history
        ;;
    *)
        echo "Usage: migration/internal/platform-billing-restore [install|import|validate|idempotence|finalize|schema-finalize|product-validate|test|all]"
        exit 2
        ;;
esac
