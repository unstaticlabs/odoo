#!/usr/bin/env bash
set -euo pipefail
export COMPOSE_IGNORE_ORPHANS=1

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT"
source "$ROOT/scripts/lib/compose-scope.sh"
source "$ROOT/scripts/lib/migration-addons.sh"

command_name="${1:-all}"
compose_project="${COMPOSE_PROJECT_NAME:?migration/manage did not resolve COMPOSE_PROJECT_NAME}"
target_database="${ODOO_DEV_DB:?migration/manage did not resolve ODOO_DEV_DB}"
migration_addons_path="$USL_MIGRATION_ADDONS_PATH"

export USL_EINVOICE_LIVE_ENABLED=0
export USL_EREPORTING_LIVE_ENABLED=0
usl_verify_compose_scope "$compose_project" "$ROOT" "Accounting restoration"

run_migration_shell() {
    script_path="$1"
    docker compose -p "$compose_project" --profile accounting-migration run --rm \
        -e ODOO_INIT_DB="$target_database" \
        accounting-migration \
        odoo shell --config=/etc/odoo/odoo.conf \
        --addons-path="$migration_addons_path" \
        --database="$target_database" \
        --shell-interface=python < "$script_path"
}

validate_product_boundary() {
    if [[ -n "$(docker compose -p "$compose_project" ps --status running -q odoo)" ]]; then
        docker compose -p "$compose_project" exec -T odoo \
            odoo shell --config=/etc/odoo/odoo.conf \
            --database="$target_database" --shell-interface=python \
            < migration/accounting_restore/scripts/validate_product_boundary.py
    else
        docker compose -p "$compose_project" --profile init run --rm -T --no-deps \
            -e ODOO_INIT_DB="$target_database" init-db \
            odoo shell --config=/etc/odoo/odoo.conf \
            --database="$target_database" --shell-interface=python \
            < migration/accounting_restore/scripts/validate_product_boundary.py
    fi
}

finalize_product_schema() {
    docker compose -p "$compose_project" --profile init run --rm \
        -e ODOO_INIT_DB="$target_database" \
        init-db \
        odoo shell --config=/etc/odoo/odoo.conf \
        --database="$target_database" \
        --shell-interface=python \
        < migration/accounting_restore/scripts/finalize_schema.py
}

case "$command_name" in
    attachment-targets)
        run_migration_shell \
            migration/accounting_restore/addons/usl_accounting_restore/scripts/repair_attachment_targets.py
        ;;
    expense-batch-transition)
        run_migration_shell \
            migration/accounting_restore/addons/usl_accounting_restore/scripts/reapply_expense_batch_transition.py
        ;;
    finalize)
        run_migration_shell \
            migration/accounting_restore/addons/usl_accounting_restore/scripts/finalize_restore.py
        finalize_product_schema
        validate_product_boundary
        ;;
    schema-finalize)
        finalize_product_schema
        validate_product_boundary
        ;;
    product-validate)
        validate_product_boundary
        ;;
    all)
        migration/internal/accounting-compat dev-import
        migration/internal/accounting-compat dev-validate
        run_migration_shell \
            migration/accounting_restore/addons/usl_accounting_restore/scripts/finalize_restore.py
        finalize_product_schema
        validate_product_boundary
        ;;
    *)
        echo "Usage: migration/internal/accounting-restore [attachment-targets|expense-batch-transition|finalize|schema-finalize|product-validate|all]"
        exit 2
        ;;
esac
