#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT"
# shellcheck source=lib/compose-scope.sh
source "$ROOT/scripts/lib/compose-scope.sh"

command_name="${1:-status}"
runtime_state="${USL_MIGRATION_RUNTIME_STATE:?Candidate operations must be invoked through migration/manage}"
runtime_dir="$(cd "$(dirname "$runtime_state")" && pwd -P)"
cache_root="$runtime_dir/candidates"
current_link="$cache_root/current"

export USL_EINVOICE_LIVE_ENABLED=0
export USL_EREPORTING_LIVE_ENABLED=0
export COMPOSE_IGNORE_ORPHANS=1

usage() {
  cat <<'EOF'
Usage:
  migration/internal/candidate build SOURCE_DIR [OUTPUT_ROOT]
  migration/internal/candidate verify CANDIDATE_DIR APPROVED_FINGERPRINT SOURCE_DIR
  migration/internal/candidate status [CANDIDATE_DIR] [SOURCE_DIR]

Build requires a clean exact release, immutable image identities, and a passed
full transition reconstruction recorded by migration/manage.
EOF
}

require_private_root() {
  local requested="${1:-$cache_root}"
  mkdir -p "$requested"
  chmod 700 "$requested"
  cache_root="$(cd "$requested" && pwd -P)"
  case "$cache_root" in
    "$runtime_dir"/candidates|"$runtime_dir"/candidates/*) ;;
    *) printf 'Candidate storage must remain inside the recorded private runtime.\n' >&2; exit 2 ;;
  esac
}

require_source() {
  local source_dir="$1"
  if [[ ! -f "$source_dir/dump.sql" || ! -d "$source_dir/filestore" ]]; then
    printf 'Source package is incomplete: %s\n' "$source_dir" >&2
    exit 2
  fi
}

candidate_dir() {
  if [[ -n "${1:-}" ]]; then
    (cd "$1" && pwd -P)
  elif [[ -L "$current_link" ]]; then
    (cd "$cache_root" && cd "$(readlink "$current_link")" && pwd -P)
  else
    printf 'No current production migration candidate exists.\n' >&2
    return 2
  fi
}

latest_qualified_run() {
  local source_sha="$1" commit="$2" project="$3" migration_sha="$4"
  python3 - "$ROOT/private/migration/runs" \
    "$source_sha" "$commit" "$project" "$migration_sha" <<'PY'
import json
import sys
from pathlib import Path

root, source_sha, commit, project, migration_sha = Path(sys.argv[1]), *sys.argv[2:]
matches = []
for path in root.glob("*.json"):
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        continue
    stages = value.get("stages") or []
    stage_names = {
        stage.get("name")
        for stage in stages
        if isinstance(stage, dict)
    }
    required_stages = {
        "source coverage gate",
        "attachment disposition gate",
        "import accounting",
        "validate accounting",
        "restore Documents archive",
        "finalize migration boundary",
        "apply target configuration",
        "multi-company acceptance",
    }
    if (
        value.get("schema") == "usl-production-migration-run-v2"
        and value.get("purpose") == "production"
        and value.get("profile") == "full"
        and value.get("outcome") == "passed"
        and value.get("validation_level") == "production-source-wide"
        and value.get("source_dump_sha256") == source_sha
        and value.get("git_commit") == commit
        and value.get("compose_project") == project
        and value.get("migration_code_sha256") == migration_sha
        and (value.get("source_coverage") or {}).get("complete") is True
        and (value.get("attachment_coverage") or {}).get("complete") is True
        and required_stages.issubset(stage_names)
        and all(stage.get("status") == 0 for stage in stages)
    ):
        matches.append(path)
if not matches:
    raise SystemExit(
        "No passed full production reconstruction with complete whole-source "
        "and attachment gates matches this source, commit and Compose project.",
    )
print(max(matches, key=lambda item: item.stat().st_mtime))
PY
}

build_candidate() {
  local source_argument="${2:-}" output_argument="${3:-}"
  local source_dir project image paperless_image ollama_image release_commit source_sha source_filestore_sha
  local migration_sha
  local run_evidence pending clone_db db_container odoo_volume export_name
  local paperless_container ollama_container destination fingerprint timestamp paperless_count
  local module_versions accounting_controls documents_controls
  local accounting_status odoo_sanitation paperless_sanitation qualification
  local cleanup_export=0 identity_json filestore_inventory filestore_evidence

  if [[ -z "$source_argument" ]]; then
    usage >&2
    exit 2
  fi
  source_dir="$(cd "$source_argument" && pwd -P)"
  require_source "$source_dir"
  require_private_root "${output_argument:-$cache_root}"

  if [[ -n "$(git status --porcelain=v1 --untracked-files=no)" ]]; then
    printf 'Candidate publication requires a clean checkout.\n' >&2
    exit 2
  fi
  project="${COMPOSE_PROJECT_NAME:?migration/manage did not resolve COMPOSE_PROJECT_NAME}"
  usl_require_explicit_compose_project "Migration candidate build"
  usl_verify_compose_scope "$project" "$ROOT" "Migration candidate build"
  image="${USL_CANDIDATE_IMAGE:-}"
  if [[ -z "$image" || "$image" != *@sha256:* ]]; then
    printf 'USL_CANDIDATE_IMAGE must be an immutable registry digest.\n' >&2
    exit 2
  fi
  docker image inspect "$image" >/dev/null
  paperless_image="${PAPERLESS_IMAGE:-}"
  ollama_image="${OLLAMA_IMAGE:-}"
  for runtime_image in "$paperless_image" "$ollama_image"; do
    if [[ -z "$runtime_image" || "$runtime_image" != *@sha256:* ]]; then
      printf 'PAPERLESS_IMAGE and OLLAMA_IMAGE must be immutable registry digests.\n' >&2
      exit 2
    fi
    docker image inspect "$runtime_image" >/dev/null
  done
  release_commit="$(git rev-parse HEAD)"
  source_sha="$(shasum -a 256 "$source_dir/dump.sql" | awk '{print $1}')"
  migration_sha="$(PYTHONPATH="$ROOT" python3 -c \
    'from pathlib import Path; from migration.digests import migration_digest; print(migration_digest(Path.cwd()))')"
  run_evidence="$(latest_qualified_run \
    "$source_sha" "$release_commit" "$project" "$migration_sha")"
  accounting_status="$ROOT/artifacts/accounting-compat/private/dev-import-status.json"
  if [[ ! -f "$accounting_status" ]]; then
    printf 'Passed Accounting evidence is missing: %s\n' "$accounting_status" >&2
    exit 2
  fi
  python3 - "$accounting_status" "$source_sha" <<'PY'
import json
import sys
value = json.load(open(sys.argv[1], encoding="utf-8"))
if value.get("status") != "passed":
    raise SystemExit("Accounting evidence did not pass.")
actual = value.get("source_dump_sha256") or value.get("source", {}).get("dump_sha256")
if actual != sys.argv[2]:
    raise SystemExit("Accounting evidence refers to another source dump.")
PY

  scripts/check-product-migration-boundary
  scripts/check-product-database-boundary

  umask 077
  timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
  pending="$cache_root/.pending-$project-$timestamp"
  if [[ -e "$pending" ]]; then
    printf 'Pending candidate already exists: %s\n' "$pending" >&2
    exit 2
  fi
  mkdir -m 700 "$pending" "$pending/evidence" "$pending/paperless-export"
  python3 migration/release_identity.py --source-dir "$source_dir" \
    --image "$image" --require-clean --output "$pending/release-identity.json" \
    >/dev/null
  clone_db="odoo_candidate_export_${source_sha:0:12}"
  case "$clone_db" in
    odoo_candidate_export_[0-9a-f][0-9a-f]*) ;;
    *) printf 'Unsafe candidate clone database: %s\n' "$clone_db" >&2; exit 2 ;;
  esac

  compose=(docker compose -p "$project")
  release_compose=(
    docker compose -p "$project" -f "$ROOT/compose.yaml"
    -f "$ROOT/compose.production.yaml"
  )

  cleanup_candidate_build() {
    local status=$?
    set +e
    if [[ "$cleanup_export" == 1 ]]; then
      "${compose[@]}" --profile paperless exec -T --user paperless paperless-webserver \
        rm -rf -- "/usr/src/paperless/export/$export_name" >/dev/null 2>&1
    fi
    if [[ -n "${db_container:-}" ]]; then
      "${compose[@]}" exec -T -e CLONE_DB="$clone_db" db sh -ec '
        dropdb --if-exists --force -U "$POSTGRES_USER" "$CLONE_DB"
        rm -f /tmp/usl-candidate-*.dump
      ' >/dev/null 2>&1
    fi
    if ((status)); then
      case "$pending" in
        "$cache_root"/.pending-*) rm -rf -- "$pending" ;;
      esac
    fi
    exit "$status"
  }
  trap cleanup_candidate_build EXIT INT TERM

  printf '[1/7] Clone and sanitize finalized Odoo data\n'
  "${compose[@]}" up -d --wait db
  "${compose[@]}" stop odoo >/dev/null 2>&1 || true
  db_container="$("${compose[@]}" ps -q db)"
  "${compose[@]}" exec -T -e CLONE_DB="$clone_db" db sh -ec '
    dropdb --if-exists --force -U "$POSTGRES_USER" "$CLONE_DB"
    psql -X -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" -d postgres -c \
      "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname='"'"'odoo_dev'"'"' AND pid <> pg_backend_pid();" >/dev/null
    createdb -U "$POSTGRES_USER" -T odoo_dev "$CLONE_DB"
  '
  ODOO_IMAGE="$image" "${release_compose[@]}" --profile init run --rm -T \
    -e ODOO_INIT_DB="$clone_db" -e ODOO_DB_FILTER="^${clone_db}$" \
    init-db odoo neutralize --config=/etc/odoo/odoo.conf \
    --database="$clone_db"
  odoo_sanitation="$pending/evidence/odoo-sanitation.log"
  ODOO_IMAGE="$image" "${release_compose[@]}" --profile init run --rm -T \
    -e ODOO_INIT_DB="$clone_db" -e ODOO_DB_FILTER="^${clone_db}$" \
    init-db odoo shell --config=/etc/odoo/odoo.conf \
    --database="$clone_db" --shell-interface=python \
    < "$ROOT/migration/sanitize_odoo.py" | tee "$odoo_sanitation"
  grep -q '"status": "passed"' "$odoo_sanitation"
  identity_json="$(tr -d '\n' < "$pending/release-identity.json")"
  ODOO_IMAGE="$image" "${release_compose[@]}" --profile init run --rm -T \
    -e ODOO_INIT_DB="$clone_db" -e ODOO_DB_FILTER="^${clone_db}$" \
    -e USL_RELEASE_IDENTITY_JSON="$identity_json" \
    -e USL_RELEASE_IDENTITY_APPLY=1 \
    init-db odoo shell --config=/etc/odoo/odoo.conf \
    --database="$clone_db" --shell-interface=python \
    < "$ROOT/scripts/odoo/release_identity.py" >/dev/null

  printf '[2/7] Export sanitized Odoo dump and filestore\n'
  "${compose[@]}" exec -T -e CLONE_DB="$clone_db" db sh -ec '
    pg_dump -U "$POSTGRES_USER" -Fc -f /tmp/usl-candidate-odoo.dump "$CLONE_DB"
  '
  docker cp "$db_container:/tmp/usl-candidate-odoo.dump" "$pending/odoo.dump"
  odoo_volume="${project}_odoo-data"
  docker volume inspect "$odoo_volume" >/dev/null
  filestore_inventory="$pending/evidence/odoo-filestore-attachments.tsv"
  "${compose[@]}" exec -T -e CLONE_DB="$clone_db" db sh -ec '
    psql -X -qAt -U "$POSTGRES_USER" -d "$CLONE_DB" -c "
      COPY (
        SELECT DISTINCT store_fname, checksum, file_size
          FROM ir_attachment
         WHERE store_fname IS NOT NULL
         ORDER BY store_fname, checksum, file_size
      ) TO STDOUT WITH (FORMAT csv, DELIMITER E'\\t')"
  ' > "$filestore_inventory"
  filestore_evidence="$pending/evidence/odoo-filestore.json"
  docker run --rm --user 0 --entrypoint python3 \
    -v "$odoo_volume:/source:ro" \
    -v "$pending:/candidate" \
    -v "$ROOT/migration/portable_filestore.py:/portable_filestore.py:ro" \
    "$image" /portable_filestore.py build \
    --root /source/filestore/odoo_dev \
    --inventory /candidate/evidence/odoo-filestore-attachments.tsv \
    --archive /candidate/odoo-filestore.tgz | tee "$filestore_evidence"

  printf '[3/7] Create and sanitize official Paperless export (no OCR)\n'
  "${compose[@]}" --profile paperless up -d --wait \
    paperless-preflight paperless-db paperless-broker paperless-trash-init \
    paperless-gotenberg paperless-tika paperless-webserver
  "${compose[@]}" exec -T paperless-webserver \
    python manage.py document_sanity_checker
  paperless_count="$(
    "${compose[@]}" exec -T paperless-webserver python manage.py shell -c \
      'from documents.models import Document; print(Document.objects.count())' \
      | tail -n 1
  )"
  export_name="production-candidate-$project-$timestamp"
  cleanup_export=1
  "${compose[@]}" exec -T --user paperless paperless-webserver \
    mkdir -p "/usr/src/paperless/export/$export_name"
  "${compose[@]}" exec -T --user paperless paperless-webserver \
    python manage.py document_exporter \
    "/usr/src/paperless/export/$export_name" \
    --compare-checksums --delete --no-progress-bar
  paperless_container="$("${compose[@]}" ps -q paperless-webserver)"
  ollama_container=""
  if [[ "${USL_OLLAMA_RUNTIME_SELECTED:?migration/manage did not select Ollama}" == container ]]; then
    ollama_container="$("${compose[@]}" ps -q paperless-ollama)"
  fi
  if [[ -z "$paperless_container" \
      || ( "$USL_OLLAMA_RUNTIME_SELECTED" == container && -z "$ollama_container" ) ]]; then
    printf 'Paperless and the selected Ollama runtime must be available.\n' >&2
    exit 2
  fi
  if [[ "$(docker inspect "$paperless_container" --format '{{.Config.Image}}')" != "$paperless_image" ]]; then
    printf 'Running Documents images differ from the immutable candidate images.\n' >&2
    exit 2
  fi
  if [[ "$USL_OLLAMA_RUNTIME_SELECTED" == container \
      && "$(docker inspect "$ollama_container" --format '{{.Config.Image}}')" != "$ollama_image" ]]; then
    printf 'Running Ollama image differs from the immutable candidate image.\n' >&2
    exit 2
  fi
  docker cp \
    "$paperless_container:/usr/src/paperless/export/$export_name/." \
    "$pending/paperless-export"
  paperless_sanitation="$pending/evidence/paperless-sanitation.json"
  python3 migration/sanitize_export.py --portable-candidate \
    "$pending/paperless-export" | tee "$paperless_sanitation"
  find "$pending/paperless-export" -type d -exec chmod 700 {} +
  find "$pending/paperless-export" -type f -exec chmod 600 {} +
  tar -C "$pending/paperless-export" -czf "$pending/paperless-export.tgz" .
  rm -rf -- "$pending/paperless-export"
  "${compose[@]}" exec -T --user paperless paperless-webserver \
    rm -rf -- "/usr/src/paperless/export/$export_name"
  cleanup_export=0

  printf '[4/7] Capture immutable release and parity controls\n'
  module_versions="$("${compose[@]}" exec -T -e DB="$clone_db" db \
    psql -X -qAt -U odoo -d "$clone_db" -c \
    "SELECT COALESCE(json_object_agg(name, latest_version ORDER BY name)::text, '{}') FROM ir_module_module WHERE state='installed' AND (name LIKE 'usl_%' OR name='rebuild_account_migration')")"
  accounting_controls="$("${compose[@]}" exec -T db psql -X -qAt -U odoo \
    -d "$clone_db" -c "
      SELECT json_build_object(
        'move_count', (SELECT count(*) FROM account_move),
        'move_line_count', (SELECT count(*) FROM account_move_line),
        'partial_reconcile_count', (SELECT count(*) FROM account_partial_reconcile),
        'full_reconcile_count', (SELECT count(*) FROM account_full_reconcile),
        'posted_debit', (SELECT COALESCE(sum(l.debit),0)::text FROM account_move_line l JOIN account_move m ON m.id=l.move_id WHERE m.state='posted'),
        'posted_credit', (SELECT COALESCE(sum(l.credit),0)::text FROM account_move_line l JOIN account_move m ON m.id=l.move_id WHERE m.state='posted')
      )::text")"
  documents_controls="$("${compose[@]}" exec -T db psql -X -qAt -U odoo \
    -d "$clone_db" -c "
      SELECT json_build_object(
        'odoo_document_count', (SELECT count(*) FROM usl_document),
        'active_link_count', (SELECT count(*) FROM usl_document_link WHERE active)
      )::text")"
  source_filestore_sha="$(PYTHONPATH="$ROOT" python3 - "$source_dir/filestore" <<'PY'
import sys
from pathlib import Path
from migration.digests import tree_digest
print(tree_digest(Path(sys.argv[1]))[0])
PY
)"

  cp "$accounting_status" "$pending/evidence/accounting-import.json"
  python3 - "$run_evidence" "$pending/evidence" <<'PY'
import json
import sys
from pathlib import Path

run = json.load(open(sys.argv[1], encoding="utf-8"))
target = Path(sys.argv[2])
portable = {
    key: run[key]
    for key in (
        "cache",
        "compose_project",
        "downloaded_bytes",
        "duration_seconds",
        "finished_at",
        "git_commit",
        "migration_code_sha256",
        "ocr_submissions",
        "outcome",
        "profile",
        "purpose",
        "schema",
        "source_dump_sha256",
        "stages",
        "started_at",
        "validation_level",
    )
    if key in run
}
for key in ("source_coverage", "attachment_coverage"):
    gate = run.get(key) or {}
    path = Path(gate.get("evidence", ""))
    if not path.is_file():
        raise SystemExit(f"Missing {key} evidence: {path}")
    expected_digest = gate.get("evidence_sha256")
    import hashlib
    digest = hashlib.sha256(path.read_bytes()).hexdigest()
    if digest != expected_digest:
        raise SystemExit(f"Changed {key} evidence: {path}")
    projection = {
        "complete": gate.get("complete") is True,
        "evidence_sha256": expected_digest,
        "summary": gate.get("summary") or {},
    }
    portable[key] = projection
    (target / f"{key}.json").write_text(
        json.dumps(projection, indent=2, sort_keys=True) + "\n",
        encoding="utf-8",
    )
(target / "reconstruction-run.json").write_text(
    json.dumps(portable, indent=2, sort_keys=True) + "\n",
    encoding="utf-8",
)
PY

  printf '[5/7] Build fail-closed qualification\n'
  qualification="$pending/qualification.json"
  PYTHONPATH="$ROOT" python3 - \
    "$qualification" "$pending/evidence/reconstruction-run.json" "$accounting_status" \
    "$pending/release-identity.json" "$source_sha" "$source_filestore_sha" \
    "$module_versions" "$accounting_controls" "$documents_controls" \
    "$paperless_count" "$paperless_image" "$ollama_image" \
    "$odoo_sanitation" "$paperless_sanitation" \
    "$filestore_evidence" <<'PY'
import json
import sys
from pathlib import Path
from migration.digests import migration_digest

(output, run_path, accounting_path, identity_path, source_sha,
 source_filestore_sha, module_versions, accounting_controls,
 documents_controls, paperless_count, paperless_image, ollama_image, odoo_log, paperless_path,
 filestore_path) = sys.argv[1:]
run = json.load(open(run_path, encoding="utf-8"))
accounting = json.load(open(accounting_path, encoding="utf-8"))
identity = json.load(open(identity_path, encoding="utf-8"))
paperless_sanitation = json.load(open(paperless_path, encoding="utf-8"))
filestore = json.load(open(filestore_path, encoding="utf-8"))
odoo_sanitation = None
for line in Path(odoo_log).read_text(encoding="utf-8").splitlines():
    try:
        value = json.loads(line)
    except json.JSONDecodeError:
        continue
    if value.get("status") == "passed":
        odoo_sanitation = value
if not odoo_sanitation:
    raise SystemExit("Odoo sanitation evidence is missing.")
if odoo_sanitation.get("standard_neutralized") is not True:
    raise SystemExit("Odoo standard module neutralization did not run.")
if filestore.get("status") != "passed":
    raise SystemExit("Odoo filestore qualification did not pass.")
stages = {item["name"]: item["status"] for item in run.get("stages", [])}
if stages.get("multi-company acceptance") != 0:
    raise SystemExit("Multi-company acceptance did not pass in this reconstruction.")
payload = {
    "schema": "usl-production-candidate-qualification-v2",
    "status": "passed",
    "purpose": "production",
    "profile": "full",
    "regulatory_live_guards": "disabled",
    "release_commit": identity["release_commit"],
    "source_dump_sha256": source_sha,
    "source_filestore_sha256": source_filestore_sha,
    "migration_sha256": migration_digest(Path.cwd()),
    "module_versions": json.loads(module_versions),
    "action_risk": {
        "status": "passed",
        "policy_sha256": identity["action_risk_policy_sha256"],
    },
    "accounting": {
        "status": accounting["status"],
        "controls": json.loads(accounting_controls),
        "performance": accounting.get("performance", {}),
    },
    "source_gate": {
        "status": "passed",
        "complete": (run.get("source_coverage") or {}).get("complete") is True,
        "summary": (run.get("source_coverage") or {}).get("summary", {}),
    },
    "attachment_gate": {
        "status": "passed",
        "complete": (run.get("attachment_coverage") or {}).get("complete") is True,
        "summary": (run.get("attachment_coverage") or {}).get("summary", {}),
    },
    "documents": {
        "status": "passed",
        "controls": json.loads(documents_controls),
        "paperless_document_count": int(paperless_count),
        "paperless_image_digest": paperless_image,
        "ollama_image_digest": ollama_image,
        "reconstruction": {
            "downloaded_bytes": run.get("downloaded_bytes"),
            "ocr_submissions": run.get("ocr_submissions"),
        },
    },
    "migration_boundary": "passed",
    "product_database_boundary": "passed",
    "multi_company": {"status": "passed"},
    "odoo_filestore": filestore,
    "sanitation": {
        "status": "passed",
        "odoo": odoo_sanitation,
        "paperless": paperless_sanitation,
    },
    "timings": {
        "accounting": accounting.get("performance", {}),
        "reconstruction": run,
    },
}
Path(output).write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
PY

  printf '[6/7] Seal checksums and candidate fingerprint\n'
  find "$pending" -type d -exec chmod 700 {} +
  find "$pending" -type f -exec chmod 600 {} +
  fingerprint="$(PYTHONPATH="$ROOT" python3 migration/candidate.py seal \
    --root "$ROOT" --source-dir "$source_dir" --candidate-dir "$pending")"

  printf '[7/7] Verify then publish atomically\n'
  PYTHONPATH="$ROOT" python3 migration/candidate.py verify \
    --root "$ROOT" --source-dir "$source_dir" --candidate-dir "$pending" \
    --expected-fingerprint "$fingerprint" >/dev/null
  destination="$cache_root/$fingerprint-$timestamp"
  mv "$pending" "$destination"
  ln -s "$(basename "$destination")" "$cache_root/.current-$project"
  python3 - "$cache_root/.current-$project" "$current_link" <<'PY'
import os
import sys
os.replace(sys.argv[1], sys.argv[2])
PY
  trap - EXIT INT TERM
  "${compose[@]}" exec -T -e CLONE_DB="$clone_db" db sh -ec '
    dropdb --if-exists --force -U "$POSTGRES_USER" "$CLONE_DB"
    rm -f /tmp/usl-candidate-*.dump
  ' >/dev/null
  printf 'Published production migration candidate: %s\n' "$destination"
  printf 'Fingerprint requiring independent approval: %s\n' "$fingerprint"
}

verify_candidate() {
  local requested="${2:-}" fingerprint="${3:-}" source_argument="${4:-}"
  local resolved source_dir
  if [[ -z "$requested" || -z "$fingerprint" || -z "$source_argument" ]]; then
    usage >&2
    exit 2
  fi
  require_private_root
  resolved="$(candidate_dir "$requested")"
  source_dir="$(cd "$source_argument" && pwd -P)"
  require_source "$source_dir"
  PYTHONPATH="$ROOT" python3 migration/candidate.py verify \
    --root "$ROOT" --source-dir "$source_dir" --candidate-dir "$resolved" \
    --expected-fingerprint "$fingerprint"
}

status_candidate() {
  local requested="${2:-}" source_argument="${3:-${USL_ONLINE_DUMP_DIR:-}}"
  local resolved source_dir
  require_private_root
  resolved="$(candidate_dir "$requested")"
  if [[ -z "$source_argument" ]]; then
    printf 'SOURCE_DIR or USL_ONLINE_DUMP_DIR is required for status verification.\n' >&2
    exit 2
  fi
  source_dir="$(cd "$source_argument" && pwd -P)"
  require_source "$source_dir"
  PYTHONPATH="$ROOT" python3 migration/candidate.py status \
    --root "$ROOT" --source-dir "$source_dir" --candidate-dir "$resolved"
}

case "$command_name" in
  build) build_candidate "$@" ;;
  verify) verify_candidate "$@" ;;
  status) status_candidate "$@" ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
