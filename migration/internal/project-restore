#!/usr/bin/env bash
set -euo pipefail
export COMPOSE_IGNORE_ORPHANS=1

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT"
source "$ROOT/scripts/lib/compose-scope.sh"
source "$ROOT/scripts/lib/migration-addons.sh"

command_name="${1:-all}"
compose_project="${COMPOSE_PROJECT_NAME:?migration/manage did not resolve COMPOSE_PROJECT_NAME}"
target_database="${ODOO_DEV_DB:?migration/manage did not resolve ODOO_DEV_DB}"
source_dump_dir="${USL_ONLINE_DUMP_DIR:-$ROOT/usl-online-dump}"
migration_addons_path="$USL_MIGRATION_ADDONS_PATH"
usl_verify_compose_scope "$compose_project" "$ROOT" "Project restoration"

source_snapshot() {
    local dump_path="$source_dump_dir/dump.sql"
    if [[ ! -f "$dump_path" ]]; then
        echo "Source dump is missing at $dump_path." >&2
        exit 2
    fi
    local dump_sha256
    dump_sha256="$(shasum -a 256 "$dump_path" | awk '{print $1}')"
    printf 'source-%s\n' "${dump_sha256:0:12}"
}

case "$target_database" in
    odoo_online_source_saas_19_3|odoo_saas_19_3_validation_exact|odoo_saas_19_3_validation_native)
        if [[ "${PROJECT_RESTORE_ALLOW_PROTECTED_TARGET:-0}" != "1" ]]; then
            echo "Refusing protected database $target_database."
            echo "Set PROJECT_RESTORE_ALLOW_PROTECTED_TARGET=1 only for an intentional in-place import."
            exit 2
        fi
        ;;
esac

export USL_ONLINE_DUMP_DIR="$source_dump_dir"
export USL_EINVOICE_LIVE_ENABLED=0
export USL_EREPORTING_LIVE_ENABLED=0

product_was_running=0
if [[ "$command_name" != product-validate ]] \
    && docker compose -p "$compose_project" ps --status running --services \
    | grep -qx odoo; then
    product_was_running=1
    docker compose -p "$compose_project" stop odoo >/dev/null
fi

restore_product_service() {
    if ((product_was_running)); then
        docker compose -p "$compose_project" up -d --wait odoo
    fi
}
trap restore_product_service EXIT INT TERM

module_operations() {
    service_name="$1"
    profile_name="$2"
    shift 2
    init_modules=()
    update_modules=()
    for module_name in "$@"; do
        if docker compose -p "$compose_project" exec -T db \
            psql -U "${ODOO_DB_USER:-odoo}" -d "$target_database" -Atc \
            "SELECT 1 FROM ir_module_module WHERE name = '$module_name' AND state = 'installed'" \
            | grep -qx 1; then
            update_modules+=("$module_name")
        else
            init_modules+=("$module_name")
        fi
    done
    module_operations=()
    if ((${#init_modules[@]})); then
        module_operations+=("--init=$(IFS=,; echo "${init_modules[*]}")")
    fi
    if ((${#update_modules[@]})); then
        module_operations+=("--update=$(IFS=,; echo "${update_modules[*]}")")
    fi
    docker compose -p "$compose_project" --profile "$profile_name" run --rm \
        -e ODOO_INIT_DB="$target_database" \
        "$service_name" \
        odoo --config=/etc/odoo/odoo.conf \
        --addons-path="$migration_addons_path" \
        --database="$target_database" \
        "${module_operations[@]}" \
        --without-demo=true \
        --stop-after-init
}

install_modules() {
    module_operations project-migration project-migration \
        usl_accounting \
        rebuild_account_migration \
        usl_project \
        usl_project_restore
}

require_source() {
    if [[ ! -f "$source_dump_dir/dump.sql" || ! -d "$source_dump_dir/filestore" ]]; then
        echo "Source dump or filestore is missing under $source_dump_dir."
        exit 2
    fi
}

import_projects() {
    require_source
    docker compose -p "$compose_project" --profile project-migration run --rm \
        -e PROJECT_SOURCE_DB_HOST="${PROJECT_SOURCE_DB_HOST:-accounting-source-db}" \
        -e PROJECT_SOURCE_DB_PORT="${PROJECT_SOURCE_DB_PORT:-5432}" \
        -e PROJECT_SOURCE_DB_USER="${PROJECT_SOURCE_DB_USER:-odoo}" \
        -e PROJECT_SOURCE_DB_PASSWORD="${PROJECT_SOURCE_DB_PASSWORD:-odoo}" \
        -e PROJECT_SOURCE_DATABASE="${PROJECT_SOURCE_DATABASE:-odoo_online_source_saas_19_3}" \
        -e PROJECT_SOURCE_SNAPSHOT="${PROJECT_SOURCE_SNAPSHOT:-$(source_snapshot)}" \
        -e PROJECT_SOURCE_FILESTORE=/mnt/accounting-source/filestore \
        -e PROJECT_RESTORE_DEFAULT_PASSWORD="${PROJECT_RESTORE_DEFAULT_PASSWORD:-}" \
        project-migration \
        odoo shell --config=/etc/odoo/odoo.conf \
        --addons-path="$migration_addons_path" \
        --database="$target_database" \
        --shell-interface=python \
        < migration/project_restore/addons/usl_project_restore/scripts/run_restore.py
}

validate_projects() {
    require_source
    docker compose -p "$compose_project" --profile project-migration run --rm \
        -e PROJECT_SOURCE_DB_HOST="${PROJECT_SOURCE_DB_HOST:-accounting-source-db}" \
        -e PROJECT_SOURCE_DB_PORT="${PROJECT_SOURCE_DB_PORT:-5432}" \
        -e PROJECT_SOURCE_DB_USER="${PROJECT_SOURCE_DB_USER:-odoo}" \
        -e PROJECT_SOURCE_DB_PASSWORD="${PROJECT_SOURCE_DB_PASSWORD:-odoo}" \
        -e PROJECT_SOURCE_DATABASE="${PROJECT_SOURCE_DATABASE:-odoo_online_source_saas_19_3}" \
        -e PROJECT_SOURCE_SNAPSHOT="${PROJECT_SOURCE_SNAPSHOT:-$(source_snapshot)}" \
        project-migration \
        odoo shell --config=/etc/odoo/odoo.conf \
        --addons-path="$migration_addons_path" \
        --database="$target_database" \
        --shell-interface=python \
        < migration/project_restore/addons/usl_project_restore/scripts/validate_restore.py
}

finalize_projects() {
    docker compose -p "$compose_project" --profile project-migration run --rm \
        project-migration \
        odoo shell --config=/etc/odoo/odoo.conf \
        --addons-path="$migration_addons_path" \
        --database="$target_database" \
        --shell-interface=python \
        < migration/project_restore/addons/usl_project_restore/scripts/finalize_restore.py
    if [[ "${PROJECT_RESTORE_DEFER_PRODUCT_VALIDATE:-0}" != "1" ]]; then
        validate_product_boundary
    fi
}

validate_product_boundary() {
    if [[ -n "$(docker compose -p "$compose_project" ps --status running -q odoo)" ]]; then
        docker compose -p "$compose_project" exec -T odoo \
            odoo shell --config=/etc/odoo/odoo.conf \
            --database="$target_database" --shell-interface=python \
            < migration/project_restore/scripts/validate_product_boundary.py
    else
        docker compose -p "$compose_project" --profile init run --rm -T --no-deps \
            -e ODOO_INIT_DB="$target_database" init-db \
            odoo shell --config=/etc/odoo/odoo.conf \
            --database="$target_database" --shell-interface=python \
            < migration/project_restore/scripts/validate_product_boundary.py
    fi
}

case "$command_name" in
    install)
        install_modules
        ;;
    import)
        import_projects
        ;;
    validate)
        validate_projects
        ;;
    finalize)
        finalize_projects
        ;;
    product-validate)
        validate_product_boundary
        ;;
    all)
        install_modules
        import_projects
        validate_projects
        finalize_projects
        ;;
    *)
        echo "Usage: migration/internal/project-restore [install|import|validate|finalize|product-validate|all]"
        exit 2
        ;;
esac
