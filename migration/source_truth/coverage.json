{
  "schema": "usl-source-truth-coverage-v1",
  "scopes": {
    "accounting": {
      "status": "implemented",
      "disposition": "translated",
      "evidence": "accounting compatibility import and parity controls"
    },
    "projects": {
      "status": "implemented",
      "disposition": "translated",
      "evidence": "temporary Projects restore add-on and source/target digest validation"
    },
    "native_reference": {
      "status": "implemented",
      "disposition": "recomputed",
      "evidence": "version-controlled Community modules and target configuration"
    },
    "identity": {
      "status": "implemented",
      "disposition": "translated",
      "evidence": "temporary identity restore imports all contacts, original contact images, users, companies, industries, categories, banks and relations with digest parity; authentication is re-enrolled"
    },
    "collaboration": {
      "status": "incomplete",
      "disposition": "translated",
      "evidence": "Accounting and Projects currently import only scoped chatter and activity history"
    },
    "attachments": {
      "status": "incomplete",
      "disposition": "translated",
      "evidence": "the complete attachment ledger integrity-checks and assigns all 2,322 rows; Accounting, Projects, native identity/product/HR images, all legacy Documents originals, and unassigned enterprise evidence are restored, while collaboration, signing, Knowledge, preference, and AI actions remain gated"
    },
    "documents": {
      "status": "implemented",
      "disposition": "archive",
      "evidence": "the dump-qualified Paperless 3.0.4/API v10 stage restores 567 source document identities and nine unassigned evidence files into 548 checksum-stable archive roots, verifies originals, previews, metadata, links and object permissions, and produces identical evidence on replay"
    },
    "knowledge": {
      "status": "incomplete",
      "disposition": "translate_or_archive",
      "evidence": "no Community target and no approved lossless translation are implemented"
    },
    "signing": {
      "status": "incomplete",
      "disposition": "archive",
      "evidence": "signed originals and audit evidence are not yet reconstructed"
    },
    "hr": {
      "status": "implemented",
      "disposition": "translated",
      "evidence": "Accounting restores expenses; the temporary HR stage restores the complete employee, original employee image, version, organization, calendar, work-location and skill perimeter with private-field access validation"
    },
    "tese_payroll": {
      "status": "implemented",
      "disposition": "translated",
      "evidence": "the temporary TESE stage restores profiles, payroll records, native HR and Accounting links, official evidence and lifecycle state with exact-count and idempotency validation"
    },
    "platform_billing": {
      "status": "implemented",
      "disposition": "translated",
      "evidence": "the temporary Platform Billing stage restores four platforms, three sessions, 31 payouts and all 51 generated Accounting links with stable application and ledger digests; transient legacy candidates are regenerated"
    },
    "studio": {
      "status": "incomplete",
      "disposition": "translate_or_archive",
      "evidence": "populated Studio models require explicit business mappings"
    },
    "preferences": {
      "status": "incomplete",
      "disposition": "translated",
      "evidence": "user filters, exports, dashboards and favorites are not globally reconstructed"
    },
    "product_master": {
      "status": "implemented",
      "disposition": "translated",
      "evidence": "temporary product restore imports the complete service catalog, variants, original product images, categories, attributes, prices, taxes and pricelists with multilingual digest parity"
    },
    "sales_marketing": {
      "status": "incomplete",
      "disposition": "translated",
      "evidence": "sales-team and UTM business configuration is not globally reconstructed"
    },
    "ai_configuration": {
      "status": "incomplete",
      "disposition": "translate_or_archive",
      "evidence": "source AI agents, prompts, topics and automation need an explicit Community treatment"
    },
    "credential_state": {
      "status": "implemented",
      "disposition": "deliberately_not_copied",
      "evidence": "tokens, passkeys, TOTP devices, sessions, certificates and IAP credentials are revoked/re-enrolled; business identities are covered separately"
    }
  },
