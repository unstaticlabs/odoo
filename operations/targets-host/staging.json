{
  "schema": "usl-runtime/v1",
  "name": "staging",
  "environment": "staging",
  "protected": false,
  "transport": {"type": "local"},
  "compose": {
    "project": "usl-odoo-staging-main",
    "anchor_service": "odoo-staging",
    "profiles": ["document-renderer", "mcp", "paperless", "sign"],
    "default_network": "usl-odoo-staging-main_default",
    "resource_overlay": "compose.resources.staging.json",
    "canonical": {
      "working_directory": "komodo/stacks/prod-odoo-nbg1-2/usl-odoo-staging",
      "compose_files": ["compose.yaml", "compose.resources.json"],
      "environment_file": "/opt/usl-odoo/staging/staging.env"
    },
    "adoption": {
      "schema": "usl-compose-adoption/v1",
      "legacy_anchor_service": "odoo",
      "legacy_release_schema": "usl-release/v2",
      "candidate": {
        "working_directory": "/etc/komodo/stacks/usl-odoo-production-main/komodo/stacks/prod-odoo-nbg1-2/usl-odoo-staging",
        "compose_files": [
          "/etc/komodo/stacks/usl-odoo-production-main/komodo/stacks/prod-odoo-nbg1-2/usl-odoo-staging/compose.yaml",
          "/etc/komodo/stacks/usl-odoo-production-main/komodo/stacks/prod-odoo-nbg1-2/usl-odoo-staging/compose.resources.json"
        ],
        "environment_file": "/opt/usl-odoo/staging/staging.env"
      }
    }
  },
  "services": {
    "odoo": "odoo-staging",
    "odoo_db": "db",
    "paperless": "paperless-webserver",
    "paperless_db": "paperless-db",
    "paperless_broker": "paperless-broker",
    "paperless_gotenberg": "paperless-gotenberg",
    "paperless_tika": "paperless-tika",
    "mcp": "odoo-mcp",
    "renderer": "usl-document-renderer",
    "sign": "usl-sign-dss",
    "sign_ca": "usl-sign-step-ca"
  },
  "databases": {
    "odoo": {"service": "db", "name": "odoo_staging", "user": "odoo", "password_key": "ODOO_DB_PASSWORD"},
    "paperless": {"service": "paperless-db", "name": "paperless_staging", "user": "paperless", "password_key": "PAPERLESS_DB_PASSWORD"}
  },
  "storage": {"tiers": {
    "bulk": {"path": "/srv/storage", "reserve_bytes": 16106127360},
    "database": {"path": "/srv/db", "reserve_bytes": 2147483648},
    "local": {"path": "/var/lib/usl-odoo", "reserve_bytes": 2147483648}
  }},
  "volumes": {
    "odoo_postgres": {"name": "usl-odoo-staging-main_postgres-data", "class": "transient", "tier": "database"},
    "odoo_filestore": {"name": "usl-odoo-staging-main_odoo-data", "class": "durable", "tier": "bulk"},
    "paperless_postgres": {"name": "usl-odoo-staging-main_paperless-postgres-data", "class": "transient", "tier": "database"},
    "paperless_broker": {"name": "usl-odoo-staging-main_paperless-broker-data", "class": "transient", "tier": "database"},
    "paperless_media": {"name": "usl-odoo-staging-main_paperless-media", "class": "durable", "tier": "bulk"},
    "paperless_data": {"name": "usl-odoo-staging-main_paperless-data", "class": "cache", "tier": "bulk"},
    "paperless_trash": {"name": "usl-odoo-staging-main_paperless-trash", "class": "durable", "tier": "bulk"},
    "paperless_consume": {"name": "usl-odoo-staging-main-paperless-consume", "class": "durable", "tier": "bulk"},
    "paperless_export": {"name": "usl-odoo-staging-main-paperless-export", "class": "transient", "tier": "bulk"},
    "mcp_oauth": {"name": "usl-odoo-staging-main-odoo-mcp-oauth-data", "class": "durable", "tier": "database"}
  },
  "paths": {
    "sign_secrets": {"path": "/opt/usl-odoo/staging/secrets/sign", "class": "durable", "required": true, "tier": "local"},
    "sign_evidence": {"path": "/srv/usl/sign/staging-evidence", "class": "durable", "required": false, "tier": "local"}
  },
  "external_networks": {"identity": "usl-identity", "ingress": "cloudflare", "ollama": "ollama"},
  "endpoints": {"odoo": "https://odoo-staging.unstaticlabs.com", "paperless": "http://127.0.0.1:19010", "mcp": "http://127.0.0.1:19000"},
  "admission_endpoints": {"odoo": "http://127.0.0.1:19069", "odoo_websocket": "http://127.0.0.1:19072", "paperless": "http://127.0.0.1:19010", "mcp": "http://127.0.0.1:19000"},
  "ingress": {"proxy_mode": true, "list_db": false, "dbfilter": "^odoo_staging$", "websocket": true},
  "ollama": {"mode": "external", "container": "ollama", "network": "ollama", "url": "http://ollama:11434", "model": "bge-m3:latest", "manifest_sha256": "7907646426070047a77226ac3e684fbbe8410524f7b4a74d02837e43f2146bab", "dimension": 1024},
  "backup": {
    "durable_repository": "/var/lib/usl-odoo/restic/staging/durable",
    "cache_repository": "/var/lib/usl-odoo/restic/staging/cache"
  },
  "release_manifest": "/opt/usl-odoo/staging/current/usl-release.json",
  "plan_signing": {"private_key": "/opt/usl-odoo/staging/secrets/upgrade-plan-signing.key", "public_key": "/opt/usl-odoo/staging/secrets/upgrade-plan-signing.pub"},
  "cron_policy": {
    "mode": "neutralized",
    "path": "/opt/usl/deploy/production.cron-policy.json",
    "gates": {"always": true, "digest": false, "inbound_mail": true, "ots": false, "pdp_ereporting": false, "pdp_reception": true, "project_ratings": false, "purchase_reminders": false, "sales_automation": false, "smtp": true, "stock": false, "vies": false}
  },
  "secrets": {"env_file": "/opt/usl-odoo/staging/secrets/operations.env", "allowed_keys": ["AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY", "ODOO_DB_PASSWORD", "PAPERLESS_DB_PASSWORD", "RESTIC_PASSWORD", "USL_BACKUP_CACHE_PASSWORD"]},
  "state_directory": "/var/lib/usl-odoo/runtime/staging"
}
