{
  "schema": "usl-runtime/v1",
  "name": "local",
  "environment": "local",
  "protected": false,
  "transport": {"type": "local"},
  "compose": {
    "project": "usl-odoo-local",
    "anchor_service": "odoo",
    "profiles": ["sign"],
    "default_network": "usl-odoo-local_default"
  },
  "services": {
    "odoo": "odoo",
    "odoo_db": "db",
    "paperless": "paperless-webserver",
    "paperless_db": "paperless-db",
    "mcp": "odoo-mcp",
    "sign": "usl-sign-dss"
  },
  "databases": {
    "odoo": {
      "service": "db",
      "name": "odoo_local",
      "user": "odoo",
      "password_key": "ODOO_DB_PASSWORD"
    },
    "paperless": {
      "service": "paperless-db",
      "name": "paperless_local",
      "user": "paperless",
      "password_key": "PAPERLESS_DB_PASSWORD"
    }
  },
  "volumes": {
    "odoo_postgres": {"name": "usl-odoo-local_postgres-data", "class": "transient"},
    "odoo_filestore": {"name": "usl-odoo-local_odoo-data", "class": "durable"},
    "paperless_postgres": {"name": "usl-odoo-local_paperless-postgres-data", "class": "transient"},
    "paperless_broker": {"name": "usl-odoo-local_paperless-broker-data", "class": "transient"},
    "paperless_media": {"name": "usl-odoo-local_paperless-media", "class": "durable"},
    "paperless_data": {"name": "usl-odoo-local_paperless-data", "class": "cache"},
    "paperless_trash": {"name": "usl-odoo-local_paperless-trash", "class": "durable"},
    "paperless_consume": {"name": "usl-odoo-local_paperless-consume", "class": "durable"},
    "mcp_oauth": {"name": "usl-odoo-local_odoo-mcp-oauth-data", "class": "durable"}
  },
  "paths": {
    "sign_ca": {"path": "/tmp/usl-odoo-local/sign/step-ca", "class": "durable", "required": true},
    "sign_evidence": {"path": "/tmp/usl-odoo-local/sign/evidence", "class": "durable", "required": false}
  },
  "external_networks": {},
  "endpoints": {
    "odoo": "http://odoo.localhost:28669",
    "paperless": "http://papers.localhost:28671",
    "mcp": "http://mcp.localhost:28672"
  },
  "ollama": {
    "mode": "native",
    "container": "",
    "network": "host",
    "url": "http://host.docker.internal:11434",
    "model": "bge-m3:latest",
    "manifest_sha256": "7907646426070047a77226ac3e684fbbe8410524f7b4a74d02837e43f2146bab",
    "dimension": 1024
  },
  "backup": {
    "durable_repository": "rest:/tmp/usl-odoo-local/restic/durable",
    "cache_repository": "rest:/tmp/usl-odoo-local/restic/cache"
  },
  "release_manifest": "/tmp/usl-odoo-local/usl-release.json",
  "secrets": {
    "env_file": "/tmp/usl-odoo-local/operations.env",
    "allowed_keys": [
      "AWS_ACCESS_KEY_ID",
      "AWS_SECRET_ACCESS_KEY",
      "ODOO_DB_PASSWORD",
      "PAPERLESS_DB_PASSWORD",
      "RESTIC_PASSWORD",
      "USL_BACKUP_CACHE_PASSWORD"
    ]
  },
  "state_directory": "/tmp/usl-odoo-local/runtime"
}
