{
  "schema": "usl-runtime/v1",
  "name": "production",
  "environment": "production",
  "protected": true,
  "transport": {"type": "ssh", "host": "odoo"},
  "compose": {
    "project": "usl-odoo-production-main",
    "anchor_service": "odoo",
    "profiles": ["document-renderer", "mcp", "paperless", "sign"],
    "default_network": "usl-odoo-production-main_default",
    "resource_overlay": "compose.resources.production.json"
  },
  "services": {
    "odoo": "odoo",
    "odoo_db": "db",
    "paperless": "paperless-webserver",
    "paperless_db": "paperless-db",
    "paperless_broker": "paperless-broker",
    "paperless_gotenberg": "paperless-gotenberg",
    "paperless_tika": "paperless-tika",
    "mcp": "odoo-mcp",
    "renderer": "usl-document-renderer",
    "receipt_fetcher": "usl-receipt-fetcher",
    "receipt_egress": "usl-receipt-egress",
    "sign": "usl-sign-dss",
    "sign_ca": "usl-sign-step-ca"
  },
  "databases": {
    "odoo": {
      "service": "db",
      "name": "odoo_production",
      "user": "odoo",
      "password_key": "ODOO_DB_PASSWORD"
    },
    "paperless": {
      "service": "paperless-db",
      "name": "paperless",
      "user": "paperless",
      "password_key": "PAPERLESS_DB_PASSWORD"
    }
  },
  "storage": {"tiers": {
    "bulk": {"path": "/srv/storage", "reserve_bytes": 16106127360},
    "database": {"path": "/srv/db", "reserve_bytes": 2147483648},
    "local": {"path": "/var/lib/usl-odoo", "reserve_bytes": 2147483648}
  }},
  "volumes": {
    "odoo_postgres": {"name": "usl-odoo-production-main-postgres", "class": "transient", "tier": "database"},
    "odoo_filestore": {"name": "usl-odoo-production-main-odoo-data", "class": "durable", "tier": "bulk"},
    "paperless_postgres": {"name": "usl-odoo-production-main-paperless-postgres", "class": "transient", "tier": "database"},
    "paperless_broker": {"name": "usl-odoo-production-main-paperless-broker", "class": "transient", "tier": "database"},
    "paperless_media": {"name": "usl-odoo-production-main-paperless-media", "class": "durable", "tier": "bulk"},
    "paperless_data": {"name": "usl-odoo-production-main-paperless-data", "class": "cache", "tier": "bulk"},
    "paperless_trash": {"name": "usl-odoo-production-main-paperless-trash", "class": "durable", "tier": "bulk"},
    "paperless_consume": {"name": "usl-odoo-production-main-paperless-consume", "class": "durable", "tier": "bulk"},
    "paperless_export": {"name": "usl-odoo-production-main-paperless-export", "class": "transient", "tier": "bulk"},
    "mcp_oauth": {"name": "usl-odoo-production-main-odoo-mcp-oauth", "class": "durable", "tier": "database"},
    "receipt_control": {"name": "usl-odoo-production-main_receipt-control", "class": "transient", "tier": "local"}
  },
  "paths": {
    "mcp_secrets": {"path": "/run/usl-secrets/odoo-mcp", "class": "durable", "required": true, "tier": "local"},
    "paperless_personal_ai_keys": {"path": "/opt/usl-odoo/secrets/paperless-personal-ai-keys.json", "class": "durable", "required": true, "tier": "local"},
    "renderer_secrets": {"path": "/run/usl-secrets/document-renderer", "class": "durable", "required": true, "tier": "local"},
    "sign_secrets": {"path": "/opt/usl-odoo/secrets/sign", "class": "durable", "required": true, "tier": "local"},
    "sign_evidence": {"path": "/srv/usl/sign/evidence", "class": "durable", "required": false, "tier": "local"}
  },
  "external_networks": {
    "identity": "usl-identity",
    "ingress": "cloudflare",
    "ollama": "ollama"
  },
  "endpoints": {
    "odoo": "https://odoo.unstaticlabs.com",
    "paperless": "https://papers.unstaticlabs.com",
    "mcp": "https://odoo-mcp.unstaticlabs.com"
  },
  "admission_endpoints": {
    "odoo": "http://127.0.0.1:18069",
    "odoo_websocket": "http://127.0.0.1:18072",
    "paperless": "http://127.0.0.1:18010",
    "mcp": "http://127.0.0.1:18000"
  },
  "ingress": {
    "proxy_mode": true,
    "list_db": false,
    "dbfilter": "^odoo_production$",
    "websocket": true
  },
  "ollama": {
    "mode": "external",
    "container": "ollama",
    "network": "ollama",
    "url": "http://ollama:11434",
    "model": "bge-m3:latest",
    "manifest_sha256": "7907646426070047a77226ac3e684fbbe8410524f7b4a74d02837e43f2146bab",
    "dimension": 1024
  },
  "backup": {
    "durable_repository": "s3:https://dac5c03754f31ec46fbf248dccc54831.eu.r2.cloudflarestorage.com/usl-backups/odoo-production/continuous-durable",
    "cache_repository": "s3:https://dac5c03754f31ec46fbf248dccc54831.eu.r2.cloudflarestorage.com/usl-backups/odoo-production/continuous-cache"
  },
  "release_manifest": "/opt/usl-odoo/current/usl-release.json",
  "plan_signing": {"private_key": null, "public_key": "/opt/usl-odoo/secrets/upgrade-plan-signing.pub"},
  "cron_policy": {
    "mode": "managed",
    "path": "/opt/usl/deploy/production.cron-policy.json",
    "gates": {"always": true, "digest": false, "inbound_mail": true, "ots": false, "pdp_ereporting": false, "pdp_reception": true, "project_ratings": false, "purchase_reminders": false, "sales_automation": false, "smtp": true, "stock": false, "vies": false}
  },
  "secrets": {
    "env_file": "/opt/usl-odoo/secrets/operations.env",
    "allowed_keys": [
      "AWS_ACCESS_KEY_ID",
      "AWS_SECRET_ACCESS_KEY",
      "ODOO_DB_PASSWORD",
      "PAPERLESS_DB_PASSWORD",
      "RESTIC_PASSWORD",
      "USL_BACKUP_CACHE_PASSWORD"
    ]
  },
  "state_directory": "/var/lib/usl-odoo/runtime/production"
}
