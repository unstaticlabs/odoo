{
  "name": "USL Production Admission",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "exclude": [],
      "include": [
        "refs/heads/19-usl"
      ]
    }
  },
  "rules": [
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "USL source policy"
          },
          {
            "context": "USL compatibility"
          }
        ]
      }
    },
    {
      "type": "required_deployments",
      "parameters": {
        "required_deployment_environments": [
          "staging-release"
        ]
      }
    }
  ]
}
