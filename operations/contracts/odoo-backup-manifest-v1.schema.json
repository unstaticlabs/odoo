{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unstaticlabs.com/schemas/operations/odoo-backup-manifest-v1.schema.json",
  "title": "USL Odoo backup manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "backup_id", "created_at", "consistency", "source", "tool", "database", "filestore"],
  "properties": {
    "schema": {"const": "usl-odoo-backup/v1"},
    "backup_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,95}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "consistency": {"enum": ["live", "quiesced"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["database", "postgres_version", "postgres_version_num", "pg_dump_version", "git_sha", "image_digest_reference"],
      "properties": {
        "database": {"type": "string", "minLength": 1},
        "postgres_version": {"type": "string", "minLength": 1},
        "postgres_version_num": {"type": "integer", "minimum": 160000, "maximum": 169999},
        "pg_dump_version": {"type": "string", "pattern": "^16(?:\\.|$)"},
        "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "image_digest_reference": {"type": "string", "pattern": "^ghcr\\.io/unstaticlabs/usl-odoo@sha256:[0-9a-f]{64}$"}
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image_digest_reference"],
      "properties": {
        "image_digest_reference": {"type": "string", "pattern": "^ghcr\\.io/unstaticlabs/usl-odoo-operations@sha256:[0-9a-f]{64}$"}
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dump_file", "dump_bytes", "dump_sha256", "row_counts"],
      "properties": {
        "dump_file": {"const": "database.dump"},
        "dump_bytes": {"type": "integer", "minimum": 1},
        "dump_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "row_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["res_users", "res_company", "ir_module_module", "res_partner", "account_move", "ir_attachment"],
          "properties": {
            "res_users": {"type": "integer", "minimum": 1},
            "res_company": {"type": "integer", "minimum": 1},
            "ir_module_module": {"type": "integer", "minimum": 1},
            "res_partner": {"type": "integer", "minimum": 1},
            "account_move": {"type": "integer", "minimum": 0},
            "ir_attachment": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "filestore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directory", "file_count", "total_bytes", "stored_attachment_count", "missing_attachment_count"],
      "properties": {
        "directory": {"const": "filestore"},
        "file_count": {"type": "integer", "minimum": 0},
        "total_bytes": {"type": "integer", "minimum": 0},
        "stored_attachment_count": {"type": "integer", "minimum": 0},
        "missing_attachment_count": {"const": 0}
      }
    }
  }
}
