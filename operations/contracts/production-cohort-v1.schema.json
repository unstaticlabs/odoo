{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unstaticlabs.com/contracts/usl-production-cohort-v1.schema.json",
  "title": "usl-production-cohort/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "cohort_id", "created_at", "release", "storage", "models", "queues", "restore_evidence", "secrets", "contract_sha256"],
  "properties": {
    "schema": {"const": "usl-production-cohort/v1"},
    "cohort_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "release": {
      "type": "object", "additionalProperties": false,
      "required": ["source_commit_sha", "release_contract_sha256", "artifacts"],
      "properties": {
        "source_commit_sha": {"$ref": "#/$defs/commit"},
        "release_contract_sha256": {"$ref": "#/$defs/sha256"},
        "artifacts": {"$ref": "#/$defs/artifactPins"}
      }
    },
    "storage": {
      "type": "object", "additionalProperties": false,
      "required": ["odoo_postgresql", "odoo_filestore", "paperless_postgresql", "paperless_media", "paperless_data", "paperless_search", "paperless_vector", "paperless_export", "paperless_trash", "ollama_models", "native_sign_step_ca", "native_sign_evidence"],
      "properties": {
        "odoo_postgresql": {"$ref": "#/$defs/unit"}, "odoo_filestore": {"$ref": "#/$defs/unit"},
        "paperless_postgresql": {"$ref": "#/$defs/unit"}, "paperless_media": {"$ref": "#/$defs/unit"},
        "paperless_data": {"$ref": "#/$defs/unit"}, "paperless_search": {"$ref": "#/$defs/unit"},
        "paperless_vector": {"$ref": "#/$defs/unit"}, "paperless_export": {"$ref": "#/$defs/unit"},
        "paperless_trash": {"$ref": "#/$defs/unit"}, "ollama_models": {"$ref": "#/$defs/unit"},
        "native_sign_step_ca": {"$ref": "#/$defs/unit"}, "native_sign_evidence": {"$ref": "#/$defs/unit"}
      }
    },
    "models": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "digest", "archive_sha256"], "properties": {"name": {"type": "string"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "archive_sha256": {"$ref": "#/$defs/sha256"}}}},
    "queues": {"type": "object", "additionalProperties": false, "required": ["odoo_jobs", "paperless_broker"], "properties": {"odoo_jobs": {"$ref": "#/$defs/queue"}, "paperless_broker": {"$ref": "#/$defs/queue"}}},
    "restore_evidence": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["component", "environment", "restored_at", "verification_sha256", "status"], "properties": {"component": {"type": "string"}, "environment": {"const": "fresh_isolated_volumes"}, "restored_at": {"type": "string", "format": "date-time"}, "verification_sha256": {"$ref": "#/$defs/sha256"}, "status": {"const": "verified"}}}},
    "secrets": {"type": "object", "additionalProperties": false, "required": ["provider", "copied"], "properties": {"provider": {"const": "infisical"}, "copied": {"const": false}}},
    "contract_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "digestReference": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*@sha256:[0-9a-f]{64}$"},
    "artifactPins": {"type": "object", "additionalProperties": false, "required": ["odoo_distribution", "operations_tool", "paperless_overlay", "document_renderer", "native_sign_dss"], "properties": {"odoo_distribution": {"$ref": "#/$defs/digestReference"}, "operations_tool": {"$ref": "#/$defs/digestReference"}, "paperless_overlay": {"$ref": "#/$defs/digestReference"}, "document_renderer": {"$ref": "#/$defs/digestReference"}, "native_sign_dss": {"$ref": "#/$defs/digestReference"}}},
    "unit": {"type": "object", "additionalProperties": false, "required": ["snapshot_id", "sha256", "size_bytes"], "properties": {"snapshot_id": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}, "size_bytes": {"type": "integer", "minimum": 0}}},
    "queue": {"type": "object", "additionalProperties": false, "required": ["state", "pending", "authoritative"], "properties": {"state": {"const": "drained"}, "pending": {"const": 0}, "authoritative": {"const": false}}}
  }
}
