# Copy outside the repository, chmod 0600, and replace every CHANGE_ME value.
# Pocket ID already exists: this stack must never own its container or data.
COMPOSE_PROJECT_NAME=usl-odoo-production-main
USL_DEPLOYMENT_ENV=production

POSTGRES_IMAGE=postgres:16-bookworm
POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=CHANGE_ME_ODOO_DATABASE_PASSWORD_24_CHARS
ODOO_DB_HOST=db
ODOO_DB_PORT=5432
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=CHANGE_ME_ODOO_DATABASE_PASSWORD_24_CHARS
ODOO_DB_NAME=odoo_production
ODOO_INIT_DB=odoo_production
ODOO_DB_FILTER=^odoo_production$
ODOO_ADMIN_PASSWORD=CHANGE_ME_ODOO_MASTER_PASSWORD_32_CHARS
ODOO_IMAGE=ghcr.io/unstaticlabs/usl-odoo@sha256:CHANGE_ME_64_HEX_DIGEST
ODOO_HTTP_PORT=18069
ODOO_GEVENT_PORT=18072
ODOO_LIST_DB=False
ODOO_WORKERS=4
ODOO_DB_MAXCONN=12
ODOO_LIMIT_MEMORY_SOFT=1073741824
ODOO_LIMIT_MEMORY_HARD=1342177280
ODOO_LIMIT_REQUEST=8192
# Staging and admission start with cron paused. `admit` applies the separately
# reviewed USL_PRODUCTION_CRON_THREADS value.
ODOO_MAX_CRON_THREADS=0
USL_PRODUCTION_CRON_THREADS=1
USL_PRODUCTION_CRON_GATES_JSON={"always":true,"digest":false,"inbound_mail":false,"ots":false,"pdp_ereporting":false,"pdp_reception":false,"project_ratings":false,"purchase_reminders":false,"sales_automation":false,"smtp":true,"stock":false,"vies":false}
USL_EINVOICE_LIVE_ENABLED=0
USL_EREPORTING_LIVE_ENABLED=0

# Host-level SMTP is authoritative. Production admission removes every
# database ir.mail_server row before cron workers are enabled.
ODOO_SMTP_SERVER=smtp.resend.com
ODOO_SMTP_PORT=587
ODOO_SMTP_SSL=True
ODOO_SMTP_USER=resend
ODOO_SMTP_PASSWORD=CHANGE_ME_EXISTING_KOMODO_RESEND_SECRET
ODOO_EMAIL_FROM=odoo@unstaticlabs.com
ODOO_FROM_FILTER=unstaticlabs.com

# Odoo MCP — publish the pinned external source as an immutable registry image.
# The two files are independent mode-0600 secret-manager outputs. The OAuth
# database starts empty in production; local grants are never transferred.
ODOO_MCP_IMAGE=ghcr.io/unstaticlabs/odoo-mcp@sha256:c1c0861cd1e3f70fd7ecb17cf2108b4aafbe86b2b0901cf63fe36d18420c02ed
ODOO_MCP_RELEASE_COMMIT=78515eaf6b03441e1b67f27979246247ac270d71
ODOO_MCP_PUBLIC_ORIGIN=https://mcp.example.invalid
ODOO_MCP_HTTP_PORT=18000
ODOO_MCP_ALLOW_LOCAL_HTTP_ODOO=false
ODOO_MCP_ALLOWED_HOSTS=mcp.example.invalid
ODOO_MCP_HEALTHCHECK_HOST=mcp.example.invalid
ODOO_MCP_ALLOWED_ORIGINS=chatgpt.com,claude.ai
ODOO_MCP_OAUTH_TRUSTED_ORIGINS=https://chatgpt.com,https://claude.ai
ODOO_MCP_BETTER_AUTH_SECRET_FILE=/run/usl-secrets/odoo-mcp/better-auth.secret
ODOO_MCP_CREDENTIAL_ENCRYPTION_KEY_FILE=/run/usl-secrets/odoo-mcp/credential-encryption-key.secret

# Native Sign — immutable service images and secret-manager-owned directories.
USL_DOCUMENT_RENDERER_IMAGE=ghcr.io/unstaticlabs/usl-document-renderer@sha256:CHANGE_ME_64_HEX_DIGEST
USL_SIGN_STEP_CA_IMAGE=smallstep/step-ca@sha256:a2b17872915c193259b75a5474c398326f41bd199f0842093e52cf4182bc8270
USL_SIGN_DSS_IMAGE=ghcr.io/unstaticlabs/usl-sign-dss@sha256:CHANGE_ME_64_HEX_DIGEST
USL_DOCUMENT_RENDERER_CERT_DIR=/run/usl-secrets/document-renderer
USL_SIGN_STEP_CA_DIR=/run/usl-secrets/sign/step-ca
USL_SIGN_DSS_SECRET_DIR=/run/usl-secrets/sign/dss
USL_SIGN_ODOO_SECRET_DIR=/run/usl-secrets/sign/odoo
USL_SIGN_EVIDENCE_DIR=/srv/usl/sign/evidence

PAPERLESS_IMAGE=ghcr.io/unstaticlabs/usl-paperless-ngx@sha256:CHANGE_ME_64_HEX_DIGEST
PAPERLESS_BASE_IMAGE=ghcr.io/paperless-ngx/paperless-ngx@sha256:65a4cabf0169ea7fbd90ab7bb28ba3f8b5909613635acda1a03ad606f34b456b
# Existing mode-0600 key ring populated by the deployment secret manager.
# Production reconstruction validates this before resetting the target.
USL_PERSONAL_AI_MASTER_KEYS_HOST_PATH=CHANGE_ME_SECRET_MANAGER_FILE_PATH
PAPERLESS_POSTGRES_IMAGE=postgres:16-bookworm
PAPERLESS_BROKER_IMAGE=valkey/valkey:9.1.1-alpine
PAPERLESS_GOTENBERG_IMAGE=gotenberg/gotenberg:8.36@sha256:87c16b9f364279d321bc9772d31fa58aa6abe036423c270698bd636c3a8e9466
PAPERLESS_TIKA_IMAGE=apache/tika:3.3.1.0-full
OLLAMA_IMAGE=ollama/ollama:0.32.5@sha256:4dea9fb511947e24a84237bb636b0203abcb2ff0d3fbc7b4ff865deb91362131
USL_OLLAMA_RUNTIME=external
USL_EXTERNAL_OLLAMA_CONTAINER=ollama
USL_EXTERNAL_OLLAMA_NETWORK=ollama
USL_OLLAMA_MANIFEST_SHA256=7907646426070047a77226ac3e684fbbe8410524f7b4a74d02837e43f2146bab
USL_OLLAMA_EMBEDDING_DIMENSION=1024
PAPERLESS_DB_NAME=paperless
PAPERLESS_DB_USER=paperless
PAPERLESS_DB_PASSWORD=CHANGE_ME_PAPERLESS_DATABASE_PASSWORD_24_CHARS
PAPERLESS_SECRET_KEY=CHANGE_ME_PAPERLESS_APPLICATION_SECRET_48_CHARACTERS
PAPERLESS_INTERNAL_URL=http://paperless-webserver:8000
PAPERLESS_PUBLIC_URL=https://documents.example.invalid
PAPERLESS_PUBLIC_BASE_URL=https://documents.example.invalid
PAPERLESS_ALLOWED_HOSTS=documents.example.invalid,paperless-webserver
PAPERLESS_CORS_ALLOWED_HOSTS=https://documents.example.invalid
PAPERLESS_CSRF_TRUSTED_ORIGINS=https://documents.example.invalid
PAPERLESS_HTTP_PORT=18010
PAPERLESS_TIME_ZONE=Europe/Paris
PAPERLESS_OCR_LANGUAGE=fra+eng
PAPERLESS_CONSUMER_ENABLE_BARCODES=true
PAPERLESS_EMPTY_TRASH_DELAY=36500
PAPERLESS_AI_ENABLED=true
PAPERLESS_USL_DEFER_SEMANTIC_INDEX=false
PAPERLESS_AI_LLM_EMBEDDING_BACKEND=ollama
PAPERLESS_AI_LLM_EMBEDDING_MODEL=bge-m3:latest
PAPERLESS_AI_LLM_EMBEDDING_ENDPOINT=http://ollama:11434
PAPERLESS_AI_LLM_EMBEDDING_CHUNK_SIZE=512
PAPERLESS_AI_LLM_EMBEDDING_BATCH_SIZE=32
PAPERLESS_AI_LLM_CONTEXT_SIZE=8192
PAPERLESS_AI_LLM_REQUEST_TIMEOUT=300
PAPERLESS_EMAIL_TASK_CRON=disable
PAPERLESS_TRAIN_TASK_CRON=disable
PAPERLESS_SANITY_TASK_CRON=disable
PAPERLESS_EMPTY_TRASH_TASK_CRON=disable
PAPERLESS_WORKFLOW_SCHEDULED_TASK_CRON=disable
PAPERLESS_SHARE_LINK_BUNDLE_CLEANUP_CRON=disable
PAPERLESS_LLM_INDEX_TASK_CRON=10 2 * * *
PAPERLESS_SSO_BASE_GROUP=USL Odoo document users
PAPERLESS_OIDC_ENABLED=1
PAPERLESS_DISABLE_REGULAR_LOGIN=true
PAPERLESS_REDIRECT_LOGIN_TO_SSO=true
PAPERLESS_SOCIAL_ACCOUNT_SYNC_GROUPS=false

# Existing external Pocket ID. Odoo and Paperless require distinct clients.
POCKET_ID_APP_URL=https://identity.example.invalid
POCKET_ID_GROUP_NAME=odoo-production
POCKET_ID_CLIENT_ID=usl-odoo-production
POCKET_ID_CLIENT_SECRET=CHANGE_ME_EXISTING_ODOO_OIDC_CLIENT_SECRET
POCKET_ID_PAPERLESS_CLIENT_ID=usl-paperless-production
POCKET_ID_PAPERLESS_CLIENT_SECRET=CHANGE_ME_EXISTING_PAPERLESS_OIDC_CLIENT_SECRET
ODOO_PUBLIC_BASE_URL=https://odoo.example.invalid
USL_POCKET_ID_LOGIN_POLICY=sso_only
USL_POCKET_ID_ALLOW_UNIQUE_EMAIL_LINK=0
USL_POCKET_ID_BREAK_GLASS_ENABLED=0
USL_POCKET_ID_BREAK_GLASS_EXPIRES_AT=
USL_POCKET_ID_BREAK_GLASS_PASSWORD=CHANGE_ME_BREAK_GLASS_PASSWORD_MANAGER_SECRET

# Existing networks are inspected read-only. Ingress activation remains an
# infrastructure-owner operation after `admit`.
USL_EXTERNAL_IDENTITY_NETWORK=identity-production
USL_EXTERNAL_INGRESS_NETWORK=ingress-production

# Fresh dedicated candidate-owned application volumes.
USL_ODOO_POSTGRES_VOLUME=usl-odoo-production-main-postgres
USL_ODOO_DATA_VOLUME=usl-odoo-production-main-odoo-data
USL_PAPERLESS_POSTGRES_VOLUME=usl-odoo-production-main-paperless-postgres
USL_PAPERLESS_BROKER_VOLUME=usl-odoo-production-main-paperless-broker
USL_PAPERLESS_DATA_VOLUME=usl-odoo-production-main-paperless-data
USL_PAPERLESS_MEDIA_VOLUME=usl-odoo-production-main-paperless-media
USL_PAPERLESS_EXPORT_VOLUME=usl-odoo-production-main-paperless-export
USL_PAPERLESS_CONSUME_VOLUME=usl-odoo-production-main-paperless-consume
USL_PAPERLESS_TRASH_VOLUME=usl-odoo-production-main-paperless-trash
USL_ODOO_MCP_OAUTH_VOLUME=usl-odoo-production-main-odoo-mcp-oauth
