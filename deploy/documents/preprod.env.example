# Copy outside the repository, replace every CHANGE_ME value from the secret
# manager, and pass its path with USL_DOCUMENTS_PREPROD_ENV.
COMPOSE_PROJECT_NAME=usl-documents-preprod
USL_DEPLOYMENT_ENV=preproduction

POSTGRES_IMAGE=postgres:16-bookworm
POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=CHANGE_ME_ODOO_DATABASE_PASSWORD

ODOO_IMAGE=registry.example.invalid/usl-odoo:CHANGE_ME_GIT_REVISION
ODOO_DB_HOST=db
ODOO_DB_PORT=5432
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=CHANGE_ME_ODOO_DATABASE_PASSWORD
ODOO_DB_NAME=odoo_usl_documents_preprod
ODOO_ADMIN_PASSWORD=CHANGE_ME_ODOO_MASTER_PASSWORD
ODOO_INIT_DB=odoo_usl_documents_preprod
ODOO_INIT_MODULES=usl_documents
ODOO_DB_FILTER=^odoo_usl_documents_preprod$
ODOO_HTTP_PORT=28080
ODOO_GEVENT_PORT=28072
ODOO_HTTP_INTERFACE=0.0.0.0
ODOO_WORKERS=2
ODOO_MAX_CRON_THREADS=1
ODOO_DB_MAXCONN=20
ODOO_LIMIT_MEMORY_SOFT=1073741824
ODOO_LIMIT_MEMORY_HARD=1342177280
ODOO_LIMIT_REQUEST=8192
USL_EINVOICE_LIVE_ENABLED=0
USL_EREPORTING_LIVE_ENABLED=0

# Pocket ID — Odoo and Paperless use distinct confidential OIDC clients.
POCKET_ID_IMAGE=ghcr.io/pocket-id/pocket-id:v2.14.0@sha256:01540977dcf4c7b41b1159f34d68e4632f2658d62790e460ca65a42722b13c4a
POCKET_ID_APP_URL=https://identity-preprod.example.invalid
POCKET_ID_HOSTNAME=identity-preprod.example.invalid
POCKET_ID_HTTP_PORT=24110
POCKET_ID_ENCRYPTION_KEY=CHANGE_ME_POCKET_ENCRYPTION_KEY
POCKET_ID_STATIC_API_KEY=CHANGE_ME_POCKET_STATIC_API_KEY
POCKET_ID_GROUP_NAME=documents-preproduction
POCKET_ID_CLIENT_ID=usl-odoo-preproduction
POCKET_ID_CLIENT_SECRET=CHANGE_ME_ODOO_OIDC_CLIENT_SECRET
POCKET_ID_PAPERLESS_CLIENT_ID=usl-paperless-preproduction
POCKET_ID_PAPERLESS_CLIENT_SECRET=CHANGE_ME_PAPERLESS_OIDC_CLIENT_SECRET
ODOO_PUBLIC_BASE_URL=https://odoo-preprod.example.invalid
PAPERLESS_PUBLIC_BASE_URL=https://documents-preprod.example.invalid
PAPERLESS_OIDC_ENABLED=1
PAPERLESS_DISABLE_REGULAR_LOGIN=true
PAPERLESS_REDIRECT_LOGIN_TO_SSO=true
PAPERLESS_SOCIAL_ACCOUNT_SYNC_GROUPS=false

PAPERLESS_IMAGE=registry.example.invalid/usl-paperless-ngx:CHANGE_ME_RELEASE_ID
PAPERLESS_BASE_IMAGE=ghcr.io/paperless-ngx/paperless-ngx@sha256:65a4cabf0169ea7fbd90ab7bb28ba3f8b5909613635acda1a03ad606f34b456b
# Host path populated by the deployment secret manager. The file contains the
# active envelope-key identifier/version and the current plus retained keys.
USL_PERSONAL_AI_MASTER_KEYS_HOST_PATH=CHANGE_ME_SECRET_MANAGER_FILE_PATH
PAPERLESS_POSTGRES_IMAGE=postgres:16-bookworm
PAPERLESS_BROKER_IMAGE=valkey/valkey:9.1.1-alpine
PAPERLESS_GOTENBERG_IMAGE=gotenberg/gotenberg:8.36@sha256:87c16b9f364279d321bc9772d31fa58aa6abe036423c270698bd636c3a8e9466
PAPERLESS_TIKA_IMAGE=apache/tika:3.3.1.0-full
OLLAMA_IMAGE=ollama/ollama:0.32.15@sha256:57d60e686821ea81a7748a3ec8141308c8b8f95b27105713954abf7a6529e700
PAPERLESS_DB_NAME=paperless
PAPERLESS_DB_USER=paperless
PAPERLESS_DB_PASSWORD=CHANGE_ME_PAPERLESS_DATABASE_PASSWORD_24_CHARS
PAPERLESS_SECRET_KEY=CHANGE_ME_PAPERLESS_APPLICATION_SECRET_48_CHARACTERS
PAPERLESS_INTERNAL_URL=http://paperless-webserver:8000
PAPERLESS_PUBLIC_URL=https://documents-preprod.example.invalid
PAPERLESS_ACCOUNT_DEFAULT_HTTP_PROTOCOL=https
PAPERLESS_SSO_BASE_GROUP=USL Odoo document users
PAPERLESS_ALLOWED_HOSTS=documents-preprod.example.invalid,paperless-webserver
PAPERLESS_CORS_ALLOWED_HOSTS=https://documents-preprod.example.invalid
PAPERLESS_CSRF_TRUSTED_ORIGINS=https://documents-preprod.example.invalid
PAPERLESS_HTTP_PORT=28010
PAPERLESS_TIME_ZONE=Europe/Paris
PAPERLESS_OCR_LANGUAGE=fra+eng
PAPERLESS_CONSUMER_ENABLE_BARCODES=true
PAPERLESS_EMPTY_TRASH_DELAY=CHANGE_ME_AT_LEAST_36500_DAYS
PAPERLESS_AI_ENABLED=true
PAPERLESS_USL_DEFER_SEMANTIC_INDEX=false
PAPERLESS_AI_LLM_EMBEDDING_BACKEND=ollama
PAPERLESS_AI_LLM_EMBEDDING_MODEL=usl-bge-m3:documents-20260824-rc1
PAPERLESS_AI_LLM_EMBEDDING_CHUNK_SIZE=512
PAPERLESS_AI_LLM_EMBEDDING_BATCH_SIZE=32
PAPERLESS_AI_LLM_CONTEXT_SIZE=8192
PAPERLESS_AI_LLM_REQUEST_TIMEOUT=300
PAPERLESS_EMAIL_TASK_CRON=disable
PAPERLESS_TRAIN_TASK_CRON=disable
PAPERLESS_SANITY_TASK_CRON=disable
PAPERLESS_EMPTY_TRASH_TASK_CRON=disable
PAPERLESS_WORKFLOW_SCHEDULED_TASK_CRON=disable
PAPERLESS_SHARE_LINK_BUNDLE_CLEANUP_CRON=disable
PAPERLESS_LLM_INDEX_TASK_CRON=10 2 * * *
