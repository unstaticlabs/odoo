# Copy outside the repository, replace every CHANGE_ME value from the secret
# manager, and pass its path with USL_DOCUMENTS_PREPROD_ENV.
COMPOSE_PROJECT_NAME=usl-documents-preprod
USL_DEPLOYMENT_ENV=preproduction

POSTGRES_IMAGE=postgres:16-bookworm
POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=CHANGE_ME_ODOO_DATABASE_PASSWORD

ODOO_IMAGE=registry.example.invalid/usl-odoo:CHANGE_ME_GIT_REVISION
ODOO_DB_HOST=db
ODOO_DB_PORT=5432
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=CHANGE_ME_ODOO_DATABASE_PASSWORD
ODOO_ADMIN_PASSWORD=CHANGE_ME_ODOO_MASTER_PASSWORD
ODOO_INIT_DB=odoo_usl_documents_preprod
ODOO_INIT_MODULES=usl_documents
ODOO_DB_FILTER=^odoo_usl_documents_preprod$
ODOO_HTTP_PORT=28080
ODOO_GEVENT_PORT=28072
ODOO_HTTP_INTERFACE=0.0.0.0
ODOO_MAX_CRON_THREADS=1
USL_EINVOICE_LIVE_ENABLED=0
USL_EREPORTING_LIVE_ENABLED=0

PAPERLESS_IMAGE=ghcr.io/paperless-ngx/paperless-ngx:3.0.4
PAPERLESS_POSTGRES_IMAGE=postgres:16-bookworm
PAPERLESS_BROKER_IMAGE=valkey/valkey:8.1.3-alpine
PAPERLESS_GOTENBERG_IMAGE=gotenberg/gotenberg:8.34
PAPERLESS_TIKA_IMAGE=apache/tika:3.2.3.0-full
PAPERLESS_DB_NAME=paperless
PAPERLESS_DB_USER=paperless
PAPERLESS_DB_PASSWORD=CHANGE_ME_PAPERLESS_DATABASE_PASSWORD_24_CHARS
PAPERLESS_SECRET_KEY=CHANGE_ME_PAPERLESS_APPLICATION_SECRET_48_CHARACTERS
PAPERLESS_INTERNAL_URL=http://paperless-webserver:8000
PAPERLESS_PUBLIC_URL=https://documents-preprod.example.invalid
PAPERLESS_ALLOWED_HOSTS=documents-preprod.example.invalid,paperless-webserver
PAPERLESS_CORS_ALLOWED_HOSTS=https://documents-preprod.example.invalid
PAPERLESS_CSRF_TRUSTED_ORIGINS=https://documents-preprod.example.invalid
PAPERLESS_HTTP_PORT=28010
PAPERLESS_TIME_ZONE=Europe/Paris
PAPERLESS_OCR_LANGUAGE=fra+eng
PAPERLESS_CONSUMER_ENABLE_BARCODES=true
PAPERLESS_EMPTY_TRASH_DELAY=CHANGE_ME_AT_LEAST_36500_DAYS
