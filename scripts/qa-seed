#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
# shellcheck source=lib/compose-scope.sh
source "$ROOT/scripts/lib/compose-scope.sh"
# shellcheck source=lib/cli-ui.sh
source "$ROOT/scripts/lib/cli-ui.sh"
# shellcheck source=lib/transition-live.sh
source "$ROOT/scripts/lib/transition-live.sh"
usl_cli_load_local_port_defaults "$ROOT"

command_name="${1:-status}"
compose_project="${COMPOSE_PROJECT_NAME:-usl-odoo-saas-19-3}"
database="${ODOO_DEV_DB:-odoo_dev}"
common_git_dir="$(git rev-parse --path-format=absolute --git-common-dir)"
main_checkout="$(cd "$(dirname "$common_git_dir")" && pwd -P)"
source_dump_dir="${USL_ONLINE_DUMP_DIR:-$main_checkout/usl-online-dump}"
source_dump="$source_dump_dir/dump.sql"
cache_root="${USL_QA_SEED_CACHE_DIR:-$main_checkout/artifacts/migration/private/qa-seeds}"
pending_dir="$cache_root/.pending-$compose_project"
current_link="$cache_root/current"
compose=(docker compose -p "$compose_project")
if [[ -n "${POCKET_ID_ENV_FILE:-}" ]]; then
    # Canonical Documents reconstruction initializes Paperless with the
    # project-bound generated database password.  Every later Compose action
    # on those same volumes must resolve the identical environment; otherwise
    # recreating the web/database containers silently falls back to the public
    # development defaults and makes the archive unavailable.
    compose+=(--env-file "$POCKET_ID_ENV_FILE")
fi

export USL_EINVOICE_LIVE_ENABLED=0
export USL_EREPORTING_LIVE_ENABLED=0
export COMPOSE_IGNORE_ORPHANS=1

case "$command_name" in
    capture|publish|discard)
        usl_refuse_protected_transition "$ROOT" "$compose_project" "QA seed $command_name"
        ;;
esac

require_source() {
    if [[ ! -f "$source_dump" || ! -d "$source_dump_dir/filestore" ]]; then
        usl_cli_blocked \
            "The current Odoo Online source package is incomplete." \
            "Expected dump.sql and filestore under $source_dump_dir." \
            "Set USL_ONLINE_DUMP_DIR to the complete local export."
        exit 2
    fi
}

require_safe_cache_root() {
    mkdir -p "$cache_root"
    chmod 700 "$cache_root"
    cache_root="$(cd "$cache_root" && pwd -P)"
    case "$cache_root" in
        "$main_checkout"/artifacts/migration/private/qa-seeds|\
        "$main_checkout"/artifacts/migration/private/qa-seeds/*) ;;
        *)
            if [[ "${USL_QA_SEED_ALLOW_EXTERNAL_CACHE:-0}" != 1 ]]; then
                printf 'Refusing external QA seed cache: %s\n' "$cache_root" >&2
                exit 2
            fi
            ;;
    esac
}

runtime_identity() {
    local output="$1" config_file service image_ref image_id
    local -a image_arguments
    config_file="$(mktemp "${TMPDIR:-/tmp}/usl-qa-compose.json.XXXXXX")"
    "${compose[@]}" --profile paperless config --format json > "$config_file"
    for service in \
        db odoo paperless-db paperless-webserver paperless-gotenberg paperless-tika
    do
        image_ref="$(
            python3 -c \
                'import json,sys; print(json.load(open(sys.argv[1]))["services"][sys.argv[2]]["image"])' \
                "$config_file" "$service"
        )"
        image_id="$(docker image inspect "$image_ref" --format '{{.Id}}' 2>/dev/null || true)"
        if [[ -z "$image_id" ]]; then
            printf 'Required QA runtime image is not available locally: %s (%s)\n' \
                "$service" "$image_ref" >&2
            printf 'Pull or build the configured image, then retry.\n' >&2
            rm -f "$config_file"
            return 2
        fi
        image_arguments+=(--image-id "$service=$image_id")
    done
    python3 scripts/qa_seed.py runtime \
        --compose-config "$config_file" \
        "${image_arguments[@]}" \
        --output "$output"
    rm -f "$config_file"
}

seed_directory() {
    if [[ ! -L "$current_link" ]]; then
        printf 'QA seed is missing: %s\n' "$current_link" >&2
        return 2
    fi
    (cd "$cache_root" && cd "$(readlink "$current_link")" && pwd -P)
}

verify_seed() {
    local seed_dir="$1" runtime_json="$2"
    python3 scripts/qa_seed.py verify \
        --root "$ROOT" \
        --seed-dir "$seed_dir" \
        --source-dump "$source_dump" \
        --runtime-json "$runtime_json" \
        --commit "$(git rev-parse HEAD)"
}

capture() {
    local accounting_controls accounting_status documents_controls
    local collaboration_evidence collaboration_sha256 source_sha256
    local runtime_json export_name odoo_volume commit qualification_json module_versions
    local paperless_documents
    require_source
    require_safe_cache_root
    if [[ "$ROOT" != "$main_checkout" ]]; then
        printf 'QA seed refresh is reserved for the main checkout: %s\n' "$main_checkout" >&2
        exit 2
    fi
    if [[ "${USL_MIGRATION_PURPOSE:-}" != qa-cache \
        || "${USL_QA_DATA_PROFILE:-}" != full \
        || "${USL_QA_SEED_REFRESH:-}" != 1 ]]; then
        printf 'QA seed capture requires the canonical fresh full qa-cache run.\n' >&2
        exit 2
    fi
    if [[ "$(git branch --show-current)" != 19-usl \
        || -n "$(git status --porcelain=v1 --untracked-files=all)" ]]; then
        printf 'QA seed publication requires the clean 19-usl main checkout.\n' >&2
        exit 2
    fi
    usl_require_explicit_compose_project "QA seed capture"
    usl_verify_compose_scope "$compose_project" "$ROOT" "QA seed capture"
    if [[ "$database" != odoo_dev ]]; then
        printf 'QA seed capture is reserved for odoo_dev.\n' >&2
        exit 2
    fi
    if [[ -e "$pending_dir" ]]; then
        printf 'A pending QA seed already exists: %s\n' "$pending_dir" >&2
        exit 2
    fi

    usl_cli_title "capture private QA seed"
    usl_cli_step 1 "Verify finalized migration state"
    "${compose[@]}" up -d --wait db
    "${compose[@]}" --profile paperless up -d --wait --pull never \
        paperless-preflight paperless-db paperless-broker paperless-trash-init \
        paperless-gotenberg paperless-tika paperless-webserver
    if [[ "$("${compose[@]}" exec -T db psql -X -qAt -U odoo -d odoo_dev -c \
        "SELECT count(*) FROM ir_module_module WHERE name LIKE 'usl%restore' AND state='installed'")" != 0 ]]; then
        printf 'Temporary migration modules remain installed; refusing seed capture.\n' >&2
        exit 1
    fi
    "${compose[@]}" stop odoo >/dev/null 2>&1 || true
    "${compose[@]}" --profile init run --rm -T \
        -e ODOO_INIT_DB=odoo_dev \
        init-db odoo shell \
        --config=/etc/odoo/odoo.conf \
        --database=odoo_dev \
        --shell-interface=python \
        < "$ROOT/scripts/odoo/qa_seed_sanitize.py"
    scripts/check-product-migration-boundary
    scripts/check-product-database-boundary

    umask 077
    mkdir "$pending_dir"
    runtime_json="$pending_dir/runtime.json"
    runtime_identity "$runtime_json"

    usl_cli_step 2 "Export Paperless without API tokens"
    export_name="qa-seed-$compose_project-$(date -u +%Y%m%dT%H%M%SZ)"
    "${compose[@]}" exec -T paperless-webserver \
        python manage.py document_sanity_checker
    paperless_documents="$(
        "${compose[@]}" exec -T paperless-webserver \
            python manage.py shell -c \
            'from documents.models import Document; print(Document.objects.count())' \
            | tail -n 1
    )"
    "${compose[@]}" exec -T --user paperless paperless-webserver \
        mkdir -p "/usr/src/paperless/export/$export_name"
    "${compose[@]}" exec -T --user paperless paperless-webserver \
        python manage.py document_exporter \
        "/usr/src/paperless/export/$export_name" \
        --compare-checksums --delete --no-progress-bar
    mkdir "$pending_dir/paperless-export"
    docker cp \
        "$("${compose[@]}" ps -q paperless-webserver):/usr/src/paperless/export/$export_name/." \
        "$pending_dir/paperless-export"
    # A reusable seed must not retain Paperless OIDC subjects, sessions,
    # provider applications, mail/webhook integrations, or environment-bound
    # application configuration.  Hydration provisions fresh identities and
    # configuration for its isolated Compose project.
    python3 scripts/paperless_seed_sanitize.py --portable-candidate \
        "$pending_dir/paperless-export"

    usl_cli_step 3 "Snapshot Odoo database and filestore"
    "${compose[@]}" stop odoo >/dev/null 2>&1 || true
    "${compose[@]}" exec -T db pg_dump -U odoo -Fc odoo_dev \
        > "$pending_dir/odoo.dump"
    odoo_volume="${compose_project}_odoo-data"
    docker volume inspect "$odoo_volume" >/dev/null
    docker run --rm \
        -v "$odoo_volume:/source:ro" \
        -v "$pending_dir:/backup" \
        alpine:3.24.1 \
        tar -C /source/filestore -czf /backup/odoo-filestore.tgz odoo_dev

    qualification_json="$pending_dir/qualification.json"
    module_versions="$("${compose[@]}" exec -T db psql -X -qAt -U odoo -d odoo_dev -c \
        "SELECT COALESCE(json_object_agg(name, latest_version ORDER BY name)::text, '{}') FROM ir_module_module WHERE state='installed' AND (name LIKE 'usl_%' OR name='rebuild_account_migration')")"
    accounting_status="$ROOT/artifacts/accounting-compat/private/dev-import-status.json"
    if [[ ! -f "$accounting_status" ]] \
        || ! python3 - "$accounting_status" "$source_dump" <<'PY'
import hashlib
import json
import sys
value = json.load(open(sys.argv[1], encoding="utf-8"))
digest = hashlib.sha256()
with open(sys.argv[2], "rb") as stream:
    for chunk in iter(lambda: stream.read(1024 * 1024), b""):
        digest.update(chunk)
if value.get("status") != "passed" or value.get("source_dump_sha256") != digest.hexdigest():
    raise SystemExit(1)
PY
    then
        printf 'The passed Accounting import evidence is missing; refusing seed capture.\n' >&2
        exit 1
    fi
    accounting_controls="$("${compose[@]}" exec -T db psql -X -qAt -U odoo -d odoo_dev -c "
        SELECT json_build_object(
            'move_count', (SELECT count(*) FROM account_move),
            'move_line_count', (SELECT count(*) FROM account_move_line),
            'partial_reconcile_count', (SELECT count(*) FROM account_partial_reconcile),
            'full_reconcile_count', (SELECT count(*) FROM account_full_reconcile),
            'posted_debit', (SELECT COALESCE(sum(line.debit), 0)::text FROM account_move_line line JOIN account_move move ON move.id=line.move_id WHERE move.state='posted'),
            'posted_credit', (SELECT COALESCE(sum(line.credit), 0)::text FROM account_move_line line JOIN account_move move ON move.id=line.move_id WHERE move.state='posted')
        )::text")"
    documents_controls="$("${compose[@]}" exec -T db psql -X -qAt -U odoo -d odoo_dev -c "
        SELECT json_build_object(
            'odoo_document_count', (SELECT count(*) FROM usl_document),
            'active_link_count', (SELECT count(*) FROM usl_document_link WHERE active)
        )::text")"
    source_sha256="$(shasum -a 256 "$source_dump" | awk '{print $1}')"
    collaboration_evidence="$ROOT/artifacts/migration/private/source-${source_sha256:0:12}/collaboration/$compose_project/collaboration-disposition.json"
    if [[ ! -f "$collaboration_evidence" ]] \
        || ! python3 - "$collaboration_evidence" "$source_sha256" <<'PY'
import json
import sys

value = json.load(open(sys.argv[1], encoding="utf-8"))
valid = (
    value.get("source_dump_sha256") == sys.argv[2]
    and value.get("visible_message_count") == 49385
    and value.get("external_message_count") == 0
    and value.get("deliberately_not_copied_message_count") == 620
    and len(value.get("dispositions", {}).get("messages", [])) == 50005
    and len(value.get("dispositions", {}).get("tracking", [])) == 36946
    and len(value.get("dispositions", {}).get("followers", [])) == 5862
    and len(value.get("dispositions", {}).get("activities", [])) == 895
)
raise SystemExit(0 if valid else 1)
PY
    then
        printf 'The sealed Collaboration disposition evidence is missing or incomplete; refusing seed capture.\n' >&2
        exit 1
    fi
    collaboration_sha256="$(shasum -a 256 "$collaboration_evidence" | awk '{print $1}')"
    mkdir -p "$pending_dir/collaboration-evidence"
    chmod 700 "$pending_dir/collaboration-evidence"
    cp -a "$(dirname "$collaboration_evidence")/." \
        "$pending_dir/collaboration-evidence/"
    python3 - "$qualification_json" "$compose_project" "$module_versions" \
        "$paperless_documents" "$accounting_status" "$accounting_controls" \
        "$documents_controls" "$collaboration_sha256" <<'PY'
import json
import sys
from datetime import UTC, datetime

accounting = json.load(open(sys.argv[5], encoding="utf-8"))
with open(sys.argv[1], "w", encoding="utf-8") as stream:
    json.dump(
        {
            "accounting": {
                "controls": json.loads(sys.argv[6]),
                "performance": accounting.get("performance", {}),
                "status": accounting["status"],
            },
            "captured_at": datetime.now(UTC).isoformat(),
            "collaboration": {
                "deliberately_not_copied_message_count": 620,
                "evidence_sha256": sys.argv[8],
                "external_message_count": 0,
                "status": "passed",
                "visible_message_count": 49385,
            },
            "compose_project": sys.argv[2],
            "documents": {
                "controls": json.loads(sys.argv[7]),
                "paperless_document_count": int(sys.argv[4]),
                "status": "passed",
            },
            "migration_boundary": "passed",
            "module_versions": json.loads(sys.argv[3]),
            "paperless_documents": int(sys.argv[4]),
            "profile": "full",
            "product_database_boundary": "passed",
            "regulatory_live_guards": "disabled",
            "status": "passed",
        },
        stream,
        indent=2,
        sort_keys=True,
    )
    stream.write("\n")
PY
    commit="$(git rev-parse HEAD)"
    python3 scripts/qa_seed.py seal \
        --root "$ROOT" \
        --seed-dir "$pending_dir" \
        --source-dump "$source_dump" \
        --runtime-json "$runtime_json" \
        --qualification-json "$qualification_json" \
        --commit "$commit" >/dev/null
    rm -f "$qualification_json"
    printf '\nPending QA seed captured: %s\n' "$pending_dir"
}

publish() {
    local runtime_json fingerprint destination temporary_link
    require_source
    require_safe_cache_root
    if [[ ! -d "$pending_dir" ]]; then
        printf 'No pending QA seed exists for %s.\n' "$compose_project" >&2
        exit 2
    fi
    runtime_json="$(mktemp "${TMPDIR:-/tmp}/usl-qa-runtime.json.XXXXXX")"
    runtime_identity "$runtime_json"
    fingerprint="$(verify_seed "$pending_dir" "$runtime_json")"
    rm -f "$runtime_json"
    destination="$cache_root/$fingerprint-$(date -u +%Y%m%dT%H%M%SZ)"
    mv "$pending_dir" "$destination"
    temporary_link="$cache_root/.current-$compose_project"
    ln -s "$(basename "$destination")" "$temporary_link"
    python3 - "$temporary_link" "$current_link" <<'PY'
import os
import sys

os.replace(sys.argv[1], sys.argv[2])
PY
    printf 'Published QA seed: %s\n' "$destination"
}

discard() {
    require_safe_cache_root
    case "$pending_dir" in
        "$cache_root"/.pending-?*) rm -rf -- "$pending_dir" ;;
        *) printf 'Refusing unsafe pending-seed cleanup: %s\n' "$pending_dir" >&2; exit 2 ;;
    esac
}

status() {
    local runtime_json seed_dir
    require_source
    require_safe_cache_root
    if ! seed_dir="$(seed_directory)"; then
        printf '\nNext step: from the main checkout run make qa-cache-refresh.\n'
        exit 2
    fi
    runtime_json="$(mktemp "${TMPDIR:-/tmp}/usl-qa-runtime.json.XXXXXX")"
    runtime_identity "$runtime_json"
    python3 scripts/qa_seed.py status \
        --root "$ROOT" \
        --seed-dir "$seed_dir" \
        --source-dump "$source_dump" \
        --runtime-json "$runtime_json" \
        --commit "$(git rev-parse HEAD)"
    rm -f "$runtime_json"
}

prune() {
    local current_dir candidate candidate_name removed=0
    require_safe_cache_root
    if [[ "${USL_QA_SEED_PRUNE_CONFIRM:-}" != qa-seeds ]]; then
        printf 'Refusing QA seed pruning without CONFIRM=qa-seeds.\n' >&2
        exit 2
    fi
    current_dir="$(seed_directory)"
    for candidate in "$cache_root"/*; do
        [[ -d "$candidate" && ! -L "$candidate" ]] || continue
        [[ "$candidate" != "$current_dir" ]] || continue
        candidate_name="$(basename "$candidate")"
        if [[ ! "$candidate_name" =~ ^[0-9a-f]{64}-[0-9]{8}T[0-9]{6}Z$ ]]; then
            continue
        fi
        rm -rf -- "$candidate"
        printf 'Removed superseded QA seed: %s\n' "$candidate_name"
        removed=$((removed + 1))
    done
    printf 'QA seed pruning complete: %s superseded seed(s) removed.\n' "$removed"
}

case "$command_name" in
    capture) capture ;;
    publish) publish ;;
    discard) discard ;;
    status) status ;;
    prune) prune ;;
    path)
        require_safe_cache_root
        seed_directory
        ;;
    runtime)
        output="${2:?Usage: scripts/qa-seed runtime OUTPUT}"
        runtime_identity "$output"
        ;;
    *)
        printf 'Usage: scripts/qa-seed [capture|publish|discard|status|prune|path|runtime OUTPUT]\n' >&2
        exit 2
        ;;
esac
