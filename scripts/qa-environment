#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
# shellcheck source=lib/compose-scope.sh
source "$ROOT/scripts/lib/compose-scope.sh"
# shellcheck source=lib/cli-ui.sh
source "$ROOT/scripts/lib/cli-ui.sh"

profile="${1:-${PROFILE:-full}}"
case "$profile" in
  full|no-documents|documents-smoke|clean-install) ;;
  *)
    printf 'QA profile must be full, no-documents, documents-smoke, or clean-install.\n' >&2
    exit 2
    ;;
esac

root_hash="$(printf '%s' "$ROOT" | shasum -a 256 | cut -c 1-8)"
common_git_dir="$(git rev-parse --path-format=absolute --git-common-dir)"
main_checkout="$(cd "$(dirname "$common_git_dir")" && pwd -P)"
export USL_ONLINE_DUMP_DIR="${USL_ONLINE_DUMP_DIR:-$main_checkout/usl-online-dump}"
port_seed="$(printf '%s' "$ROOT" | cksum)"
port_seed="${port_seed%% *}"
port_base=$((24000 + port_seed % 12000))
export COMPOSE_PROJECT_NAME="${COMPOSE_PROJECT_NAME:-usl-odoo-qa-$root_hash}"
export ODOO_HTTP_PORT="${ODOO_HTTP_PORT:-$port_base}"
export ODOO_GEVENT_PORT="${ODOO_GEVENT_PORT:-$((port_base + 1))}"
export POCKET_ID_HTTP_PORT="${POCKET_ID_HTTP_PORT:-$((port_base + 2))}"
export PAPERLESS_HTTP_PORT="${PAPERLESS_HTTP_PORT:-$((port_base + 3))}"
export ODOO_DEV_DB=odoo_dev
export ODOO_DB_NAME=odoo_dev
export USL_DEPLOYMENT_ENV=qa
export USL_EINVOICE_LIVE_ENABLED=0
export USL_EREPORTING_LIVE_ENABLED=0
export PAPERLESS_PUBLIC_URL="${PAPERLESS_PUBLIC_URL:-http://paperless.localhost:$PAPERLESS_HTTP_PORT}"
export ODOO_IMAGE="${ODOO_IMAGE:-usl-odoo-saas-19-3-odoo:latest}"
export POCKET_ID_ENV_FILE="${POCKET_ID_ENV_FILE:-$ROOT/.pocket-id-qa-$root_hash.env}"
export USL_PERSONAL_AI_MASTER_KEYS_HOST_PATH="${USL_PERSONAL_AI_MASTER_KEYS_HOST_PATH:-$ROOT/.documents-personal-ai-keys.json}"
export USL_POCKET_ID_DEV_COMPOSE_PROJECT="$COMPOSE_PROJECT_NAME"
export USL_POCKET_ID_DEV_ODOO_DB=odoo_dev
export USL_POCKET_ID_DEV_ODOO_PORT="$ODOO_HTTP_PORT"
export USL_POCKET_ID_DEV_GEVENT_PORT="$ODOO_GEVENT_PORT"
export USL_POCKET_ID_DEV_POCKET_PORT="$POCKET_ID_HTTP_PORT"
export USL_POCKET_ID_DEV_PAPERLESS_PORT="$PAPERLESS_HTTP_PORT"
export USL_POCKET_ID_DEV_PAPERLESS_URL="$PAPERLESS_PUBLIC_URL"
export COMPOSE_IGNORE_ORPHANS=1
requested_project="$COMPOSE_PROJECT_NAME"
requested_odoo_port="$ODOO_HTTP_PORT"
requested_gevent_port="$ODOO_GEVENT_PORT"
requested_pocket_port="$POCKET_ID_HTTP_PORT"
requested_paperless_port="$PAPERLESS_HTTP_PORT"
requested_odoo_image="$ODOO_IMAGE"
reuse_requested="${USL_QA_REUSE_EXISTING:-0}"
case "$reuse_requested" in
  0|1) ;;
  *)
    printf 'USL_QA_REUSE_EXISTING must be 0 or 1.\n' >&2
    exit 2
    ;;
esac

case "$COMPOSE_PROJECT_NAME" in
  usl-odoo-qa-?*) ;;
  *)
    printf 'QA provisioning requires an isolated usl-odoo-qa-* Compose project.\n' >&2
    exit 2
    ;;
esac
usl_verify_compose_scope "$COMPOSE_PROJECT_NAME" "$ROOT" "QA provisioning"

scripts/pocket-id-dev bootstrap >/dev/null
python3 "$ROOT/scripts/documents_sso_env.py" \
  --personal-ai-key-file "$USL_PERSONAL_AI_MASTER_KEYS_HOST_PATH" >/dev/null
set -a
# shellcheck disable=SC1090
source "$POCKET_ID_ENV_FILE"
set +a
# Environment identity files own secrets, while this invocation owns scope.
export COMPOSE_PROJECT_NAME="$requested_project"
export ODOO_HTTP_PORT="$requested_odoo_port"
export ODOO_GEVENT_PORT="$requested_gevent_port"
export POCKET_ID_HTTP_PORT="$requested_pocket_port"
export PAPERLESS_HTTP_PORT="$requested_paperless_port"
export ODOO_IMAGE="$requested_odoo_image"
export PAPERLESS_PUBLIC_URL="http://paperless.localhost:$PAPERLESS_HTTP_PORT"
if [[ "$profile" != no-documents ]]; then
  # Archive/OCR work must not queue behind expensive incremental embeddings.
  # The full profile restores normal indexing and proves vector parity before
  # it is handed to a reviewer.
  export PAPERLESS_USL_DEFER_SEMANTIC_INDEX=true
fi
compose=(
  docker compose -p "$COMPOSE_PROJECT_NAME" --env-file "$POCKET_ID_ENV_FILE"
  -f "$ROOT/compose.yaml" -f "$ROOT/compose.pocket-id.yaml"
)

timing_dir="$ROOT/artifacts/migration/private/qa-runs"
mkdir -p "$timing_dir"
timing_file="$timing_dir/${COMPOSE_PROJECT_NAME}-$(date -u +%Y%m%dT%H%M%SZ).tsv"
report_file="${timing_file%.tsv}.json"
hydration_controls_file="${timing_file%.tsv}-hydration.json"
qa_state_dir="$ROOT/artifacts/migration/private/qa-state"
qa_state_file="$qa_state_dir/$COMPOSE_PROJECT_NAME.json"
run_started="$(date +%s)"
cache_result="not-applicable"
: > "$timing_file"

stage() {
  local name="$1" started finished status
  shift
  printf '\n[%s] %s\n' "$(($(wc -l < "$timing_file") + 1))" "$name"
  started="$(date +%s)"
  set +e
  (set -e; "$@")
  status=$?
  set -e
  finished="$(date +%s)"
  printf '%s\t%s\t%s\n' "$name" "$((finished - started))" "$status" >> "$timing_file"
  return "$status"
}

write_report() {
  local outcome="$1"
  python3 - "$timing_file" "$report_file" "$profile" "$COMPOSE_PROJECT_NAME" "$run_started" "$outcome" "${qa_seed_manifest:-}" "$cache_result" "$hydration_controls_file" <<'PY'
import json
import sys
import time
from pathlib import Path

timings = []
for row in Path(sys.argv[1]).read_text(encoding="utf-8").splitlines():
    name, duration, status = row.split("\t")
    timings.append({"duration_seconds": int(duration), "name": name, "status": int(status)})
payload = {
    "cache": sys.argv[8],
    "compose_project": sys.argv[4],
    "duration_seconds": int(time.time()) - int(sys.argv[5]),
    "outcome": sys.argv[6],
    "profile": sys.argv[3],
    "stages": timings,
    "validation_level": "cached-full" if sys.argv[3] == "full" else "partial",
}
if sys.argv[7]:
    manifest = json.loads(Path(sys.argv[7]).read_text(encoding="utf-8"))
    payload.update({
        "downloaded_bytes": (
            0
            if sys.argv[8] == "warm-hit"
            else sum(item["size"] for item in manifest["artifacts"].values())
        ),
        "reused_document_roots": manifest["qualification"]["paperless_documents"],
        "seed_fingerprint": manifest["fingerprint"],
    })
    if sys.argv[8] == "warm-hit":
        payload["ocr_submissions"] = 0
if Path(sys.argv[9]).is_file():
    hydration = json.loads(Path(sys.argv[9]).read_text(encoding="utf-8"))
    payload["hydration_controls"] = hydration
    payload["ocr_submissions"] = hydration["ocr_submissions"]
Path(sys.argv[2]).write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
PY
}
trap 'rm -f "$qa_state_file"; write_report failed' EXIT

reset_project() {
  local unsafe
  usl_compose_scope_scan "$COMPOSE_PROJECT_NAME" "$ROOT"
  unsafe="$(usl_compose_active_unsafe_resources || true)"
  if [[ -n "$unsafe" ]]; then
    printf 'A one-shot QA or migration operation is active; refusing reset:\n%s\n' \
      "$(usl_format_compose_resources "$unsafe")" >&2
    return 2
  fi
  rm -f "$qa_state_file"
  "${compose[@]}" --profile paperless down --volumes --remove-orphans
}

product_modules='rebuild_account_migration,usl_access_control,usl_accounting,usl_b2c,usl_documents,usl_documents_accounting,usl_documents_b2c,usl_expense_batch,usl_locale,usl_platform_billing,usl_platform_billing_pocketid,usl_pocketid,usl_project,usl_sign,usl_tese_accounting,usl_tese_payroll'

verify_seed() {
  local runtime_json
  runtime_json="$(mktemp "${TMPDIR:-/tmp}/usl-qa-runtime.json.XXXXXX")"
  scripts/qa-seed runtime "$runtime_json"
  if ! scripts/qa_seed.py verify \
    --root "$ROOT" --seed-dir "$qa_seed_dir" \
    --source-dump "${USL_ONLINE_DUMP_DIR:-$ROOT/usl-online-dump}/dump.sql" \
    --runtime-json "$runtime_json" \
    --commit "$(git rev-parse HEAD)" >/dev/null; then
    rm -f "$runtime_json"
    printf '\nBlocked: the shared QA seed is incompatible with this source or runtime.\n' >&2
    printf 'No containers or data volumes were changed.\n' >&2
    printf 'Next step (main checkout): make qa-cache-refresh\n' >&2
    return 2
  fi
  rm -f "$runtime_json"
}

qa_state_matches() {
  [[ -f "$qa_state_file" ]] || return 1
  python3 - "$qa_state_file" "$qa_seed_manifest" "$COMPOSE_PROJECT_NAME" \
    "$POCKET_ID_ENV_FILE" "$qa_state_sha256" <<'PY'
import hashlib
import json
import sys

try:
    state = json.load(open(sys.argv[1], encoding="utf-8"))
except (OSError, json.JSONDecodeError):
    raise SystemExit(1)
manifest_path = sys.argv[2]
manifest = json.load(open(manifest_path, encoding="utf-8"))
manifest_sha = hashlib.sha256(open(manifest_path, "rb").read()).hexdigest()
expected = {
    "compose_project": sys.argv[3],
    "migration_sha256": manifest["identity"]["migration_sha256"],
    "pocket_environment_sha256": hashlib.sha256(open(sys.argv[4], "rb").read()).hexdigest(),
    "profile": "full",
    "schema": "usl-worktree-qa-state-v1",
    "seed_fingerprint": manifest["fingerprint"],
    "seed_manifest_sha256": manifest_sha,
    "worktree_state_sha256": sys.argv[5],
}
raise SystemExit(0 if state == expected else 1)
PY
}

qa_volumes_present() {
  local suffix
  for suffix in \
    postgres-data odoo-data paperless-postgres-data paperless-broker-data \
    paperless-data paperless-media paperless-export paperless-consume \
    paperless-trash pocket-id-data
  do
    docker volume inspect "$COMPOSE_PROJECT_NAME-$suffix" >/dev/null 2>&1 \
      || docker volume inspect "${COMPOSE_PROJECT_NAME}_$suffix" >/dev/null 2>&1 \
      || return 1
  done
}

reuse_qa_target() {
  "${compose[@]}" up -d --wait db
  "${compose[@]}" --profile paperless up -d --wait --pull never \
    paperless-webserver
  "${compose[@]}" up -d --wait --pull never odoo
  if [[ "$("${compose[@]}" exec -T db psql -X -qAt -U odoo -d odoo_dev \
      -c "SELECT COALESCE((SELECT value FROM ir_config_parameter WHERE key='usl.qa.data_profile'), 'full')")" != full ]]; then
    printf 'The cached QA target is not stamped with the full profile.\n' >&2
    return 1
  fi
  scripts/check-product-migration-boundary
  scripts/check-product-database-boundary
}

write_qa_state() {
  mkdir -p "$qa_state_dir"
  chmod 700 "$qa_state_dir"
  python3 - "$qa_state_file" "$qa_seed_manifest" "$COMPOSE_PROJECT_NAME" \
    "$POCKET_ID_ENV_FILE" "$qa_state_sha256" <<'PY'
import hashlib
import json
import os
import sys
import tempfile

path = sys.argv[1]
manifest_path = sys.argv[2]
manifest = json.load(open(manifest_path, encoding="utf-8"))
payload = {
    "compose_project": sys.argv[3],
    "migration_sha256": manifest["identity"]["migration_sha256"],
    "pocket_environment_sha256": hashlib.sha256(open(sys.argv[4], "rb").read()).hexdigest(),
    "profile": "full",
    "schema": "usl-worktree-qa-state-v1",
    "seed_fingerprint": manifest["fingerprint"],
    "seed_manifest_sha256": hashlib.sha256(open(manifest_path, "rb").read()).hexdigest(),
    "worktree_state_sha256": sys.argv[5],
}
descriptor, temporary = tempfile.mkstemp(prefix=".qa-state-", dir=os.path.dirname(path))
try:
    os.fchmod(descriptor, 0o600)
    with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
        json.dump(payload, stream, indent=2, sort_keys=True)
        stream.write("\n")
        stream.flush()
        os.fsync(stream.fileno())
    os.replace(temporary, path)
finally:
    if os.path.exists(temporary):
        os.unlink(temporary)
PY
}

hydrate_seed() {
  local after_queue after_tasks before_queue before_tasks db_container
  local collaboration_evidence_dir odoo_volume paperless_export_volume restore_jobs
  local source_sha256

  source_sha256="$(python3 - "$qa_seed_manifest" <<'PY'
import json
import sys
print(json.load(open(sys.argv[1], encoding="utf-8"))["identity"]["source_dump_sha256"])
PY
)"
  collaboration_evidence_dir="$ROOT/artifacts/migration/private/source-${source_sha256:0:12}/collaboration/$COMPOSE_PROJECT_NAME"
  mkdir -p "$collaboration_evidence_dir"
  chmod 700 "$collaboration_evidence_dir"
  cp -a "$qa_seed_dir/collaboration-evidence/." "$collaboration_evidence_dir/"

  "${compose[@]}" up -d --wait db
  "${compose[@]}" exec -T db createdb -U odoo odoo_dev
  restore_jobs="${USL_QA_PG_RESTORE_JOBS:-4}"
  if [[ ! "$restore_jobs" =~ ^[1-8]$ ]]; then
    printf 'USL_QA_PG_RESTORE_JOBS must be between 1 and 8.\n' >&2
    return 2
  fi
  db_container="$("${compose[@]}" ps -q db)"
  docker cp "$qa_seed_dir/odoo.dump" \
    "$db_container:/tmp/usl-qa-seed.dump"
  "${compose[@]}" exec -T -e RESTORE_JOBS="$restore_jobs" db sh -ec '
    trap '\''rm -f /tmp/usl-qa-seed.dump'\'' EXIT
    pg_restore -U odoo -d odoo_dev --exit-on-error \
      --jobs="$RESTORE_JOBS" --no-owner --no-privileges \
      /tmp/usl-qa-seed.dump
    vacuumdb -U odoo -d odoo_dev --analyze-in-stages
  '

  odoo_volume="${COMPOSE_PROJECT_NAME}_odoo-data"
  docker volume create \
    --label "com.docker.compose.project=$COMPOSE_PROJECT_NAME" \
    --label com.docker.compose.volume=odoo-data \
    "$odoo_volume" >/dev/null
  docker run --rm \
    -v "$odoo_volume:/target" -v "$qa_seed_dir:/seed:ro" alpine:3.24.1 \
    sh -ec '
      mkdir -p /target/filestore /target/sessions
      tar -C /target/filestore -xzf /seed/odoo-filestore.tgz
      chown -R 1000:1000 /target
    '

  paperless_export_volume="${COMPOSE_PROJECT_NAME}_paperless-export"
  docker volume create \
    --label "com.docker.compose.project=$COMPOSE_PROJECT_NAME" \
    --label com.docker.compose.volume=paperless-export \
    "$paperless_export_volume" >/dev/null
  docker run --rm \
    -v "$paperless_export_volume:/export" -v "$qa_seed_dir/paperless-export:/seed:ro" \
    alpine:3.24.1 sh -ec 'mkdir -p /export/qa-seed && cp -a /seed/. /export/qa-seed/'
  "${compose[@]}" --profile paperless up -d --wait paperless-webserver
  "${compose[@]}" stop paperless-webserver
  before_queue="$("${compose[@]}" exec -T paperless-broker valkey-cli LLEN celery)"
  before_tasks="$(
    "${compose[@]}" --profile paperless run --rm --no-deps \
      --entrypoint python paperless-webserver manage.py shell -c \
      'from documents.models import PaperlessTask; print(PaperlessTask.objects.count())' \
      | tail -n 1
  )"
  "${compose[@]}" --profile paperless run --rm --no-deps \
    --user paperless --entrypoint python paperless-webserver \
    manage.py document_importer --no-progress-bar \
    /usr/src/paperless/export/qa-seed
  after_queue="$("${compose[@]}" exec -T paperless-broker valkey-cli LLEN celery)"
  after_tasks="$(
    "${compose[@]}" --profile paperless run --rm --no-deps \
      --entrypoint python paperless-webserver manage.py shell -c \
      'from documents.models import PaperlessTask; print(PaperlessTask.objects.count())' \
      | tail -n 1
  )"
  if [[ "$after_queue" != "$before_queue" || "$after_tasks" != "$before_tasks" ]]; then
    printf 'QA seed hydration submitted Paperless background/OCR work; refusing cache.\n' >&2
    printf 'Queue: %s -> %s; Paperless task rows: %s -> %s\n' \
      "$before_queue" "$after_queue" "$before_tasks" "$after_tasks" >&2
    return 1
  fi
  "${compose[@]}" --profile paperless up -d --wait paperless-webserver
  "${compose[@]}" exec -T paperless-webserver python manage.py document_sanity_checker
  python3 - "$hydration_controls_file" "$before_queue" "$after_queue" \
    "$before_tasks" "$after_tasks" <<'PY'
import json
import sys
from pathlib import Path
Path(sys.argv[1]).write_text(json.dumps({
    "broker_queue_after": int(sys.argv[3]),
    "broker_queue_before": int(sys.argv[2]),
    "ocr_submissions": 0,
    "paperless_tasks_after": int(sys.argv[5]),
    "paperless_tasks_before": int(sys.argv[4]),
}, indent=2, sort_keys=True) + "\n", encoding="utf-8")
PY
}

verify_hydrated_controls() {
  local actual_accounting actual_documents actual_paperless
  actual_accounting="$("${compose[@]}" exec -T db psql -X -qAt -U odoo \
    -d odoo_dev -c "
      SELECT json_build_object(
        'move_count', (SELECT count(*) FROM account_move),
        'move_line_count', (SELECT count(*) FROM account_move_line),
        'partial_reconcile_count', (SELECT count(*) FROM account_partial_reconcile),
        'full_reconcile_count', (SELECT count(*) FROM account_full_reconcile),
        'posted_debit', (SELECT COALESCE(sum(l.debit),0)::text FROM account_move_line l JOIN account_move m ON m.id=l.move_id WHERE m.state='posted'),
        'posted_credit', (SELECT COALESCE(sum(l.credit),0)::text FROM account_move_line l JOIN account_move m ON m.id=l.move_id WHERE m.state='posted')
      )::text")"
  actual_documents="$("${compose[@]}" exec -T db psql -X -qAt -U odoo \
    -d odoo_dev -c "
      SELECT json_build_object(
        'odoo_document_count', (SELECT count(*) FROM usl_document),
        'active_link_count', (SELECT count(*) FROM usl_document_link WHERE active)
      )::text")"
  actual_paperless="$(
    "${compose[@]}" exec -T paperless-webserver python manage.py shell -c \
      'from documents.models import Document; print(Document.objects.count())' \
      | tail -n 1
  )"
  python3 - "$qa_seed_manifest" "$hydration_controls_file" \
    "$actual_accounting" "$actual_documents" "$actual_paperless" <<'PY'
import json
import sys
from pathlib import Path
manifest = json.load(open(sys.argv[1], encoding="utf-8"))
qualification = manifest["qualification"]
actual = {
    "accounting": json.loads(sys.argv[3]),
    "documents": json.loads(sys.argv[4]),
    "paperless_document_count": int(sys.argv[5]),
}
expected = {
    "accounting": qualification["accounting"]["controls"],
    "documents": qualification["documents"]["controls"],
    "paperless_document_count": qualification["documents"]["paperless_document_count"],
}
if actual != expected:
    raise SystemExit(
        "Hydrated QA controls differ from the sealed seed: "
        + json.dumps({"actual": actual, "expected": expected}, sort_keys=True),
    )
path = Path(sys.argv[2])
hydration = json.loads(path.read_text(encoding="utf-8"))
hydration.update({"controls": actual, "controls_match": True})
path.write_text(json.dumps(hydration, indent=2, sort_keys=True) + "\n", encoding="utf-8")
PY
}

clean_install() {
  "${compose[@]}" up -d --wait db
  "${compose[@]}" --profile init run --rm -T \
    -e ODOO_INIT_DB=odoo_dev init-db odoo \
    --config=/etc/odoo/odoo.conf --database=odoo_dev \
    --init="$product_modules" --without-demo=true --stop-after-init --log-level=warn
  # Odoo's auto-install fixed point includes optional demo/marketing products
  # that are not part of Distribution. Remove only the reviewed exact set and
  # abort if a supported installed module has acquired a dependency on it.
  "${compose[@]}" --profile init run --rm -T \
    -e ODOO_INIT_DB=odoo_dev \
    init-db odoo shell --config=/etc/odoo/odoo.conf --database=odoo_dev \
    < "$ROOT/scripts/odoo/enforce_product_module_scope.py"
  "${compose[@]}" --profile init run --rm -T \
    -e ODOO_INIT_DB=odoo_dev \
    init-db odoo shell --config=/etc/odoo/odoo.conf --database=odoo_dev \
    < "$ROOT/scripts/odoo/qa_clean_install_company.py"
  USL_QA_DATA_PROFILE=clean-install \
    scripts/pocket-id-dev configure-odoo "$product_modules"
  "${compose[@]}" stop odoo
  "${compose[@]}" --profile init run --rm -T \
    -e ODOO_INIT_DB=odoo_dev -e USL_PLATFORM_BILLING_QA_BOOTSTRAP=1 \
    init-db odoo shell --config=/etc/odoo/odoo.conf --database=odoo_dev \
    < "$ROOT/scripts/odoo/platform_billing_qa_bootstrap.py"
  "${compose[@]}" up -d --wait odoo
  scripts/odoo-dev disable-tours
  scripts/check-product-migration-boundary
  scripts/check-product-database-boundary
  "${compose[@]}" exec -T -e ACTION_RISK_MODE=check \
    odoo odoo shell --config=/etc/odoo/odoo.conf --database=odoo_dev \
    < "$ROOT/scripts/odoo/action_risk_inventory.py"
  "${compose[@]}" exec -T \
    -e USL_EINVOICE_LIVE_ENABLED=0 \
    -e USL_EREPORTING_LIVE_ENABLED=0 \
    odoo odoo shell --config=/etc/odoo/odoo.conf --database=odoo_dev \
    < "$ROOT/scripts/odoo/compile_product_assets.py"
}

b2c_qa_bootstrap() {
  # Run the write-heavy persona bootstrap without the long-lived Odoo process.
  # Otherwise the Documents synchronization cron can start concurrently and
  # contend on the same B2C-linked document rows, making QA provisioning depend
  # on whether the minute scheduler happens to fire during this stage.
  "${compose[@]}" stop odoo
  "${compose[@]}" --profile init run --rm -T --no-deps \
    -e ODOO_INIT_DB=odoo_dev \
    -e USL_QA_DATA_PROFILE="$profile" \
    -e USL_EINVOICE_LIVE_ENABLED=0 \
    -e USL_EREPORTING_LIVE_ENABLED=0 \
    init-db odoo shell --config=/etc/odoo/odoo.conf --database=odoo_dev \
    < "$ROOT/scripts/odoo/b2c_qa_bootstrap.py"
  "${compose[@]}" up -d --wait odoo
}

documents_qa_finalize() {
  # Drain the governed archive queue with the long-lived scheduler stopped so
  # QA readiness does not depend on minute-bound cron timing.
  "${compose[@]}" stop odoo
  "${compose[@]}" --profile init run --rm -T --no-deps \
    -e ODOO_INIT_DB=odoo_dev \
    -e USL_EINVOICE_LIVE_ENABLED=0 \
    -e USL_EREPORTING_LIVE_ENABLED=0 \
    init-db odoo shell --config=/etc/odoo/odoo.conf --database=odoo_dev \
    < "$ROOT/scripts/odoo/documents_qa_finalize.py"
  "${compose[@]}" up -d --wait odoo
}

documents_qa_finalize_semantic_index() {
  export PAPERLESS_USL_DEFER_SEMANTIC_INDEX=false
  DOCUMENTS_CANONICAL_TARGET=1 \
    DOCUMENTS_RESTORE_PROFILE=full \
    DOCUMENTS_TARGET_DATABASE=odoo_dev \
    COMPOSE_PROJECT_NAME="$COMPOSE_PROJECT_NAME" \
    scripts/documents-restore semantic-finalize
}

usl_cli_title "provision isolated QA target"
printf '  Profile:  %s\n  Project:  %s\n  Database: odoo_dev\n' "$profile" "$COMPOSE_PROJECT_NAME"
if [[ "$profile" == full ]]; then
  cache_result="miss"
  if ! qa_seed_dir="$(scripts/qa-seed path)"; then
    printf '\nBlocked: no qualified QA seed is available.\n' >&2
    printf 'No containers or data volumes were changed.\n' >&2
    printf 'Next step (main checkout): make qa-cache-refresh\n' >&2
    exit 2
  fi
  qa_seed_manifest="$qa_seed_dir/manifest.json"
  stage "verify qualified seed (read only)" verify_seed
  qa_state_sha256="$(PYTHONPATH="$ROOT" python3 -c \
    'from pathlib import Path; from scripts.qa_seed import qa_state_digest; print(qa_state_digest(Path.cwd()))')"
  cache_result="hit"
fi
reuse_existing=0
if [[ "$profile" == full && "$reuse_requested" == 1 ]] \
    && qa_state_matches && qa_volumes_present; then
  reuse_existing=1
  cache_result="warm-hit"
fi
if [[ "$reuse_existing" == 0 ]]; then
  stage "reset isolated QA project" reset_project
fi
case "$profile" in
  full)
    if [[ "$reuse_existing" == 1 ]]; then
      stage "reuse and verify existing QA target" reuse_qa_target
    else
      stage "hydrate qualified seed" hydrate_seed
      stage "upgrade and finalize current branch" \
        env USL_QA_DATA_PROFILE=full scripts/target-finalize
      stage "verify sealed hydration controls and zero OCR" \
        verify_hydrated_controls
    fi
    stage "multi-company acceptance" make \
      COMPOSE_PROJECT="$COMPOSE_PROJECT_NAME" accounting-multicompany-acceptance
    ;;
  no-documents|documents-smoke)
    stage "source reconstruction ($profile)" \
      env USL_MIGRATION_PURPOSE=development \
      USL_QA_DATA_PROFILE="$profile" scripts/target-reconstruct
    ;;
  clean-install)
    stage "clean product installation" clean_install
    ;;
esac
if [[ "$reuse_existing" == 0 ]]; then
  stage "B2C QA personas and tour baseline" b2c_qa_bootstrap
fi
if [[ "$profile" == full ]]; then
  stage "reconcile locked Documents classification" env \
    DOCUMENTS_CANONICAL_TARGET=1 \
    DOCUMENTS_RESTORE_PROFILE=full \
    DOCUMENTS_TARGET_DATABASE=odoo_dev \
    COMPOSE_PROJECT_NAME="$COMPOSE_PROJECT_NAME" \
    scripts/documents-restore reconcile-locked-classification
fi
if [[ "$profile" != no-documents ]]; then
  stage "enable Documents jobs and drain archive queue" documents_qa_finalize
fi
if [[ "$profile" == full ]]; then
  stage "restore and verify Documents semantic index" \
    documents_qa_finalize_semantic_index
  write_qa_state
fi

write_report passed
trap - EXIT
printf '\nQA target ready (%s)\n' "$profile"
printf '  Odoo:     http://odoo.localhost:%s/web/login?db=odoo_dev\n' "$ODOO_HTTP_PORT"
if [[ "$profile" != no-documents ]]; then
  printf '  Documents: %s\n' "$PAPERLESS_PUBLIC_URL"
fi
printf '  Evidence: %s\n' "$report_file"
printf '  Login:    POCKET_ID_ENV_FILE=%s make login-link USER=valentin\n' "$POCKET_ID_ENV_FILE"
