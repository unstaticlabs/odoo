#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
source "$ROOT/scripts/lib/compose-scope.sh"
source "$ROOT/scripts/lib/migration-addons.sh"

command_name="${1:-all}"
compose_project="${COMPOSE_PROJECT_NAME:-usl-odoo-saas-19-3}"
target_database="${TESE_TARGET_DATABASE:-odoo_dev}"
source_dump_dir="${USL_ONLINE_DUMP_DIR:-$ROOT/usl-online-dump}"
migration_addons_path="$USL_MIGRATION_ADDONS_PATH"
usl_verify_compose_scope "$compose_project" "$ROOT" "TESE restoration"

case "$target_database" in
    odoo_online_source_saas_19_3|odoo_saas_19_3_validation_exact|odoo_saas_19_3_validation_native)
        if [[ "${TESE_RESTORE_ALLOW_PROTECTED_TARGET:-0}" != "1" ]]; then
            echo "Refusing protected database $target_database."
            echo "Set TESE_RESTORE_ALLOW_PROTECTED_TARGET=1 only for an intentional downstream import."
            exit 2
        fi
        ;;
esac

export USL_ONLINE_DUMP_DIR="$source_dump_dir"
export USL_EINVOICE_LIVE_ENABLED=0
export USL_EREPORTING_LIVE_ENABLED=0

product_was_running=0
if [[ "$command_name" != product-validate ]] \
    && docker compose -p "$compose_project" ps --status running --services \
    | grep -qx odoo; then
    product_was_running=1
    docker compose -p "$compose_project" stop odoo >/dev/null
fi

restore_product_service() {
    if ((product_was_running)); then
        docker compose -p "$compose_project" up -d --wait odoo
    fi
}
trap restore_product_service EXIT INT TERM

module_operations() {
    init_modules=()
    update_modules=()
    for module_name in "$@"; do
        if docker compose -p "$compose_project" exec -T db \
            psql -U "${ODOO_DB_USER:-odoo}" -d "$target_database" -Atc \
            "SELECT 1 FROM ir_module_module WHERE name = '$module_name' AND state = 'installed'" \
            | grep -qx 1; then
            update_modules+=("$module_name")
        else
            init_modules+=("$module_name")
        fi
    done
    module_args=()
    if ((${#init_modules[@]})); then
        module_args+=("--init=$(IFS=,; echo "${init_modules[*]}")")
    fi
    if ((${#update_modules[@]})); then
        module_args+=("--update=$(IFS=,; echo "${update_modules[*]}")")
    fi
    docker compose -p "$compose_project" \
        --profile accounting-compat \
        --profile tese-migration run --rm \
        -e ODOO_INIT_DB="$target_database" \
        tese-migration \
        odoo --config=/etc/odoo/odoo.conf \
        --addons-path="$migration_addons_path" \
        --database="$target_database" \
        "${module_args[@]}" \
        --without-demo=true \
        --stop-after-init
}

require_source() {
    if [[ ! -f "$source_dump_dir/dump.sql" || ! -d "$source_dump_dir/filestore" ]]; then
        echo "Source dump or filestore is missing under $source_dump_dir."
        exit 2
    fi
}

require_reconstruction_schema() {
    local trace_count
    trace_count="$(
        docker compose -p "$compose_project" exec -T db \
            psql -U "${ODOO_DB_USER:-odoo}" -d "$target_database" -Atc \
            "SELECT count(*)
               FROM information_schema.columns
              WHERE table_schema = current_schema()
                AND (table_name, column_name) IN (
                    ('res_company', 'rebuild_source_id'),
                    ('account_move', 'rebuild_source_id')
                )"
    )"
    if [[ "$trace_count" != "2" ]]; then
        echo "TESE restoration requires the active reconstruction schema."
        echo "This target is finalized; use a product-module upgrade instead."
        exit 2
    fi
}

run_shell() {
    script_path="$1"
    require_source
    docker compose -p "$compose_project" \
        --profile accounting-compat \
        --profile tese-migration run --rm \
        -e TESE_SOURCE_DB_HOST="${TESE_SOURCE_DB_HOST:-accounting-source-db}" \
        -e TESE_SOURCE_DB_PORT="${TESE_SOURCE_DB_PORT:-5432}" \
        -e TESE_SOURCE_DB_USER="${TESE_SOURCE_DB_USER:-odoo}" \
        -e TESE_SOURCE_DB_PASSWORD="${TESE_SOURCE_DB_PASSWORD:-odoo}" \
        -e TESE_SOURCE_DATABASE="${TESE_SOURCE_DATABASE:-odoo_online_source_saas_19_3}" \
        -e TESE_SOURCE_SNAPSHOT="${TESE_SOURCE_SNAPSHOT:-odoo-online-saas-19.3-tese-payroll}" \
        -e TESE_SOURCE_FILESTORE=/mnt/accounting-source/filestore \
        tese-migration \
        odoo shell --config=/etc/odoo/odoo.conf \
        --addons-path="$migration_addons_path" \
        --database="$target_database" \
        --shell-interface=python \
        < "$script_path"
}

install_modules() {
    module_operations usl_tese_payroll usl_tese_restore
}

import_tese() {
    run_shell migration/tese_restore/addons/usl_tese_restore/scripts/run_restore.py
}

validate_tese() {
    run_shell migration/tese_restore/addons/usl_tese_restore/scripts/validate_restore.py
}

finalize_tese() {
    run_shell migration/tese_restore/addons/usl_tese_restore/scripts/finalize_restore.py
    if [[ "${TESE_RESTORE_DEFER_PRODUCT_VALIDATE:-0}" != "1" ]]; then
        validate_product_boundary
    fi
}

validate_product_boundary() {
    if [[ -n "$(docker compose -p "$compose_project" ps --status running -q odoo)" ]]; then
        docker compose -p "$compose_project" exec -T odoo \
            odoo shell --config=/etc/odoo/odoo.conf \
            --database="$target_database" --shell-interface=python \
            < migration/tese_restore/scripts/validate_product_boundary.py
    else
        docker compose -p "$compose_project" --profile init run --rm -T --no-deps \
            -e ODOO_INIT_DB="$target_database" init-db \
            odoo shell --config=/etc/odoo/odoo.conf \
            --database="$target_database" --shell-interface=python \
            < migration/tese_restore/scripts/validate_product_boundary.py
    fi
}

case "$command_name" in
    install)
        require_reconstruction_schema
        install_modules
        ;;
    import)
        require_reconstruction_schema
        import_tese
        ;;
    validate)
        validate_tese
        ;;
    idempotence)
        require_reconstruction_schema
        import_tese
        validate_tese
        ;;
    finalize)
        finalize_tese
        ;;
    product-validate)
        validate_product_boundary
        ;;
    all)
        require_reconstruction_schema
        install_modules
        import_tese
        validate_tese
        import_tese
        validate_tese
        finalize_tese
        ;;
    *)
        echo "Usage: scripts/tese-restore [install|import|validate|idempotence|finalize|product-validate|all]"
        exit 2
        ;;
esac
