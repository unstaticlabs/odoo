#!/usr/bin/env python3
"""Check the pinned mattermost-odoo commit and show a pin change.

verify  refuses the pin unless its commit is an ancestor of main of the
        pinned repository. A fork-only commit fails.
review  verifies the pin and prints, as Markdown, the git diff --stat and the
        diff of the module between the pin at --base and the pin now. It
        prints nothing when the pin did not change.
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from operations.mattermost_odoo_release import (  # noqa: E402
    MattermostOdooReleaseError,
    load_pin,
    load_pin_at,
    review,
    summary,
    temporary_directory,
    verify_reachable,
)


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(prog="scripts/mattermost-odoo")
    result.add_argument("command", choices=("verify", "review"))
    result.add_argument("--base", help="the revision of this repository to compare with")
    return result


def main() -> int:
    arguments = parser().parse_args()
    try:
        pin = load_pin(ROOT)
        old = None
        if arguments.command == "review":
            if not arguments.base:
                raise MattermostOdooReleaseError("review requires --base")
            old = load_pin_at(ROOT, arguments.base)
        with temporary_directory() as temporary:
            directory = Path(temporary)
            main_commit = verify_reachable(pin["repository"], pin["commit"], directory)
            if arguments.command == "verify":
                print(json.dumps(summary(pin, main_commit), indent=2, sort_keys=True))
            else:
                print(review(old, pin, directory), end="")
        return 0
    except (MattermostOdooReleaseError, OSError) as error:
        print(f"Mattermost Odoo pin refused: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
