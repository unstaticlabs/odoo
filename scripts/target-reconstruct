#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
source "$ROOT/scripts/lib/compose-scope.sh"

usl_require_explicit_compose_project "Canonical reconstruction"
compose_project="$COMPOSE_PROJECT_NAME"
usl_verify_compose_scope "$compose_project" "$ROOT" "Canonical reconstruction"

if [[ -z "${POCKET_ID_ENV_FILE:-}" ]]; then
  if [[ -d "$ROOT/.git" && "$compose_project" == "usl-odoo-saas-19-3" ]]; then
    export POCKET_ID_ENV_FILE="$ROOT/.pocket-id.env"
  else
    export POCKET_ID_ENV_FILE="$ROOT/.pocket-id-${compose_project}.env"
    printf 'Pocket ID: using isolated project environment %s.\n' \
      "$(basename "$POCKET_ID_ENV_FILE")"
  fi
fi

if [[ "${ODOO_DEV_DB:-odoo_dev}" != "odoo_dev" ]]; then
  printf 'Canonical reconstruction is reserved for odoo_dev.\n' >&2
  exit 2
fi

export USL_EINVOICE_LIVE_ENABLED=0
export USL_EREPORTING_LIVE_ENABLED=0
export COMPOSE_IGNORE_ORPHANS=1

qa_profile="${USL_QA_DATA_PROFILE:-full}"
case "$qa_profile" in
  full)
    documents_profile=full
    documents_enabled=1
    ;;
  no-documents)
    documents_profile=full
    documents_enabled=0
    ;;
  documents-smoke)
    documents_profile=smoke
    documents_enabled=1
    ;;
  *)
    printf 'USL_QA_DATA_PROFILE must be full, no-documents, or documents-smoke.\n' >&2
    exit 2
    ;;
esac

migration_purpose="${USL_MIGRATION_PURPOSE:-production}"
case "$migration_purpose" in
  production)
    if [[ "$qa_profile" != full ]]; then
      printf 'Production migration requires the complete full profile.\n' >&2
      exit 2
    fi
    if [[ "${USL_RECONSTRUCT_REUSE_DOCUMENTS:-0}" != 0 ]]; then
      printf 'Production migration cannot reuse a mutable Documents checkpoint.\n' >&2
      exit 2
    fi
    if [[ "${USL_QA_SEED_REFRESH:-0}" != 0 ]]; then
      printf 'Production migration and QA seed publication are separate operations.\n' >&2
      exit 2
    fi
    if [[ -n "$(git status --porcelain --untracked-files=no)" ]]; then
      printf 'Production migration requires a clean tracked working tree.\n' >&2
      exit 2
    fi
    source_gate=gate
    attachment_gate=gate
    ;;
  qa-cache)
    if [[ "$qa_profile" != full || "${USL_QA_SEED_REFRESH:-0}" != 1 ]]; then
      printf 'QA cache refresh requires the full profile and seed publication.\n' >&2
      exit 2
    fi
    source_gate=product-gate
    attachment_gate=inventory
    ;;
  development)
    source_gate=product-gate
    attachment_gate=inventory
    ;;
  *)
    printf 'USL_MIGRATION_PURPOSE must be production, qa-cache, or development.\n' >&2
    exit 2
    ;;
esac

source_dump_dir="${USL_ONLINE_DUMP_DIR:-$ROOT/usl-online-dump}"
source_dump="$source_dump_dir/dump.sql"
if [[ ! -f "$source_dump" || ! -d "$source_dump_dir/filestore" ]]; then
  printf 'Migration source package is incomplete: %s\n' "$source_dump_dir" >&2
  exit 2
fi
source_sha256="$(shasum -a 256 "$source_dump" | awk '{print $1}')"
if [[ "$migration_purpose" == production ]]; then
  expected_source_sha256="${USL_MIGRATION_CONFIRM_SOURCE_SHA:-}"
  if [[ "$expected_source_sha256" != "$source_sha256" ]]; then
    printf 'Production migration requires confirmation of the exact source package.\n' >&2
    printf 'Source SHA-256: %s\n' "$source_sha256" >&2
    printf 'Retry with SOURCE_SHA=%s make migrate-production\n' "$source_sha256" >&2
    exit 2
  fi
fi

reuse_documents="${USL_RECONSTRUCT_REUSE_DOCUMENTS:-0}"
if [[ "$qa_profile" != full && "$reuse_documents" == 1 ]]; then
  printf 'Paperless checkpoint reuse is only valid for the full profile.\n' >&2
  exit 2
fi
case "$reuse_documents" in
  0)
    documents_reset=1
    documents_require_checkpoint=0
    printf 'Documents archive: fresh deterministic ingestion.\n'
    ;;
  1)
    documents_reset=0
    documents_require_checkpoint=1
    printf 'Documents archive: verified ingestion checkpoint reuse.\n'
    ;;
  *)
    printf 'USL_RECONSTRUCT_REUSE_DOCUMENTS must be 0 or 1.\n' >&2
    exit 2
    ;;
esac

resume_accounting="${USL_RECONSTRUCT_RESUME_ACCOUNTING:-0}"
case "$resume_accounting" in
  0) ;;
  1)
    if [[ "$migration_purpose" == production ]]; then
      printf 'Production migration cannot resume from development evidence.\n' >&2
      exit 2
    fi
    printf 'Accounting: resume requested; exact source parity will be revalidated before reuse.\n'
    ;;
  *)
    printf 'USL_RECONSTRUCT_RESUME_ACCOUNTING must be 0 or 1.\n' >&2
    exit 2
    ;;
esac

if [[ "$migration_purpose" == production ]]; then
  documents_task_workers="${USL_DOCUMENTS_TASK_WORKERS:-1}"
else
  documents_task_workers="${USL_DOCUMENTS_TASK_WORKERS:-3}"
fi

export ACCOUNTING_COMPAT_COMPOSE_PROJECT="${ACCOUNTING_COMPAT_COMPOSE_PROJECT:-$compose_project}"
timing_dir="$ROOT/artifacts/migration/private/runs"
mkdir -p "$timing_dir"
timing_tsv="$timing_dir/${compose_project}-reconstruct-$(date -u +%Y%m%dT%H%M%SZ).tsv"
timing_json="${timing_tsv%.tsv}.json"
: > "$timing_tsv"
run_started="$(date +%s)"
run_started_iso="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
git_commit="$(git rev-parse HEAD)"
migration_code_sha256="$(
  PYTHONPATH="$ROOT" python3 -c \
    'from pathlib import Path; from scripts.qa_seed import migration_digest; print(migration_digest(Path.cwd()))'
)"
seed_pending=0
accounting_validated=0

run_stage() {
  local label="$1" started status
  shift
  started="$(date +%s)"
  set +e
  (set -e; "$@")
  status=$?
  set -e
  printf '%s\t%s\t%s\n' "$label" "$(( $(date +%s) - started ))" "$status" >> "$timing_tsv"
  return "$status"
}

write_timing() {
  local outcome="$1"
  python3 - "$timing_tsv" "$timing_json" "$qa_profile" "$reuse_documents" "$run_started" "$outcome" "$ROOT" "$migration_purpose" "$source_sha256" "$git_commit" "$run_started_iso" "$compose_project" "$migration_code_sha256" <<'PY'
import hashlib
import json
import sys
import time
from pathlib import Path


def sha256(path):
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()

stages = []
for row in Path(sys.argv[1]).read_text(encoding="utf-8").splitlines():
    name, duration, status = row.split("\t")
    stages.append({"duration_seconds": int(duration), "name": name, "status": int(status)})
payload = {
    "schema": "usl-production-migration-run-v1",
    "cache": "same-project-checkpoint" if sys.argv[4] == "1" else "miss-fresh",
    "compose_project": sys.argv[12],
    "duration_seconds": int(time.time()) - int(sys.argv[5]),
    "finished_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
    "git_commit": sys.argv[10],
    "migration_code_sha256": sys.argv[13],
    "outcome": sys.argv[6],
    "profile": sys.argv[3],
    "purpose": sys.argv[8],
    "source_dump_sha256": sys.argv[9],
    "started_at": sys.argv[11],
    "stages": stages,
    "validation_level": (
        "production-source-wide"
        if sys.argv[8] == "production"
        else "canonical-full"
        if sys.argv[3] == "full"
        else "partial"
    ),
}
source_evidence = Path(sys.argv[7]) / "artifacts/migration/private" / (
    "source-" + sys.argv[9][:12]
)
inventory_path = source_evidence / "source-truth-inventory.json"
if inventory_path.is_file():
    inventory = json.loads(inventory_path.read_text(encoding="utf-8"))
    payload["source_coverage"] = {
        "blocking": inventory.get("blocking", {}),
        "complete": inventory.get("summary", {}).get("complete", False),
        "evidence": str(inventory_path),
        "evidence_sha256": sha256(inventory_path),
        "summary": inventory.get("summary", {}),
    }
ledger_path = source_evidence / "attachment-disposition-ledger.json"
if ledger_path.is_file():
    ledger = json.loads(ledger_path.read_text(encoding="utf-8"))
    payload["attachment_coverage"] = {
        "blocking": ledger.get("blocking", {}),
        "complete": ledger.get("summary", {}).get("complete", False),
        "evidence": str(ledger_path),
        "evidence_sha256": sha256(ledger_path),
        "summary": ledger.get("summary", {}),
    }
evidence = sorted(
    Path(sys.argv[7]).glob("accounting_compat/private/snapshots/*/evidence/documents-restore-*.json"),
    key=lambda path: path.stat().st_mtime,
)
if evidence and evidence[-1].stat().st_mtime >= int(sys.argv[5]):
    result = json.loads(evidence[-1].read_text(encoding="utf-8"))
    payload.update({
        "documents_evidence": str(evidence[-1]),
        "downloaded_bytes": result.get("submitted_bytes", 0),
        "ocr_submissions": result.get("ocr_submissions", 0),
        "reused_document_roots": result.get("reused_roots", 0),
    })
Path(sys.argv[2]).write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
PY
}

cleanup() {
  local status=$?
  trap - EXIT
  [[ "$seed_pending" == 0 ]] || scripts/qa-seed discard >/dev/null 2>&1 || true
  if ((status)); then
    write_timing failed
    if [[ "$accounting_validated" == 1 && "$migration_purpose" != production ]]; then
      printf '\nAccounting remains validated. Resume without replaying it:\n' >&2
      printf '  make qa-cache-resume\n' >&2
    fi
  fi
  exit "$status"
}
trap cleanup EXIT

start_target_database() {
  printf 'Target database: starting isolated PostgreSQL service.\n'
  docker compose -p "$compose_project" up -d --wait db
}

preflight_target_identity() {
  local configured_project
  USL_POCKET_ID_DEV_COMPOSE_PROJECT="$compose_project" \
    USL_POCKET_ID_DEV_ODOO_PORT="${ODOO_HTTP_PORT:-8069}" \
    USL_POCKET_ID_DEV_GEVENT_PORT="${ODOO_GEVENT_PORT:-8072}" \
    USL_POCKET_ID_DEV_POCKET_PORT="${POCKET_ID_HTTP_PORT:-1411}" \
    USL_POCKET_ID_DEV_PAPERLESS_PORT="${PAPERLESS_HTTP_PORT:-8010}" \
    USL_POCKET_ID_DEV_PAPERLESS_URL="${PAPERLESS_PUBLIC_URL:-http://paperless.localhost:${PAPERLESS_HTTP_PORT:-8010}}" \
    scripts/pocket-id-dev bootstrap >/dev/null
  configured_project="$(sed -n 's/^COMPOSE_PROJECT_NAME=//p' "$POCKET_ID_ENV_FILE" | tail -n 1)"
  if [[ "$configured_project" != "$compose_project" ]]; then
    printf 'Target reconstruction is blocked: Pocket ID configuration belongs to another project.\n' >&2
    printf 'Requested project: %s\n' "$compose_project" >&2
    printf 'Configured project: %s\n' "${configured_project:-missing}" >&2
    printf 'Configuration file: %s\n' "$POCKET_ID_ENV_FILE" >&2
    printf 'No source or target database was changed.\n' >&2
    printf 'Use a Pocket ID environment dedicated to this Compose project, then retry.\n' >&2
    return 2
  fi
}

stop_product() {
  docker compose -p "$compose_project" stop odoo >/dev/null 2>&1 || true
}

run_stage "target identity preflight" preflight_target_identity
start_target_database
stop_product
run_stage "restore source database" scripts/accounting-compat source-restore
run_stage "source coverage gate" scripts/migration-source-truth "$source_gate"
run_stage "attachment disposition gate" scripts/attachment-ledger "$attachment_gate"
run_stage "sync pinned OCA add-ons" scripts/sync-oca-addons
run_stage "source accounting controls" scripts/accounting-compat source-controls
run_stage "extract accounting source" scripts/accounting-compat extract
if [[ "$resume_accounting" == 1 ]]; then
  stop_product
  run_stage "revalidate reusable accounting" scripts/accounting-compat dev-validate
else
  run_stage "reset target database" scripts/accounting-compat dev-reset
  stop_product
  run_stage "import accounting" scripts/accounting-compat dev-import
  stop_product
  run_stage "validate accounting" scripts/accounting-compat dev-validate
fi
accounting_validated=1
stop_product
run_stage "prepare Documents product" env DOCUMENTS_CANONICAL_TARGET=1 \
  DOCUMENTS_TARGET_DATABASE=odoo_dev \
  COMPOSE_PROJECT_NAME="$compose_project" \
  scripts/documents-restore prepare-target
stop_product
run_stage "restore identities" scripts/identity-restore all
stop_product
run_stage "restore product data" scripts/product-restore all
stop_product
run_stage "restore B2C commerce evidence" scripts/b2c-restore all
stop_product
run_stage "restore HR" scripts/hr-restore all
stop_product
run_stage "restore Projects" env PROJECT_RESTORE_DEFER_PRODUCT_VALIDATE=1 scripts/project-restore all
stop_product
run_stage "restore Paie TESE" env TESE_RESTORE_DEFER_PRODUCT_VALIDATE=1 scripts/tese-restore all
stop_product
run_stage "restore Platform Billing" env COMPOSE_PROJECT_NAME="$compose_project" scripts/platform-billing-restore all
stop_product
if [[ "$documents_enabled" == 1 ]]; then
  run_stage "restore Documents archive" env DOCUMENTS_CANONICAL_TARGET=1 \
    DOCUMENTS_CANONICAL_RESET="$documents_reset" \
    DOCUMENTS_REQUIRE_CHECKPOINT="$documents_require_checkpoint" \
    DOCUMENTS_RESTORE_PROFILE="$documents_profile" \
    DOCUMENTS_PAPERLESS_TASK_WORKERS="$documents_task_workers" \
    DOCUMENTS_TARGET_DATABASE=odoo_dev \
    COMPOSE_PROJECT_NAME="$compose_project" \
    scripts/documents-restore all
  stop_product
else
  printf 'Documents archive: skipped by explicit no-documents QA profile.\n'
fi
run_stage "finalize migration boundary" scripts/accounting-restore finalize

seed_refresh="${USL_QA_SEED_REFRESH:-0}"
case "$seed_refresh" in
  0) ;;
  1)
    if [[ "$qa_profile" != full || "$reuse_documents" != 0 ]]; then
      printf 'QA seed refresh requires a full fresh Documents reconstruction.\n' >&2
      exit 2
    fi
    run_stage "capture pending QA seed" scripts/qa-seed capture
    seed_pending=1
    ;;
  *)
    printf 'USL_QA_SEED_REFRESH must be 0 or 1.\n' >&2
    exit 2
    ;;
esac

run_stage "apply target configuration" env USL_QA_DATA_PROFILE="$qa_profile" scripts/target-finalize
if [[ "$qa_profile" == full ]]; then
  run_stage "multi-company acceptance" make \
    COMPOSE_PROJECT="$compose_project" accounting-multicompany-acceptance
fi
if [[ "$seed_refresh" == 1 ]]; then
  run_stage "publish qualified QA seed" scripts/qa-seed publish
  seed_pending=0
fi

write_timing passed
trap - EXIT
printf '\nReconstruction complete: purpose=%s profile=%s.\n' \
  "$migration_purpose" "$qa_profile"
printf 'Timing evidence: %s\n' "$timing_json"
