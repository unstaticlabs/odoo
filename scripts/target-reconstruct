#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
source "$ROOT/scripts/lib/compose-scope.sh"

usl_require_explicit_compose_project "Canonical reconstruction"
compose_project="$COMPOSE_PROJECT_NAME"
usl_verify_compose_scope "$compose_project" "$ROOT" "Canonical reconstruction"

if [[ -f "$ROOT/.git" && -z "${POCKET_ID_ENV_FILE:-}" ]]; then
  export POCKET_ID_ENV_FILE="$ROOT/.pocket-id-${compose_project}.env"
  printf 'Pocket ID: using isolated project environment %s.\n' \
    "$(basename "$POCKET_ID_ENV_FILE")"
fi

if [[ "${ODOO_DEV_DB:-odoo_dev}" != "odoo_dev" ]]; then
  printf 'Canonical reconstruction is reserved for odoo_dev.\n' >&2
  exit 2
fi

export USL_EINVOICE_LIVE_ENABLED=0
export USL_EREPORTING_LIVE_ENABLED=0
export COMPOSE_IGNORE_ORPHANS=1

reuse_documents="${USL_RECONSTRUCT_REUSE_DOCUMENTS:-0}"
case "$reuse_documents" in
  0)
    documents_reset=1
    documents_require_checkpoint=0
    printf 'Documents archive: fresh deterministic ingestion.\n'
    ;;
  1)
    documents_reset=0
    documents_require_checkpoint=1
    printf 'Documents archive: verified ingestion checkpoint reuse.\n'
    ;;
  *)
    printf 'USL_RECONSTRUCT_REUSE_DOCUMENTS must be 0 or 1.\n' >&2
    exit 2
    ;;
esac

export ACCOUNTING_COMPAT_COMPOSE_PROJECT="${ACCOUNTING_COMPAT_COMPOSE_PROJECT:-$compose_project}"
start_target_database() {
  printf 'Target database: starting isolated PostgreSQL service.\n'
  docker compose -p "$compose_project" up -d --wait db
}

stop_product() {
  docker compose -p "$compose_project" stop odoo >/dev/null 2>&1 || true
}

start_target_database
stop_product
scripts/accounting-compat source-restore
scripts/migration-source-truth product-gate
scripts/sync-oca-addons
scripts/accounting-compat source-restore
scripts/accounting-compat source-controls
scripts/accounting-compat extract
scripts/accounting-compat dev-reset
stop_product
scripts/accounting-compat dev-import
stop_product
scripts/accounting-compat dev-validate
stop_product
DOCUMENTS_CANONICAL_TARGET=1 \
  DOCUMENTS_TARGET_DATABASE=odoo_dev \
  COMPOSE_PROJECT_NAME="$compose_project" \
  scripts/documents-restore prepare-target
stop_product
scripts/identity-restore all
stop_product
scripts/product-restore all
stop_product
scripts/hr-restore all
stop_product
PROJECT_RESTORE_DEFER_PRODUCT_VALIDATE=1 scripts/project-restore all
stop_product
TESE_RESTORE_DEFER_PRODUCT_VALIDATE=1 scripts/tese-restore all
stop_product
COMPOSE_PROJECT_NAME="$compose_project" scripts/platform-billing-restore all
stop_product
DOCUMENTS_CANONICAL_TARGET=1 \
  DOCUMENTS_CANONICAL_RESET="$documents_reset" \
  DOCUMENTS_REQUIRE_CHECKPOINT="$documents_require_checkpoint" \
  DOCUMENTS_TARGET_DATABASE=odoo_dev \
  COMPOSE_PROJECT_NAME="$compose_project" \
  scripts/documents-restore all
stop_product
scripts/accounting-restore finalize
scripts/target-finalize

printf '\nCanonical reconstruction complete: source parity plus target configuration.\n'
