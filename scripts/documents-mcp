#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
  printf '%s\n' \
    "Usage: scripts/documents-mcp <qa|preprod> <verify|test|bundle|dev|readiness>" \
    "" \
    "USL_DOCUMENTS_MCP_REPOSITORY must identify the independent odoo-mcp checkout." \
    "Pre-production also requires USL_DOCUMENTS_PREPROD_ENV." >&2
  exit 2
}

ENVIRONMENT="${1:-}"
COMMAND="${2:-}"
case "$ENVIRONMENT" in
  qa)
    ENV_FILE="${USL_DOCUMENTS_QA_ENV:-$ROOT/deploy/documents/qa.env}"
    ;;
  preprod)
    ENV_FILE="${USL_DOCUMENTS_PREPROD_ENV:-}"
    [[ -n "$ENV_FILE" && -f "$ENV_FILE" ]] || {
      printf 'Set USL_DOCUMENTS_PREPROD_ENV to a populated pre-production env file.\n' >&2
      exit 2
    }
    ;;
  *) usage ;;
esac
[[ -f "$ENV_FILE" ]] || {
  printf 'Documents environment is missing: %s\n' "$ENV_FILE" >&2
  exit 2
}

env_value() {
  local name="$1"
  sed -n "s/^${name}=//p" "$ENV_FILE" | tail -n 1
}

required_value() {
  local name="$1"
  local value
  value="$(env_value "$name")"
  [[ -n "$value" ]] || {
    printf '%s is missing from %s.\n' "$name" "$ENV_FILE" >&2
    exit 2
  }
  printf '%s' "$value"
}

EXPECTED_COMMIT="$(required_value ODOO_MCP_RELEASE_COMMIT)"
EXPECTED_VERSION="$(required_value ODOO_MCP_SERVER_VERSION)"
EXPECTED_WORKER_SHA256="$(required_value ODOO_MCP_WORKER_SHA256)"
PUBLIC_BASE_URL="$(required_value ODOO_MCP_PUBLIC_BASE_URL)"
DOCUMENTS_URL="$(required_value ODOO_MCP_DOCUMENTS_URL)"
HTTP_PORT="$(required_value ODOO_MCP_HTTP_PORT)"
INSPECTOR_PORT="$(required_value ODOO_MCP_INSPECTOR_PORT)"
LOCAL_STATE="$(required_value ODOO_MCP_LOCAL_STATE)"
MCP_REPOSITORY="${USL_DOCUMENTS_MCP_REPOSITORY:-}"
BUNDLE_TEMPORARY=""

cleanup_bundle() {
  if [[ -n "$BUNDLE_TEMPORARY" && -d "$BUNDLE_TEMPORARY" ]]; then
    find "$BUNDLE_TEMPORARY" -mindepth 1 -delete
    rmdir "$BUNDLE_TEMPORARY"
  fi
  BUNDLE_TEMPORARY=""
}

validate_settings() {
  [[ "$EXPECTED_COMMIT" =~ ^[0-9a-f]{40}$ ]] || {
    printf 'ODOO_MCP_RELEASE_COMMIT is not a full Git commit.\n' >&2
    return 1
  }
  [[ "$EXPECTED_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || {
    printf 'ODOO_MCP_SERVER_VERSION is not semantic.\n' >&2
    return 1
  }
  [[ "$EXPECTED_WORKER_SHA256" =~ ^[0-9a-f]{64}$ ]] || {
    printf 'ODOO_MCP_WORKER_SHA256 is not a SHA-256 digest.\n' >&2
    return 1
  }
  [[ "$HTTP_PORT" =~ ^[0-9]+$ && "$INSPECTOR_PORT" =~ ^[0-9]+$ ]] || {
    printf 'MCP runtime and Inspector ports must be numeric.\n' >&2
    return 1
  }
  [[ "$PUBLIC_BASE_URL" =~ ^https?://[^/]+$ ]] || {
    printf 'ODOO_MCP_PUBLIC_BASE_URL must be an origin without a path.\n' >&2
    return 1
  }
  [[ "$DOCUMENTS_URL" = "$PUBLIC_BASE_URL/documents/mcp" ]] || {
    printf 'ODOO_MCP_DOCUMENTS_URL must be the configured origin plus /documents/mcp.\n' >&2
    return 1
  }
  if [[ "$ENVIRONMENT" = preprod && "$PUBLIC_BASE_URL" != https://* ]]; then
    printf 'Pre-production MCP must use HTTPS.\n' >&2
    return 1
  fi
  case "$LOCAL_STATE" in
    /private/tmp/*|/tmp/*) ;;
    *)
      printf 'Local Wrangler state must use a task-scoped temporary path.\n' >&2
      return 1
      ;;
  esac
}

verify_repository() {
  [[ -n "$MCP_REPOSITORY" && -d "$MCP_REPOSITORY/.git" ]] || {
    printf 'USL_DOCUMENTS_MCP_REPOSITORY must identify an odoo-mcp checkout.\n' >&2
    return 2
  }
  local actual_commit actual_version status
  actual_commit="$(git -C "$MCP_REPOSITORY" rev-parse HEAD)"
  [[ "$actual_commit" = "$EXPECTED_COMMIT" ]] || {
    printf 'Odoo MCP is %s, expected %s.\n' "$actual_commit" "$EXPECTED_COMMIT" >&2
    return 1
  }
  status="$(git -C "$MCP_REPOSITORY" status --porcelain=v1 --untracked-files=all)"
  [[ -z "$status" ]] || {
    printf 'Odoo MCP checkout is dirty; refusing release evidence.\n' >&2
    return 1
  }
  actual_version="$({
    sed -n 's/^export const SERVER_VERSION = "\([^"]*\)";.*/\1/p' \
      "$MCP_REPOSITORY/src/server.ts"
  })"
  [[ "$actual_version" = "$EXPECTED_VERSION" ]] || {
    printf 'Odoo MCP server version is %s, expected %s.\n' \
      "${actual_version:-<missing>}" "$EXPECTED_VERSION" >&2
    return 1
  }
  grep -Fq 'path: "/documents/mcp"' "$MCP_REPOSITORY/src/index.ts" || {
    printf 'The focused Documents MCP route is missing.\n' >&2
    return 1
  }
  grep -Fq '"name": "DocumentsAgent"' "$MCP_REPOSITORY/wrangler.jsonc" || {
    printf 'The Documents Durable Object binding is missing.\n' >&2
    return 1
  }
  printf 'Odoo MCP verified: commit=%s version=%s documents=%s\n' \
    "$actual_commit" "$actual_version" "$DOCUMENTS_URL"
}

bundle_worker() {
  local artifact_dir worker_sha
  BUNDLE_TEMPORARY="$(
    mktemp -d "${TMPDIR:-/tmp}/usl-documents-mcp-bundle.XXXXXX"
  )"
  trap cleanup_bundle EXIT INT TERM
  (
    cd "$MCP_REPOSITORY"
    bunx wrangler deploy --dry-run --outdir "$BUNDLE_TEMPORARY"
  )
  worker_sha="$(
    shasum -a 256 "$BUNDLE_TEMPORARY/index.js" | awk '{print $1}'
  )"
  [[ "$worker_sha" = "$EXPECTED_WORKER_SHA256" ]] || {
    printf 'Compiled Worker digest is %s, expected %s.\n' \
      "$worker_sha" "$EXPECTED_WORKER_SHA256" >&2
    return 1
  }
  artifact_dir="${USL_DOCUMENTS_MCP_ARTIFACT_DIR:-$ROOT/artifacts/release/odoo-mcp}"
  mkdir -p "$artifact_dir"
  install -m 0644 "$BUNDLE_TEMPORARY/index.js" "$artifact_dir/index.js"
  install -m 0644 "$BUNDLE_TEMPORARY/index.js.map" "$artifact_dir/index.js.map"
  install -m 0644 "$BUNDLE_TEMPORARY/README.md" "$artifact_dir/README.md"
  python3 - \
    "$EXPECTED_COMMIT" "$EXPECTED_VERSION" "$worker_sha" \
    "$PUBLIC_BASE_URL" "$DOCUMENTS_URL" \
    > "$artifact_dir/identity.json" <<'PY'
import hashlib
import json
import sys

(
    commit,
    version,
    worker_sha,
    base_url,
    documents_url,
) = sys.argv[1:]
identity = {
    "schema": "usl-documents-mcp-identity-v1",
    "commit": commit,
    "server_version": version,
    "worker_sha256": worker_sha,
    "public_base_url": base_url,
    "endpoints": {
        "full": f"{base_url}/mcp",
        "documents": documents_url,
    },
}
canonical = json.dumps(identity, sort_keys=True, separators=(",", ":"))
identity["identity_sha256"] = hashlib.sha256(canonical.encode()).hexdigest()
print(json.dumps(identity, indent=2, sort_keys=True))
PY
  printf 'Odoo MCP dry-run artifact: %s (sha256=%s)\n' \
    "$artifact_dir/index.js" "$worker_sha"
  printf 'Odoo MCP identity: %s\n' "$artifact_dir/identity.json"
  cleanup_bundle
}

runtime_readiness() {
  local endpoint status
  for endpoint in "$PUBLIC_BASE_URL/mcp" "$DOCUMENTS_URL"; do
    status="$(
      curl --silent --show-error --output /dev/null --write-out '%{http_code}' \
        --request POST --header 'Content-Type: application/json' \
        --data '{}' "$endpoint"
    )"
    [[ "$status" = 401 ]] || {
      printf 'MCP readiness expected an authenticated 401 from %s, got %s.\n' \
        "$endpoint" "$status" >&2
      return 1
    }
  done
  printf 'Odoo MCP readiness passed for /mcp and /documents/mcp.\n'
}

validate_settings
case "$COMMAND" in
  verify)
    verify_repository
    ;;
  test)
    verify_repository
    (cd "$MCP_REPOSITORY" && bun run typecheck && bun test)
    ;;
  bundle)
    verify_repository
    bundle_worker
    ;;
  dev)
    verify_repository
    mkdir -p "$LOCAL_STATE"
    cd "$MCP_REPOSITORY"
    exec bunx wrangler dev --port "$HTTP_PORT" --persist-to "$LOCAL_STATE"
    ;;
  readiness)
    runtime_readiness
    ;;
  *) usage ;;
esac
