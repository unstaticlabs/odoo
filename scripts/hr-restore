#!/usr/bin/env bash
set -euo pipefail
export COMPOSE_IGNORE_ORPHANS=1

command_name="${1:-all}"
compose_project="${COMPOSE_PROJECT_NAME:-usl-odoo-saas-19-2}"
target_database="${HR_TARGET_DATABASE:-odoo_dev}"
source_dump_dir="${USL_ONLINE_DUMP_DIR:-/Users/valentin/Code/odoo/usl-online-dump}"
migration_addons_path="/opt/odoo/addons,/opt/odoo/odoo/addons,/mnt/custom-addons,/mnt/oca-addons,/mnt/accounting-migration-addons,/mnt/project-migration-addons,/mnt/identity-migration-addons,/mnt/product-migration-addons,/mnt/hr-migration-addons"

case "$target_database" in
    odoo_online_source_saas_19_2|odoo_saas_19_2_validation_exact|odoo_saas_19_2_validation_native)
        echo "Refusing protected HR target $target_database." >&2
        exit 2
        ;;
esac
if [[ ! -f "$source_dump_dir/dump.sql" || ! -d "$source_dump_dir/filestore" ]]; then
    echo "Source dump or filestore is missing under $source_dump_dir." >&2
    exit 2
fi
source_dump_dir="$(cd "$source_dump_dir" && pwd -P)"
source_sha256="$(shasum -a 256 "$source_dump_dir/dump.sql" | awk '{print $1}')"
source_snapshot="source-${source_sha256:0:12}"
export USL_ONLINE_DUMP_DIR="$source_dump_dir"
export USL_EINVOICE_LIVE_ENABLED=0
export USL_EREPORTING_LIVE_ENABLED=0
compose=(docker compose -p "$compose_project")

product_was_running=0
if "${compose[@]}" ps --status running --services | grep -qx odoo; then
    product_was_running=1
    "${compose[@]}" stop odoo >/dev/null
fi
restore_product_service() {
    if ((product_was_running)); then
        "${compose[@]}" up -d --wait odoo
    fi
}
trap restore_product_service EXIT INT TERM

run_shell() {
    local script_path="$1"
    "${compose[@]}" --profile project-migration run --rm -T \
        -e HR_SOURCE_DB_HOST="${HR_SOURCE_DB_HOST:-accounting-source-db}" \
        -e HR_SOURCE_DB_PORT="${HR_SOURCE_DB_PORT:-5432}" \
        -e HR_SOURCE_DB_USER="${HR_SOURCE_DB_USER:-odoo}" \
        -e HR_SOURCE_DB_PASSWORD="${HR_SOURCE_DB_PASSWORD:-odoo}" \
        -e HR_SOURCE_DATABASE="${HR_SOURCE_DATABASE:-odoo_online_source_saas_19_2}" \
        -e HR_SOURCE_SNAPSHOT="$source_snapshot" \
        project-migration odoo shell --config=/etc/odoo/odoo.conf \
        --addons-path="$migration_addons_path" --database="$target_database" \
        --shell-interface=python < "$script_path"
}

install_module() {
    local operation="--init=usl_hr_restore"
    if "${compose[@]}" exec -T db psql -U "${ODOO_DB_USER:-odoo}" \
        -d "$target_database" -Atc \
        "SELECT 1 FROM ir_module_module WHERE name='usl_hr_restore' AND state='installed'" \
        | grep -qx 1; then
        operation="--update=usl_hr_restore"
    fi
    "${compose[@]}" --profile project-migration run --rm \
        -e ODOO_INIT_DB="$target_database" project-migration \
        odoo --config=/etc/odoo/odoo.conf \
        --addons-path="$migration_addons_path" --database="$target_database" \
        "$operation" --without-demo=true --stop-after-init
}

case "$command_name" in
    install) install_module ;;
    import) run_shell migration/hr_restore/addons/usl_hr_restore/scripts/run_restore.py ;;
    validate) run_shell migration/hr_restore/addons/usl_hr_restore/scripts/validate_restore.py ;;
    finalize)
        run_shell migration/hr_restore/addons/usl_hr_restore/scripts/finalize_restore.py
        scripts/check-product-migration-boundary
        ;;
    all)
        install_module
        run_shell migration/hr_restore/addons/usl_hr_restore/scripts/run_restore.py
        run_shell migration/hr_restore/addons/usl_hr_restore/scripts/validate_restore.py
        run_shell migration/hr_restore/addons/usl_hr_restore/scripts/finalize_restore.py
        scripts/check-product-migration-boundary
        ;;
    *)
        echo "Usage: scripts/hr-restore [install|import|validate|finalize|all]" >&2
        exit 2
        ;;
esac
