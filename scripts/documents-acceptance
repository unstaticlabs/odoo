#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
# shellcheck source=lib/ollama-runtime.sh
source "$ROOT/scripts/lib/ollama-runtime.sh"

ENVIRONMENT="${1:-qa}"
case "$ENVIRONMENT" in
  qa)
    ENV_FILE="$ROOT/deploy/documents/qa.env"
    SSO_ENV_FILE="$ROOT/.documents-qa-sso.env"
    python3 "$ROOT/scripts/documents_sso_env.py" "$SSO_ENV_FILE" >/dev/null
    OVERRIDE="$ROOT/compose.documents.qa.yaml"
    PROJECT="codex-paperless-docs"
    DATABASE="odoo_usl_documents_test"
    ;;
  preprod)
    ENV_FILE="${USL_DOCUMENTS_PREPROD_ENV:-}"
    [[ -n "$ENV_FILE" && -f "$ENV_FILE" ]] || {
      printf 'Set USL_DOCUMENTS_PREPROD_ENV to the populated pre-production env file.\n' >&2
      exit 2
    }
    SSO_ENV_FILE=""
    OVERRIDE="$ROOT/compose.documents.preprod.yaml"
    PROJECT="${USL_DOCUMENTS_PREPROD_PROJECT:-usl-documents-preprod}"
    DATABASE="${USL_DOCUMENTS_PREPROD_DB:-odoo_usl_documents_preprod}"
    ;;
  *)
    printf 'Usage: scripts/documents-acceptance <qa|preprod>\n' >&2
    exit 2
    ;;
esac
case "$PROJECT" in
  ""|usl-odoo-saas-19-3|odoo|production|prod|*canonical*|*[!A-Za-z0-9_.-]*)
    printf 'Refusing shared or invalid Compose project: %s\n' "$PROJECT" >&2
    exit 2
    ;;
esac
case "$DATABASE" in
  ""|odoo_dev|*[!A-Za-z0-9_]*)
    printf 'Refusing unsafe Documents database: %s\n' "$DATABASE" >&2
    exit 2
    ;;
esac

scripts/documents-stack "$ENVIRONMENT" preflight >/dev/null
if [[ "$ENVIRONMENT" = "qa" ]]; then
  scripts/documents-stack qa up >/dev/null
fi
ENV_FILES=(--env-file "$ENV_FILE")
if [[ -n "$SSO_ENV_FILE" ]]; then
  ENV_FILES+=(--env-file "$SSO_ENV_FILE")
fi
usl_prepare_ollama_runtime "$ROOT"
COMPOSE=(
  docker compose
  "${ENV_FILES[@]}"
  -p "$PROJECT"
  -f "$ROOT/compose.yaml"
  -f "$ROOT/compose.pocket-id.yaml"
  -f "$OVERRIDE"
  --profile paperless
)
if [[ -n "$USL_OLLAMA_COMPOSE_OVERRIDE" ]]; then
  COMPOSE+=(-f "$USL_OLLAMA_COMPOSE_OVERRIDE")
fi
PAPERLESS_SERVICES=(
  pocket-id
  paperless-preflight
  paperless-db
  paperless-broker
  paperless-gotenberg
  paperless-tika
  paperless-webserver
)

restore_services() {
  "${COMPOSE[@]}" up -d --wait --pull never "${PAPERLESS_SERVICES[@]}" >/dev/null 2>&1 || true
  "${COMPOSE[@]}" up -d --wait --pull never odoo >/dev/null 2>&1 || true
}
trap restore_services EXIT INT TERM

run_shell() {
  local script="$1"
  "${COMPOSE[@]}" --profile init run --rm -T \
    -e ODOO_INIT_DB="$DATABASE" \
    init-db odoo shell \
    --config=/etc/odoo/odoo.conf \
    --database="$DATABASE" < "$script"
}

"${COMPOSE[@]}" up -d --wait --pull never "${PAPERLESS_SERVICES[@]}"
"${COMPOSE[@]}" stop odoo >/dev/null 2>&1 || true

run_shell "$ROOT/scripts/odoo/documents_compose_acceptance.py"

if [[ "$ENVIRONMENT" = "qa" ]]; then
  paperless_public_url="$(
    sed -n 's/^PAPERLESS_PUBLIC_URL=//p' "$ENV_FILE" | tail -n 1
  )"
  [[ -n "$paperless_public_url" ]] || {
    printf 'Documents QA Paperless public URL is missing.\n' >&2
    exit 1
  }
  paperless_api="${paperless_public_url%/}/api"
  shared_view_names=("Contracts & legal" "Banking" "Tax & reporting")
  for username in \
    archive-admin \
    documents-user \
    documents-accountant \
    documents-hr \
    documents-restricted
  do
    documents_payload="$(
      curl --fail --silent --show-error \
        --user "${username}:admin" \
        --header "Accept: application/json; version=10" \
        "${paperless_api}/documents/?page_size=1"
    )"
    saved_views_payload="$(
      curl --fail --silent --show-error \
        --user "${username}:admin" \
        --header "Accept: application/json; version=10" \
        "${paperless_api}/saved_views/?page_size=100"
    )"
    for view_name in "${shared_view_names[@]}"; do
      grep -Fq "\"name\":\"${view_name}\"" <<<"$saved_views_payload" || {
        printf 'Paperless identity %s cannot see shared view %s.\n' \
          "$username" "$view_name" >&2
        exit 1
      }
    done
    if [[ "$username" != "archive-admin" ]]; then
      shared_view_id="$(
        sed -n 's/.*"results":\[{"id":\([0-9][0-9]*\).*/\1/p' \
          <<<"$saved_views_payload"
      )"
      change_status="$(
        curl --silent --show-error \
          --user "${username}:admin" \
          --header "Accept: application/json; version=10" \
          --header "Content-Type: application/json" \
          --request PATCH \
          --data '{"sort_reverse":true}' \
          --output /dev/null \
          --write-out "%{http_code}" \
          "${paperless_api}/saved_views/${shared_view_id}/"
      )"
      [[ "$change_status" = "403" ]] || {
        printf 'Ordinary Paperless identity %s can change a shared view.\n' \
          "$username" >&2
        exit 1
      }
    fi
    if [[ "$username" = "documents-restricted" ]]; then
      grep -Eq '^\{"count":0,' <<<"$documents_payload" || {
        printf 'Restricted Paperless identity can infer document results.\n' >&2
        exit 1
      }
    else
      grep -Eq '^\{"count":[1-9][0-9]*,' <<<"$documents_payload" || {
        printf 'Paperless identity %s has no authorized direct-use documents.\n' \
          "$username" >&2
        exit 1
      }
    fi
  done
  printf '%s\n' \
    "DOCUMENTS_DIRECT_IDENTITIES_OK shared_views=3 restricted_documents=0"
fi

"${COMPOSE[@]}" stop paperless-webserver
run_shell "$ROOT/scripts/odoo/documents_outage_acceptance.py"

"${COMPOSE[@]}" up -d --wait --pull never paperless-webserver
run_shell "$ROOT/scripts/odoo/documents_recovery_acceptance.py"

restore_services
trap - EXIT INT TERM
printf 'DOCUMENTS_ACCEPTANCE_OK environment=%s project=%s database=%s\n' \
  "$ENVIRONMENT" "$PROJECT" "$DATABASE"
