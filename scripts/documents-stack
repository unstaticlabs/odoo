#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
source "$ROOT/scripts/lib/compose-scope.sh"
source "$ROOT/scripts/lib/ollama-runtime.sh"

usage() {
  printf '%s\n' \
    "Usage: scripts/documents-stack <qa|preprod> <config|preflight|build|up|update|bootstrap|status|logs|stop|test|test-accounting|test-pocket|test-js> [args]" \
    "" \
    "QA is fixed to project codex-paperless-docs, database odoo_usl_documents_test," \
    "Odoo 127.0.0.1:18080, and Paperless 127.0.0.1:18010." >&2
  exit 2
}

ENVIRONMENT="${1:-}"
COMMAND="${2:-}"
shift $(( $# >= 2 ? 2 : $# ))

case "$ENVIRONMENT" in
  qa)
    qa_override="${USL_DOCUMENTS_QA_ISOLATED_OVERRIDE:-0}"
    case "$qa_override" in
      0|1) ;;
      *)
        printf 'USL_DOCUMENTS_QA_ISOLATED_OVERRIDE must be 0 or 1.\n' >&2
        exit 2
        ;;
    esac
    if [[ "$qa_override" = 0 ]] \
      && [[ -n "${USL_DOCUMENTS_QA_ENV:-}" \
        || -n "${USL_DOCUMENTS_QA_SSO_ENV:-}" \
        || -n "${USL_DOCUMENTS_QA_PROJECT:-}" \
        || -n "${USL_DOCUMENTS_QA_DB:-}" ]]; then
      printf 'QA scope overrides require USL_DOCUMENTS_QA_ISOLATED_OVERRIDE=1.\n' >&2
      exit 2
    fi
    ENV_FILE="${USL_DOCUMENTS_QA_ENV:-$ROOT/deploy/documents/qa.env}"
    SSO_ENV_FILE="${USL_DOCUMENTS_QA_SSO_ENV:-$ROOT/.documents-qa-sso.env}"
    [[ -f "$ENV_FILE" ]] || {
      printf 'Documents QA environment is missing: %s\n' "$ENV_FILE" >&2
      exit 2
    }
    if [[ -n "${USL_DOCUMENTS_QA_SSO_ENV:-}" ]]; then
      [[ -f "$SSO_ENV_FILE" ]] || {
        printf 'Documents QA SSO environment is missing: %s\n' "$SSO_ENV_FILE" >&2
        exit 2
      }
    else
      python3 "$ROOT/scripts/documents_sso_env.py" "$SSO_ENV_FILE" >/dev/null
    fi
    OVERRIDE="$ROOT/compose.documents.qa.yaml"
    PROJECT="${USL_DOCUMENTS_QA_PROJECT:-codex-paperless-docs}"
    DATABASE="${USL_DOCUMENTS_QA_DB:-odoo_usl_documents_test}"
    ;;
  preprod)
    ENV_FILE="${USL_DOCUMENTS_PREPROD_ENV:-}"
    [[ -n "$ENV_FILE" && -f "$ENV_FILE" ]] || {
      printf 'Set USL_DOCUMENTS_PREPROD_ENV to a populated pre-production env file.\n' >&2
      exit 2
    }
    SSO_ENV_FILE=""
    OVERRIDE="$ROOT/compose.documents.preprod.yaml"
    PROJECT="${USL_DOCUMENTS_PREPROD_PROJECT:-usl-documents-preprod}"
    DATABASE="${USL_DOCUMENTS_PREPROD_DB:-odoo_usl_documents_preprod}"
    ;;
  *)
    usage
    ;;
esac

case "$PROJECT" in
  ""|usl-odoo-saas-19-3|*[!A-Za-z0-9_.-]*)
    printf 'Refusing unsafe Documents Compose project: %s\n' "$PROJECT" >&2
    exit 2
    ;;
esac
case "$DATABASE" in
  ""|*[!A-Za-z0-9_]*)
    printf 'Refusing unsafe Documents database: %s\n' "$DATABASE" >&2
    exit 2
    ;;
  odoo_dev)
    if [[ "$ENVIRONMENT" != "preprod" \
        || "${USL_DOCUMENTS_ALLOW_ODOO_DEV_RECOVERY:-0}" != "1" \
        || "${USL_DOCUMENTS_LOCAL_PREPROD_RECOVERY:-0}" != "1" \
        || ( "$PROJECT" != usl-odoo-preprod-* \
          && "$PROJECT" != usl-odoo-paperless-* ) ]]; then
      printf 'Refusing unsafe Documents database: %s\n' "$DATABASE" >&2
      exit 2
    fi
    ;;
esac
usl_verify_compose_scope "$PROJECT" "$ROOT" "Documents stack"

ENV_FILES=(--env-file "$ENV_FILE")
if [[ -n "$SSO_ENV_FILE" ]]; then
  ENV_FILES+=(--env-file "$SSO_ENV_FILE")
fi
COMPOSE_OVERRIDE=(-f "$OVERRIDE")
if [[ "$ENVIRONMENT" = "preprod" \
    && "${USL_DOCUMENTS_LOCAL_PREPROD_RECOVERY:-0}" = "1" \
    && "$PROJECT" = usl-odoo-paperless-* ]]; then
  COMPOSE_OVERRIDE=()
fi
usl_prepare_ollama_runtime "$ROOT"
if [[ -n "$USL_OLLAMA_COMPOSE_OVERRIDE" ]]; then
  COMPOSE_OVERRIDE+=(-f "$USL_OLLAMA_COMPOSE_OVERRIDE")
fi
COMPOSE=(
  docker compose
  "${ENV_FILES[@]}"
  -p "$PROJECT"
  -f "$ROOT/compose.yaml"
  -f "$ROOT/compose.pocket-id.yaml"
  "${COMPOSE_OVERRIDE[@]}"
  --profile paperless
)
SERVICES=(
  db
  pocket-id
  paperless-preflight
  paperless-db
  paperless-broker
  paperless-model-preflight
  paperless-trash-init
  paperless-gotenberg
  paperless-tika
  paperless-webserver
  odoo
)
OLLAMA_SERVICES=()
if [[ "$USL_OLLAMA_RUNTIME_SELECTED" == container ]]; then
  OLLAMA_SERVICES=(paperless-ollama paperless-model-init)
  SERVICES+=("${OLLAMA_SERVICES[@]}")
fi
UPDATE_MODULES="usl_locale,usl_pocketid,usl_documents,usl_documents_accounting"
[[ "$UPDATE_MODULES" =~ ^[A-Za-z0-9_,]+$ ]] || {
  printf 'Refusing unsafe Documents module update list: %s\n' "$UPDATE_MODULES" >&2
  exit 2
}

validate_config() {
  local config trash_delay qa_odoo_port qa_gevent_port qa_paperless_port
  config="$("${COMPOSE[@]}" config)"
  if [[ "$ENVIRONMENT" = "preprod" ]] && grep -Fq "CHANGE_ME" "$ENV_FILE"; then
    printf 'Pre-production env still contains CHANGE_ME placeholders.\n' >&2
    return 1
  fi
  grep -Fq "ODOO_DB_FILTER: ^${DATABASE}\$" <<<"$config" || {
    printf 'Rendered Odoo database filter does not target %s.\n' "$DATABASE" >&2
    return 1
  }
  grep -Fq "ODOO_DB_NAME: ${DATABASE}" <<<"$config" || {
    printf 'Rendered Odoo runtime database does not target %s.\n' "$DATABASE" >&2
    return 1
  }
  grep -Fq "USL_EINVOICE_LIVE_ENABLED: \"0\"" <<<"$config" || {
    printf 'Electronic-invoice live safety flag is not disabled.\n' >&2
    return 1
  }
  grep -Fq "USL_EREPORTING_LIVE_ENABLED: \"0\"" <<<"$config" || {
    printf 'E-reporting live safety flag is not disabled.\n' >&2
    return 1
  }
  grep -Fq "PAPERLESS_BASE_IMAGE: ghcr.io/paperless-ngx/paperless-ngx@sha256:65a4cabf0169ea7fbd90ab7bb28ba3f8b5909613635acda1a03ad606f34b456b" <<<"$config" || {
    printf 'Paperless 3.0.5 base image is not pinned by qualified digest.\n' >&2
    return 1
  }
  grep -Fq "PAPERLESS_AI_LLM_EMBEDDING_MODEL: usl-bge-m3:documents-20260824-rc1" <<<"$config" || {
    printf 'Paperless BGE-M3 release alias is not pinned.\n' >&2
    return 1
  }
  grep -Fq "USL_BGE_MANIFEST_SHA256: 7907646426070047a77226ac3e684fbbe8410524f7b4a74d02837e43f2146bab" <<<"$config" || {
    printf 'Paperless BGE-M3 bootstrap digest is not pinned.\n' >&2
    return 1
  }
  grep -Fq "PAPERLESS_AI_LLM_EMBEDDING_BACKEND: ollama" <<<"$config" || {
    printf 'Paperless embeddings are not local Ollama embeddings.\n' >&2
    return 1
  }
  grep -Fq "PAPERLESS_AI_LLM_EMBEDDING_CHUNK_SIZE: \"512\"" <<<"$config" || {
    printf 'Paperless embedding chunk size is not frozen at 512.\n' >&2
    return 1
  }
  grep -Fq "PAPERLESS_AI_LLM_EMBEDDING_BATCH_SIZE: \"32\"" <<<"$config" || {
    printf 'Paperless embedding batch size is not qualified at 32.\n' >&2
    return 1
  }
  grep -Fq "ollama/ollama:0.32.15@sha256:57d60e686821ea81a7748a3ec8141308c8b8f95b27105713954abf7a6529e700" <<<"$config" || {
    printf 'Ollama 0.32.15 is not pinned by qualified digest.\n' >&2
    return 1
  }
  grep -Fq "ghcr.io/pocket-id/pocket-id:v2.14.0@sha256:01540977dcf4c7b41b1159f34d68e4632f2658d62790e460ca65a42722b13c4a" <<<"$config" || {
    printf 'Pocket ID v2.14.0 is not pinned by digest.\n' >&2
    return 1
  }
  grep -Fq "PAPERLESS_APPS: allauth.socialaccount.providers.openid_connect,paperless_personal_ai" <<<"$config" || {
    printf 'Paperless OpenID Connect and personal AI apps are not enabled.\n' >&2
    return 1
  }
  grep -Fq "USL_PERSONAL_AI_MASTER_KEYS_PATH: /run/secrets/usl_personal_ai_master_keys" <<<"$config" || {
    printf 'Paperless personal AI master-key secret is not mounted.\n' >&2
    return 1
  }
  grep -Fq "PAPERLESS_SOCIAL_ACCOUNT_SYNC_GROUPS: \"false\"" <<<"$config" || {
    printf 'Paperless must not derive authorization from Pocket groups.\n' >&2
    return 1
  }
  trash_delay="$(
    awk '$1 == "PAPERLESS_EMPTY_TRASH_DELAY:" {
      gsub(/"/, "", $2)
      print $2
      exit
    }' <<<"$config"
  )"
  [[ "$trash_delay" =~ ^[0-9]+$ ]] && (( trash_delay >= 36500 )) || {
    printf 'Paperless automatic Trash emptying must use at least the 100-year safety delay.\n' >&2
    return 1
  }
  if [[ "$ENVIRONMENT" = "qa" && "$trash_delay" != "36500" ]]; then
    printf 'QA Paperless Trash safety delay must remain exactly 36500 days.\n' >&2
    return 1
  fi
  if [[ "$ENVIRONMENT" = "qa" ]]; then
    qa_odoo_port="$(sed -n 's/^ODOO_HTTP_PORT=//p' "$ENV_FILE" | tail -n 1)"
    qa_gevent_port="$(sed -n 's/^ODOO_GEVENT_PORT=//p' "$ENV_FILE" | tail -n 1)"
    qa_paperless_port="$(
      sed -n 's/^PAPERLESS_HTTP_PORT=//p' "$ENV_FILE" | tail -n 1
    )"
    if [[ "${USL_DOCUMENTS_QA_ISOLATED_OVERRIDE:-0}" = 1 ]]; then
      [[ "$qa_odoo_port" =~ ^[0-9]+$ \
        && "$qa_gevent_port" =~ ^[0-9]+$ \
        && "$qa_paperless_port" =~ ^[0-9]+$ \
        && "$qa_odoo_port" = "${ODOO_HTTP_PORT:-$qa_odoo_port}" \
        && "$qa_gevent_port" = "${ODOO_GEVENT_PORT:-$qa_gevent_port}" \
        && "$qa_paperless_port" = "${PAPERLESS_HTTP_PORT:-$qa_paperless_port}" ]] || {
        printf 'Overridden Documents QA ports must be explicit, numeric, and scope-matched.\n' >&2
        return 1
      }
    else
      [[ "$qa_odoo_port" = "18080" \
        && "$qa_gevent_port" = "18072" \
        && "$qa_paperless_port" = "18010" ]] || {
        printf '%s\n' \
          'Documents QA must use its isolated ports: Odoo 18080/18072 and Paperless 18010.' >&2
        return 1
      }
      grep -Fqx 'PAPERLESS_PUBLIC_BASE_URL=http://127.0.0.1:18010' \
        "$SSO_ENV_FILE" || {
        printf 'Documents QA Paperless SSO callback must use isolated port 18010.\n' >&2
        return 1
      }
    fi
  fi
  if [[ "$ENVIRONMENT" = "preprod" ]]; then
    if [[ "${USL_DOCUMENTS_LOCAL_PREPROD_RECOVERY:-0}" = "1" \
        && "${USL_DOCUMENTS_ALLOW_ODOO_DEV_RECOVERY:-0}" = "1" \
        && ( "$PROJECT" = usl-odoo-preprod-* \
          || "$PROJECT" = usl-odoo-paperless-* ) ]]; then
      grep -Fq "USL_DEPLOYMENT_ENV: qa" <<<"$config" || {
        printf 'Local pre-production recovery must keep QA live guards.\n' >&2
        return 1
      }
    elif ! grep -Fq "USL_DEPLOYMENT_ENV: preproduction" <<<"$config"; then
      printf 'Pre-production target must set USL_DEPLOYMENT_ENV=preproduction.\n' >&2
      return 1
    fi
  fi
}

provision_qa_sso() {
  [[ "$ENVIRONMENT" = "qa" ]] || return 0
  "${COMPOSE[@]}" up -d --wait --pull never pocket-id
  python3 "$ROOT/scripts/pocket_id_dev.py" \
    --env-file "$SSO_ENV_FILE" provision >/dev/null
}

runtime_status() {
  "${COMPOSE[@]}" ps
  local runtime_database runtime_filter
  runtime_database="$(
    "${COMPOSE[@]}" exec -T odoo \
      sed -n 's/^db_name[[:space:]]*=[[:space:]]*//p' /etc/odoo/odoo.conf \
      | tr -d '\r' | tail -n 1
  )"
  [[ "$runtime_database" = "$DATABASE" ]] || {
    printf 'Runtime database mismatch: %s\n' "${runtime_database:-<empty>}" >&2
    return 1
  }
  runtime_filter="$(
    "${COMPOSE[@]}" exec -T odoo \
      sed -n 's/^dbfilter[[:space:]]*=[[:space:]]*//p' /etc/odoo/odoo.conf \
      | tr -d '\r' | tail -n 1
  )"
  [[ "$runtime_filter" = "^${DATABASE}$" ]] || {
    printf 'Runtime database filter mismatch: %s\n' "${runtime_filter:-<empty>}" >&2
    return 1
  }
}

ensure_paperless_access() {
  "${COMPOSE[@]}" run --rm --no-deps paperless-access-init
}

ensure_personal_ai_release() {
  "${COMPOSE[@]}" exec -T paperless-webserver \
    python manage.py check_personal_ai_release
}

sync_odoo_runtime_config() {
  local paperless_public_url
  paperless_public_url="$(
    sed -n 's/^PAPERLESS_PUBLIC_URL=//p' "$ENV_FILE" | tail -n 1
  )"
  [[ -n "$paperless_public_url" ]] || {
    printf 'Paperless public URL is missing from the Documents environment.\n' >&2
    return 1
  }
  "${COMPOSE[@]}" exec -T \
    -e PAPERLESS_RUNTIME_PUBLIC_URL="$paperless_public_url" \
    odoo odoo shell \
    --config=/etc/odoo/odoo.conf \
    --database="$DATABASE" \
    < "$ROOT/scripts/odoo/documents_runtime_config.py"
}

case "$COMMAND" in
  config)
    validate_config
    "${COMPOSE[@]}" config "$@"
    ;;
  preflight)
    validate_config
    "${COMPOSE[@]}" run --rm --no-deps paperless-preflight
    ;;
  build)
    [[ "$ENVIRONMENT" = "qa" ]] || {
      printf 'Pre-production uses a qualified registry image and cannot build in place.\n' >&2
      exit 2
    }
    validate_config
    "${COMPOSE[@]}" build odoo paperless-webserver
    ;;
  up)
    validate_config
    provision_qa_sso
    "${COMPOSE[@]}" up -d --wait --pull never "${SERVICES[@]}"
    ensure_paperless_access
    ensure_personal_ai_release
    runtime_status
    sync_odoo_runtime_config
    ;;
  update)
    validate_config
    provision_qa_sso
    "${COMPOSE[@]}" up -d --wait --pull never db pocket-id
    "${COMPOSE[@]}" stop odoo >/dev/null 2>&1 || true
    "${COMPOSE[@]}" --profile init run --rm --no-deps \
      -e ODOO_INIT_DB="$DATABASE" init-db odoo \
      --config=/etc/odoo/odoo.conf \
      --database="$DATABASE" \
      --update="$UPDATE_MODULES" \
      --without-demo=true \
      --stop-after-init \
      --log-level=warn
    "${COMPOSE[@]}" up -d --wait --pull never \
      db paperless-preflight paperless-db paperless-broker \
      paperless-model-preflight paperless-gotenberg paperless-tika \
      paperless-webserver "${OLLAMA_SERVICES[@]}"
    ensure_paperless_access
    ensure_personal_ai_release
    "${COMPOSE[@]}" up -d --force-recreate --wait --pull never odoo
    runtime_status
    sync_odoo_runtime_config
    ;;
  bootstrap)
    [[ "$ENVIRONMENT" = "qa" ]] || {
      printf 'Synthetic bootstrap is available only for local QA.\n' >&2
      exit 2
    }
    validate_config
    provision_qa_sso
    "${COMPOSE[@]}" up -d --wait --pull never "${SERVICES[@]}"
    ensure_paperless_access
    ensure_personal_ai_release
    paperless_setup="$(
      "${COMPOSE[@]}" exec -T paperless-webserver python manage.py shell -c '
from django.contrib.auth import get_user_model
from django.contrib.auth.models import Permission
from rest_framework.authtoken.models import Token
import json

users = {
    "archive-admin": ("Archive Administrator", True),
    "odoo-integration": ("Odoo Integration", False),
    "documents-user": ("Documents General User", False),
    "documents-accountant": ("Documents Accountant", False),
    "documents-hr": ("Documents HR Reviewer", False),
    "documents-restricted": ("Documents Restricted User", False),
}
User = get_user_model()
for username, (name, administrator) in users.items():
    user, _created = User.objects.get_or_create(username=username)
    user.first_name = name
    user.is_active = True
    user.is_staff = administrator
    user.is_superuser = administrator
    user.set_password("admin")
    user.save()

# Direct Paperless use is deliberately read-only for ordinary QA identities.
# Global model permissions make the Paperless UI usable; Odoo-synchronized
# object permissions still decide which document roots each identity can see.
# UI settings remain personal. The global Saved View change permission
# also permits editing unowned shared views, so ordinary identities receive
# read-only Saved Views and keep personal filters in Odoo instead.
direct_view_models = {
    "correspondent",
    "customfield",
    "customfieldinstance",
    "document",
    "documenttype",
    "note",
    "savedview",
    "savedviewfilterrule",
    "storagepath",
    "tag",
    "uisettings",
}
direct_permission_codenames = {
    f"view_{model}" for model in direct_view_models
} | {
    f"{action}_{model}"
    for action in ("add", "change", "delete")
    for model in ("uisettings",)
}
direct_permissions = Permission.objects.filter(
    content_type__app_label="documents",
    codename__in=direct_permission_codenames,
)
for username in users:
    if username in {"archive-admin", "odoo-integration"}:
        continue
    User.objects.get(username=username).user_permissions.set(direct_permissions)

service = User.objects.get(username="odoo-integration")
# This is a server-side integration identity, not a human login. It needs the
# supported APIs for ingestion, reconciliation, object permissions, document
# lifecycle, metadata catalogs, Saved Views, and the fail-closed workflow. Do
# not grant unrelated Paperless administration capabilities.
mutable_models = {
    "correspondent",
    "customfield",
    "customfieldinstance",
    "document",
    "documenttype",
    "savedview",
    "savedviewfilterrule",
    "tag",
}
workflow_models = {"workflow", "workflowaction", "workflowtrigger"}
read_models = {"paperlesstask", "storagepath"}
service_codenames = {
    f"{action}_{model}"
    for model in mutable_models
    for action in ("add", "change", "delete", "view")
} | {
    f"{action}_{model}"
    for model in workflow_models
    for action in ("add", "change", "view")
} | {f"view_{model}" for model in read_models}
service_permissions = Permission.objects.filter(
    content_type__app_label="documents",
    codename__in=service_codenames,
)
service_permissions |= Permission.objects.filter(
    content_type__app_label="auth",
    codename="view_user",
)
if service_permissions.count() != len(service_codenames) + 1:
    raise RuntimeError("Paperless integration permissions are incompatible")
service.user_permissions.set(service_permissions)
service.set_unusable_password()
service.save(update_fields=["password"])
token, _created = Token.objects.get_or_create(user=service)
print(f"USL_TOKEN={token.key}")
print(f"USL_SERVICE_ID={service.id}")
print(
    "USL_IDENTITIES="
    + json.dumps(
        {
            username: User.objects.get(username=username).id
            for username in users
            if username != "odoo-integration"
        }
        | {
            "documents-sso-user": User.objects.get(
                username="documents-sso-user"
            ).id
            for _item in [True]
            if User.objects.filter(username="documents-sso-user").exists()
        },
        separators=(",", ":"),
    )
)
'
    )"
    paperless_token="$(sed -n 's/^USL_TOKEN=//p' <<<"$paperless_setup" | tail -n 1)"
    paperless_service_id="$(
      sed -n 's/^USL_SERVICE_ID=//p' <<<"$paperless_setup" | tail -n 1
    )"
    paperless_identities="$(
      sed -n 's/^USL_IDENTITIES=//p' <<<"$paperless_setup" | tail -n 1
    )"
    [[ -n "$paperless_token" && -n "$paperless_service_id" && -n "$paperless_identities" ]] || {
      printf 'Could not prepare Paperless QA identities.\n' >&2
      exit 1
    }
    "${COMPOSE[@]}" stop odoo >/dev/null 2>&1 || true
    bootstrap_status=0
    "${COMPOSE[@]}" --profile init run --rm -T \
      -e ODOO_INIT_DB="$DATABASE" \
      -e PAPERLESS_QA_TOKEN="$paperless_token" \
      -e PAPERLESS_QA_SERVICE_USER_ID="$paperless_service_id" \
      -e PAPERLESS_QA_IDENTITIES="$paperless_identities" \
      init-db odoo shell \
      --config=/etc/odoo/odoo.conf \
      --database="$DATABASE" \
      < "$ROOT/scripts/odoo/documents_qa_bootstrap.py" \
      || bootstrap_status=$?
    "${COMPOSE[@]}" up -d --force-recreate --wait --pull never odoo
    runtime_status
    ((bootstrap_status == 0)) || exit "$bootstrap_status"
    printf '\nDocuments QA users all use password admin:\n'
    printf '  Odoo: admin, documents-user, documents-accountant, documents-hr, documents-restricted\n'
    printf '  Paperless: archive-admin, documents-user, documents-accountant, documents-hr, documents-restricted\n'
    ;;
  status)
    validate_config
    runtime_status
    ;;
  logs)
    validate_config
    "${COMPOSE[@]}" logs "$@"
    ;;
  stop)
    validate_config
    "${COMPOSE[@]}" stop "${SERVICES[@]}"
    ;;
  test|test-accounting|test-pocket)
    validate_config
    provision_qa_sso
    if [[ "$COMMAND" = "test-accounting" ]]; then
      TEST_DATABASE="${1:-odoo_test_usl_documents_accounting}"
      TEST_INIT_MODULE="usl_documents_accounting"
      TEST_TAGS="usl_documents_accounting"
    elif [[ "$COMMAND" = "test-pocket" ]]; then
      TEST_DATABASE="${1:-odoo_test_usl_pocketid}"
      TEST_INIT_MODULE="usl_pocketid"
      TEST_TAGS="usl_pocketid,usl_pocketid_http"
    else
      TEST_DATABASE="${1:-odoo_test_usl_documents}"
      TEST_INIT_MODULE="usl_documents"
      TEST_TAGS="usl_documents"
    fi
    case "$TEST_DATABASE" in
      ""|"$DATABASE"|odoo_dev|*[!A-Za-z0-9_]*)
        printf 'Refusing unsafe Documents test database: %s\n' "$TEST_DATABASE" >&2
        exit 2
        ;;
    esac
    cleanup_test() {
      "${COMPOSE[@]}" exec -T \
        -e TEST_DATABASE="$TEST_DATABASE" db sh -c \
        'dropdb --if-exists --force -U "$POSTGRES_USER" "$TEST_DATABASE"' \
        >/dev/null
      "${COMPOSE[@]}" --profile test run --rm --no-deps \
        --entrypoint sh -e TEST_DATABASE="$TEST_DATABASE" test -c '
          directory="/var/lib/odoo/filestore/$TEST_DATABASE"
          if [ -d "$directory" ]; then
            find "$directory" -mindepth 1 -delete
            rmdir "$directory"
          fi
        ' >/dev/null
    }
    trap cleanup_test EXIT
    "${COMPOSE[@]}" up -d --wait --pull never db
    # OCA auth_oidc's test package imports `responses`. Keep that dependency
    # in the browser-capable test image rather than bloating the runtime image.
    "${COMPOSE[@]}" --profile test build test
    cleanup_test
    "${COMPOSE[@]}" --profile test run --rm \
      -e "ODOO_DB_FILTER=^${TEST_DATABASE}$" test odoo \
      --config=/etc/odoo/odoo.conf \
      --database="$TEST_DATABASE" \
      --init="$TEST_INIT_MODULE" \
      --without-demo=true \
      --test-enable \
      --test-tags="$TEST_TAGS" \
      --stop-after-init \
      --log-level=test
    trap - EXIT
    cleanup_test
    ;;
  test-js)
    validate_config
    TEST_DATABASE="${1:-odoo_test_usl_documents_js}"
    case "$TEST_DATABASE" in
      ""|"$DATABASE"|odoo_dev|*[!A-Za-z0-9_]*)
        printf 'Refusing unsafe Documents frontend test database: %s\n' \
          "$TEST_DATABASE" >&2
        exit 2
        ;;
    esac
    cleanup_js_test() {
      "${COMPOSE[@]}" exec -T \
        -e TEST_DATABASE="$TEST_DATABASE" db sh -c \
        'dropdb --if-exists --force -U "$POSTGRES_USER" "$TEST_DATABASE"' \
        >/dev/null
      "${COMPOSE[@]}" --profile init run --rm --no-deps \
        --entrypoint sh -e TEST_DATABASE="$TEST_DATABASE" init-db -c '
          directory="/var/lib/odoo/filestore/$TEST_DATABASE"
          if [ -d "$directory" ]; then
            find "$directory" -mindepth 1 -delete
            rmdir "$directory"
          fi
        ' >/dev/null
    }
    trap cleanup_js_test EXIT
    "${COMPOSE[@]}" up -d --wait --pull never db
    "${COMPOSE[@]}" --profile test build test
    cleanup_js_test
    "${COMPOSE[@]}" --profile test run --rm \
      -e "ODOO_DB_FILTER=^${TEST_DATABASE}$" test odoo \
      --config=/etc/odoo/odoo.conf \
      --database="$TEST_DATABASE" \
      --init=usl_documents,usl_locale \
      --without-demo=true \
      --test-enable \
      --test-tags="/usl_documents:WebSuite.test_unit_desktop,/usl_documents:MobileWebSuite.test_unit_mobile" \
      --stop-after-init \
      --log-level=test
    trap - EXIT
    cleanup_js_test
    ;;
  *)
    usage
    ;;
esac
