#!/usr/bin/env bash
set -euo pipefail
umask 077

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=lib/compose-scope.sh
source "$ROOT/scripts/lib/compose-scope.sh"
command_name="${1:-status}"
project="${COMPOSE_PROJECT_NAME:-}"

if [[ -z "$project" ]]; then
  printf 'Transition state requires an explicit COMPOSE_PROJECT_NAME.\n' >&2
  exit 2
fi

case "$command_name" in
  mark)
    confirm="${2:-}"
    usl_verify_compose_scope "$project" "$ROOT" "Transition-live protection"
    python3 "$ROOT/scripts/transition_live.py" --root "$ROOT" mark \
      --project "$project" --database "${ODOO_DEV_DB:-odoo_dev}" \
      --commit "$(git -C "$ROOT" rev-parse HEAD)" --confirm "$confirm"
    ;;
  freeze)
    confirm="${2:-}"
    usl_verify_compose_scope "$project" "$ROOT" "Transition freeze"
    python3 "$ROOT/scripts/transition_live.py" --root "$ROOT" freeze \
      --project "$project" --confirm "$confirm"
    ;;
  status)
    python3 "$ROOT/scripts/transition_live.py" --root "$ROOT" status \
      --project "$project"
    ;;
  *)
    printf 'Usage: COMPOSE_PROJECT_NAME=usl-odoo-transition-* scripts/transition-live [status|mark PROJECT|freeze PROJECT]\n' >&2
    exit 2
    ;;
esac
