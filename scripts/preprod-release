#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
source "$ROOT/scripts/lib/compose-scope.sh"

command_name="${1:-help}"
source_argument="${2:-${USL_ONLINE_DUMP_DIR:-}}"
identity_path="$ROOT/artifacts/release/identity.json"

usage() {
  cat <<'EOF'
Usage: scripts/preprod-release <build|clean-install|reconstruct|finish-reconstruction|finalize-reconstruction|start|recovery-rehearsal|gate|identity|all> SOURCE_DIR

Commands:
  build        Sync pinned OCA code and build the self-contained commit image
  clean-install
               Install the complete product in a disposable empty database
  reconstruct  Recreate odoo_dev from SOURCE_DIR and write database identity
  finish-reconstruction
               Resume at Documents and finalization after prior stages passed
  finalize-reconstruction
               Resume target finalization after Documents and accounting passed
  start        Start the qualified image without checkout bind mounts
  recovery-rehearsal
               Restore a coordinated Odoo/Paperless backup in an isolated project
  gate         Verify source, database, image, runtime mounts and service preflight
  identity     Print and refresh the exact non-secret release identity
  all          Build, reconstruct, start and run the release gate
EOF
}

prepare_environment() {
  if [[ -z "$source_argument" ]]; then
    printf 'A source package directory is required.\n' >&2
    return 2
  fi
  export USL_ONLINE_DUMP_DIR
  USL_ONLINE_DUMP_DIR="$(cd "$source_argument" && pwd -P)"
  if [[ ! -f "$USL_ONLINE_DUMP_DIR/dump.sql" \
      || ! -d "$USL_ONLINE_DUMP_DIR/filestore" ]]; then
    printf 'The source package is incomplete under %s.\n' \
      "$USL_ONLINE_DUMP_DIR" >&2
    return 2
  fi

  local root_digest checksum default_base
  root_digest="$(printf '%s' "$ROOT" | shasum -a 256 | cut -c 1-8)"
  checksum="$(printf '%s' "$ROOT" | cksum)"
  checksum="${checksum%% *}"
  default_base=$((20000 + checksum % 20000))

  export COMPOSE_PROJECT_NAME="${USL_PREPROD_COMPOSE_PROJECT:-usl-odoo-preprod-$root_digest}"
  export ODOO_HTTP_PORT="${ODOO_HTTP_PORT:-$default_base}"
  export ODOO_GEVENT_PORT="${ODOO_GEVENT_PORT:-$((default_base + 1))}"
  export POCKET_ID_HTTP_PORT="${POCKET_ID_HTTP_PORT:-$((default_base + 2))}"
  export PAPERLESS_HTTP_PORT="${PAPERLESS_HTTP_PORT:-$((default_base + 3))}"
  export POCKET_ID_ENV_FILE="${POCKET_ID_ENV_FILE:-$ROOT/.pocket-id-preprod.env}"
  export USL_POCKET_ID_DEV_STRONG_DATABASE_SECRETS=1
  export USL_POCKET_ID_DEV_COMPOSE_PROJECT="$COMPOSE_PROJECT_NAME"
  export USL_POCKET_ID_DEV_ODOO_DB=odoo_dev
  export USL_POCKET_ID_DEV_ODOO_PORT="$ODOO_HTTP_PORT"
  export USL_POCKET_ID_DEV_GEVENT_PORT="$ODOO_GEVENT_PORT"
  export USL_POCKET_ID_DEV_POCKET_PORT="$POCKET_ID_HTTP_PORT"
  export USL_POCKET_ID_DEV_PAPERLESS_PORT="$PAPERLESS_HTTP_PORT"
  export USL_POCKET_ID_DEV_PAPERLESS_URL="http://paperless.localhost:$PAPERLESS_HTTP_PORT"
  POCKET_ID_ENV_FILE="$POCKET_ID_ENV_FILE" scripts/pocket-id-dev bootstrap >/dev/null

  local requested_project="$COMPOSE_PROJECT_NAME"
  local requested_odoo_http_port="$ODOO_HTTP_PORT"
  local requested_odoo_gevent_port="$ODOO_GEVENT_PORT"
  local requested_pocket_id_http_port="$POCKET_ID_HTTP_PORT"
  local requested_paperless_http_port="$PAPERLESS_HTTP_PORT"
  local requested_paperless_public_url="${PAPERLESS_PUBLIC_URL:-http://paperless.localhost:$PAPERLESS_HTTP_PORT}"
  set -a
  # shellcheck disable=SC1090
  source "$POCKET_ID_ENV_FILE"
  set +a
  if [[ "$COMPOSE_PROJECT_NAME" != "$requested_project" ]]; then
    printf 'Pre-production environment belongs to project %s, not %s.\n' \
      "$COMPOSE_PROJECT_NAME" "$requested_project" >&2
    return 2
  fi
  # The generated identity file owns secrets and stable subjects. Ports belong
  # to this release invocation and must not be replaced by historical defaults
  # when that file is sourced.
  export ODOO_HTTP_PORT="$requested_odoo_http_port"
  export ODOO_GEVENT_PORT="$requested_odoo_gevent_port"
  export POCKET_ID_HTTP_PORT="$requested_pocket_id_http_port"
  export PAPERLESS_HTTP_PORT="$requested_paperless_http_port"
  export PAPERLESS_PUBLIC_URL="$requested_paperless_public_url"
  local secret_name
  for secret_name in POSTGRES_PASSWORD ODOO_DB_PASSWORD ODOO_ADMIN_PASSWORD; do
    if [[ -z "${!secret_name:-}" ]]; then
      printf '%s is missing from %s; regenerate the release environment.\n' \
        "$secret_name" "$POCKET_ID_ENV_FILE" >&2
      return 2
    fi
  done
  if [[ "$POSTGRES_PASSWORD" != "$ODOO_DB_PASSWORD" ]]; then
    printf 'PostgreSQL and Odoo database passwords do not match.\n' >&2
    return 2
  fi

  export ODOO_SAAS_COMPOSE_PROJECT="$COMPOSE_PROJECT_NAME"
  export ACCOUNTING_COMPAT_COMPOSE_PROJECT="$COMPOSE_PROJECT_NAME"
  export ODOO_DEV_DB=odoo_dev
  export ODOO_DB_NAME=odoo_dev
  export USL_DEPLOYMENT_ENV=qa
  export USL_EINVOICE_LIVE_ENABLED=0
  export USL_EREPORTING_LIVE_ENABLED=0
  export PAPERLESS_DISABLE_REGULAR_LOGIN=true
  export PAPERLESS_REDIRECT_LOGIN_TO_SSO=true
  export ODOO_IMAGE="${USL_PREPROD_IMAGE:-${COMPOSE_PROJECT_NAME}-odoo:$(git rev-parse --short=12 HEAD)}"
  usl_verify_compose_scope \
    "$COMPOSE_PROJECT_NAME" "$ROOT" "Pre-production release"
}

identity_command() {
  local args=(--source-dir "$USL_ONLINE_DUMP_DIR")
  if [[ "${USL_RELEASE_ALLOW_DIRTY:-0}" != "1" ]]; then
    args+=(--require-clean)
  fi
  if docker image inspect "$ODOO_IMAGE" >/dev/null 2>&1; then
    args+=(--image "$ODOO_IMAGE")
  fi
  args+=(--output "$identity_path")
  python3 "$ROOT/scripts/release_identity.py" "${args[@]}"
}

require_qualified_identity() {
  local args=(
    --source-dir "$USL_ONLINE_DUMP_DIR"
    --image "$ODOO_IMAGE"
  )
  if [[ "${USL_RELEASE_ALLOW_DIRTY:-0}" != "1" ]]; then
    args+=(--require-clean)
  fi
  args+=(--output "$identity_path")
  python3 "$ROOT/scripts/release_identity.py" "${args[@]}" >/dev/null
}

action_risk_source_gate() {
  python3 "$ROOT/scripts/action_risk_inventory.py" check-source
}

action_risk_runtime_gate() {
  local database="${1:-odoo_dev}"
  release_compose --profile init run --rm -T \
    -e ODOO_INIT_DB="$database" \
    -e ODOO_DB_FILTER="^${database}$" \
    -e ACTION_RISK_MODE=check \
    -e USL_EINVOICE_LIVE_ENABLED=0 \
    -e USL_EREPORTING_LIVE_ENABLED=0 \
    init-db odoo shell \
    --config=/etc/odoo/odoo.conf \
    --database="$database" \
    --shell-interface=python \
    < "$ROOT/scripts/odoo/action_risk_inventory.py"
}

product_asset_gate() {
  local database="${1:-odoo_dev}"
  release_compose --profile init run --rm -T \
    -e ODOO_INIT_DB="$database" \
    -e ODOO_DB_FILTER="^${database}$" \
    -e USL_EINVOICE_LIVE_ENABLED=0 \
    -e USL_EREPORTING_LIVE_ENABLED=0 \
    init-db odoo shell \
    --config=/etc/odoo/odoo.conf \
    --database="$database" \
    --shell-interface=python \
    < "$ROOT/scripts/odoo/compile_product_assets.py"
}

build_distribution() {
  make oca-addons-sync
  action_risk_source_gate
  local identity_args=(--source-dir "$USL_ONLINE_DUMP_DIR")
  if [[ "${USL_RELEASE_ALLOW_DIRTY:-0}" != "1" ]]; then
    identity_args+=(--require-clean)
  fi
  identity_args+=(--field oca.bundle_sha256)
  local oca_digest action_risk_digest release_commit
  oca_digest="$(
    python3 "$ROOT/scripts/release_identity.py" "${identity_args[@]}"
  )"
  identity_args=(--source-dir "$USL_ONLINE_DUMP_DIR")
  if [[ "${USL_RELEASE_ALLOW_DIRTY:-0}" != "1" ]]; then
    identity_args+=(--require-clean)
  fi
  identity_args+=(--field action_risk_policy_sha256)
  action_risk_digest="$(
    python3 "$ROOT/scripts/release_identity.py" "${identity_args[@]}"
  )"
  release_commit="$(git rev-parse HEAD)"
  docker build \
    --target distribution \
    --build-arg "USL_RELEASE_COMMIT=$release_commit" \
    --build-arg "USL_OCA_BUNDLE_SHA256=$oca_digest" \
    --build-arg "USL_ACTION_RISK_POLICY_SHA256=$action_risk_digest" \
    --tag "$ODOO_IMAGE" \
    "$ROOT"
  require_qualified_identity
  printf 'Qualified image: %s\n' "$ODOO_IMAGE"
}

release_compose() {
  docker compose \
    -p "$COMPOSE_PROJECT_NAME" \
    --env-file "$POCKET_ID_ENV_FILE" \
    -f "$ROOT/compose.yaml" \
    -f "$ROOT/compose.pocket-id.yaml" \
    -f "$ROOT/compose.preprod.yaml" \
    "$@"
}

release_helper() {
  # Reconstruction services keep their dedicated migration-only mounts, while
  # every delivered product service (Odoo and init-db) must execute from the
  # same qualified image that will be retained at runtime.
  COMPOSE_FILE="$ROOT/compose.yaml:$ROOT/compose.pocket-id.yaml:$ROOT/compose.preprod.yaml" \
    USL_POCKET_ID_COMPOSE_EXTRA_FILE="$ROOT/compose.preprod.yaml" \
    "$@"
}

database_identity() {
  local apply_mode="$1"
  local database="${2:-odoo_dev}"
  local identity_json
  identity_json="$(tr -d '\n' < "$identity_path")"
  release_compose --profile init run --rm -T \
    -e ODOO_INIT_DB="$database" \
    -e ODOO_DB_FILTER="^${database}$" \
    -e USL_RELEASE_IDENTITY_JSON="$identity_json" \
    -e USL_RELEASE_IDENTITY_APPLY="$apply_mode" \
    init-db odoo shell \
    --config=/etc/odoo/odoo.conf \
    --database="$database" \
    --shell-interface=python \
    < "$ROOT/scripts/odoo/release_identity.py"
}

documents_identity_boundary() {
  release_compose --profile init run --rm -T \
    -e ODOO_INIT_DB=odoo_dev \
    -e ODOO_DB_FILTER='^odoo_dev$' \
    init-db odoo shell \
    --config=/etc/odoo/odoo.conf \
    --database=odoo_dev \
    --shell-interface=python \
    < "$ROOT/scripts/odoo/documents_identity_boundary.py"
}

pocket_id_release_gate() {
  release_compose --profile init run --rm -T \
    -e ODOO_INIT_DB=odoo_dev \
    -e ODOO_DB_FILTER='^odoo_dev$' \
    init-db odoo shell \
    --config=/etc/odoo/odoo.conf \
    --database=odoo_dev \
    --shell-interface=python \
    < "$ROOT/scripts/odoo/pocket_id_release_gate.py"
}

clean_install_database=odoo_release_clean_install

cleanup_clean_install_database() {
  case "$clean_install_database" in
    ""|odoo_dev|odoo_online_source_saas_19_3|*[!A-Za-z0-9_]*)
      printf 'Refusing unsafe clean-install database: %s\n' \
        "${clean_install_database:-<unset>}" >&2
      return 2
      ;;
  esac
  release_compose up -d --wait db
  release_compose exec -T \
    -e TEST_DATABASE="$clean_install_database" \
    db sh -c \
    'dropdb --if-exists --force -U "$POSTGRES_USER" "$TEST_DATABASE"'
  release_compose --profile init run --rm --no-deps \
    --entrypoint sh \
    -e TEST_DATABASE="$clean_install_database" \
    init-db -c '
      directory="/var/lib/odoo/filestore/$TEST_DATABASE"
      if [ -d "$directory" ]; then
        find "$directory" -mindepth 1 -delete
        rmdir "$directory"
      fi
    '
}

clean_install_product() {
  action_risk_source_gate
  require_qualified_identity
  local product_modules
  product_modules="rebuild_account_migration,usl_access_control,usl_accounting,usl_b2c,usl_documents,usl_documents_accounting,usl_documents_b2c,usl_expense_batch,usl_home,usl_locale,usl_platform_billing,usl_platform_billing_pocketid,usl_pocketid,usl_project,usl_sign,usl_tese_accounting,usl_tese_payroll"
  cleanup_clean_install_database
  trap cleanup_clean_install_database EXIT INT TERM
  release_compose --profile init run --rm -T \
    -e ODOO_INIT_DB="$clean_install_database" \
    -e ODOO_DB_FILTER="^${clean_install_database}$" \
    init-db odoo \
    --config=/etc/odoo/odoo.conf \
    --database="$clean_install_database" \
    --init="$product_modules" \
    --without-demo=true \
    --stop-after-init
  # Odoo reaches an auto-install fixed point after installing the supported
  # product set. Remove the reviewed optional marketing/demo modules with the
  # same fail-closed helper used by canonical reconstruction and isolated QA.
  release_compose --profile init run --rm -T \
    -e ODOO_INIT_DB="$clean_install_database" \
    -e ODOO_DB_FILTER="^${clean_install_database}$" \
    init-db odoo shell \
    --config=/etc/odoo/odoo.conf \
    --database="$clean_install_database" \
    --shell-interface=python \
    < "$ROOT/scripts/odoo/enforce_product_module_scope.py"
  database_identity 1 "$clean_install_database" \
    > "$ROOT/artifacts/release/clean-install-database-identity.json"
  USL_PRODUCT_BOUNDARY_PREPROD=1 \
    ODOO_DEV_DB="$clean_install_database" \
    scripts/check-product-database-boundary \
    | tee "$ROOT/artifacts/release/clean-install-boundary.txt"
  action_risk_runtime_gate "$clean_install_database" \
    | tee "$ROOT/artifacts/release/clean-install-action-risk.txt"
  product_asset_gate "$clean_install_database" \
    | tee "$ROOT/artifacts/release/clean-install-assets.txt"
  trap - EXIT INT TERM
  cleanup_clean_install_database
  printf 'Pre-production clean installation: PASS\n'
}

reconstruct_target() {
  require_qualified_identity
  local source_dump source_sha256
  export ODOO_MAX_CRON_THREADS=0
  source_dump="${USL_ONLINE_DUMP_DIR:-$ROOT/usl-online-dump}/dump.sql"
  source_sha256="$(shasum -a 256 "$source_dump" | awk '{print $1}')"
  USL_MIGRATION_PURPOSE=production \
    USL_MIGRATION_CONFIRM_SOURCE_SHA="$source_sha256" \
    USL_RECONSTRUCT_REUSE_DOCUMENTS=0 \
    release_helper scripts/target-reconstruct
  database_identity 1 > "$ROOT/artifacts/release/database-identity.json"
}

finish_reconstruction() {
  require_qualified_identity
  export ODOO_MAX_CRON_THREADS=0
  release_compose stop odoo >/dev/null 2>&1 || true
  DOCUMENTS_CANONICAL_TARGET=1 \
    DOCUMENTS_CANONICAL_RESET=1 \
    DOCUMENTS_REQUIRE_CHECKPOINT=0 \
    DOCUMENTS_TARGET_DATABASE=odoo_dev \
    COMPOSE_PROJECT_NAME="$COMPOSE_PROJECT_NAME" \
    release_helper scripts/documents-restore all
  release_compose stop odoo >/dev/null 2>&1 || true
  release_helper scripts/accounting-restore finalize
  release_helper scripts/target-finalize
  database_identity 1 > "$ROOT/artifacts/release/database-identity.json"
  printf 'Canonical reconstruction finalization complete: odoo_dev\n'
}

finalize_reconstruction() {
  require_qualified_identity
  export ODOO_MAX_CRON_THREADS=0
  release_compose stop odoo >/dev/null 2>&1 || true
  release_helper scripts/accounting-restore schema-finalize
  release_helper scripts/target-finalize
  database_identity 1 > "$ROOT/artifacts/release/database-identity.json"
  printf 'Canonical target finalization complete: odoo_dev\n'
}

start_distribution() {
  require_qualified_identity
  scripts/pocket-id-dev provision >/dev/null
  release_compose stop odoo >/dev/null 2>&1 || true
  release_compose --profile paperless up -d --wait --pull never \
    paperless-webserver
  release_compose --profile paperless run --rm --no-deps paperless-access-init
  export ODOO_MAX_CRON_THREADS=1
  release_compose --profile sign --profile document-renderer up -d --wait --pull never \
    usl-document-renderer usl-sign-step-ca usl-sign-dss
  release_compose up -d --force-recreate --wait --pull never db pocket-id odoo
  printf 'Odoo: http://odoo.localhost:%s/web/login?db=odoo_dev\n' \
    "$ODOO_HTTP_PORT"
  printf 'Pocket ID: %s\n' "$POCKET_ID_APP_URL"
  printf 'Documents: %s\n' "$PAPERLESS_PUBLIC_URL"
}

recovery_rehearsal() {
  require_qualified_identity
  USL_DOCUMENTS_PREPROD_ENV="$POCKET_ID_ENV_FILE" \
    USL_DOCUMENTS_PREPROD_PROJECT="$COMPOSE_PROJECT_NAME" \
    USL_DOCUMENTS_PREPROD_DB=odoo_dev \
    USL_DOCUMENTS_ALLOW_ODOO_DEV_RECOVERY=1 \
    USL_DOCUMENTS_LOCAL_PREPROD_RECOVERY=1 \
    USL_DOCUMENTS_SYNTHETIC_RECOVERY=1 \
    USL_RECOVERY_ALLOW_SOURCE_INTEGRITY_FAILURE=1 \
    USL_RECOVERY_REQUIRE_RESTRICTED_FIXTURE=0 \
    USL_DEPLOYMENT_ENV=qa \
    PAPERLESS_EMPTY_TRASH_DELAY=36500 \
    PAPERLESS_DISABLE_REGULAR_LOGIN=true \
    PAPERLESS_REDIRECT_LOGIN_TO_SSO=true \
    PAPERLESS_SOCIAL_ACCOUNT_SYNC_GROUPS=false \
    ODOO_DB_NAME=odoo_dev \
    ODOO_DB_FILTER='^odoo_dev$' \
    ODOO_IMAGE="$ODOO_IMAGE" \
    USL_EXPECTED_RELEASE_COMMIT="$(git rev-parse HEAD)" \
    USL_EXPECTED_RELEASE_IMAGE="$ODOO_IMAGE" \
    scripts/documents-recovery-test preprod \
    | tee "$ROOT/artifacts/release/recovery-rehearsal.txt"
}

release_gate() {
  action_risk_source_gate
  require_qualified_identity
  scripts/check-product-migration-boundary
  USL_PRODUCT_BOUNDARY_PREPROD=1 scripts/check-product-database-boundary
  release_compose --profile paperless run --rm --no-deps paperless-preflight
  release_compose --profile sign --profile document-renderer up -d --wait --pull never \
    usl-document-renderer usl-sign-step-ca usl-sign-dss
  database_identity 0 > "$ROOT/artifacts/release/database-identity.json"
  action_risk_runtime_gate \
    | tee "$ROOT/artifacts/release/action-risk-runtime.txt"
  product_asset_gate \
    | tee "$ROOT/artifacts/release/product-assets.txt"
  release_compose exec -T odoo python /usr/local/bin/usl-sign-services-smoke \
    | tee "$ROOT/artifacts/release/sign-services.txt"

  local container_id mounts runtime_image
  container_id="$(release_compose ps -q odoo)"
  if [[ -z "$container_id" ]]; then
    printf 'The qualified Odoo runtime is not running.\n' >&2
    return 1
  fi
  mounts="$(docker inspect --format '{{range .Mounts}}{{println .Destination}}{{end}}' "$container_id")"
  if grep -Eq '^/mnt/(custom-addons|oca-addons|oca-src|user-docs)$' <<<"$mounts"; then
    printf 'The qualified runtime still has checkout source mounts.\n' >&2
    return 1
  fi
  runtime_image="$(docker inspect --format '{{.Image}}' "$container_id")"
  if [[ "$runtime_image" != "$(docker image inspect --format '{{.Id}}' "$ODOO_IMAGE")" ]]; then
    printf 'The running Odoo container does not use the qualified image.\n' >&2
    return 1
  fi
  release_compose images --format json \
    > "$ROOT/artifacts/release/compose-images.jsonl"
  release_compose ps
  documents_identity_boundary \
    | tee "$ROOT/artifacts/release/documents-identity-boundary.json"
  pocket_id_release_gate \
    | tee "$ROOT/artifacts/release/pocket-id-boundary.json"
  printf 'Pre-production release gate: PASS\n'
}

case "$command_name" in
  build)
    prepare_environment
    build_distribution
    ;;
  clean-install)
    prepare_environment
    clean_install_product
    ;;
  reconstruct)
    prepare_environment
    reconstruct_target
    ;;
  finish-reconstruction)
    prepare_environment
    finish_reconstruction
    ;;
  finalize-reconstruction)
    prepare_environment
    finalize_reconstruction
    ;;
  start)
    prepare_environment
    start_distribution
    ;;
  recovery-rehearsal)
    prepare_environment
    recovery_rehearsal
    ;;
  gate)
    prepare_environment
    release_gate
    ;;
  identity)
    prepare_environment
    identity_command
    ;;
  all)
    prepare_environment
    build_distribution
    clean_install_product
    reconstruct_target
    start_distribution
    release_gate
    ;;
  help|*)
    usage
    [[ "$command_name" == "help" ]] || exit 2
    ;;
esac
