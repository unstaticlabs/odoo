#!/usr/bin/env bash
set -euo pipefail
umask 077

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
command_name="${1:-}"
shift $(( $# > 0 ? 1 : 0 ))

case "$command_name" in
  seal|verify|accept)
    bundle="${1:?Usage: scripts/migration-cohort-promotion $command_name BUNDLE}"
    python3 "$ROOT/migration/cohort_promotion/cohort.py" "$command_name" "$bundle"
    ;;
  capture-sign)
    bundle="${1:?Usage: scripts/migration-cohort-promotion capture-sign BUNDLE STEP_CA DSS EVIDENCE RELEASE_IDENTITY}"
    step_ca="${2:?Missing Step CA state directory}"
    dss="${3:?Missing DSS state directory}"
    sign_evidence="${4:?Missing Sign evidence directory}"
    release_identity="${5:?Missing evolved release identity}"
    python3 "$ROOT/migration/cohort_promotion/cohort.py" capture-sign "$bundle" \
      --step-ca "$step_ca" --dss "$dss" --evidence "$sign_evidence" \
      --release-identity "$release_identity"
    ;;
  inspect-components)
    bundle="${1:?Usage: scripts/migration-cohort-promotion inspect-components BUNDLE}"
    python3 "$ROOT/migration/cohort_promotion/cohort.py" inspect-components "$bundle"
    ;;
  rehearse)
    bundle="${1:?Usage: scripts/migration-cohort-promotion rehearse BUNDLE PROJECT SIGN_ROOT COMPONENT_FINGERPRINT}"
    project="${2:?Missing fresh recovery project}"
    sign_root="${3:?Missing fresh Sign rehearsal root}"
    component_fingerprint="${4:?Missing accepted component fingerprint}"
    case "$project" in
      usl-odoo-recovery-?*) ;;
      *) printf 'Pre-seal rehearsal requires a dedicated recovery project.\n' >&2; exit 2 ;;
    esac
    actual="$(python3 "$ROOT/migration/cohort_promotion/cohort.py" inspect-components "$bundle" \
      | python3 -c 'import json,sys; print(json.load(sys.stdin)["component_fingerprint"])')"
    [[ "$actual" == "$component_fingerprint" ]] || {
      printf 'Accepted component fingerprint differs from confirmation.\n' >&2
      exit 2
    }
    "$ROOT/scripts/documents-release-bundle" restore "$bundle/documents" --project "$project"
    python3 "$ROOT/migration/cohort_promotion/cohort.py" restore-sign-components "$bundle" \
      --destination "$sign_root" --confirm "$component_fingerprint"
    ;;
  preflight)
    bundle="${1:?Usage: scripts/migration-cohort-promotion preflight BUNDLE STATE FINGERPRINT}"
    state="${2:?Missing private state path}"
    fingerprint="${3:?Missing accepted cohort fingerprint}"
    actual="$(python3 "$ROOT/migration/cohort_promotion/cohort.py" accept "$bundle" \
      | python3 -c 'import json,sys; print(json.load(sys.stdin)["cohort_fingerprint"])')"
    [[ "$actual" == "$fingerprint" ]] || {
      printf 'Accepted evolved cohort fingerprint differs from confirmation.\n' >&2
      exit 2
    }
    python3 "$ROOT/migration/cohort_promotion/cohort.py" transition \
      --state "$state" --fingerprint "$fingerprint" --action preflight
    ;;
  restore)
    bundle="${1:?Usage: scripts/migration-cohort-promotion restore BUNDLE STATE PROJECT SIGN_ROOT FINGERPRINT}"
    state="${2:?Missing private state path}"
    project="${3:?Missing fresh restore project}"
    sign_root="${4:?Missing fresh Sign restore root}"
    fingerprint="${5:?Missing accepted cohort fingerprint}"
    case "$project" in
      usl-odoo-production-?*|usl-odoo-recovery-?*) ;;
      *) printf 'Evolved cohort restore requires a dedicated production/recovery project.\n' >&2; exit 2 ;;
    esac
    actual="$(python3 "$ROOT/migration/cohort_promotion/cohort.py" accept "$bundle" \
      | python3 -c 'import json,sys; print(json.load(sys.stdin)["cohort_fingerprint"])')"
    [[ "$actual" == "$fingerprint" ]] || {
      printf 'Accepted evolved cohort fingerprint differs from confirmation.\n' >&2
      exit 2
    }
    python3 "$ROOT/migration/cohort_promotion/cohort.py" require-state \
      --state "$state" --fingerprint "$fingerprint" --expected preflight >/dev/null
    "$ROOT/scripts/documents-release-bundle" restore "$bundle/documents" --project "$project"
    python3 "$ROOT/migration/cohort_promotion/cohort.py" restore-sign "$bundle" \
      --destination "$sign_root" --confirm "$fingerprint"
    python3 "$ROOT/migration/cohort_promotion/cohort.py" transition \
      --state "$state" --fingerprint "$fingerprint" --action restore
    ;;
  record-configured|record-gated|record-admitted)
    action="${command_name#record-}"
    case "$action" in
      configured) action=configure ;;
      gated) action=gate ;;
      admitted) action=admit ;;
    esac
    state="${1:?Usage: scripts/migration-cohort-promotion $command_name STATE FINGERPRINT EVIDENCE}"
    fingerprint="${2:?Missing accepted cohort fingerprint}"
    evidence="${3:?Missing private passed evidence}"
    python3 "$ROOT/migration/cohort_promotion/cohort.py" transition \
      --state "$state" --fingerprint "$fingerprint" \
      --action "$action" --evidence "$evidence"
    ;;
  *)
    printf '%s\n' \
      'Usage:' \
      '  scripts/migration-cohort-promotion seal|verify|accept BUNDLE' \
      '  scripts/migration-cohort-promotion capture-sign BUNDLE STEP_CA DSS EVIDENCE RELEASE_IDENTITY' \
      '  scripts/migration-cohort-promotion inspect-components BUNDLE' \
      '  scripts/migration-cohort-promotion rehearse BUNDLE PROJECT SIGN_ROOT COMPONENT_FINGERPRINT' \
      '  scripts/migration-cohort-promotion preflight BUNDLE STATE FINGERPRINT' \
      '  scripts/migration-cohort-promotion restore BUNDLE STATE PROJECT SIGN_ROOT FINGERPRINT' \
      '  scripts/migration-cohort-promotion record-configured|record-gated|record-admitted STATE FINGERPRINT EVIDENCE' >&2
    exit 2
    ;;
esac
