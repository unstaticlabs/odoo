#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
COMPOSE_FILE="$ROOT/deploy/odoo-backup/compose.yaml"
COMPOSE_ARGS=(--file "$COMPOSE_FILE")
case "${ODOO_BACKUP_QUALIFICATION:-}" in
  "") ;;
  local) COMPOSE_ARGS+=(--file "$ROOT/deploy/odoo-backup/compose.qualification.yaml");;
  r2) COMPOSE_ARGS+=(--file "$ROOT/deploy/odoo-backup/compose.r2-qualification.yaml");;
  *) echo "ODOO_BACKUP_QUALIFICATION must be unset, local, or r2" >&2; exit 2;;
esac
export ODOO_BACKUP_STAGING_VOLUME="${ODOO_BACKUP_STAGING_VOLUME:-usl-odoo-production-backup-staging}"
export ODOO_BACKUP_STATE_VOLUME="${ODOO_BACKUP_STATE_VOLUME:-usl-odoo-production-backup-state}"
export ODOO_BACKUP_CACHE_VOLUME="${ODOO_BACKUP_CACHE_VOLUME:-usl-odoo-production-restic-cache}"
export COMPOSE_PROJECT_NAME="${COMPOSE_PROJECT_NAME:-usl-odoo-production-backup}"

usage() {
  cat <<'EOF'
Usage:
  scripts/odoo-backup create [--mode live|quiesced]
  scripts/odoo-backup list [--json]
  scripts/odoo-backup verify <64-character-snapshot-id>
  scripts/odoo-backup stage prepare <backup-id> [live|quiesced]
  scripts/odoo-backup stage push <backup-id>
  scripts/odoo-backup stage restore <snapshot-id> <clone-id>
  scripts/odoo-backup stage verify <snapshot-id> <clone-id>
  scripts/odoo-backup stage abandon <backup-id>

The stage interface is for Komodo. Normal operators use create/list/verify.
EOF
}

compose() {
  docker compose "${COMPOSE_ARGS[@]}" --profile backup --profile restore "$@"
}

ensure_shared_volume() {
  local volume="$1"
  if ! docker volume inspect "$volume" >/dev/null 2>&1; then
    docker volume create \
      --label com.unstaticlabs.owner=odoo-production-backup \
      --label com.unstaticlabs.lifecycle=preserve \
      "$volume" >/dev/null
  elif [[ "$(docker volume inspect "$volume" --format '{{index .Labels "com.unstaticlabs.owner"}}')" != "odoo-production-backup" ]]; then
    echo "backup volume ownership check failed: $volume" >&2
    exit 1
  fi
}

ensure_shared_volumes() {
  ensure_shared_volume "$ODOO_BACKUP_STAGING_VOLUME"
  ensure_shared_volume "$ODOO_BACKUP_STATE_VOLUME"
  ensure_shared_volume "$ODOO_BACKUP_CACHE_VOLUME"
}

run_tool() {
  local service="$1"
  shift
  compose run --rm --no-deps "$service" "$@"
}

snapshot_from_output() {
  awk '/^[0-9a-f]{64}$/ { value=$0 } END { if (!value) exit 1; print value }'
}

command_create() {
  local mode=live
  if [[ "${1:-}" == "--mode" ]]; then
    mode="${2:-}"
    shift 2
  fi
  [[ $# -eq 0 ]] || { usage >&2; exit 2; }
  [[ "$mode" == live || "$mode" == quiesced ]] || { echo "mode must be live or quiesced" >&2; exit 2; }
  ensure_shared_volumes
  local backup_id snapshot final_snapshot
  backup_id="$(date -u +%Y%m%dt%H%M%Sz)-$(git -C "$ROOT" rev-parse --short=8 HEAD)"
  run_tool preflight preflight
  run_tool prepare prepare --backup-id "$backup_id" --mode "$mode"
  snapshot="$(run_tool push push --backup-id "$backup_id" | snapshot_from_output)"
  final_snapshot="$("$ROOT/scripts/odoo-backup" verify "$snapshot" | snapshot_from_output)"
  printf 'Verified production backup\n  backup_id: %s\n  snapshot_id: %s\n' "$backup_id" "$final_snapshot"
}

command_verify() {
  local snapshot="${1:-}"
  [[ "$snapshot" =~ ^[0-9a-f]{64}$ ]] || { echo "snapshot must be the full 64-character Restic ID" >&2; exit 2; }
  ensure_shared_volumes
  local clone_id final_snapshot
  clone_id="verify-${snapshot:0:12}-$(date -u +%Y%m%dt%H%M%Sz)"
  "$ROOT/scripts/odoo-restore" clone "$snapshot" --clone-id "$clone_id" --destroy-after-success
  final_snapshot="$(run_tool push finalize --snapshot "$snapshot" | snapshot_from_output)"
  printf '%s\n' "$final_snapshot"
}

command_stage() {
  local stage="${1:-}"
  shift || true
  ensure_shared_volumes
  case "$stage" in
    prepare)
      [[ $# -ge 1 && $# -le 2 ]] || { usage >&2; exit 2; }
      run_tool preflight preflight
      run_tool prepare prepare --backup-id "$1" --mode "${2:-live}"
      ;;
    push)
      [[ $# -eq 1 ]] || { usage >&2; exit 2; }
      run_tool push push --backup-id "$1"
      ;;
    restore)
      [[ $# -eq 2 ]] || { usage >&2; exit 2; }
      "$ROOT/scripts/odoo-restore" stage-restore "$1" "$2"
      ;;
    verify)
      [[ $# -eq 2 ]] || { usage >&2; exit 2; }
      "$ROOT/scripts/odoo-restore" stage-verify "$1" "$2"
      run_tool push finalize --snapshot "$1"
      ;;
    abandon)
      [[ $# -eq 1 ]] || { usage >&2; exit 2; }
      run_tool finalize abandon --confirm "$1"
      ;;
    *) usage >&2; exit 2;;
  esac
}

case "${1:-}" in
  create) shift; command_create "$@";;
  list) shift; ensure_shared_volumes; run_tool push list "$@";;
  verify) shift; [[ $# -eq 1 ]] || { usage >&2; exit 2; }; command_verify "$1";;
  stage) shift; command_stage "$@";;
  -h|--help|help) usage;;
  *) usage >&2; exit 2;;
esac
