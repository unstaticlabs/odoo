#!/usr/bin/env bash
# Keep the integration branch from falling behind production.
#
# Production advances on its own in two ways: an urgent/** pull request merges
# straight into 19-usl, and every staging promotion adds a merge commit that
# exists only on 19-usl. Both leave 19-usl-staging behind. This opens the
# back-merge pull request that restores the shared ancestry.
set -euo pipefail

production=19-usl
staging=19-usl-staging

git fetch --quiet origin "$production" "$staging"

# Collect the head branches of back-merges that have already landed. A branch
# goes only once staging contains its tip, so this can never drop a merge that
# is not already recorded on the branch it was opened against. It has to happen
# here rather than through `gh pr merge --delete-branch`, which the merge queue
# refuses outright.
for stale in $(git ls-remote --heads origin 'chore/back-merge-production-*' | cut -f2); do
  name="${stale#refs/heads/}"
  git fetch --quiet origin "$name" || continue
  if git merge-base --is-ancestor FETCH_HEAD "origin/$staging"; then
    git push --quiet origin --delete "$name" && echo "collected landed back-merge branch $name" || true
  fi
done

if git merge-base --is-ancestor "origin/$production" "origin/$staging"; then
  echo "staging already contains production; no back-merge required"
  exit 0
fi

echo "staging is $(git rev-list --count "origin/$staging..origin/$production") commit(s) behind production:"
git log --oneline "origin/$staging..origin/$production"

if ! git merge-tree --write-tree "origin/$staging" "origin/$production" >/dev/null; then
  echo "::error::production does not merge cleanly into staging; resolve the back-merge by hand"
  exit 1
fi

# The pull request gets a head commit of its own; it is never opened directly
# from 19-usl.
#
# A pull request whose head IS a release branch inherits that branch's whole
# check history: GitHub's rollup takes the worst run of each check name on the
# head commit, and pushes to 19-usl run workflows that pull requests do not. On
# 2026-09-10 a push-event run that failed on production's tip made #227
# unmergeable for ever -- the pull request's own run was green, the rollup was
# red, and no rerun of anything the pull request owned could change it. Staging
# fell behind until somebody opened the same merge from a fresh commit by hand.
#
# Merging production into a branch of our own, off staging, gives the pull
# request a commit that only pull-request checks have ever touched, while the
# merge commit still carries production's tip as a second parent -- which is the
# whole point of the back-merge. The name pins both tips, so a rerun after a
# failed push rebuilds the identical branch and never has to force-update one.
branch="chore/back-merge-production-$(git rev-parse --short=12 "origin/$production")-$(git rev-parse --short=12 "origin/$staging")"

number="$(gh pr list --repo "$GITHUB_REPOSITORY" --base "$staging" --head "$branch" \
  --state open --json number --jq '.[0].number // empty')"

if [ -z "$number" ]; then
  if git ls-remote --exit-code --heads origin "$branch" >/dev/null 2>&1; then
    echo "reusing the back-merge branch $branch already on origin"
  else
    git checkout --quiet -B "$branch" "origin/$staging"
    git -c user.name="github-actions[bot]" \
        -c user.email="41898282+github-actions[bot]@users.noreply.github.com" \
        merge --no-ff --no-edit \
        -m "chore(release): back-merge production into staging" \
        "origin/$production"
    git push --quiet origin "HEAD:refs/heads/$branch"
    echo "pushed $branch"
  fi

  url="$(gh pr create --repo "$GITHUB_REPOSITORY" --base "$staging" --head "$branch" \
    --title "chore(release): back-merge production into staging" \
    --body "Production is ahead of the integration branch. Merging it back restores the
shared ancestry so \`19-usl-staging\` is never behind \`19-usl\`.

Opened automatically; it carries no change of its own. The merge commit adds
production's tip as a second parent, which is what stops the two lines from
diverging again.

The head is a branch of this run's own making rather than \`19-usl\` itself, so
the checks on it are only ever this pull request's. A pull request opened
directly from a release branch inherits that branch's push-event runs, and one
red run there blocks the back-merge permanently.")"
  echo "opened $url"
  number="${url##*/}"
else
  echo "back-merge pull request #$number is already open"
fi

# Keep --merge: a merge commit is what restores the ancestry, and squashing or
# rebasing would defeat the point of the back-merge. No --delete-branch: the
# merge queue refuses it outright, and the cleanup above collects the branch on
# the next run instead.
#
# Enabling auto-merge needs a token with write access to the repository, which
# this workflow -- alone among the workflows here -- is granted. When the
# mutation is refused anyway the pull request is still open and still correct,
# so say what needs doing and leave the run green: reporting a failure on the
# very pull request this just opened reads as "the back-merge is broken" and
# teaches people to ignore a red check that is usually worth reading.
if ! gh pr merge "$number" --repo "$GITHUB_REPOSITORY" --auto --merge; then
  echo "::warning::Opened #${number} but could not enable auto-merge, which needs a token with write access. Merge #${number} to keep 19-usl-staging from falling behind 19-usl."
fi
