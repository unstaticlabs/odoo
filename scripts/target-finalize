#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
source "$ROOT/scripts/lib/compose-scope.sh"

usl_require_explicit_compose_project "Target finalization"
usl_verify_compose_scope \
  "$COMPOSE_PROJECT_NAME" "$ROOT" "Target finalization"

target_database="${ODOO_DEV_DB:-odoo_dev}"
if [[ "$target_database" != "odoo_dev" ]]; then
  printf 'Target finalization is reserved for canonical odoo_dev.\n' >&2
  exit 2
fi
if [[ "${USL_EINVOICE_LIVE_ENABLED:-0}" != "0" \
    || "${USL_EREPORTING_LIVE_ENABLED:-0}" != "0" ]]; then
  printf 'Target finalization requires both regulatory live guards to be 0.\n' >&2
  exit 2
fi

# Update the complete delivered product allow-list. A broad ``-u all`` would
# also mutate unrelated native and OCA modules during target finalization.
product_modules=(
  rebuild_account_migration
  usl_accounting
  usl_documents
  usl_documents_accounting
  usl_expense_batch
  usl_locale
  usl_platform_billing
  usl_platform_billing_pocketid
  usl_pocketid
  usl_project
  usl_tese_accounting
  usl_tese_payroll
)
product_modules_csv="$(IFS=,; printf '%s' "${product_modules[*]}")"

scripts/check-product-migration-boundary
scripts/accounting-restore product-validate
scripts/project-restore product-validate
scripts/tese-restore product-validate
scripts/pocket-id-dev configure-odoo "$product_modules_csv"
scripts/odoo-dev disable-tours
scripts/check-product-migration-boundary
scripts/check-product-database-boundary

printf '\nCanonical target finalized: odoo_dev\n'
printf 'Product URL: %s/web/login?db=odoo_dev\n' \
  "${ODOO_PUBLIC_BASE_URL:-http://odoo.localhost:${ODOO_HTTP_PORT:-8069}}"
printf 'Local QA login link: make login-link USER=valentin\n'
