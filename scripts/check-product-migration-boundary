#!/usr/bin/env python3
# ruff: noqa: T201

import ast
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
PRODUCT_ADDONS = ROOT / "custom-addons"
MIGRATION_ADDONS = {
    "usl_accounting_restore": (
        ROOT / "migration" / "accounting_restore" / "addons"
    ),
    "usl_project_restore": ROOT / "migration" / "project_restore" / "addons",
    "usl_identity_restore": ROOT / "migration" / "identity_restore" / "addons",
    "usl_product_restore": ROOT / "migration" / "product_restore" / "addons",
    "usl_b2c_restore": ROOT / "migration" / "b2c_restore" / "addons",
    "usl_hr_restore": ROOT / "migration" / "hr_restore" / "addons",
    "usl_tese_restore": ROOT / "migration" / "tese_restore" / "addons",
    "usl_platform_billing_restore": (
        ROOT / "migration" / "platform_billing_restore" / "addons"
    ),
    "usl_collaboration_restore": (
        ROOT / "migration" / "collaboration_restore" / "addons"
    ),
}
MIGRATION_PATHS = (
    "/mnt/accounting-migration-addons",
    "/mnt/identity-migration-addons",
    "/mnt/product-migration-addons",
    "/mnt/b2c-migration-addons",
    "/mnt/hr-migration-addons",
    "/mnt/project-migration-addons",
    "/mnt/tese-migration-addons",
    "/mnt/platform-billing-migration-addons",
)
MIGRATION_SERVICES = (
    "accounting-migration",
    "project-migration",
    "b2c-migration",
    "tese-migration",
    "platform-billing-migration",
)
COLLABORATION_MIGRATION_PATH = "/mnt/collaboration-migration-addons"


def manifest(path):
    return ast.literal_eval(path.read_text())


def compose_service(compose, name, next_name):
    return compose.split(f"  {name}:", 1)[1].split(f"\n  {next_name}:", 1)[0]


errors = []

# Active runtime and reconstruction paths must move together when the Odoo SaaS
# generation changes. Historical alignment evidence and installed-version
# migration directories intentionally retain their original identifiers.
active_generation_roots = (
    ROOT / "custom-addons",
    ROOT / "migration",
    ROOT / "scripts",
    ROOT / "accounting_compat",
)
for active_root in active_generation_roots:
    for path in active_root.rglob("*"):
        if not path.is_file() or "__pycache__" in path.parts:
            continue
        relative = path.relative_to(ROOT)
        if relative == Path("scripts/check-product-migration-boundary"):
            continue
        if any(
            part.startswith("saas~19.2.")
            for part in relative.parts
        ):
            continue
        if path.suffix not in {
            "",
            ".py",
            ".sh",
            ".xml",
            ".csv",
            ".js",
            ".md",
            ".yaml",
            ".yml",
        }:
            continue
        text = path.read_text(errors="ignore")
        for stale in (
            "usl-odoo-saas-19-2",
            "odoo_online_source_saas_19_2",
            "odoo_saas_19_2_validation_exact",
            "odoo_saas_19_2_validation_native",
        ):
            if stale in text:
                errors.append(
                    f"Active file {relative} contains stale 19.2 identifier {stale!r}.",
                )
for migration_name, migration_path in MIGRATION_ADDONS.items():
    if not (migration_path / migration_name / "__manifest__.py").is_file():
        errors.append(f"The {migration_name} add-on is not migration-isolated.")

for addon_manifest in PRODUCT_ADDONS.glob("*/__manifest__.py"):
    addon_name = addon_manifest.parent.name
    dependencies = set(manifest(addon_manifest).get("depends", []))
    if addon_name in MIGRATION_ADDONS or "restore" in addon_name:
        errors.append(
            f"Migration-only add-on {addon_name} is on the product add-ons path.",
        )
    for migration_name in MIGRATION_ADDONS:
        if migration_name in dependencies:
            errors.append(
                f"Product add-on {addon_name} depends on {migration_name}.",
            )

compose = (ROOT / "compose.yaml").read_text()
default_addons_path = (
    "/opt/odoo/addons,/opt/odoo/odoo/addons,"
    "/mnt/custom-addons,/mnt/oca-addons"
)
if default_addons_path not in compose:
    errors.append("The expected production add-ons path guard is missing.")

normal_odoo_service = compose_service(compose, "odoo", "init-db")
service_text = {
    "accounting-migration": compose_service(
        compose, "accounting-migration", "project-migration",
    ),
    "project-migration": compose_service(
        compose, "project-migration", "b2c-migration",
    ),
    "b2c-migration": compose_service(
        compose, "b2c-migration", "tese-migration",
    ),
    "tese-migration": compose_service(
        compose, "tese-migration", "platform-billing-migration",
    ),
    "platform-billing-migration": compose_service(
        compose, "platform-billing-migration", "test",
    ),
}
for migration_path in MIGRATION_PATHS:
    if migration_path in normal_odoo_service:
        errors.append(
            f"The normal Odoo service exposes migration path {migration_path}.",
        )
if COLLABORATION_MIGRATION_PATH in normal_odoo_service:
    errors.append(
        f"The normal Odoo service exposes migration path {COLLABORATION_MIGRATION_PATH}.",
    )

expected_addons_path = default_addons_path + "," + ",".join(MIGRATION_PATHS)
for service_name in MIGRATION_SERVICES:
    current_service = service_text[service_name]
    if f"--addons-path={expected_addons_path}" not in current_service:
        errors.append(
            f"The {service_name} service does not expose the complete staged "
            "migration add-ons path.",
        )
    for migration_path in MIGRATION_PATHS:
        if f"{migration_path}:ro" not in current_service:
            errors.append(
                f"The {service_name} service does not mount {migration_path} read-only.",
            )
if COLLABORATION_MIGRATION_PATH not in service_text["project-migration"]:
    errors.append("The project-migration service does not expose Collaboration restoration.")

restore_harnesses = {
    "Accounting": ROOT / "scripts" / "accounting-restore",
    "Projects": ROOT / "scripts" / "project-restore",
    "Identity": ROOT / "scripts" / "identity-restore",
    "Product": ROOT / "scripts" / "product-restore",
    "B2C": ROOT / "scripts" / "b2c-restore",
    "HR": ROOT / "scripts" / "hr-restore",
    "TESE": ROOT / "scripts" / "tese-restore",
    "Platform Billing": ROOT / "scripts" / "platform-billing-restore",
    "Collaboration": ROOT / "scripts" / "collaboration-restore",
}
for perimeter, harness_path in restore_harnesses.items():
    harness = harness_path.read_text()
    if '--addons-path="$migration_addons_path"' not in harness:
        errors.append(
            f"The {perimeter} restoration harness does not explicitly pass "
            "its migration-only add-ons path.",
        )

platform_restore_harness = restore_harnesses["Platform Billing"].read_text()
if "PLATFORM_BILLING_REQUIRE_ISOLATED_PROJECT" not in platform_restore_harness:
    errors.append(
        "The platform restoration harness lacks the isolated-project switch.",
    )
if 'compose_project" != usl-odoo-fp-*' not in platform_restore_harness:
    errors.append("The platform restoration harness lacks its project guard.")

runtime_modules = {
    PRODUCT_ADDONS / "usl_b2c": (
        "usl.b2c.restore",
        "usl_b2c_restore",
        "rebuild_source_",
        "source_snapshot",
        "/mnt/b2c-migration-addons",
    ),
    PRODUCT_ADDONS / "usl_sign": (
        "usl.sign.restore",
        "usl_sign_restore",
        "sign-restore",
        "sign-migration",
        "rebuild_source_",
        "/mnt/sign-migration-addons",
    ),
    PRODUCT_ADDONS / "usl_project": (
        "usl.project.restore",
        "rebuild_source_",
        "source_snapshot",
        "Restoration Runs",
    ),
    PRODUCT_ADDONS / "usl_tese_payroll": (
        "usl.tese.restore",
        "rebuild_source_",
        "source_snapshot",
        "TESE Restoration",
    ),
    PRODUCT_ADDONS / "usl_platform_billing": (
        "usl.platform.billing.restore",
        "usl_platform_billing_restore",
        "rebuild_source_",
        "/mnt/platform-billing-migration-addons",
        "x_content_bank_candidate",
    ),
}
for runtime_module, forbidden_values in runtime_modules.items():
    for path in runtime_module.rglob("*"):
        if (
            not path.is_file()
            or "__pycache__" in path.parts
            or "tests" in path.parts
            or path.suffix not in {".py", ".xml", ".csv", ".js"}
        ):
            continue
        text = path.read_text(errors="ignore")
        for forbidden in forbidden_values:
            if forbidden in text:
                errors.append(
                    f"Product file {path.relative_to(ROOT)} contains "
                    f"migration-only reference {forbidden!r}.",
                )

runtime_accounting = PRODUCT_ADDONS / "rebuild_account_migration"
for path in runtime_accounting.rglob("*"):
    if (
        not path.is_file()
        or "__pycache__" in path.parts
        or "tests" in path.parts
        or path.suffix not in {".py", ".xml", ".csv", ".js"}
    ):
        continue
    text = path.read_text(errors="ignore")
    for forbidden in (
        "rebuild_source_",
        "rebuild.account.import.run",
        "rebuild.account.discrepancy",
        "rebuild.account.source.report",
        "rebuild.account.deferred.schedule.line",
        "rebuild.account.analytic.override",
        "action_open_latest_import_run",
        "menu_rebuild_account_migration",
    ):
        if forbidden in text:
            errors.append(
                f"Product file {path.relative_to(ROOT)} contains "
                f"migration-only reference {forbidden!r}.",
            )

runtime_platform = PRODUCT_ADDONS / "usl_platform_billing"
for path in runtime_platform.rglob("*"):
    if (
        not path.is_file()
        or "__pycache__" in path.parts
        or "tests" in path.parts
    ):
        continue
    text = path.read_text(errors="ignore")
    for forbidden in (
        "usl.platform.billing.restore",
        "usl_platform_billing_restore",
        "rebuild_source_",
        "/mnt/platform-billing-migration-addons",
        "x_content_bank_candidate",
    ):
        if forbidden in text:
            errors.append(
                f"Product file {path.relative_to(ROOT)} contains "
                f"{forbidden!r}.",
            )

if errors:
    raise SystemExit("\n".join(f"- {error}" for error in errors))

print("Product/migration source boundary: PASS")
