#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT"

profile="full"
dry_run=0
while (($#)); do
  case "$1" in
    --profile)
      [[ $# -ge 2 ]] || { printf '%s\n' 'qa-up: --profile requires a value' >&2; exit 2; }
      profile="$2"
      shift 2
      ;;
    --dry-run)
      dry_run=1
      shift
      ;;
    -h|--help)
      printf '%s\n' 'Usage: scripts/agent/qa-up [--profile full|no-documents|documents-smoke|clean-install] [--dry-run]'
      exit 0
      ;;
    *)
      printf 'qa-up: unknown argument: %s\n' "$1" >&2
      exit 2
      ;;
  esac
done

case "$profile" in
  full|no-documents|documents-smoke|clean-install) ;;
  *) printf 'qa-up: unsupported profile: %s\n' "$profile" >&2; exit 2 ;;
esac

branch="$(git branch --show-current)"
development_branch="$(python3 -c 'import json; print(json.load(open("agent/policy.json"))["development_branch"])')"
if [[ -z "$branch" || "$branch" == "$development_branch" ]]; then
  printf 'qa-up: use a dedicated feature branch; current branch is %s\n' "${branch:-<detached>}" >&2
  exit 2
fi

project="$(scripts/agent/qa-status --project)"
ownership="$(scripts/agent/qa-status --json | python3 -c 'import json, sys; print(json.load(sys.stdin)["ownership"]["state"])')"
case "$ownership" in
  foreign|mixed)
    printf 'qa-up: refusing %s Compose ownership for %s\n' "$ownership" "$project" >&2
    exit 2
    ;;
esac
if ((dry_run)); then
  printf 'QA dry run\n'
  printf '  Branch:  %s\n' "$branch"
  printf '  Profile: %s\n' "$profile"
  printf '  Project: %s\n' "$project"
  printf '  Ownership: %s\n' "$ownership"
  printf '  Command: PROFILE=%q scripts/qa-environment %q\n' "$profile" "$profile"
  exit 0
fi

COMPOSE_PROJECT_NAME= PROFILE="$profile" scripts/qa-environment "$profile"
