#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from lib import (  # noqa: E402
    AgentError,
    ROOT,
    branch_name,
    changed_addons,
    changed_paths,
    compose_project_status,
    dirty_entries,
    head_sha,
    merge_base,
    odoo_version,
    policy,
    qa_status_payload,
    resolve_ref,
)


def build_context(base: str) -> dict[str, object]:
    paths = changed_paths(base)
    qa = qa_status_payload()
    current_policy = policy()
    branch = branch_name()
    return {
        "schema": "usl-agent-context/v1",
        "repository": str(ROOT.resolve()),
        "git": {
            "branch": branch,
            "detached": branch == "<detached>",
            "head_sha": head_sha(),
            "base": base,
            "base_sha": resolve_ref(base),
            "merge_base_sha": merge_base(base),
            "dirty": bool(dirty_entries()),
            "dirty_entries": dirty_entries(),
            "changed_paths": paths,
        },
        "odoo": {
            "version": odoo_version(),
            "changed_addons": changed_addons(paths),
            "product_addons_path": "custom-addons",
            "migration_path": "migration",
        },
        "policy": {
            "development_branch": current_policy["development_branch"],
            "workflow_phase": current_policy["workflow_phase"],
            "enforcement": current_policy["enforcement"],
        },
        "database": {
            "development": "odoo_dev",
            "source": "odoo_online_source_saas_19_3",
            "source_access": "read-only and migration-transition-only",
        },
        "compose": {
            "canonical_development": compose_project_status("usl-odoo-saas-19-3"),
            "task_qa": {
                "project": qa["compose_project"],
                "health": qa["health"],
                "ownership": qa["ownership"]["state"],
                "owners": qa["ownership"]["owners"],
            },
            "shared_qa_seed": {
                "mode": "immutable qualified artifact",
                "reuse": "read-only",
                "status_command": "scripts/qa-seed status",
            },
        },
        "qa": qa,
        "commands": {
            "environment": "make doctor",
            "qa_up": "scripts/agent/qa-up --profile <profile>",
            "qa_status": "scripts/agent/qa-status",
            "qa_down": f"scripts/agent/qa-down --confirm {qa['compose_project']}",
            "odoo_test": "scripts/odoo-dev test <module>",
            "odoo_js_test": "scripts/odoo-dev test-js <module>",
            "migration_boundary": "make product-migration-boundary",
            "access_risk": "make action-risk-inventory",
        },
    }


def main() -> int:
    parser = argparse.ArgumentParser(description="Report deterministic USL agent context.")
    parser.add_argument("--json", action="store_true", help="Emit machine-readable JSON.")
    parser.add_argument("--base", help="Comparison ref (default: origin/<development branch>).")
    arguments = parser.parse_args()
    try:
        base = arguments.base or f"origin/{policy()['development_branch']}"
        value = build_context(base)
    except AgentError as error:
        print(f"agent context: {error}", file=sys.stderr)
        return 2
    if arguments.json:
        print(json.dumps(value, indent=2))
        return 0
    git_context = value["git"]
    qa = value["qa"]
    print("USL agent context")
    print(f"  Worktree: {value['repository']}")
    print(f"  Branch:   {git_context['branch']}")
    print(f"  HEAD:     {git_context['head_sha']}")
    print(f"  Base:     {git_context['base']} ({git_context['base_sha']})")
    print(f"  Dirty:    {'yes' if git_context['dirty'] else 'no'}")
    print(f"  Odoo:     {value['odoo']['version']}")
    modules = value["odoo"]["changed_addons"]
    print(f"  Add-ons:  {', '.join(modules) if modules else '<none changed>'}")
    print(f"  Phase:    {value['policy']['workflow_phase']}")
    print(f"  QA:       {qa['compose_project']} ({qa['health']}, {qa['ownership']['state']})")
    print(f"  QA URL:   {qa['urls']['local_odoo']}")
    print("  Remote:   unavailable in QA contract v1")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
