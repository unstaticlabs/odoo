#!/usr/bin/env python3
from __future__ import annotations

import argparse
import os
import re
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from lib import (  # noqa: E402
    AgentError,
    QA_SCHEMA_PATH,
    ROOT,
    branch_name,
    dirty_entries,
    git,
    head_sha,
    load_json,
    policy,
    validate_schema,
)


SKILLS = {
    "usl-commit-work",
    "usl-upstream-sync",
    "odoo-ui-product-quality",
    "odoo-migration-upgrade-safety",
    "odoo-accounting-integrity",
    "odoo-access-control-safety",
    "writing-clearly-and-concisely",
}


def check_skills(root: Path = ROOT) -> list[str]:
    errors: list[str] = []
    canonical = root / "agent-skills"
    for name in sorted(SKILLS):
        skill = canonical / name / "SKILL.md"
        if not skill.is_file():
            errors.append(f"missing canonical skill {skill.relative_to(root)}")
            continue
        text = skill.read_text(encoding="utf-8")
        if not text.startswith("---\n") or "\n---\n" not in text[4:]:
            errors.append(f"{skill.relative_to(root)} lacks YAML frontmatter")
            continue
        frontmatter = text.split("---\n", 2)[1]
        keys = {
            line.split(":", 1)[0].strip()
            for line in frontmatter.splitlines()
            if ":" in line and not line.lstrip().startswith("#")
        }
        if keys != {"name", "description"}:
            errors.append(f"{skill.relative_to(root)} frontmatter must contain only name and description")
        if f"name: {name}\n" not in frontmatter:
            errors.append(f"{skill.relative_to(root)} name does not match its directory")
        for exposure in (root / ".agents" / "skills" / name, root / ".claude" / "skills" / name):
            if not exposure.is_symlink():
                errors.append(f"{exposure.relative_to(root)} is not a symlink")
                continue
            if exposure.resolve() != (canonical / name).resolve():
                errors.append(f"{exposure.relative_to(root)} does not resolve to the canonical skill")
    return errors


def check_contracts() -> list[str]:
    errors: list[str] = []
    for path, schema_id in ((QA_SCHEMA_PATH, "https://unstaticlabs.com/schemas/agent/qa-environment-v1.schema.json"),):
        value = load_json(path)
        if value.get("$id") != schema_id:
            errors.append(f"{path.relative_to(ROOT)} has unexpected $id")
        if value.get("additionalProperties") is not False:
            errors.append(f"{path.relative_to(ROOT)} must reject unknown root properties")
    return errors


def check_policy() -> list[str]:
    value = policy()
    errors: list[str] = []
    if value.get("development_branch") != "19-usl":
        errors.append("agent/policy.json must identify 19-usl as the development branch")
    if value.get("workflow_phase") not in {"migration-transition", "continuous-development"}:
        errors.append("agent/policy.json has an unsupported workflow phase")
    enforcement = value.get("enforcement", {})
    if set(enforcement) != {"branch_worktree", "commit_attribution"}:
        errors.append("agent/policy.json has an unexpected enforcement surface")
    if any(mode not in {"advisory", "required"} for mode in enforcement.values()):
        errors.append("agent/policy.json enforcement values must be advisory or required")
    if value.get("workflow_phase") == "continuous-development" and set(enforcement.values()) != {"required"}:
        errors.append("continuous-development requires every local agent-process control")
    github = value.get("github", {})
    if github.get("repository") != "unstaticlabs/odoo" or github.get("credential_transport") != "isolated-https":
        errors.append("agent/policy.json must retain the governed repository and isolated HTTPS transport")
    merge_queue = github.get("merge_queue", {})
    expected_queue = {
        "ruleset": "USL Distribution",
        "required_status_checks": [],
        "check_response_timeout_minutes": 120,
        "grouping_strategy": "ALLGREEN",
        "max_entries_to_build": 2,
        "max_entries_to_merge": 1,
        "merge_method": "MERGE",
        "min_entries_to_merge": 1,
        "min_entries_to_merge_wait_minutes": 0,
    }
    if merge_queue != expected_queue:
        errors.append("agent/policy.json must retain the reviewed 19-usl merge-queue configuration")
    if value.get("production", {}).get("deployment_owner") != "ci":
        errors.append("agent/policy.json must assign production deployment to CI")
    if value.get("qa", {}).get("compose_project_prefix") != "usl-odoo-qa-":
        errors.append("agent/policy.json has an unsafe QA project prefix")
    return errors


def check_script(path: Path) -> str | None:
    text = path.read_text(encoding="utf-8")
    if text.startswith("#!/usr/bin/env python3"):
        try:
            compile(text, str(path), "exec")
        except SyntaxError as error:
            return f"{path.relative_to(ROOT)} has invalid Python syntax: {error}"
    elif text.startswith("#!/usr/bin/env bash"):
        process = subprocess.run(
            ["bash", "-n", str(path)], cwd=ROOT, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True
        )
        if process.returncode:
            return f"{path.relative_to(ROOT)} has invalid Bash syntax: {process.stderr.strip()}"
    else:
        return f"{path.relative_to(ROOT)} has an unsupported interpreter"
    return None


def show(errors: list[str]) -> int:
    if errors:
        for error in errors:
            print(f"- {error}", file=sys.stderr)
        return 1
    return 0


def repository(_arguments: argparse.Namespace) -> int:
    errors = check_contracts() + check_policy() + check_skills()
    for script in (
        "commit",
        "context",
        "verify",
        "qa-up",
        "qa-status",
        "qa-down",
        "github",
    ):
        path = ROOT / "scripts" / "agent" / script
        if not path.is_file() or not os.access(path, os.X_OK):
            errors.append(f"scripts/agent/{script} is missing or not executable")
        elif syntax_error := check_script(path):
            errors.append(syntax_error)
    if show(errors):
        return 1
    print("Repository agent infrastructure is structurally valid.")
    return 0


def branch_start(_arguments: argparse.Namespace) -> int:
    value = policy()
    branch = branch_name()
    errors: list[str] = []
    if branch == "<detached>":
        errors.append("work requires an attached branch")
    if branch == value["development_branch"]:
        errors.append(f"ordinary work is forbidden on {branch}")
    if branch != "<detached>" and not any(branch.startswith(prefix) for prefix in value["branch_prefixes"]):
        errors.append(f"branch {branch!r} does not use an allowed prefix")
    if dirty_entries():
        errors.append("branch-start requires a clean worktree")
    if show(errors):
        return 1
    print(f"Topic branch is ready: {branch} at {head_sha()}")
    return 0


def commits(arguments: argparse.Namespace) -> int:
    base = arguments.base or f"origin/{policy()['development_branch']}"
    output = git("log", "--format=%H%x00%s%x00%B%x00", f"{base}..HEAD")
    chunks = output.split("\x00")
    errors: list[str] = []
    count = 0
    for index in range(0, len(chunks) - 2, 3):
        commit, subject, body = chunks[index : index + 3]
        commit = commit.strip()
        if not commit:
            continue
        count += 1
        if not re.match(r"^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([^)]+\))?!?: .+", subject):
            errors.append(f"{commit[:12]} subject is not Conventional Commits 1.0.0: {subject}")
        if "AI-generated commit" not in body:
            errors.append(f"{commit[:12]} lacks 'AI-generated commit' in its body")
        if not re.search(r"^Co-authored-by: .+ <[^<>\s]+@[^<>\s]+>$", body, re.MULTILINE | re.IGNORECASE):
            errors.append(f"{commit[:12]} lacks a driving-human Co-authored-by trailer")
    if count == 0:
        errors.append(f"no commits found in {base}..HEAD")
    if not errors:
        print(f"Validated {count} agent-authored commit(s) from {base}.")
        return 0
    mode = policy()["enforcement"]["commit_attribution"]
    show(errors)
    if arguments.strict or mode == "required":
        return 1
    print(f"Advisory only during {policy()['workflow_phase']}; commit findings do not block CI.")
    return 0


def skills(_arguments: argparse.Namespace) -> int:
    errors = check_skills()
    if show(errors):
        return 1
    print(f"Validated {len(SKILLS)} canonical skills and both provider exposures.")
    return 0


def pr_event(arguments: argparse.Namespace) -> int:
    event = load_json(Path(arguments.event))
    branch = event.get("pull_request", {}).get("head", {}).get("ref")
    errors: list[str] = []
    if not isinstance(branch, str) or not branch:
        errors.append("pull request event has no head branch")
    elif not any(branch.startswith(prefix) for prefix in policy()["branch_prefixes"]):
        errors.append(f"PR branch {branch!r} does not use an allowed prefix")
    if not errors:
        print(f"PR branch policy valid: {branch}")
        return 0
    show(errors)
    mode = policy()["enforcement"]["branch_worktree"]
    if arguments.strict or mode == "required":
        return 1
    print(f"Advisory only during {policy()['workflow_phase']}; branch findings do not block CI.")
    return 0


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(description="Verify USL agent-development invariants.")
    commands = result.add_subparsers(dest="command", required=True)
    for name, handler in (("repository", repository), ("branch-start", branch_start), ("skills", skills)):
        command = commands.add_parser(name)
        command.set_defaults(handler=handler)
    commit_command = commands.add_parser("commits")
    commit_command.add_argument("--base")
    commit_command.add_argument("--strict", action="store_true")
    commit_command.set_defaults(handler=commits)
    event = commands.add_parser("pr-event")
    event.add_argument("event")
    event.add_argument("--strict", action="store_true")
    event.set_defaults(handler=pr_event)
    return result


def main() -> int:
    try:
        arguments = parser().parse_args()
        return arguments.handler(arguments)
    except AgentError as error:
        print(f"agent verify: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
