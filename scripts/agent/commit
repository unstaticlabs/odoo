#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path


ROOT = Path(__file__).resolve().parents[2]
STATE_ROOT = Path(os.environ.get("USL_AGENT_STATE_DIR", ROOT / ".agent"))
IDENTITY_PATH = STATE_ROOT / "identity.json"
COMMIT_TYPES = {
    "build",
    "chore",
    "ci",
    "docs",
    "feat",
    "fix",
    "perf",
    "refactor",
    "revert",
    "style",
    "test",
}


class CommitError(RuntimeError):
    pass


def run(*arguments: str, check: bool = True) -> subprocess.CompletedProcess[str]:
    process = subprocess.run(
        arguments,
        cwd=ROOT,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )
    if check and process.returncode:
        raise CommitError(process.stderr.strip() or process.stdout.strip())
    return process


def identity() -> dict[str, object]:
    try:
        value = json.loads(IDENTITY_PATH.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise CommitError(
            "Missing or invalid worktree identity; run scripts/agent/github configure first."
        ) from error
    if value.get("schema") != "usl-agent-github-identity/v1":
        raise CommitError("Unsupported worktree identity schema.")
    return value


def clean_text(value: str, label: str) -> str:
    value = value.strip()
    if not value:
        raise CommitError(f"{label} cannot be empty.")
    if "\\n" in value or "\r" in value or "\n" in value:
        raise CommitError(
            f"{label} must be one real CLI argument without escaped or embedded newlines."
        )
    return value


def build_message(arguments: argparse.Namespace, configured: dict[str, object]) -> str:
    commit_type = arguments.type
    if commit_type not in COMMIT_TYPES:
        raise CommitError(f"Unsupported Conventional Commit type: {commit_type}")
    scope = clean_text(arguments.scope, "Scope")
    if not re.fullmatch(r"[a-z0-9][a-z0-9._/-]*", scope):
        raise CommitError("Scope must use lowercase Conventional Commit characters.")
    summary = clean_text(arguments.summary, "Summary")
    if summary.endswith("."):
        raise CommitError("Summary must not end with a period.")
    body = [clean_text(paragraph, "Body paragraph") for paragraph in arguments.body]
    validations = [
        clean_text(validation, "Validation result")
        for validation in arguments.validation
    ]
    forbidden = ("AI-generated commit", "Co-authored-by:")
    if any(token in value for value in [*body, *validations] for token in forbidden):
        raise CommitError("Attribution markers are generated automatically; do not pass them.")

    agent = configured.get("agent")
    driving_human = configured.get("driving_human")
    if not isinstance(agent, dict) or not isinstance(driving_human, dict):
        raise CommitError("Worktree identity is incomplete.")
    author_name = str(agent.get("name") or "")
    author_email = str(agent.get("email") or "")
    human_name = str(driving_human.get("name") or "")
    human_email = str(driving_human.get("email") or "")
    if run("git", "config", "--worktree", "--get", "user.name").stdout.strip() != author_name:
        raise CommitError("Worktree Git author name does not match the configured agent identity.")
    if run("git", "config", "--worktree", "--get", "user.email").stdout.strip() != author_email:
        raise CommitError("Worktree Git author email does not match the configured agent identity.")
    if not human_name or not re.fullmatch(r"[^<>\s]+@[^<>\s]+", human_email):
        raise CommitError("Driving-human identity is invalid.")

    sections = [f"{commit_type}({scope}): {summary}", *body]
    if validations:
        sections.append("Validation:\n" + "\n".join(f"- {item}" for item in validations))
    sections.extend(
        [
            "AI-generated commit",
            f"Co-authored-by: {human_name} <{human_email}>",
        ]
    )
    return "\n\n".join(sections) + "\n"


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Create one policy-compliant commit from the staged index."
    )
    parser.add_argument("--type", required=True, choices=sorted(COMMIT_TYPES))
    parser.add_argument("--scope", required=True)
    parser.add_argument("--summary", required=True)
    parser.add_argument("--body", action="append", required=True)
    parser.add_argument("--validation", action="append", default=[])
    parser.add_argument("--dry-run", action="store_true")
    arguments = parser.parse_args()

    try:
        configured = identity()
        message = build_message(arguments, configured)
        if not run("git", "diff", "--cached", "--quiet", check=False).returncode:
            raise CommitError("The staged index is empty; stage the intended files first.")
        run("git", "diff", "--cached", "--check")
        if arguments.dry_run:
            print(message, end="")
            return 0
        STATE_ROOT.mkdir(mode=0o700, parents=True, exist_ok=True)
        with tempfile.NamedTemporaryFile(
            mode="w",
            encoding="utf-8",
            dir=STATE_ROOT,
            prefix="commit-message-",
            delete=False,
        ) as temporary:
            temporary.write(message)
            message_path = Path(temporary.name)
        message_path.chmod(0o600)
        try:
            process = run("git", "commit", "--file", str(message_path))
        finally:
            message_path.unlink(missing_ok=True)
        committed = run("git", "show", "-s", "--format=%B", "HEAD").stdout
        if committed.rstrip() != message.rstrip():
            raise CommitError("Committed message differs from the generated contract.")
        print(process.stdout, end="")
        return 0
    except CommitError as error:
        print(f"Commit blocked: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
