#!/usr/bin/env python3
from __future__ import annotations

import argparse
import copy
import json
import os
import re
import stat
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Any

sys.path.insert(0, str(Path(__file__).resolve().parent))
from lib import (  # noqa: E402
    AgentError,
    ROOT,
    branch_name,
    dirty_entries,
    git,
    head_sha,
    load_json,
    policy,
    run,
    write_json,
)


STATE_ROOT = Path(os.environ.get("USL_AGENT_STATE_DIR", ROOT / ".agent"))
IDENTITY_PATH = STATE_ROOT / "identity.json"
GH_CONFIG_DIR = STATE_ROOT / "gh"


def gh_environment() -> dict[str, str]:
    environment = os.environ.copy()
    environment["GH_CONFIG_DIR"] = str(GH_CONFIG_DIR)
    return environment


def gh(*arguments: str, check: bool = True) -> str:
    return run("gh", *arguments, check=check, env=gh_environment())


def repository_slug() -> str:
    remote = git("remote", "get-url", "origin")
    match = re.search(r"github\.com(?::|/)([^/]+/[^/]+?)(?:\.git)?$", remote)
    if not match:
        raise AgentError(f"origin is not a recognizable GitHub repository: {remote}")
    return match.group(1)


def identity() -> dict[str, Any]:
    value = load_json(IDENTITY_PATH)
    if value.get("schema") != "usl-agent-github-identity/v1":
        raise AgentError(f"Unsupported identity schema in {IDENTITY_PATH}")
    return value


def inherited_git_value(key: str) -> str:
    value = git("config", "--get", key, check=False)
    if not value:
        raise AgentError(f"Git {key} is not configured; supply it explicitly")
    return value


def configure(arguments: argparse.Namespace) -> int:
    if not re.fullmatch(r"[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?", arguments.login):
        raise AgentError("Invalid GitHub login")
    expected_login = policy()["github"]["agent_login"]
    if not expected_login:
        raise AgentError(
            "agent/policy.json has no approved github.agent_login; add the dedicated account in a reviewed change first"
        )
    if arguments.login.casefold() != expected_login.casefold():
        raise AgentError(f"Requested @{arguments.login}; policy requires dedicated agent @{expected_login}")
    coauthor_name = arguments.coauthor_name or inherited_git_value("user.name")
    coauthor_email = arguments.coauthor_email or inherited_git_value("user.email")
    if coauthor_email.casefold() == arguments.author_email.casefold():
        raise AgentError("Agent author and driving-human co-author must be distinct")
    payload = {
        "schema": "usl-agent-github-identity/v1",
        "repository": policy()["github"]["repository"],
        "agent": {
            "login": arguments.login,
            "name": arguments.author_name,
            "email": arguments.author_email,
        },
        "driving_human": {"name": coauthor_name, "email": coauthor_email},
    }
    STATE_ROOT.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(STATE_ROOT, 0o700)
    GH_CONFIG_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
    write_json(IDENTITY_PATH, payload, mode=0o600)
    git("config", "extensions.worktreeConfig", "true")
    git("config", "--worktree", "user.name", arguments.author_name)
    git("config", "--worktree", "user.email", arguments.author_email)
    git("config", "--worktree", "usl.agentGithubLogin", arguments.login)
    print(f"Configured isolated agent identity for @{arguments.login}.")
    print(f"Driving-human trailer: Co-authored-by: {coauthor_name} <{coauthor_email}>")
    print(f"Credentials will be stored only under {GH_CONFIG_DIR}.")
    return 0


def login(_arguments: argparse.Namespace) -> int:
    configured = identity()
    GH_CONFIG_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(GH_CONFIG_DIR, 0o700)
    process = subprocess.run(
        ["gh", "auth", "login", "--hostname", "github.com", "--git-protocol", "https", "--web"],
        cwd=ROOT,
        env=gh_environment(),
        check=False,
    )
    if process.returncode:
        raise AgentError("Isolated GitHub login did not complete")
    actual = gh("api", "user", "--jq", ".login")
    expected = configured["agent"]["login"]
    if actual.casefold() != expected.casefold():
        raise AgentError(f"Authenticated as @{actual}; expected dedicated agent @{expected}")
    print(f"Authenticated isolated GitHub profile as @{actual}.")
    return 0


def status(_arguments: argparse.Namespace) -> int:
    configured = identity()
    mode = stat.S_IMODE(IDENTITY_PATH.stat().st_mode)
    if mode & 0o077:
        raise AgentError(f"Identity metadata must not be group/world-readable: {IDENTITY_PATH}")
    approved = policy()["github"]["agent_login"]
    if not approved:
        raise AgentError("agent/policy.json has no approved dedicated github.agent_login")
    expected = configured["agent"]["login"]
    if expected.casefold() != approved.casefold():
        raise AgentError(f"Identity metadata names @{expected}; policy requires @{approved}")
    if configured["repository"] != policy()["github"]["repository"]:
        raise AgentError("Identity metadata repository does not match agent policy")
    actual = gh("api", "user", "--jq", ".login")
    if actual.casefold() != expected.casefold():
        raise AgentError(f"Authenticated as @{actual}; expected dedicated agent @{expected}")
    author_email = git("config", "--worktree", "--get", "user.email", check=False)
    author_name = git("config", "--worktree", "--get", "user.name", check=False)
    if author_email != configured["agent"]["email"] or author_name != configured["agent"]["name"]:
        raise AgentError("Worktree Git author does not match isolated agent identity")
    permission = gh("repo", "view", configured["repository"], "--json", "viewerPermission", "--jq", ".viewerPermission")
    if permission not in {"WRITE", "MAINTAIN", "ADMIN"}:
        raise AgentError(f"@{actual} lacks repository write access (viewerPermission={permission or 'unknown'})")
    if configured["driving_human"]["email"].casefold() == author_email.casefold():
        raise AgentError("Agent author and driving-human co-author are not distinct")
    print(f"GitHub identity OK: @{actual}, {permission}, isolated config {GH_CONFIG_DIR}")
    return 0


def ensure_topic_branch() -> str:
    branch = branch_name()
    development = policy()["development_branch"]
    if branch == "<detached>" or branch == development:
        raise AgentError(f"Refusing GitHub topic-branch operation from {branch!r}")
    if not any(branch.startswith(prefix) for prefix in policy()["branch_prefixes"]):
        raise AgentError(f"Branch {branch!r} does not use an allowed prefix")
    return branch


def pull_request_base(raw: str | None) -> str:
    raw = raw or policy()["development_branch"]
    base = raw.removeprefix("origin/")
    check = subprocess.run(
        ["git", "check-ref-format", "--branch", base],
        cwd=ROOT,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    if check.returncode:
        raise AgentError(f"Pull-request base is not a safe branch: {raw!r}")
    return base


def push(_arguments: argparse.Namespace) -> int:
    status(_arguments)
    branch = ensure_topic_branch()
    configured = identity()
    https_remote = f"https://github.com/{configured['repository']}.git"
    environment = gh_environment()
    run(
        "git",
        "-c",
        "credential.helper=",
        "-c",
        "credential.https://github.com.helper=!gh auth git-credential",
        "push",
        https_remote,
        f"HEAD:refs/heads/{branch}",
        cwd=ROOT,
        env=environment,
    )
    git("update-ref", f"refs/remotes/origin/{branch}", head_sha())
    git("branch", "--set-upstream-to", f"origin/{branch}", branch)
    print(f"Pushed {head_sha()} to {configured['repository']}:{branch} via isolated HTTPS credentials.")
    return 0


def pr(arguments: argparse.Namespace) -> int:
    status(arguments)
    branch = ensure_topic_branch()
    base = pull_request_base(arguments.base)
    body_path = Path(arguments.body_file)
    if not body_path.is_absolute():
        body_path = ROOT / body_path
    if not body_path.is_file():
        raise AgentError(f"Pull-request body file does not exist: {body_path}")
    existing = gh(
        "pr", "list", "--repo", repository_slug(), "--head", branch,
        "--state", "open", "--json", "number,url", "--jq", ".[0] // empty",
    )
    if existing:
        item = json.loads(existing)
        gh(
            "pr", "edit", str(item["number"]), "--repo", repository_slug(),
            "--base", base, "--title", arguments.title, "--body-file", str(body_path),
        )
        url = item["url"]
        action = "Updated"
    else:
        command = [
            "pr", "create", "--repo", repository_slug(), "--base", base,
            "--head", branch, "--title", arguments.title, "--body-file", str(body_path),
        ]
        if arguments.draft:
            command.append("--draft")
        url = gh(*command)
        action = "Opened"
    print(f"{action} PR: {url}")
    return 0


def merge_queue_policy() -> dict[str, Any]:
    value = policy().get("github", {}).get("merge_queue")
    if not isinstance(value, dict):
        raise AgentError("agent/policy.json has no reviewed github.merge_queue configuration")
    return value


def ruleset_update_payload(ruleset: dict[str, Any]) -> dict[str, Any]:
    payload = {
        key: copy.deepcopy(ruleset[key])
        for key in ("name", "target", "enforcement", "conditions", "rules")
        if key in ruleset
    }
    bypass_actors = ruleset.get("bypass_actors")
    if isinstance(bypass_actors, list):
        payload["bypass_actors"] = copy.deepcopy(bypass_actors)
    return payload


def configure_merge_queue_ruleset(ruleset: dict[str, Any], configuration: dict[str, Any]) -> dict[str, Any]:
    if ruleset.get("target") != "branch" or ruleset.get("enforcement") != "active":
        raise AgentError("The configured merge-queue ruleset must be an active branch ruleset")
    conditions = ruleset.get("conditions", {}).get("ref_name", {})
    includes = conditions.get("include", [])
    development_ref = f"refs/heads/{policy()['development_branch']}"
    if "~DEFAULT_BRANCH" not in includes and development_ref not in includes:
        raise AgentError(f"Ruleset {ruleset.get('name')!r} does not target {development_ref}")

    result = ruleset_update_payload(ruleset)
    rules = result.get("rules")
    if not isinstance(rules, list):
        raise AgentError("Ruleset has no mutable rules list")
    by_type = {rule.get("type"): rule for rule in rules if isinstance(rule, dict)}
    if "required_linear_history" in by_type:
        raise AgentError("Refusing merge-queue configuration while required_linear_history forbids merge commits")
    pull_request = by_type.get("pull_request")
    if not isinstance(pull_request, dict) or not isinstance(pull_request.get("parameters"), dict):
        raise AgentError("Ruleset must retain its existing pull_request protection")
    pull_request["parameters"]["allowed_merge_methods"] = ["merge"]

    configured_checks = configuration.get("required_status_checks", [])
    if configured_checks:
        required_checks = by_type.get("required_status_checks")
        if not isinstance(required_checks, dict):
            required_checks = {"type": "required_status_checks", "parameters": {}}
            rules.append(required_checks)
        required_checks["parameters"] = {
            "required_status_checks": [
                {"context": context} for context in configured_checks
            ],
            "strict_required_status_checks_policy": False,
        }
    else:
        rules[:] = [rule for rule in rules if rule.get("type") != "required_status_checks"]

    queue_parameters = {
        key: configuration[key]
        for key in (
            "check_response_timeout_minutes",
            "grouping_strategy",
            "max_entries_to_build",
            "max_entries_to_merge",
            "merge_method",
            "min_entries_to_merge",
            "min_entries_to_merge_wait_minutes",
        )
    }
    merge_queue = by_type.get("merge_queue")
    if not isinstance(merge_queue, dict):
        merge_queue = {"type": "merge_queue", "parameters": queue_parameters}
        rules.append(merge_queue)
    else:
        merge_queue["parameters"] = queue_parameters
    return result


def verify_merge_queue_prerequisite(repository: str, after_sha: str) -> None:
    if not re.fullmatch(r"[0-9a-f]{40}", after_sha):
        raise AgentError("--after-sha must be the 40-character lowercase head SHA of the prerequisite PR")
    development = policy()["development_branch"]
    if branch_name() != development or dirty_entries():
        raise AgentError(f"Merge-queue activation requires the clean authoritative {development} checkout")
    remote_head = gh("api", f"repos/{repository}/git/ref/heads/{development}", "--jq", ".object.sha")
    if head_sha() != remote_head:
        raise AgentError(f"Local {development} is not at the current GitHub tip {remote_head}; fetch and update first")
    comparison = gh("api", f"repos/{repository}/compare/{after_sha}...{development}", "--jq", ".status")
    if comparison not in {"ahead", "identical"}:
        raise AgentError(f"Prerequisite {after_sha} is not an ancestor of GitHub {development}")
    workflow = ROOT / ".github" / "workflows" / "product-image.yml"
    text = workflow.read_text(encoding="utf-8")
    if (
        "push:\n    branches:\n      - 19-usl" not in text
        or "pull_request:" in text
        or "merge_group:" in text
        or "workflow_dispatch:" in text
    ):
        raise AgentError("Post-merge OCI workflow policy is missing from product-image.yml")


def merge_queue(arguments: argparse.Namespace) -> int:
    status(arguments)
    configured = identity()
    repository = configured["repository"]
    verify_merge_queue_prerequisite(repository, arguments.after_sha)
    configuration = merge_queue_policy()
    summaries = json.loads(gh("api", f"repos/{repository}/rulesets"))
    matches = [item for item in summaries if item.get("name") == configuration["ruleset"]]
    if len(matches) != 1:
        raise AgentError(
            f"Expected exactly one ruleset named {configuration['ruleset']!r}; found {len(matches)}"
        )
    ruleset_id = matches[0]["id"]
    current = json.loads(gh("api", f"repos/{repository}/rulesets/{ruleset_id}"))
    repository_settings = json.loads(gh("api", f"repos/{repository}"))
    if not repository_settings.get("allow_merge_commit"):
        raise AgentError("Repository merge commits are disabled; refusing an ancestry-breaking queue configuration")
    desired = configure_merge_queue_ruleset(current, configuration)
    if ruleset_update_payload(current) == desired:
        print(f"Merge queue already matches policy in ruleset {configuration['ruleset']!r} ({ruleset_id}).")
        return 0
    if not arguments.apply:
        print(json.dumps(desired, indent=2, sort_keys=True))
        print("Dry run only. Re-run with --apply after reviewing this preserved-rules payload.")
        return 0
    STATE_ROOT.mkdir(parents=True, exist_ok=True, mode=0o700)
    with tempfile.NamedTemporaryFile(mode="w", suffix=".json", dir=STATE_ROOT, delete=False) as temporary:
        payload_path = Path(temporary.name)
        json.dump(desired, temporary, indent=2, sort_keys=True)
        temporary.write("\n")
    try:
        gh("api", f"repos/{repository}/rulesets/{ruleset_id}", "--method", "PUT", "--input", str(payload_path))
    finally:
        payload_path.unlink(missing_ok=True)
    print(f"Configured merge queue in ruleset {configuration['ruleset']!r} ({ruleset_id}).")
    return 0


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(description="Use a worktree-isolated GitHub agent identity.")
    commands = result.add_subparsers(dest="command", required=True)
    configure_command = commands.add_parser("configure")
    configure_command.add_argument("--login", required=True)
    configure_command.add_argument("--author-name", required=True)
    configure_command.add_argument("--author-email", required=True)
    configure_command.add_argument("--coauthor-name")
    configure_command.add_argument("--coauthor-email")
    configure_command.set_defaults(handler=configure)
    login_command = commands.add_parser("login")
    login_command.set_defaults(handler=login)
    status_command = commands.add_parser("status")
    status_command.set_defaults(handler=status)
    push_command = commands.add_parser("push")
    push_command.set_defaults(handler=push)
    pr_command = commands.add_parser("pr")
    pr_command.add_argument("--base")
    pr_command.add_argument("--title", required=True)
    pr_command.add_argument("--body-file", required=True)
    pr_command.add_argument("--draft", action="store_true")
    pr_command.set_defaults(handler=pr)
    queue_command = commands.add_parser("merge-queue")
    queue_command.add_argument("--after-sha", required=True)
    queue_command.add_argument("--apply", action="store_true")
    queue_command.set_defaults(handler=merge_queue)
    return result


def main() -> int:
    try:
        arguments = parser().parse_args()
        return arguments.handler(arguments)
    except (AgentError, subprocess.CalledProcessError) as error:
        print(f"agent github: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
