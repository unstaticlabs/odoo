#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
source "$ROOT/scripts/lib/compose-scope.sh"

usl_require_explicit_compose_project "Product database boundary"
usl_verify_compose_scope \
  "$COMPOSE_PROJECT_NAME" "$ROOT" "Product database boundary"

target_database="${ODOO_DEV_DB:-odoo_dev}"
case "$target_database" in
  ""|odoo_online_source_saas_19_3|*[!A-Za-z0-9_]*)
    printf 'Refusing unsafe product boundary database: %s\n' \
      "${target_database:-<unset>}" >&2
    exit 2
    ;;
esac

compose=(docker compose -p "$COMPOSE_PROJECT_NAME")
if [[ "${USL_PRODUCT_BOUNDARY_PREPROD:-0}" == "1" ]]; then
  compose=(
    docker compose -p "$COMPOSE_PROJECT_NAME"
    -f "$ROOT/compose.yaml"
    -f "$ROOT/compose.pocket-id.yaml"
    -f "$ROOT/compose.preprod.yaml"
  )
fi

if [[ -n "$("${compose[@]}" ps --status running -q odoo)" ]]; then
  "${compose[@]}" exec -T \
    -e USL_EINVOICE_LIVE_ENABLED=0 \
    -e USL_EREPORTING_LIVE_ENABLED=0 \
    -e USL_PRODUCT_BOUNDARY_PREPROD="${USL_PRODUCT_BOUNDARY_PREPROD:-0}" \
    odoo odoo shell \
    --config=/etc/odoo/odoo.conf \
    --database="$target_database" \
    --shell-interface=python \
    < "$ROOT/scripts/odoo/product_database_boundary.py"
else
  "${compose[@]}" --profile init run --rm -T --no-deps \
    -e ODOO_INIT_DB="$target_database" \
    -e USL_EINVOICE_LIVE_ENABLED=0 \
    -e USL_EREPORTING_LIVE_ENABLED=0 \
    -e USL_PRODUCT_BOUNDARY_PREPROD="${USL_PRODUCT_BOUNDARY_PREPROD:-0}" \
    init-db odoo shell \
    --config=/etc/odoo/odoo.conf \
    --database="$target_database" \
    --shell-interface=python \
    < "$ROOT/scripts/odoo/product_database_boundary.py"
fi
