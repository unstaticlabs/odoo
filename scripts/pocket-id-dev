#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENV_FILE="${POCKET_ID_ENV_FILE:-$ROOT/.pocket-id.env}"
PYTHON_HELPER="$ROOT/scripts/pocket_id_dev.py"
COMPOSE_FILES=(-f "$ROOT/compose.yaml" -f "$ROOT/compose.pocket-id.yaml")

bootstrap() {
  python3 "$PYTHON_HELPER" --env-file "$ENV_FILE" bootstrap
}

load_environment() {
  bootstrap >/dev/null
  set -a
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a
  if [[ "${USL_EINVOICE_LIVE_ENABLED:-0}" != "0" \
      || "${USL_EREPORTING_LIVE_ENABLED:-0}" != "0" ]]; then
    printf 'Refusing Pocket ID preproduction while a live regulatory guard is enabled.\n' >&2
    return 2
  fi
  if [[ "${POCKET_ID_QA_CLONE:-0}" != "1" \
      || ! "${ODOO_INIT_DB:-}" =~ ^odoo_dev_[A-Za-z0-9_]+_qa$ \
      || "${POCKET_ID_SOURCE_DB:-}" != "odoo_dev" ]]; then
    printf \
      'Refusing local Pocket ID QA outside a disposable odoo_dev_*_qa clone.\n' \
      >&2
    return 2
  fi
  export ODOO_IMAGE="${ODOO_IMAGE:-${COMPOSE_PROJECT_NAME}-odoo:latest}"
  COMPOSE=(
    docker compose
    -p "$COMPOSE_PROJECT_NAME"
    --env-file "$ENV_FILE"
    "${COMPOSE_FILES[@]}"
  )
  BASE_COMPOSE=(
    docker compose
    -p "$COMPOSE_PROJECT_NAME"
    -f "$ROOT/compose.yaml"
  )
}

prepare_qa_clone() {
  local target_exists
  load_environment
  "${BASE_COMPOSE[@]}" up -d --wait db || return $?
  "${BASE_COMPOSE[@]}" stop odoo >/dev/null 2>&1 || true
  target_exists="$(
    "${BASE_COMPOSE[@]}" exec -T \
      -e PGPASSWORD="${POSTGRES_PASSWORD:-odoo}" \
      -e SOURCE_DATABASE="$POCKET_ID_SOURCE_DB" \
      -e TARGET_DATABASE="$ODOO_INIT_DB" \
      db sh -eu -c '
        source_exists="$(psql -U "$POSTGRES_USER" -d postgres -Atc \
          "SELECT 1 FROM pg_database WHERE datname = '\''$SOURCE_DATABASE'\''")"
        target_exists="$(psql -U "$POSTGRES_USER" -d postgres -Atc \
          "SELECT 1 FROM pg_database WHERE datname = '\''$TARGET_DATABASE'\''")"
        test "$source_exists" = 1
        printf "%s" "$target_exists"
      '
  )" || return $?
  if [[ "$target_exists" == "1" ]]; then
    printf 'Reusing disposable Pocket ID QA clone: %s\n' "$ODOO_INIT_DB"
    return
  fi
  "${BASE_COMPOSE[@]}" exec -T \
    -e PGPASSWORD="${POSTGRES_PASSWORD:-odoo}" \
    -e SOURCE_DATABASE="$POCKET_ID_SOURCE_DB" \
    -e TARGET_DATABASE="$ODOO_INIT_DB" \
    db sh -eu -c \
    'createdb -U "$POSTGRES_USER" --template="$SOURCE_DATABASE" "$TARGET_DATABASE"' \
    || return $?
  if ! "${BASE_COMPOSE[@]}" --profile init run --rm \
    --entrypoint sh \
    -e SOURCE_DATABASE="$POCKET_ID_SOURCE_DB" \
    -e TARGET_DATABASE="$ODOO_INIT_DB" \
    init-db -eu -c '
      source="/var/lib/odoo/filestore/$SOURCE_DATABASE"
      target="/var/lib/odoo/filestore/$TARGET_DATABASE"
      test ! -e "$target"
      mkdir -p "$target"
      if [ -d "$source" ]; then
        cp -a "$source"/. "$target"/
      fi
    '; then
    "${BASE_COMPOSE[@]}" exec -T \
      -e PGPASSWORD="${POSTGRES_PASSWORD:-odoo}" \
      -e TARGET_DATABASE="$ODOO_INIT_DB" \
      db sh -eu -c \
      'dropdb --if-exists --force -U "$POSTGRES_USER" "$TARGET_DATABASE"' \
      || true
    return 1
  fi
  printf 'Created disposable Pocket ID QA clone: %s\n' "$ODOO_INIT_DB"
}

restore_canonical_odoo() {
  ODOO_INIT_DB="$POCKET_ID_SOURCE_DB" \
    ODOO_DB_FILTER="^${POCKET_ID_SOURCE_DB}$" \
    "${BASE_COMPOSE[@]}" up -d --force-recreate --wait odoo
}

start_idp() {
  load_environment
  "${COMPOSE[@]}" up -d --wait pocket-id
}

provision() {
  start_idp
  python3 "$PYTHON_HELPER" --env-file "$ENV_FILE" provision
}

ensure_unlinked() {
  start_idp
  python3 "$PYTHON_HELPER" --env-file "$ENV_FILE" ensure-unlinked
}

run_policy() {
  local apply_mode="$1" policy
  policy="$(python3 "$PYTHON_HELPER" --env-file "$ENV_FILE" odoo-policy)"
  "${COMPOSE[@]}" --profile init run --rm -T \
    -e ODOO_INIT_DB="$ODOO_INIT_DB" \
    -e USL_POCKET_ID_USERS_JSON="$policy" \
    -e USL_POCKET_ID_BREAK_GLASS_PASSWORD="$USL_POCKET_ID_BREAK_GLASS_PASSWORD" \
    -e USL_POCKET_ID_APPLY="$apply_mode" \
    init-db odoo shell \
    --config=/etc/odoo/odoo.conf \
    --database="$ODOO_INIT_DB" < "$ROOT/scripts/odoo/pocket_id_configure.py"
}

configure_odoo() {
  local status=0
  if prepare_qa_clone; then
    if provision; then
      :
    else
      status=$?
    fi
  else
    status=$?
  fi
  if ((status)); then
    restore_canonical_odoo
    return "$status"
  fi
  "${COMPOSE[@]}" stop odoo >/dev/null 2>&1 || true
  if "${COMPOSE[@]}" --profile init run --rm \
    -e ODOO_INIT_DB="$ODOO_INIT_DB" \
    init-db odoo \
    --config=/etc/odoo/odoo.conf \
    --database="$ODOO_INIT_DB" \
    --update=rebuild_account_migration \
    --without-demo=true \
    --stop-after-init \
    --log-level=warn; then
    if run_policy 0; then
      if run_policy 1; then
        :
      else
        status=$?
      fi
    else
      status=$?
    fi
  else
    status=$?
  fi
  if ((status)); then
    restore_canonical_odoo
    return "$status"
  fi
  "${COMPOSE[@]}" up -d --force-recreate --wait odoo
  printf '\nPocket ID: %s\n' "$POCKET_ID_APP_URL"
  printf 'Odoo: %s/web/login?db=%s\n' "$ODOO_PUBLIC_BASE_URL" "$ODOO_INIT_DB"
}

one_time_link() {
  local username="${1:?Usage: scripts/pocket-id-dev one-time-link USER}"
  start_idp
  python3 "$PYTHON_HELPER" --env-file "$ENV_FILE" one-time-link "$username"
}

set_disabled() {
  local username="${1:?Usage: scripts/pocket-id-dev set-disabled USER true|false}"
  local state="${2:?Usage: scripts/pocket-id-dev set-disabled USER true|false}"
  start_idp
  python3 "$PYTHON_HELPER" --env-file "$ENV_FILE" set-disabled "$username" "$state"
}

set_profile() {
  local username="${1:?Usage: scripts/pocket-id-dev set-profile USER EMAIL DISPLAY_NAME}"
  local email="${2:?Usage: scripts/pocket-id-dev set-profile USER EMAIL DISPLAY_NAME}"
  local display_name="${3:?Usage: scripts/pocket-id-dev set-profile USER EMAIL DISPLAY_NAME}"
  start_idp
  python3 "$PYTHON_HELPER" \
    --env-file "$ENV_FILE" \
    set-profile "$username" "$email" "$display_name"
}

set_group() {
  local username="${1:?Usage: scripts/pocket-id-dev set-group USER present|absent}"
  local state="${2:?Usage: scripts/pocket-id-dev set-group USER present|absent}"
  start_idp
  python3 "$PYTHON_HELPER" --env-file "$ENV_FILE" set-group "$username" "$state"
}

stop_idp() {
  load_environment
  "${COMPOSE[@]}" stop pocket-id
}

status() {
  load_environment
  "${COMPOSE[@]}" ps
}

reset_idp() {
  local confirmation="${1:-}"
  load_environment
  if [[ "$confirmation" != "--confirm" ]]; then
    printf 'This deletes only the local Pocket ID container and volume.\n' >&2
    printf 'Re-run with: scripts/pocket-id-dev reset-idp --confirm\n' >&2
    return 2
  fi
  "${COMPOSE[@]}" rm -sf pocket-id
  docker volume rm "${COMPOSE_PROJECT_NAME}_pocket-id-data"
}

cleanup_qa_clone() {
  local confirmation="${1:-}"
  load_environment
  if [[ "$confirmation" != "--confirm" ]]; then
    printf 'This deletes the disposable Pocket ID QA clone and local IdP data.\n' >&2
    printf 'Re-run with: scripts/pocket-id-dev cleanup-qa-clone --confirm\n' >&2
    return 2
  fi
  "${COMPOSE[@]}" stop odoo pocket-id >/dev/null 2>&1 || true
  "${BASE_COMPOSE[@]}" up -d --wait db
  "${BASE_COMPOSE[@]}" exec -T \
    -e PGPASSWORD="${POSTGRES_PASSWORD:-odoo}" \
    -e TARGET_DATABASE="$ODOO_INIT_DB" \
    db sh -eu -c \
    'dropdb --if-exists --force -U "$POSTGRES_USER" "$TARGET_DATABASE"'
  "${BASE_COMPOSE[@]}" --profile init run --rm \
    --entrypoint sh \
    -e TARGET_DATABASE="$ODOO_INIT_DB" \
    init-db -eu -c '
      target="/var/lib/odoo/filestore/$TARGET_DATABASE"
      if [ -d "$target" ]; then
        find "$target" -mindepth 1 -delete
        rmdir "$target"
      fi
    '
  "${COMPOSE[@]}" rm -sf pocket-id >/dev/null 2>&1 || true
  docker volume rm "${COMPOSE_PROJECT_NAME}_pocket-id-data" >/dev/null 2>&1 || true
  restore_canonical_odoo
  printf 'Removed disposable Pocket ID QA clone: %s\n' "$ODOO_INIT_DB"
  printf 'Restored canonical development URL: http://localhost:8069/web/login?db=%s\n' \
    "$POCKET_ID_SOURCE_DB"
}

case "${1:-help}" in
  bootstrap)
    bootstrap
    ;;
  start-idp)
    start_idp
    ;;
  provision)
    provision
    ;;
  ensure-unlinked)
    ensure_unlinked
    ;;
  configure-odoo)
    configure_odoo
    ;;
  one-time-link)
    one_time_link "${2:-}"
    ;;
  set-disabled)
    set_disabled "${2:-}" "${3:-}"
    ;;
  set-profile)
    set_profile "${2:-}" "${3:-}" "${4:-}"
    ;;
  set-group)
    set_group "${2:-}" "${3:-}"
    ;;
  stop-idp)
    stop_idp
    ;;
  status)
    status
    ;;
  reset-idp)
    reset_idp "${2:-}"
    ;;
  cleanup-qa-clone)
    cleanup_qa_clone "${2:-}"
    ;;
  help|*)
    cat <<'EOF'
Usage: scripts/pocket-id-dev <command>

Commands:
  bootstrap                  Generate ignored local secrets and stable test IDs
  start-idp                  Start only the isolated Pocket ID service
  provision                  Idempotently configure users, group, and OIDC client
  ensure-unlinked            Add the Pocket-only lifecycle-denial identity
  configure-odoo             Clone, configure, and start disposable SSO QA
  one-time-link USER         Generate a one-hour Pocket ID login link
  set-disabled USER BOOL     Enable or disable a named Pocket ID user
  set-profile USER EMAIL NAME
                             Change claims without changing the immutable subject
  set-group USER STATE       Add or remove a named user from the Odoo group
  stop-idp                   Stop Pocket ID for outage testing
  status                     Show this project's services
  reset-idp --confirm        Delete only the disposable Pocket ID service data
  cleanup-qa-clone --confirm Delete the QA clone/IdP and restore canonical Odoo
EOF
    ;;
esac
