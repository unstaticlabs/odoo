#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
GIT_COMMON_DIR="$(
  git -C "$ROOT" rev-parse --path-format=absolute --git-common-dir 2>/dev/null \
    || true
)"
if [[ -n "$GIT_COMMON_DIR" ]]; then
  DEFAULT_ENV_FILE="$(dirname "$GIT_COMMON_DIR")/.pocket-id.env"
else
  DEFAULT_ENV_FILE="$ROOT/.pocket-id.env"
fi
# Pocket ID is a deliberately shared canonical odoo_dev service. Linked Git
# worktrees must therefore share its encryption environment as well; otherwise
# an ordinary helper command can recreate the shared container with a key that
# cannot decrypt the existing Pocket volume.
ENV_FILE="${POCKET_ID_ENV_FILE:-$DEFAULT_ENV_FILE}"
PYTHON_HELPER="$ROOT/scripts/pocket_id_dev.py"
COMPOSE_FILES=(-f "$ROOT/compose.yaml" -f "$ROOT/compose.pocket-id.yaml")

bootstrap() {
  python3 "$PYTHON_HELPER" --env-file "$ENV_FILE" bootstrap
}

load_environment() {
  bootstrap >/dev/null
  set -a
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a
  if [[ "${USL_EINVOICE_LIVE_ENABLED:-0}" != "0" \
      || "${USL_EREPORTING_LIVE_ENABLED:-0}" != "0" ]]; then
    printf 'Refusing Pocket ID while a live regulatory guard is enabled.\n' >&2
    return 2
  fi
  if [[ "${ODOO_INIT_DB:-}" != "odoo_dev" \
      || "${ODOO_DB_FILTER:-}" != "^odoo_dev$" ]]; then
    printf \
      'Refusing local Pocket ID outside canonical odoo_dev.\n' \
      >&2
    return 2
  fi
  export ODOO_IMAGE="${ODOO_IMAGE:-${COMPOSE_PROJECT_NAME}-odoo:latest}"
  COMPOSE=(
    docker compose
    -p "$COMPOSE_PROJECT_NAME"
    --env-file "$ENV_FILE"
    "${COMPOSE_FILES[@]}"
  )
}

start_idp() {
  load_environment
  "${COMPOSE[@]}" up -d --wait pocket-id
}

start_paperless_runtime() {
  "${COMPOSE[@]}" --profile paperless up -d --wait paperless-webserver
  "${COMPOSE[@]}" --profile paperless run --rm --no-deps paperless-access-init
}

provision() {
  start_idp
  python3 "$PYTHON_HELPER" --env-file "$ENV_FILE" provision
}

ensure_unlinked() {
  start_idp
  python3 "$PYTHON_HELPER" --env-file "$ENV_FILE" ensure-unlinked
}

run_policy() {
  local apply_mode="$1" policy
  policy="$(python3 "$PYTHON_HELPER" --env-file "$ENV_FILE" odoo-policy)"
  "${COMPOSE[@]}" --profile init run --rm -T \
    -e ODOO_INIT_DB="$ODOO_INIT_DB" \
    -e USL_POCKET_ID_USERS_JSON="$policy" \
    -e USL_POCKET_ID_BREAK_GLASS_PASSWORD="$USL_POCKET_ID_BREAK_GLASS_PASSWORD" \
    -e USL_POCKET_ID_APPLY="$apply_mode" \
    init-db odoo shell \
    --config=/etc/odoo/odoo.conf \
    --database="$ODOO_INIT_DB" < "$ROOT/scripts/odoo/pocket_id_configure.py"
}

import_french_catalogues() {
  local modules_csv="$1"
  local module
  local -a catalogues=()
  local -a modules=()
  IFS=',' read -r -a modules <<< "$modules_csv"
  for module in "${modules[@]}"; do
    if [[ -f "$ROOT/custom-addons/$module/i18n/fr.po" ]]; then
      catalogues+=("/mnt/custom-addons/$module/i18n/fr.po")
    fi
  done
  if ((${#catalogues[@]} == 0)); then
    return 0
  fi
  "${COMPOSE[@]}" --profile init run --rm \
    -e ODOO_INIT_DB="$ODOO_INIT_DB" \
    init-db odoo i18n import \
    --config=/etc/odoo/odoo.conf \
    --database="$ODOO_INIT_DB" \
    --overwrite \
    --language=fr \
    "${catalogues[@]}"
}

configure_odoo() {
  local module="${1:-usl_pocketid}"
  local status=0 update_modules
  provision
  start_paperless_runtime
  "${COMPOSE[@]}" stop odoo >/dev/null 2>&1 || true
  update_modules="usl_pocketid"
  if [[ "$module" != "usl_pocketid" ]]; then
    update_modules="$update_modules,$module"
  fi
  if "${COMPOSE[@]}" --profile init run --rm \
    -e ODOO_INIT_DB="$ODOO_INIT_DB" \
    init-db odoo \
    --config=/etc/odoo/odoo.conf \
    --database="$ODOO_INIT_DB" \
    --update="$update_modules" \
    --load-language=fr \
    --i18n-overwrite \
    --without-demo=true \
    --stop-after-init \
    --log-level=warn; then
    if import_french_catalogues "$update_modules" && run_policy 0; then
      if run_policy 1; then
        run_policy 0 || status=$?
      else
        status=$?
      fi
    else
      status=$?
    fi
  else
    status=$?
  fi
  if ((status)); then
    "${COMPOSE[@]}" up -d --wait odoo || true
    return "$status"
  fi
  "${COMPOSE[@]}" up -d --force-recreate --wait odoo
  printf '\nPocket ID: %s\n' "$POCKET_ID_APP_URL"
  printf 'Odoo: %s/web/login?db=%s\n' "$ODOO_PUBLIC_BASE_URL" "$ODOO_INIT_DB"
  printf 'Documents: %s\n' "$PAPERLESS_PUBLIC_URL"
}

start_runtime() {
  provision
  start_paperless_runtime
  "${COMPOSE[@]}" up -d --wait db pocket-id odoo
  printf '\nPocket ID: %s\n' "$POCKET_ID_APP_URL"
  printf 'Odoo: %s/web/login?db=%s\n' "$ODOO_PUBLIC_BASE_URL" "$ODOO_INIT_DB"
  printf 'Documents: %s\n' "$PAPERLESS_PUBLIC_URL"
}

one_time_link() {
  local username="${1:?Usage: scripts/pocket-id-dev one-time-link USER}"
  start_idp
  python3 "$PYTHON_HELPER" --env-file "$ENV_FILE" one-time-link "$username"
}

set_disabled() {
  local username="${1:?Usage: scripts/pocket-id-dev set-disabled USER true|false}"
  local state="${2:?Usage: scripts/pocket-id-dev set-disabled USER true|false}"
  start_idp
  python3 "$PYTHON_HELPER" --env-file "$ENV_FILE" set-disabled "$username" "$state"
}

set_profile() {
  local username="${1:?Usage: scripts/pocket-id-dev set-profile USER EMAIL DISPLAY_NAME}"
  local email="${2:?Usage: scripts/pocket-id-dev set-profile USER EMAIL DISPLAY_NAME}"
  local display_name="${3:?Usage: scripts/pocket-id-dev set-profile USER EMAIL DISPLAY_NAME}"
  start_idp
  python3 "$PYTHON_HELPER" \
    --env-file "$ENV_FILE" \
    set-profile "$username" "$email" "$display_name"
}

set_group() {
  local username="${1:?Usage: scripts/pocket-id-dev set-group USER present|absent}"
  local state="${2:?Usage: scripts/pocket-id-dev set-group USER present|absent}"
  start_idp
  python3 "$PYTHON_HELPER" --env-file "$ENV_FILE" set-group "$username" "$state"
}

stop_idp() {
  load_environment
  "${COMPOSE[@]}" stop pocket-id
}

stop_stack() {
  load_environment
  "${COMPOSE[@]}" down
}

follow_logs() {
  load_environment
  "${COMPOSE[@]}" logs -f "$@"
}

status() {
  load_environment
  "${COMPOSE[@]}" ps
}

reset_idp() {
  local confirmation="${1:-}"
  load_environment
  if [[ "$confirmation" != "--confirm" ]]; then
    printf 'This deletes only the local Pocket ID container and volume.\n' >&2
    printf 'Re-run with: scripts/pocket-id-dev reset-idp --confirm\n' >&2
    return 2
  fi
  "${COMPOSE[@]}" rm -sf pocket-id
  docker volume rm "${COMPOSE_PROJECT_NAME}_pocket-id-data"
}

case "${1:-help}" in
  bootstrap)
    bootstrap
    ;;
  start-idp)
    start_idp
    ;;
  provision)
    provision
    ;;
  ensure-unlinked)
    ensure_unlinked
    ;;
  configure-odoo)
    configure_odoo "${2:-usl_pocketid}"
    ;;
  start-runtime)
    start_runtime
    ;;
  one-time-link)
    one_time_link "${2:-}"
    ;;
  set-disabled)
    set_disabled "${2:-}" "${3:-}"
    ;;
  set-profile)
    set_profile "${2:-}" "${3:-}" "${4:-}"
    ;;
  set-group)
    set_group "${2:-}" "${3:-}"
    ;;
  stop-idp)
    stop_idp
    ;;
  stop-stack)
    stop_stack
    ;;
  logs)
    shift
    follow_logs "$@"
    ;;
  status)
    status
    ;;
  reset-idp)
    reset_idp "${2:-}"
    ;;
  help|*)
    cat <<'EOF'
Usage: scripts/pocket-id-dev <command>

Commands:
  bootstrap                  Generate ignored local secrets and stable test IDs
  start-idp                  Start only the isolated Pocket ID service
  provision                  Idempotently configure users, group, and OIDC client
  ensure-unlinked            Add the Pocket-only lifecycle-denial identity
  configure-odoo [MODULE]    Configure canonical odoo_dev and start its SSO stack
  start-runtime              Start Odoo, Pocket ID, and Paperless for odoo_dev
  one-time-link USER         Generate a one-hour link for any Pocket ID user
  set-disabled USER BOOL     Enable or disable a named Pocket ID user
  set-profile USER EMAIL NAME
                             Change claims without changing the immutable subject
  set-group USER STATE       Add or remove a named user from the Odoo group
  stop-idp                   Stop Pocket ID for outage testing
  stop-stack                 Stop the canonical Odoo/Pocket ID stack
  logs [SERVICE]             Follow canonical target stack logs
  status                     Show this project's services
  reset-idp --confirm        Delete only local Pocket ID service data
EOF
    ;;
esac
