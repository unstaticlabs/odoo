#!/usr/bin/env python3
"""Print a comma-separated Odoo module test plan for a Git diff."""

from __future__ import annotations

import argparse
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from operations.module_release import build_inventory  # noqa: E402
from operations.qualification_plan import affected_modules  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--base", required=True)
    parser.add_argument("--head", required=True)
    arguments = parser.parse_args()
    changed = subprocess.run(
        ["git", "diff", "--name-only", arguments.base, arguments.head],
        cwd=ROOT,
        check=True,
        capture_output=True,
        text=True,
    ).stdout.splitlines()
    inventory = build_inventory(ROOT, require_dependencies=True)
    print(",".join(affected_modules(changed, inventory)))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
