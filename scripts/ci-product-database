#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

run_id="${GITHUB_RUN_ID:-local}"
attempt="${GITHUB_RUN_ATTEMPT:-1}"
project="usl-qualification-${run_id}-${attempt}"
database="usl_qualification_${run_id}_${attempt}"
project="${project//[^A-Za-z0-9_-]/-}"
database="${database//[^A-Za-z0-9_]/_}"
export COMPOSE_PROJECT_NAME="$project"
export ODOO_DEV_DB="$database"
export USL_EINVOICE_LIVE_ENABLED=0
export USL_EREPORTING_LIVE_ENABLED=0

compose=(docker compose -p "$project")
cleanup() {
  "${compose[@]}" down --volumes --remove-orphans >/dev/null 2>&1 || true
}
trap cleanup EXIT INT TERM

scripts/sync-oca-addons
modules="$(PYTHONPATH=. python3 - <<'PY'
from pathlib import Path
from operations.module_release import build_inventory

print(",".join(sorted(build_inventory(Path.cwd(), require_dependencies=True)["modules"])))
PY
)"
test -n "$modules"

"${compose[@]}" up -d --wait db
"${compose[@]}" --profile test build test

odoo_run() {
  "${compose[@]}" --profile test run --rm -T \
    -e ODOO_INIT_DB="$database" \
    -e ODOO_DB_FILTER="^${database}$" \
    -e USL_PRODUCT_BOUNDARY_PREPROD="${USL_PRODUCT_BOUNDARY_PREPROD:-0}" \
    -e ACTION_RISK_MODE="${ACTION_RISK_MODE:-check}" \
    test odoo \
    --config=/etc/odoo/odoo.conf \
    --database="$database" \
    --without-demo=true \
    --workers=0 \
    --max-cron-threads=0 \
    --no-http \
    --stop-after-init \
    --log-level=warn \
    "$@"
}

odoo_shell() {
  "${compose[@]}" --profile test run --rm -T --no-deps \
    -e ODOO_INIT_DB="$database" \
    -e ODOO_DB_FILTER="^${database}$" \
    -e USL_PRODUCT_BOUNDARY_PREPROD="${USL_PRODUCT_BOUNDARY_PREPROD:-0}" \
    -e ACTION_RISK_MODE="${ACTION_RISK_MODE:-check}" \
    test odoo shell \
    --config=/etc/odoo/odoo.conf \
    --database="$database" \
    --shell-interface=python
}

printf 'Installing %s product modules into %s\n' "$(tr ',' '\n' <<<"$modules" | wc -l | tr -d ' ')" "$database"
odoo_run --init="$modules"
odoo_shell < scripts/odoo/enforce_product_module_scope.py
odoo_run --update="$modules"
odoo_run --update="$modules"

test_modules="${USL_TEST_MODULES:-}"
if [[ -n "$test_modules" ]]; then
  if [[ ! "$test_modules" =~ ^[A-Za-z0-9_]+(,[A-Za-z0-9_]+)*$ ]]; then
    printf 'Invalid USL_TEST_MODULES value: %s\n' "$test_modules" >&2
    exit 2
  fi
  test_tags="$(printf '%s' "$test_modules" | sed 's/[^,][^,]*/\/&/g')"
  printf 'Running affected module suites: %s\n' "$test_modules"
  "${compose[@]}" --profile test run --rm -T \
    -e ODOO_INIT_DB="$database" \
    -e ODOO_DB_FILTER="^${database}$" \
    -e USL_EINVOICE_LIVE_ENABLED=0 \
    -e USL_EREPORTING_LIVE_ENABLED=0 \
    -e ACTION_RISK_MODE=check \
    test odoo \
    --config=/etc/odoo/odoo.conf \
    --database="$database" \
    --workers=0 \
    --max-cron-threads=0 \
    --stop-after-init \
    --test-enable \
    --test-tags="$test_tags" \
    --update="$test_modules" \
    --log-level=test

  IFS=',' read -r -a affected_modules <<< "$test_modules"
  for module in "${affected_modules[@]}"; do
    frontend_tests="$ROOT/custom-addons/$module/static/tests"
    if [[ ! -d "$frontend_tests" ]] \
        || [[ -z "$(find "$frontend_tests" -type f -name '*.test.js' -print -quit)" ]]; then
      continue
    fi
    printf 'Running affected frontend suites on desktop and mobile: %s\n' "$module"
    "${compose[@]}" --profile test run --rm -T \
      -e ODOO_INIT_DB="$database" \
      -e ODOO_DB_FILTER="^${database}$" \
      -e USL_EINVOICE_LIVE_ENABLED=0 \
      -e USL_EREPORTING_LIVE_ENABLED=0 \
      -e ACTION_RISK_MODE=check \
      test odoo \
      --config=/etc/odoo/odoo.conf \
      --database="$database" \
      --workers=0 \
      --max-cron-threads=0 \
      --stop-after-init \
      --test-enable \
      --test-tags="/$module:WebSuite.test_unit_desktop,/$module:MobileWebSuite.test_unit_mobile" \
      --update="$module" \
      --log-level=test
  done
fi

USL_PRODUCT_BOUNDARY_PREPROD=0 odoo_shell < scripts/odoo/product_database_boundary.py

ACTION_RISK_MODE=check odoo_shell < scripts/odoo/action_risk_inventory.py

printf 'Clean install, repeated upgrade, affected tests and runtime boundaries passed.\n'
