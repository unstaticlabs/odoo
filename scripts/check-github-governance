#!/usr/bin/env python3
"""Validate the versioned USL GitHub ruleset payload."""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from operations.github_governance import load, validate


ROOT = Path(__file__).resolve().parents[1]


if __name__ == "__main__":
    validate(load(ROOT / "operations/contracts/github-usl-distribution-ruleset.json"))
    print("GitHub USL Distribution ruleset: valid")
