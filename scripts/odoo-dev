#!/usr/bin/env bash
set -euo pipefail
export COMPOSE_IGNORE_ORPHANS=1

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

COMPOSE_PROJECT="${ODOO_SAAS_COMPOSE_PROJECT:-usl-odoo-saas-19-2}"
CANONICAL_COMPOSE_PROJECT="${ODOO_CANONICAL_COMPOSE_PROJECT:-usl-odoo-saas-19-2}"
COMPOSE=(docker compose -p "$COMPOSE_PROJECT")
DEV_DB="${ODOO_DEV_DB:-odoo_dev}"
DEV_MODULE="${ODOO_DEV_MODULE:-rebuild_account_migration}"
case "$DEV_DB" in
  ""|*[!A-Za-z0-9_]*)
    printf 'Refusing unsafe development database name: %s\n' "$DEV_DB" >&2
    exit 2
    ;;
esac
export ODOO_INIT_DB="$DEV_DB"
export ODOO_DB_FILTER="^${DEV_DB}$"

is_canonical_target() {
  [[ "$DEV_DB" == "odoo_dev" \
    && "$COMPOSE_PROJECT" == "$CANONICAL_COMPOSE_PROJECT" ]]
}

restore_development_runtime() {
  if is_canonical_target; then
    "$ROOT/scripts/pocket-id-dev" start-runtime
  else
    "${COMPOSE[@]}" up -d --wait odoo
    print_url
  fi
}

verify_runtime_database_filter() {
  local runtime_filter
  runtime_filter="$(
    "${COMPOSE[@]}" exec -T odoo sh -lc \
      "sed -n 's/^dbfilter[[:space:]]*=[[:space:]]*//p' /etc/odoo/odoo.conf" \
      | tr -d '\r' \
      | tail -n 1
  )"
  if [[ "$runtime_filter" != "$ODOO_DB_FILTER" ]]; then
    printf \
      'Development server database filter mismatch: expected %s, found %s\n' \
      "$ODOO_DB_FILTER" "${runtime_filter:-<empty>}" >&2
    return 1
  fi
}

print_url() {
  local published_port
  verify_runtime_database_filter
  published_port="$("${COMPOSE[@]}" port odoo 8069 2>/dev/null | tail -n 1)"
  published_port="${published_port##*:}"
  published_port="${published_port:-8069}"
  printf '\nDevelopment environment: http://localhost:%s/web/login?db=%s\n' \
    "$published_port" "$DEV_DB"
}

disable_dev_tours() {
  "${COMPOSE[@]}" exec -T \
    -e USL_DISABLE_DEV_TOURS=1 \
    odoo odoo shell \
    --config=/etc/odoo/odoo.conf \
    --database="$DEV_DB" < "$ROOT/scripts/odoo/disable_dev_tours.py"
}

deploy() {
  local module="${1:-$DEV_MODULE}"
  local update_modules="$module"
  if [[ "$module" == "rebuild_account_migration" ]]; then
    update_modules="usl_accounting,rebuild_account_migration,usl_documents,usl_documents_accounting,usl_tese_payroll"
  fi
  if is_canonical_target; then
    "$ROOT/scripts/pocket-id-dev" configure-odoo "$update_modules"
    disable_dev_tours
    return
  fi
  "${COMPOSE[@]}" up -d --wait db
  "${COMPOSE[@]}" stop odoo >/dev/null 2>&1 || true
  "${COMPOSE[@]}" --profile init run --rm \
    -e ODOO_INIT_DB="$DEV_DB" \
    init-db odoo \
    --config=/etc/odoo/odoo.conf \
    --database="$DEV_DB" \
    --update="$update_modules" \
    --without-demo=true \
    --stop-after-init \
    --log-level=warn
  "${COMPOSE[@]}" up -d --force-recreate --wait odoo
  disable_dev_tours
  print_url
}

run_with_odoo_stopped() {
  local profile="$1"
  local service="$2"
  shift 2
  local status=0
  "${COMPOSE[@]}" up -d --wait db
  "${COMPOSE[@]}" stop odoo >/dev/null 2>&1 || true
  "${COMPOSE[@]}" --profile "$profile" run --rm \
    -e ODOO_INIT_DB="$DEV_DB" "$service" "$@" || status=$?
  restore_development_runtime
  return "$status"
}

verify_platform_billing_qa_scope() {
  if [[ "$COMPOSE_PROJECT" != usl-odoo-fp-* ]]; then
    printf \
      'Platform Billing QA requires a dedicated usl-odoo-fp-* project; got %s.\n' \
      "$COMPOSE_PROJECT" >&2
    return 2
  fi
  if [[ "${COMPOSE_PROJECT_NAME:-}" != "$COMPOSE_PROJECT" ]]; then
    printf \
      'Platform Billing QA requires COMPOSE_PROJECT_NAME=%s for Pocket ID; got %s.\n' \
      "$COMPOSE_PROJECT" "${COMPOSE_PROJECT_NAME:-<unset>}" >&2
    return 2
  fi

  local container_id project_label working_dir_label
  while IFS= read -r container_id; do
    [[ -z "$container_id" ]] && continue
    project_label="$(
      docker inspect --format \
        '{{ index .Config.Labels "com.docker.compose.project" }}' \
        "$container_id"
    )"
    working_dir_label="$(
      docker inspect --format \
        '{{ index .Config.Labels "com.docker.compose.project.working_dir" }}' \
        "$container_id"
    )"
    if [[ "$project_label" != "$COMPOSE_PROJECT" \
        || "$working_dir_label" != "$ROOT" ]]; then
      printf \
        'Platform Billing QA scope mismatch on container %s.\n' \
        "$container_id" >&2
      return 2
    fi
  done < <(
    docker ps -aq \
      --filter "label=com.docker.compose.project=$COMPOSE_PROJECT"
  )
}

platform_billing_compose() {
  verify_platform_billing_qa_scope
  "${COMPOSE[@]}" "$@"
}

test_js() {
  local module="${1:-$DEV_MODULE}"
  "${COMPOSE[@]}" --profile test build test
  run_with_odoo_stopped test test odoo \
    --config=/etc/odoo/odoo.conf \
    --database="$DEV_DB" \
    --test-tags="/${module}:WebSuite.test_unit_desktop" \
    --stop-after-init \
    --log-level=test
}

test_tag() {
  local test_tag="$1"
  "${COMPOSE[@]}" --profile test build test
  run_with_odoo_stopped test test odoo \
    --config=/etc/odoo/odoo.conf \
    --database="$DEV_DB" \
    --test-enable \
    --test-tags="$test_tag" \
    --stop-after-init \
    --log-level=test
}

audit_platform_billing_qa() {
  local status=0
  platform_billing_compose up -d --wait db
  platform_billing_compose stop odoo >/dev/null 2>&1 || true
  platform_billing_compose --profile init run --rm -T \
    -e ODOO_INIT_DB="$DEV_DB" \
    init-db odoo shell \
    --config=/etc/odoo/odoo.conf \
    --database="$DEV_DB" < "$ROOT/scripts/odoo/platform_billing_qa_audit.py" \
    || status=$?
  verify_platform_billing_qa_scope
  restore_development_runtime
  return "$status"
}

bootstrap_einvoice_qa() {
  local status=0
  "${COMPOSE[@]}" up -d --wait db
  "${COMPOSE[@]}" stop odoo >/dev/null 2>&1 || true
  "${COMPOSE[@]}" --profile init run --rm -T \
    -e ODOO_INIT_DB="$DEV_DB" \
    -e USL_EINVOICE_QA_BOOTSTRAP=1 \
    init-db odoo shell \
    --config=/etc/odoo/odoo.conf \
    --database="$DEV_DB" < "$ROOT/scripts/odoo/einvoice_qa_bootstrap.py" \
    || status=$?
  restore_development_runtime
  if ((status)); then
    return "$status"
  fi
  printf '\nFrench e-invoicing QA is ready but inactive.\n'
  printf 'Manager: qa.manager / admin\n'
  printf 'Read-only: qa.reviewer / admin\n'
}

bootstrap_platform_billing_qa() {
  local status=0
  platform_billing_compose up -d --wait db
  platform_billing_compose stop odoo >/dev/null 2>&1 || true
  platform_billing_compose --profile init run --rm -T \
    -e ODOO_INIT_DB="$DEV_DB" \
    -e USL_PLATFORM_BILLING_QA_BOOTSTRAP=1 \
    init-db odoo shell \
    --config=/etc/odoo/odoo.conf \
    --database="$DEV_DB" < "$ROOT/scripts/odoo/platform_billing_qa_bootstrap.py" \
    || status=$?
  verify_platform_billing_qa_scope
  restore_development_runtime
  if ((status)); then
    return "$status"
  fi
  printf '\nPlatform Billing QA demo is ready.\n'
  printf 'Named manager: valentin / existing Pocket ID sign-in\n'
  printf 'Manager: qa.platform.manager / qa-platform-manager\n'
  printf 'Operator: qa.platform.operator / qa-platform-operator\n'
  printf 'Reviewer: qa.platform.reviewer / qa-platform-reviewer\n'
  printf 'Accountant without app access: qa.platform.accountant / qa-platform-accountant\n'
}

configure_pocket_id() {
  local status=0
  if is_canonical_target; then
    "$ROOT/scripts/pocket-id-dev" configure-odoo usl_pocketid
    return
  fi
  if [[ -z "${ODOO_DEV_DB:-}" \
      || "$DEV_DB" == "odoo_online_source_saas_19_2" ]]; then
    printf 'External Pocket ID configuration requires an explicit safe target.\n' >&2
    return 2
  fi
  if [[ "${USL_EINVOICE_LIVE_ENABLED:-0}" != "0" \
      || "${USL_EREPORTING_LIVE_ENABLED:-0}" != "0" ]]; then
    printf 'Pocket ID configuration requires both regulatory guards to be 0.\n' >&2
    return 2
  fi
  "${COMPOSE[@]}" up -d --wait db
  "${COMPOSE[@]}" stop odoo >/dev/null 2>&1 || true
  "${COMPOSE[@]}" --profile init run --rm -T \
    -e ODOO_INIT_DB="$DEV_DB" \
    init-db odoo shell \
    --config=/etc/odoo/odoo.conf \
    --database="$DEV_DB" < "$ROOT/scripts/odoo/pocket_id_configure.py" \
    || status=$?
  "${COMPOSE[@]}" up -d --force-recreate --wait odoo
  print_url
  return "$status"
}

bootstrap_immediate_settlement_qa() {
  local status=0
  "${COMPOSE[@]}" up -d --wait db
  "${COMPOSE[@]}" stop odoo >/dev/null 2>&1 || true
  "${COMPOSE[@]}" --profile init run --rm -T \
    -e ODOO_INIT_DB="$DEV_DB" \
    -e USL_IMMEDIATE_SETTLEMENT_QA_BOOTSTRAP=1 \
    -e ODOO_IMMEDIATE_SETTLEMENT_QA_DATABASE="$DEV_DB" \
    init-db odoo shell \
    --config=/etc/odoo/odoo.conf \
    --database="$DEV_DB" < \
    "$ROOT/scripts/odoo/immediate_settlement_qa_bootstrap.py" \
    || status=$?
  restore_development_runtime
  if ((status)); then
    return "$status"
  fi
  printf '\nThree-Action Foreign-Currency Settlement QA is ready.\n'
  printf 'Accountant: qa.settlement / qa-settlement\n'
  printf 'Read-only: qa.viewer / qa-viewer\n'
}

bootstrap_tese_payroll_qa() {
  local generation="${1:-01}"
  local status=0
  case "$generation" in
    ""|*[!0-9]*)
      printf 'TESE QA generation must be numeric: %s\n' "$generation" >&2
      return 2
      ;;
  esac
  "${COMPOSE[@]}" up -d --wait db
  "${COMPOSE[@]}" stop odoo >/dev/null 2>&1 || true
  "${COMPOSE[@]}" --profile init run --rm -T \
    -e ODOO_INIT_DB="$DEV_DB" \
    -e USL_TESE_PAYROLL_QA_BOOTSTRAP=1 \
    -e USL_TESE_PAYROLL_QA_GENERATION="$generation" \
    -e ODOO_TESE_PAYROLL_QA_DATABASE="$DEV_DB" \
    -e USL_EINVOICE_LIVE_ENABLED=0 \
    -e USL_EREPORTING_LIVE_ENABLED=0 \
    init-db odoo shell \
    --config=/etc/odoo/odoo.conf \
    --database="$DEV_DB" < \
    "$ROOT/scripts/odoo/tese_payroll_qa_bootstrap.py" \
    || status=$?
  restore_development_runtime
  if ((status)); then
    return "$status"
  fi
  printf '\nPaie TESE QA generation %s is ready.\n' "$generation"
  printf 'Open Payroll Records and apply the saved QA TESE filter.\n'
}

cleanup_test_database() {
  local database="$1"
  case "$database" in
    ""|"$DEV_DB"|*[!A-Za-z0-9_]*)
      printf 'Refusing to clean unsafe test database name: %s\n' "$database" >&2
      return 2
      ;;
  esac
  "${COMPOSE[@]}" up -d --wait db
  "${COMPOSE[@]}" exec -T \
    -e TEST_DATABASE="$database" \
    db sh -c \
    'dropdb --if-exists --force -U "$POSTGRES_USER" "$TEST_DATABASE"'
  "${COMPOSE[@]}" --profile init run --rm \
    --entrypoint sh \
    -e TEST_DATABASE="$database" \
    init-db -c '
      directory="/var/lib/odoo/filestore/$TEST_DATABASE"
      if [ -d "$directory" ]; then
        find "$directory" -mindepth 1 -delete
        rmdir "$directory"
      fi
    '
}

cleanup_test_container() {
  local container="$1"
  docker rm --force "$container" >/dev/null 2>&1 || true
}

finish_module_test() {
  local database="$1"
  local container="$2"
  trap - EXIT INT TERM
  cleanup_test_container "$container"
  cleanup_test_database "$database"
  restore_development_runtime
}

test_module() {
  local module="$1"
  local database="$2"
  local container
  local status=0
  case "$module" in
    ""|*[!A-Za-z0-9_]*)
      printf 'Refusing unsafe test module name: %s\n' "$module" >&2
      return 2
      ;;
  esac
  case "$database" in
    ""|"$DEV_DB"|*[!A-Za-z0-9_]*)
      printf 'Refusing unsafe test database name: %s\n' "$database" >&2
      return 2
      ;;
  esac
  container="${COMPOSE_PROJECT}-test-${database}"
  trap 'finish_module_test "$database" "$container"' EXIT INT TERM
  "${COMPOSE[@]}" --profile test build test
  cleanup_test_container "$container"
  cleanup_test_database "$database"
  "${COMPOSE[@]}" stop odoo >/dev/null 2>&1 || true
  "${COMPOSE[@]}" --profile test run --rm \
    --name "$container" \
    -e ODOO_INIT_DB="$database" \
    -e ODOO_DB_FILTER="^${database}$" \
    test odoo \
    --config=/etc/odoo/odoo.conf \
    --database="$database" \
    --init="$module" \
    --without-demo=true \
    --test-enable \
    --test-tags="/$module" \
    --stop-after-init \
    --log-level=test || status=$?
  finish_module_test "$database" "$container"
  return "$status"
}

case "${1:-help}" in
  build)
    "${COMPOSE[@]}" build "${@:2}"
    ;;
  start)
    if is_canonical_target; then
      "$ROOT/scripts/pocket-id-dev" configure-odoo usl_pocketid
    else
      "${COMPOSE[@]}" up -d --wait db odoo
    fi
    disable_dev_tours
    print_url
    ;;
  deploy)
    deploy "${2:-$DEV_MODULE}"
    ;;
  rebuild)
    "${COMPOSE[@]}" build odoo
    deploy "${2:-$DEV_MODULE}"
    ;;
  stop)
    if is_canonical_target; then
      "$ROOT/scripts/pocket-id-dev" stop-stack
    else
      "${COMPOSE[@]}" down
    fi
    ;;
  restart)
    if is_canonical_target; then
      "$ROOT/scripts/pocket-id-dev" start-runtime
    else
      "${COMPOSE[@]}" restart "${@:2}"
    fi
    ;;
  logs)
    if is_canonical_target; then
      "$ROOT/scripts/pocket-id-dev" logs "${@:2}"
    else
      "${COMPOSE[@]}" logs -f "${@:2}"
    fi
    ;;
  init-db)
    "${COMPOSE[@]}" build odoo
    "${COMPOSE[@]}" --profile init run --rm init-db
    if is_canonical_target; then
      "$ROOT/scripts/pocket-id-dev" configure-odoo usl_pocketid
    fi
    ;;
  shell)
    "${COMPOSE[@]}" --profile devcontainer run --rm devcontainer bash
    ;;
  test)
    module="${2:-base}"
    database="${3:-odoo_unit_test}"
    test_module "$module" "$database"
    ;;
  test-js)
    test_js "${2:-$DEV_MODULE}"
    ;;
  test-tag)
    test_tag "${2:?Usage: scripts/odoo-dev test-tag TEST_TAG}"
    ;;
  audit-platform-billing)
    audit_platform_billing_qa
    ;;
  bootstrap-einvoice-qa)
    bootstrap_einvoice_qa
    ;;
  bootstrap-platform-billing-qa)
    bootstrap_platform_billing_qa
    ;;
  configure-pocket-id)
    configure_pocket_id
    ;;
  disable-tours)
    disable_dev_tours
    ;;
  bootstrap-immediate-settlement-qa)
    bootstrap_immediate_settlement_qa
    ;;
  bootstrap-tese-payroll-qa)
    bootstrap_tese_payroll_qa "${2:-01}"
    ;;
  ruff)
    "${COMPOSE[@]}" --profile devcontainer run --rm devcontainer ruff check "${@:2}"
    ;;
  reset)
    if is_canonical_target; then
      "$ROOT/scripts/pocket-id-dev" stop-stack
    fi
    "${COMPOSE[@]}" down --volumes --remove-orphans
    ;;
  update)
    "${COMPOSE[@]}" pull db
    "${COMPOSE[@]}" build --pull
    ;;
  ps)
    if is_canonical_target; then
      "$ROOT/scripts/pocket-id-dev" status
    else
      "${COMPOSE[@]}" ps
    fi
    ;;
  help|*)
    cat <<'EOF'
Usage: scripts/odoo-dev <command>

Commands:
  build        Build Odoo images
  start        Start PostgreSQL and Odoo
  deploy [mod] Update a module and recreate the development server
  rebuild [mod] Rebuild images, update a module, and recreate the server
  stop         Stop the stack
  restart      Restart services
  logs         Follow logs
  init-db      Initialize odoo_dev (or ODOO_INIT_DB)
  shell        Open a dev container shell
  test [mod]   Run full backend/browser tests for a module
  test-js [mod] Run one module's frontend unit tests on odoo_dev
  test-tag TAG  Run one installed backend/browser test tag on odoo_dev
  audit-platform-billing
                Audit the restored Platform Billing QA database
  bootstrap-einvoice-qa
                Prepare safe e-invoicing QA data and local test accounts
  bootstrap-platform-billing-qa
                Prepare deterministic Platform Billing QA records and users
  configure-pocket-id
                Dry-run or apply Pocket ID environment and named-user policy
  disable-tours
                Disable automatic tours for internal dev/QA users
  bootstrap-immediate-settlement-qa
                Prepare three-action foreign-currency settlement QA cases
  bootstrap-tese-payroll-qa [generation]
                Seed synthetic Paie TESE journeys in the selected QA database
  ruff [args]  Run ruff in the dev image
  update       Pull service images and rebuild
  reset        Stop and delete local volumes
  ps           Show service status
EOF
    ;;
esac
