#!/usr/bin/env bash
set -euo pipefail
export COMPOSE_IGNORE_ORPHANS=1

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
source "$ROOT/scripts/lib/compose-scope.sh"
usl_cli_load_local_port_defaults "$ROOT"

COMPOSE_PROJECT="${ODOO_SAAS_COMPOSE_PROJECT:-${COMPOSE_PROJECT_NAME:-usl-odoo-saas-19-3}}"
CANONICAL_COMPOSE_PROJECT="${ODOO_CANONICAL_COMPOSE_PROJECT:-usl-odoo-saas-19-3}"
COMPOSE=(docker compose -p "$COMPOSE_PROJECT")
DEV_DB="${ODOO_DEV_DB:-odoo_dev}"
DEV_MODULE="${ODOO_DEV_MODULE:-rebuild_account_migration}"
case "$DEV_DB" in
  ""|*[!A-Za-z0-9_]*)
    printf 'Refusing unsafe development database name: %s\n' "$DEV_DB" >&2
    exit 2
    ;;
esac
export ODOO_INIT_DB="$DEV_DB"
export ODOO_DB_FILTER="^${DEV_DB}$"

current_branch() {
  local branch
  branch="$(git -C "$ROOT" branch --show-current 2>/dev/null || true)"
  printf '%s' "${branch:-<detached>}"
}

print_command_context() {
  usl_cli_context \
    "$ROOT" "$(current_branch)" "$COMPOSE_PROJECT" "$DEV_DB" \
    "Odoo ${ODOO_HTTP_PORT:-8069}, gevent ${ODOO_GEVENT_PORT:-8072}, Pocket ID ${POCKET_ID_HTTP_PORT:-1411}, Paperless ${PAPERLESS_HTTP_PORT:-8010}"
}

doctor() {
  local mode="${1:-doctor}"
  local volume_count volume_names database_status
  local pocket_status="not-required" pocket_output configured_project
  if [[ "$mode" == "doctor" ]]; then
    usl_cli_title "Environment doctor"
  else
    usl_cli_title "Environment status"
  fi
  print_command_context
  printf '  Safety:   e-invoice=%s, e-reporting=%s\n' \
    "${USL_EINVOICE_LIVE_ENABLED:-0}" "${USL_EREPORTING_LIVE_ENABLED:-0}"
  if volume_names="$(
    docker volume ls --filter "name=${COMPOSE_PROJECT}_" --format '{{.Name}}' 2>/dev/null \
  )"; then
    volume_count="$(
      printf '%s\n' "$volume_names" \
        | awk 'NF {count += 1} END {print count + 0}'
    )"
    printf '  Volumes:  %s preserved data volumes\n' "$volume_count"
  else
    printf '  Volumes:  unavailable\n'
  fi
  usl_print_compose_inventory "$COMPOSE_PROJECT" "$ROOT"
  database_status="not-checked"
  if [[ "$USL_COMPOSE_SCOPE_STATE" == "owned" ]]; then
    usl_compose_database_status "$COMPOSE_PROJECT" "$ROOT" "$DEV_DB"
    database_status="$USL_COMPOSE_DATABASE_STATUS"
  fi
  printf '  Target:   %s\n' "$database_status"
  if uses_pocket_id_runtime; then
    configured_project="$(pocket_id_env_project 2>/dev/null || true)"
    if [[ -z "$configured_project" ]]; then
      pocket_status="not-configured"
    elif [[ "$configured_project" != "$COMPOSE_PROJECT" ]]; then
      pocket_status="wrong-project ($configured_project)"
    elif [[ "$USL_COMPOSE_SCOPE_STATE" == "owned" \
        && "$database_status" == "present" ]]; then
      if pocket_output="$(
        COMPOSE_PROJECT_NAME="$COMPOSE_PROJECT" \
          "$ROOT/scripts/pocket-id-dev" verify-odoo 2>&1
      )"; then
        pocket_status="ready"
      elif [[ "$pocket_output" == *"Odoo is not running"* ]]; then
        pocket_status="not-running"
      else
        pocket_status="broken"
      fi
    else
      pocket_status="not-checked"
    fi
  fi
  printf '  Pocket ID: %s\n' "$pocket_status"
  printf '  Configured URLs:\n'
  printf '             http://odoo.localhost:%s/odoo\n' "${ODOO_HTTP_PORT:-8069}"
  printf '             http://paperless.localhost:%s\n' "${PAPERLESS_HTTP_PORT:-8010}"

  if [[ "$mode" != "doctor" ]]; then
    return 0
  fi
  printf '\nAssessment\n'
  case "$USL_COMPOSE_SCOPE_STATE" in
    unused)
      printf '  Ready to start. Run: make dev\n'
      ;;
    owned)
      printf '  Ownership is consistent with this checkout.\n'
      case "$database_status" in
        present)
          printf '  Update mounted add-ons with: make deploy\n'
          ;;
        missing)
          printf '  The %s database is missing; deploy cannot recreate source data.\n' "$DEV_DB"
          printf '  Reconstruct shipped product scopes with: make target-reconstruct-product\n'
          printf '  Final migration uses: make migrate-production SOURCE_SHA=<sha256>\n'
          ;;
        not-running)
          printf '  The database service is stopped; run make dev to inspect the target.\n'
          ;;
        *)
          printf '  Database readiness could not be verified; inspect the db logs.\n'
          ;;
      esac
      ;;
    foreign|mixed)
      printf '  Action required before mutating this project.\n'
      printf '  The safety guard is preventing cross-checkout bind mounts and config.\n'
      if [[ -d "$ROOT/.git" && "$COMPOSE_PROJECT" == "$CANONICAL_COMPOSE_PROJECT" ]]; then
        printf '  Reclaim containers while preserving data:\n'
        printf '    make dev-reclaim CONFIRM=%s\n' "$COMPOSE_PROJECT"
      else
        printf '  Use a dedicated COMPOSE_PROJECT and ports for this worktree.\n'
      fi
      ;;
    unavailable)
      printf '  Docker is unavailable. Start Docker, then rerun make doctor.\n'
      ;;
  esac
  if uses_pocket_id_runtime \
      && [[ "$pocket_status" != "ready" \
        && "$pocket_status" != "not-running" \
        && "$pocket_status" != "not-checked" ]]; then
    printf '\nPocket ID repair\n'
    printf '  Odoo and its project-bound SSO configuration are not aligned.\n'
    printf '  Run:\n'
    printf '    make COMPOSE_PROJECT=%s ODOO_HTTP_PORT=%s ODOO_GEVENT_PORT=%s \\\n' \
      "$COMPOSE_PROJECT" "${ODOO_HTTP_PORT:-8069}" "${ODOO_GEVENT_PORT:-8072}"
    printf '      POCKET_ID_HTTP_PORT=%s PAPERLESS_HTTP_PORT=%s repair-pocket-id\n' \
      "${POCKET_ID_HTTP_PORT:-1411}" "${PAPERLESS_HTTP_PORT:-8010}"
  fi
}

reclaim_development_project() {
  local confirmation="${USL_DEV_RECLAIM_CONFIRM:-}"
  local unsafe_resources initial_ids current_ids

  if [[ -f "$ROOT/.git" ]]; then
    usl_cli_blocked \
      "A linked worktree cannot reclaim the canonical development project." \
      "Canonical ownership belongs exclusively to the main checkout." \
      "Use a dedicated COMPOSE_PROJECT and non-conflicting ports." \
      "Run: make doctor"
    return 2
  fi
  if ! is_canonical_target; then
    usl_cli_blocked \
      "Reclaim is restricted to canonical project $CANONICAL_COMPOSE_PROJECT and database odoo_dev." \
      "Selected project/database: $COMPOSE_PROJECT / $DEV_DB" \
      "Run: make doctor"
    return 2
  fi

  usl_cli_title "Reclaim development containers"
  print_command_context
  usl_print_compose_inventory "$COMPOSE_PROJECT" "$ROOT"
  case "$USL_COMPOSE_SCOPE_STATE" in
    unused|owned)
      usl_cli_success "the canonical project is already available to this checkout."
      printf 'Next: make dev\n'
      return 0
      ;;
    unavailable)
      usl_cli_blocked \
        "The canonical project cannot be inspected." \
        "Docker is unavailable or the current user cannot access it." \
        "Start Docker, then run: make doctor"
      return 2
      ;;
  esac

  unsafe_resources="$(usl_compose_active_unsafe_resources)"
  if [[ -n "$unsafe_resources" ]]; then
    usl_cli_blocked \
      "An active migration, test, or one-shot initialization is using the project." \
      "These active services must finish before containers can be replaced:
$(usl_format_compose_resources "$unsafe_resources")" \
      "Wait for that operation or stop it from its owning checkout, then run make doctor."
    return 2
  fi
  if [[ "$confirmation" != "$COMPOSE_PROJECT" ]]; then
    usl_cli_blocked \
      "Reclaim requires explicit confirmation." \
      "This stops and recreates project containers; named volumes and data are preserved." \
      "Run: make dev-reclaim CONFIRM=$COMPOSE_PROJECT"
    return 2
  fi

  initial_ids="$(
    printf '%s\n' "$USL_COMPOSE_SCOPE_RESOURCES" \
      | awk -F'|' 'NF {print $1}' | sort
  )"
  usl_compose_scope_scan "$COMPOSE_PROJECT" "$ROOT"
  unsafe_resources="$(usl_compose_active_unsafe_resources)"
  if [[ -n "$unsafe_resources" ]]; then
    usl_cli_blocked \
      "A migration, test, or one-shot operation started during the safety check." \
      "These active services must finish before containers can be replaced:
$(usl_format_compose_resources "$unsafe_resources")" \
      "Wait for that operation or stop it from its owning checkout, then run make doctor."
    return 2
  fi
  current_ids="$(
    printf '%s\n' "$USL_COMPOSE_SCOPE_RESOURCES" \
      | awk -F'|' 'NF {print $1}' | sort
  )"
  if [[ "$initial_ids" != "$current_ids" ]]; then
    usl_cli_blocked \
      "Compose resources changed while preparing the reclaim." \
      "Another operation created or removed a container during the safety check." \
      "Run make doctor and retry after the other operation finishes."
    return 2
  fi

  usl_cli_step "1/3" "Remove project containers only"
  printf 'Named volumes, databases, filestores, archives, images, and dumps are preserved.\n'
  usl_remove_compose_containers
  usl_cli_step "2/3" "Recreate the canonical runtime from this checkout"
  "${ODOO_DEV_RUNTIME_STARTER:-$ROOT/scripts/pocket-id-dev}" start-runtime
  usl_cli_step "3/3" "Verify ownership"
  usl_compose_scope_scan "$COMPOSE_PROJECT" "$ROOT"
  if [[ "$USL_COMPOSE_SCOPE_STATE" != "owned" ]]; then
    printf 'Reclaim completed, but ownership verification is %s.\n' \
      "$USL_COMPOSE_SCOPE_STATE" >&2
    return 1
  fi
  usl_cli_success "canonical containers now belong to $(current_branch)."
  printf 'Next: make deploy\n'
}

is_canonical_target() {
  [[ "$DEV_DB" == "odoo_dev" \
    && "$COMPOSE_PROJECT" == "$CANONICAL_COMPOSE_PROJECT" ]]
}

pocket_id_env_project() {
  local env_file="${POCKET_ID_ENV_FILE:-$ROOT/.pocket-id.env}"
  [[ -f "$env_file" ]] || return 1
  awk -F= '$1 == "COMPOSE_PROJECT_NAME" {print substr($0, index($0, "=") + 1); exit}' \
    "$env_file"
}

uses_pocket_id_runtime() {
  local configured_project
  [[ "$DEV_DB" == "odoo_dev" ]] || return 1
  is_canonical_target && return 0
  # Every linked worktree owns an isolated, SSO-governed odoo_dev. Requiring
  # its project-bound environment prevents a plain Compose restart from
  # silently stripping Pocket ID credentials from the Odoo container.
  [[ -f "$ROOT/.git" ]] && return 0
  configured_project="$(pocket_id_env_project 2>/dev/null || true)"
  [[ -n "$configured_project" && "$configured_project" == "$COMPOSE_PROJECT" ]]
}

restore_development_runtime() {
  if uses_pocket_id_runtime; then
    "$ROOT/scripts/pocket-id-dev" start-runtime
  else
    "${COMPOSE[@]}" up -d --wait odoo
    print_url
  fi
}

verify_runtime_database_filter() {
  local runtime_filter
  runtime_filter="$(
    "${COMPOSE[@]}" exec -T odoo sh -lc \
      "sed -n 's/^dbfilter[[:space:]]*=[[:space:]]*//p' /etc/odoo/odoo.conf" \
      | tr -d '\r' \
      | tail -n 1
  )"
  if [[ "$runtime_filter" != "$ODOO_DB_FILTER" ]]; then
    printf \
      'Development server database filter mismatch: expected %s, found %s\n' \
      "$ODOO_DB_FILTER" "${runtime_filter:-<empty>}" >&2
    return 1
  fi
}

print_url() {
  local published_port
  verify_runtime_database_filter
  published_port="$("${COMPOSE[@]}" port odoo 8069 2>/dev/null | tail -n 1)"
  published_port="${published_port##*:}"
  published_port="${published_port:-8069}"
  printf '\nDevelopment environment: http://localhost:%s/web/login?db=%s\n' \
    "$published_port" "$DEV_DB"
}

disable_dev_tours() {
  "${COMPOSE[@]}" exec -T \
    -e USL_DISABLE_DEV_TOURS=1 \
    odoo odoo shell \
    --config=/etc/odoo/odoo.conf \
    --database="$DEV_DB" < "$ROOT/scripts/odoo/disable_dev_tours.py"
}

sync_product_french_translations() {
  local catalogue relative
  local -a catalogues=()
  while IFS= read -r catalogue; do
    relative="${catalogue#"$ROOT/custom-addons/"}"
    catalogues+=("/mnt/custom-addons/$relative")
  done < <(find "$ROOT/custom-addons" -mindepth 3 -maxdepth 3 -path '*/i18n/fr.po' -type f | sort)
  if ((${#catalogues[@]} == 0)); then
    printf 'No maintained French catalogues were found.\n' >&2
    return 1
  fi
  "${COMPOSE[@]}" exec -T odoo odoo i18n import \
    --config=/etc/odoo/odoo.conf \
    --database="$DEV_DB" \
    --language=fr \
    --overwrite \
    "${catalogues[@]}"
}

worktree_release_commit() {
  git diff --quiet --ignore-submodules -- \
    && git diff --cached --quiet --ignore-submodules -- \
    && [[ -z "$(git ls-files --others --exclude-standard)" ]] \
    && git rev-parse --verify HEAD
}

stamp_worktree_release_identity() {
  local release_commit=""
  if ! release_commit="$(worktree_release_commit)"; then
    printf 'The tracked worktree is dirty; clearing its feedback release identity.\n'
  fi
  "${COMPOSE[@]}" up -d --wait db
  "${COMPOSE[@]}" --profile init run --rm -T \
    -e ODOO_INIT_DB="$DEV_DB" \
    -e USL_DEPLOYMENT_ENV="${USL_DEPLOYMENT_ENV:-development}" \
    -e USL_EINVOICE_LIVE_ENABLED="${USL_EINVOICE_LIVE_ENABLED:-0}" \
    -e USL_EREPORTING_LIVE_ENABLED="${USL_EREPORTING_LIVE_ENABLED:-0}" \
    -e USL_WORKTREE_RELEASE_COMMIT="$release_commit" \
    init-db odoo shell \
    --config=/etc/odoo/odoo.conf \
    --database="$DEV_DB" \
    < "$ROOT/scripts/odoo/worktree_release_identity.py"
}

deploy() {
  local module="${1:-$DEV_MODULE}"
  local update_step="${2:-1/2}"
  local settings_step="${3:-2/2}"
  local update_modules="$module"
  if [[ "$module" == "rebuild_account_migration" ]]; then
    update_modules="usl_accounting,rebuild_account_migration,usl_access_control,usl_documents,usl_documents_accounting,usl_tese_payroll,usl_tese_accounting"
  fi
  usl_cli_step "$update_step" "Update Odoo modules: $update_modules"
  if is_canonical_target; then
    "$ROOT/scripts/pocket-id-dev" configure-odoo "$update_modules"
    usl_cli_step "$settings_step" "Apply local QA preferences and maintained French translations"
    sync_product_french_translations
    disable_dev_tours
    stamp_worktree_release_identity
    usl_cli_success "modules updated and the development runtime is healthy."
    return
  fi
  if uses_pocket_id_runtime; then
    "$ROOT/scripts/pocket-id-dev" update-odoo "$update_modules"
    usl_cli_step "$settings_step" "Apply local QA preferences"
    disable_dev_tours
    stamp_worktree_release_identity
    usl_cli_success "modules updated and the isolated SSO runtime is healthy."
    return
  fi
  "${COMPOSE[@]}" up -d --wait db
  "${COMPOSE[@]}" stop odoo >/dev/null 2>&1 || true
  "${COMPOSE[@]}" --profile init run --rm \
    -e ODOO_INIT_DB="$DEV_DB" \
    init-db odoo \
    --config=/etc/odoo/odoo.conf \
    --database="$DEV_DB" \
    --update="$update_modules" \
    --without-demo=true \
    --stop-after-init \
    --log-level=warn
  "${COMPOSE[@]}" up -d --force-recreate --wait odoo
  usl_cli_step "$settings_step" "Apply local QA preferences and maintained French translations"
  sync_product_french_translations
  disable_dev_tours
  stamp_worktree_release_identity
  print_url
  usl_cli_success "modules updated and the development runtime is healthy."
}

run_with_odoo_stopped() {
  local profile="$1"
  local service="$2"
  shift 2
  local status=0
  "${COMPOSE[@]}" up -d --wait db
  "${COMPOSE[@]}" stop odoo >/dev/null 2>&1 || true
  "${COMPOSE[@]}" --profile "$profile" run --rm \
    -e ODOO_INIT_DB="$DEV_DB" "$service" "$@" || status=$?
  restore_development_runtime
  return "$status"
}

verify_platform_billing_qa_scope() {
  if [[ "$COMPOSE_PROJECT" != usl-odoo-fp-* ]]; then
    printf \
      'Platform Billing QA requires a dedicated usl-odoo-fp-* project; got %s.\n' \
      "$COMPOSE_PROJECT" >&2
    return 2
  fi
  if [[ "${COMPOSE_PROJECT_NAME:-}" != "$COMPOSE_PROJECT" ]]; then
    printf \
      'Platform Billing QA requires COMPOSE_PROJECT_NAME=%s for Pocket ID; got %s.\n' \
      "$COMPOSE_PROJECT" "${COMPOSE_PROJECT_NAME:-<unset>}" >&2
    return 2
  fi

  local container_id project_label working_dir_label
  while IFS= read -r container_id; do
    [[ -z "$container_id" ]] && continue
    project_label="$(
      docker inspect --format \
        '{{ index .Config.Labels "com.docker.compose.project" }}' \
        "$container_id"
    )"
    working_dir_label="$(
      docker inspect --format \
        '{{ index .Config.Labels "com.docker.compose.project.working_dir" }}' \
        "$container_id"
    )"
    if [[ "$project_label" != "$COMPOSE_PROJECT" \
        || "$working_dir_label" != "$ROOT" ]]; then
      printf \
        'Platform Billing QA scope mismatch on container %s.\n' \
        "$container_id" >&2
      return 2
    fi
  done < <(
    docker ps -aq \
      --filter "label=com.docker.compose.project=$COMPOSE_PROJECT"
  )
}

platform_billing_compose() {
  verify_platform_billing_qa_scope
  "${COMPOSE[@]}" "$@"
}

test_js() {
  local module="${1:-$DEV_MODULE}"
  "${COMPOSE[@]}" --profile test build test
  run_with_odoo_stopped test test odoo \
    --config=/etc/odoo/odoo.conf \
    --database="$DEV_DB" \
    --test-tags="/${module}:WebSuite.test_unit_desktop" \
    --stop-after-init \
    --log-level=test
}

ensure_sign_test_services() {
  if [[ ! -f "$ROOT/.secrets/sign/odoo.env" ]]; then
    printf '%s\n' \
      'Sign test secrets are missing. Run scripts/sign-services-bootstrap first.' \
      >&2
    return 2
  fi
  "${COMPOSE[@]}" --profile sign up -d --wait \
    usl-sign-step-ca usl-sign-dss
}

test_tag() {
  local test_tag="$1"
  if [[ "$test_tag" == *usl_sign* ]]; then
    ensure_sign_test_services
  fi
  "${COMPOSE[@]}" --profile test build test
  run_with_odoo_stopped test test odoo \
    --config=/etc/odoo/odoo.conf \
    --database="$DEV_DB" \
    --test-enable \
    --test-tags="$test_tag" \
    --stop-after-init \
    --log-level=test
}

audit_platform_billing_qa() {
  local status=0
  platform_billing_compose up -d --wait db
  platform_billing_compose stop odoo >/dev/null 2>&1 || true
  platform_billing_compose --profile init run --rm -T \
    -e ODOO_INIT_DB="$DEV_DB" \
    init-db odoo shell \
    --config=/etc/odoo/odoo.conf \
    --database="$DEV_DB" < "$ROOT/scripts/odoo/platform_billing_qa_audit.py" \
    || status=$?
  verify_platform_billing_qa_scope
  restore_development_runtime
  return "$status"
}

bootstrap_einvoice_qa() {
  local status=0
  "${COMPOSE[@]}" up -d --wait db
  "${COMPOSE[@]}" stop odoo >/dev/null 2>&1 || true
  "${COMPOSE[@]}" --profile init run --rm -T \
    -e ODOO_INIT_DB="$DEV_DB" \
    -e USL_EINVOICE_QA_BOOTSTRAP=1 \
    init-db odoo shell \
    --config=/etc/odoo/odoo.conf \
    --database="$DEV_DB" < "$ROOT/scripts/odoo/einvoice_qa_bootstrap.py" \
    || status=$?
  restore_development_runtime
  if ((status)); then
    return "$status"
  fi
  printf '\nFrench e-invoicing QA is ready but inactive.\n'
  printf 'Manager: qa.manager / admin\n'
  printf 'Read-only: qa.reviewer / admin\n'
}

bootstrap_platform_billing_qa() {
  local status=0
  platform_billing_compose up -d --wait db
  platform_billing_compose stop odoo >/dev/null 2>&1 || true
  platform_billing_compose --profile init run --rm -T \
    -e ODOO_INIT_DB="$DEV_DB" \
    -e USL_PLATFORM_BILLING_QA_BOOTSTRAP=1 \
    init-db odoo shell \
    --config=/etc/odoo/odoo.conf \
    --database="$DEV_DB" < "$ROOT/scripts/odoo/platform_billing_qa_bootstrap.py" \
    || status=$?
  verify_platform_billing_qa_scope
  restore_development_runtime
  if ((status)); then
    return "$status"
  fi
  printf '\nPlatform Billing QA demo is ready.\n'
  printf 'Named manager: valentin / existing Pocket ID sign-in\n'
  printf 'Manager: qa.platform.manager / qa-platform-manager\n'
  printf 'Operator: qa.platform.operator / qa-platform-operator\n'
  printf 'Reviewer: qa.platform.reviewer / qa-platform-reviewer\n'
  printf 'Accountant without app access: qa.platform.accountant / qa-platform-accountant\n'
}

bootstrap_expense_batch_qa() {
  local status=0
  if [[ "$DEV_DB" != "odoo_dev" ]]; then
    printf 'Expense Batch target QA requires database odoo_dev, got %s.\n' \
      "$DEV_DB" >&2
    return 2
  fi
  "${COMPOSE[@]}" up -d --wait db
  "${COMPOSE[@]}" stop odoo >/dev/null 2>&1 || true
  "${COMPOSE[@]}" --profile init run --rm -T \
    -e ODOO_INIT_DB="$DEV_DB" \
    -e USL_EXPENSE_BATCH_TARGET_QA_BOOTSTRAP=1 \
    -e USL_EINVOICE_LIVE_ENABLED=0 \
    -e USL_EREPORTING_LIVE_ENABLED=0 \
    init-db odoo shell \
    --config=/etc/odoo/odoo.conf \
    --database="$DEV_DB" < \
    "$ROOT/scripts/odoo/expense_batch_qa_bootstrap.py" \
    || status=$?
  restore_development_runtime
  if ((status)); then
    return "$status"
  fi
  printf '\nExpense Batch QA is ready.\n'
  printf 'Batch: QA — Mixed payment Batch\n'
  printf 'Use the configured Pocket ID users for role validation.\n'
}

configure_pocket_id() {
  local status=0
  if uses_pocket_id_runtime; then
    "$ROOT/scripts/pocket-id-dev" configure-odoo usl_pocketid
    return
  fi
  if [[ -z "${ODOO_DEV_DB:-}" \
      || "$DEV_DB" == "odoo_online_source_saas_19_3" ]]; then
    printf 'External Pocket ID configuration requires an explicit safe target.\n' >&2
    return 2
  fi
  if [[ "${USL_EINVOICE_LIVE_ENABLED:-0}" != "0" \
      || "${USL_EREPORTING_LIVE_ENABLED:-0}" != "0" ]]; then
    printf 'Pocket ID configuration requires both regulatory guards to be 0.\n' >&2
    return 2
  fi
  "${COMPOSE[@]}" up -d --wait db
  "${COMPOSE[@]}" stop odoo >/dev/null 2>&1 || true
  "${COMPOSE[@]}" --profile init run --rm -T \
    -e ODOO_INIT_DB="$DEV_DB" \
    init-db odoo shell \
    --config=/etc/odoo/odoo.conf \
    --database="$DEV_DB" < "$ROOT/scripts/odoo/pocket_id_configure.py" \
    || status=$?
  "${COMPOSE[@]}" up -d --force-recreate --wait odoo
  print_url
  return "$status"
}

repair_pocket_id() {
  if ! uses_pocket_id_runtime; then
    printf 'Pocket ID runtime repair is restricted to a governed odoo_dev.\n' >&2
    return 2
  fi
  "$ROOT/scripts/pocket-id-dev" repair-odoo
}

bootstrap_immediate_settlement_qa() {
  local status=0
  "${COMPOSE[@]}" up -d --wait db
  "${COMPOSE[@]}" stop odoo >/dev/null 2>&1 || true
  "${COMPOSE[@]}" --profile init run --rm -T \
    -e ODOO_INIT_DB="$DEV_DB" \
    -e USL_IMMEDIATE_SETTLEMENT_QA_BOOTSTRAP=1 \
    -e ODOO_IMMEDIATE_SETTLEMENT_QA_DATABASE="$DEV_DB" \
    init-db odoo shell \
    --config=/etc/odoo/odoo.conf \
    --database="$DEV_DB" < \
    "$ROOT/scripts/odoo/immediate_settlement_qa_bootstrap.py" \
    || status=$?
  restore_development_runtime
  if ((status)); then
    return "$status"
  fi
  printf '\nThree-Action Foreign-Currency Settlement QA is ready.\n'
  printf 'Accountant: qa.settlement / qa-settlement\n'
  printf 'Read-only: qa.viewer / qa-viewer\n'
}

bootstrap_tese_payroll_qa() {
  local generation="${1:-01}"
  local status=0
  case "$generation" in
    ""|*[!0-9]*)
      printf 'TESE QA generation must be numeric: %s\n' "$generation" >&2
      return 2
      ;;
  esac
  "${COMPOSE[@]}" up -d --wait db
  "${COMPOSE[@]}" stop odoo >/dev/null 2>&1 || true
  "${COMPOSE[@]}" --profile init run --rm -T \
    -e ODOO_INIT_DB="$DEV_DB" \
    -e USL_TESE_PAYROLL_QA_BOOTSTRAP=1 \
    -e USL_TESE_PAYROLL_QA_GENERATION="$generation" \
    -e ODOO_TESE_PAYROLL_QA_DATABASE="$DEV_DB" \
    -e USL_EINVOICE_LIVE_ENABLED=0 \
    -e USL_EREPORTING_LIVE_ENABLED=0 \
    init-db odoo shell \
    --config=/etc/odoo/odoo.conf \
    --database="$DEV_DB" < \
    "$ROOT/scripts/odoo/tese_payroll_qa_bootstrap.py" \
    || status=$?
  restore_development_runtime
  if ((status)); then
    return "$status"
  fi
  printf '\nPaie TESE QA generation %s is ready.\n' "$generation"
  printf 'Open Payroll Records and apply the saved QA TESE filter.\n'
}

bootstrap_sign_qa() {
  local module_state
  module_state="$(
    "${COMPOSE[@]}" exec -T db psql -U odoo -d "$DEV_DB" -Atc \
      "SELECT state FROM ir_module_module WHERE name = 'usl_sign'"
  )"
  if [[ "$module_state" != "installed" ]]; then
    "${COMPOSE[@]}" stop odoo >/dev/null 2>&1 || true
    "${COMPOSE[@]}" --profile init run --rm \
      -e ODOO_INIT_DB="$DEV_DB" \
      init-db odoo \
      --config=/etc/odoo/odoo.conf \
      --database="$DEV_DB" \
      --init=usl_sign \
      --without-demo=true \
      --stop-after-init \
      --log-level=warn
    restore_development_runtime
  fi
  "${COMPOSE[@]}" exec -T odoo odoo shell \
    --config=/etc/odoo/odoo.conf \
    --database="$DEV_DB" < "$ROOT/scripts/odoo/sign_qa_bootstrap.py"
}

cleanup_test_database() {
  local database="$1"
  case "$database" in
    ""|"$DEV_DB"|*[!A-Za-z0-9_]*)
      printf 'Refusing to clean unsafe test database name: %s\n' "$database" >&2
      return 2
      ;;
  esac
  "${COMPOSE[@]}" up -d --wait db
  "${COMPOSE[@]}" exec -T \
    -e TEST_DATABASE="$database" \
    db sh -c \
    'dropdb --if-exists --force -U "$POSTGRES_USER" "$TEST_DATABASE"'
  "${COMPOSE[@]}" --profile init run --rm \
    --entrypoint sh \
    -e TEST_DATABASE="$database" \
    init-db -c '
      directory="/var/lib/odoo/filestore/$TEST_DATABASE"
      if [ -d "$directory" ]; then
        find "$directory" -mindepth 1 -delete
        rmdir "$directory"
      fi
    '
}

cleanup_test_container() {
  local container="$1"
  docker rm --force "$container" >/dev/null 2>&1 || true
}

finish_module_test() {
  local database="$1"
  local container="$2"
  trap - EXIT INT TERM
  cleanup_test_container "$container"
  cleanup_test_database "$database"
  restore_development_runtime
}

test_module() {
  local module="$1"
  local database="$2"
  local container
  local status=0
  case "$module" in
    ""|*[!A-Za-z0-9_]*)
      printf 'Refusing unsafe test module name: %s\n' "$module" >&2
      return 2
      ;;
  esac
  case "$database" in
    ""|"$DEV_DB"|*[!A-Za-z0-9_]*)
      printf 'Refusing unsafe test database name: %s\n' "$database" >&2
      return 2
      ;;
  esac
  container="${COMPOSE_PROJECT}-test-${database}"
  trap 'finish_module_test "$database" "$container"' EXIT INT TERM
  if [[ "$module" == "usl_sign" ]]; then
    ensure_sign_test_services
  fi
  "${COMPOSE[@]}" --profile test build test
  cleanup_test_container "$container"
  cleanup_test_database "$database"
  "${COMPOSE[@]}" stop odoo >/dev/null 2>&1 || true
  "${COMPOSE[@]}" --profile test run --rm \
    --name "$container" \
    -e ODOO_INIT_DB="$database" \
    -e ODOO_DB_FILTER="^${database}$" \
    test odoo \
    --config=/etc/odoo/odoo.conf \
    --database="$database" \
    --init="$module" \
    --without-demo=true \
    --test-enable \
    --test-tags="/$module" \
    --stop-after-init \
    --log-level=test || status=$?
  finish_module_test "$database" "$container"
  return "$status"
}

command_name="${1:-help}"
case "$command_name" in
  start) usl_cli_title "Start development"; print_command_context ;;
  deploy) usl_cli_title "Deploy add-ons"; print_command_context ;;
  stamp-release-identity) usl_cli_title "Record worktree release identity"; print_command_context ;;
  rebuild) usl_cli_title "Rebuild and deploy"; print_command_context ;;
  stop) usl_cli_title "Stop development"; print_command_context ;;
  restart) usl_cli_title "Restart services"; print_command_context ;;
  logs) usl_cli_title "Service logs"; print_command_context ;;
esac
if [[ "$command_name" != "help" \
    && "$command_name" != "doctor" \
    && "$command_name" != "status" \
    && "$command_name" != "reclaim" ]]; then
  usl_verify_compose_scope \
    "$COMPOSE_PROJECT" "$ROOT" "Odoo development helper"
fi

case "$command_name" in
  build)
    "${COMPOSE[@]}" build "${@:2}"
    ;;
  start)
    usl_cli_step "1/1" "Start Odoo, Pocket ID, and Paperless"
    if is_canonical_target; then
      "$ROOT/scripts/pocket-id-dev" configure-odoo usl_pocketid
    elif uses_pocket_id_runtime; then
      "$ROOT/scripts/pocket-id-dev" start-runtime
    else
      "${COMPOSE[@]}" up -d --wait db odoo
    fi
    disable_dev_tours
    print_url
    usl_cli_success "development services are ready."
    ;;
  deploy)
    deploy "${2:-$DEV_MODULE}" "1/2" "2/2"
    ;;
  stamp-release-identity)
    stamp_worktree_release_identity
    ;;
  rebuild)
    usl_cli_step "1/3" "Build the Odoo image"
    "${COMPOSE[@]}" build odoo
    deploy "${2:-$DEV_MODULE}" "2/3" "3/3"
    ;;
  stop)
    usl_cli_step "1/1" "Stop project containers without deleting data"
    if uses_pocket_id_runtime; then
      "$ROOT/scripts/pocket-id-dev" stop-stack
    else
      "${COMPOSE[@]}" down
    fi
    usl_cli_success "development services are stopped; volumes are preserved."
    ;;
  restart)
    usl_cli_step "1/1" "Restart selected services"
    if uses_pocket_id_runtime; then
      "$ROOT/scripts/pocket-id-dev" start-runtime
    else
      "${COMPOSE[@]}" restart "${@:2}"
    fi
    usl_cli_success "services restarted."
    ;;
  logs)
    if uses_pocket_id_runtime; then
      "$ROOT/scripts/pocket-id-dev" logs "${@:2}"
    else
      "${COMPOSE[@]}" logs -f "${@:2}"
    fi
    ;;
  init-db)
    "${COMPOSE[@]}" build odoo
    "${COMPOSE[@]}" --profile init run --rm init-db
    if uses_pocket_id_runtime; then
      "$ROOT/scripts/pocket-id-dev" configure-odoo usl_pocketid
    fi
    ;;
  shell)
    "${COMPOSE[@]}" --profile devcontainer run --rm devcontainer bash
    ;;
  test)
    module="${2:-base}"
    database="${3:-odoo_unit_test}"
    test_module "$module" "$database"
    ;;
  test-js)
    test_js "${2:-$DEV_MODULE}"
    ;;
  test-tag)
    test_tag "${2:?Usage: scripts/odoo-dev test-tag TEST_TAG}"
    ;;
  audit-platform-billing)
    audit_platform_billing_qa
    ;;
  bootstrap-einvoice-qa)
    bootstrap_einvoice_qa
    ;;
  bootstrap-platform-billing-qa)
    bootstrap_platform_billing_qa
    ;;
  bootstrap-expense-batch-qa)
    bootstrap_expense_batch_qa
    ;;
  configure-pocket-id)
    configure_pocket_id
    ;;
  repair-pocket-id)
    repair_pocket_id
    ;;
  disable-tours)
    disable_dev_tours
    ;;
  bootstrap-immediate-settlement-qa)
    bootstrap_immediate_settlement_qa
    ;;
  bootstrap-tese-payroll-qa)
    bootstrap_tese_payroll_qa "${2:-01}"
    ;;
  bootstrap-sign-qa)
    bootstrap_sign_qa
    ;;
  ruff)
    "${COMPOSE[@]}" --profile devcontainer run --rm devcontainer ruff check "${@:2}"
    ;;
  reset)
    if is_canonical_target; then
      "$ROOT/scripts/pocket-id-dev" stop-stack
    fi
    "${COMPOSE[@]}" down --volumes --remove-orphans
    ;;
  update)
    "${COMPOSE[@]}" pull db
    "${COMPOSE[@]}" build --pull
    ;;
  ps)
    doctor status
    ;;
  doctor)
    doctor doctor
    ;;
  status)
    doctor status
    ;;
  reclaim)
    reclaim_development_project
    ;;
  help|*)
    cat <<'EOF'
Usage: scripts/odoo-dev <command>

Commands:
  doctor       Explain checkout, project ownership, services, and next steps
  status       Show project ownership, service health, and local URLs
  reclaim      Recreate canonical containers after explicit confirmation
  build        Build Odoo images
  start        Start PostgreSQL and Odoo
  deploy [mod] Update a module and recreate the development server
  rebuild [mod] Rebuild images, update a module, and recreate the server
  stamp-release-identity
                Record the exact clean worktree commit for feedback submissions
  stop         Stop the stack
  restart      Restart services
  logs         Follow logs
  init-db      Initialize odoo_dev (or ODOO_INIT_DB)
  shell        Open a dev container shell
  test [mod]   Run full backend/browser tests for a module
  test-js [mod] Run one module's frontend unit tests on odoo_dev
  test-tag TAG  Run one installed backend/browser test tag on odoo_dev
  audit-platform-billing
                Audit the restored Platform Billing QA database
  bootstrap-einvoice-qa
                Prepare safe e-invoicing QA data and local test accounts
  bootstrap-platform-billing-qa
                Prepare deterministic Platform Billing QA records and users
  bootstrap-expense-batch-qa
                Prepare idempotent mixed-payer Expense Batch QA records
  configure-pocket-id
                Dry-run or apply Pocket ID environment and named-user policy
  repair-pocket-id
                Repair running Odoo/provider alignment without changing users
  disable-tours
                Disable automatic tours for internal dev/QA users
  bootstrap-immediate-settlement-qa
                Prepare three-action foreign-currency settlement QA cases
  bootstrap-tese-payroll-qa [generation]
                Seed synthetic Paie TESE journeys in the selected QA database
  bootstrap-sign-qa
                Assign local Sign roles and seed a synthetic Routine Agreement
  ruff [args]  Run ruff in the dev image
  update       Pull service images and rebuild
  reset        Stop and delete local volumes
  ps           Show service status
EOF
    ;;
esac
