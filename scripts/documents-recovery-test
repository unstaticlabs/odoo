#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

SOURCE_PROJECT="${USL_DOCUMENTS_COMPOSE_PROJECT:?Set the isolated source Compose project}"
SOURCE_DATABASE="${USL_DOCUMENTS_DATABASE:?Set the isolated source Odoo database}"
RESTORE_PROJECT="${USL_DOCUMENTS_RESTORE_PROJECT:?Set a new isolated restore Compose project}"
if [[ "${USL_DOCUMENTS_SYNTHETIC_RECOVERY:-0}" != "1" ]]; then
  printf 'Refusing unconfirmed recovery test; set USL_DOCUMENTS_SYNTHETIC_RECOVERY=1\n' >&2
  exit 2
fi
case "$SOURCE_DATABASE" in
  odoo_usl_documents_*_test|odoo_usl_documents_test) ;;
  *)
    printf 'Refusing non-QA source database: %s\n' "$SOURCE_DATABASE" >&2
    exit 2
    ;;
esac
case "$RESTORE_PROJECT" in
  "$SOURCE_PROJECT"|usl-odoo-saas-19-2|odoo|production|prod|*canonical*)
    printf 'Refusing unsafe restore project: %s\n' "$RESTORE_PROJECT" >&2
    exit 2
    ;;
esac
if docker ps -a --format '{{.Names}}' | grep -q "^${RESTORE_PROJECT}-"; then
  printf 'Restore project already exists; choose a new project name: %s\n' "$RESTORE_PROJECT" >&2
  exit 2
fi

SOURCE=(docker compose -p "$SOURCE_PROJECT")
RESTORE=(docker compose -p "$RESTORE_PROJECT")
SOURCE_ODOO_HTTP_PORT="${USL_DOCUMENTS_ODOO_HTTP_PORT:-18080}"
SOURCE_ODOO_GEVENT_PORT="${USL_DOCUMENTS_ODOO_GEVENT_PORT:-18072}"
SOURCE_PAPERLESS_HTTP_PORT="${USL_DOCUMENTS_PAPERLESS_HTTP_PORT:-8010}"
BACKUP_ID="documents-restore-$(date -u +%Y%m%dT%H%M%SZ)"
ARTIFACT_DIR="$(mktemp -d "/tmp/${BACKUP_ID}.XXXXXX")"
RESTORED_DATABASE="${SOURCE_DATABASE}_restored"
SOURCE_ODOO_VOLUME="${SOURCE_PROJECT}_odoo-data"
SOURCE_PAPERLESS_DATA_VOLUME="${SOURCE_PROJECT}_paperless-data"
SOURCE_PAPERLESS_MEDIA_VOLUME="${SOURCE_PROJECT}_paperless-media"
SOURCE_PAPERLESS_EXPORT_VOLUME="${SOURCE_PROJECT}_paperless-export"
RESTORE_ODOO_VOLUME="${RESTORE_PROJECT}_odoo-data"
RESTORE_PAPERLESS_DATA_VOLUME="${RESTORE_PROJECT}_paperless-data"
RESTORE_PAPERLESS_MEDIA_VOLUME="${RESTORE_PROJECT}_paperless-media"
RESTORE_PAPERLESS_EXPORT_VOLUME="${RESTORE_PROJECT}_paperless-export"

restore_source() {
  PAPERLESS_HTTP_PORT="$SOURCE_PAPERLESS_HTTP_PORT" \
    "${SOURCE[@]}" --profile paperless up -d --wait \
    paperless-preflight paperless-db paperless-broker paperless-gotenberg \
    paperless-tika paperless-webserver || true
  ODOO_HTTP_PORT="$SOURCE_ODOO_HTTP_PORT" \
    ODOO_GEVENT_PORT="$SOURCE_ODOO_GEVENT_PORT" \
    ODOO_DB_FILTER="^${SOURCE_DATABASE}$" \
    "${SOURCE[@]}" up -d --wait odoo || true
}
trap restore_source EXIT INT TERM

EXPECTED_DOCUMENTS="$("${SOURCE[@]}" exec -T db psql -U odoo -d "$SOURCE_DATABASE" -Atc 'SELECT count(*) FROM usl_document')"
EXPECTED_RELATIONSHIPS="$("${SOURCE[@]}" exec -T db psql -U odoo -d "$SOURCE_DATABASE" -Atc 'SELECT count(*) FROM usl_document_link WHERE active')"

"${SOURCE[@]}" exec -T paperless-webserver \
  mkdir -p "/usr/src/paperless/export/$BACKUP_ID"
"${SOURCE[@]}" exec -T paperless-webserver python manage.py document_exporter \
  "/usr/src/paperless/export/$BACKUP_ID"
"${SOURCE[@]}" stop odoo paperless-webserver
"${SOURCE[@]}" exec -T db pg_dump -U odoo -Fc "$SOURCE_DATABASE" > "$ARTIFACT_DIR/odoo.dump"
"${SOURCE[@]}" exec -T paperless-db pg_dump -U paperless -Fc paperless > "$ARTIFACT_DIR/paperless.dump"

docker run --rm -v "$SOURCE_ODOO_VOLUME:/source:ro" -v "$ARTIFACT_DIR:/backup" \
  alpine:3.22.1 tar -C /source -czf /backup/odoo-data.tgz .
docker run --rm -v "$SOURCE_PAPERLESS_DATA_VOLUME:/source:ro" -v "$ARTIFACT_DIR:/backup" \
  alpine:3.22.1 tar -C /source -czf /backup/paperless-data.tgz .
docker run --rm -v "$SOURCE_PAPERLESS_MEDIA_VOLUME:/source:ro" -v "$ARTIFACT_DIR:/backup" \
  alpine:3.22.1 tar -C /source -czf /backup/paperless-media.tgz .
docker run --rm -v "$SOURCE_PAPERLESS_EXPORT_VOLUME:/source:ro" -v "$ARTIFACT_DIR:/backup" \
  alpine:3.22.1 tar -C /source -czf /backup/paperless-export.tgz .
sha256sum "$ARTIFACT_DIR"/* > "$ARTIFACT_DIR/SHA256SUMS"
restore_source
"${SOURCE[@]}" --profile init run --rm -T \
  -e ODOO_INIT_DB="$SOURCE_DATABASE" \
  -e USL_BACKUP_ID="$BACKUP_ID" \
  -e USL_BACKUP_COMPLETION_STATUS="completed" \
  init-db odoo shell \
  --config=/etc/odoo/odoo.conf \
  --database="$SOURCE_DATABASE" \
  < "$ROOT/scripts/odoo/documents_integrity_manifest.py" \
  > "$ARTIFACT_DIR/integrity.json"
sha256sum "$ARTIFACT_DIR/integrity.json" >> "$ARTIFACT_DIR/SHA256SUMS"

export ODOO_HTTP_PORT="${USL_DOCUMENTS_RESTORE_ODOO_HTTP_PORT:-18180}"
export ODOO_GEVENT_PORT="${USL_DOCUMENTS_RESTORE_ODOO_GEVENT_PORT:-18172}"
export PAPERLESS_HTTP_PORT="${USL_DOCUMENTS_RESTORE_PAPERLESS_HTTP_PORT:-8020}"
export ODOO_DB_FILTER="^${RESTORED_DATABASE}$"

"${RESTORE[@]}" up -d --wait db
"${RESTORE[@]}" --profile paperless up -d --wait paperless-db paperless-broker
docker volume create "$RESTORE_ODOO_VOLUME" >/dev/null
docker volume create "$RESTORE_PAPERLESS_DATA_VOLUME" >/dev/null
docker volume create "$RESTORE_PAPERLESS_MEDIA_VOLUME" >/dev/null
docker volume create "$RESTORE_PAPERLESS_EXPORT_VOLUME" >/dev/null

docker run --rm -v "$RESTORE_ODOO_VOLUME:/target" -v "$ARTIFACT_DIR:/backup:ro" \
  alpine:3.22.1 tar -C /target -xzf /backup/odoo-data.tgz
docker run --rm -v "$RESTORE_ODOO_VOLUME:/target" alpine:3.22.1 \
  cp -a "/target/filestore/$SOURCE_DATABASE" \
  "/target/filestore/$RESTORED_DATABASE"
docker run --rm -v "$RESTORE_PAPERLESS_DATA_VOLUME:/target" -v "$ARTIFACT_DIR:/backup:ro" \
  alpine:3.22.1 tar -C /target -xzf /backup/paperless-data.tgz
docker run --rm -v "$RESTORE_PAPERLESS_MEDIA_VOLUME:/target" -v "$ARTIFACT_DIR:/backup:ro" \
  alpine:3.22.1 tar -C /target -xzf /backup/paperless-media.tgz
docker run --rm -v "$RESTORE_PAPERLESS_EXPORT_VOLUME:/target" -v "$ARTIFACT_DIR:/backup:ro" \
  alpine:3.22.1 tar -C /target -xzf /backup/paperless-export.tgz

"${RESTORE[@]}" exec -T db createdb -U odoo "$RESTORED_DATABASE"
"${RESTORE[@]}" exec -T db pg_restore -U odoo -d "$RESTORED_DATABASE" \
  --no-owner --no-privileges < "$ARTIFACT_DIR/odoo.dump"
"${RESTORE[@]}" exec -T paperless-db pg_restore -U paperless -d paperless \
  --clean --if-exists --no-owner --no-privileges < "$ARTIFACT_DIR/paperless.dump"

# Prove Odoo can recover and remain healthy before Paperless is started.
"${RESTORE[@]}" up -d --wait odoo
curl --fail --silent \
  "http://127.0.0.1:${ODOO_HTTP_PORT}/web/health?db_server_status=1" >/dev/null

# Prove Paperless can recover independently, then validate cross-system links.
"${RESTORE[@]}" --profile paperless up -d --wait \
  paperless-preflight paperless-db paperless-broker paperless-gotenberg \
  paperless-tika paperless-webserver
curl --fail --silent "http://127.0.0.1:${PAPERLESS_HTTP_PORT}/api/" >/dev/null
"${RESTORE[@]}" stop odoo >/dev/null
"${RESTORE[@]}" --profile init run --rm -T \
  -e ODOO_INIT_DB="$RESTORED_DATABASE" \
  -e USL_EXPECTED_DOCUMENT_COUNT="$EXPECTED_DOCUMENTS" \
  -e USL_EXPECTED_RELATIONSHIP_COUNT="$EXPECTED_RELATIONSHIPS" \
  -e USL_BACKUP_ID="$BACKUP_ID" \
  init-db odoo shell \
  --config=/etc/odoo/odoo.conf \
  --database="$RESTORED_DATABASE" < "$ROOT/scripts/odoo/documents_restore_acceptance.py"
"${RESTORE[@]}" up -d --wait odoo

trap - EXIT INT TERM
printf 'DOCUMENTS_RECOVERY_TEST_OK backup=%s artifacts=%s restore_project=%s database=%s\n' \
  "$BACKUP_ID" "$ARTIFACT_DIR" "$RESTORE_PROJECT" "$RESTORED_DATABASE"
