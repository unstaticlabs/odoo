#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
# shellcheck source=scripts/lib/ollama-runtime.sh
source "$ROOT/scripts/lib/ollama-runtime.sh"

ENVIRONMENT="${1:-qa}"
case "$ENVIRONMENT" in
  qa)
    qa_override="${USL_DOCUMENTS_QA_ISOLATED_OVERRIDE:-0}"
    case "$qa_override" in
      0|1) ;;
      *)
        printf 'USL_DOCUMENTS_QA_ISOLATED_OVERRIDE must be 0 or 1.\n' >&2
        exit 2
        ;;
    esac
    if [[ "$qa_override" = 0 ]] \
      && [[ -n "${USL_DOCUMENTS_QA_ENV:-}" \
        || -n "${USL_DOCUMENTS_QA_SSO_ENV:-}" \
        || -n "${USL_DOCUMENTS_QA_PROJECT:-}" \
        || -n "${USL_DOCUMENTS_QA_DB:-}" ]]; then
      printf 'QA scope overrides require USL_DOCUMENTS_QA_ISOLATED_OVERRIDE=1.\n' >&2
      exit 2
    fi
    ENV_FILE="${USL_DOCUMENTS_QA_ENV:-$ROOT/deploy/documents/qa.env}"
    SSO_ENV_FILE="${USL_DOCUMENTS_QA_SSO_ENV:-$ROOT/.documents-qa-sso.env}"
    [[ -f "$ENV_FILE" ]] || {
      printf 'Documents QA environment is missing: %s\n' "$ENV_FILE" >&2
      exit 2
    }
    if [[ -n "${USL_DOCUMENTS_QA_SSO_ENV:-}" ]]; then
      [[ -f "$SSO_ENV_FILE" ]] || {
        printf 'Documents QA SSO environment is missing: %s\n' "$SSO_ENV_FILE" >&2
        exit 2
      }
    else
      python3 "$ROOT/scripts/documents_sso_env.py" "$SSO_ENV_FILE" >/dev/null
    fi
    OVERRIDE="$ROOT/compose.documents.qa.yaml"
    SOURCE_PROJECT="${USL_DOCUMENTS_QA_PROJECT:-codex-paperless-docs}"
    SOURCE_DATABASE="${USL_DOCUMENTS_QA_DB:-odoo_usl_documents_test}"
    ;;
  preprod)
    ENV_FILE="${USL_DOCUMENTS_PREPROD_ENV:-}"
    [[ -n "$ENV_FILE" && -f "$ENV_FILE" ]] || {
      printf 'Set USL_DOCUMENTS_PREPROD_ENV to the populated pre-production env file.\n' >&2
      exit 2
    }
    SSO_ENV_FILE=""
    OVERRIDE="$ROOT/compose.documents.preprod.yaml"
    SOURCE_PROJECT="${USL_DOCUMENTS_PREPROD_PROJECT:-usl-documents-preprod}"
    SOURCE_DATABASE="${USL_DOCUMENTS_PREPROD_DB:-odoo_usl_documents_preprod}"
    ;;
  *)
    printf 'Usage: scripts/documents-recovery-test <qa|preprod>\n' >&2
    exit 2
    ;;
esac
LOCAL_DEV_RECOVERY=0
if [[ "$ENVIRONMENT" = "preprod" \
    && "${USL_DOCUMENTS_LOCAL_PREPROD_RECOVERY:-0}" = "1" \
    && ( "$SOURCE_PROJECT" = usl-odoo-paperless-* \
      || "$SOURCE_PROJECT" = usl-odoo-qa-migration-* ) ]]; then
  LOCAL_DEV_RECOVERY=1
fi
RESTORE_PROJECT="${USL_DOCUMENTS_RESTORE_PROJECT:-${SOURCE_PROJECT}-restore-$(date -u +%Y%m%d%H%M%S)}"
if [[ "${USL_DOCUMENTS_SYNTHETIC_RECOVERY:-0}" != "1" ]]; then
  printf 'Refusing unconfirmed recovery test; set USL_DOCUMENTS_SYNTHETIC_RECOVERY=1\n' >&2
  exit 2
fi
case "$SOURCE_DATABASE" in
  ""|*[!A-Za-z0-9_]*)
    printf 'Refusing unsafe source database: %s\n' "$SOURCE_DATABASE" >&2
    exit 2
    ;;
  odoo_dev)
    if [[ "$ENVIRONMENT" != "preprod" \
        || "${USL_DOCUMENTS_ALLOW_ODOO_DEV_RECOVERY:-0}" != "1" \
        || "${USL_DOCUMENTS_LOCAL_PREPROD_RECOVERY:-0}" != "1" \
        || ( "$SOURCE_PROJECT" != usl-odoo-preprod-* \
          && "$SOURCE_PROJECT" != usl-odoo-paperless-* \
          && "$SOURCE_PROJECT" != usl-odoo-qa-migration-* ) ]]; then
      printf 'Refusing unsafe source database: %s\n' "$SOURCE_DATABASE" >&2
      exit 2
    fi
    ;;
esac
case "$RESTORE_PROJECT" in
  "$SOURCE_PROJECT"|usl-odoo-saas-19-3|odoo|production|prod|*canonical*)
    printf 'Refusing unsafe restore project: %s\n' "$RESTORE_PROJECT" >&2
    exit 2
    ;;
esac
if docker ps -a --format '{{.Names}}' | grep -q "^${RESTORE_PROJECT}-"; then
  printf 'Restore project already exists; choose a new project name: %s\n' "$RESTORE_PROJECT" >&2
  exit 2
fi

scripts/documents-stack "$ENVIRONMENT" preflight
usl_prepare_ollama_runtime "$ROOT"
SOURCE_ENV_FILES=(--env-file "$ENV_FILE")
if [[ -n "$SSO_ENV_FILE" ]]; then
  SOURCE_ENV_FILES+=(--env-file "$SSO_ENV_FILE")
fi
SOURCE_OVERRIDE=()
RESTORE_OVERRIDE=()
if [[ "$LOCAL_DEV_RECOVERY" = "0" ]]; then
  SOURCE_OVERRIDE=(-f "$OVERRIDE")
  RESTORE_OVERRIDE=(-f "$OVERRIDE")
fi
if [[ -n "$USL_OLLAMA_COMPOSE_OVERRIDE" ]]; then
  SOURCE_OVERRIDE+=(-f "$USL_OLLAMA_COMPOSE_OVERRIDE")
  RESTORE_OVERRIDE+=(-f "$USL_OLLAMA_COMPOSE_OVERRIDE")
fi
SOURCE=(
  docker compose
  "${SOURCE_ENV_FILES[@]}"
  -p "$SOURCE_PROJECT"
  -f "$ROOT/compose.yaml"
  -f "$ROOT/compose.pocket-id.yaml"
  "${SOURCE_OVERRIDE[@]}"
  --profile paperless
)
RESTORE=(
  docker compose
  --env-file "$ENV_FILE"
  -p "$RESTORE_PROJECT"
  -f "$ROOT/compose.yaml"
  "${RESTORE_OVERRIDE[@]}"
  --profile paperless
)
SOURCE_ODOO_HTTP_PORT="$(
  sed -n 's/^ODOO_HTTP_PORT=//p' "$ENV_FILE" | tail -n 1
)"
SOURCE_ODOO_GEVENT_PORT="$(
  sed -n 's/^ODOO_GEVENT_PORT=//p' "$ENV_FILE" | tail -n 1
)"
SOURCE_PAPERLESS_HTTP_PORT="$(
  sed -n 's/^PAPERLESS_HTTP_PORT=//p' "$ENV_FILE" | tail -n 1
)"
SOURCE_PAPERLESS_PUBLIC_URL="$(
  sed -n 's/^PAPERLESS_PUBLIC_URL=//p' "$ENV_FILE" | tail -n 1
)"
SOURCE_PAPERLESS_PUBLIC_BASE_URL="$(
  if [[ -n "$SSO_ENV_FILE" ]]; then
    sed -n 's/^PAPERLESS_PUBLIC_BASE_URL=//p' \
      "$ENV_FILE" "$SSO_ENV_FILE" | tail -n 1
  else
    sed -n 's/^PAPERLESS_PUBLIC_BASE_URL=//p' "$ENV_FILE" | tail -n 1
  fi
)"
SOURCE_PAPERLESS_PUBLIC_BASE_URL="$(
  printf '%s' "${SOURCE_PAPERLESS_PUBLIC_BASE_URL:-$SOURCE_PAPERLESS_PUBLIC_URL}"
)"
SOURCE_PAPERLESS_CORS_ALLOWED_HOSTS="$(
  sed -n 's/^PAPERLESS_CORS_ALLOWED_HOSTS=//p' "$ENV_FILE" | tail -n 1
)"
SOURCE_PAPERLESS_CSRF_TRUSTED_ORIGINS="$(
  sed -n 's/^PAPERLESS_CSRF_TRUSTED_ORIGINS=//p' "$ENV_FILE" | tail -n 1
)"
if [[ "${USL_DOCUMENTS_LOCAL_PREPROD_RECOVERY:-0}" = "1" ]]; then
  SOURCE_ODOO_HTTP_PORT="${ODOO_HTTP_PORT:-$SOURCE_ODOO_HTTP_PORT}"
  SOURCE_ODOO_GEVENT_PORT="${ODOO_GEVENT_PORT:-$SOURCE_ODOO_GEVENT_PORT}"
  SOURCE_PAPERLESS_HTTP_PORT="${PAPERLESS_HTTP_PORT:-$SOURCE_PAPERLESS_HTTP_PORT}"
  SOURCE_PAPERLESS_PUBLIC_URL="${PAPERLESS_PUBLIC_URL:-$SOURCE_PAPERLESS_PUBLIC_URL}"
  SOURCE_PAPERLESS_PUBLIC_BASE_URL="${PAPERLESS_PUBLIC_BASE_URL:-$SOURCE_PAPERLESS_PUBLIC_BASE_URL}"
  SOURCE_PAPERLESS_CORS_ALLOWED_HOSTS="${PAPERLESS_CORS_ALLOWED_HOSTS:-$SOURCE_PAPERLESS_CORS_ALLOWED_HOSTS}"
  SOURCE_PAPERLESS_CSRF_TRUSTED_ORIGINS="${PAPERLESS_CSRF_TRUSTED_ORIGINS:-$SOURCE_PAPERLESS_CSRF_TRUSTED_ORIGINS}"
fi
BACKUP_ID="documents-restore-$(date -u +%Y%m%dT%H%M%SZ)"
PRESERVE_RECOVERY="${USL_DOCUMENTS_PRESERVE_RECOVERY:-0}"
[[ "$PRESERVE_RECOVERY" =~ ^[01]$ ]] || {
  printf 'USL_DOCUMENTS_PRESERVE_RECOVERY must be 0 or 1.\n' >&2
  exit 2
}
ARTIFACT_DIR="$(mktemp -d "/tmp/${BACKUP_ID}.XXXXXX")"
RESTORED_DATABASE="${SOURCE_DATABASE}_restored"
SOURCE_ODOO_VOLUME="${SOURCE_PROJECT}_odoo-data"
SOURCE_PAPERLESS_DATA_VOLUME="${SOURCE_PROJECT}_paperless-data"
SOURCE_PAPERLESS_MEDIA_VOLUME="${SOURCE_PROJECT}_paperless-media"
SOURCE_PAPERLESS_EXPORT_VOLUME="${SOURCE_PROJECT}_paperless-export"
SOURCE_PAPERLESS_TRASH_VOLUME="${SOURCE_PROJECT}_paperless-trash"
SOURCE_PAPERLESS_OLLAMA_VOLUME="${SOURCE_PROJECT}_paperless-ollama-data"
RESTORE_ODOO_VOLUME="${RESTORE_PROJECT}_odoo-data"
RESTORE_PAPERLESS_DATA_VOLUME="${RESTORE_PROJECT}_paperless-data"
RESTORE_PAPERLESS_MEDIA_VOLUME="${RESTORE_PROJECT}_paperless-media"
RESTORE_PAPERLESS_EXPORT_VOLUME="${RESTORE_PROJECT}_paperless-export"
RESTORE_PAPERLESS_TRASH_VOLUME="${RESTORE_PROJECT}_paperless-trash"
RESTORE_PAPERLESS_OLLAMA_VOLUME="${RESTORE_PROJECT}_paperless-ollama-data"
NATIVE_OLLAMA_MANIFEST=""
if [[ "$USL_OLLAMA_RUNTIME_SELECTED" = native ]]; then
  NATIVE_OLLAMA_MANIFEST="${OLLAMA_MODELS:-${HOME}/.ollama/models}/manifests/registry.ollama.ai/library/usl-bge-m3/documents-20260824-rc1"
fi

restore_source() {
  ODOO_HTTP_PORT="$SOURCE_ODOO_HTTP_PORT" \
  ODOO_GEVENT_PORT="$SOURCE_ODOO_GEVENT_PORT" \
  ODOO_DB_NAME="$SOURCE_DATABASE" \
  ODOO_DB_FILTER="^${SOURCE_DATABASE}$" \
  PAPERLESS_HTTP_PORT="$SOURCE_PAPERLESS_HTTP_PORT" \
  PAPERLESS_PUBLIC_URL="$SOURCE_PAPERLESS_PUBLIC_URL" \
  PAPERLESS_PUBLIC_BASE_URL="$SOURCE_PAPERLESS_PUBLIC_BASE_URL" \
  PAPERLESS_CORS_ALLOWED_HOSTS="$SOURCE_PAPERLESS_CORS_ALLOWED_HOSTS" \
  PAPERLESS_CSRF_TRUSTED_ORIGINS="$SOURCE_PAPERLESS_CSRF_TRUSTED_ORIGINS" \
  "${SOURCE[@]}" up -d --wait --pull never \
    paperless-preflight paperless-db paperless-broker paperless-gotenberg \
    paperless-tika paperless-trash-init paperless-webserver
  "${SOURCE[@]}" run --rm --no-deps paperless-access-init
  ODOO_HTTP_PORT="$SOURCE_ODOO_HTTP_PORT" \
  ODOO_GEVENT_PORT="$SOURCE_ODOO_GEVENT_PORT" \
  ODOO_DB_NAME="$SOURCE_DATABASE" \
  ODOO_DB_FILTER="^${SOURCE_DATABASE}$" \
  PAPERLESS_HTTP_PORT="$SOURCE_PAPERLESS_HTTP_PORT" \
  PAPERLESS_PUBLIC_URL="$SOURCE_PAPERLESS_PUBLIC_URL" \
  PAPERLESS_PUBLIC_BASE_URL="$SOURCE_PAPERLESS_PUBLIC_BASE_URL" \
  PAPERLESS_CORS_ALLOWED_HOSTS="$SOURCE_PAPERLESS_CORS_ALLOWED_HOSTS" \
  PAPERLESS_CSRF_TRUSTED_ORIGINS="$SOURCE_PAPERLESS_CSRF_TRUSTED_ORIGINS" \
  "${SOURCE[@]}" up -d --wait --pull never odoo
}

cleanup_restore() {
  if ! restore_source; then
    printf 'WARNING: failed to restore the source Documents stack.\n' >&2
  fi
  if [[ "$PRESERVE_RECOVERY" = "1" ]]; then
    return
  fi
  "${RESTORE[@]}" down --volumes --remove-orphans >/dev/null 2>&1 || true
  local volume
  for volume in \
    "${RESTORE_PROJECT}_postgres-data" \
    "$RESTORE_ODOO_VOLUME" \
    "${RESTORE_PROJECT}_paperless-postgres-data" \
    "${RESTORE_PROJECT}_paperless-broker-data" \
    "$RESTORE_PAPERLESS_DATA_VOLUME" \
    "$RESTORE_PAPERLESS_MEDIA_VOLUME" \
    "${RESTORE_PROJECT}_paperless-consume" \
    "$RESTORE_PAPERLESS_EXPORT_VOLUME" \
    "$RESTORE_PAPERLESS_TRASH_VOLUME" \
    "$RESTORE_PAPERLESS_OLLAMA_VOLUME"
  do
    docker volume rm "$volume" >/dev/null 2>&1 || true
  done
  case "$ARTIFACT_DIR" in
    /tmp/documents-restore-*.??????)
      rm -rf -- "$ARTIFACT_DIR"
      ;;
    *)
      printf 'Refusing unsafe recovery artifact cleanup: %s\n' \
        "$ARTIFACT_DIR" >&2
      ;;
  esac
}
trap cleanup_restore EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

EXPECTED_DOCUMENTS="$("${SOURCE[@]}" exec -T db psql -U odoo -d "$SOURCE_DATABASE" -Atc 'SELECT count(*) FROM usl_document')"
EXPECTED_RELATIONSHIPS="$("${SOURCE[@]}" exec -T db psql -U odoo -d "$SOURCE_DATABASE" -Atc 'SELECT count(*) FROM usl_document_link WHERE active')"
EXPECTED_COMPANIES="$("${SOURCE[@]}" exec -T db psql -U odoo -d "$SOURCE_DATABASE" -Atc 'SELECT count(*) FROM res_company')"
EXPECTED_INTERNAL_USERS="$("${SOURCE[@]}" exec -T db psql -U odoo -d "$SOURCE_DATABASE" -Atc 'SELECT count(*) FROM res_users WHERE active AND NOT share')"
EXPECTED_MOVES="$("${SOURCE[@]}" exec -T db psql -U odoo -d "$SOURCE_DATABASE" -Atc 'SELECT count(*) FROM account_move')"
EXPECTED_MOVE_LINES="$("${SOURCE[@]}" exec -T db psql -U odoo -d "$SOURCE_DATABASE" -Atc 'SELECT count(*) FROM account_move_line')"
EXPECTED_POSTED_DEBIT="$("${SOURCE[@]}" exec -T db psql -U odoo -d "$SOURCE_DATABASE" -Atc "SELECT COALESCE(sum(line.debit), 0) FROM account_move_line line JOIN account_move move ON move.id = line.move_id WHERE move.state = 'posted'")"
EXPECTED_POSTED_CREDIT="$("${SOURCE[@]}" exec -T db psql -U odoo -d "$SOURCE_DATABASE" -Atc "SELECT COALESCE(sum(line.credit), 0) FROM account_move_line line JOIN account_move move ON move.id = line.move_id WHERE move.state = 'posted'")"

"${SOURCE[@]}" exec -T --user paperless paperless-webserver \
  mkdir -p "/usr/src/paperless/export/$BACKUP_ID"
"${SOURCE[@]}" exec -T --user paperless paperless-webserver \
  python manage.py document_exporter \
  "/usr/src/paperless/export/$BACKUP_ID"
"${SOURCE[@]}" stop odoo paperless-webserver
"${SOURCE[@]}" exec -T db pg_dump -U odoo -Fc "$SOURCE_DATABASE" > "$ARTIFACT_DIR/odoo.dump"
"${SOURCE[@]}" exec -T paperless-db pg_dump -U paperless -Fc paperless > "$ARTIFACT_DIR/paperless.dump"

docker run --rm -v "$SOURCE_ODOO_VOLUME:/source:ro" -v "$ARTIFACT_DIR:/backup" \
  alpine:3.22.1 tar -C /source -czf /backup/odoo-data.tgz .
docker run --rm -v "$SOURCE_PAPERLESS_DATA_VOLUME:/source:ro" -v "$ARTIFACT_DIR:/backup" \
  alpine:3.22.1 tar -C /source -czf /backup/paperless-data.tgz .
docker run --rm -v "$SOURCE_PAPERLESS_MEDIA_VOLUME:/source:ro" -v "$ARTIFACT_DIR:/backup" \
  alpine:3.22.1 tar -C /source -czf /backup/paperless-media.tgz .
docker run --rm -v "$SOURCE_PAPERLESS_EXPORT_VOLUME:/source:ro" -v "$ARTIFACT_DIR:/backup" \
  alpine:3.22.1 tar -C /source -czf /backup/paperless-export.tgz .
docker run --rm -v "$SOURCE_PAPERLESS_TRASH_VOLUME:/source:ro" -v "$ARTIFACT_DIR:/backup" \
  alpine:3.22.1 tar -C /source -czf /backup/paperless-trash.tgz .
if [[ "$USL_OLLAMA_RUNTIME_SELECTED" = container ]]; then
  docker run --rm -v "$SOURCE_PAPERLESS_OLLAMA_VOLUME:/source:ro" -v "$ARTIFACT_DIR:/backup" \
    alpine:3.22.1 tar -C /source -czf /backup/paperless-ollama-data.tgz .
else
  shasum -a 256 "$NATIVE_OLLAMA_MANIFEST" > "$ARTIFACT_DIR/native-ollama-manifest.sha256"
fi
sha256sum "$ARTIFACT_DIR"/* > "$ARTIFACT_DIR/SHA256SUMS"
restore_source
"${SOURCE[@]}" --profile init run --rm -T \
  -e ODOO_INIT_DB="$SOURCE_DATABASE" \
  -e USL_BACKUP_ID="$BACKUP_ID" \
  -e USL_BACKUP_COMPLETION_STATUS="completed" \
  init-db odoo shell \
  --config=/etc/odoo/odoo.conf \
  --database="$SOURCE_DATABASE" \
  < "$ROOT/scripts/odoo/documents_integrity_manifest.py" \
  > "$ARTIFACT_DIR/integrity.json"
sha256sum "$ARTIFACT_DIR/integrity.json" >> "$ARTIFACT_DIR/SHA256SUMS"
EXPECTED_SOURCE_INTEGRITY_OK="$(
  python3 -c \
    'import json, sys; print(int(bool(json.load(open(sys.argv[1]))["integrity_ok"])))' \
    "$ARTIFACT_DIR/integrity.json"
)"
EXPECTED_PERMISSION_SYNC_FAILURES="$(
  python3 -c \
    'import json, sys; print(",".join(map(str, sorted(json.load(open(sys.argv[1]))["permission_sync_failures"]))))' \
    "$ARTIFACT_DIR/integrity.json"
)"

export ODOO_HTTP_PORT="${USL_DOCUMENTS_RESTORE_ODOO_HTTP_PORT:-18180}"
export ODOO_GEVENT_PORT="${USL_DOCUMENTS_RESTORE_ODOO_GEVENT_PORT:-18172}"
export PAPERLESS_HTTP_PORT="${USL_DOCUMENTS_RESTORE_PAPERLESS_HTTP_PORT:-8020}"
export ODOO_DB_NAME="$RESTORED_DATABASE"
export ODOO_DB_FILTER="^${RESTORED_DATABASE}$"
export ODOO_INIT_DB="$RESTORED_DATABASE"
export PAPERLESS_PUBLIC_URL="http://127.0.0.1:${PAPERLESS_HTTP_PORT}"
export PAPERLESS_CORS_ALLOWED_HOSTS="$PAPERLESS_PUBLIC_URL"
export PAPERLESS_CSRF_TRUSTED_ORIGINS="$PAPERLESS_PUBLIC_URL"

"${RESTORE[@]}" up -d --wait db
"${RESTORE[@]}" up -d --wait --pull never paperless-db paperless-broker
docker volume create "$RESTORE_ODOO_VOLUME" >/dev/null
docker volume create "$RESTORE_PAPERLESS_DATA_VOLUME" >/dev/null
docker volume create "$RESTORE_PAPERLESS_MEDIA_VOLUME" >/dev/null
docker volume create "$RESTORE_PAPERLESS_EXPORT_VOLUME" >/dev/null
docker volume create "$RESTORE_PAPERLESS_TRASH_VOLUME" >/dev/null
if [[ "$USL_OLLAMA_RUNTIME_SELECTED" = container ]]; then
  docker volume create "$RESTORE_PAPERLESS_OLLAMA_VOLUME" >/dev/null
fi

docker run --rm -v "$RESTORE_ODOO_VOLUME:/target" -v "$ARTIFACT_DIR:/backup:ro" \
  alpine:3.22.1 tar -C /target -xzf /backup/odoo-data.tgz
docker run --rm -v "$RESTORE_ODOO_VOLUME:/target" alpine:3.22.1 \
  cp -a "/target/filestore/$SOURCE_DATABASE" \
  "/target/filestore/$RESTORED_DATABASE"
docker run --rm -v "$RESTORE_PAPERLESS_DATA_VOLUME:/target" -v "$ARTIFACT_DIR:/backup:ro" \
  alpine:3.22.1 tar -C /target -xzf /backup/paperless-data.tgz
docker run --rm -v "$RESTORE_PAPERLESS_MEDIA_VOLUME:/target" -v "$ARTIFACT_DIR:/backup:ro" \
  alpine:3.22.1 tar -C /target -xzf /backup/paperless-media.tgz
docker run --rm -v "$RESTORE_PAPERLESS_EXPORT_VOLUME:/target" -v "$ARTIFACT_DIR:/backup:ro" \
  alpine:3.22.1 tar -C /target -xzf /backup/paperless-export.tgz
docker run --rm -v "$RESTORE_PAPERLESS_TRASH_VOLUME:/target" -v "$ARTIFACT_DIR:/backup:ro" \
  alpine:3.22.1 tar -C /target -xzf /backup/paperless-trash.tgz
if [[ "$USL_OLLAMA_RUNTIME_SELECTED" = container ]]; then
  docker run --rm -v "$RESTORE_PAPERLESS_OLLAMA_VOLUME:/target" -v "$ARTIFACT_DIR:/backup:ro" \
    alpine:3.22.1 tar -C /target -xzf /backup/paperless-ollama-data.tgz
else
  shasum -a 256 -c "$ARTIFACT_DIR/native-ollama-manifest.sha256"
fi

"${RESTORE[@]}" exec -T db createdb -U odoo "$RESTORED_DATABASE"
"${RESTORE[@]}" exec -T db pg_restore -U odoo -d "$RESTORED_DATABASE" \
  --no-owner --no-privileges < "$ARTIFACT_DIR/odoo.dump"
"${RESTORE[@]}" exec -T paperless-db pg_restore -U paperless -d paperless \
  --clean --if-exists --no-owner --no-privileges < "$ARTIFACT_DIR/paperless.dump"

# Prove Odoo can recover and remain healthy before Paperless is started.
"${RESTORE[@]}" up -d --wait --pull never odoo
curl --fail --silent \
  "http://127.0.0.1:${ODOO_HTTP_PORT}/web/health?db_server_status=1" >/dev/null

# Prove Paperless can recover independently, then validate cross-system links.
"${RESTORE[@]}" up -d --wait --pull never \
  paperless-preflight paperless-db paperless-broker paperless-gotenberg \
  paperless-tika paperless-trash-init paperless-webserver
"${RESTORE[@]}" run --rm --no-deps paperless-access-init
curl --fail --silent "http://127.0.0.1:${PAPERLESS_HTTP_PORT}/api/" >/dev/null
"${RESTORE[@]}" stop odoo >/dev/null
"${RESTORE[@]}" --profile init run --rm -T \
  -e ODOO_INIT_DB="$RESTORED_DATABASE" \
  -e USL_EXPECTED_DOCUMENT_COUNT="$EXPECTED_DOCUMENTS" \
  -e USL_EXPECTED_RELATIONSHIP_COUNT="$EXPECTED_RELATIONSHIPS" \
  -e USL_EXPECTED_COMPANY_COUNT="$EXPECTED_COMPANIES" \
  -e USL_EXPECTED_INTERNAL_USER_COUNT="$EXPECTED_INTERNAL_USERS" \
  -e USL_EXPECTED_MOVE_COUNT="$EXPECTED_MOVES" \
  -e USL_EXPECTED_MOVE_LINE_COUNT="$EXPECTED_MOVE_LINES" \
  -e USL_EXPECTED_POSTED_DEBIT="$EXPECTED_POSTED_DEBIT" \
  -e USL_EXPECTED_POSTED_CREDIT="$EXPECTED_POSTED_CREDIT" \
  -e USL_EXPECTED_RELEASE_COMMIT="${USL_EXPECTED_RELEASE_COMMIT:-}" \
  -e USL_EXPECTED_RELEASE_IMAGE="${USL_EXPECTED_RELEASE_IMAGE:-}" \
  -e USL_EXPECTED_SOURCE_INTEGRITY_OK="$EXPECTED_SOURCE_INTEGRITY_OK" \
  -e USL_EXPECTED_PERMISSION_SYNC_FAILURES="$EXPECTED_PERMISSION_SYNC_FAILURES" \
  -e USL_RECOVERY_ALLOW_SOURCE_INTEGRITY_FAILURE="${USL_RECOVERY_ALLOW_SOURCE_INTEGRITY_FAILURE:-0}" \
  -e USL_RECOVERY_REQUIRE_RESTRICTED_FIXTURE="${USL_RECOVERY_REQUIRE_RESTRICTED_FIXTURE:-1}" \
  -e USL_BACKUP_ID="$BACKUP_ID" \
  init-db odoo shell \
  --config=/etc/odoo/odoo.conf \
  --database="$RESTORED_DATABASE" < "$ROOT/scripts/odoo/documents_restore_acceptance.py"
"${RESTORE[@]}" up -d --wait --pull never odoo

RESTORE_CONTAINER_IDS="$("${RESTORE[@]}" ps -q)"
if [[ -n "$RESTORE_CONTAINER_IDS" ]]; then
  "${RESTORE[@]}" stop >/dev/null
fi
if [[ "$PRESERVE_RECOVERY" = "1" ]]; then
  printf 'DOCUMENTS_RECOVERY_TEST_OK environment=%s backup=%s artifacts=%s restore_project=%s database=%s preserved=1\n' \
    "$ENVIRONMENT" "$BACKUP_ID" "$ARTIFACT_DIR" "$RESTORE_PROJECT" "$RESTORED_DATABASE"
else
  printf 'DOCUMENTS_RECOVERY_TEST_OK environment=%s backup=%s artifacts=cleaned restore_project=cleaned database=%s preserved=0\n' \
    "$ENVIRONMENT" "$BACKUP_ID" "$RESTORED_DATABASE"
fi
