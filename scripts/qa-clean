#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
# shellcheck source=lib/compose-scope.sh
source "$ROOT/scripts/lib/compose-scope.sh"

root_hash="$(printf '%s' "$ROOT" | shasum -a 256 | cut -c 1-8)"
compose_project="${COMPOSE_PROJECT_NAME:-usl-odoo-qa-$root_hash}"
pocket_env="${POCKET_ID_ENV_FILE:-$ROOT/.pocket-id-qa-$root_hash.env}"

case "$compose_project" in
  usl-odoo-qa-?*) ;;
  *)
    printf 'QA cleanup requires an isolated usl-odoo-qa-* project.\n' >&2
    exit 2
    ;;
esac
if [[ "${USL_QA_CLEAN_CONFIRM:-}" != qa-volumes ]]; then
  printf 'Refusing QA cleanup without CONFIRM=qa-volumes.\n' >&2
  exit 2
fi

usl_verify_compose_scope "$compose_project" "$ROOT" "QA cleanup"
usl_compose_scope_scan "$compose_project" "$ROOT"
unsafe="$(usl_compose_active_unsafe_resources || true)"
if [[ -n "$unsafe" ]]; then
  printf 'A one-shot QA or migration operation is active; refusing cleanup:\n%s\n' \
    "$(usl_format_compose_resources "$unsafe")" >&2
  exit 2
fi

compose=(
  docker compose -p "$compose_project"
  -f "$ROOT/compose.yaml" -f "$ROOT/compose.pocket-id.yaml"
)
if [[ -f "$pocket_env" ]]; then
  compose+=(--env-file "$pocket_env")
fi
"${compose[@]}" --profile paperless --profile accounting-compat \
  down --volumes --remove-orphans
rm -f "$ROOT/artifacts/migration/private/qa-state/$compose_project.json"

printf 'Removed isolated QA containers, network, and volumes: %s\n' \
  "$compose_project"
printf 'Preserved shared seed, images, build cache, source package, and identity environment.\n'
