# Copy to .env before running Docker Compose.
# Do not commit .env; it contains local credentials.

COMPOSE_PROJECT_NAME=usl-odoo-saas-19-3

# PostgreSQL
POSTGRES_IMAGE=postgres:16-bookworm
POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo

# Odoo database connection
ODOO_DB_HOST=db
ODOO_DB_PORT=5432
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=odoo

# Change this in every shared, staging, or production-like environment.
ODOO_ADMIN_PASSWORD=admin

# Runtime
ODOO_HTTP_PORT=8069
ODOO_GEVENT_PORT=8072
ODOO_HTTP_INTERFACE=0.0.0.0
ODOO_WORKERS=0
# The long-running development server executes normal scheduled actions.
# Init, test and Dev Container helper services keep cron disabled explicitly.
ODOO_MAX_CRON_THREADS=1
ODOO_PROXY_MODE=False
ODOO_LOG_LEVEL=info
ODOO_LIMIT_TIME_CPU=600
ODOO_LIMIT_TIME_REAL=1200
ODOO_DB_FILTER=^odoo_dev$

# External electronic-invoicing safety guards. Keep both disabled in every
# development, test, staging and reconstruction environment. Reception is
# activated later through a separate production procedure; e-reporting has its
# own rollout and must not be enabled as part of reception activation.
USL_EINVOICE_LIVE_ENABLED=0
USL_EREPORTING_LIVE_ENABLED=0

# Governed LaTeX renderer. Generate local mTLS credentials with
# `make document-renderer-certs`, then start the isolated service with
# `docker compose --profile document-renderer up -d usl-document-renderer`.
# Production must override this exact development tag with a reviewed image
# digest while retaining the embedded template revision.
USL_DOCUMENT_RENDERER_IMAGE=usl-document-renderer:5ab496f8d8f9

# USL Sign cryptographic services are activated with `docker compose --profile
# sign up -d`. Run `scripts/sign-services-bootstrap` first. The generated
# certificates, provisioner key, and passwords remain under the ignored
# `.secrets/sign/` tree; none are stored in Odoo settings or this file.
USL_SIGN_STEP_CA_IMAGE=smallstep/step-ca:0.30.2@sha256:a2b17872915c193259b75a5474c398326f41bd199f0842093e52cf4182bc8270
USL_SIGN_DSS_IMAGE=usl-sign-dss:6.4
# Qualified-external validation remains unavailable until an EU LOTL signing
# certificate store and the official URLs are explicitly configured. Put the
# PKCS#12 file under the ignored DSS secret directory; never commit it.
USL_DSS_LOTL_KEYSTORE=
USL_DSS_LOTL_KEYSTORE_PASSWORD=
USL_DSS_LOTL_URL=
USL_DSS_OJ_URL=
# Optional reviewed RFC 3161 TSA. Leave empty for PAdES-B operation.
USL_DSS_TSA_URL=

# Pocket ID is inert until explicitly enabled. Register the exact callback
# https://<odoo-host>/auth_oauth/signin in the Pocket ID OIDC client.
# Keep the client secret and named-user JSON in the uncommitted .env or the
# deployment secret store. Never put either value in repository files.
USL_POCKET_ID_ENABLED=0
USL_POCKET_ID_ISSUER=
USL_POCKET_ID_CLIENT_ID=
USL_POCKET_ID_CLIENT_SECRET=
USL_POCKET_ID_ODOO_BASE_URL=
USL_POCKET_ID_REQUIRED_GROUP=
USL_POCKET_ID_SCOPES=openid profile email groups
USL_POCKET_ID_TOKEN_AUTH_METHOD=
USL_POCKET_ID_ALLOW_UNIQUE_EMAIL_LINK=0

# Paperless uses a separate confidential Pocket ID client. Register:
# https://<paperless-host>/accounts/oidc/pocket-id/login/callback/
# Never reuse the Odoo client ID or secret. Pocket groups gate authentication
# only; PAPERLESS_SOCIAL_ACCOUNT_SYNC_GROUPS must remain false because Odoo
# owns document authorization.
POCKET_ID_PAPERLESS_CLIENT_ID=
POCKET_ID_PAPERLESS_CLIENT_SECRET=
PAPERLESS_PUBLIC_BASE_URL=
PAPERLESS_ACCOUNT_DEFAULT_HTTP_PROTOCOL=https
PAPERLESS_SSO_BASE_GROUP=USL Odoo document users
PAPERLESS_OIDC_ENABLED=0
PAPERLESS_DISABLE_REGULAR_LOGIN=false
PAPERLESS_REDIRECT_LOGIN_TO_SSO=false
PAPERLESS_SOCIAL_ACCOUNT_SYNC_GROUPS=false

# One-shot named-user provisioning inputs. Leave APPLY disabled for the first
# dry run and use a password of at least 20 characters for the sole local
# break-glass administrator. Remove these three variables after provisioning.
USL_POCKET_ID_USERS_JSON=
USL_POCKET_ID_BREAK_GLASS_PASSWORD=
USL_POCKET_ID_APPLY=0

# Addon paths. Keep custom addons outside Odoo core.
ODOO_ADDONS_PATH=/opt/odoo/addons,/opt/odoo/odoo/addons,/mnt/custom-addons,/mnt/oca-addons

# Ignored host-side Odoo Online source package used only by migration profiles.
# Use an approved absolute path outside the checkout for production cutover.
USL_ONLINE_DUMP_DIR=./usl-online-dump

# First-run initialization target used by:
# docker compose --profile init run --rm init-db
ODOO_INIT_DB=odoo_dev
ODOO_INIT_MODULES=rebuild_account_migration

# Development convenience. Example: reload,xml,qweb
ODOO_DEV_MODE=

# Paperless-ngx — independently deployed archive. Never use an unpinned image.
# Development defaults are loopback-only. Set USL_DEPLOYMENT_ENV=production to
# make the Compose preflight reject placeholders, short secrets, HTTP ingress,
# or an unpinned Paperless image.
USL_DEPLOYMENT_ENV=development
PAPERLESS_IMAGE=ghcr.io/paperless-ngx/paperless-ngx:3.0.5
PAPERLESS_POSTGRES_IMAGE=postgres:16-bookworm
PAPERLESS_BROKER_IMAGE=valkey/valkey:8.1.3-alpine
PAPERLESS_GOTENBERG_IMAGE=gotenberg/gotenberg:8.36@sha256:87c16b9f364279d321bc9772d31fa58aa6abe036423c270698bd636c3a8e9466
PAPERLESS_TIKA_IMAGE=apache/tika:3.2.3.0-full
PAPERLESS_DB_NAME=paperless
PAPERLESS_DB_USER=paperless
PAPERLESS_DB_PASSWORD=
PAPERLESS_SECRET_KEY=
PAPERLESS_INTERNAL_URL=http://paperless-webserver:8000
PAPERLESS_PUBLIC_URL=http://127.0.0.1:8010
PAPERLESS_ALLOWED_HOSTS=localhost,127.0.0.1,paperless-webserver
PAPERLESS_CORS_ALLOWED_HOSTS=http://127.0.0.1:8010
PAPERLESS_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8010
PAPERLESS_HTTP_PORT=8010
PAPERLESS_TIME_ZONE=Europe/Paris
PAPERLESS_OCR_LANGUAGE=fra+eng
PAPERLESS_CONSUMER_ENABLE_BARCODES=true
