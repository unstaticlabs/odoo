# Copy to .env before running Docker Compose.
# Do not commit .env; it contains local credentials.

COMPOSE_PROJECT_NAME=usl-odoo-saas-19-2

# PostgreSQL
POSTGRES_IMAGE=postgres:16-bookworm
POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo

# Odoo database connection
ODOO_DB_HOST=db
ODOO_DB_PORT=5432
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=odoo

# Change this in every shared, staging, or production-like environment.
ODOO_ADMIN_PASSWORD=admin

# Runtime
ODOO_HTTP_PORT=8069
ODOO_GEVENT_PORT=8072
ODOO_HTTP_INTERFACE=0.0.0.0
ODOO_WORKERS=0
# The long-running development server executes normal scheduled actions.
# Init, test and Dev Container helper services keep cron disabled explicitly.
ODOO_MAX_CRON_THREADS=1
ODOO_PROXY_MODE=False
ODOO_LOG_LEVEL=info
ODOO_LIMIT_TIME_CPU=600
ODOO_LIMIT_TIME_REAL=1200
ODOO_DB_FILTER=^odoo_dev$

# External electronic-invoicing safety guards. Keep both disabled in every
# development, test, staging and reconstruction environment. Reception is
# activated later through a separate production procedure; e-reporting has its
# own rollout and must not be enabled as part of reception activation.
USL_EINVOICE_LIVE_ENABLED=0
USL_EREPORTING_LIVE_ENABLED=0

# Addon paths. Keep custom addons outside Odoo core.
ODOO_ADDONS_PATH=/opt/odoo/addons,/opt/odoo/odoo/addons,/mnt/custom-addons,/mnt/oca-addons

# First-run initialization target used by:
# docker compose --profile init run --rm init-db
ODOO_INIT_DB=odoo_dev
ODOO_INIT_MODULES=rebuild_account_migration

# Development convenience. Example: reload,xml,qweb
ODOO_DEV_MODE=

# Paperless-ngx — independently deployed archive. Never use an unpinned image.
# Generate unique secrets before enabling the `paperless` profile. The example
# placeholders intentionally make Compose refuse to start.
PAPERLESS_IMAGE=ghcr.io/paperless-ngx/paperless-ngx:3.0.4
PAPERLESS_POSTGRES_IMAGE=postgres:16-bookworm
PAPERLESS_BROKER_IMAGE=valkey/valkey:8.1.3-alpine
PAPERLESS_DB_NAME=paperless
PAPERLESS_DB_USER=paperless
PAPERLESS_DB_PASSWORD=
PAPERLESS_SECRET_KEY=
PAPERLESS_INTERNAL_URL=http://paperless-webserver:8000
PAPERLESS_PUBLIC_URL=http://127.0.0.1:8010
PAPERLESS_HTTP_PORT=8010
PAPERLESS_TIME_ZONE=Europe/Paris
PAPERLESS_OCR_LANGUAGE=fra+eng
PAPERLESS_CONSUMER_ENABLE_BARCODES=true
