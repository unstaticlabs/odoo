<templates xml:space="preserve">
    <t t-inherit="mail.Message" t-inherit-mode="extension">
        <xpath expr="//AttachmentList" position="after">
            <VoiceTranscripts t-if="this.store.self_user and this.message.persistent and this.message.model !== 'discuss.channel' and this.message.extra_body_attachment_ids.some((attachment) => attachment.voice)" message="this.message" t-key="this.message.id"/>
        </xpath>
    </t>
    <t t-name="usl_voice.Transcripts">
        <div t-foreach="this.state.notes" t-as="note" t-key="note.attachment_id" class="o-usl-transcript mt-1 mb-2 ps-2 border-start border-2" aria-live="polite">
            <t t-if="note.state === 'done'">
                <div class="text-muted small"><i class="fa fa-file-text-o me-1" aria-hidden="true"/>Transcript</div>
                <p class="mb-0 text-break" style="white-space:pre-wrap" t-esc="note.text"/>
            </t>
            <small t-elif="note.state === 'pending'" class="text-muted"><i class="fa fa-circle-o-notch fa-spin me-1" aria-hidden="true"/>Transcribing…</small>
            <small t-elif="note.state === 'silent'" class="text-muted">No speech detected.</small>
            <t t-elif="note.state === 'failed'">
                <small class="text-muted"><i class="fa fa-exclamation-triangle me-1" aria-hidden="true"/>Transcription unavailable.</small>
                <button t-if="this.props.message.editable" class="btn btn-link btn-sm py-0" t-att-disabled="this.state.retrying" t-on-click="this.onRetry">Try again</button>
            </t>
        </div>
        <button t-if="this.state.error" class="btn btn-link btn-sm" t-on-click="this.refresh">Reload transcript</button>
    </t>
</templates>
