<templates xml:space="preserve">
    <!-- No t-on-click here: dictation.js handles data-usl-action itself, before the event
         reaches any Odoo component that closes a field on an outside click. -->
    <t t-name="usl_voice.FieldDictation">
        <div t-if="this.state.recovered" class="o-usl-dictation o-usl-recovered border rounded bg-view shadow p-3" role="status">
            <div class="fw-bold mb-1">Your dictation is ready</div>
            <div t-if="this.destination" class="text-muted small mb-2">The field changed while Odoo was transcribing, so nothing was inserted. Copy the text and paste it where you need it.</div>
            <div t-else="" class="text-muted small mb-2">This recording was kept from an earlier page. Copy the text and paste it where you need it.</div>
            <p class="o-usl-recovered-text border-start border-2 ps-2 mb-3" t-esc="this.state.recovered"/>
            <button class="btn btn-primary btn-sm" data-usl-action="copyText"><i class="fa fa-clipboard me-1" aria-hidden="true"/>Copy transcript</button>
            <button class="btn btn-link btn-sm text-muted ms-1" data-usl-action="discard">Dismiss</button>
        </div>
        <div t-elif="this.state.mode === 'retry'" class="o-usl-dictation o-usl-recovered border rounded bg-view shadow p-3" role="status">
            <t t-if="this.state.reason === 'silent'">
                <div class="fw-bold mb-1">No speech detected</div>
                <p class="text-muted small mb-2">Your recording is kept. Try again, or download it.</p>
            </t>
            <t t-else="">
                <div class="fw-bold mb-1">Waiting for transcription</div>
                <p class="text-muted small mb-2">Your recording is kept. Retry when ready, or download it.</p>
            </t>
            <button class="btn btn-primary btn-sm" data-usl-action="retry">Retry transcription</button>
            <button class="btn btn-link btn-sm ms-1" data-usl-action="download"><i class="fa fa-download me-1" aria-hidden="true"/>Download audio</button>
            <button class="btn btn-link btn-sm text-muted" data-usl-action="discard">Discard</button>
        </div>
        <div t-elif="(this.state.visible and this.state.wanted and !this.state.typing) or this.state.mode !== 'idle'" class="o-usl-dictation o-usl-dictation-controls d-flex align-items-start" t-custom-ref="controls"
             t-att-class="{ 'o-usl-dictation-above flex-column-reverse': this.state.above, 'flex-column': !this.state.above }"
             t-att-style="'left:' + this.state.x + 'px;top:' + this.state.y + 'px'">
            <button t-if="this.state.mode === 'idle'" class="o-usl-dictation-mic btn btn-light border rounded-circle shadow-sm" title="Dictate (Alt+Shift+D)" aria-label="Dictate text" aria-keyshortcuts="Alt+Shift+D" data-usl-action="record">
                <i class="fa fa-microphone" aria-hidden="true"/>
            </button>
            <div t-else="" class="o-usl-dictation-pill d-flex align-items-center border rounded-pill bg-view shadow-sm">
                <t t-if="this.state.mode === 'recording'">
                    <span class="ps-2 pe-1 small"><VoiceMeter capture="this.capture"/></span>
                    <button class="btn btn-danger btn-sm rounded-circle" title="Stop and insert the text" aria-label="Stop and insert the text" data-usl-action="stop">
                        <i class="fa fa-stop" aria-hidden="true"/>
                    </button>
                </t>
                <span t-else="" class="ps-2 pe-1 small text-muted text-nowrap" role="status">
                    <i class="fa fa-circle-o-notch fa-spin me-1" aria-hidden="true"/>
                    <t t-if="this.state.mode === 'starting'">Starting…</t>
                    <t t-else="">Transcribing…</t>
                </span>
                <!-- While transcribing, the cross only stops the wait: the recording is never dropped. -->
                <button t-if="this.state.mode === 'processing'" class="btn btn-link btn-sm text-muted rounded-circle" title="Stop waiting. The recording is kept." aria-label="Stop waiting" data-usl-action="stopWaiting"><i class="oi oi-close" aria-hidden="true"/></button>
                <button t-else="" class="btn btn-link btn-sm text-muted rounded-circle" title="Cancel dictation (Esc)" aria-label="Cancel dictation" data-usl-action="cancel"><i class="oi oi-close" aria-hidden="true"/></button>
            </div>
        </div>
        <!-- A recording kept from an earlier page (reload, crash, logout, a tab the phone closed): offered again until used or discarded. -->
        <div t-if="this.state.stored.length and this.state.mode === 'idle' and !this.state.recovered and !this.state.collapsed" class="o-usl-dictation o-usl-recovered o-usl-stored border rounded bg-view shadow p-3" role="status">
            <div class="fw-bold mb-1" t-esc="this.storedTitle"/>
            <p class="text-muted small mb-2" t-esc="this.storedBody"/>
            <button t-if="!this.hasPendingVoiceAttachment(this.state.stored[0])" class="btn btn-primary btn-sm" data-usl-action="retry" t-att-data-usl-id="this.state.stored[0].id">
                <t t-if="this.state.stored[0].kind === 'voice_note'">Attach to the record</t>
                <t t-else="">Retry transcription</t>
            </button>
            <button class="btn btn-link btn-sm ms-1" data-usl-action="download" t-att-data-usl-id="this.state.stored[0].id"><i class="fa fa-download me-1" aria-hidden="true"/>Download audio</button>
            <button t-if="!this.hasPendingVoiceAttachment(this.state.stored[0])" class="btn btn-link btn-sm text-muted" data-usl-action="discard" t-att-data-usl-id="this.state.stored[0].id">Discard</button>
            <button class="btn btn-link btn-sm text-muted" data-usl-action="collapseStored">Later</button>
        </div>
        <!-- Out of the way, never gone: a tap brings the recordings back. -->
        <button t-elif="this.state.stored.length and this.state.mode === 'idle' and !this.state.recovered" class="o-usl-dictation o-usl-stored-pill btn btn-primary btn-sm rounded-pill shadow"
                data-usl-action="expandStored" title="Show the unused recordings" aria-label="Show the unused recordings">
            <i class="fa fa-microphone me-1" aria-hidden="true"/><t t-esc="this.state.stored.length"/>
        </button>
        <!-- The last words heard, in the field at the insertion point and in its own type, clipped
             at their start: where the text will go, but not yet the final text. -->
        <div t-if="this.state.preview and this.state.caption and this.state.mode !== 'idle' and !this.state.recovered" class="o-usl-dictation-caption"
             t-att-class="{ 'o-usl-dictation-caption-clipped': this.state.clipped }" t-att-style="this.state.caption" t-custom-ref="caption" aria-hidden="true">
            <span t-esc="this.state.preview"/>
        </div>
    </t>
</templates>
