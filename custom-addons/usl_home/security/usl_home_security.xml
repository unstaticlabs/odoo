<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_usl_home_favorite_allowed_companies" model="ir.rule">
        <field name="name">Home favorites: allowed companies only</field>
        <field name="model_id" ref="model_usl_home_favorite"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_usl_home_favorite_own" model="ir.rule">
        <field name="name">Home favorites: own destinations only</field>
        <field name="model_id" ref="model_usl_home_favorite"/>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>
</odoo>
