<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="usl_home.ContentSearch">
        <section class="o_usl_content_search" aria-label="Search your work">
            <label for="usl-home-content-search" class="form-label fw-semibold">Search your work</label>
            <div class="input-group">
                <span class="input-group-text"><i class="fa fa-search" aria-hidden="true"/></span>
                <input id="usl-home-content-search" class="form-control" type="text" maxlength="2048" placeholder="Tasks, projects, documents, contacts…" t-ref="input" t-att-value="state.query" t-on-input="inputChanged" t-on-keydown="keydown" role="combobox" aria-autocomplete="list" aria-controls="usl-home-search-results" t-att-aria-expanded="state.query.trim() ? 'true' : 'false'" t-att-aria-activedescendant="this.selectedRecord ? this.resultDomId(this.selectedRecord) : undefined"/>
                <button t-if="state.query" class="btn btn-outline-secondary" type="button" aria-label="Clear search" t-on-click="clear"><i class="fa fa-times" aria-hidden="true"/></button>
            </div>
            <p t-if="!state.query.trim()" class="text-muted small mt-2 mb-0">Search text and field values in the records you can access. Documents also search their contents.</p>
            <div t-if="state.query.trim()" id="usl-home-search-results" class="o_usl_content_results" role="listbox" aria-label="Search results">
                <p t-if="state.loading" class="text-muted" role="status">Searching records…</p>
                <div t-if="state.error" role="alert">Some records could not be searched. Results already found remain available. <button type="button" class="btn btn-link" t-on-click="search">Try again</button></div>
                <t t-foreach="groups" t-as="group" t-key="group.key">
                    <section t-if="group.records.length or (group.key === 'tasks' and state.meaningLoading)" class="o_usl_search_group" t-att-data-category="group.key">
                        <h2 class="o_usl_search_group_title" t-esc="group.label"/>
                        <t t-foreach="group.records" t-as="record" t-key="this.resultKey(record)">
                            <h3 t-if="group.key === 'tasks' and group.relatedStart and record_index === group.relatedStart" class="o_usl_search_subgroup">Related by subject</h3>
                            <button type="button" class="o_usl_search_result text-start w-100" t-att-class="{ 'active': state.selected === this.resultKey(record) }" t-att-id="this.resultDomId(record)" role="option" t-att-aria-selected="state.selected === this.resultKey(record) ? 'true' : 'false'" t-on-click="() => this.open(record)">
                                <span class="o_usl_result_title">
                                    <t t-esc="record.title"/><t t-if="group.key === 'tasks' and record_index >= group.relatedStart"><t t-out="' '"/></t>
                                    <span t-if="group.key === 'tasks' and record_index >= group.relatedStart" class="o_usl_result_badge">Similar topic</span>
                                </span>
                                <span t-if="record.context_label" class="o_usl_result_meta" t-esc="record.context_label"/>
                                <span t-if="record.source" class="o_usl_result_meta o_usl_result_source">
                                    <i t-att-class="record.source.message_kind === 'note' ? 'fa fa-sticky-note-o' : 'fa fa-comment-o'" aria-hidden="true"/>
                                    <t t-esc="this.sourceLabel(record.source)"/>
                                </span>
                                <span t-if="record.excerpt" class="o_usl_result_excerpt">
                                    <t t-if="record.source">“</t><t t-foreach="this.excerptParts(record)" t-as="part" t-key="part_index"><strong t-if="part.match" class="o_usl_result_match" t-esc="part.text"/><t t-else="" t-esc="part.text"/></t><t t-if="record.source">”</t>
                                </span>
                            </button>
                        </t>
                        <p t-if="group.key === 'tasks' and state.meaningLoading" class="o_usl_search_skeleton text-muted" role="status"><span class="o_usl_skeleton_bar" aria-hidden="true"/>Looking for related tasks…</p>
                        <button t-if="group.has_more" t-att-disabled="group.loading || (group.key === 'documents' &amp;&amp; state.documentsLoading)" class="o_usl_search_more btn btn-link btn-sm" type="button" t-on-click="() => this.more(group)">More <t t-esc="group.label"/></button>
                    </section>
                </t>
                <p t-if="state.documentsLoading" class="text-muted" role="status">Searching document contents…</p>
                <div t-if="state.documentError" role="alert">Document contents are temporarily unavailable. <button type="button" class="btn btn-link" t-on-click="() => this.loadDocuments()">Try again</button></div>
                <p t-if="state.documents?.warnings?.some(warning => warning.code === 'semantic_unavailable')" class="text-muted small">Meaning-based document matches are temporarily unavailable. Exact content matches are still shown.</p>
                <button t-if="state.documents?.continue_in_documents" class="btn btn-link" type="button" t-on-click="continueDocuments">Continue in Documents</button>
                <p t-if="empty" class="o_usl_search_empty text-muted" role="status" t-esc="emptyMessage"/>
            </div>
        </section>
    </t>
</templates>
