<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="usl_home.ProjectsContentSearchBar" t-inherit="web.SearchBar" t-inherit-mode="primary">
        <xpath expr="//t[@t-call='web.SearchBar.QuickSearchItems']" position="attributes">
            <attribute name="t-call">usl_home.ProjectsQuickSearchItems</attribute>
        </xpath>
    </t>
    <t t-name="usl_home.ProjectsQuickSearchItems" t-inherit="web.SearchBar.QuickSearchItems" t-inherit-mode="primary">
        <xpath expr="//t[@t-if='item.isAddCustomFilterButton']" position="before">
            <t t-if="item.record">
                <strong t-esc="item.label"/>
                <small t-if="item.record.excerpt" class="d-block text-muted text-wrap" t-esc="item.record.excerpt"/>
            </t>
        </xpath>
        <xpath expr="//t[@t-if='item.isAddCustomFilterButton']" position="attributes">
            <attribute name="t-if"/>
            <attribute name="t-elif">item.isAddCustomFilterButton</attribute>
        </xpath>
        <xpath expr="//b[@t-out='item.searchItemDescription']" position="attributes">
            <attribute name="t-if">!item.record</attribute>
        </xpath>
        <xpath expr="//t[@t-elif='!item.isFieldProperty']" position="attributes">
            <attribute name="t-elif">!item.isFieldProperty &amp;&amp; !item.record</attribute>
        </xpath>
    </t>
</templates>
