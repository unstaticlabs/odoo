<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_project_content_search" model="ir.ui.view">
        <field name="name">project.project.content.search</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_project_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search/field[@name='name']" position="before">
                <field name="usl_search_text" string="Content" filter_domain="[('usl_search_text', 'ilike', self)]"/>
            </xpath>
        </field>
    </record>
    <record id="view_contact_content_search" model="ir.ui.view">
        <field name="name">res.partner.content.search</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search/field[@name='name']" position="before">
                <field name="usl_search_text" string="Content" filter_domain="[('usl_search_text', 'ilike', self)]"/>
            </xpath>
        </field>
    </record>
</odoo>
