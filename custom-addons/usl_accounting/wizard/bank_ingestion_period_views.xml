<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bank_ingestion_period_form" model="ir.ui.view">
        <field name="name">account.bank.ingestion.period.form</field>
        <field name="model">account.bank.ingestion.period</field>
        <field name="arch" type="xml">
            <form string="Correct statement period">
                <p>Check the dates on the bank statement. This correction uses retained files only; it does not download files or reimport transactions.</p>
                <group>
                    <field name="ingestion_id" options="{'no_open': True}"/>
                    <field name="period_start"/>
                    <field name="period_end"/>
                    <field name="reason" placeholder="Explain where you verified these dates."/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Apply correction" class="btn-primary" title="Save the verified dates and audit reason, then associate retained PDFs without reimporting transactions."/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
