<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_usl_expense_bank_match_wizard_form" model="ir.ui.view">
        <field name="name">usl.expense.bank.match.wizard.form</field>
        <field name="model">usl.expense.bank.match.wizard</field>
        <field name="arch" type="xml">
            <form string="Use bank transaction">
                <group>
                    <field name="expense_id"/>
                    <field name="bank_statement_line_id"/>
                    <field name="bank_date"/>
                    <field
                        name="bank_amount"
                        widget="monetary"
                        options="{'currency_field': 'currency_id'}"/>
                    <field name="journal_id"/>
                    <field name="partner_id"/>
                </group>
                <div class="alert alert-info py-2" role="status">
                    <field name="evidence_summary" nolabel="1"/>
                </div>
                <div class="text-muted">
                    <field name="confirmation_message" nolabel="1"/>
                </div>
                <footer>
                    <button
                        name="action_confirm"
                        type="object"
                        string="Use and reconcile"
                        class="btn-primary"
                        title="Run Odoo's native expense approval and posting steps, then reconcile the generated company payment with this bank transaction."/>
                    <button
                        string="Cancel"
                        special="cancel"
                        class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
