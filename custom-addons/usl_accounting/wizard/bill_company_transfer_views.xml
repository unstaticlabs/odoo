<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bill_company_transfer_form" model="ir.ui.view">
        <field name="name">usl.bill.company.transfer.form</field>
        <field name="model">usl.bill.company.transfer</field>
        <field name="arch" type="xml">
            <form string="Change company" js_class="usl_bill_company_transfer">
                <field name="stage" invisible="1"/>
                <field name="has_blockers" invisible="1"/>
                <field name="scope_company_ids" invisible="1"/>
                <field name="operator_company_ids" invisible="1"/>
                <group>
                    <group>
                        <field name="bill_id" options="{'no_open': True}"/>
                        <field name="source_company_id" options="{'no_open': True}"/>
                    </group>
                    <group>
                        <field name="target_company_id" widget="usl_bill_transfer_company" required="1" readonly="stage != 'choose'"
                               domain="[('id', 'in', operator_company_ids), ('id', '!=', source_company_id)]"
                               context="{'allowed_company_ids': operator_company_ids}"
                               options="{'no_create': True, 'no_open': True}"/>
                    </group>
                </group>
                <div class="alert alert-danger" role="alert" invisible="not has_blockers" name="blockers">
                    <field name="blockers_html" nolabel="1"/>
                </div>
                <div class="alert alert-warning" role="status" invisible="not warning"><field name="warning" nolabel="1"/></div>
                <group invisible="stage == 'choose'">
                    <group>
                        <field name="source_journal_id" options="{'no_open': True}"/>
                        <field name="source_term_id" options="{'no_open': True}"/>
                        <field name="source_fiscal_position_id" invisible="not source_fiscal_position_id" options="{'no_open': True}"/>
                    </group>
                    <group>
                        <field name="journal_id" context="{'allowed_company_ids': scope_company_ids}" domain="[('company_id', '=', target_company_id), ('type', '=', 'purchase')]"
                               options="{'no_create': True, 'no_open': True}"/>
                        <field name="term_id" context="{'allowed_company_ids': scope_company_ids}" domain="['|', ('company_id', '=', False), ('company_id', 'parent_of', target_company_id)]"
                               options="{'no_create': True, 'no_open': True}"/>
                        <field name="fiscal_position_id" context="{'allowed_company_ids': scope_company_ids}" domain="[('company_id', 'parent_of', target_company_id)]"
                               options="{'no_create': True, 'no_open': True}"/>
                        <field name="remove_fiscal_position" invisible="not source_fiscal_position_id or fiscal_position_id"/>
                    </group>
                </group>
                <field name="mapping_ids" mode="list,kanban" nolabel="1" invisible="stage == 'choose'">
                    <list editable="bottom" create="0" delete="0">
                        <field name="company_id" column_invisible="True"/>
                        <field name="analytic_precision" column_invisible="True"/>
                        <field name="scope_company_ids" column_invisible="True"/>
                        <field name="label"/>
                        <field name="source_account_label" optional="show"/>
                        <field name="target_account_id" context="{'allowed_company_ids': scope_company_ids}" domain="[('company_ids', 'parent_of', company_id), ('active', '=', True)]" options="{'no_create': True, 'no_open': True}"/>
                        <field name="source_tax_ids" widget="many2many_tags" optional="show"/>
                        <field name="target_tax_ids" widget="many2many_tags" context="{'allowed_company_ids': scope_company_ids}" domain="[('company_id', 'parent_of', company_id), ('type_tax_use', '=', 'purchase')]" options="{'no_create': True}"/>
                        <field name="remove_taxes" invisible="not source_tax_ids or target_tax_ids"/>
                        <field name="analytic_distribution" widget="usl_bill_transfer_analytic" optional="hide" groups="analytic.group_analytic_accounting"/>
                    </list>
                    <kanban class="o_kanban_mobile" create="false" delete="false">
                        <templates>
                            <t t-name="card">
                                <strong><field name="label"/></strong>
                                <div><field name="source_account_label"/> → <field name="target_account_id"/></div>
                                <field name="target_tax_ids" widget="many2many_tags"/>
                            </t>
                        </templates>
                    </kanban>
                    <form string="Review invoice line" create="false" delete="false">
                        <field name="company_id" invisible="1"/>
                        <field name="analytic_precision" invisible="1"/>
                        <field name="scope_company_ids" invisible="1"/>
                        <group>
                            <field name="label"/>
                            <field name="source_account_label"/>
                            <field name="target_account_id" context="{'allowed_company_ids': scope_company_ids}" domain="[('company_ids', 'parent_of', company_id), ('active', '=', True)]" options="{'no_create': True}"/>
                            <field name="source_tax_ids" widget="many2many_tags"/>
                            <field name="target_tax_ids" widget="many2many_tags" context="{'allowed_company_ids': scope_company_ids}" domain="[('company_id', 'parent_of', company_id), ('type_tax_use', '=', 'purchase')]" options="{'no_create': True}"/>
                            <field name="remove_taxes" invisible="not source_tax_ids or target_tax_ids"/>
                            <field name="analytic_distribution" widget="usl_bill_transfer_analytic" groups="analytic.group_analytic_accounting"/>
                        </group>
                    </form>
                </field>
                <p class="mt-3 mb-0" invisible="stage != 'map'"><field name="destination_summary" nolabel="1"/></p>
                <p class="text-muted mt-3 mb-0"><field name="consequences" nolabel="1"/></p>
                <footer>
                    <button name="action_prepare_mapping" type="object" string="Review accounts" class="btn-primary" invisible="stage != 'choose' or has_blockers"/>
                    <button name="action_apply" type="object" string="Transfer draft" class="btn-primary" invisible="stage != 'map'"
                            help="Move this draft to the destination company using the journal, accounts and taxes you reviewed."/>
                    <button name="action_choose_company" type="object" string="Back" class="btn-secondary" invisible="stage != 'map'"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="view_move_form_bill_company_transfer" model="ir.ui.view">
        <field name="name">account.move.form.bill.company.transfer</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='button_draft']" position="after">
                <button name="action_change_bill_company" type="object" string="Change company"
                        groups="base.group_multi_company" invisible="state != 'draft' or move_type not in ['in_invoice', 'in_refund']"/>
            </xpath>
        </field>
    </record>
</odoo>
