<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="mail_activity_type_bank_statement_review" model="mail.activity.type">
        <field name="name">Monthly Bank Statement</field>
        <field name="summary">Review monthly bank statement</field>
        <field name="icon">fa-bank</field>
        <field name="res_model">account.journal</field>
        <field name="delay_count">0</field>
        <field name="decoration_type">warning</field>
    </record>
    <record id="ir_cron_process_bank_exports" model="ir.cron">
        <field name="name">Accounting: process scheduled bank exports</field>
        <field name="model_id" ref="model_account_bank_ingestion"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_pending()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
    <record id="ir_cron_bank_export_expected_activities" model="ir.cron">
        <field name="name">Accounting: check expected bank statements</field>
        <field name="model_id" ref="model_account_bank_ingestion_config"/>
        <field name="state">code</field>
        <field name="code">model._cron_update_expected_activities()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>
