<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_expense_receipt_email" model="ir.actions.report">
        <field name="name">Receipt email</field>
        <field name="model">hr.expense</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">usl_accounting.expense_receipt_email</field>
        <field name="attachment_use" eval="False"/>
    </record>
    <template id="expense_receipt_email">
        <t t-call="web.html_container">
            <t t-foreach="docs._receipt_email_report_sources()" t-as="source">
                <t t-call="web.basic_layout">
                    <div class="page">
                        <h2>Receipt email</h2>
                        <p><strong>Subject:</strong> <span t-out="source['message'].subject"/></p>
                        <p><strong>Date:</strong> <span t-field="source['message'].date"/></p>
                        <p><strong>Order number:</strong> <span t-out="source['reference']"/></p>
                        <hr/>
                        <div style="white-space: pre-wrap; overflow-wrap: anywhere;" t-out="source['text']"/>
                        <hr/>
                        <p class="text-muted">Rendered from the receipt email. The original conversation and files remain available in the expense chatter.</p>
                    </div>
                </t>
            </t>
        </t>
    </template>
    <record id="view_expense_receipt_email" model="ir.ui.view">
        <field name="name">hr.expense.form.receipt.email</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="receipt_email_url" widget="expense_receipt_email"
                       class="oe_stat_button" readonly="1" nolabel="1"
                       invisible="not id or not receipt_email_url"/>
            </xpath>
        </field>
    </record>
</odoo>
