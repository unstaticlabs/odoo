<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_expense_bank_match_candidate_list" model="ir.ui.view">
        <field name="name">usl.expense.bank.match.candidate.list</field>
        <field name="model">usl.expense.bank.match.candidate</field>
        <field name="arch" type="xml">
                    <list
                        create="0"
                        edit="0"
                        delete="0"
                        default_order="rank"
                        limit="5">
                        <field name="expense_id" width="90px" column_invisible="not context.get('usl_bank_match_show_expense')"/>
                        <field name="amount_is_exact" column_invisible="True"/>
                        <field name="currency_id" column_invisible="True"/>
                        <field
                            name="bank_amount"
                            string="Amount"
                            widget="monetary"
                            options="{'currency_field': 'currency_id'}"/>
                        <button
                            name="action_open_confirmation"
                            type="object"
                            string="Use"
                            icon="fa-link"
                            class="btn-primary"
                            groups="account.group_account_manager"
                            invisible="not amount_is_exact"
                            title="Review the selected bank transaction, then post this as a company-paid expense and reconcile its native payment."/>
                        <field name="bank_date" string="Date"/>
                        <field
                            name="match_label"
                            string="Match"
                            widget="badge"
                            decoration-primary="match_label == 'best'"
                            decoration-muted="match_label == 'alternative'"/>
                        <field name="journal_id" string="Journal"/>
                        <field name="bank_label" string="Bank label"/>
                        <field name="partner_id" string="Partner" optional="hide"/>
                        <field name="evidence_summary" string="Why suggested"/>
                        <field name="competing_expense_count" column_invisible="True"/>
                    </list>
        </field>
    </record>
    <record id="view_hr_expense_form_bank_matching" model="ir.ui.view">
        <field name="name">hr.expense.form.company.bank.matching</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form"/>
        <field name="priority">95</field>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group[1]" position="after">
                <field name="usl_bank_match_eligible" invisible="1"/>
                <field name="usl_bank_match_available_count" invisible="1"/>
                <field name="usl_bank_match_accepted_count" invisible="1"/>
                <field name="usl_bank_match_last_refreshed_at" invisible="1"/>

                <separator
                    string="Company payment match"
                    groups="account.group_account_readonly,account.group_account_manager"/>
                <div
                    class="d-flex flex-wrap align-items-center gap-2 mb-2"
                    groups="account.group_account_manager"
                    invisible="not usl_bank_match_eligible">
                    <button
                        name="action_refresh_bank_match_candidates"
                        type="object"
                        string="Find bank transactions"
                        icon="fa-search"
                        class="btn-secondary"
                        title="Look for unreconciled company bank debits with a close date and amount. This only prepares suggestions; it does not post or reconcile anything."/>
                    <span class="text-muted">
                        <field name="usl_bank_match_guidance" nolabel="1" readonly="1"/>
                    </span>
                </div>
                <div
                    class="alert alert-info py-2"
                    role="status"
                    groups="account.group_account_readonly,account.group_account_manager"
                    invisible="usl_bank_match_eligible or usl_bank_match_accepted_count">
                    <field name="usl_bank_match_guidance" nolabel="1" readonly="1"/>
                </div>
                <div
                    class="text-muted mb-2"
                    groups="account.group_account_readonly,account.group_account_manager"
                    invisible="not usl_bank_match_eligible or usl_bank_match_available_count">
                    No current suggestion. Select <strong>Find bank transactions</strong> to check the latest bank data.
                </div>
                <field
                    name="usl_bank_match_candidate_ids"
                    mode="list"
                    context="{'list_view_ref': 'usl_accounting.view_expense_bank_match_candidate_list'}"
                    nolabel="1"
                    readonly="1"
                    groups="account.group_account_readonly,account.group_account_manager"
                    domain="[('state', '=', 'available')]"
                    invisible="not usl_bank_match_available_count">

                </field>
                <field
                    name="usl_bank_match_candidate_ids"
                    string="Accepted company payment"
                    readonly="1"
                    groups="account.group_account_readonly,account.group_account_manager"
                    domain="[('state', '=', 'accepted')]"
                    invisible="not usl_bank_match_accepted_count">
                    <list create="0" edit="0" delete="0">
                        <field name="bank_date" string="Date"/>
                        <field
                            name="bank_amount"
                            string="Amount"
                            widget="monetary"
                            options="{'currency_field': 'currency_id'}"/>
                        <field name="journal_id" string="Journal"/>
                        <field name="bank_label" string="Bank label"/>
                        <field name="evidence_summary" string="Evidence"/>
                        <field name="accepted_by_id" string="Matched by"/>
                        <field name="accepted_at" string="Matched on"/>
                    </list>
                </field>
            </xpath>
        </field>
    </record>
</odoo>
