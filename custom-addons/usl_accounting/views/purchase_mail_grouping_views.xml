<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_mail_grouping_form" model="ir.ui.view">
        <field name="name">account.move.purchase.mail.grouping</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <field name="usl_mail_grouping_needs_review" invisible="1"/>
                <div class="alert alert-warning d-flex flex-wrap align-items-center gap-2 mb-0" role="alert" invisible="not usl_mail_grouping_needs_review">
                    <div class="flex-grow-1">
                        <strong>Check the attachment grouping</strong>
                        <div>Some documents could not be matched to an invoice with confidence. Their original files are kept on this bill. Review them before deciding how to proceed.</div>
                    </div>
                    <button name="action_review_mail_grouping" type="object" string="Review attachments" class="btn btn-secondary"/>
                </div>
            </xpath>
            <xpath expr="//page[@name='other_info']" position="inside">
                <group string="Mail attachments" invisible="not usl_mail_grouping">
                    <field name="usl_mail_grouping" invisible="1"/>
                    <field name="usl_mail_grouping_summary" nolabel="1" colspan="2"/>
                    <button name="action_review_mail_grouping" type="object" string="Review attachments" class="btn-link" invisible="usl_mail_grouping_needs_review"/>
                    <field name="usl_mail_grouping_reviewed_by" invisible="not usl_mail_grouping_reviewed_by"/>
                    <field name="usl_mail_grouping_reviewed_at" invisible="not usl_mail_grouping_reviewed_at"/>
                </group>
                <group string="Bills from this email" invisible="not usl_mail_grouping" col="1">
                    <field name="usl_mail_grouping_move_ids" nolabel="1">
                        <list create="0" delete="0">
                            <field name="display_name"/>
                            <field name="message_main_attachment_id"/>
                            <field name="state"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
    <record id="purchase_mail_grouping_search" model="ir.ui.view">
        <field name="name">account.move.purchase.mail.grouping.search</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='to_check']" position="attributes">
                <attribute name="domain">['|', '&amp;', ('review_state', 'in', ('todo', 'anomaly')), ('state', '=', 'posted'), '&amp;', ('usl_mail_grouping_needs_review', '=', True), ('state', 'in', ('draft', 'posted'))]</attribute>
            </xpath>
        </field>
    </record>
    <record id="purchase_mail_grouping_review_form" model="ir.ui.view">
        <field name="name">usl.purchase.mail.grouping.review.form</field>
        <field name="model">usl.purchase.mail.grouping.review</field>
        <field name="arch" type="xml">
            <form string="Review attachments">
                <p>Choose how to use each file. Keep supporting files here, choose the main document, or copy files for another invoice to a new draft bill.</p>
                <field name="move_id" invisible="1"/>
                <field name="fingerprint" invisible="1"/>
                <field name="has_separate_files" invisible="1"/>
                <field name="line_ids" nolabel="1" class="o_purchase_attachment_choices" context="{'bin_size': True}">
                    <list editable="bottom" create="0" delete="0">
                        <field name="attachment_id" column_invisible="1"/>
                        <field name="name" column_invisible="1"/>
                        <field name="raw" widget="binary" filename="name" readonly="1"/>
                        <field name="use" widget="usl_purchase_attachment_use" width="180px"/>
                    </list>
                </field>
                <div class="text-muted mt-2" invisible="not has_separate_files">Files marked Another invoice will be copied together to one new draft. Originals stay here. Complete the new bill's invoice details before posting.</div>
                <details class="mt-3">
                    <summary>Original attachment evidence</summary>
                    <field name="summary" nolabel="1" class="mt-2"/>
                </details>
                <footer>
                    <button name="action_keep_together" type="object" string="Confirm" class="btn-primary" invisible="has_separate_files"/>
                    <button name="action_create_draft_bill" type="object" string="Create draft bill" help="Copy the selected files to one empty draft bill. Keep the source originals and complete the new bill before posting." class="btn-primary" invisible="not has_separate_files"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
