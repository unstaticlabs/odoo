<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vendor_bill_merge_inspection_form" model="ir.ui.view">
        <field name="name">account.move.vendor.bill.merge.inspection</field>
        <field name="model">account.move</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form string="Inspect this bill" create="false" edit="false" delete="false" duplicate="false">
                <sheet>
                    <div class="alert alert-info" role="status">Read-only inspection. Close these details to return to your choice; confirm the merge separately in the comparison.</div>
                    <group>
                        <group>
                            <field name="id" readonly="1" />
                            <field name="name" readonly="1" />
                            <field name="ref" readonly="1" />
                            <field name="partner_id" readonly="1" options="{'no_open': True}" />
                            <field name="partner_bank_id" readonly="1" options="{'no_open': True}" />
                            <field name="state" readonly="1" />
                            <field name="payment_state" readonly="1" />
                        </group>
                        <group>
                            <field name="company_id" readonly="1" options="{'no_open': True}" />
                            <field name="journal_id" readonly="1" options="{'no_open': True}" />
                            <field name="currency_id" readonly="1" options="{'no_open': True}" />
                            <field name="company_currency_id" readonly="1" options="{'no_open': True}" />
                            <field name="invoice_date" readonly="1" />
                            <field name="date" readonly="1" />
                            <field name="invoice_date_due" readonly="1" />
                            <field name="invoice_payment_term_id" readonly="1" options="{'no_open': True}" />
                            <field name="fiscal_position_id" readonly="1" options="{'no_open': True}" />
                        </group>
                    </group>
                    <group>
                        <field name="invoice_origin" readonly="1" />
                        <field name="payment_reference" readonly="1" />
                        <field name="invoice_currency_rate" readonly="1" />
                        <field name="amount_untaxed" readonly="1" />
                        <field name="amount_tax" readonly="1" />
                        <field name="amount_total" readonly="1" />
                        <field name="amount_residual" readonly="1" />
                    </group>
                    <notebook>
                        <page string="Invoice lines" name="inspection_invoice_lines">
                            <field name="invoice_line_ids" readonly="1" write="0">
                                <list create="false" edit="false" delete="false">
                                    <field name="name" />
                                    <field name="account_id" options="{'no_open': True}" />
                                    <field name="quantity" />
                                    <field name="price_unit" />
                                    <field name="discount" />
                                    <field name="tax_ids" widget="many2many_tags" readonly="1" write="0" />
                                    <field name="tax_tag_ids" widget="many2many_tags" readonly="1" write="0" />
                                    <field name="analytic_distribution" widget="analytic_distribution" readonly="1" />
                                    <field name="currency_id" column_invisible="1" />
                                    <field name="price_total" />
                                </list>
                                <form create="false" edit="false" delete="false">
                                    <sheet>
                                        <group>
                                            <field name="name" readonly="1" />
                                            <field name="product_id" readonly="1" options="{'no_open': True}" />
                                            <field name="account_id" readonly="1" options="{'no_open': True}" />
                                            <field name="quantity" readonly="1" />
                                            <field name="product_uom_id" readonly="1" options="{'no_open': True}" />
                                            <field name="price_unit" readonly="1" />
                                            <field name="discount" readonly="1" />
                                            <field name="tax_ids" widget="many2many_tags" readonly="1" write="0" />
                                            <field name="tax_tag_ids" widget="many2many_tags" readonly="1" write="0" />
                                            <field name="analytic_distribution" widget="analytic_distribution" readonly="1" />
                                            <field name="currency_id" readonly="1" options="{'no_open': True}" />
                                            <field name="price_subtotal" readonly="1" />
                                            <field name="price_total" readonly="1" />
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page string="Journal items" name="inspection_journal_items">
                            <field name="line_ids" readonly="1" write="0">
                                <list create="false" edit="false" delete="false">
                                    <field name="name" />
                                    <field name="account_id" options="{'no_open': True}" />
                                    <field name="debit" />
                                    <field name="credit" />
                                    <field name="balance" />
                                    <field name="currency_id" />
                                    <field name="amount_currency" />
                                    <field name="tax_ids" widget="many2many_tags" readonly="1" write="0" />
                                    <field name="tax_tag_ids" widget="many2many_tags" readonly="1" write="0" />
                                    <field name="analytic_distribution" widget="analytic_distribution" readonly="1" />
                                </list>
                                <form create="false" edit="false" delete="false">
                                    <sheet>
                                        <group>
                                            <field name="name" readonly="1" />
                                            <field name="account_id" readonly="1" options="{'no_open': True}" />
                                            <field name="partner_id" readonly="1" options="{'no_open': True}" />
                                            <field name="date" readonly="1" />
                                            <field name="date_maturity" readonly="1" />
                                            <field name="debit" readonly="1" />
                                            <field name="credit" readonly="1" />
                                            <field name="balance" readonly="1" />
                                            <field name="currency_id" readonly="1" options="{'no_open': True}" />
                                            <field name="amount_currency" readonly="1" />
                                            <field name="tax_line_id" readonly="1" options="{'no_open': True}" />
                                            <field name="tax_repartition_line_id" readonly="1" options="{'no_open': True}" />
                                            <field name="tax_tag_ids" widget="many2many_tags" readonly="1" write="0" />
                                            <field name="analytic_distribution" widget="analytic_distribution" readonly="1" />
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page string="Original files" name="inspection_original_files">
                            <field name="attachment_ids" readonly="1" write="0" context="{'bin_size': True}">
                                <list create="false" edit="false" delete="false">
                                    <field name="name" />
                                    <field name="mimetype" />
                                    <field name="file_size" />
                                    <field name="raw" widget="binary" filename="name" readonly="1" />
                                </list>
                                <form create="false" edit="false" delete="false">
                                    <sheet>
                                        <group>
                                            <field name="name" readonly="1" />
                                            <field name="mimetype" readonly="1" />
                                            <field name="raw" widget="binary" filename="name" readonly="1" />
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page string="History" name="inspection_history">
                            <field name="message_ids" readonly="1" write="0" domain="[('model', '=', 'account.move')]">
                                <list create="false" edit="false" delete="false">
                                    <field name="date" />
                                    <field name="author_id" options="{'no_open': True}" />
                                    <field name="subject" />
                                </list>
                                <form create="false" edit="false" delete="false">
                                    <sheet>
                                        <group>
                                            <field name="date" readonly="1" />
                                            <field name="author_id" readonly="1" options="{'no_open': True}" />
                                            <field name="subject" readonly="1" />
                                        </group>
                                        <field name="body" widget="html_mail" readonly="1" />
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                    <field name="narration" readonly="1" />
                </sheet>
            </form>
        </field>
    </record>
    <record id="vendor_bill_merge_wizard_form" model="ir.ui.view">
        <field name="name">usl.vendor.bill.merge.wizard.form</field>
        <field name="model">usl.vendor.bill.merge.wizard</field>
        <field name="arch" type="xml">
            <form string="Choose the bill to keep" create="false" delete="false">
                <field name="id" invisible="1"/>
                <div class="alert alert-info" role="status">These bills differ. Keep one bill's existing content and amount. The other bills will be cancelled and remain available with their original files and history. The kept bill will be marked To Review.</div>
                <field name="difference_summary" readonly="1" nolabel="1" class="fw-semibold"/>
                <p class="text-muted">Open a record number to inspect the bill, then return here to choose.</p>
                <field name="bill_ids" readonly="1" write="0" context="{'form_view_ref': 'usl_accounting.vendor_bill_merge_inspection_form'}">
                    <list create="false" delete="false" edit="false">
                        <field name="id" string="Record"/><field name="partner_id"/><field name="ref"/>
                        <field name="invoice_date"/><field name="state"/>
                        <field name="partner_bank_id"/>
                        <field name="currency_id" column_invisible="1"/>
                        <field name="amount_total" widget="monetary"/>
                        <button name="action_choose_vendor_bill_merge_winner" type="object" string="Choose this bill" context="{'vendor_bill_merge_wizard_id': parent.id}"/>
                    </list>
                </field>
                <field name="winning_bill_id" invisible="1"/>
                <group invisible="not winning_bill_id"><field name="winning_details" readonly="1"/></group>
                <footer><button name="action_merge" type="object" string="Keep this bill and merge" class="btn-primary" invisible="not winning_bill_id"/><button string="Cancel" special="cancel"/></footer>
            </form>
        </field>
    </record>
    <record id="vendor_bill_merge_list" model="ir.ui.view">
        <field name="name">account.invoice.list.vendor.bill.merge</field><field name="model">account.move</field><field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside"><button name="action_merge_vendor_bills" type="object" string="Merge Bills" groups="account.group_account_invoice" invisible="context.get('default_move_type') != 'in_invoice'"/></xpath>
            <xpath expr="//field[@name='review_state']" position="after"><field name="review_state" string="Review" widget="badge" readonly="1" optional="show" groups="account.group_account_invoice,!account.group_account_user" column_invisible="context.get('default_move_type') != 'in_invoice'" invisible="review_state not in ('todo', 'anomaly')" decoration-info="review_state == 'todo'" decoration-danger="review_state == 'anomaly'"/></xpath>
        </field>
    </record>
    <record id="vendor_bill_merge_form" model="ir.ui.view">
        <field name="name">account.move.vendor.bill.merge</field><field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_vendor_bill_merge_originals" type="object" class="oe_stat_button" icon="fa-files-o" invisible="not vendor_bill_merge_original_count"><field name="vendor_bill_merge_original_count" widget="statinfo" string="Original Bills"/></button>
            </xpath>
            <xpath expr="//sheet" position="before">
                <field name="vendor_bill_merge_target_id" invisible="1"/>
                <div class="alert alert-info" role="status" invisible="not vendor_bill_merge_target_id or state != 'cancel'">This original bill is retained as a merged duplicate. Its files and history stay here. <button name="action_open_vendor_bill_merge_target" type="object" string="Open the bill kept" class="btn btn-link"/> Use Reset to Draft to restore this bill independently.</div>
            </xpath>
            <xpath expr="//header/field[@name='review_state']" position="before"><field name="review_state" widget="badge" readonly="1" class="ms-auto me-3 align-self-center" groups="account.group_account_invoice" invisible="move_type != 'in_invoice' or state != 'draft' or review_state not in ('todo', 'anomaly')" decoration-info="review_state == 'todo'" decoration-danger="review_state == 'anomaly'"/></xpath>
        </field>
    </record>
    <record id="vendor_bill_merge_search" model="ir.ui.view">
        <field name="name">account.move.vendor.bill.merge.search</field><field name="model">account.move</field><field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml"><xpath expr="//filter[@name='to_check']" position="attributes"><attribute name="domain">[('review_state', 'in', ('todo', 'anomaly')), '|', ('state', '=', 'posted'), '&amp;', ('state', '=', 'draft'), ('move_type', '=', 'in_invoice')]</attribute></xpath></field>
    </record>
</odoo>
