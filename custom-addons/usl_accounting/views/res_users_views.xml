<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_multi_company_expenses" model="ir.ui.view">
        <field name="name">res.users.form.multi.company.expenses</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']//field[@name='company_id']" position="after">
                <field
                    name="usl_expense_multi_company"
                    groups="base.group_system"
                    invisible="share"
                    help="Create and maintain one company-specific employee profile for each allowed company. This shares the person and login, not contracts, payroll, approvals or accounting records."/>
                <field
                    name="usl_expense_excluded_company_ids"
                    widget="many2many_tags"
                    domain="[('id', 'in', company_ids)]"
                    groups="base.group_system"
                    invisible="not usl_expense_multi_company"
                    options="{'no_create': True, 'no_open': True}"/>
                <field
                    name="usl_expense_company_profile_status"
                    widget="badge"
                    readonly="1"
                    groups="base.group_system"
                    invisible="not usl_expense_multi_company"
                    decoration-success="usl_expense_company_profile_status == 'ready'"
                    decoration-warning="usl_expense_company_profile_status == 'attention'"/>
                <field
                    name="usl_expense_company_profile_message"
                    readonly="1"
                    groups="base.group_system"
                    invisible="not usl_expense_multi_company"/>
                <button
                    name="action_usl_sync_expense_company_profiles"
                    type="object"
                    string="Refresh expense access"
                    class="btn-secondary"
                    groups="base.group_system"
                    invisible="not usl_expense_multi_company"
                    title="Ensure this user has one active employee profile in each allowed company that is not excluded. Existing expenses and company-specific HR information are not merged or removed."/>
            </xpath>
        </field>
    </record>
</odoo>
