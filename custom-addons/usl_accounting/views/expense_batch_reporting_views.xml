<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_line_tree_expense_batch" model="ir.ui.view">
        <field name="name">account.move.line.list.expense.batch</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="expense_batch_id" optional="hide"/>
                <field name="expense_payment_mode" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="view_account_move_line_filter_expense_batch" model="ir.ui.view">
        <field name="name">account.move.line.search.expense.batch</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_account_move_line_filter"/>
        <field name="arch" type="xml">
            <field name="journal_id" position="after">
                <field name="expense_batch_id"/>
                <field name="expense_payment_mode"/>
            </field>
            <filter name="journal" position="after">
                <filter name="group_by_expense_batch" string="Expense Batch" context="{'group_by': 'expense_batch_id'}"/>
                <filter name="group_by_expense_payer" string="Expense Payer" context="{'group_by': 'expense_payment_mode'}"/>
            </filter>
        </field>
    </record>

    <record id="view_move_line_pivot_expense_batch" model="ir.ui.view">
        <field name="name">account.move.line.pivot.expense.batch</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_pivot"/>
        <field name="arch" type="xml">
            <field name="journal_id" position="after">
                <field name="expense_batch_id" type="row"/>
                <field name="expense_payment_mode" type="row"/>
            </field>
        </field>
    </record>

    <record id="view_account_analytic_line_tree_expense_batch" model="ir.ui.view">
        <field name="name">account.analytic.line.list.expense.batch</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_line_tree"/>
        <field name="arch" type="xml">
            <field name="account_id" position="after">
                <field name="expense_batch_id" optional="hide"/>
                <field name="expense_payment_mode" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="view_account_analytic_line_filter_expense_batch" model="ir.ui.view">
        <field name="name">account.analytic.line.search.expense.batch</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_line_filter"/>
        <field name="arch" type="xml">
            <field name="date" position="after">
                <field name="expense_batch_id"/>
                <field name="expense_payment_mode"/>
            </field>
            <filter name="group_date" position="after">
                <filter name="group_expense_batch" string="Expense Batch" context="{'group_by': 'expense_batch_id'}"/>
                <filter name="group_expense_payer" string="Expense Payer" context="{'group_by': 'expense_payment_mode'}"/>
            </filter>
        </field>
    </record>

    <record id="view_account_analytic_line_pivot_expense_batch" model="ir.ui.view">
        <field name="name">account.analytic.line.pivot.expense.batch</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_line_pivot"/>
        <field name="arch" type="xml">
            <field name="account_id" position="after">
                <field name="expense_batch_id" type="row"/>
                <field name="expense_payment_mode" type="row"/>
            </field>
        </field>
    </record>
</odoo>
