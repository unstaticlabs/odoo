<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_immediate_settlement_company_rule" model="ir.rule">
        <field name="name">Immediate settlements by company</field>
        <field name="model_id" ref="model_account_immediate_settlement"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('account.group_account_user'))]"/>
    </record>

    <record id="account_immediate_settlement_allocation_company_rule" model="ir.rule">
        <field name="name">Immediate settlement allocations by company</field>
        <field name="model_id" ref="model_account_immediate_settlement_allocation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('account.group_account_user'))]"/>
    </record>
</odoo>
