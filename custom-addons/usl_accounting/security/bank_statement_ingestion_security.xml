<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_bank_ingestion_config_company" model="ir.rule">
        <field name="name">Bank export routes: allowed companies</field>
        <field name="model_id" ref="model_account_bank_ingestion_config"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('account.group_account_manager'))]"/>
    </record>
    <record id="rule_bank_ingestion_company" model="ir.rule">
        <field name="name">Received bank exports: allowed companies</field>
        <field name="model_id" ref="model_account_bank_ingestion"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('account.group_account_readonly'))]"/>
    </record>
    <record id="rule_bank_ingestion_file_company" model="ir.rule">
        <field name="name">Bank export files: allowed companies</field>
        <field name="model_id" ref="model_account_bank_ingestion_file"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('account.group_account_readonly'))]"/>
    </record>
    <record id="rule_bank_statement_certification_company" model="ir.rule">
        <field name="name">Bank statement certification: allowed companies</field>
        <field name="model_id" ref="model_account_bank_statement_certification"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('account.group_account_readonly'))]"/>
    </record>
    <record id="rule_bank_statement_exception_company" model="ir.rule">
        <field name="name">Bank statement exceptions: allowed companies</field>
        <field name="model_id" ref="model_account_bank_statement_exception"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('account.group_account_readonly'))]"/>
    </record>
</odoo>
