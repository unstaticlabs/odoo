<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sign_oca.sign_oca_root_menu" model="ir.ui.menu">
        <field name="name">Sign</field>
        <field name="action" eval="'ir.actions.client,%d' % ref('sign_landing_action')"/>
        <field name="group_ids" eval="[(6, 0, [ref('usl_sign.group_sign_user'), ref('usl_sign.group_sign_identity_reviewer'), ref('usl_sign.group_sign_evidence_reviewer')])]"/>
    </record>
    <record id="sign_oca.sign_oca_template_menu" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="sign_oca.sign_oca_request_menu" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="sign_oca.sign_oca_settings_menu" model="ir.ui.menu">
        <field name="name">Configuration</field>
        <field name="sequence">90</field>
        <field name="group_ids" eval="[(6, 0, [ref('usl_sign.group_sign_user'), ref('usl_sign.group_sign_admin'), ref('usl_sign.group_sign_identity_reviewer'), ref('usl_sign.group_sign_evidence_reviewer')])]"/>
    </record>
    <record id="sign_oca.sign_oca_general_settings_menu" model="ir.ui.menu">
        <field name="name">Settings</field>
        <field name="active" eval="True"/>
        <field name="sequence">90</field>
        <field name="group_ids" eval="[(6, 0, [ref('usl_sign.group_sign_admin')])]"/>
    </record>
    <record id="sign_oca.sign_oca_role_menu" model="ir.ui.menu">
        <field name="name">Signing Roles</field>
        <field name="sequence">50</field>
        <field name="group_ids" eval="[(6, 0, [ref('usl_sign.group_sign_template_manager')])]"/>
    </record>
    <record id="sign_oca.sign_oca_field_menu" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <record id="sign_service_status_action" model="ir.actions.act_window">
        <field name="name">System Status</field>
        <field name="res_model">usl.sign.service.health</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="sign_service_health_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No signing capability checks are available</p>
            <p>Capability checks are created automatically for each company. Ask a Sign administrator to verify the module installation.</p>
        </field>
    </record>
    <record id="my_sign_identity_server_action" model="ir.actions.server">
        <field name="name">My Signing Identity</field>
        <field name="model_id" ref="model_usl_sign_enrollment"/>
        <field name="group_ids" eval="[(6, 0, [ref('usl_sign.group_sign_user')])]"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_my_identity()</field>
    </record>

    <menuitem id="sign_dashboard_menu" name="Sign Dashboard" parent="sign_oca.sign_oca_root_menu" action="sign_landing_action" sequence="5" active="False" groups="usl_sign.group_sign_user,usl_sign.group_sign_identity_reviewer,usl_sign.group_sign_evidence_reviewer"/>
    <menuitem id="request_signature_menu" name="Request Signature" parent="sign_oca.sign_oca_root_menu" sequence="10" groups="usl_sign.group_sign_user,usl_sign.group_sign_evidence_reviewer"/>
    <menuitem id="request_signature_templates_menu" name="Templates" parent="request_signature_menu" action="sign_oca.sign_oca_template_act_window" sequence="10" groups="usl_sign.group_sign_user,usl_sign.group_sign_evidence_reviewer"/>
    <menuitem id="request_signature_open_menu" name="Open Requests" parent="request_signature_menu" action="sign_request_action" sequence="20" groups="usl_sign.group_sign_user"/>
    <menuitem id="request_signature_completed_menu" name="Completed" parent="request_signature_menu" action="completed_documents_action" sequence="30" groups="usl_sign.group_sign_user,usl_sign.group_sign_evidence_reviewer"/>
    <menuitem id="my_signatures_menu" name="My Signatures" parent="sign_oca.sign_oca_root_menu" action="my_signatures_action" sequence="20" groups="usl_sign.group_sign_user"/>

    <menuitem id="my_sign_identity_menu" name="My Signing Identity" parent="sign_oca.sign_oca_settings_menu" action="my_sign_identity_server_action" sequence="10" groups="usl_sign.group_sign_user"/>
    <menuitem id="sign_enrollment_menu" name="Signer Identity Reviews" parent="sign_oca.sign_oca_settings_menu" action="sign_enrollment_action" sequence="20" groups="usl_sign.group_sign_identity_reviewer"/>
    <menuitem id="sign_policy_menu" name="Signing Policies" parent="sign_oca.sign_oca_settings_menu" action="sign_policy_action" sequence="30" groups="usl_sign.group_sign_admin"/>
    <menuitem id="sign_external_provider_menu" name="External Providers" parent="sign_oca.sign_oca_settings_menu" action="sign_external_provider_action" sequence="40" groups="usl_sign.group_sign_admin"/>
    <menuitem id="sign_service_status_menu" name="System Status" parent="sign_oca.sign_oca_settings_menu" action="sign_service_status_action" sequence="70" groups="usl_sign.group_sign_admin"/>
    <menuitem id="sign_daily_manifest_menu" name="Daily Timestamps" parent="sign_oca.sign_oca_settings_menu" action="sign_daily_manifest_action" sequence="80" groups="usl_sign.group_sign_evidence_reviewer,usl_sign.group_sign_admin"/>
</odoo>
