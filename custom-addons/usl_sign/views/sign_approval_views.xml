<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        DORMANT: this file is intentionally not loaded by the module manifest.
        Internal Decision requests are outside the current document-signing
        product. Activation requires a separate product and security review.
    -->
    <record id="sign_approval_search" model="ir.ui.view">
        <field name="name">usl.sign.approval.search</field>
        <field name="model">usl.sign.approval</field>
        <field name="arch" type="xml">
            <search string="Decision requests">
                <field name="name"/>
                <field name="record_ref"/>
                <field name="requested_by_id"/>
                <field name="approver_ids"/>
                <filter name="awaiting_me" string="Waiting for me" domain="[('state', '=', 'waiting'), ('response_ids.user_id', '=', uid), ('response_ids.state', '=', 'pending')]"/>
                <filter name="recovery" string="Action required" domain="[('state', '=', 'action_required')]"/>
                <filter name="completed" string="Completed" domain="[('state', '=', 'completed')]"/>
                <separator/>
                <filter name="by_outcome" string="Outcome" context="{'group_by': 'outcome'}"/>
                <filter name="by_requester" string="Requester" context="{'group_by': 'requested_by_id'}"/>
                <filter name="by_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
            </search>
        </field>
    </record>

    <record id="sign_approval_list" model="ir.ui.view">
        <field name="name">usl.sign.approval.list</field>
        <field name="model">usl.sign.approval</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'completed' and outcome == 'approved'" decoration-danger="state == 'completed' and outcome == 'rejected'" decoration-warning="state == 'action_required'">
                <field name="name" string="Decision"/>
                <field name="record_ref"/>
                <field name="requested_by_id"/>
                <field name="response_progress" string="Progress"/>
                <field name="decision_rule" optional="show"/>
                <field name="due_date" optional="show"/>
                <field name="outcome" widget="badge" decoration-success="outcome == 'approved'" decoration-danger="outcome == 'rejected'" decoration-muted="outcome in ['pending', 'cancelled']"/>
                <field name="state" widget="badge" decoration-info="state in ['draft', 'waiting', 'finalizing']" decoration-success="state == 'completed'" decoration-warning="state == 'action_required'"/>
                <field name="proof_status" optional="hide" widget="badge"/>
                <field name="archive_status" optional="hide" widget="badge"/>
                <field name="completed_at" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="sign_approval_form" model="ir.ui.view">
        <field name="name">usl.sign.approval.form</field>
        <field name="model">usl.sign.approval</field>
        <field name="arch" type="xml">
            <form string="Decision request">
                <header>
                    <button name="action_send" type="object" string="Send request" class="btn-primary" invisible="not can_send"/>
                    <button name="action_open_approve" type="object" string="Approve" class="btn-primary" invisible="not can_respond"/>
                    <button name="action_open_reject" type="object" string="Reject" class="btn-secondary" invisible="not can_respond"/>
                    <button name="action_retry_proof" type="object" string="Retry proof" class="btn-primary" invisible="not can_retry" groups="usl_sign.group_sign_user,usl_sign.group_sign_evidence_reviewer"/>
                    <button name="action_open_cancel" type="object" string="Cancel request" invisible="not can_cancel"/>
                    <button name="action_open_record" type="object" string="Open linked record" invisible="not record_ref"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,waiting,finalizing,completed,action_required"/>
                    <field name="can_send" invisible="1"/>
                    <field name="can_respond" invisible="1"/>
                    <field name="can_cancel" invisible="1"/>
                    <field name="can_retry" invisible="1"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_archive" type="object" class="oe_stat_button" icon="fa-archive" invisible="not archive_document_id">
                            <div class="o_stat_info"><span class="o_stat_text">Paperless proof</span></div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Approved" bg_color="text-bg-success" invisible="state != 'completed' or outcome != 'approved'"/>
                    <widget name="web_ribbon" title="Rejected" bg_color="text-bg-danger" invisible="state != 'completed' or outcome != 'rejected'"/>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-secondary" invisible="state != 'completed' or outcome != 'cancelled'"/>
                    <widget name="web_ribbon" title="Action required" bg_color="text-bg-warning" invisible="state != 'action_required'"/>
                    <div class="oe_title">
                        <label for="name" string="Decision"/>
                        <h1><field name="name" placeholder="What needs to be decided?" readonly="state != 'draft'"/></h1>
                    </div>
                    <div class="alert alert-info d-flex align-items-start gap-2 mb-3" role="status" invisible="not next_step">
                        <i class="fa fa-compass mt-1" title="Next step"/>
                        <div><strong>Next step</strong><br/><field name="next_step" class="text-body"/></div>
                    </div>
                    <div class="alert alert-warning mb-3" role="alert" invisible="state != 'action_required'">
                        <strong>Proof needs attention.</strong>
                        <field name="last_error" class="d-block"/>
                        <field name="recovery_action" class="d-block"/>
                    </div>
                    <group>
                        <group string="Request">
                            <field name="record_ref" readonly="state != 'draft'" options="{'no_create': true}"/>
                            <field name="requested_by_id"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                            <field name="due_date" readonly="state != 'draft'"/>
                        </group>
                        <group string="Decision">
                            <field name="decision_rule" readonly="state != 'draft'"/>
                            <field name="response_progress"/>
                            <field name="outcome" widget="badge" decoration-success="outcome == 'approved'" decoration-danger="outcome == 'rejected'"/>
                            <field name="outcome_by_id" invisible="outcome == 'pending'"/>
                            <field name="outcome_at" invisible="outcome == 'pending'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Decision-makers" name="responses">
                            <field name="approver_ids" widget="many2many_tags" readonly="state != 'draft'" options="{'no_create': true}"/>
                            <field name="response_ids" nolabel="1" readonly="1">
                                <list create="0" delete="0" edit="0" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'">
                                    <field name="user_id" string="Decision-maker"/>
                                    <field name="state" widget="badge" decoration-info="state == 'pending'" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'"/>
                                    <field name="responded_at"/>
                                    <field name="reason" string="Note or reason"/>
                                </list>
                            </field>
                        </page>
                        <page string="Decision proof" name="proof" invisible="state in ['draft', 'waiting']">
                            <p class="text-muted">This receipt proves the attributable business decision and its tamper-evident history. It is not an electronic signature.</p>
                            <group>
                                <group>
                                    <field name="proof_status" widget="badge"/>
                                    <field name="receipt_sha256" string="Receipt SHA-256"/>
                                    <field name="signed_manifest_sha256" string="Manifest SHA-256"/>
                                    <field name="policy_version"/>
                                </group>
                                <group>
                                    <field name="archive_status" widget="badge"/>
                                    <field name="completed_at"/>
                                    <field name="daily_timestamp_status" string="Daily proof" widget="badge" invisible="not daily_timestamp_status"/>
                                    <field name="daily_timestamp_message" invisible="not daily_timestamp_message"/>
                                    <button name="action_open_daily_timestamp_proof" type="object" string="Open daily proof" class="btn-link" invisible="not daily_timestamp_manifest_id" groups="usl_sign.group_sign_evidence_reviewer"/>
                                    <field name="daily_timestamp_manifest_id" invisible="1"/>
                                    <field name="receipt_data" filename="receipt_filename" string="Decision proof PDF"/>
                                    <field name="receipt_filename" invisible="1"/>
                                    <field name="signed_manifest" filename="signed_manifest_filename" string="Signed manifest" groups="usl_sign.group_sign_evidence_reviewer"/>
                                    <field name="signed_manifest_filename" invisible="1"/>
                                    <field name="validation_report" filename="validation_report_filename" string="Validation report" groups="usl_sign.group_sign_evidence_reviewer"/>
                                    <field name="validation_report_filename" invisible="1"/>
                                </group>
                            </group>
                            <field name="outcome_reason" string="Recorded reason" invisible="not outcome_reason"/>
                        </page>
                        <page string="Timeline" name="timeline">
                            <field name="event_ids" nolabel="1" readonly="1">
                                <list create="0" delete="0" edit="0" default_order="sequence desc">
                                    <field name="sequence"/>
                                    <field name="occurred_at"/>
                                    <field name="event_type" string="Event"/>
                                    <field name="actor_id"/>
                                    <field name="authentication_method" optional="hide"/>
                                    <field name="reason" optional="show"/>
                                    <field name="event_hash" optional="hide" groups="usl_sign.group_sign_evidence_reviewer"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sign_approval_action" model="ir.actions.act_window">
        <field name="name">Decision requests</field>
        <field name="res_model">usl.sign.approval</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="sign_approval_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record a business decision</p>
            <p>Use a decision request when an attributable approval or rejection is sufficient and the document itself does not need a signature.</p>
        </field>
    </record>

    <record id="completed_decisions_action" model="ir.actions.act_window">
        <field name="name">Decisions</field>
        <field name="res_model">usl.sign.approval</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'completed')]</field>
        <field name="search_view_id" ref="sign_approval_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No completed decisions yet</p>
            <p>Completed decisions appear here only after their proof is validated and archived.</p>
        </field>
    </record>

    <record id="sign_approval_decision_wizard_form" model="ir.ui.view">
        <field name="name">usl.sign.approval.decision.wizard.form</field>
        <field name="model">usl.sign.approval.decision.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm decision">
                <sheet>
                    <div class="text-center mb-3">
                        <span class="fa fa-check-circle-o fa-3x text-success" invisible="decision != 'approve'" aria-label="Approve"/>
                        <span class="fa fa-times-circle-o fa-3x text-danger" invisible="decision != 'reject'" aria-label="Reject"/>
                        <span class="fa fa-ban fa-3x text-secondary" invisible="decision != 'cancel'" aria-label="Cancel"/>
                        <h3 class="mt-2"><field name="decision" readonly="1"/></h3>
                    </div>
                    <field name="approval_id" readonly="1" options="{'no_open': true}"/>
                    <div class="alert alert-info my-3" role="status"><field name="consequence" nolabel="1"/></div>
                    <field name="reason" placeholder="Optional note" invisible="decision in ['reject', 'cancel']"/>
                    <field name="reason" placeholder="Reason required" required="decision in ['reject', 'cancel']" invisible="decision not in ['reject', 'cancel']"/>
                </sheet>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"/>
                    <button string="Go back" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
