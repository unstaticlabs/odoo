<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sign_policy_list" model="ir.ui.view">
        <field name="name">usl.sign.policy.list</field>
        <field name="model">usl.sign.policy</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="version"/>
                <field name="document_category"/>
                <field name="signer_type"/>
                <field name="risk_level"/>
                <field name="recommendation"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="sign_policy_form" model="ir.ui.view">
        <field name="name">usl.sign.policy.form</field>
        <field name="model">usl.sign.policy</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="version"/>
                            <field name="sequence"/>
                            <field name="document_category"/>
                            <field name="signer_type"/>
                            <field name="risk_level"/>
                            <field name="formal_qes_required"/>
                        </group>
                        <group>
                            <field name="recommendation"/>
                            <field name="default_authentication" invisible="recommendation != 'standard'"/>
                            <field name="expiration_days"/>
                            <field name="reminder_days"/>
                            <field name="max_reminders"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason"/>
                        <field name="consequence"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="sign_policy_action" model="ir.actions.act_window">
        <field name="name">Trust Policies</field>
        <field name="res_model">usl.sign.policy</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
