<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sign_landing_action" model="ir.actions.client">
        <field name="name">Sign</field>
        <field name="tag">usl_sign.landing</field>
    </record>
    <record id="sign_start_form" model="ir.ui.view">
        <field name="name">usl.sign.start.form</field>
        <field name="model">usl.sign.start</field>
        <field name="arch" type="xml">
            <form string="Start">
                <sheet>
                    <field name="company_id" invisible="1"/>
                    <div class="oe_title">
                        <h2>Send a document for signature</h2>
                        <p class="text-muted">Upload a PDF, choose the signer, then place the fields they need to complete.</p>
                    </div>
                    <field name="signature_source" widget="radio" options="{'horizontal': true}" nolabel="1" class="mb-3"/>
                    <group invisible="signature_source != 'upload'">
                        <field name="document_data" filename="document_filename" required="signature_source == 'upload'"/>
                        <field name="document_filename" invisible="1"/>
                        <field name="signer_partner_id" required="signature_source == 'upload'" options="{'no_quick_create': true}" placeholder="Search for a contact or create one"/>
                        <field name="message" placeholder="Optional note shown to the signer"/>
                    </group>
                    <group invisible="signature_source != 'template'">
                        <field name="template_id" required="signature_source == 'template'" options="{'no_create': true}"/>
                    </group>
                    <details class="mt-3">
                        <summary class="text-muted">More options</summary>
                        <group class="mt-2">
                            <field name="name" placeholder="Defaults to the PDF or template name"/>
                            <field name="record_ref"/>
                        </group>
                    </details>
                </sheet>
                <footer>
                    <button name="action_continue" type="object" string="Add signing fields" class="btn-primary" invisible="signature_source != 'upload'"/>
                    <button name="action_continue" type="object" string="Choose signers" class="btn-primary" invisible="signature_source != 'template'"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="sign_start_action" model="ir.actions.act_window">
        <field name="name">Start</field>
        <field name="res_model">usl.sign.start</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
