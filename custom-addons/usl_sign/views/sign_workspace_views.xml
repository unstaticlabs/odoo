<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sign_landing_action" model="ir.actions.client">
        <field name="name">Sign</field>
        <field name="tag">usl_sign.landing</field>
    </record>
    <record id="sign_start_form" model="ir.ui.view">
        <field name="name">usl.sign.start.form</field>
        <field name="model">usl.sign.start</field>
        <field name="arch" type="xml">
            <form string="Start">
                <sheet>
                    <field name="company_id" invisible="1"/>
                    <div class="oe_title">
                        <h2>Request signatures</h2>
                        <p class="text-muted">Start from a reusable template or upload a PDF for this request.</p>
                    </div>
                    <group>
                        <field name="name" placeholder="A clear name for this request"/>
                        <field name="record_ref"/>
                    </group>
                    <group>
                        <field name="signature_source" widget="radio" options="{'horizontal': true}" nolabel="1"/>
                        <field name="template_id" invisible="signature_source != 'template'" required="signature_source == 'template'" options="{'no_create': true}"/>
                        <field name="document_data" filename="document_filename" invisible="signature_source != 'upload'" required="signature_source == 'upload'"/>
                        <field name="document_filename" invisible="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_continue" type="object" string="Continue" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="sign_start_action" model="ir.actions.act_window">
        <field name="name">Start</field>
        <field name="res_model">usl.sign.start</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
