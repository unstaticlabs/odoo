<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sign_landing_action" model="ir.actions.client">
        <field name="name">Sign</field>
        <field name="tag">usl_sign.landing</field>
    </record>
    <record id="signature_inspector_action" model="ir.actions.client">
        <field name="name">Check signatures</field>
        <field name="tag">usl_sign.signature_inspector</field>
    </record>
    <record id="sign_start_form" model="ir.ui.view">
        <field name="name">usl.sign.start.form</field>
        <field name="model">usl.sign.start</field>
        <field name="arch" type="xml">
            <form string="Request signatures" class="usl_sign_start_wizard">
                <sheet>
                    <field name="company_id" invisible="1"/>
                    <div class="oe_title">
                        <h2>Request signatures</h2>
                        <p class="text-muted">Choose a document and its signers. You will place fields and check every detail before anything is sent.</p>
                    </div>
                    <field name="signature_source" widget="radio" options="{'horizontal': true}" nolabel="1" class="mb-3"/>
                    <section class="usl_sign_start_section" invisible="signature_source != 'upload'">
                        <p class="usl_sign_step_label">Step 1</p>
                        <h3>Document</h3>
                        <p class="text-muted">Upload the PDF you want people to sign.</p>
                        <div class="usl_sign_start_input">
                            <field name="document_data" filename="document_filename" string="PDF to sign" required="signature_source == 'upload'"/>
                            <field name="document_filename" invisible="1"/>
                        </div>
                    </section>
                    <section class="usl_sign_start_section" invisible="signature_source != 'upload'">
                        <p class="usl_sign_step_label">Step 2</p>
                        <h3>Signers</h3>
                        <p class="text-muted">Add everyone who must sign. You will assign and place each person’s fields next.</p>
                        <div class="usl_sign_start_input">
                            <label for="signer_partner_ids" string="Who needs to sign?" class="o_form_label fw-semibold d-block mb-1"/>
                            <field name="signer_partner_ids" widget="many2many_tags" nolabel="1"
                                   required="signature_source == 'upload'" options="{'no_quick_create': true}"
                                   placeholder="Add one or more contacts"/>
                        </div>
                    </section>
                    <section class="usl_sign_start_section" invisible="signature_source != 'template'">
                        <p class="usl_sign_step_label">Step 1</p>
                        <h3>Template</h3>
                        <p class="text-muted">Choose a ready template. You will assign each signing role next.</p>
                        <div class="usl_sign_start_input">
                            <field name="template_id" nolabel="1" required="signature_source == 'template'" options="{'no_create': true}"/>
                        </div>
                    </section>
                    <section class="usl_sign_start_section">
                        <p class="usl_sign_step_label" invisible="signature_source != 'upload'">Step 3</p>
                        <p class="usl_sign_step_label" invisible="signature_source != 'template'">Step 2</p>
                        <h3>Signing method</h3>
                        <p class="text-muted">Choose how signers confirm and what proof is retained.</p>
                        <field name="requested_trust" widget="usl_sign_method_radio"
                               options="{'horizontal': true}" nolabel="1"
                               class="usl_sign_method_radio"/>
                        <div class="small text-muted mt-2" role="status" aria-live="polite">
                            <field name="signing_method_summary" nolabel="1" readonly="1"/>
                        </div>
                    </section>
                    <details class="usl_sign_start_more">
                        <summary>Request name, message and linked record</summary>
                        <group class="mt-2">
                            <field name="name" string="Request name" placeholder="Defaults to the PDF or template name"/>
                            <field name="message" string="Message to signers" placeholder="Optional note shown with the invitation"/>
                            <field name="record_ref" string="Related Odoo record"/>
                        </group>
                    </details>
                </sheet>
                <footer>
                    <button name="action_continue" type="object" string="Place signing fields" class="btn-primary" invisible="signature_source != 'upload'"/>
                    <button name="action_continue" type="object" string="Choose signers" class="btn-primary" invisible="signature_source != 'template'"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="sign_start_action" model="ir.actions.act_window">
        <field name="name">Request signatures</field>
        <field name="res_model">usl.sign.start</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
