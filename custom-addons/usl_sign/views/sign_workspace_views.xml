<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sign_landing_action" model="ir.actions.client">
        <field name="name">Sign</field>
        <field name="tag">usl_sign.landing</field>
    </record>
    <record id="signature_inspector_action" model="ir.actions.client">
        <field name="name">Check signatures</field>
        <field name="tag">usl_sign.signature_inspector</field>
    </record>
    <record id="sign_start_form" model="ir.ui.view">
        <field name="name">usl.sign.start.form</field>
        <field name="model">usl.sign.start</field>
        <field name="arch" type="xml">
            <form string="Request signatures" class="usl_sign_start_wizard">
                <sheet>
                    <field name="company_id" invisible="1"/>
                    <div class="oe_title usl_sign_start_intro">
                        <h2 class="mb-1">Request signatures</h2>
                        <p class="text-muted mb-0">Add the document, signers, and signing method. You will place fields next.</p>
                    </div>
                    <div class="usl_sign_start_source">
                        <field name="signature_source" widget="radio" options="{'horizontal': true}" nolabel="1"/>
                    </div>

                    <div class="usl_sign_start_grid" invisible="signature_source != 'upload'">
                        <section class="usl_sign_start_block">
                            <h3>Document</h3>
                            <label for="document_data" string="PDF to sign" class="o_form_label"/>
                            <field name="document_data" filename="document_filename" nolabel="1" required="signature_source == 'upload'"/>
                            <field name="document_filename" invisible="1"/>
                        </section>
                        <section class="usl_sign_start_block">
                            <h3>Signers</h3>
                            <label for="signer_partner_ids" string="Who needs to sign?" class="o_form_label"/>
                            <field name="signer_partner_ids" widget="many2many_tags" nolabel="1"
                                   required="signature_source == 'upload'" options="{'no_quick_create': true}"
                                   placeholder="Add one or more contacts"/>
                        </section>
                    </div>

                    <section class="usl_sign_start_block usl_sign_start_template" invisible="signature_source != 'template'">
                        <h3>Template</h3>
                        <label for="template_id" string="Template" class="o_form_label"/>
                        <field name="template_id" nolabel="1" required="signature_source == 'template'" options="{'no_create': true}"/>
                    </section>

                    <section class="usl_sign_start_block usl_sign_start_details">
                        <h3>Request details</h3>
                        <div class="usl_sign_start_grid">
                            <div class="usl_sign_start_field">
                                <label for="name" string="Request name" class="o_form_label"/>
                                <field name="name" nolabel="1" placeholder="Defaults to the PDF or template name"/>
                            </div>
                            <div class="usl_sign_start_field">
                                <label for="record_ref" string="Related Odoo record" class="o_form_label"/>
                                <field name="record_ref" nolabel="1"/>
                            </div>
                            <div class="usl_sign_start_field usl_sign_start_field_wide">
                                <label for="message" string="Message to signers" class="o_form_label"/>
                                <field name="message" nolabel="1" placeholder="Optional note shown with the invitation"/>
                            </div>
                        </div>
                    </section>

                    <section class="usl_sign_start_block usl_sign_start_method">
                        <h3>Signing method</h3>
                        <p class="text-muted">Choose how signers confirm and what proof is retained.</p>
                        <field name="requested_trust" widget="usl_sign_method_radio"
                               options="{'horizontal': true}" nolabel="1"
                               class="usl_sign_method_radio"/>
                    </section>
                </sheet>
                <footer>
                    <button name="action_continue" type="object" string="Place signing fields" class="btn-primary" invisible="signature_source != 'upload'"/>
                    <button name="action_continue" type="object" string="Choose signers" class="btn-primary" invisible="signature_source != 'template'"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="sign_start_action" model="ir.actions.act_window">
        <field name="name">Request signatures</field>
        <field name="res_model">usl.sign.start</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
