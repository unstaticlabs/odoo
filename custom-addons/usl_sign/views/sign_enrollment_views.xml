<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sign_enrollment_list" model="ir.ui.view">
        <field name="name">usl.sign.enrollment.list</field>
        <field name="model">usl.sign.enrollment</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'active'" decoration-danger="state == 'revoked'">
                <field name="partner_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="relationship_basis"/>
                <field name="state"/>
                <field name="reviewer_id"/>
                <field name="active_passkey_count"/>
                <field name="recovery_ready"/>
            </list>
        </field>
    </record>
    <record id="sign_enrollment_form" model="ir.ui.view">
        <field name="name">usl.sign.enrollment.form</field>
        <field name="model">usl.sign.enrollment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm_identity" type="object" string="Confirm Identity and Invite" class="btn-primary" invisible="state != 'pending_review'" groups="usl_sign.group_sign_identity_reviewer"/>
                    <button name="action_create_invitation" type="object" string="Register Recovery Passkey" invisible="state not in ['pending_passkey', 'active']" groups="usl_sign.group_sign_identity_reviewer"/>
                    <button name="action_open_revoke" type="object" string="Revoke Enrolment" invisible="state == 'revoked'" groups="usl_sign.group_sign_identity_reviewer"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending_review,pending_passkey,active,revoked"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="partner_id"/></h1></div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="relationship_basis" readonly="state != 'pending_review'"/>
                            <field name="relationship_reference" readonly="state != 'pending_review'"/>
                            <field name="policy_version" readonly="state != 'pending_review'"/>
                            <field name="review_note" readonly="state != 'pending_review'"/>
                        </group>
                        <group>
                            <field name="reviewer_id"/>
                            <field name="reviewed_at"/>
                            <field name="active_passkey_count"/>
                            <field name="recovery_ready"/>
                            <field name="revoked_at" invisible="not revoked_at"/>
                            <field name="revocation_reason" invisible="not revocation_reason"/>
                        </group>
                    </group>
                    <field name="passkey_ids" readonly="1">
                        <list create="0" delete="0" edit="0">
                            <field name="name"/>
                            <field name="state"/>
                            <field name="device_type"/>
                            <field name="backed_up"/>
                            <field name="created_at"/>
                            <field name="last_used_at"/>
                            <field name="status_reason" optional="hide"/>
                            <button name="action_mark_lost" type="object" string="Mark Lost" invisible="state != 'active'" groups="usl_sign.group_sign_identity_reviewer"/>
                            <button name="action_revoke" type="object" string="Revoke" invisible="state != 'active'" groups="usl_sign.group_sign_identity_reviewer"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="sign_passkey_status_wizard_form" model="ir.ui.view">
        <field name="name">usl.sign.passkey.status.wizard.form</field>
        <field name="model">usl.sign.passkey.status.wizard</field>
        <field name="arch" type="xml">
            <form string="Mark Passkey Unavailable">
                <group>
                    <field name="passkey_id"/>
                    <field name="status"/>
                    <field name="reason" placeholder="Record the reported loss or revocation reason."/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Confirm" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="sign_enrollment_revoke_wizard_form" model="ir.ui.view">
        <field name="name">usl.sign.enrollment.revoke.wizard.form</field>
        <field name="model">usl.sign.enrollment.revoke.wizard</field>
        <field name="arch" type="xml">
            <form string="Revoke Strong Signer Enrolment">
                <group>
                    <field name="enrollment_id"/>
                    <field name="reason" placeholder="Record why this identity enrolment is revoked."/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Revoke" class="btn-danger"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="sign_enrollment_action" model="ir.actions.act_window">
        <field name="name">Strong Signer Enrolments</field>
        <field name="res_model">usl.sign.enrollment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
