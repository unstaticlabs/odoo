<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Odoo 19 passes layout fragments as t-call attributes.  Keep this local
        wrapper around OCA Sign so the upstream module remains untouched while
        its portal application receives its assets and bootstrap code.
    -->
    <template id="portal_sign_document" name="USL Sign document">
        <t t-set="head">
            <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no"/>
            <meta name="robots" content="noindex,nofollow"/>
            <t t-call-assets="oca_sign.assets_frontend_sign" t-js="false"/>
            <t t-call-assets="oca_sign.assets_frontend_sign" t-css="false"/>
            <script type="text/javascript">
                odoo.define("usl_sign.document_portal", ["@sign_oca/components/sign_oca_pdf_portal/sign_oca_pdf_portal.esm"], function (require) {
                    const { initDocumentToSign } = require("@sign_oca/components/sign_oca_pdf_portal/sign_oca_pdf_portal.esm");
                    initDocumentToSign(document, <t t-out="json.dumps(sign_oca_backend_info)"/>)
                        .then(() =&gt; document.getElementById("usl_sign_loading")?.remove())
                        .catch(() =&gt; {
                            const status = document.getElementById("usl_sign_loading");
                            if (status) {
                                status.classList.add("alert", "alert-danger");
                                status.textContent = "The signing session could not be loaded. Refresh the page or ask the sender for a new invitation.";
                            }
                        });
                });
            </script>
        </t>
        <t t-call="web.layout"
           html_data="{'lang': sign_oca_backend_info['lang']}"
           head="head"
           body_classname.f="o_web_client o_portal_sign_document_body">
            <main id="usl_sign_loading" class="container py-5" role="status" aria-live="polite">
                <p>Loading the secure signing session…</p>
            </main>
        </t>
    </template>

    <template id="portal_sign_unavailable" name="Signing link unavailable">
        <t t-call="portal.frontend_layout">
            <main class="container py-5" style="max-width: 42rem;">
                <div class="alert alert-warning" role="alert">
                    <h1 class="h4">This signing link is unavailable</h1>
                    <p class="mb-0">It may have expired, been used, or been revoked. Ask the sender for a new invitation.</p>
                </div>
            </main>
        </t>
    </template>
    <template id="portal_sign_result" name="Signature result">
        <t t-call="portal.frontend_layout">
            <main class="container py-5" style="max-width: 42rem;">
                <div t-if="successful" class="alert alert-success" role="status">
                    <h1 class="h4">Your signature was recorded</h1>
                    <p class="mb-0">Other participants may still need to sign. When the request is complete, Odoo will validate the final document and prepare the evidence dossier.</p>
                </div>
                <div t-elif="declined" class="alert alert-info" role="status">
                    <h1 class="h4">Your refusal was recorded</h1>
                </div>
                <div t-else="" class="alert alert-danger" role="alert">
                    <h1 class="h4">The signature was not completed</h1>
                    <p class="mb-0">Return to the invitation or contact the sender.</p>
                </div>
            </main>
        </t>
    </template>
    <template id="portal_sign_email_otp" name="Signing email verification">
        <t t-call="portal.frontend_layout">
            <main class="container py-5" style="max-width: 32rem;">
                <h1 class="h3">Verify your email</h1>
                <p>Enter the eight-digit code sent to <strong t-out="signer.partner_id.email"/>. It expires in 10 minutes.</p>
                <div t-if="error" class="alert alert-danger" role="alert" t-out="error"/>
                <form method="post">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <label class="form-label" for="usl_email_otp">Verification code</label>
                    <input id="usl_email_otp" name="code" class="form-control form-control-lg" inputmode="numeric" pattern="[0-9]{8}" autocomplete="one-time-code" maxlength="8" required="required" autofocus="autofocus"/>
                    <button type="submit" class="btn btn-primary mt-3 w-100">Continue to the document</button>
                </form>
            </main>
        </t>
    </template>
    <template id="strong_sign_page" name="Strong personal signature">
        <html lang="en">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <title>Strong personal signature</title>
                <t t-call-assets="usl_sign.assets_strong" t-js="false"/>
            </head>
            <body>
                <main id="usl_strong_sign" class="usl-sign-shell" t-att-data-signer-id="signer.id" t-att-data-access-token="access_token" t-att-data-certificate-subject="('USL Sign Personal: %s' % signer.partner_id.name).replace(',', ' ')">
                    <p class="usl-sign-eyebrow">USL Sign</p>
                    <h1>Strong personal signature</h1>
                    <p class="usl-sign-muted">Designed for advanced-signature requirements. This wording is not a formal legal classification.</p>
                    <section class="usl-sign-card">
                        <h2 t-out="signer.request_id.name"/>
                        <p><strong>Exact document SHA-256:</strong> <code class="usl-sign-hash" t-out="signer.request_id.current_hash"/></p>
                        <iframe class="usl-sign-document" t-att-src="'/sign_oca/content/%s/%s' % (signer.id, access_token)" title="Document to sign"/>
                    </section>
                    <label class="usl-sign-consent" for="usl_strong_consent">
                        <input id="usl_strong_consent" type="checkbox"/>
                        <span>I reviewed this exact document and authorize my strong personal electronic signature using my Pocket ID passkey.</span>
                    </label>
                    <button id="usl_strong_sign_button" class="usl-sign-button">Open Pocket ID and sign</button>
                    <div id="usl_strong_status" class="usl-sign-status" role="status" aria-live="polite"/>
                </main>
                <script type="text/javascript" src="/usl_sign/static/src/js/strong_sign.js"></script>
            </body>
        </html>
    </template>
    <template id="strong_enrollment_page" name="Strong signer enrolment">
        <html lang="en">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <title>Connect Pocket ID to USL Sign</title>
                <t t-call-assets="usl_sign.assets_strong" t-js="false"/>
            </head>
            <body>
                <main id="usl_strong_enrollment" class="usl-sign-shell usl-sign-shell--compact" t-att-data-enrollment-id="enrollment.id" t-att-data-enrollment-token="enrollment_token">
                    <p class="usl-sign-eyebrow">USL Sign enrolment</p>
                    <h1>Connect Pocket ID</h1>
                    <p>Use your existing Pocket ID passkey to link the correct identity to this USL Sign enrolment under policy <t t-out="enrollment.policy_version"/>.</p>
                    <button id="usl_enroll_button" class="usl-sign-button">Continue to Pocket ID</button>
                    <div id="usl_enroll_status" class="usl-sign-status" role="status" aria-live="polite"/>
                    <div class="usl-sign-note">Pocket ID manages passkeys and recovery. USL Sign stores only the immutable Pocket ID identity link and reviewer decision, never passkey credentials.</div>
                </main>
                <script type="text/javascript" src="/usl_sign/static/src/js/strong_sign.js"></script>
            </body>
        </html>
    </template>
    <template id="pocketid_callback_result" name="Pocket ID authorization result">
        <html lang="en">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <title>Pocket ID authorization</title>
                <t t-call-assets="usl_sign.assets_strong" t-js="false"/>
            </head>
            <body>
                <main class="usl-sign-shell usl-sign-shell--compact">
                    <p class="usl-sign-eyebrow">USL Sign</p>
                    <div t-if="successful" class="alert alert-success" role="status">
                        <h1 class="h3">Pocket ID verified</h1>
                        <p class="mb-0">Return to the signing page. You can close this window.</p>
                    </div>
                    <div t-else="" class="alert alert-danger" role="alert">
                        <h1 class="h3">Authorization stopped</h1>
                        <p class="mb-0">Return to the signing page and start again. No signature was applied.</p>
                    </div>
                </main>
            </body>
        </html>
    </template>
</odoo>
