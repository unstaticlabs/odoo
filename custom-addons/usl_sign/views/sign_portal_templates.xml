<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Small, dependency-free vector motion for the public signer journey.
        The drawings are decorative: adjacent text remains the authoritative
        description, and strong_sign.scss exposes a static final frame when
        the reviewer prefers reduced motion.
    -->
    <template id="sign_motion" name="Signer journey motion">
        <span t-att-class="'usl-sign-motion usl-sign-motion--%s' % motion_variant"
              aria-hidden="true">
            <svg viewBox="0 0 160 120" focusable="false">
                <circle class="usl-sign-motion__backdrop" cx="80" cy="60" r="52"/>

                <g t-if="motion_variant == 'review'" class="usl-sign-motion__scene usl-sign-motion__scene--review">
                    <rect class="usl-sign-motion__paper" x="48" y="24" width="64" height="78" rx="7"/>
                    <path class="usl-sign-motion__fold" d="M94 24v18h18"/>
                    <path class="usl-sign-motion__ink usl-sign-motion__ink--one" d="M61 54h38"/>
                    <path class="usl-sign-motion__ink usl-sign-motion__ink--two" d="M61 66h31"/>
                    <path class="usl-sign-motion__ink usl-sign-motion__ink--three" d="M61 78h23"/>
                    <path class="usl-sign-motion__scan" d="M43 72h74"/>
                </g>

                <g t-elif="motion_variant == 'identity'" class="usl-sign-motion__scene usl-sign-motion__scene--identity">
                    <circle class="usl-sign-motion__person" cx="49" cy="50" r="9"/>
                    <path class="usl-sign-motion__person" d="M32 78c2-12 9-18 17-18s15 6 17 18"/>
                    <path class="usl-sign-motion__connection" d="M67 62h20"/>
                    <path class="usl-sign-motion__shield" d="M109 31c8 6 15 7 19 8v20c0 19-10 29-19 34-9-5-19-15-19-34V39c4-1 11-2 19-8Z"/>
                </g>

                <g t-elif="motion_variant == 'complete'" class="usl-sign-motion__scene usl-sign-motion__scene--complete">
                    <rect class="usl-sign-motion__paper" x="48" y="24" width="64" height="78" rx="7"/>
                    <path class="usl-sign-motion__fold" d="M94 24v18h18"/>
                    <path class="usl-sign-motion__ink" d="M61 56h38M61 68h27"/>
                    <circle class="usl-sign-motion__seal" cx="103" cy="88" r="16"/>
                    <path class="usl-sign-motion__check" d="m95 88 6 6 11-13"/>
                </g>

                <g t-else="" class="usl-sign-motion__journey">
                    <g class="usl-sign-motion__phase usl-sign-motion__phase--review">
                        <rect class="usl-sign-motion__paper" x="49" y="23" width="62" height="78" rx="7"/>
                        <path class="usl-sign-motion__fold" d="M94 23v18h17"/>
                        <path class="usl-sign-motion__ink" d="M61 55h38M61 67h31M61 79h20"/>
                        <path class="usl-sign-motion__scan" d="M44 74h72"/>
                    </g>
                    <g class="usl-sign-motion__phase usl-sign-motion__phase--identity">
                        <circle class="usl-sign-motion__person" cx="45" cy="53" r="8"/>
                        <path class="usl-sign-motion__person" d="M30 78c2-11 8-16 15-16s13 5 15 16"/>
                        <path class="usl-sign-motion__connection" d="M62 62h22"/>
                        <path class="usl-sign-motion__shield" d="M108 30c8 6 15 7 19 8v21c0 18-10 28-19 33-9-5-19-15-19-33V38c4-1 11-2 19-8Z"/>
                    </g>
                    <g class="usl-sign-motion__phase usl-sign-motion__phase--processing">
                        <rect class="usl-sign-motion__paper" x="51" y="24" width="58" height="74" rx="7"/>
                        <path class="usl-sign-motion__fold" d="M93 24v17h16"/>
                        <path class="usl-sign-motion__ink" d="M62 56h35M62 68h28"/>
                        <circle class="usl-sign-motion__progress" cx="105" cy="87" r="15"/>
                    </g>
                    <g class="usl-sign-motion__phase usl-sign-motion__phase--complete">
                        <rect class="usl-sign-motion__paper" x="49" y="23" width="62" height="78" rx="7"/>
                        <path class="usl-sign-motion__fold" d="M94 23v18h17"/>
                        <path class="usl-sign-motion__ink" d="M61 55h38M61 67h29"/>
                        <circle class="usl-sign-motion__seal" cx="104" cy="88" r="16"/>
                        <path class="usl-sign-motion__check" d="m96 88 6 6 11-13"/>
                    </g>
                    <g class="usl-sign-motion__phase usl-sign-motion__phase--error">
                        <circle class="usl-sign-motion__error" cx="80" cy="60" r="27"/>
                        <path class="usl-sign-motion__error-mark" d="M80 44v20M80 75v1"/>
                    </g>
                </g>
            </svg>
        </span>
    </template>

    <template id="secure_company_brand" name="Secure company signing brand">
        <header class="usl-sign-brand">
            <div class="usl-sign-brand__identity">
                <span class="usl-sign-brand__mark" aria-hidden="true">
                    <i class="fa fa-shield"/>
                </span>
                <span>
                    <span class="usl-sign-brand__product">Document signing</span>
                    <strong class="usl-sign-brand__company" t-out="company.name"/>
                </span>
            </div>
            <span class="usl-sign-security-pill">
                <i class="fa fa-lock" aria-hidden="true"/>
                Private signing session
            </span>
        </header>
    </template>

    <!--
        Odoo 19 passes layout fragments as t-call attributes. Keep this local
        wrapper around OCA Sign so the upstream module remains untouched while
        its portal application receives its assets and bootstrap code.
    -->
    <template id="secure_web_layout" name="Nonce-bearing signing layout" inherit_id="web.layout" primary="True">
        <xpath expr="//script[@id='web.layout.odooscript']" position="attributes">
            <attribute name="t-att-nonce">script_nonce if script_nonce else None</attribute>
        </xpath>
    </template>

    <template id="portal_sign_document" name="Company signing document">
        <t t-set="head">
            <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no"/>
            <meta name="robots" content="noindex,nofollow"/>
            <t t-call-assets="oca_sign.assets_frontend_sign" t-js="false"/>
            <t t-call-assets="oca_sign.assets_frontend_sign" t-css="false"/>
            <script type="text/javascript" t-att-nonce="script_nonce if strong_signing else None">
                odoo.define("usl_sign.document_portal", ["@sign_oca/components/sign_oca_pdf_portal/sign_oca_pdf_portal.esm"], function (require) {
                    const { initDocumentToSign } = require("@sign_oca/components/sign_oca_pdf_portal/sign_oca_pdf_portal.esm");
                    initDocumentToSign(document, <t t-out="json.dumps(sign_oca_backend_info)"/>)
                        .then(() =&gt; document.getElementById("usl_sign_loading")?.remove())
                        .catch(() =&gt; {
                            const status = document.getElementById("usl_sign_loading");
                            if (status) {
                                status.classList.add("alert", "alert-danger");
                                status.textContent = "The signing session could not be loaded. Refresh the page or ask the sender for a new invitation.";
                            }
                        });
                });
            </script>
        </t>
        <t t-call="usl_sign.secure_web_layout"
           html_data="{'lang': sign_oca_backend_info['lang']}"
           head="head"
           body_classname.f="o_web_client o_portal_sign_document_body">
            <main id="usl_sign_loading" class="container py-5" role="status" aria-live="polite">
                <p>Opening your document…</p>
            </main>
            <div t-if="strong_signing"
                 id="usl_strong_sign_context"
                 hidden="hidden"
                 data-active="false"
                 t-att-data-signer-id="signer.id"
                 t-att-data-access-token="access_token"
                 t-att-data-certificate-subject="certificate_subject"/>
        </t>
    </template>

    <template id="portal_sign_unavailable" name="Signing link unavailable">
        <t t-call="portal.frontend_layout">
            <t t-call-assets="usl_sign.assets_strong" t-js="false"/>
            <main class="usl-sign-public-page">
                <section class="usl-sign-public-card usl-sign-public-card--compact usl-sign-public-card--centered">
                    <span class="usl-sign-result-icon usl-sign-result-icon--warning" aria-hidden="true">
                        <i class="fa fa-link"/>
                    </span>
                    <h1>This link is no longer available</h1>
                    <p class="usl-sign-lead">It may have expired, already been used, or been cancelled.</p>
                    <p class="usl-sign-muted mb-0">Ask the sender for a new invitation if you still need to sign.</p>
                </section>
            </main>
        </t>
    </template>

    <template id="portal_sign_start" name="Review signature request">
        <t t-call="portal.frontend_layout">
            <t t-call-assets="usl_sign.assets_strong" t-js="false"/>
            <main class="usl-sign-public-page">
                <section class="usl-sign-public-card">
                    <t t-set="company" t-value="signer.request_id.company_id"/>
                    <t t-call="usl_sign.secure_company_brand"/>
                    <div class="usl-sign-public-card__body">
                        <div class="usl-sign-intro-layout">
                            <div>
                                <h1 t-out="signer.request_id.name"/>
                                <p class="usl-sign-lead">
                                    <t t-out="signer.request_id.company_id.name"/> has asked you to review and sign this document.
                                </p>
                            </div>
                            <t t-set="motion_variant" t-value="'review'"/>
                            <t t-call="usl_sign.sign_motion"/>
                        </div>
                        <dl class="usl-sign-summary">
                            <div><dt>Signing as</dt><dd t-out="signer.partner_id.name"/></div>
                            <div><dt>Your role</dt><dd t-out="signer.role_id.name"/></div>
                            <div t-if="signer.request_id.requested_trust != 'standard'"><dt>Signing method</dt><dd t-out="requested_trust_display"/></div>
                            <div t-if="due_display"><dt>Complete by</dt><dd t-out="due_display"/></div>
                        </dl>
                        <a class="usl-sign-button usl-sign-button--wide" t-att-href="'/sign/session/%s/%s?review=1' % (signer.id, access_token)">
                            Review document
                            <i class="fa fa-arrow-right" aria-hidden="true"/>
                        </a>
                        <p class="usl-sign-action-note">You can review the whole document before anything is signed.</p>
                    </div>
                </section>
            </main>
        </t>
    </template>

    <template id="portal_sign_result" name="Signature result">
        <t t-call="portal.frontend_layout">
            <t t-call-assets="usl_sign.assets_strong" t-js="false"/>
            <main class="usl-sign-public-page">
                <section class="usl-sign-public-card usl-sign-public-card--compact">
                    <t t-if="result_company">
                        <t t-set="company" t-value="result_company"/>
                        <t t-call="usl_sign.secure_company_brand"/>
                    </t>
                    <div class="usl-sign-public-card__body usl-sign-public-card__body--centered">
                        <t t-if="successful">
                            <t t-set="motion_variant" t-value="'complete'"/>
                            <t t-call="usl_sign.sign_motion"/>
                            <h1>You’re done</h1>
                            <p t-if="result_request_name" class="usl-sign-lead">Your signature has been saved for <strong t-out="result_request_name"/>.</p>
                            <p t-else="" class="usl-sign-lead">Your signature has been saved.</p>
                            <a t-if="result_download_url" class="usl-sign-button usl-sign-button--wide" t-att-href="result_download_url" download="download">
                                <i class="fa fa-download" aria-hidden="true"/>
                                <t t-if="final_document_ready">Download the final document</t>
                                <t t-else="">Download the current signed copy</t>
                            </a>
                            <p t-if="result_download_url and has_pending_signers" class="usl-sign-action-note mb-0">Other people still need to sign. This is the current signed copy, not the final document.</p>
                            <p t-elif="result_download_url and final_document_ready" class="usl-sign-action-note mb-0">Everyone has signed. This is the final document.</p>
                            <p t-elif="result_download_url" class="usl-sign-action-note mb-0">Everyone has signed. Final checks are still in progress; this is the current signed copy.</p>
                        </t>
                        <t t-elif="declined">
                            <span class="usl-sign-result-icon usl-sign-result-icon--neutral" aria-hidden="true"><i class="fa fa-ban"/></span>
                            <h1>You declined this document</h1>
                            <p class="usl-sign-muted mb-0">The sender can see your response.</p>
                        </t>
                        <t t-else="">
                            <span class="usl-sign-result-icon usl-sign-result-icon--danger" aria-hidden="true"><i class="fa fa-exclamation"/></span>
                            <h1>No signature was applied</h1>
                            <p class="usl-sign-muted mb-0">Return to your invitation and try again, or contact the sender.</p>
                        </t>
                    </div>
                </section>
            </main>
        </t>
    </template>

    <template id="portal_sign_email_otp" name="Signing email verification">
        <t t-call="portal.frontend_layout">
            <t t-call-assets="usl_sign.assets_strong" t-js="false"/>
            <main class="usl-sign-public-page">
                <section class="usl-sign-public-card usl-sign-public-card--compact">
                    <t t-set="company" t-value="signer.request_id.company_id"/>
                    <t t-call="usl_sign.secure_company_brand"/>
                    <div class="usl-sign-public-card__body">
                        <h1>Check your inbox</h1>
                        <p class="usl-sign-lead">Enter the 8-digit code sent to <strong t-out="signer.partner_id.email"/>.</p>
                        <div t-if="error" class="usl-sign-inline-status usl-sign-inline-status--danger" role="alert" t-out="error"/>
                        <form method="post" class="usl-sign-code-form">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <label for="usl_email_otp">Verification code</label>
                            <input id="usl_email_otp" name="code" class="usl-sign-code-input" inputmode="numeric" pattern="[0-9]{8}" autocomplete="one-time-code" maxlength="8" required="required" autofocus="autofocus" placeholder="00000000"/>
                            <button type="submit" class="usl-sign-button usl-sign-button--wide">Continue</button>
                        </form>
                        <p class="usl-sign-action-note">The code expires in 10 minutes. Do not share it.</p>
                    </div>
                </section>
            </main>
        </t>
    </template>

    <template id="strong_identity_required_page" name="Strong signing identity required">
        <html lang="en">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <meta name="robots" content="noindex,nofollow"/>
                <title>Set up your signing identity · <t t-out="signer.request_id.company_id.name"/></title>
                <t t-call-assets="usl_sign.assets_strong" t-js="false"/>
            </head>
            <body class="usl-sign-secure-body">
                <main class="usl-sign-shell usl-sign-shell--compact">
                    <t t-set="company" t-value="signer.request_id.company_id"/>
                    <t t-call="usl_sign.secure_company_brand"/>
                    <section class="usl-sign-public-card__body">
                        <t t-set="motion_variant" t-value="'identity'"/>
                        <t t-call="usl_sign.sign_motion"/>
                        <h1>Set up your signing identity first</h1>
                        <p class="usl-sign-lead">This document needs a reviewed signing identity. Nothing has been signed yet.</p>
                        <ol class="usl-sign-steps usl-sign-steps--enrollment" aria-label="Identity setup steps">
                            <li class="is-current"><span>1</span>Ask <t t-out="company.name"/> for your personal setup link</li>
                            <li><span>2</span>Connect your Pocket ID account</li>
                            <li><span>3</span>Wait for the identity review, then reopen the signing invitation</li>
                        </ol>
                        <div class="usl-sign-inline-status usl-sign-inline-status--warning mt-4" role="status">
                            <span class="usl-sign-status-icon" aria-hidden="true"><i class="fa fa-info-circle"/></span>
                            <span><strong>Contact the sender or an identity reviewer</strong><small>They can send the setup link and tell you when the review is complete.</small></span>
                        </div>
                    </section>
                </main>
            </body>
        </html>
    </template>

    <template id="strong_enrollment_page" name="Strong signer enrolment">
        <html lang="en">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <meta name="robots" content="noindex,nofollow"/>
                <title>Set up strong signatures · <t t-out="enrollment.company_id.name"/></title>
                <t t-call-assets="usl_sign.assets_strong" t-js="false"/>
            </head>
            <body class="usl-sign-secure-body">
                <main id="usl_strong_enrollment"
                      class="usl-sign-shell usl-sign-shell--compact"
                      data-phase="review"
                      t-att-data-enrollment-id="enrollment.id"
                      t-att-data-enrollment-token="enrollment_token"
                      t-att-data-company-name="enrollment.company_id.name">
                    <t t-set="company" t-value="enrollment.company_id"/>
                    <t t-call="usl_sign.secure_company_brand"/>
                    <section class="usl-sign-public-card__body">
                        <div class="usl-sign-intro-layout usl-sign-intro-layout--compact">
                            <div>
                                <h1>Connect your signing identity</h1>
                                <p class="usl-sign-lead">Connect the Pocket ID account you’ll use for strong personal signatures requested by <t t-out="enrollment.company_id.name"/>.</p>
                            </div>
                            <t t-set="motion_variant" t-value="'identity'"/>
                            <t t-call="usl_sign.sign_motion"/>
                        </div>
                        <dl class="usl-sign-summary">
                            <div><dt>Identity</dt><dd t-out="enrollment.partner_id.name"/></div>
                            <div><dt>Next step</dt><dd>Review by <t t-out="enrollment.company_id.name"/></dd></div>
                        </dl>
                        <ol class="usl-sign-steps usl-sign-steps--enrollment" aria-label="Identity setup progress">
                            <li data-step="review" class="is-current"><span>1</span>Connect account</li>
                            <li data-step="identity"><span>2</span>Identity review</li>
                            <li data-step="complete"><span>3</span>Ready to sign</li>
                        </ol>
                        <button id="usl_enroll_button" class="usl-sign-button usl-sign-button--wide" type="button">
                            <span class="usl-sign-button__spinner" aria-hidden="true"/>
                            <i class="fa fa-shield" aria-hidden="true"/>
                            <span class="usl-sign-button__label">Connect Pocket ID</span>
                        </button>
                        <p class="usl-sign-action-note"><i class="fa fa-external-link" aria-hidden="true"/> Pocket ID opens in a separate window. This only connects your account; it does not sign a document.</p>
                        <div id="usl_enroll_status" class="usl-sign-inline-status" role="status" aria-live="polite" aria-atomic="true" hidden="hidden">
                            <span class="usl-sign-status-icon" aria-hidden="true"><i class="fa fa-circle-o-notch"/></span>
                            <span><strong data-status-title=""/><small data-status-message=""/></span>
                            <button class="usl-sign-cancel-attempt" type="button" data-cancel-attempt="" hidden="hidden">Cancel</button>
                        </div>
                        <div class="usl-sign-privacy-note">
                            <i class="fa fa-lock" aria-hidden="true"/>
                            <p><strong>Your account stays under your control.</strong> Pocket ID keeps your passkeys. <t t-out="enrollment.company_id.name"/> stores only the account link and its review decision.</p>
                        </div>
                    </section>
                </main>
                <script type="text/javascript" src="/usl_sign/static/src/js/strong_sign.js"></script>
            </body>
        </html>
    </template>

    <template id="pocketid_callback_result" name="Pocket ID authorization result">
        <html lang="en">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <meta name="robots" content="noindex,nofollow"/>
                <title>Identity confirmation</title>
                <t t-call-assets="usl_sign.assets_strong" t-js="false"/>
            </head>
            <body class="usl-sign-secure-body usl-sign-callback-body">
                <main id="usl_pocketid_callback"
                      class="usl-sign-callback"
                      t-att-data-successful="'true' if successful else 'false'">
                    <span t-if="successful" class="usl-sign-result-icon usl-sign-result-icon--success usl-sign-result-icon--animated" aria-hidden="true"><i class="fa fa-check"/></span>
                    <span t-else="" class="usl-sign-result-icon usl-sign-result-icon--danger" aria-hidden="true"><i class="fa fa-exclamation"/></span>
                    <t t-if="successful and callback_purpose == 'enrollment'">
                        <h1>Account connected</h1>
                        <p>Your identity is ready for review. Returning you to the setup page…</p>
                    </t>
                    <t t-elif="successful">
                        <h1>Identity confirmed</h1>
                        <p>Returning to your document to complete the signature…</p>
                    </t>
                    <t t-elif="callback_purpose == 'enrollment'">
                        <h1>Account not connected</h1>
                        <p>Return to the setup page for a clear next step. You can safely try again.</p>
                    </t>
                    <t t-else="">
                        <h1>Signature not completed</h1>
                        <p>Nothing was signed. Return to the document for a clear next step.</p>
                    </t>
                    <p t-if="company_name" class="usl-sign-callback-company">Requested by <t t-out="company_name"/></p>
                    <button id="usl_callback_close" class="usl-sign-button usl-sign-button--quiet" type="button">Close this window</button>
                </main>
                <script type="text/javascript" src="/usl_sign/static/src/js/strong_sign.js"></script>
            </body>
        </html>
    </template>
</odoo>
