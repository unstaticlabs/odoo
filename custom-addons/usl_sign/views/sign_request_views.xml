<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sign_request_form_usl" model="ir.ui.view">
        <field name="name">sign.oca.request.form.usl.journey</field>
        <field name="model">sign.oca.request</field>
        <field name="priority">2</field>
        <field name="arch" type="xml">
            <form create="1" delete="0">
                <header>
                    <button name="configure" type="object" string="Add signing fields" class="btn-primary" invisible="state != 'draft' or has_signing_fields or not can_coordinate"/>
                    <button name="action_mark_ready" type="object" string="Check and continue" class="btn-primary" invisible="state != 'draft' or not has_signing_fields or not can_coordinate"/>
                    <button name="action_send" type="object" string="Send for signature" class="btn-primary" invisible="state != 'ready' or not can_send"/>
                    <button name="action_resume_after_enrollment" type="object" string="Continue" class="btn-primary" invisible="state != 'waiting_enrollment' or not can_coordinate"/>
                    <button name="action_validate_external" type="object" string="Check imported document" class="btn-primary" invisible="state != 'signed_to_import' or not can_coordinate"/>
                    <button name="action_create_replacement" type="object" string="Create replacement" class="btn-primary" invisible="state != 'validation_failed' or not can_send"/>
                    <button name="action_retry_validation" type="object" string="Try again" class="btn-primary" invisible="state != 'action_required' or not can_coordinate"/>
                    <button name="action_retry_archive" type="object" string="Retry final storage" class="btn-primary" invisible="state != 'evidence_incomplete' or archive_status != 'failed' or not can_coordinate"/>
                    <button name="action_send_reminder" type="object" string="Remind signers" invisible="state not in ['sent', 'viewed', 'partial'] or reminder_count &gt;= max_reminders or not can_coordinate"/>
                    <button name="cancel" type="object" string="Cancel" confirm="Cancel this request and disable every signing link?" invisible="state not in ['draft', 'ready', 'sent', 'viewed', 'partial', 'waiting_enrollment', 'waiting_external', 'signed_to_import', 'action_required'] or not can_send"/>
                    <field name="lifecycle_stage" widget="statusbar" statusbar_visible="draft,ready,sent,progress,checks,closed" readonly="1"/>
                    <field name="state" invisible="1"/>
                    <field name="archive_status" invisible="1"/>
                    <field name="has_signing_fields" invisible="1"/>
                    <field name="can_coordinate" invisible="1"/>
                    <field name="can_send" invisible="1"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="configure" type="object" class="oe_stat_button" icon="fa-pencil-square-o" string="Edit fields" invisible="state != 'draft' or not has_signing_fields or not can_coordinate"/>
                        <button name="preview" type="object" class="oe_stat_button" icon="fa-file-pdf-o" string="Open document" invisible="state in ['draft', 'ready', 'completed']"/>
                        <button name="preview" type="object" class="oe_stat_button" icon="fa-file-pdf-o" string="View signed PDF" invisible="state != 'completed'"/>
                    </div>
                    <widget name="web_ribbon" title="Completed" invisible="state != 'completed'"/>
                    <widget name="web_ribbon" title="Cancelled" bg_color="bg-danger" invisible="state != 'cancelled'"/>
                    <div class="oe_title">
                        <p class="text-muted mb-1">Document for signature</p>
                        <h1><field name="name" placeholder="Document name" readonly="state != 'draft'"/></h1>
                    </div>

                    <div class="row g-3 my-3 usl_sign_request_summary">
                        <div class="col-12 col-sm-6 col-xl-3"><div class="card h-100"><div class="card-body py-3"><div class="text-muted small">People</div><div class="fw-semibold"><field name="signer_progress" readonly="1"/></div></div></div></div>
                        <div class="col-12 col-sm-6 col-xl-3"><div class="card h-100"><div class="card-body py-3"><div class="text-muted small">Signing method</div><div class="fw-semibold"><field name="requested_trust_short" readonly="1"/></div></div></div></div>
                        <div class="col-12 col-sm-6 col-xl-3"><div class="card h-100"><div class="card-body py-3"><div class="text-muted small">Deadline</div><div class="fw-semibold"><field name="due_date_summary" readonly="1"/></div></div></div></div>
                        <div class="col-12 col-sm-6 col-xl-3"><div class="card h-100"><div class="card-body py-3"><div class="text-muted small">Status</div><div class="fw-semibold"><field name="lifecycle_stage_label" readonly="1"/></div></div></div></div>
                    </div>

                    <div class="alert alert-warning" role="alert" invisible="state != 'evidence_incomplete'">
                        <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
                            <div>
                                <strong class="d-block mb-1">Signed files are ready; final storage failed.</strong>
                                <span class="d-block">The validated signed PDF and proof are safe in Odoo. Paperless has not stored the final copies yet.</span>
                                <field name="recovery_action" nolabel="1" readonly="1" class="d-block mt-1" invisible="not recovery_action or not can_coordinate"/>
                                <span class="d-block mt-1" invisible="can_coordinate">The requester or a Sign administrator needs to retry final storage.</span>
                            </div>
                            <div class="d-flex flex-wrap gap-2 flex-shrink-0">
                                <button name="preview" type="object" string="Open signed PDF" class="btn-secondary" invisible="not final_data"/>
                                <button name="action_retry_archive" type="object" string="Retry final storage" class="btn-primary" invisible="archive_status != 'failed' or not can_coordinate"/>
                            </div>
                        </div>
                    </div>
                    <div class="alert alert-warning" role="status" invisible="state not in ['waiting_enrollment', 'action_required', 'validation_failed']">
                        <div class="d-flex flex-column gap-1">
                            <strong class="d-block">Needs attention</strong>
                            <field name="blocking_summary" nolabel="1" readonly="1" class="d-block"/>
                        </div>
                    </div>
                    <div class="alert alert-info" role="status" invisible="state in ['waiting_enrollment', 'action_required', 'evidence_incomplete', 'validation_failed', 'completed', 'cancelled', 'declined', 'expired']">
                        <field name="next_step" nolabel="1" readonly="1"/>
                    </div>

                    <notebook>
                        <page string="Overview" name="overview">
                            <group>
                                <group string="Details">
                                    <field name="user_id" string="Sent by" readonly="state != 'draft'"/>
                                    <field name="record_ref" string="Linked record" readonly="state != 'draft'"/>
                                    <field name="template_id" string="Template" readonly="1" invisible="not template_id"/>
                                    <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                                    <field name="expires_at" string="Deadline" readonly="state != 'draft'"/>
                                    <field name="responsible_message" string="Message to signers" readonly="state != 'draft'" placeholder="Optional note shown with the invitation"/>
                                </group>
                                <group string="Signing method">
                                    <field name="requested_trust_short" string="Method" readonly="1"/>
                                    <field name="achieved_trust_short" string="Result" readonly="1" invisible="not achieved_trust_short"/>
                                    <field name="signing_method_summary" nolabel="1" readonly="1"/>
                                    <button name="action_open_signing_method" type="object" string="Change signing method" class="oe_link" invisible="state != 'draft' or not can_send"/>
                                </group>
                            </group>
                            <details class="mt-3">
                                <summary class="text-muted">More options</summary>
                                <group class="mt-2">
                                    <field name="coordinator_ids" string="People helping manage this request" widget="many2many_tags" readonly="not can_send" options="{'no_create': true}"/>
                                    <field name="reminder_days" string="Remind after (days)" readonly="state != 'draft'"/>
                                    <field name="max_reminders" string="Maximum reminders" readonly="state != 'draft'"/>
                                    <field name="reminder_count" string="Reminders sent" readonly="1"/>
                                </group>
                            </details>
                        </page>
                        <page string="Signers" name="signers">
                            <div class="border rounded bg-light p-3 mb-3" role="note" invisible="state != 'draft'">
                                Add everyone who must sign. A signing role identifies the fields each person will complete.
                            </div>
                            <group invisible="state != 'draft'">
                                <field name="signing_order" string="People must sign in this order" readonly="requested_trust == 'strong_personal'"/>
                            </group>
                            <field name="signer_ids" readonly="state != 'draft' or not can_coordinate" nolabel="1">
                                <list editable="bottom" decoration-success="state == 'signed'" decoration-danger="state == 'declined'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="partner_id" string="Person"/>
                                    <field name="role_id" string="Signing role"/>
                                    <field name="state" string="Status" readonly="1"/>
                                    <field name="invitation_delivery_state" string="Invitation" readonly="1" optional="show"/>
                                    <field name="authentication_method" readonly="1" optional="hide" groups="usl_sign.group_sign_evidence_reviewer,usl_sign.group_sign_admin"/>
                                    <field name="signed_on" string="Signed on" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Files" name="documents">
                            <group>
                                <field name="data" filename="filename" string="Main PDF" readonly="state != 'draft'"/>
                                <field name="filename" invisible="1"/>
                            </group>
                            <field name="document_ids" readonly="state != 'draft' or not can_coordinate" nolabel="1">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="is_annex" string="Annex"/>
                                    <field name="name" string="Document"/>
                                    <field name="filename"/>
                                    <field name="data" filename="filename"/>
                                </list>
                            </field>
                        </page>
                        <page string="Result &amp; proof" name="proof">
                            <div class="border rounded bg-light p-3" role="status" invisible="state not in ['draft', 'ready', 'sent', 'viewed', 'partial', 'waiting_enrollment', 'waiting_external']">
                                The final document will appear here after everyone has signed and the result has been checked.
                            </div>
                            <group invisible="state in ['draft', 'ready', 'sent', 'viewed', 'partial', 'waiting_enrollment', 'waiting_external']">
                                <group string="Result">
                                    <field name="achieved_trust_short" string="Signing method achieved" readonly="1" invisible="not achieved_trust_short"/>
                                    <field name="completed_at" string="Completed on" readonly="1" invisible="not completed_at"/>
                                    <field name="archive_document_id" string="Archived signed document" readonly="1" invisible="not archive_document_id" groups="usl_sign.group_sign_evidence_reviewer,usl_sign.group_sign_admin"/>
                                    <field name="archive_dossier_document_id" string="Archived proof package" readonly="1" invisible="not archive_dossier_document_id" groups="usl_sign.group_sign_evidence_reviewer,usl_sign.group_sign_admin"/>
                                </group>
                                <group string="Files">
                                    <field name="final_filename" invisible="1"/>
                                    <field name="completion_filename" invisible="1"/>
                                    <field name="dossier_filename" invisible="1"/>
                                    <field name="final_data" filename="final_filename" string="Signed PDF" readonly="1" invisible="not final_data"/>
                                    <field name="completion_certificate" filename="completion_filename" string="Completion certificate" readonly="1" invisible="not completion_certificate"/>
                                    <field name="dossier_data" filename="dossier_filename" string="Complete proof package" readonly="1" invisible="not dossier_data"/>
                                </group>
                            </group>
                            <div class="alert alert-light border mt-3" role="status" invisible="not final_data">
                                <strong>Which file should I use?</strong>
                                <span>The signed PDF is the document to read and share. The completion certificate is a short summary. The proof package is for audit and contains the signed PDF, source files, consent, activity record, certificates, and validation reports as embedded attachments.</span>
                            </div>
                            <group string="Independent timestamp" invisible="state != 'completed'">
                                <group>
                                    <field name="daily_timestamp_status" readonly="1" widget="badge"/>
                                    <field name="daily_timestamp_message" readonly="1" nolabel="1"/>
                                </group>
                                <div class="text-muted small" colspan="2">
                                    A daily Bitcoin timestamp will independently show that this completed file existed by a verified date.
                                </div>
                            </group>
                            <details class="mt-4" groups="usl_sign.group_sign_evidence_reviewer,usl_sign.group_sign_admin" invisible="state in ['draft', 'ready']">
                                <summary class="text-muted">Verification details</summary>
                                <group class="mt-3">
                                    <group string="Checks">
                                        <field name="validation_status" readonly="1"/>
                                        <field name="evidence_status" readonly="1"/>
                                        <field name="archive_status" readonly="1"/>
                                        <field name="policy_id" readonly="1"/>
                                        <field name="policy_version" readonly="1"/>
                                    </group>
                                    <group string="File fingerprints">
                                        <field name="original_sha256" readonly="1"/>
                                        <field name="final_sha256" readonly="1" invisible="not final_sha256"/>
                                    </group>
                                </group>
                                <field name="daily_timestamp_manifest_id" readonly="1" invisible="not daily_timestamp_manifest_id"/>
                                <button name="action_open_daily_timestamp_proof" type="object" string="Open timestamp record" class="btn-secondary" invisible="not daily_timestamp_manifest_id"/>
                                <field name="daily_timestamp_has_pending_receipt" invisible="1"/>
                                <field name="daily_timestamp_has_confirmed_receipt" invisible="1"/>
                                <field name="daily_timestamp_has_report" invisible="1"/>
                                <field name="daily_timestamp_has_dossier" invisible="1"/>
                                <div class="d-flex flex-wrap gap-2 my-2" invisible="not daily_timestamp_manifest_id">
                                    <button name="action_download_daily_signed_manifest" type="object" string="Daily record" class="btn-link"/>
                                    <button name="action_download_daily_pending_receipt" type="object" string="Pending timestamp" class="btn-link" invisible="not daily_timestamp_has_pending_receipt"/>
                                    <button name="action_download_daily_confirmed_receipt" type="object" string="Confirmed timestamp" class="btn-link" invisible="not daily_timestamp_has_confirmed_receipt"/>
                                    <button name="action_download_daily_verification_report" type="object" string="Timestamp check" class="btn-link" invisible="not daily_timestamp_has_report"/>
                                    <button name="action_download_daily_proof_dossier" type="object" string="Timestamp record" class="btn-link" invisible="not daily_timestamp_has_dossier"/>
                                </div>
                                <field name="validation_ids" readonly="1" nolabel="1">
                                    <list create="0" delete="0" edit="0"><field name="engine"/><field name="engine_version"/><field name="expected_trust"/><field name="achieved_trust"/><field name="status"/><field name="signature_count"/><field name="qualified_provider"/></list>
                                </field>
                                <field name="evidence_ids" readonly="1" nolabel="1">
                                    <list create="0" delete="0" edit="0"><field name="kind"/><field name="name"/><field name="signer_id"/><field name="created_at"/><field name="data" filename="name"/></list>
                                </field>
                            </details>
                        </page>
                        <page string="Activity record" name="timeline" groups="usl_sign.group_sign_evidence_reviewer,usl_sign.group_sign_admin">
                            <field name="event_ids" readonly="1" nolabel="1">
                                <list create="0" delete="0" edit="0"><field name="occurred_at"/><field name="event_type"/><field name="signer_id"/><field name="state_from" optional="hide"/><field name="state_to" optional="hide"/><field name="actor_id"/></list>
                            </field>
                        </page>
                        <page string="External signing" name="external" invisible="requested_trust != 'qualified_external'">
                            <field name="external_journey_id" readonly="1" nolabel="1"><list create="0" delete="0" edit="0"><field name="provider_id"/><field name="state"/><field name="exported_at"/><field name="imported_at"/><button name="action_open_details" type="object" string="Open"/></list></field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sign_request_signer_result_form" model="ir.ui.view">
        <field name="name">sign.oca.request.form.usl.signer.result</field>
        <field name="model">sign.oca.request</field>
        <field name="arch" type="xml">
            <form string="Signed document" create="0" edit="0" delete="0">
                <header>
                    <button name="preview" type="object" string="Open signed PDF" class="btn-primary" invisible="not final_data or validation_status != 'valid' or state not in ['evidence_incomplete', 'completed']"/>
                    <button name="action_retry_archive" type="object" string="Retry final storage" class="btn-primary" invisible="state != 'evidence_incomplete' or archive_status != 'failed' or not can_coordinate"/>
                    <field name="lifecycle_stage" widget="statusbar" statusbar_visible="sent,progress,checks,closed" readonly="1"/>
                    <field name="state" invisible="1"/>
                    <field name="validation_status" invisible="1"/>
                    <field name="archive_status" invisible="1"/>
                    <field name="can_coordinate" invisible="1"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Completed" invisible="state != 'completed'"/>
                    <div class="oe_title">
                        <p class="text-muted mb-1">Document sent to you</p>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <div class="row g-3 my-4">
                        <div class="col-12 col-sm-6 col-xl-3"><div class="card h-100"><div class="card-body py-3"><div class="text-muted small">Sent by</div><div class="fw-semibold"><field name="user_id" readonly="1"/></div></div></div></div>
                        <div class="col-12 col-sm-6 col-xl-3"><div class="card h-100"><div class="card-body py-3"><div class="text-muted small">Progress</div><div class="fw-semibold"><field name="signer_progress" readonly="1"/></div></div></div></div>
                        <div class="col-12 col-sm-6 col-xl-3"><div class="card h-100"><div class="card-body py-3"><div class="text-muted small">Signing method</div><div class="fw-semibold"><field name="requested_trust_short" readonly="1"/></div></div></div></div>
                        <div class="col-12 col-sm-6 col-xl-3"><div class="card h-100"><div class="card-body py-3"><div class="text-muted small">Status</div><div class="fw-semibold"><field name="lifecycle_stage_label" readonly="1"/></div></div></div></div>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="state != 'evidence_incomplete'">
                        <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
                            <div>
                                <strong class="d-block mb-1">Your signed files are ready.</strong>
                                <span class="d-block">The validated signed PDF and proof are safe here, but Paperless has not stored the final copies yet.</span>
                                <field name="recovery_action" nolabel="1" readonly="1" class="d-block mt-1" invisible="not recovery_action or not can_coordinate"/>
                                <span class="d-block mt-1" invisible="can_coordinate">The requester or a Sign administrator needs to retry final storage.</span>
                            </div>
                            <button name="action_retry_archive" type="object" string="Retry final storage" class="btn-primary flex-shrink-0" invisible="archive_status != 'failed' or not can_coordinate"/>
                        </div>
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="state != 'validation_failed'">
                        <strong>Verification failed.</strong> The requester needs to review this result before it can be used.
                    </div>
                    <div class="alert alert-info" role="status" invisible="state in ['completed', 'evidence_incomplete', 'validation_failed']">
                        Your part is recorded. The final files will appear here after everyone has signed and the document has passed its checks.
                    </div>
                    <div class="alert alert-success" role="status" invisible="state != 'completed'">
                        <strong>Complete.</strong> The signed document and its proof are ready below.
                    </div>
                    <group invisible="not final_data or validation_status != 'valid' or state not in ['evidence_incomplete', 'completed']">
                        <group string="Result">
                            <field name="achieved_trust_short" string="Signing method achieved" readonly="1"/>
                            <field name="completed_at" string="Completed on" readonly="1"/>
                        </group>
                        <group string="Files">
                            <field name="final_filename" invisible="1"/>
                            <field name="completion_filename" invisible="1"/>
                            <field name="dossier_filename" invisible="1"/>
                            <field name="final_data" filename="final_filename" string="Signed PDF" readonly="1" invisible="not final_data"/>
                            <field name="completion_certificate" filename="completion_filename" string="Completion certificate" readonly="1" invisible="not completion_certificate"/>
                            <field name="dossier_data" filename="dossier_filename" string="Complete proof package" readonly="1" invisible="not dossier_data"/>
                        </group>
                    </group>
                    <div class="text-muted small mt-3" invisible="not final_data or validation_status != 'valid' or state not in ['evidence_incomplete', 'completed']">
                        Use the signed PDF for everyday reference. Keep the proof package when an auditor or reviewer needs the full record.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sign_share_confirm_form" model="ir.ui.view">
        <field name="name">usl.sign.share.confirm.form</field>
        <field name="model">usl.sign.share.confirm</field>
        <field name="arch" type="xml">
            <form string="Share and send">
                <sheet>
                    <field name="request_id" invisible="1"/>
                    <field name="recipient_count" invisible="1"/>
                    <field name="message" invisible="1"/>
                    <div class="oe_title">
                        <h2>Share this request with <field name="recipient_names" readonly="1" class="d-inline"/>?</h2>
                    </div>
                    <p class="mb-2">
                        These invited people have an Odoo account. They will receive a signing activity, can open the request in <strong>My Signatures</strong>, and can retrieve the final files after completion.
                    </p>
                    <p class="text-muted mb-0">
                        They will only see their own signing assignment. Other recipients still use their private signing link.
                    </p>
                </sheet>
                <footer>
                    <button name="action_confirm" type="object" string="Share and send" class="btn-primary"/>
                    <button string="Go back" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="sign_request_method_form" model="ir.ui.view">
        <field name="name">usl.sign.request.method.form</field>
        <field name="model">usl.sign.request.method</field>
        <field name="arch" type="xml">
            <form string="Signing method" class="usl_sign_method_wizard">
                <sheet class="mw-100">
                    <field name="request_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="can_override_trust" invisible="1"/>
                    <div class="oe_title mb-4">
                        <h2>Choose a signing method</h2>
                        <p class="text-muted mb-0">Confirm the context, then use the recommended method or choose another.</p>
                    </div>

                    <section class="card mb-4">
                        <div class="card-body">
                            <div class="d-flex flex-wrap align-items-start justify-content-between gap-2 mb-3">
                                <div>
                                    <h3 class="h5 mb-1">1. Confirm the context</h3>
                                    <p class="text-muted mb-0">These required details determine the recommendation.</p>
                                </div>
                                <span class="small text-muted"><span class="text-danger" aria-hidden="true">*</span> Required</span>
                            </div>
                            <div class="row g-3">
                                <div class="col-12 col-md-4">
                                    <label for="document_category" class="o_form_label fw-semibold">Document type <span class="text-danger" aria-hidden="true">*</span></label>
                                    <field name="document_category" nolabel="1"/>
                                </div>
                                <div class="col-12 col-md-4">
                                    <label for="signer_type" class="o_form_label fw-semibold">Relationship to signer <span class="text-danger" aria-hidden="true">*</span></label>
                                    <field name="signer_type" nolabel="1"/>
                                </div>
                                <div class="col-12 col-md-4">
                                    <label for="risk_level" class="o_form_label fw-semibold">Business risk <span class="text-danger" aria-hidden="true">*</span></label>
                                    <field name="risk_level" nolabel="1"/>
                                </div>
                            </div>
                            <div class="mt-3 pt-3 border-top">
                                <field name="formal_qes_required" string="A law, authority, or counterparty explicitly requires a qualified signature"/>
                                <p class="small text-muted mb-0 ms-4">Select this only when a formal qualified-signature requirement has been confirmed.</p>
                            </div>
                        </div>
                    </section>

                    <section>
                        <h3 class="h5 mb-1">2. Choose the method</h3>
                        <p class="text-muted mb-3">The method changes how signers confirm and what proof is produced.</p>

                        <div class="alert alert-info mb-3" role="status">
                            <div class="small fw-semibold text-uppercase mb-1">Recommended for this document</div>
                            <div class="h5 mb-1"><field name="recommended_trust" class="d-inline" readonly="1"/></div>
                            <field name="recommendation_reason" nolabel="1" readonly="1" class="text-body"/>
                        </div>

                        <label for="requested_trust" class="o_form_label fw-semibold">Signing method <span class="text-danger" aria-hidden="true">*</span></label>
                        <p class="small text-muted mb-2">Required. Select one method, then review any requirement shown below.</p>
                        <field name="requested_trust" widget="radio" options="{'horizontal': true}" nolabel="1" class="usl_sign_method_radio"/>

                        <div class="rounded border bg-light-subtle p-3 mt-3 mb-3" aria-live="polite">
                            <field name="selected_method_summary" nolabel="1" readonly="1" class="fw-semibold"/>
                            <div class="small text-muted mt-1"><field name="selected_method_readiness" nolabel="1" readonly="1"/></div>
                        </div>

                        <div class="alert alert-warning" role="alert" invisible="requested_trust == recommended_trust or can_override_trust">
                            <strong>Use the recommendation or ask an administrator.</strong>
                            <div>You do not have permission to choose a different signing method.</div>
                        </div>

                        <div class="card border-warning mb-3" invisible="requested_trust == recommended_trust or not can_override_trust">
                            <div class="card-body">
                                <label for="override_reason" class="o_form_label fw-semibold">Reason for choosing a different method <span class="text-danger" aria-hidden="true">*</span></label>
                                <p class="small text-muted mb-2">Required. This reason is kept with the request.</p>
                                <field name="override_reason" nolabel="1" placeholder="Explain why the recommendation is not appropriate for this document…" required="requested_trust != recommended_trust and can_override_trust"/>
                            </div>
                        </div>

                        <div class="card mb-3" invisible="requested_trust != 'qualified_external'">
                            <div class="card-body">
                                <label for="external_provider_id" class="o_form_label fw-semibold">Qualified provider <span class="text-danger" aria-hidden="true">*</span></label>
                                <p class="small text-muted mb-2">Required. Choose the provider that will sign the frozen PDF outside Odoo.</p>
                                <field name="external_provider_id" nolabel="1" required="requested_trust == 'qualified_external'"/>
                            </div>
                        </div>
                    </section>
                </sheet>
                <footer>
                    <button name="action_apply" type="object" string="Apply signing method" class="btn-primary" invisible="requested_trust != recommended_trust and not can_override_trust"/>
                    <span class="text-muted align-self-center" invisible="requested_trust == recommended_trust or can_override_trust">Select the recommended method to continue.</span>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="sign_request_list_usl" model="ir.ui.view">
        <field name="name">sign.oca.request.list.usl.open</field>
        <field name="model">sign.oca.request</field>
        <field name="priority">2</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" decoration-danger="state in ['action_required', 'validation_failed']" decoration-warning="state in ['waiting_enrollment', 'evidence_incomplete']">
                <field name="name" string="Request"/>
                <field name="record_ref" string="Linked record"/>
                <field name="lifecycle_stage" string="Stage"/>
                <field name="signer_progress" string="Progress"/>
                <field name="next_step" string="Next action"/>
                <field name="expires_at" string="Due date"/>
                <field name="requested_trust_short" string="Signing method"/>
                <field name="validation_status" string="Proof status" optional="hide"/>
                <field name="archive_status" string="Archive status" optional="hide"/>
                <field name="user_id" optional="hide"/>
                <field name="coordinator_ids" widget="many2many_tags" optional="hide"/>
                <field name="state" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="sign_request_search_usl" model="ir.ui.view">
        <field name="name">sign.oca.request.search.usl.open</field>
        <field name="model">sign.oca.request</field>
        <field name="priority">2</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="record_ref"/>
                <field name="signer_ids"/>
                <filter name="needs_action" string="Needs my action" domain="[('state', 'in', ['draft', 'ready', 'waiting_enrollment', 'signed_to_import', 'action_required', 'evidence_incomplete'])]"/>
                <filter name="waiting" string="Waiting for signers" domain="[('state', 'in', ['sent', 'viewed', 'partial'])]"/>
                <filter name="final_checks" string="Finishing" domain="[('state', 'in', ['signed_to_import', 'validating', 'evidence_incomplete'])]"/>
                <filter name="recovery" string="Needs attention" domain="[('state', 'in', ['action_required', 'validation_failed', 'evidence_incomplete'])]"/>
                <filter name="external" string="External signing" domain="[('state', 'in', ['waiting_external', 'signed_to_import'])]"/>
                <group><filter name="group_status" string="Status" context="{'group_by': 'state'}"/><filter name="group_requester" string="Requester" context="{'group_by': 'user_id'}"/></group>
            </search>
        </field>
    </record>

    <record id="my_signature_list_usl" model="ir.ui.view">
        <field name="name">sign.oca.request.signer.list.usl.mine</field>
        <field name="model">sign.oca.request.signer</field>
        <field name="priority">2</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0"
                decoration-success="state == 'signed'"
                decoration-danger="state == 'declined' or request_state == 'validation_failed'"
                decoration-muted="request_state in ['expired', 'cancelled']"
                decoration-warning="state in ['draft', 'notified', 'viewed', 'authorized'] and request_state not in ['expired', 'cancelled']">
                <field name="request_id" string="Document" options="{'no_open': true}"/>
                <field name="sender_id" string="Sent by"/>
                <field name="role_id" string="Signing as"/>
                <field name="personal_status" string="Your status"/>
                <field name="personal_next_step" string="Next step"/>
                <field name="request_due_at" string="Due date"/>
                <field name="overall_status" string="Request status" optional="hide"/>
                <field name="requested_trust_short" string="Signing method"/>
                <field name="signed_on" string="Signed on" optional="show"/>
                <button name="sign" type="object" string="Review and sign" class="btn-primary" invisible="not is_allow_signature"/>
                <button name="action_open_signing_identity" type="object" string="View identity status" invisible="not can_open_signing_identity"/>
                <button name="action_open_external_signing" type="object" string="Open external signing" class="btn-primary" invisible="not can_open_external_signing"/>
                <button name="action_open_request" type="object" string="View result" invisible="state != 'signed' and request_state not in ['completed', 'evidence_incomplete', 'validation_failed']"/>
                <field name="is_allow_signature" column_invisible="1"/>
                <field name="can_open_signing_identity" column_invisible="1"/>
                <field name="can_open_external_signing" column_invisible="1"/>
                <field name="state" column_invisible="1"/>
                <field name="request_state" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="my_signature_form_usl" model="ir.ui.view">
        <field name="name">sign.oca.request.signer.form.usl.mine</field>
        <field name="model">sign.oca.request.signer</field>
        <field name="priority">2</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="sign" type="object" string="Review and sign" class="btn-primary" invisible="not is_allow_signature"/>
                    <button name="action_open_signing_identity" type="object" string="View identity status" class="btn-primary" invisible="not can_open_signing_identity"/>
                    <button name="action_open_external_signing" type="object" string="Open external signing" class="btn-primary" invisible="not can_open_external_signing"/>
                    <button name="action_open_request" type="object" string="View result" invisible="state != 'signed' and request_state not in ['completed', 'evidence_incomplete', 'validation_failed']"/>
                </header>
                <sheet>
                    <field name="is_allow_signature" invisible="1"/>
                    <field name="can_open_signing_identity" invisible="1"/>
                    <field name="can_open_external_signing" invisible="1"/>
                    <field name="state" invisible="1"/>
                    <field name="request_state" invisible="1"/>
                    <div class="oe_title"><p class="text-muted mb-1">Your signature</p><h1><field name="request_id" options="{'no_open': true}"/></h1></div>
                    <div class="alert alert-info mt-3" role="status">
                        <div>
                            <strong><field name="personal_status" readonly="1" nolabel="1"/></strong>
                            <div><field name="personal_next_step" readonly="1" nolabel="1"/></div>
                        </div>
                    </div>
                    <div class="row g-3 my-4">
                        <div class="col-12 col-sm-6 col-xl-3"><div class="card h-100"><div class="card-body py-3"><div class="text-muted small">Sent by</div><div class="fw-semibold"><field name="sender_id" readonly="1"/></div></div></div></div>
                        <div class="col-12 col-sm-6 col-xl-3"><div class="card h-100"><div class="card-body py-3"><div class="text-muted small">Signing as</div><div class="fw-semibold"><field name="role_id" readonly="1"/></div></div></div></div>
                        <div class="col-12 col-sm-6 col-xl-3"><div class="card h-100"><div class="card-body py-3"><div class="text-muted small">Complete by</div><div class="fw-semibold"><field name="request_due_at" readonly="1"/></div></div></div></div>
                        <div class="col-12 col-sm-6 col-xl-3"><div class="card h-100"><div class="card-body py-3"><div class="text-muted small">Signing method</div><div class="fw-semibold"><field name="requested_trust_short" readonly="1"/></div></div></div></div>
                    </div>
                    <field name="signed_on" string="Signed on" readonly="1" invisible="not signed_on"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="my_signature_search_usl" model="ir.ui.view">
        <field name="name">sign.oca.request.signer.search.usl.mine</field>
        <field name="model">sign.oca.request.signer</field>
        <field name="priority">2</field>
        <field name="arch" type="xml">
            <search>
                <field name="request_id"/>
                <field name="sender_id"/>
                <field name="role_id"/>
                <field name="state"/>
                <field name="request_state"/>
                <separator/>
                <filter name="to_sign" string="Ready to sign" domain="[('state', 'in', ['notified', 'viewed', 'authorized']), ('request_id.state', 'in', ['sent', 'viewed', 'partial'])]"/>
                <filter name="waiting_turn" string="Waiting for my turn" domain="[('state', '=', 'draft'), ('request_id.state', 'in', ['sent', 'viewed', 'partial'])]"/>
                <filter name="identity_setup" string="Identity setup" domain="[('request_id.state', '=', 'waiting_enrollment')]"/>
                <filter name="external_signing" string="External signing" domain="[('request_id.state', '=', 'waiting_external')]"/>
                <filter name="signed_by_me" string="Signed by me" domain="[('state', '=', 'signed')]"/>
                <filter name="completed" string="Completed" domain="[('request_id.state', '=', 'completed')]"/>
                <filter name="closed" string="Closed" domain="[('request_id.state', 'in', ['declined', 'expired', 'cancelled', 'validation_failed'])]"/>
                <separator/>
                <filter name="due" string="Has a due date" domain="[('request_due_at', '!=', False)]"/>
                <group>
                    <filter name="group_signature" string="My signature status" context="{'group_by': 'state'}"/>
                    <filter name="group_status" string="Request status" context="{'group_by': 'request_state'}"/>
                    <filter name="group_sender" string="Sender" context="{'group_by': 'sender_id'}"/>
                    <filter name="group_due" string="Due month" context="{'group_by': 'request_due_at:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sign_request_action" model="ir.actions.act_window">
        <field name="name">Open Requests</field>
        <field name="res_model">sign.oca.request</field>
        <field name="view_mode">list,form,activity</field>
        <field name="domain">[('state', 'not in', ['completed', 'declined', 'expired', 'cancelled']), '|', ('user_id', '=', uid), ('coordinator_ids', 'in', [uid])]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No open requests</p>
            <p>Requests you own or coordinate will appear here until they are completed or closed. Use <strong>Start</strong> on the Sign home page to prepare one.</p>
        </field>
    </record>
    <record id="my_signatures_action" model="ir.actions.act_window">
        <field name="name">My Signatures</field>
        <field name="res_model">sign.oca.request.signer</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('partner_id.user_ids', 'in', [uid]), ('request_id.state', 'not in', ['draft', 'ready'])]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No documents have been assigned to you</p>
            <p>This page keeps both documents awaiting your signature and your earlier results. Use the search filters to focus on ready, signed, completed, or closed requests.</p>
        </field>
    </record>
    <record id="completed_documents_action" model="ir.actions.act_window">
        <field name="name">Completed Documents</field>
        <field name="res_model">sign.oca.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'completed'), ('managed_by_current_user', '=', True)]</field>
        <field name="context">{'search_default_completed': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No completed documents yet</p>
            <p>Final documents from requests you sent or coordinate appear here. Documents you signed are kept under <strong>My Signatures</strong>.</p>
        </field>
    </record>
</odoo>
