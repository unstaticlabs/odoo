<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sign_service_health_kanban" model="ir.ui.view">
        <field name="name">usl.sign.service.health.kanban</field>
        <field name="model">usl.sign.service.health</field>
        <field name="arch" type="xml">
            <kanban create="0" edit="0" delete="0" default_order="company_id, sequence" class="o_kanban_small_column usl_sign_service_status_kanban">
                <header>
                    <button name="action_refresh_company" type="object" string="Check all" class="btn-primary" display="always"/>
                </header>
                <field name="name"/><field name="status"/><field name="purpose"/><field name="checks"/>
                <field name="summary"/><field name="version"/><field name="latency_ms"/>
                <field name="checked_at"/><field name="next_action"/><field name="company_id"/>
                <field name="is_optional"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-2">
                            <div class="min-w-0">
                                <div t-if="record.is_optional.raw_value" class="text-uppercase text-muted small fw-semibold mb-1">Optional</div>
                                <h2 class="h5 mb-0"><field name="name"/></h2>
                            </div>
                            <field name="status" widget="badge"
                                decoration-success="status == 'ready'"
                                decoration-warning="status in ['degraded', 'not_configured']"
                                decoration-danger="status in ['unreachable', 'action_required']"/>
                        </div>
                        <p class="mb-3"><field name="purpose"/></p>
                        <div class="rounded border bg-light p-3 mb-3">
                            <div class="small text-muted mb-1">Current result</div>
                            <div><field name="summary"/></div>
                        </div>
                        <div t-if="record.next_action.raw_value" class="alert alert-warning py-2 px-3 mb-3" role="status">
                            <div class="small fw-semibold">Next action</div>
                            <field name="next_action"/>
                        </div>
                        <details class="small text-muted mb-2">
                            <summary>What is checked</summary>
                            <field name="checks"/>
                        </details>
                        <div class="small text-muted d-flex flex-wrap gap-2">
                            <span t-if="record.version.raw_value"><field name="version"/></span>
                            <span t-if="record.checked_at.raw_value">Checked <field name="checked_at"/></span>
                            <span t-if="record.latency_ms.raw_value"><field name="latency_ms"/> ms</span>
                        </div>
                        <footer class="mt-3 d-flex justify-content-between align-items-center">
                            <button name="action_refresh" type="object" string="Check again" class="btn btn-sm btn-outline-primary"/>
                            <a type="open" role="button" class="btn btn-sm btn-link">Details</a>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="sign_service_health_form" model="ir.ui.view">
        <field name="name">usl.sign.service.health.form</field>
        <field name="model">usl.sign.service.health</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header><button name="action_refresh" type="object" string="Check again" class="btn-primary"/></header>
                <sheet>
                    <div class="oe_title">
                        <p class="text-uppercase text-muted fw-semibold small mb-1">System status</p>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <field name="status" widget="badge" readonly="1"
                            decoration-success="status == 'ready'"
                            decoration-warning="status in ['degraded', 'not_configured']"
                            decoration-danger="status in ['unreachable', 'action_required']"/>
                        <span invisible="not is_optional" class="badge text-bg-light">Optional</span>
                    </div>
                    <p class="lead"><field name="purpose" readonly="1" nolabel="1"/></p>
                    <div class="alert alert-success" role="status" invisible="status != 'ready'">
                        <strong>Available.</strong> <field name="summary" readonly="1" nolabel="1" class="d-inline"/>
                    </div>
                    <div class="alert alert-warning" role="status" invisible="status not in ['degraded', 'not_configured']">
                        <strong invisible="status != 'degraded'">Partly available.</strong>
                        <strong invisible="status != 'not_configured'">Not configured.</strong>
                        <field name="summary" readonly="1" nolabel="1" class="d-inline"/>
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="status not in ['unreachable', 'action_required']">
                        <strong>Action required.</strong> <field name="summary" readonly="1" nolabel="1" class="d-inline"/>
                    </div>
                    <div class="card mb-4" invisible="not next_action">
                        <div class="card-body">
                            <div class="text-muted small mb-1">What to do next</div>
                            <field name="next_action" readonly="1" nolabel="1"/>
                        </div>
                    </div>
                    <group>
                        <group string="What this check covers">
                            <field name="checks" readonly="1" nolabel="1"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                        </group>
                        <group string="Last check">
                            <field name="checked_at" readonly="1"/>
                            <field name="checked_by_id" readonly="1"/>
                            <field name="latency_ms" readonly="1"/>
                            <field name="version" readonly="1" invisible="not version"/>
                        </group>
                    </group>
                    <details class="mt-3" groups="usl_sign.group_sign_admin" invisible="not diagnostic_code">
                        <summary class="text-muted">Technical diagnostic</summary>
                        <field name="diagnostic_code" readonly="1" nolabel="1"/>
                    </details>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sign_service_health_list" model="ir.ui.view">
        <field name="name">usl.sign.service.health.list</field>
        <field name="model">usl.sign.service.health</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0"
                decoration-success="status == 'ready'"
                decoration-warning="status in ['degraded', 'not_configured']"
                decoration-danger="status in ['unreachable', 'action_required']">
                <header><button name="action_refresh_company" type="object" string="Check all" class="btn-primary" display="always"/></header>
                <field name="name" string="Signing service"/><field name="company_id" groups="base.group_multi_company"/>
                <field name="status" widget="badge"/><field name="summary" string="Current result"/>
                <field name="checked_at"/><field name="version" optional="hide"/><field name="latency_ms" optional="hide"/>
                <button name="action_refresh" type="object" string="Check again"/>
            </list>
        </field>
    </record>

    <record id="sign_service_health_search" model="ir.ui.view">
        <field name="name">usl.sign.service.health.search</field>
        <field name="model">usl.sign.service.health</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Signing service"/><field name="company_id"/>
                <filter name="issues" string="Needs attention" domain="[('status', 'in', ['degraded', 'unreachable', 'action_required'])]"/>
                <filter name="not_configured" string="Not configured" domain="[('status', '=', 'not_configured')]"/>
                <filter name="ready" string="Ready" domain="[('status', '=', 'ready')]"/>
                <group><filter name="company" string="Company" context="{'group_by': 'company_id'}"/></group>
            </search>
        </field>
    </record>
</odoo>
