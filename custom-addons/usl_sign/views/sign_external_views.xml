<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sign_external_provider_list" model="ir.ui.view">
        <field name="name">usl.sign.external.provider.list</field>
        <field name="model">usl.sign.external.provider</field>
        <field name="arch" type="xml">
            <list>
                <field name="recommendation_priority" widget="handle"/>
                <field name="name" string="Provider"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="territory" string="Provider territory"/>
                <field name="supported_levels" string="Signature levels"/>
                <field name="reviewed_on" string="Reviewed on"/>
                <field name="active" string="Enabled"/>
            </list>
        </field>
    </record>
    <record id="sign_external_provider_form" model="ir.ui.view">
        <field name="name">usl.sign.external.provider.form</field>
        <field name="model">usl.sign.external.provider</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="alert alert-info" role="status">
                        This list helps requesters choose where to complete an exceptional qualified signature. Add only providers your organization has reviewed.
                    </div>
                    <div class="oe_title"><p class="text-muted mb-1">External signing provider</p><h1><field name="name"/></h1></div>
                    <group>
                        <group string="Provider scope">
                            <field name="active" string="Enabled"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="territory" string="Provider territory"/>
                            <field name="supported_levels" string="Supported signature levels"/>
                            <field name="mobile_url" string="Mobile signing URL" widget="url"/>
                        </group>
                        <group string="Catalog review">
                            <field name="recommendation_priority" string="Recommendation priority"/>
                            <field name="reviewed_on" string="Reviewed on"/>
                            <field name="reviewed_by_id" string="Reviewed by"/>
                        </group>
                    </group>
                    <group string="Signer and operator instructions">
                        <field name="instructions" nolabel="1" placeholder="Explain how to purchase the one-off signature, use the provider on mobile, and return the final PDF and proof package."/>
                    </group>
                    <group string="Commercial review notes">
                        <field name="commercial_notes" nolabel="1" placeholder="Record pay-as-you-go availability, territory, pricing notes, and any review caveats."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="sign_external_provider_action" model="ir.actions.act_window">
        <field name="name">External Providers</field>
        <field name="res_model">usl.sign.external.provider</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No external providers reviewed</p>
            <p>Add a provider after checking where it operates, what qualified signatures it offers, and how signers use it.</p>
        </field>
    </record>
    <record id="sign_external_import_wizard_form" model="ir.ui.view">
        <field name="name">usl.sign.external.import.wizard.form</field>
        <field name="model">usl.sign.external.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Return a signed document">
                <sheet>
                    <div class="oe_title"><h2>Upload the result from the external provider</h2><p class="text-muted">The signed PDF will be checked before the request can finish.</p></div>
                    <group>
                    <field name="journey_id" string="Request"/>
                    <field name="signed_pdf" filename="signed_filename" string="Signed PDF"/>
                    <field name="signed_filename" invisible="1"/>
                    <field name="proof_package" filename="proof_filename" string="Provider record"/>
                    <field name="proof_filename" invisible="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_import" type="object" string="Upload and check" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="sign_external_journey_form" model="ir.ui.view">
        <field name="name">usl.sign.external.journey.form</field>
        <field name="model">usl.sign.external.journey</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="action_export" type="object" string="Download Frozen PDF" class="btn-primary" invisible="state != 'waiting'"/>
                    <button name="action_open_provider" type="object" string="Open Reviewed Provider" invisible="state != 'waiting'"/>
                    <button name="action_open_import" type="object" string="Import Signed Result" invisible="state != 'waiting'"/>
                    <field name="state" widget="statusbar" statusbar_visible="waiting,imported,validated,rejected,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <p class="text-muted">Qualified external signature</p>
                        <h1><field name="provider_id"/></h1>
                    </div>
                    <div class="alert alert-info" role="status">
                        Use this journey only when formal QES or maximum independent assurance is required. Odoo completes the request only after independent validation and archival.
                    </div>
                    <group>
                        <group>
                            <field name="request_id"/>
                            <field name="frozen_sha256" string="Exact frozen PDF SHA-256"/>
                            <field name="exported_at"/>
                            <field name="imported_at"/>
                        </group>
                        <group>
                            <field name="provider_mobile_url" string="Mobile signing URL" widget="url"/>
                            <field name="provider_review_summary" string="Catalog review"/>
                            <field name="validation_id" invisible="not validation_id"/>
                            <field name="rejection_reason" invisible="not rejection_reason"/>
                        </group>
                    </group>
                    <group string="Expected signers">
                        <field name="signer_summary" nolabel="1"/>
                    </group>
                    <group string="Provider-neutral instructions">
                        <field name="provider_instructions" nolabel="1"/>
                    </group>
                    <group string="Imported result" invisible="not imported_pdf">
                        <group>
                            <field name="imported_filename" invisible="1"/>
                            <field name="imported_pdf" filename="imported_filename"/>
                            <field name="imported_sha256"/>
                        </group>
                        <group>
                            <field name="proof_filename" invisible="1"/>
                            <field name="proof_package" filename="proof_filename"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
