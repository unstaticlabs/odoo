<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sign_daily_manifest_list" model="ir.ui.view">
        <field name="name">usl.sign.daily.manifest.list</field>
        <field name="model">usl.sign.daily.manifest</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0">
                <field name="manifest_date" string="Date"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state" string="Manifest status"/>
                <field name="event_count" string="Events"/>
                <field name="request_count" string="Requests"/>
                <field name="payload_sha256" string="Manifest SHA-256"/>
                <field name="signed_at" string="Signed on"/>
                <field name="anchoring_status" string="External anchoring"/>
                <button name="action_retry" type="object" string="Retry" invisible="state != 'failed'"/>
            </list>
        </field>
    </record>
    <record id="sign_daily_manifest_form" model="ir.ui.view">
        <field name="name">usl.sign.daily.manifest.form</field>
        <field name="model">usl.sign.daily.manifest</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" edit="0">
                <header>
                    <button name="action_retry" type="object" string="Retry signing" class="btn-primary" invisible="state != 'failed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="manifest_date" string="Date"/>
                        <field name="company_id"/>
                        <field name="event_count" string="Events"/>
                        <field name="request_count" string="Requests"/>
                        <field name="payload_sha256" string="Manifest SHA-256"/>
                        <field name="signature_algorithm" string="Signature algorithm"/>
                        <field name="signed_at" string="Signed on"/>
                        <field name="anchoring_status" string="External anchoring"/>
                        <field name="failure_code" invisible="not failure_code"/>
                    </group>
                    <group string="Artifacts">
                        <field name="payload" filename="payload_sha256"/>
                        <field name="signature" filename="payload_sha256"/>
                        <field name="anchoring_receipt" invisible="not anchoring_receipt"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="sign_daily_manifest_action" model="ir.actions.act_window">
        <field name="name">Evidence Manifests</field>
        <field name="res_model">usl.sign.daily.manifest</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No evidence manifests yet</p>
            <p>The scheduled job signs one tamper-evident summary of each company’s Sign events every day.</p>
        </field>
    </record>
</odoo>
