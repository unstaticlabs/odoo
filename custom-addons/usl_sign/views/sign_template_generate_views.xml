<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sign_oca.sign_oca_template_generate_act_window" model="ir.actions.act_window">
        <field name="name">Prepare request</field>
    </record>
    <record id="sign_template_generate_form_usl" model="ir.ui.view">
        <field name="name">sign.oca.template.generate.form.usl.journey</field>
        <field name="model">sign.oca.template.generate</field>
        <field name="priority">2</field>
        <field name="arch" type="xml">
            <form string="Prepare request">
                <sheet>
                    <field name="template_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="sign_now" invisible="1"/>
                    <div class="oe_title mb-3"><p class="text-muted mb-1">Using <field name="template_id" readonly="1" class="d-inline"/></p><h2><field name="request_name" placeholder="Document name" required="1"/></h2></div>
                    <h3 class="h5">Who will sign?</h3>
                    <field name="signer_ids" nolabel="1">
                        <list editable="bottom" create="0" delete="0"><field name="role_id" string="Field group" force_save="1"/><field name="partner_id" string="Person"/></list>
                    </field>
                    <separator string="Signing method"/>
                    <div class="card mb-3"><div class="card-body">
                        <div class="row g-3">
                            <div class="col-12 col-md-5"><span class="o_form_label fw-semibold">Recommended</span><field name="recommended_trust" nolabel="1" readonly="1"/><field name="policy_id" invisible="1"/></div>
                            <div class="col-12 col-md-7"><field name="journey_availability" nolabel="1" readonly="1"/></div>
                        </div>
                    </div></div>
                    <group>
                        <field name="requested_trust" string="Use"/>
                        <field name="external_provider_id" invisible="requested_trust != 'qualified_external'"/>
                        <field name="override_reason" invisible="requested_trust == recommended_trust" required="requested_trust != recommended_trust"/>
                    </group>
                    <separator string="Message"/>
                    <field name="message" nolabel="1" placeholder="Add a short reason or instruction (optional)."/>
                    <details class="mt-3">
                        <summary class="text-muted">More options</summary>
                        <group class="mt-2">
                            <field name="record_ref"/>
                            <field name="document_category" string="Document type"/>
                            <field name="signer_type" string="Relationship to signer"/>
                            <field name="risk_level" string="Business risk"/>
                            <field name="formal_qes_required"/>
                        </group>
                        <div class="text-muted small">
                            <field name="recommendation_reason" nolabel="1" readonly="1"/>
                            <field name="recommendation_consequence" nolabel="1" readonly="1"/>
                        </div>
                    </details>
                </sheet>
                <footer>
                    <button name="generate" string="Continue" class="btn-primary" type="object"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
