<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="usl_sign.SignIframeTextRoleFix" t-inherit="sign_oca.sign_iframe_field_text" t-inherit-mode="extension">
        <xpath expr="//input" position="attributes">
            <attribute name="t-if">item.role_id == role_id</attribute>
        </xpath>
    </t>
    <t t-name="usl_sign.SignIframeCheckRoleFix" t-inherit="sign_oca.sign_iframe_field_check" t-inherit-mode="extension">
        <xpath expr="//input" position="attributes">
            <attribute name="t-if">item.role_id == role_id</attribute>
        </xpath>
    </t>
    <t t-name="usl_sign.DeclineDocumentDialog">
        <Dialog title="'Decline this document'" size="'md'">
            <p class="text-muted">The sender will see your reason and the request will stop.</p>
            <label class="form-label" for="usl_sign_decline_reason">Reason</label>
            <textarea id="usl_sign_decline_reason" class="form-control" rows="4" required="required" autofocus="autofocus" placeholder="Briefly explain why you cannot sign" t-on-input="updateReason"/>
            <t t-set-slot="footer">
                <button type="button" class="btn btn-secondary" t-on-click="props.close">Keep reviewing</button>
                <button type="button" class="btn btn-danger" title="Decline this request and record the reason for the requester." t-att-disabled="!state.reason.trim() || state.busy" t-on-click="confirm">
                    <i t-if="state.busy" class="fa fa-spinner fa-spin me-2"/>Decline document
                </button>
            </t>
        </Dialog>
    </t>
    <t t-name="usl_sign.InitialsDialog">
        <Dialog title="'Adopt Your Initials'">
            <div>
                <p class="text-muted">Use the initials you want placed in this document. Your name is shortened to initials automatically; you can also draw or upload them.</p>
                <NameAndSignature t-props="this.nameAndSignatureProps"/>
                <label class="form-check mt-3 mb-0">
                    <input class="form-check-input" type="checkbox" t-att-checked="adoption.autoFill" t-on-change="onAutoFillChanged"/>
                    <span class="form-check-label">
                        <strong class="d-block">Automatically fill repeated initials</strong>
                        <small class="text-muted">Reuse these initials for the remaining Initials fields as you continue through this document.</small>
                    </span>
                </label>
                <div class="mt16 small">By continuing, I agree to use these initials as my electronic initials on this document.</div>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-att-disabled="this.signature.isSignatureEmpty" t-on-click="this.onClickConfirm">Adopt Initials</button>
                <button class="btn btn-secondary" t-on-click="this.props.close">Discard</button>
            </t>
        </Dialog>
    </t>
    <t t-name="usl_sign.PersonalSignatureDialog">
        <Dialog title="'Adopt Your Signature'">
            <div>
                <p class="text-muted">Choose the signature you want to use in this document. You can type your full name, draw, or upload it.</p>
                <NameAndSignature t-props="this.nameAndSignatureProps"/>
                <label class="form-check mt-3 mb-0">
                    <input class="form-check-input" type="checkbox" t-att-checked="adoption.autoFill" t-on-change="onAutoFillChanged"/>
                    <span class="form-check-label">
                        <strong class="d-block">Automatically fill repeated signatures</strong>
                        <small class="text-muted">Reuse this signature for the remaining Signature fields as you continue through this document.</small>
                    </span>
                </label>
                <div class="mt16 small">By continuing, I agree to use this electronic signature on this document.</div>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-att-disabled="this.signature.isSignatureEmpty" t-on-click="this.onClickConfirm">Adopt Signature</button>
                <button class="btn btn-secondary" t-on-click="this.props.close">Discard</button>
            </t>
        </Dialog>
    </t>
    <t t-name="usl_sign.SignOcaPdfPortal" t-inherit="sign_oca.SignOcaPdfPortal" t-inherit-mode="extension">
        <xpath expr="//header" position="replace">
            <header class="usl_sign_portal_header">
                <div class="usl_sign_portal_brand" aria-label="Secure document signing">
                    <span class="usl_sign_portal_brand_mark"><i class="fa fa-shield" aria-hidden="true"/></span>
                    <span><small>Document signing</small><strong t-esc="info.company_name"/></span>
                </div>
                <div class="usl_sign_portal_instruction">
                    <strong>Review and sign</strong>
                    <span>Fill the highlighted fields on the document.</span>
                </div>
                <span class="badge rounded-pill text-bg-light border">
                    <i class="fa fa-lock me-1"/>
                    <t t-out="info.requested_trust === 'strong_personal' ? 'Strong personal signature' : 'Private signing session'"/>
                </span>
            </header>
        </xpath>
        <xpath expr="//div[hasclass('o_sign_validation_buttons')]" position="replace">
            <div class="o_sign_validation_buttons">
                <div class="usl_sign_field_guide" role="group" aria-label="Field guide" aria-live="polite">
                    <div>
                        <strong>
                            <t t-if="uslGuide.remaining" t-out="requiredFieldsRemainingLabel"/>
                            <t t-else="">Ready to sign</t>
                        </strong>
                        <span t-if="uslGuide.remaining">Select a field on the page, or use the guide.</span>
                        <span t-else="">Confirm below to finish.</span>
                    </div>
                    <div t-if="uslGuide.remaining" class="usl_sign_field_guide_actions">
                        <button type="button" class="btn btn-outline-secondary" aria-label="Previous incomplete field" title="Previous required field" t-on-click="previousIncompleteField">
                            <i class="fa fa-chevron-up me-1" aria-hidden="true"/>Previous
                        </button>
                        <button type="button" class="btn btn-primary" aria-label="Next incomplete field" title="Next required field" t-on-click="nextIncompleteField">
                            Next field<i class="fa fa-chevron-down ms-1" aria-hidden="true"/>
                        </button>
                    </div>
                </div>
                <div t-if="!uslGuide.remaining" class="usl_sign_consent" role="group" aria-labelledby="usl_sign_consent_title">
                    <label class="usl_sign_consent_choice" for="usl_sign_consent">
                        <input id="usl_sign_consent" class="form-check-input" type="checkbox" t-on-change="(ev) => this._onConsentChanged(ev)"/>
                        <span>
                            <strong id="usl_sign_consent_title">I reviewed this document and agree to sign electronically.</strong>
                        </span>
                    </label>
                    <details class="usl_sign_proof_details">
                        <summary>What proof is recorded?</summary>
                        <p class="usl_sign_proof_notice"><t t-out="info.proof_notice"/></p>
                        <p t-if="uslLocation.status !== 'idle'" class="usl_sign_location_status" role="status" aria-live="polite"><t t-out="locationMessage"/></p>
                    </details>
                    <div id="usl_sign_consent_error" class="text-danger small d-none">Consent is required.</div>
                    <div id="usl_sign_submission_error" class="alert alert-warning py-2 mt-2 mb-0 d-none" role="alert" tabindex="-1"></div>
                </div>
                <div class="usl_sign_portal_actions">
                    <button type="button" class="btn btn-link text-danger" t-on-click="() => this._onClickDecline()">Decline</button>
                    <button type="button" class="btn btn-primary" id="sign_oca_button" aria-label="Confirm consent and submit my signature" aria-describedby="usl_sign_submission_status" disabled="disabled" t-on-click="(ev) => this._onClickSign(ev)">
                        <span id="usl_sign_submission_spinner" class="spinner-border spinner-border-sm me-2 d-none" aria-hidden="true"/>
                        <span id="usl_sign_submission_label">Sign</span>
                    </button>
                </div>
                <div id="usl_sign_submission_status" class="usl_sign_submission_status d-none" role="status" aria-live="polite">
                    <i class="fa fa-lock" aria-hidden="true"/>
                    <span>Saving and checking your signature…</span>
                </div>
            </div>
        </xpath>
    </t>
    <t t-name="usl_sign.StandardSignatureDialog" t-inherit="web.SignatureDialog" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('mt16') and hasclass('small')]" position="replace">
            <div class="mt16 small">
                By continuing, I agree to sign this document electronically. The record will include my consent and the completed document.
            </div>
        </xpath>
    </t>
</templates>
