<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="web.FormView" t-inherit-mode="extension">
        <xpath expr="//t[@t-component='props.Renderer']" position="before">
            <UslSignBusinessSummary
                t-if="model.root.resId and !props.resModel.startsWith('sign.oca') and !props.resModel.startsWith('usl.sign')"
                resModel="props.resModel"
                resId="model.root.resId"
            />
        </xpath>
    </t>

    <t t-name="usl_sign.BusinessSummary">
        <section t-if="state.loading" class="usl-sign-business-summary usl-sign-business-summary--loading" aria-busy="true">
            <span class="o_loading_indicator"/> Loading signature status…
        </section>
        <section t-elif="state.error" class="usl-sign-business-summary usl-sign-business-summary--error" role="status">
            Signature status is temporarily unavailable. Refresh to retry.
        </section>
        <section t-elif="state.summary" class="usl-sign-business-summary" aria-label="USL Sign status">
            <div class="usl-sign-business-summary__main">
                <span class="usl-sign-business-summary__eyebrow">USL Sign</span>
                <button type="button" class="btn btn-link p-0 usl-sign-business-summary__title" t-on-click="openRequest"><t t-out="state.summary.request_name"/></button>
                <span class="badge text-bg-info" t-out="state.summary.state_label"/>
            </div>
            <div class="usl-sign-business-summary__details">
                <span><strong>Next:</strong> <t t-out="state.summary.next_step"/></span>
                <span><strong>Requested:</strong> <t t-out="state.summary.requested_trust"/></span>
                <span t-if="state.summary.achieved_trust"><strong>Achieved:</strong> <t t-out="state.summary.achieved_trust"/></span>
                <span><strong>Archive:</strong> <t t-out="state.summary.archive_state"/></span>
            </div>
            <div class="usl-sign-business-summary__actions">
                <button type="button" class="btn btn-sm btn-primary" t-on-click="openRequest">Open request</button>
                <a t-if="state.summary.final_url" class="btn btn-sm btn-outline-secondary" t-att-href="state.summary.final_url">Final PDF</a>
                <a t-if="state.summary.certificate_url" class="btn btn-sm btn-outline-secondary" t-att-href="state.summary.certificate_url">Certificate</a>
                <a t-if="state.summary.evidence_url" class="btn btn-sm btn-outline-secondary" t-att-href="state.summary.evidence_url">Evidence</a>
            </div>
        </section>
    </t>
</templates>
