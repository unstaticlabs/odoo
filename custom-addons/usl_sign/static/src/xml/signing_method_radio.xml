<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="usl_sign.SigningMethodRadio">
        <div role="radiogroup"
             t-attf-class="{{ this.hasTouch ? 'o_input' : '' }} o_{{ this.props.orientation }} usl_sign_method_comparison"
             t-att-aria-label="this.props.label">
            <t t-foreach="this.items" t-as="item" t-key="item[0]">
                <div t-attf-class="form-check o_radio_item usl_sign_method_card {{ item[0] === this.value ? 'is-selected' : '' }} {{ this.props.readonly ? 'is-readonly' : '' }} {{ this.hasTouch ? 'w-100' : '' }}" aria-atomic="true">
                    <input type="radio" class="form-check-input o_radio_input visually-hidden"
                           t-att-checked="item[0] === this.value"
                           t-att-disabled="this.props.readonly"
                           t-att-name="this.id"
                           t-att-data-value="item[0]"
                           t-att-data-index="item_index"
                           t-att-id="`${this.id}_${item[0]}`"
                           t-on-change="() => this.onChange(item)"/>
                    <label class="form-check-label o_form_label" t-att-for="`${this.id}_${item[0]}`">
                        <span class="usl_sign_method_card_header">
                            <strong t-out="this.detailsFor(item[0]).title"/>
                            <span t-if="this.detailsFor(item[0]).recommendation" class="badge rounded-pill text-bg-light border" t-out="this.detailsFor(item[0]).recommendation"/>
                        </span>
                        <span class="usl_sign_method_card_fit" t-out="this.detailsFor(item[0]).fit"/>
                        <span class="usl_sign_method_card_summary" t-out="this.detailsFor(item[0]).summary"/>
                        <dl class="usl_sign_method_facts">
                            <div><dt><i class="fa fa-user-o" aria-hidden="true"/>Signer check</dt><dd t-out="this.detailsFor(item[0]).authentication"/></div>
                            <div><dt><i class="fa fa-file-pdf-o" aria-hidden="true"/>Signed PDF</dt><dd t-out="this.detailsFor(item[0]).pdf"/></div>
                            <div><dt><i class="fa fa-shield" aria-hidden="true"/>Proof kept</dt><dd t-out="this.detailsFor(item[0]).evidence"/></div>
                        </dl>
                        <span t-attf-class="btn w-100 usl_sign_method_select {{ item[0] === this.value ? 'btn-primary' : 'btn-outline-primary' }}">
                            <i t-if="item[0] === this.value" class="fa fa-check me-1" aria-hidden="true"/>
                            <t t-if="item[0] === this.value">Selected</t>
                            <t t-else="">Choose this method</t>
                        </span>
                    </label>
                </div>
            </t>
        </div>
    </t>
</templates>
