<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_sign_operations" model="ir.cron">
        <field name="name">USL Sign: lifecycle, reminders and archive recovery</field>
        <field name="model_id" ref="sign_oca.model_sign_oca_request"/>
        <field name="state">code</field>
        <field name="code">model._cron_sign_operations()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_sign_daily_event_heads" model="ir.cron">
        <field name="name">USL Sign: build daily evidence manifests</field>
        <field name="model_id" ref="model_usl_sign_daily_manifest"/>
        <field name="state">code</field>
        <field name="code">model._cron_build_daily_manifests()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_sign_opentimestamps" model="ir.cron">
        <field name="name">USL Sign: submit and confirm daily timestamp proofs</field>
        <field name="model_id" ref="model_usl_sign_daily_manifest"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_opentimestamps()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
