#. module: usl_sign
#: model_terms:ir.ui.view,arch_db:usl_sign.sign_role_form_usl
msgid ""
"<strong>A signing role groups the fields completed by one person.</strong>\n"
"                        Use short names such as Client, Employee, or Company representative. You choose the actual person when you send a document."
msgstr ""
"<strong>Un rôle de signature regroupe les champs remplis par une même personne.</strong>\n"
"                        Utilisez des noms courts comme Client, Salarié ou Représentant de la société. Vous choisirez la personne concernée lors de l’envoi du document."

#. module: usl_sign
#: model_terms:ir.ui.view,arch_db:usl_sign.sign_daily_manifest_form
