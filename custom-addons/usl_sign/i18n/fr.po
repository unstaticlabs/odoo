#. module: usl_sign
#: model_terms:ir.ui.view,arch_db:usl_sign.sign_request_signer_result_form
msgid "<strong>Complete.</strong> The signed document and its proof are ready below."
msgstr "<strong>Complet.</strong> Le document signé et sa preuve sont prêts ci-dessous."

#. module: usl_sign
#: model_terms:ir.ui.view,arch_db:usl_sign.sign_request_signer_result_form
msgid ""
"<strong>Final storage is in progress.</strong> Your signed copy is safe in Odoo while "
"Paperless stores the signed PDF and proof package."
msgstr ""
"<strong>L'archivage final est en cours.</strong> Votre copie signée est conservée dans"
" Odoo pendant que Paperless archive le PDF signé et le dossier de preuves."

#. module: usl_sign
#: model_terms:ir.ui.view,arch_db:usl_sign.sign_daily_manifest_form
msgid ""
"<strong>Independent existence proof confirmed.</strong>\n"
"                        The documents listed in this daily record existed no later than"
msgstr ""
"<strong>Preuve d'existence indépendante confirmée.</strong>\n"
"                        Les documents listés dans cet enregistrement quotidien existaient au plus tard le"

#. module: usl_sign
#: model_terms:ir.ui.view,arch_db:usl_sign.sign_external_journey_form
msgid "<strong>Next step:</strong>"
msgstr "<strong>Étape suivante :</strong>"

#. module: usl_sign
#: model_terms:ir.ui.view,arch_db:usl_sign.sign_template_form_usl
msgid ""
"<strong>Next: place the fields people need to complete.</strong>\n"
"                        Save happens automatically in the editor. Publish only after every field has the right role."
msgstr ""
"<strong>Étape suivante : placez les champs que les personnes doivent compléter.</strong>\n"
"                        L'enregistrement se fait automatiquement dans l'éditeur. Publiez uniquement lorsque chaque champ a le bon rôle."

#. module: usl_sign
#: model_terms:ir.ui.view,arch_db:usl_sign.sign_enrollment_form
msgid ""
"<strong>Next: review the identity.</strong> Check that the Pocket ID account belongs "
"to this person and that your organization already knows them."
msgstr ""
"<strong>Étape suivante : vérifiez l'identité.</strong> Assurez-vous que le compte "
"Pocket ID appartient à cette personne et que votre organisation la connaît déjà."

#. module: usl_sign
#: model_terms:ir.ui.view,arch_db:usl_sign.sign_enrollment_form
msgid ""
"<strong>Next: send the setup email.</strong> The person connects their Pocket ID "
"account; no document is signed during setup."
msgstr ""
"<strong>Étape suivante : envoyez l'e-mail de configuration.</strong> La personne "
"connecte son compte Pocket ID ; aucun document n'est signé pendant la configuration."

#. module: usl_sign
#: model_terms:ir.ui.view,arch_db:usl_sign.sign_enrollment_form
msgid ""
"<strong>Ready for Strong personal signing.</strong> Pocket ID will ask for a fresh "
"confirmation every time this person signs."
msgstr ""
"<strong>Prêt pour la signature personnelle renforcée.</strong> Pocket ID demandera une"
" nouvelle confirmation à chaque signature."

#. module: usl_sign
#: model_terms:ir.ui.view,arch_db:usl_sign.sign_template_form_usl
msgid ""
"<strong>Ready to use.</strong> This version is locked so requests always use the "
"layout you reviewed. Create a new version to make changes."
msgstr ""
"<strong>Prêt à l'emploi.</strong> Cette version est verrouillée afin que les demandes "
"utilisent toujours la mise en page que vous avez vérifiée. Créez une nouvelle version "
"pour apporter des modifications."

#. module: usl_sign
#: model_terms:ir.ui.view,arch_db:usl_sign.sign_enrollment_my_form
msgid ""
"<strong>Ready.</strong> Pocket ID will ask for a fresh passkey confirmation whenever "
"you make a strong personal signature."
msgstr ""
"<strong>Prêt.</strong> Pocket ID demandera une nouvelle confirmation par clé d’accès à"
" chaque signature personnelle renforcée."

#. module: usl_sign
#: model_terms:ir.ui.view,arch_db:usl_sign.sign_daily_manifest_form
msgid ""
"<strong>The Bitcoin proof is confirmed, but its daily dossier needs "
"attention.</strong>"
msgstr ""
"<strong>La preuve Bitcoin est confirmée, mais son dossier quotidien nécessite une "
"intervention.</strong>"

#. module: usl_sign
#: model_terms:ir.ui.view,arch_db:usl_sign.sign_enrollment_form
msgid ""
"<strong>This identity link is revoked.</strong> It cannot authorize new Strong "
"signatures. Completed documents remain valid and unchanged."
msgstr ""
"<strong>Cette association d’identité a été révoquée.</strong> Elle ne peut plus "
"autoriser de nouvelles signatures renforcées. Les documents finalisés restent valides "
"et inchangés."

#. module: usl_sign
#: model_terms:ir.ui.view,arch_db:usl_sign.sign_request_signer_result_form
msgid ""
"<strong>Verification failed.</strong> The requester needs to review this result before"
" it can be used."
msgstr ""
"<strong>Vérification échouée.</strong> Le demandeur doit examiner ce résultat avant de"
" pouvoir l'utiliser."

#. module: usl_sign
#: model_terms:ir.ui.view,arch_db:usl_sign.sign_request_form_usl
msgid ""
"<strong>Which file should I use?</strong>\n"
"                                <span>Use the signed PDF day to day. The certificate is a short receipt. The complete proof package keeps every file and check an auditor may need.</span>"
msgstr ""
"<strong>Quel fichier dois-je utiliser ?</strong>\n"
"                                <span>Utilisez le PDF signé au quotidien. Le certificat est un reçu court. Le dossier de preuves complet conserve tous les fichiers et vérifications qu'un auditeur pourrait nécessiter.</span>"

#. module: usl_sign
#: model_terms:ir.ui.view,arch_db:usl_sign.sign_enrollment_my_form
msgid ""
"<strong>Your Pocket ID account is connected.</strong> Your organization must now "
"review the identity link. You do not need to register another passkey."
msgstr ""
"<strong>Votre compte Pocket ID est connecté.</strong> Votre organisation doit "
"maintenant vérifier cette association d’identité. Vous n’avez pas besoin d’enregistrer"
" une autre clé d’accès."

#. module: usl_sign
#: model_terms:ir.ui.view,arch_db:usl_sign.sign_enrollment_my_form
msgid ""
"<strong>Your Pocket ID account is not connected yet.</strong> Open the personal setup "
"link sent by an identity reviewer. The link connects your account; it does not sign a "
"document."
msgstr ""
"<strong>Votre compte Pocket ID n'est pas encore connecté.</strong> Ouvrez le lien de "
"configuration personnel envoyé par un responsable de la vérification d'identité. Le "
"lien connecte votre compte ; il ne signe pas de document."

#. module: usl_sign
#: model_terms:ir.ui.view,arch_db:usl_sign.strong_enrollment_page
msgid ""
"<strong>Your account stays under your control.</strong> Pocket ID keeps your passkeys."
msgstr ""
"<strong>Votre compte reste sous votre contrôle.</strong> Pocket ID conserve vos clés "
"d’accès."

