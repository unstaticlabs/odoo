#. module: usl_sign
#: model_terms:ir.ui.view,arch_db:usl_sign.sign_request_form_usl
msgid ""
"<strong class=\"d-block mb-1\">Archived Odoo Online signing record</strong>\n"
"                        <span class=\"d-block\">This document and its original Odoo Online certificate are preserved in Documents. USL Sign did not rerun the historical signing, identity, certificate, trust, or revocation checks, so this record does not claim native USL completion or verification.</span>"
msgstr ""
"<strong class=\"d-block mb-1\">Enregistrement de signature Odoo Online archivé</strong>\n"
"                        <span class=\"d-block\">Ce document et son certificat Odoo Online d’origine sont conservés dans Documents. USL Sign n’a pas réexécuté les contrôles historiques de signature, d’identité, de certificat, de confiance ou de révocation. Cet enregistrement ne prétend donc pas avoir été finalisé ni vérifié nativement par USL.</span>"

#. module: usl_sign
#: model_terms:ir.ui.view,arch_db:usl_sign.sign_request_signer_result_form
msgid ""
"<strong class=\"d-block mb-1\">Final storage is delayed.</strong>\n"
"                                <span class=\"d-block\">Your signature is recorded, but the request is not complete until Paperless stores both the signed PDF and proof package.</span>"
msgstr ""
"<strong class=\"d-block mb-1\">L’archivage final est retardé.</strong>\n"
"                                <span class=\"d-block\">Votre signature est enregistrée, mais la demande ne sera finalisée qu’après l’archivage du PDF signé et du dossier de preuves dans Paperless.</span>"

#. module: usl_sign
#: model_terms:ir.ui.view,arch_db:usl_sign.sign_request_form_usl
msgid ""
"<strong class=\"d-block mb-1\">Final storage is in progress.</strong>\n"
"                                <span class=\"d-block\">The signed PDF and proof package are safe in Odoo while Paperless finishes storing both archive copies.</span>"
msgstr ""
"<strong class=\"d-block mb-1\">L'archivage final est en cours.</strong>\n"
"                                <span class=\"d-block\">Le PDF signé et le dossier de preuves sont conservés dans Odoo pendant que Paperless termine l'archivage des deux copies.</span>"

#. module: usl_sign
#: model_terms:ir.ui.view,arch_db:usl_sign.sign_request_form_usl
msgid ""
"<strong class=\"d-block mb-1\">Final storage needs attention</strong>\n"
"                                <span class=\"d-block\">Odoo retained the signed PDF and proof package, but this request is not complete until Paperless confirms both archive copies.</span>"
msgstr ""
"<strong class=\"d-block mb-1\">L'archivage final nécessite une intervention</strong>\n"
"                                <span class=\"d-block\">Odoo a conservé le PDF signé et le dossier de preuves, mais cette demande n'est pas complète tant que Paperless n'a pas confirmé les deux copies d'archive.</span>"

#. module: usl_sign
#: model_terms:ir.ui.view,arch_db:usl_sign.sign_request_signer_result_form
msgid ""
"<strong class=\"d-block mb-1\">Recorded by Odoo Online.</strong>\n"
"                        <span>The signed PDF and original Odoo Online certificate are preserved in Documents. USL Sign did not rerun or certify the historical signing checks.</span>"
msgstr ""
"<strong class=\"d-block mb-1\">Enregistré par Odoo Online.</strong>\n"
"                        <span>Le PDF signé et le certificat original Odoo Online sont conservés dans Documents. USL Sign n'a pas réexécuté ni certifié les vérifications de signature historiques.</span>"

#. module: usl_sign
#: model_terms:ir.ui.view,arch_db:usl_sign.sign_request_form_usl
msgid ""
"<strong class=\"d-block mb-1\">Signer identity setup is required before "
"sending.</strong>"
msgstr ""
"<strong class=\"d-block mb-1\">La configuration de l'identité du signataire est "
"requise avant l'envoi.</strong>"

