<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sign_privilege" model="res.groups.privilege">
        <field name="name">Sign</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_sign_user" model="res.groups">
        <field name="name">Sign user</field>
        <field name="privilege_id" ref="sign_privilege"/>
        <field name="implied_ids" eval="[(4, ref('sign_oca.sign_oca_group_user'))]"/>
    </record>
    <record id="group_sign_template_manager" model="res.groups">
        <field name="name">Template manager</field>
        <field name="privilege_id" ref="sign_privilege"/>
        <field name="implied_ids" eval="[(4, ref('group_sign_user'))]"/>
    </record>
    <record id="group_sign_reviewer" model="res.groups">
        <field name="name">Evidence reviewer</field>
        <field name="privilege_id" ref="sign_privilege"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_sign_admin" model="res.groups">
        <field name="name">Sign administrator</field>
        <field name="privilege_id" ref="sign_privilege"/>
        <field name="implied_ids" eval="[
            (4, ref('group_sign_template_manager')),
            (4, ref('group_sign_reviewer')),
            (4, ref('sign_oca.sign_oca_group_admin'))
        ]"/>
    </record>

    <!-- OCA gives every internal user read access to requests. This rule turns
         that access into the intended signer/responsible boundary. -->
    <record id="request_internal_boundary" model="ir.rule">
        <field name="name">Signature requests: responsible or assigned signer</field>
        <field name="model_id" ref="sign_oca.model_sign_oca_request"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('signer_ids.partner_id', 'child_of', [user.partner_id.commercial_partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>
    <record id="request_user_manage" model="ir.rule">
        <field name="name">Signature users: manage own requests</field>
        <field name="model_id" ref="sign_oca.model_sign_oca_request"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_sign_user'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>
    <record id="request_reviewer_read" model="ir.rule">
        <field name="name">Signature reviewers: completed evidence</field>
        <field name="model_id" ref="sign_oca.model_sign_oca_request"/>
        <field name="domain_force">[('state', '=', 'completed')]</field>
        <field name="groups" eval="[(4, ref('group_sign_reviewer'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>
    <record id="request_admin_all" model="ir.rule">
        <field name="name">Signature administrators: all company requests</field>
        <field name="model_id" ref="sign_oca.model_sign_oca_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_sign_admin'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>
    <record id="request_signer_user_manage" model="ir.rule">
        <field name="name">Signature users: manage recipients on own requests</field>
        <field name="model_id" ref="sign_oca.model_sign_oca_request_signer"/>
        <field name="domain_force">[('request_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_sign_user'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>
    <record id="request_signer_admin_all" model="ir.rule">
        <field name="name">Signature administrators: all company recipients</field>
        <field name="model_id" ref="sign_oca.model_sign_oca_request_signer"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_sign_admin'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>
    <record id="request_signer_reviewer_read" model="ir.rule">
        <field name="name">Signature reviewers: recipients on completed requests</field>
        <field name="model_id" ref="sign_oca.model_sign_oca_request_signer"/>
        <field name="domain_force">[('request_id.state', '=', 'completed')]</field>
        <field name="groups" eval="[(4, ref('group_sign_reviewer'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <record id="template_company" model="ir.rule">
        <field name="name">Signature templates: allowed companies</field>
        <field name="model_id" ref="sign_oca.model_sign_oca_template"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="template_item_company" model="ir.rule">
        <field name="name">Signature template fields: allowed companies</field>
        <field name="model_id" ref="sign_oca.model_sign_oca_template_item"/>
        <field name="domain_force">[('template_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="policy_company" model="ir.rule">
        <field name="name">Signature policies: allowed companies</field>
        <field name="model_id" ref="model_usl_sign_policy"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="evidence_company" model="ir.rule">
        <field name="name">Signature evidence: allowed companies</field>
        <field name="model_id" ref="model_usl_sign_evidence"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="evidence_user_read" model="ir.rule">
        <field name="name">Signature users: evidence on own requests</field>
        <field name="model_id" ref="model_usl_sign_evidence"/>
        <field name="domain_force">[('request_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_sign_user'))]"/>
    </record>
    <record id="evidence_reviewer_read" model="ir.rule">
        <field name="name">Signature reviewers: completed evidence</field>
        <field name="model_id" ref="model_usl_sign_evidence"/>
        <field name="domain_force">[('request_id.state', '=', 'completed')]</field>
        <field name="groups" eval="[(4, ref('group_sign_reviewer'))]"/>
    </record>
    <record id="provider_event_company" model="ir.rule">
        <field name="name">Signature provider events: allowed companies</field>
        <field name="model_id" ref="model_usl_sign_provider_event"/>
        <field name="domain_force">[('request_id.company_id', 'in', company_ids)]</field>
    </record>
</odoo>
