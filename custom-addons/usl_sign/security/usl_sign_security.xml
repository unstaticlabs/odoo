<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sign_privilege" model="res.groups.privilege">
        <field name="name">USL Sign</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_sign_user" model="res.groups">
        <field name="name">Sign user</field>
        <field name="privilege_id" ref="sign_privilege"/>
        <field name="implied_ids" eval="[(4, ref('sign_oca.sign_oca_group_user'))]"/>
    </record>
    <record id="group_sign_template_manager" model="res.groups">
        <field name="name">Template manager</field>
        <field name="privilege_id" ref="sign_privilege"/>
        <field name="implied_ids" eval="[(4, ref('group_sign_user'))]"/>
    </record>
    <record id="group_sign_trust_override" model="res.groups">
        <field name="name">Trust-level override</field>
        <field name="privilege_id" ref="sign_privilege"/>
        <field name="implied_ids" eval="[(4, ref('group_sign_user'))]"/>
    </record>
    <record id="group_sign_identity_reviewer" model="res.groups">
        <field name="name">Identity reviewer</field>
        <field name="privilege_id" ref="sign_privilege"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_sign_evidence_reviewer" model="res.groups">
        <field name="name">Evidence reviewer</field>
        <field name="privilege_id" ref="sign_privilege"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_sign_admin" model="res.groups">
        <field name="name">Sign administrator</field>
        <field name="privilege_id" ref="sign_privilege"/>
        <field name="implied_ids" eval="[
            (4, ref('group_sign_template_manager')),
            (4, ref('group_sign_trust_override')),
            (4, ref('group_sign_identity_reviewer')),
            (4, ref('group_sign_evidence_reviewer')),
            (4, ref('sign_oca.sign_oca_group_admin'))
        ]"/>
    </record>

    <record id="request_company" model="ir.rule">
        <field name="name">Signature requests: allowed companies</field>
        <field name="model_id" ref="sign_oca.model_sign_oca_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="request_user_manage" model="ir.rule">
        <field name="name">Signature users: requester, coordinator or signer</field>
        <field name="model_id" ref="sign_oca.model_sign_oca_request"/>
        <field name="domain_force">['|', '|', ('user_id', '=', user.id), ('coordinator_ids', 'in', [user.id]), ('signer_ids.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_sign_user'))]"/>
    </record>
    <record id="request_admin_all" model="ir.rule">
        <field name="name">Signature administrators: company requests</field>
        <field name="model_id" ref="sign_oca.model_sign_oca_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_sign_admin'))]"/>
    </record>
    <record id="request_trust_override_all" model="ir.rule">
        <field name="name">Trust-level reviewers: company requests</field>
