<odoo>
    <record id="usl_project_restore_run_list" model="ir.ui.view">
        <field name="name">usl.project.restore.run.list</field>
        <field name="model">usl.project.restore.run</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="started_at"/>
                <field name="source_database"/>
                <field name="target_database"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'passed'"
                       decoration-warning="status == 'partial'"
                       decoration-danger="status == 'failed'"/>
                <field name="project_count"/>
                <field name="task_count"/>
                <field name="message_count"/>
                <field name="attachment_count"/>
                <field name="issue_count"/>
            </list>
        </field>
    </record>

    <record id="usl_project_restore_run_form" model="ir.ui.view">
        <field name="name">usl.project.restore.run.form</field>
        <field name="model">usl.project.restore.run</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="status" widget="badge"/>
                            <field name="source_database"/>
                            <field name="source_snapshot"/>
                            <field name="target_database"/>
                        </group>
                        <group>
                            <field name="started_at"/>
                            <field name="finished_at"/>
                            <field name="project_count"/>
                            <field name="task_count"/>
                            <field name="message_count"/>
                            <field name="attachment_count"/>
                            <field name="issue_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Summary">
                            <field name="statistics_json" widget="json"/>
                        </page>
                        <page string="Issues">
                            <field name="issue_ids" readonly="1">
                                <list>
                                    <field name="severity" widget="badge"/>
                                    <field name="source_model"/>
                                    <field name="source_id"/>
                                    <field name="description"/>
                                    <field name="resolved"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="usl_project_restore_run_action" model="ir.actions.act_window">
        <field name="name">Restoration Runs</field>
        <field name="res_model">usl.project.restore.run</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="usl_project_restore_menu"
              name="Restoration Runs"
              parent="project.menu_project_config"
              action="usl_project_restore_run_action"
              groups="project.group_project_manager"
              sequence="95"/>
</odoo>

