<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
    THESIS: Feedback is a short, trusted handoff inside Odoo, not a ticketing portal.
    OWN-WORLD: Native Odoo form controls, restrained information copy, and one clear submit action.
    STORY: Describe the issue, choose its routing signals, decide whether to share page context, and send.
    FIRST VIEWPORT: Summary and description lead; category, priority, attachments, and privacy choice follow without tabs.
    FORM: Focused native modal extending the established Operate surface; the approved product brief is the source decision.
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance
    -->
    <record id="view_feedback_submission_form" model="ir.ui.view">
        <field name="name">usl.feedback.submission.form</field>
        <field name="model">usl.feedback.submission</field>
        <field name="arch" type="xml">
            <form string="Send Feedback" class="o_usl_feedback_submission">
                <sheet>
                    <div class="oe_title">
                        <label for="summary"/>
                        <h1>
                            <field name="summary" placeholder="What should we know?"/>
                        </h1>
                    </div>
                    <field name="description"
                           placeholder="Describe what happened, what you expected, or what would make the workflow clearer."/>
                    <group col="4" class="mt-3">
                        <field name="category"/>
                        <field name="priority"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group string="Attachments">
                        <field name="attachment_ids"
                               widget="many2many_binary"
                               nolabel="1"
                               options="{'accepted_file_extensions': '*'}"/>
                        <div class="text-muted small" role="note">
                            Add up to 10 screenshots or files that help explain the feedback.
                        </div>
                    </group>
                    <group string="Page context" class="o_usl_feedback_context">
                        <field name="include_page_context"/>
                        <div class="text-muted small" role="note" colspan="4">
                            When enabled, Odoo shares only the current action, readable record identifier,
                            company, viewport size, and exact release. URLs, query strings, tokens,
                            fragments, and arbitrary browser state are never collected.
                        </div>
                    </group>
                    <field name="source_action_id" invisible="1"/>
                    <field name="source_model_name" invisible="1"/>
                    <field name="source_record_id" invisible="1"/>
                    <field name="viewport_width" invisible="1"/>
                    <field name="viewport_height" invisible="1"/>
                </sheet>
                <footer>
                    <button name="action_submit"
                            string="Send feedback"
                            type="object"
                            class="oe_highlight"
                            title="Create a private feedback task for the active company. This does not send anything outside Odoo."
                            data-hotkey="s"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_feedback_submission" model="ir.actions.act_window">
        <field name="name">Send Feedback</field>
        <field name="res_model">usl.feedback.submission</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_feedback_submission_form"/>
        <field name="target">new</field>
        <field name="context">{'dialog_size': 'medium'}</field>
    </record>
</odoo>
