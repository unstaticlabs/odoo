<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_feedback" model="res.groups.privilege">
        <field name="name">Product Feedback</field>
        <field name="category_id" ref="base.module_category_services"/>
        <field name="sequence">40</field>
    </record>

    <record id="group_feedback_maintainer" model="res.groups">
        <field name="name">Feedback Maintainer</field>
        <field name="comment">Manage the shared Product Feedback Project and its canonical card fields.</field>
        <field name="privilege_id" ref="privilege_feedback"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_feedback_agent" model="res.groups">
        <field name="name">Feedback Agent (read-only service)</field>
        <field name="comment">Dedicated non-human identity used only by the Projects MCP. It must not be an Internal User or a Feedback Maintainer.</field>
    </record>

    <data noupdate="1">
        <record id="rule_feedback_project_maintainer" model="ir.rule">
            <field name="name">Product Feedback Project: maintainer operations</field>
            <field name="model_id" ref="project.model_project_project"/>
            <field name="groups" eval="[Command.link(ref('group_feedback_maintainer'))]"/>
            <field name="domain_force">[('usl_feedback_project', '=', True)]</field>
        </record>
        <record id="rule_feedback_task_maintainer" model="ir.rule">
            <field name="name">Product Feedback Task: maintainer operations</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="groups" eval="[Command.link(ref('group_feedback_maintainer'))]"/>
            <field name="domain_force">[('project_id.usl_feedback_project', '=', True)]</field>
        </record>
        <record id="rule_feedback_stage_maintainer" model="ir.rule">
            <field name="name">Product Feedback Stage: maintainer operations</field>
            <field name="model_id" ref="project.model_project_task_type"/>
            <field name="groups" eval="[Command.link(ref('group_feedback_maintainer'))]"/>
            <field name="domain_force">[('project_ids.usl_feedback_project', '=', True)]</field>
        </record>
        <record id="rule_feedback_tag_maintainer" model="ir.rule">
            <field name="name">Product Feedback Tag: maintainer operations</field>
            <field name="model_id" ref="project.model_project_tags"/>
            <field name="groups" eval="[Command.link(ref('group_feedback_maintainer'))]"/>
            <field name="domain_force">[('usl_feedback_tag', '=', True)]</field>
        </record>

        <record id="rule_feedback_project_agent" model="ir.rule">
            <field name="name">Feedback Agent: shared feedback project only</field>
            <field name="model_id" ref="project.model_project_project"/>
            <field name="groups" eval="[Command.link(ref('group_feedback_agent'))]"/>
            <field name="domain_force">[('usl_feedback_project', '=', True)]</field>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_feedback_task_agent" model="ir.rule">
            <field name="name">Feedback Agent: shared feedback cards only</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="groups" eval="[Command.link(ref('group_feedback_agent'))]"/>
            <field name="domain_force">[('project_id.usl_feedback_project', '=', True)]</field>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_feedback_stage_agent" model="ir.rule">
            <field name="name">Feedback Agent: feedback stages only</field>
            <field name="model_id" ref="project.model_project_task_type"/>
            <field name="groups" eval="[Command.link(ref('group_feedback_agent'))]"/>
            <field name="domain_force">[('project_ids.usl_feedback_project', '=', True)]</field>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_feedback_tag_agent" model="ir.rule">
            <field name="name">Feedback Agent: governed feedback tags only</field>
            <field name="model_id" ref="project.model_project_tags"/>
            <field name="groups" eval="[Command.link(ref('group_feedback_agent'))]"/>
            <field name="domain_force">[('usl_feedback_tag', '=', True)]</field>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
