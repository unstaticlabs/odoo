<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_feedback" model="res.groups.privilege">
        <field name="name">Product Feedback</field>
        <field name="category_id" ref="base.module_category_services"/>
        <field name="sequence">40</field>
    </record>

    <record id="group_feedback_maintainer" model="res.groups">
        <field name="name">Feedback Maintainer</field>
        <field name="comment">Operate the governed Product Feedback Project. Grant explicitly to human maintainers or approved automation/service identities.</field>
        <field name="privilege_id" ref="privilege_feedback"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <data noupdate="1">
        <record id="rule_feedback_project_boundary" model="ir.rule">
            <field name="name">Product Feedback Project: maintainers only</field>
            <field name="model_id" ref="project.model_project_project"/>
            <field name="domain_force">[(1, '=', 1)] if user.has_group('usl_feedback.group_feedback_maintainer') else [('usl_feedback_project', '=', False)]</field>
        </record>

        <record id="rule_feedback_task_boundary" model="ir.rule">
            <field name="name">Product Feedback Task: reporter or maintainer</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="domain_force">[(1, '=', 1)] if user.has_group('usl_feedback.group_feedback_maintainer') else ['|', ('usl_feedback_reporter_id', '=', False), ('usl_feedback_reporter_id', '=', user.id)]</field>
        </record>

        <record id="rule_feedback_project_maintainer" model="ir.rule">
            <field name="name">Product Feedback Project: maintainer operations</field>
            <field name="model_id" ref="project.model_project_project"/>
            <field name="groups" eval="[Command.link(ref('group_feedback_maintainer'))]"/>
            <field name="domain_force">[('usl_feedback_project', '=', True)]</field>
        </record>

        <record id="rule_feedback_task_maintainer" model="ir.rule">
            <field name="name">Product Feedback Task: maintainer operations</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="groups" eval="[Command.link(ref('group_feedback_maintainer'))]"/>
            <field name="domain_force">[('usl_feedback_reporter_id', '!=', False)]</field>
        </record>
    </data>
</odoo>
