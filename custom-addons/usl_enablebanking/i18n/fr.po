#. module: usl_enablebanking
#: model:ir.model.constraint,message:usl_enablebanking.constraint_usl_enablebanking_account_alias_company_hash_unique
msgid ""
"A bank account identification must resolve to one account in each company."
msgstr ""
"Un identifiant bancaire doit désigner un seul compte dans chaque société."

#. module: usl_enablebanking
#. odoo-python
#: code:addons/usl_enablebanking/models/account.py:0
msgid "A bank account must belong to its connection's company."
msgstr "Un compte bancaire doit appartenir à la société de sa connexion."

#. module: usl_enablebanking
#: model:ir.model.constraint,message:usl_enablebanking.constraint_usl_enablebanking_import_entry_unique
msgid "A bank entry can be imported only once for an account."
msgstr ""
"Une écriture bancaire ne peut être importée qu’une seule fois par compte."

#. module: usl_enablebanking
#. odoo-python
#: code:addons/usl_enablebanking/models/connection.py:0
msgid ""
"A bank entry reference has conflicting financial details. Nothing from this "
"import was saved. Check the source transaction before retrying."
msgstr ""
"Une référence bancaire présente des données financières contradictoires. "
"Aucune opération de cet import n’a été enregistrée. Vérifiez l’opération "
"source avant de réessayer."

#. module: usl_enablebanking
#: model:ir.model.constraint,message:usl_enablebanking.constraint_usl_enablebanking_account_journal_unique
msgid "A bank journal can be mapped to only one connected account."
msgstr ""
"Un journal bancaire ne peut être associé qu’à un seul compte connecté."

#. module: usl_enablebanking
#. odoo-python
#: code:addons/usl_enablebanking/models/connection.py:0
msgid ""
"A booked amount cannot be represented at the account currency's precision. "
"Nothing from this import was saved. Check the bank response before retrying."
msgstr ""
"Un montant comptabilisé par la banque ne peut pas être représenté avec la "
"précision de la devise du compte. Aucune opération de cet import n’a été "
"enregistrée. Vérifiez la réponse bancaire avant de réessayer."

#. module: usl_enablebanking
#: model:ir.model.constraint,message:usl_enablebanking.constraint_online_bank_statement_provider_enablebanking_account_unique
msgid "A connected account can have only one online provider."
msgstr ""
"Un compte connecté ne peut avoir qu’un seul fournisseur de synchronisation."

#. module: usl_enablebanking
#. odoo-python
#: code:addons/usl_enablebanking/models/connection.py:0
msgid ""
"A connection with discovered accounts must stay in its original company."
msgstr ""
"Une connexion comportant des comptes découverts doit conserver sa société "
"d’origine."

#. module: usl_enablebanking
#: model:ir.model.constraint,message:usl_enablebanking.constraint_usl_enablebanking_import_native_line_unique
msgid "A native bank line can have only one provider provenance record."
msgstr ""
"Une opération bancaire Odoo ne peut avoir qu’un seul enregistrement de "
"traçabilité du fournisseur."

