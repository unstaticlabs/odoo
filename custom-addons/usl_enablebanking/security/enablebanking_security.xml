<odoo noupdate="1">
    <record id="connection_company_rule" model="ir.rule">
        <field name="name">Bank connections by company</field>
        <field name="model_id" ref="model_usl_enablebanking_connection"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="account_company_rule" model="ir.rule">
        <field name="name">Connected bank accounts by company</field>
        <field name="model_id" ref="model_usl_enablebanking_account"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="alias_company_rule" model="ir.rule">
        <field name="name">Bank identity aliases by company</field>
        <field name="model_id" ref="model_usl_enablebanking_account_alias"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="balance_company_rule" model="ir.rule">
        <field name="name">Bank balances by company</field>
        <field name="model_id" ref="model_usl_enablebanking_balance"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="import_company_rule" model="ir.rule">
        <field name="name">Bank import provenance by company</field>
        <field name="model_id" ref="model_usl_enablebanking_import"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
