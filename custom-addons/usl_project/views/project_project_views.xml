<odoo>
    <record id="view_project_kanban_company_label" model="ir.ui.view">
        <field name="name">project.project.kanban.company.label</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="inside">
                <field name="usl_show_company_on_card"/>
            </xpath>
            <xpath expr="//t[@t-name='card']//div[hasclass('o_project_kanban_body')]" position="inside">
                <div t-if="record.usl_show_company_on_card.raw_value"
                     class="text-muted d-flex align-items-baseline">
                    <span class="fa fa-building-o me-2" aria-label="Company" title="Company"/>
                    <field class="text-truncate" name="company_id"/>
                </div>
            </xpath>
        </field>
    </record>

    <!--
        The Company field offers every company the user is *allowed*, but the
        `project.project_comp_rule` record rule keys off the companies that are
        *active* in the company switcher. Choosing an allowed-but-inactive
        company therefore hides the project from the person who just filed it,
        and Odoo answers the reload with a bare AccessError. Restrict the choice
        to the active companies so a project cannot be filed out of sight.
    -->
    <record id="view_project_form_company_active_only" model="ir.ui.view">
        <field name="name">project.project.form.company.active.only</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id'][@groups='base.group_multi_company']" position="attributes">
                <attribute name="domain">[('id', 'in', allowed_company_ids)]</attribute>
            </xpath>
        </field>
    </record>

    <!-- The project list is multi_edit, so the same trap loses a whole selection at once. -->
    <record id="view_project_list_company_active_only" model="ir.ui.view">
        <field name="name">project.project.list.company.active.only</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id'][@groups='base.group_multi_company']" position="attributes">
                <attribute name="domain">[('id', 'in', allowed_company_ids)]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
