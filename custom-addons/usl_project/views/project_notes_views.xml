<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_project_team_notes" model="ir.ui.view">
        <field name="name">project.project.form.team.notes</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="team_notes" string="Notes" invisible="not id">
                    <widget name="usl_project_notes"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
