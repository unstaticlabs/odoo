<odoo>
    <record id="project_task_kanban_reference" model="ir.ui.view">
        <field name="name">project.task.kanban.reference</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//t[@t-name='card']/main/field[@name='name']" position="after">
                <widget name="usl_task_return_badge" groups="base.group_user"/>
                <span class="o_usl_task_reference text-muted small" title="Task ID">
                    #<field name="id" options="{'enable_formatting': False}"/>
                </span>
            </xpath>
        </field>
    </record>

    <record id="project_task_kanban_swimlanes" model="ir.ui.view">
        <field name="name">project.task.kanban.swimlanes</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes"><attribute name="js_class">usl_task_swimlanes</attribute></xpath>
        </field>
    </record>
    <record id="project_task_search_content" model="ir.ui.view">
        <field name="name">project.task.search.content</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form_base"/>
        <field name="arch" type="xml">
            <xpath expr="//group[filter[@name='stage']]" position="inside">
                <filter name="usl_personal_stage" string="Personal Stage" context="{'group_by': 'personal_stage_type_id'}" invisible="not context.get('my_tasks')"/>
            </xpath>
            <field name="name" position="attributes">
                <attribute name="filter_domain">[('usl_search_text', 'ilike', self)]</attribute>
            </field>
        </field>
    </record>
    <record id="project_task_type_form_reactivation_role" model="ir.ui.view">
        <field name="name">project.task.type.form.reactivation.role</field>
        <field name="model">project.task.type</field>
        <field name="inherit_id" ref="project.task_type_edit"/>
        <field name="arch" type="xml">
            <field name="fold" position="after">
                <field name="usl_reactivation_role" placeholder="No automatic reactivation role"/>
            </field>
        </field>
    </record>

    <record id="project_task_form_planning" model="ir.ui.view">
        <field name="name">project.task.form.planning.compatibility</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <label for="date_deadline" position="before">
                <field name="planned_date_begin"/>
            </label>
            <div id="date_deadline_and_recurring_task" position="after">
                <field name="usl_dependency_date_warning"
                       class="text-warning"
                       readonly="1"
                       nolabel="1"
                       colspan="2"
                       invisible="not usl_dependency_date_warning"/>
            </div>
        </field>
    </record>

    <record id="project_task_list_planning" model="ir.ui.view">
        <field name="name">project.task.list.planning.compatibility</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2"/>
        <field name="arch" type="xml">
            <field name="date_deadline" position="before">
                <field name="planned_date_begin" optional="hide"/>
            </field>
        </field>
    </record>
    <record id="project_task_form_github_reference" model="ir.ui.view">
        <field name="name">project.task.form.github.reference</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <field name="tag_ids" position="after">
                <field name="github_url" widget="url" placeholder="Pull request, issue, document or deploy run URL"/>
            </field>
            <field name="task_properties" position="attributes">
                <attribute name="widget">usl_task_properties</attribute>
            </field>
        </field>
    </record>
    <record id="project_task_kanban_github_reference" model="ir.ui.view">
        <field name="name">project.task.kanban.github.reference</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//t[@t-name='card']//field[@name='task_properties']" position="before">
                <field name="github_url" widget="url" t-if="record.github_url.raw_value" class="small text-truncate d-block"/>
            </xpath>
            <xpath expr="//t[@t-name='card']//field[@name='task_properties']" position="attributes">
                <attribute name="widget">usl_task_properties</attribute>
            </xpath>
        </field>
    </record>

    <record id="project_task_form_waiting_reason" model="ir.ui.view">
        <field name="name">project.task.form.waiting.reason</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state'][@widget='project_task_state_selection'][not(ancestor::field)]" position="attributes">
                <attribute name="options">{'usl_offer_waiting': True}</attribute>
            </xpath>
            <xpath expr="//sheet/group[1]" position="before">
                <div class="o_usl_waiting_reason d-flex flex-wrap gap-2 mb-3" invisible="state != '04_waiting_normal'">
                    <i class="fa fa-hourglass-o text-muted align-self-center" title="Waiting reason"/>
                    <label for="usl_waiting_reason" class="o_usl_waiting_label text-muted align-self-center mb-0"/>
                    <field name="usl_waiting_reason" nolabel="1" widget="usl_waiting_reason" class="flex-grow-1"
                           placeholder="What is it waiting for?" required="state == '04_waiting_normal' and not depend_on_ids"/>
                    <field name="usl_waiting_partner_id" nolabel="1" class="o_usl_waiting_partner" placeholder="Waiting on (contact)" options="{'no_create': True}"/>
                </div>
            </xpath>
        </field>
    </record>
    <record id="project_task_kanban_waiting_reason" model="ir.ui.view">
        <field name="name">project.task.kanban.waiting.reason</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//t[@t-name='card']/main/field[@name='name']" position="after">
                <div t-if="record.state.raw_value === '04_waiting_normal' and record.usl_waiting_reason.raw_value"
                     class="o_usl_waiting_line text-muted small text-truncate">
                    <i class="fa fa-hourglass-o me-1" title="Task is waiting"/><field name="usl_waiting_reason"/><t t-if="record.usl_waiting_partner_id.raw_value"> · <field name="usl_waiting_partner_id"/></t>
                </div>
            </xpath>
        </field>
    </record>
    <record id="project_task_list_waiting_reason" model="ir.ui.view">
        <field name="name">project.task.list.waiting.reason</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2"/>
        <field name="arch" type="xml">
            <field name="date_deadline" position="before">
                <field name="usl_waiting_reason" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
