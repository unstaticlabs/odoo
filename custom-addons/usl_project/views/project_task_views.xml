<odoo>
    <record id="project_task_type_form_reactivation_role" model="ir.ui.view">
        <field name="name">project.task.type.form.reactivation.role</field>
        <field name="model">project.task.type</field>
        <field name="inherit_id" ref="project.task_type_edit"/>
        <field name="arch" type="xml">
            <field name="fold" position="after">
                <field name="usl_reactivation_role"
                       invisible="not user_id"
                       placeholder="No automatic reactivation role"/>
            </field>
        </field>
    </record>

    <record id="project_task_form_planning" model="ir.ui.view">
        <field name="name">project.task.form.planning.compatibility</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <label for="date_deadline" position="before">
                <field name="planned_date_begin"/>
            </label>
            <div id="date_deadline_and_recurring_task" position="after">
                <field name="usl_dependency_date_warning"
                       class="text-warning"
                       readonly="1"
                       nolabel="1"
                       colspan="2"
                       invisible="not usl_dependency_date_warning"/>
            </div>
        </field>
    </record>

    <record id="project_task_list_planning" model="ir.ui.view">
        <field name="name">project.task.list.planning.compatibility</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2"/>
        <field name="arch" type="xml">
            <field name="date_deadline" position="before">
                <field name="planned_date_begin" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
