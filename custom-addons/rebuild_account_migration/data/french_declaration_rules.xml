    <record id="declaration_rule_2572_2025" model="rebuild.account.declaration.rule">
        <field name="name">2572 - IS balance (2025)</field>
        <field name="code">FR_2572</field>
        <field name="sequence">20</field>
        <field name="category">corporate_tax</field>
        <field name="cadence">annual</field>
        <field name="deadline_rule">is_balance</field>
        <field name="form_code">2572-SD</field>
        <field name="version">2025</field>
        <field name="effective_from">2025-01-01</field>
        <field name="effective_to">2025-12-31</field>
        <field name="corporate_tax_required" eval="True"/>
        <field name="official_source_label">DGFiP form 2572-SD, 2025</field>
        <field name="official_url">https://www.impots.gouv.fr/formulaire/2572-sd/releve-de-solde</field>
        <field name="official_updated_on">2025-01-01</field>
        <field name="applicability_guidance">A company subject to IS records the balance payable or an excess refundable for each fiscal year.</field>
        <field name="filing_guidance">Reconcile the final taxable result, gross IS, credits and paid instalments before entering the 2572 balance in the professional portal.</field>
        <field name="deadline_guidance">The IS balance is normally due on the 15th day of the fourth month following a non-calendar fiscal close.</field>
    </record>
