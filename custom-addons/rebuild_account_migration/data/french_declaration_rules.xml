    <record id="declaration_rule_2571_2025" model="rebuild.account.declaration.rule">
        <field name="name">2571 - IS instalments (2025)</field>
        <field name="code">FR_2571</field>
        <field name="sequence">10</field>
        <field name="category">corporate_tax</field>
        <field name="cadence">is_instalments</field>
        <field name="trigger_kind">not_first_fiscal_year</field>
        <field name="deadline_rule">is_instalments</field>
        <field name="form_code">2571-SD</field>
        <field name="version">2025</field>
        <field name="effective_from">2025-01-01</field>
        <field name="effective_to">2025-12-31</field>
        <field name="corporate_tax_required" eval="True"/>
        <field name="conditional" eval="True"/>
        <field name="payment_required">conditional</field>
        <field name="official_source_label">DGFiP form 2571-SD and notice, 2025</field>
        <field name="official_url">https://www.impots.gouv.fr/formulaire/2571-sd/releve-dacompte</field>
        <field name="official_updated_on">2025-01-01</field>
        <field name="applicability_guidance">Companies liable to French corporate income tax normally pay four instalments; no instalment is due when the prior corporate-income-tax liability is below the official threshold or another statutory exemption applies.</field>
        <field name="filing_guidance">Open the professional tax portal, compare the portal instalment with the Odoo review anchor, validate any modulation, retain payment evidence and record the external result.</field>
        <field name="deadline_guidance">The four due dates depend on the fiscal-year closing-date band in the official 2571 notice.</field>
    </record>
