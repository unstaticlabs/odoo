<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        This production-oriented Accounting database is reconstructed rather
        than newly configured through Odoo's first-invoice walkthrough.
        Consume only that standard tour for the administrator; other Odoo
        tours remain available and the relation is idempotent across updates.
    -->
    <record id="account.account_tour" model="web_tour.tour">
        <field name="user_consumed_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
