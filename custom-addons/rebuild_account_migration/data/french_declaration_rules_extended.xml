<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 2027 fiscal-year rules preserve non-calendar-year grandfathering and long first years. -->
    <record id="declaration_rule_2571_2027" model="rebuild.account.declaration.rule">
        <field name="name">2571 - IS instalments (2027)</field><field name="code">FR_2571</field><field name="sequence">10</field>
        <field name="category">corporate_tax</field><field name="cadence">is_instalments</field><field name="trigger_kind">not_first_fiscal_year</field><field name="deadline_rule">is_instalments</field>
        <field name="form_code">2571-SD</field><field name="version">2027</field><field name="effective_from">2027-01-01</field><field name="effective_to">2027-12-31</field><field name="corporate_tax_required" eval="True"/><field name="conditional" eval="True"/><field name="payment_required">conditional</field>
        <field name="official_source_label">CGI article 1668 and DGFiP 2571 guidance</field><field name="official_url">https://www.legifrance.gouv.fr/codes/article_lc/LEGIARTI000033836779</field><field name="official_updated_on">2026-08-29</field>
        <field name="applicability_guidance">Four IS instalments apply only after the first fiscal year and remain subject to statutory exemptions and modulation.</field><field name="filing_guidance">Confirm the reference IS and portal amount before payment.</field><field name="deadline_guidance">The four dates follow the official fiscal-close band.</field>
    </record>
    <record id="declaration_rule_2572_2027" model="rebuild.account.declaration.rule">
        <field name="name">2572 - IS balance (2027)</field><field name="code">FR_2572</field><field name="sequence">20</field><field name="category">corporate_tax</field><field name="cadence">annual</field><field name="deadline_rule">is_balance</field>
        <field name="form_code">2572-SD</field><field name="version">2027</field><field name="effective_from">2027-01-01</field><field name="effective_to">2027-12-31</field><field name="corporate_tax_required" eval="True"/>
        <field name="official_source_label">CGI article 1668</field><field name="official_url">https://www.legifrance.gouv.fr/codes/article_lc/LEGIARTI000033836779</field><field name="official_updated_on">2026-08-29</field>
        <field name="applicability_guidance">The IS balance applies to each completed IS fiscal year, including a company's first long fiscal year.</field><field name="filing_guidance">Reconcile final IS, credits and instalments before filing.</field><field name="deadline_guidance">Normally due on the 15th day of the fourth month after a non-calendar close.</field>
    </record>
    <record id="declaration_rule_2065_2027" model="rebuild.account.declaration.rule">
        <field name="name">IS result dossier - 2065 and 2033 A-G (2027)</field><field name="code">FR_2065</field><field name="sequence">30</field><field name="category">profit_tax_package</field><field name="cadence">annual</field><field name="deadline_rule">result_return</field>
        <field name="form_code">2065-SD result dossier</field><field name="tax_form_codes">2065-SD,2033-A-SD,2033-B-SD,2033-C-SD,2033-D-SD,2033-E-SD,2033-F-SD,2033-G-SD</field><field name="supporting_form_codes">2065-bis-SD, 2033 A-G-SD</field>
        <field name="version">2027</field><field name="effective_from">2027-01-01</field><field name="effective_to">2027-12-31</field><field name="corporate_tax_required" eval="True"/><field name="profit_tax_regime">bic_simplified</field>
        <field name="official_source_label">DGFiP IS result filing guidance</field><field name="official_url">https://www.impots.gouv.fr/professionnel/imposition-des-resultats</field><field name="official_updated_on">2026-08-29</field>
        <field name="applicability_guidance">The 2065 filing and its 2033 A-G simplified-regime annexes form one result dossier.</field><field name="filing_guidance">Review the result, fiscal adjustments and every annex in the same filing dossier.</field><field name="deadline_guidance">Non-calendar result return deadline plus the published teleprocedure extension.</field>
    </record>
    <record id="declaration_rule_3517_2027" model="rebuild.account.declaration.rule">
        <field name="name">3517-S CA12 / CA12-E - final simplified VAT periods (2027)</field><field name="code">FR_3517_S</field><field name="sequence">60</field><field name="category">vat</field><field name="cadence">annual</field><field name="deadline_rule">ca12_fiscal</field>
        <field name="form_code">3517-S-SD / CA12-E</field><field name="tax_form_codes">3517-S-SD</field><field name="version">2027</field><field name="effective_from">2027-01-01</field><field name="effective_to">2027-12-31</field><field name="vat_regime">simplified</field>
        <field name="official_source_label">DGFiP simplified VAT guidance</field><field name="official_url">https://www.impots.gouv.fr/professionnel/les-regimes-dimposition-la-tva</field><field name="official_updated_on">2026-08-29</field>
        <field name="applicability_guidance">CA12 or CA12-E applies through the last grandfathered simplified-VAT fiscal period.</field><field name="filing_guidance">Reconcile VAT accounts and portal facts for each legally distinct regularisation period.</field><field name="deadline_guidance">Calendar CA12 follows the May campaign; CA12-E is due within three months after a non-calendar close.</field>
    </record>
    <record id="declaration_rule_3514_2027" model="rebuild.account.declaration.rule">
        <field name="name">3514 - final simplified VAT instalments (2027)</field><field name="code">FR_3514</field><field name="sequence">70</field><field name="category">vat</field><field name="cadence">vat_instalments</field><field name="period_basis">calendar_month</field><field name="deadline_rule">vat_instalment</field>
        <field name="form_code">3514-SD</field><field name="version">2027</field><field name="effective_from">2027-01-01</field><field name="effective_to">2027-12-31</field><field name="vat_regime">simplified</field>
        <field name="official_source_label">DGFiP simplified VAT guidance</field><field name="official_url">https://www.impots.gouv.fr/professionnel/les-regimes-dimposition-la-tva</field><field name="official_updated_on">2026-08-29</field>
        <field name="applicability_guidance">July and December instalments apply only before the company's governed VAT transition date.</field><field name="filing_guidance">Confirm the exact company portal date and amount, including the new-company 80% rule.</field><field name="deadline_guidance">The portal assigns a day in the statutory 15-24 July or December window.</field>
    </record>
    <record id="declaration_rule_rcm_2027" model="rebuild.account.declaration.rule">
        <field name="name">2777 - monthly RCM withholding (2027)</field><field name="code">FR_RCM_2777</field><field name="sequence">80</field><field name="category">dividend</field><field name="cadence">event</field><field name="period_basis">calendar_month</field><field name="trigger_kind">dividend_transactions</field><field name="deadline_rule">next_month_15</field>
        <field name="form_code">2777-SD</field><field name="version">2027</field><field name="effective_from">2027-01-01</field><field name="effective_to">2027-12-31</field><field name="corporate_tax_required" eval="True"/><field name="conditional" eval="True"/>
        <field name="official_source_label">DGFiP 2777-SD</field><field name="official_url">https://www.impots.gouv.fr/formulaire/2777-sd/revenus-de-capitaux-mobiliers-prelevement-et-retenue-la-source</field><field name="official_updated_on">2026-08-29</field>
        <field name="applicability_guidance">A filing month exists only when an RCM transaction is detected.</field><field name="filing_guidance">Confirm the payment month, beneficiaries and withholding basis.</field><field name="deadline_guidance">Due by the 15th following the payment month, subject to the official calendar.</field>
    </record>

    <!-- Transaction, registration, threshold and creation-driven obligations. -->
    <record id="declaration_rule_ca3_transition" model="rebuild.account.declaration.rule">
        <field name="name">CA3 - post-RSI quarterly VAT return</field><field name="code">FR_CA3</field><field name="sequence">75</field><field name="category">vat</field><field name="cadence">event</field><field name="period_basis">calendar_quarter</field><field name="trigger_kind">vat_transition</field><field name="deadline_rule">quarter_next_month_end</field>
        <field name="form_code">3310-CA3-SD</field><field name="version">2027-transition</field><field name="effective_from">2027-01-01</field><field name="effective_to">2028-12-31</field>
        <field name="official_source_label">CGI VAT periodicity rules effective 2027</field><field name="official_url">https://www.legifrance.gouv.fr/codes/section_lc/LEGITEXT000006069577/LEGISCTA000006133846/2027-01-01/</field><field name="official_updated_on">2026-08-29</field>
        <field name="applicability_guidance">Quarterly CA3 starts only on or after the company's governed RSI transition date.</field><field name="filing_guidance">Confirm the portal-specific filing day and the quarterly turnover thresholds.</field><field name="deadline_guidance">The cockpit uses the conservative end of the following month until the portal day is reconciled.</field>
    </record>
    <record id="declaration_rule_ifu" model="rebuild.account.declaration.rule">
        <field name="name">2561 - annual IFU after RCM payments</field><field name="code">FR_IFU_2561</field><field name="sequence">85</field><field name="category">dividend</field><field name="cadence">event</field><field name="period_basis">calendar_year</field><field name="trigger_kind">dividend_transactions</field><field name="deadline_rule">next_year_feb_15</field><field name="payment_required">no</field>
        <field name="form_code">2561-SD / IFU</field><field name="version">2025-2027</field><field name="effective_from">2025-01-01</field><field name="effective_to">2027-12-31</field><field name="corporate_tax_required" eval="True"/><field name="conditional" eval="True"/>
        <field name="official_source_label">BOFiP IFU guidance</field><field name="official_url">https://bofip.impots.gouv.fr/export/pdf/6445</field><field name="official_updated_on">2026-08-29</field>
        <field name="applicability_guidance">Annual IFU applies only for a calendar year containing relevant RCM payments.</field><field name="filing_guidance">Reconcile beneficiaries and annual RCM amounts.</field><field name="deadline_guidance">Filed by 15 February following the calendar year.</field>
    </record>
    <record id="declaration_rule_des" model="rebuild.account.declaration.rule">
        <field name="name">DES - monthly EU B2B services</field><field name="code">FR_DES</field><field name="sequence">90</field><field name="category">eu_services</field><field name="cadence">event</field><field name="period_basis">calendar_month</field><field name="trigger_kind">eu_b2b_services</field><field name="deadline_rule">des_tenth_workday</field><field name="filing_channel">customs</field><field name="payment_required">no</field>
        <field name="form_code">DES</field><field name="version">2025-2027</field><field name="effective_from">2025-01-01</field><field name="effective_to">2027-12-31</field><field name="conditional" eval="True"/>
        <field name="official_source_label">French Customs DES guidance</field><field name="official_url">https://www.douane.gouv.fr/fiche/la-declaration-europeenne-de-services-des</field><field name="official_updated_on">2026-08-29</field>
        <field name="applicability_guidance">Created only for a month containing a qualifying reverse-charge EU B2B service invoice; UK transactions are excluded.</field><field name="filing_guidance">Review VAT identity, territoriality and invoice tax treatment before filing through Customs.</field><field name="deadline_guidance">Due by the tenth working day following the reference month.</field>
    </record>
    <record id="declaration_rule_oss" model="rebuild.account.declaration.rule">
        <field name="name">OSS - registered quarterly EU B2C return</field><field name="code">FR_OSS</field><field name="sequence">95</field><field name="category">vat</field><field name="cadence">event</field><field name="period_basis">calendar_quarter</field><field name="trigger_kind">oss_registration</field><field name="deadline_rule">quarter_next_month_end</field><field name="filing_channel">portal</field>
        <field name="form_code">OSS</field><field name="version">2025-2027</field><field name="effective_from">2025-01-01</field><field name="effective_to">2027-12-31</field><field name="conditional" eval="True"/>
        <field name="official_source_label">DGFiP OSS filing guidance</field><field name="official_url">https://www.impots.gouv.fr/professionnel/je-declare-et-je-paie-0</field><field name="official_updated_on">2026-08-29</field>
        <field name="applicability_guidance">OSS periods exist only after explicit scheme registration; foreign platform revenue does not enable OSS.</field><field name="filing_guidance">Reconcile qualifying B2C flows and file even a nil return while registration remains active.</field><field name="deadline_guidance">Due by the end of the month following the quarter.</field>
    </record>
    <record id="declaration_rule_das2" model="rebuild.account.declaration.rule">
        <field name="name">DAS2 - annual third-party payment review</field><field name="code">FR_DAS2</field><field name="sequence">100</field><field name="category">third_party_reporting</field><field name="cadence">event</field><field name="period_basis">calendar_year</field><field name="trigger_kind">das2_threshold</field><field name="deadline_rule">das2_campaign</field><field name="payment_required">no</field>
        <field name="form_code">DAS2</field><field name="version">2025-2027</field><field name="effective_from">2025-01-01</field><field name="effective_to">2027-12-31</field><field name="conditional" eval="True"/><field name="threshold_amount">2400</field>
        <field name="official_source_label">DGFiP third-party declaration guidance</field><field name="official_url">https://www.impots.gouv.fr/qui-sont-les-tiers-declarants-quels-revenus-et-comment-les-declarer</field><field name="official_updated_on">2026-08-29</field>
        <field name="applicability_guidance">A review instance is created only when payments attributable to eligible account 622 fees exceed EUR 2,400 for a beneficiary during the calendar year.</field><field name="filing_guidance">Confirm amounts actually paid and the beneficiary category before filing.</field><field name="deadline_guidance">Calendar-year companies use the annual campaign; off-calendar IS companies file within three months after the financial-year close that follows the payment year.</field>
    </record>
    <record id="declaration_rule_cvae_1330" model="rebuild.account.declaration.rule">
        <field name="name">1330-CVAE - turnover-triggered reporting</field><field name="code">FR_CVAE_1330</field><field name="sequence">110</field><field name="category">local_tax</field><field name="cadence">annual</field><field name="period_basis">fiscal_year</field><field name="trigger_kind">cvae_turnover_threshold</field><field name="deadline_rule">result_return</field><field name="payment_required">no</field>
        <field name="form_code">1330-CVAE-SD</field><field name="version">2025-2027</field><field name="effective_from">2025-01-01</field><field name="effective_to">2027-12-31</field><field name="conditional" eval="True"/><field name="threshold_amount">152500</field>
        <field name="official_source_label">DGFiP CFE and CVAE guidance</field><field name="official_url">https://www.impots.gouv.fr/professionnel/cet-cfe-et-cvae</field><field name="official_updated_on">2026-08-29</field>
        <field name="applicability_guidance">Reporting review starts above EUR 152,500 fiscal turnover and does not imply CVAE is payable.</field><field name="filing_guidance">Confirm turnover and whether the mono-establishment annex satisfies the filing.</field><field name="deadline_guidance">Aligned conservatively with the result-filing cycle.</field>
    </record>
    <record id="declaration_rule_cvae_1329" model="rebuild.account.declaration.rule">
        <field name="name">1329-AC - CVAE instalments with prior liability</field><field name="code">FR_CVAE_1329_AC</field><field name="sequence">115</field><field name="category">local_tax</field><field name="cadence">event</field><field name="period_basis">calendar_year</field><field name="trigger_kind">cvae_prior_liability</field>
        <field name="form_code">1329-AC-SD</field><field name="version">2025-2027</field><field name="effective_from">2025-01-01</field><field name="effective_to">2027-12-31</field><field name="conditional" eval="True"/><field name="threshold_amount">500000</field><field name="secondary_threshold_amount">1500</field>
        <field name="official_source_label">DGFiP 1329-AC notice</field><field name="official_url">https://www.impots.gouv.fr/sites/default/files/formulaires/1329-ac-sd/2026/1329-ac-sd_5492.pdf</field><field name="official_updated_on">2026-08-29</field>
        <field name="applicability_guidance">No instalment is generated unless the latest closed financial year exceeds EUR 500,000 turnover and reviewed prior CVAE liability exceeds EUR 1,500.</field><field name="filing_guidance">Confirm prior liability and current turnover before payment.</field><field name="deadline_guidance">The official instalments are 15 June and 15 September; portal reconciliation remains required.</field>
    </record>
    <record id="declaration_rule_cfe_initial" model="rebuild.account.declaration.rule">
        <field name="name">1447-C - initial CFE declaration</field><field name="code">FR_CFE_1447_C</field><field name="sequence">120</field><field name="category">local_tax</field><field name="cadence">event</field><field name="period_basis">event</field><field name="trigger_kind">company_creation</field><field name="deadline_rule">cfe_creation</field><field name="payment_required">no</field>
        <field name="form_code">1447-C-SD</field><field name="version">2025-2027</field><field name="effective_from">2025-01-01</field><field name="effective_to">2027-12-31</field>
        <field name="official_source_label">DGFiP CFE guidance</field><field name="official_url">https://www.impots.gouv.fr/professionnel/cet-cfe-et-cvae</field><field name="official_updated_on">2026-08-29</field>
        <field name="applicability_guidance">A newly created company files its initial CFE declaration in its creation year.</field><field name="filing_guidance">Confirm establishment facts and retain filing evidence.</field><field name="deadline_guidance">Due by 31 December of the creation year.</field>
    </record>
    <record id="declaration_rule_cfe_balance" model="rebuild.account.declaration.rule">
        <field name="name">CFE - annual balance notice</field><field name="code">FR_CFE_BALANCE</field><field name="sequence">125</field><field name="category">local_tax</field><field name="cadence">event</field><field name="period_basis">calendar_year</field><field name="trigger_kind">cfe_annual</field><field name="deadline_rule">cfe_balance</field>
        <field name="form_code">CFE balance</field><field name="version">2025-2027</field><field name="effective_from">2025-01-01</field><field name="effective_to">2027-12-31</field><field name="conditional" eval="True"/>
        <field name="official_source_label">DGFiP CFE guidance</field><field name="official_url">https://www.impots.gouv.fr/professionnel/cet-cfe-et-cvae</field><field name="official_updated_on">2026-08-29</field>
        <field name="applicability_guidance">Annual CFE starts in the year after creation; the first taxable year receives the statutory base reduction.</field><field name="filing_guidance">Reconcile the tax notice before payment.</field><field name="deadline_guidance">Annual balance normally due 15 December.</field>
    </record>
    <record id="declaration_rule_cfe_advance" model="rebuild.account.declaration.rule">
        <field name="name">CFE - conditional June advance</field><field name="code">FR_CFE_ACOMPTE</field><field name="sequence">130</field><field name="category">local_tax</field><field name="cadence">event</field><field name="period_basis">calendar_year</field><field name="trigger_kind">cfe_prior_liability</field>
        <field name="form_code">CFE advance</field><field name="version">2025-2027</field><field name="effective_from">2025-01-01</field><field name="effective_to">2027-12-31</field><field name="conditional" eval="True"/><field name="threshold_amount">3000</field>
        <field name="official_source_label">DGFiP CFE guidance</field><field name="official_url">https://www.impots.gouv.fr/professionnel/cet-cfe-et-cvae</field><field name="official_updated_on">2026-08-29</field>
        <field name="applicability_guidance">Generated only from reviewed prior CFE of at least EUR 3,000 and remains inapplicable under monthly payment.</field><field name="filing_guidance">Confirm the prior notice and payment mode.</field><field name="deadline_guidance">Conditional advance normally due 15 June.</field>
    </record>

    <function model="rebuild.account.declaration.rule" name="_ensure_governance_metadata"/>
    <function model="rebuild.account.declaration" name="_sync_all_profiled_companies"/>
</odoo>
