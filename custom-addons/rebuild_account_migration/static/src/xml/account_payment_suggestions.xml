<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="rebuild_account_migration.AccountPaymentSuggestions"
       t-inherit="account.AccountPaymentField"
       t-inherit-mode="extension">
        <xpath expr="//strong[@id='outstanding']" position="attributes">
            <attribute name="class" add="text-nowrap" separator=" "/>
        </xpath>
        <xpath expr="//table" position="attributes">
            <attribute name="class"
                       add="o_rebuild_payment_suggestions"
                       separator=" "/>
        </xpath>
        <xpath expr="//t[@t-foreach='info.lines']/tr" position="attributes">
            <attribute name="t-att-class">
                {'o_rebuild_payment_suggestion': info.outstanding}
            </attribute>
        </xpath>
        <xpath expr="//t[@t-foreach='info.lines']/tr" position="after">
            <tr t-if="info.outstanding and (line.match_reason or line.show_immediate_settlement_reason)"
                class="o_rebuild_payment_suggestion_detail">
                <td/>
                <td colspan="3"
                    class="o_rebuild_payment_suggestion_context text-start text-wrap">
                    <span t-if="line.is_best_match"
                          class="badge rounded-pill o_rebuild_payment_suggestion_best"
                          t-att-title="line.match_reason"
                          data-bs-toggle="tooltip">
                        Best match
                    </span>
                    <span t-if="line.is_bank_statement_candidate"
                          class="badge rounded-pill o_rebuild_payment_suggestion_kind">
                        Bank transaction
                    </span>
                    <span class="o_rebuild_payment_suggestion_evidence"
                          t-if="line.match_reason"
                          t-att-title="line.is_best_match
                                       ? false
                                       : line.match_reason"
                          data-bs-toggle="tooltip"
                          t-out="line.match_summary or line.match_reason"/>
                    <span t-if="line.show_immediate_settlement_reason and !line.can_immediate_settle"
                          class="o_rebuild_payment_suggestion_settlement_blocker"
                          t-att-title="line.immediate_settlement_reason"
                          data-bs-toggle="tooltip">
                        Standard FX only
                    </span>
                </td>
            </tr>
        </xpath>
        <xpath expr="//a[hasclass('outstanding_credit_assign')]" position="replace">
            <div t-if="line.can_assign !== false"
                 class="d-flex flex-wrap justify-content-end gap-1 o_immediate_settlement_actions">
                <button t-if="line.can_immediate_settle"
                        type="button"
                        t-att-class="{
                            'oe_form_field btn immediate_settlement_assign d-print-none': true,
                            'btn-primary': ['high', 'trusted'].includes(line.immediate_settlement_confidence),
                            'btn-outline-primary': !['high', 'trusted'].includes(line.immediate_settlement_confidence),
                        }"
                        t-att-disabled="this.isImmediateSettlementPending(line.id)"
                        t-att-aria-busy="this.isImmediateSettlementPending(line.id) ? 'true' : 'false'"
                        t-att-title="line.immediate_settlement_reason"
                        data-bs-toggle="tooltip"
                        t-on-click.stop.prevent="() => this.settleOutstandingCredit(info.moveId, line.id)">
                    <span t-if="this.isImmediateSettlementPending(line.id)"
                          class="spinner-border spinner-border-sm me-1"
                          aria-hidden="true"/>
                    Settle
                </button>
                <a role="button"
                   class="oe_form_field btn btn-secondary outstanding_credit_assign d-print-none"
                   t-att-data-id="line.id"
                   t-att-title="line.partner_reassignment_required
                                ? 'Add this bank transaction to the document. Odoo will use the document partner, move the outstanding amount to its receivable or payable account, and reconcile it using standard Odoo FX accounting.'
                                : (line.account_reassignment_required
                                   ? 'Add this bank transaction to the document. Odoo will move the outstanding amount to its receivable or payable account and reconcile it using standard Odoo FX accounting.'
                                   : 'Add this existing payment using standard Odoo FX accounting. An exchange gain or loss may be created.')"
                   href="#"
                   data-bs-toggle="tooltip"
                   t-on-click.prevent="() => this.assignOutstandingCredit(info.moveId, line.id)">
                    Add
                </a>
            </div>
            <span t-else=""
                  class="small text-muted text-nowrap"
                  aria-disabled="true"
                  title="The document must be posted before accounting entries can be reconciled.">
                Available after posting
            </span>
        </xpath>
        <xpath expr="//t[@t-if='!info.outstanding']/td/i" position="replace">
            <i class="o_field_widget text-start o_payment_label">
                <t t-if="line.is_immediate_settlement">Settled at payment rate on </t>
                <t t-elif="line.is_refund">Reversed on </t>
                <t t-else="">Paid on </t>
                <t t-out="line.formattedDate"/>
            </i>
        </xpath>
    </t>

    <t t-name="rebuild_account_migration.AccountPaymentSettlementPopOver"
       t-inherit="account.AccountPaymentPopOver"
       t-inherit-mode="extension">
        <xpath expr="//tr[td[hasclass('fw-bolder')][normalize-space()='Journal:']]" position="after">
            <t t-if="props.is_immediate_settlement">
                <tr>
                    <td class="fw-bolder">Executed pair:</td>
                    <td class="ps-1" t-out="props.executed_pair"/>
                </tr>
                <tr>
                    <td class="fw-bolder">Executed rate:</td>
                    <td class="ps-1" t-out="props.executed_rate"/>
                </tr>
                <tr>
                    <td class="fw-bolder">Reference rate:</td>
                    <td class="ps-1" t-out="props.reference_rate"/>
                </tr>
                <tr>
                    <td class="fw-bolder">Provenance:</td>
                    <td class="ps-1" t-out="props.provenance"/>
                </tr>
            </t>
        </xpath>
    </t>
</templates>
