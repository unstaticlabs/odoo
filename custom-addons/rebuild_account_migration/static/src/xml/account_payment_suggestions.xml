<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="rebuild_account_migration.AccountPaymentSuggestions"
       t-inherit="account.AccountPaymentField"
       t-inherit-mode="extension">
        <xpath expr="//strong[@id='outstanding']" position="attributes">
            <attribute name="class" add="text-nowrap" separator=" "/>
        </xpath>
        <xpath expr="//table" position="attributes">
            <attribute name="class"
                       add="o_rebuild_payment_suggestions"
                       separator=" "/>
        </xpath>
        <xpath expr="//t[@t-foreach='info.lines']/tr" position="attributes">
            <attribute name="t-att-class">
                {'o_rebuild_payment_suggestion': info.outstanding}
            </attribute>
        </xpath>
        <xpath expr="//t[@t-foreach='info.lines']/tr" position="after">
            <tr t-if="info.outstanding and line.match_reason"
                class="o_rebuild_payment_suggestion_detail">
                <td/>
                <td colspan="3"
                    class="o_rebuild_payment_suggestion_context text-start text-wrap">
                    <span t-if="line.is_best_match"
                          class="badge rounded-pill o_rebuild_payment_suggestion_best"
                          t-att-title="line.match_reason"
                          data-bs-toggle="tooltip">
                        Best match
                    </span>
                    <span t-if="line.is_bank_statement_candidate"
                          class="badge rounded-pill o_rebuild_payment_suggestion_kind">
                        Bank transaction
                    </span>
                    <span class="o_rebuild_payment_suggestion_evidence"
                          t-att-title="line.is_best_match
                                       ? false
                                       : line.match_reason"
                          data-bs-toggle="tooltip"
                          t-out="line.match_summary or line.match_reason"/>
                </td>
            </tr>
        </xpath>
        <xpath expr="//a[hasclass('outstanding_credit_assign')]" position="replace">
            <a t-if="line.can_assign !== false"
               role="button"
               class="oe_form_field btn btn-secondary outstanding_credit_assign d-print-none"
               t-att-data-id="line.id"
               t-att-title="line.partner_reassignment_required
                            ? 'Add this bank transaction to the bill. Odoo will use the bill supplier, move the outstanding amount to the payable account, and reconcile the available amount.'
                            : (line.account_reassignment_required
                               ? 'Add this bank transaction to the bill. Odoo will move the outstanding amount to the payable account and reconcile the available amount.'
                               : 'Add this existing payment to the bill and reconcile the available amount.')"
               href="#"
               data-bs-toggle="tooltip"
               t-on-click.prevent="() => this.assignOutstandingCredit(info.moveId, line.id)">
                Add
            </a>
            <span t-else=""
                  class="small text-muted text-nowrap"
                  aria-disabled="true"
                  title="The bill must be posted before accounting entries can be reconciled.">
                Available after posting
            </span>
        </xpath>
    </t>
</templates>
