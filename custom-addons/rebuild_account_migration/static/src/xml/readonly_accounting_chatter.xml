<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="rebuild_account_migration.ReadonlyAccountingChatter"
       t-inherit="mail.Chatter"
       t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-mail-Chatter-topbar')]/div[hasclass('d-flex')][1]" position="attributes">
            <attribute name="t-if">!isReadonlyAccountingChatter</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o-mail-Followers')]" position="attributes">
            <attribute name="t-if">!isReadonlyAccountingChatter</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o-mail-AttachmentBox')]//FileUploader" position="attributes">
            <attribute name="t-if">!isReadonlyAccountingChatter</attribute>
        </xpath>
    </t>

    <t t-name="rebuild_account_migration.ReadonlyAccountingAttachFiles"
       t-inherit="mail.Chatter.attachFiles"
       t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o-mail-Chatter-attachFiles')]" position="attributes">
            <attribute name="t-if">!isReadonlyAccountingChatter</attribute>
        </xpath>
    </t>
</templates>
