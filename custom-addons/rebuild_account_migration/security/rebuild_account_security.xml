<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Community's account module keeps the accounting-manager privilege in
        invoicing-only mode until a full Accounting application activates the
        account-user group.  This add-on is that application for the rebuild:
        managers must see and operate the complete native/OCA accounting
        surface, while the dedicated reviewer group below remains read-only.
    -->
    <record id="account.group_account_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('account.group_account_user'))]"/>
    </record>

    <!--
        Analytic allocation is part of the Accounting product, not an optional
        technical feature. Native journal-item multi-edit and the analytic
        distribution widget both require this group. Keep it on writable
        Accounting users; the scoped reviewer remains read-only.
    -->
    <record id="account.group_account_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('analytic.group_analytic_accounting'))]"/>
    </record>

    <record id="group_rebuild_accountant_reviewer" model="res.groups">
        <field name="name">USL Accountant Review</field>
        <field name="privilege_id" ref="account.res_groups_privilege_accounting"/>
        <field name="comment">Read-only accounting access plus scoped, audited declaration-review decisions for allowed companies.</field>
        <field name="implied_ids" eval="[(4, ref('account.group_account_readonly'))]"/>
    </record>

    <record id="rule_hr_expense_reviewer_company_read" model="ir.rule">
        <field name="name">Native expenses: reviewer allowed companies</field>
        <field name="model_id" ref="hr_expense.model_hr_expense"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_rebuild_accountant_reviewer'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_rebuild_account_external_report_value_company" model="ir.rule">
        <field name="name">External report values: allowed companies only</field>
        <field name="model_id" ref="model_rebuild_account_external_report_value"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_rebuild_account_overview_company" model="ir.rule">
        <field name="name">Accounting home summaries: allowed companies only</field>
        <field name="model_id" ref="model_rebuild_account_overview"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_rebuild_account_revenue_spending_month_company" model="ir.rule">
        <field name="name">Revenue and spending trend: allowed companies only</field>
        <field name="model_id" ref="model_rebuild_account_revenue_spending_month"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!--
        SQL-backed report models do not inherit the company rules of the
        account.move/account.move.line tables used by their views.  Keep a
        rule on every public report model so UI domains, RPC clients, exports,
        and future MCP callers all enforce the same allowed-company boundary.
    -->
    <record id="rule_rebuild_account_trial_balance_line_company" model="ir.rule">
        <field name="name">Trial balance: allowed companies only</field>
        <field name="model_id" ref="model_rebuild_account_trial_balance_line"/>
