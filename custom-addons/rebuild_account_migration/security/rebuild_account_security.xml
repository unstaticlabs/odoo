<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_rebuild_accountant_reviewer" model="res.groups">
        <field name="name">USL Accountant Review</field>
        <field name="privilege_id" ref="account.res_groups_privilege_accounting"/>
        <field name="comment">Read-only accounting review access for imported USL accounting evidence, reports and traceability records.</field>
        <field name="implied_ids" eval="[(4, ref('account.group_account_readonly'))]"/>
    </record>

    <record id="rule_rebuild_account_external_report_value_company" model="ir.rule">
        <field name="name">External report values: allowed companies only</field>
        <field name="model_id" ref="model_rebuild_account_external_report_value"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('account.group_account_readonly'))]"/>
    </record>

    <record id="rule_rebuild_account_document_regeneration_case_company" model="ir.rule">
        <field name="name">Document regeneration cases: allowed companies only</field>
        <field name="model_id" ref="model_rebuild_account_document_regeneration_case"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('account.group_account_readonly'))]"/>
    </record>
</odoo>
