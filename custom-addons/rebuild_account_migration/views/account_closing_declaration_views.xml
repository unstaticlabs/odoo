<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rebuild_account_declaration_rule_list" model="ir.ui.view">
        <field name="name">rebuild.account.declaration.rule.list</field>
        <field name="model">rebuild.account.declaration.rule</field>
        <field name="arch" type="xml">
            <list create="false" delete="false" default_order="sequence, code, effective_from desc">
                <field name="sequence" column_invisible="True"/>
                <field name="code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="cadence"/>
                <field name="form_code"/>
                <field name="version"/>
                <field name="effective_from"/>
                <field name="effective_to"/>
                <field name="conditional"/>
                <button name="action_open_official_source" type="object" string="Official Source" icon="fa-external-link"/>
            </list>
        </field>
    </record>

    <record id="view_rebuild_account_declaration_rule_form" model="ir.ui.view">
        <field name="name">rebuild.account.declaration.rule.form</field>
        <field name="model">rebuild.account.declaration.rule</field>
        <field name="arch" type="xml">
            <form create="false" delete="false" edit="false">
                <header>
                    <button name="action_open_official_source" type="object" string="Open Official Source" class="oe_highlight" icon="fa-external-link"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="category"/>
                            <field name="cadence"/>
                            <field name="form_code"/>
                            <field name="tax_form_codes"/>
                        </group>
                        <group>
                            <field name="version"/>
                            <field name="effective_from"/>
                            <field name="effective_to"/>
                            <field name="conditional"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Applicability Profile">
                        <field name="corporate_tax_required"/>
                        <field name="profit_tax_regime"/>
                        <field name="vat_regime"/>
                    </group>
                    <group string="Official Authority">
                        <field name="official_source_label"/>
                        <field name="official_updated_on"/>
                        <field name="official_url" widget="url"/>
                        <field name="portal_url" widget="url"/>
                    </group>
                    <notebook>
                        <page string="Applicability"><field name="applicability_guidance" nolabel="1"/></page>
                        <page string="Deadline"><field name="deadline_guidance" nolabel="1"/></page>
                        <page string="Portal Guidance"><field name="filing_guidance" nolabel="1"/></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_rebuild_account_declaration_field_list" model="ir.ui.view">
        <field name="name">rebuild.account.declaration.field.list</field>
        <field name="model">rebuild.account.declaration.field</field>
        <field name="arch" type="xml">
            <list create="false" delete="false" decoration-danger="validation_status == 'mismatch'" decoration-warning="validation_status == 'review'" decoration-success="validation_status == 'matched'">
                <field name="form_code"/>
                <field name="field_code"/>
                <field name="field_label"/>
                <field name="amount" optional="show"/>
                <field name="value_text" optional="show"/>
                <field name="source_kind"/>
                <field name="validation_status" widget="badge"/>
                <field name="is_unresolved" optional="show"/>
                <field name="source_reference" optional="hide"/>
                <button name="action_open_source_items" type="object" string="Source Entries" icon="fa-search"/>
            </list>
        </field>
    </record>

    <record id="view_rebuild_account_declaration_field_form" model="ir.ui.view">
        <field name="name">rebuild.account.declaration.field.form</field>
        <field name="model">rebuild.account.declaration.field</field>
        <field name="arch" type="xml">
            <form create="false" delete="false" edit="false">
                <header>
                    <button name="action_open_source_items" type="object" string="Open Source Entries" class="oe_highlight" icon="fa-search"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="field_label"/></h1></div>
                    <group>
                        <group>
                            <field name="declaration_id"/>
                            <field name="form_code"/>
                            <field name="field_code"/>
                            <field name="amount"/>
                            <field name="value_text"/>
                        </group>
                        <group>
                            <field name="validation_status" widget="badge"/>
                            <field name="is_unresolved"/>
                            <field name="source_kind"/>
                            <field name="account_prefixes"/>
                            <field name="source_reference"/>
                        </group>
                    </group>
                    <group string="Source Formula"><field name="source_formula" nolabel="1"/></group>
                    <group string="Unresolved Information" invisible="not is_unresolved"><field name="unresolved_reason" nolabel="1"/></group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_rebuild_account_declaration_search" model="ir.ui.view">
        <field name="name">rebuild.account.declaration.search</field>
        <field name="model">rebuild.account.declaration</field>
        <field name="arch" type="xml">
            <search string="Declaration Schedule">
                <field name="name"/>
                <field name="company_id"/>
                <field name="form_code"/>
                <field name="deadline_date"/>
                <filter name="open" string="Open" domain="[('status', 'not in', ['filed', 'paid', 'archived', 'not_applicable'])]"/>
                <filter name="overdue" string="Overdue" domain="[('is_overdue', '=', True)]"/>
                <filter name="blocked" string="Blocked" domain="[('validation_status', '=', 'blocked')]"/>
                <filter name="review" string="Accountant Review" domain="[('status', 'in', ['accountant_review', 'accountant_reviewed'])]"/>
                <separator/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                <filter name="group_category" string="Category" context="{'group_by': 'category'}"/>
                <filter name="group_deadline" string="Deadline Month" context="{'group_by': 'deadline_date:month'}"/>
                <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
            </search>
        </field>
    </record>

    <record id="view_rebuild_account_declaration_list" model="ir.ui.view">
        <field name="name">rebuild.account.declaration.list</field>
        <field name="model">rebuild.account.declaration</field>
        <field name="arch" type="xml">
            <list create="false" delete="false" decoration-danger="validation_status == 'blocked' or is_overdue" decoration-warning="validation_status == 'warning' or status == 'accountant_review'" decoration-success="status in ['filed', 'paid', 'archived']">
                <field name="deadline_date"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="category"/>
                <field name="rule_version" string="Version"/>
                <field name="period_start" optional="hide"/>
                <field name="period_end"/>
                <field name="status" widget="badge"/>
                <field name="validation_status" widget="badge"/>
                <field name="review_status" optional="show"/>
                <field name="filing_status" optional="show"/>
                <field name="payment_status" optional="show"/>
                <field name="unresolved_count"/>
                <field name="is_overdue" optional="hide"/>
                <button name="action_open_prefilled_fields" type="object" string="Fields" icon="fa-list"/>
            </list>
        </field>
    </record>

    <record id="view_rebuild_account_declaration_calendar" model="ir.ui.view">
        <field name="name">rebuild.account.declaration.calendar</field>
        <field name="model">rebuild.account.declaration</field>
        <field name="arch" type="xml">
            <calendar string="Declaration Deadlines" date_start="deadline_date" color="category" mode="month" event_open_popup="true">
                <field name="name"/>
                <field name="status"/>
                <field name="validation_status"/>
                <field name="company_id"/>
            </calendar>
        </field>
    </record>

    <record id="view_rebuild_account_declaration_form" model="ir.ui.view">
        <field name="name">rebuild.account.declaration.form</field>
        <field name="model">rebuild.account.declaration</field>
        <field name="arch" type="xml">
            <form create="false" delete="false">
                <header>
                    <button name="action_refresh_preparation" type="object" string="Refresh from Ledger" icon="fa-refresh" groups="account.group_account_manager"/>
                    <button name="action_mark_internal_ready" type="object" string="Internal Review Ready" groups="account.group_account_manager" invisible="status not in ['to_prepare', 'data_missing', 'internal_review', 'blocked']"/>
                    <button name="action_request_accountant_review" type="object" string="Request Accountant Review" class="oe_highlight" groups="account.group_account_manager" invisible="status not in ['internal_review']"/>
                    <button name="action_record_review_decision" type="object" string="Record Review Decision" groups="rebuild_account_migration.group_rebuild_accountant_reviewer,account.group_account_manager" invisible="status not in ['accountant_review', 'accountant_reviewed', 'ready_to_file']"/>
                    <button name="action_mark_filed" type="object" string="Mark Filed Externally" class="oe_highlight" groups="account.group_account_manager" invisible="status not in ['accountant_reviewed', 'ready_to_file']"/>
                    <button name="action_mark_paid_or_refunded" type="object" string="Complete Payment / Refund" groups="account.group_account_manager" invisible="status != 'filed'"/>
                    <field name="status" widget="statusbar" statusbar_visible="to_prepare,data_missing,internal_review,accountant_review,accountant_reviewed,ready_to_file,filed,paid,archived"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_prefilled_fields" type="object" class="oe_stat_button" icon="fa-list">
                            <field name="prefilled_line_count" widget="statinfo" string="Prefilled Fields"/>
                        </button>
                        <button name="action_open_official_source" type="object" class="oe_stat_button" icon="fa-gavel" string="Official Source"/>
                        <button name="action_open_portal" type="object" class="oe_stat_button" icon="fa-external-link" string="Tax Portal"/>
                    </div>
                    <widget name="web_ribbon" title="Overdue" bg_color="text-bg-danger" invisible="not is_overdue"/>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="company_id" options="{'no_create': True}"/>
                            <field name="rule_id" options="{'no_create': True}"/>
                            <field name="form_code"/>
                            <field name="rule_version"/>
                            <field name="applicability"/>
                        </group>
                        <group>
                            <field name="period_start"/>
                            <field name="period_end"/>
                            <field name="deadline_window_start"/>
                            <field name="deadline_date"/>
                            <field name="validation_status" widget="badge"/>
                            <field name="is_overdue"/>
                        </group>
                    </group>
                    <group string="Applicability and Deadline Basis">
                        <field name="applicability_reason" nolabel="1"/>
                        <field name="deadline_basis" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Prefilled Fields">
                            <field name="field_line_ids" nolabel="1" readonly="1">
                                <list create="false" delete="false" decoration-danger="validation_status == 'mismatch'" decoration-warning="validation_status == 'review'" decoration-success="validation_status == 'matched'">
                                    <field name="form_code"/>
                                    <field name="field_code"/>
                                    <field name="field_label"/>
                                    <field name="amount"/>
                                    <field name="value_text" optional="show"/>
                                    <field name="source_kind"/>
                                    <field name="validation_status" widget="badge"/>
                                    <field name="is_unresolved"/>
                                    <button name="action_open_source_items" type="object" string="Source" icon="fa-search"/>
                                </list>
                            </field>
                        </page>
                        <page string="Validation">
                            <group>
                                <field name="unresolved_count"/>
                                <field name="last_refreshed_at"/>
                            </group>
                            <group string="Automated Validation"><field name="validation_summary" nolabel="1"/></group>
                            <group string="Unresolved Information"><field name="unresolved_information" nolabel="1"/></group>
                            <button name="action_classify_confirmed_vat_refund" type="object" string="Post and Reconcile Confirmed €942 VAT Refund" class="oe_highlight" groups="account.group_account_manager" invisible="category != 'vat'"/>
                        </page>
                        <page string="Review and Filing">
                            <group>
                                <group>
                                    <field name="review_status"/>
                                    <field name="filing_status"/>
                                    <field name="acceptance_status"/>
                                    <field name="payment_status"/>
                                </group>
                                <group>
                                    <field name="amount_due"/>
                                    <field name="amount_paid"/>
                                    <field name="credit_amount"/>
                                    <field name="refund_amount"/>
                                </group>
                            </group>
                            <group string="External References">
                                <field name="external_filing_reference"/>
                                <field name="evidence_reference"/>
                                <field name="evidence_attachment_ids" widget="many2many_binary"/>
                            </group>
                            <group string="Portal Entry Guidance"><field name="portal_entry_guidance" nolabel="1"/></group>
                        </page>
                        <page string="Official Authority">
                            <group>
                                <field name="official_source_label"/>
                                <field name="official_url" widget="url"/>
                                <field name="portal_url" widget="url"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rebuild_account_declaration" model="ir.actions.act_window">
        <field name="name">Declaration Schedule</field>
        <field name="res_model">rebuild.account.declaration</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="search_view_id" ref="view_rebuild_account_declaration_search"/>
        <field name="domain">[('applicability', '!=', 'not_applicable')]</field>
        <field name="context">{'search_default_open': 1, 'create': False, 'delete': False}</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Configure the company declaration profile, then synchronize obligations.</p></field>
    </record>

    <record id="action_rebuild_account_declaration_rule" model="ir.actions.act_window">
        <field name="name">Declaration Rules and Official Sources</field>
        <field name="res_model">rebuild.account.declaration.rule</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False, 'delete': False}</field>
    </record>

    <record id="view_rebuild_account_closing_control_list" model="ir.ui.view">
        <field name="name">rebuild.account.closing.control.list</field>
        <field name="model">rebuild.account.closing.control</field>
        <field name="arch" type="xml">
            <list create="false" delete="false" decoration-danger="status == 'block'" decoration-warning="status == 'warning'" decoration-success="status == 'pass'" decoration-muted="status == 'not_applicable'">
                <field name="category"/>
                <field name="name"/>
                <field name="status" widget="badge"/>
                <field name="record_count"/>
                <field name="amount" optional="show"/>
                <field name="owner"/>
                <field name="summary" optional="show"/>
                <field name="next_action" optional="hide"/>
                <button name="action_open_records" type="object" string="Review" icon="fa-search"/>
            </list>
        </field>
    </record>

    <record id="view_rebuild_account_closing_search" model="ir.ui.view">
        <field name="name">rebuild.account.closing.period.search</field>
        <field name="model">rebuild.account.closing.period</field>
        <field name="arch" type="xml">
            <search string="Closing Workspaces">
                <field name="name"/>
                <field name="company_id"/>
                <field name="date_to"/>
                <filter name="open" string="Open" domain="[('state', 'not in', ['closed', 'archived'])]"/>
                <filter name="blocked" string="Blocked" domain="[('readiness_status', '=', 'blocked')]"/>
                <filter name="annual" string="Annual" domain="[('period_type', '=', 'annual')]"/>
                <separator/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                <filter name="group_type" string="Period Type" context="{'group_by': 'period_type'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_year" string="Closing Year" context="{'group_by': 'date_to:year'}"/>
            </search>
        </field>
    </record>

    <record id="view_rebuild_account_closing_list" model="ir.ui.view">
        <field name="name">rebuild.account.closing.period.list</field>
        <field name="model">rebuild.account.closing.period</field>
        <field name="arch" type="xml">
            <list create="false" delete="false" decoration-danger="readiness_status == 'blocked'" decoration-warning="readiness_status == 'warning'" decoration-success="state in ['closed', 'archived']">
                <field name="date_to"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="period_type"/>
                <field name="state" widget="badge"/>
                <field name="readiness_status" widget="badge"/>
                <field name="blocking_count"/>
                <field name="warning_count"/>
                <field name="review_status" optional="show"/>
                <button name="action_refresh_controls" type="object" string="Refresh" icon="fa-refresh" groups="account.group_account_manager"/>
            </list>
        </field>
    </record>

    <record id="view_rebuild_account_closing_form" model="ir.ui.view">
        <field name="name">rebuild.account.closing.period.form</field>
        <field name="model">rebuild.account.closing.period</field>
        <field name="arch" type="xml">
            <form create="false" delete="false">
                <header>
                    <button name="action_refresh_controls" type="object" string="Refresh Controls" icon="fa-refresh" groups="account.group_account_manager"/>
                    <button name="action_prepare" type="object" string="Prepare Close" groups="account.group_account_manager" invisible="state not in ['open', 'preparing', 'blocked', 'internal_review']"/>
                    <button name="action_request_accountant_review" type="object" string="Request Accountant Review" class="oe_highlight" groups="account.group_account_manager" invisible="state != 'internal_review'"/>
                    <button name="action_record_review_decision" type="object" string="Record Review Decision" groups="rebuild_account_migration.group_rebuild_accountant_reviewer,account.group_account_manager" invisible="state not in ['accountant_review', 'ready']"/>
                    <button name="action_close_and_apply_lock_dates" type="object" string="Close and Apply Standard Lock Dates" class="oe_highlight" groups="account.group_account_manager" invisible="state != 'ready'" confirm="This applies Odoo's fiscal, tax, sales and purchase lock dates through the period end. Continue?"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,preparing,blocked,internal_review,accountant_review,ready,closed,archived"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_declarations" type="object" class="oe_stat_button" icon="fa-calendar-check-o" string="Declarations"/>
                        <button name="action_open_closing_package" type="object" class="oe_stat_button" icon="fa-file-archive-o" string="Closing Package"/>
                    </div>
                    <widget name="web_ribbon" title="Blocked" bg_color="text-bg-danger" invisible="readiness_status != 'blocked'"/>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="company_id" options="{'no_create': True}"/>
                            <field name="period_type"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="fiscalyear_start"/>
                            <field name="fiscalyear_end"/>
                            <field name="readiness_status" widget="badge"/>
                            <field name="review_status" widget="badge"/>
                            <field name="last_refreshed_at"/>
                        </group>
                    </group>
                    <group string="Readiness">
                        <field name="readiness_summary" nolabel="1"/>
                        <group>
                            <field name="blocking_count"/>
                            <field name="warning_count"/>
                            <field name="passed_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Closing Controls">
                            <field name="control_line_ids" nolabel="1" readonly="1">
                                <list create="false" delete="false" decoration-danger="status == 'block'" decoration-warning="status == 'warning'" decoration-success="status == 'pass'" decoration-muted="status == 'not_applicable'">
                                    <field name="category"/>
                                    <field name="name"/>
                                    <field name="status" widget="badge"/>
                                    <field name="record_count"/>
                                    <field name="amount" optional="show"/>
                                    <field name="owner"/>
                                    <field name="summary"/>
                                    <button name="action_open_records" type="object" string="Review" icon="fa-search"/>
                                </list>
                            </field>
                        </page>
                        <page string="Valentin Actions"><field name="actions_awaiting_valentin" nolabel="1"/></page>
                        <page string="Prosper / Accountant"><field name="accountant_information" nolabel="1"/></page>
                        <page string="Closing Package">
                            <group>
                                <field name="package_reference"/>
                                <field name="package_attachment_ids" widget="many2many_binary"/>
                                <field name="closing_notes"/>
                            </group>
                            <button name="action_open_closing_package" type="object" string="Generate PDF/XLSX Review Package" class="oe_highlight"/>
                        </page>
                        <page string="Lock Evidence">
                            <group>
                                <field name="previous_lock_dates"/>
                                <field name="final_lock_dates"/>
                                <field name="closed_at"/>
                                <field name="closed_by_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rebuild_account_closing_period" model="ir.actions.act_window">
        <field name="name">Closing Workspaces</field>
        <field name="res_model">rebuild.account.closing.period</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_rebuild_account_closing_search"/>
        <field name="context">{'search_default_open': 1, 'create': False, 'delete': False}</field>
    </record>

    <record id="view_company_form_rebuild_declaration_profile" model="ir.ui.view">
        <field name="name">res.company.form.rebuild.declaration.profile</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="French Declaration Profile" name="rebuild_declaration_profile">
                    <group>
                        <group>
                            <field name="rebuild_declaration_profile_active"/>
                            <field name="rebuild_legal_form" required="rebuild_declaration_profile_active"/>
                            <field name="rebuild_corporate_tax_regime" required="rebuild_declaration_profile_active"/>
                            <field name="rebuild_profit_tax_regime" required="rebuild_declaration_profile_active"/>
                            <field name="rebuild_vat_regime" required="rebuild_declaration_profile_active"/>
                            <field name="rebuild_first_fiscalyear_start"/>
                        </group>
                        <group>
                            <button name="action_sync_accounting_obligations" type="object" string="Synchronize Declarations and Closing Workspaces" class="oe_highlight" groups="account.group_account_manager"/>
                        </group>
                    </group>
                    <group string="Profile Evidence"><field name="rebuild_declaration_profile_evidence" nolabel="1"/></group>
                </page>
            </xpath>
        </field>
    </record>

    <menuitem id="menu_rebuild_account_closing_root" name="Closing" parent="account.menu_finance" action="action_rebuild_account_closing_period" sequence="5" groups="account.group_account_readonly"/>
    <menuitem id="menu_rebuild_account_declarations_root" name="Declarations" parent="account.menu_finance" action="action_rebuild_account_declaration" sequence="6" groups="account.group_account_readonly"/>
    <menuitem id="menu_rebuild_account_closing_workspace" name="Closing Workspaces" parent="account.account_closing_menu" action="action_rebuild_account_closing_period" sequence="1" groups="account.group_account_readonly"/>
    <menuitem id="menu_rebuild_account_declaration_schedule" name="Declaration Schedule" parent="account.account_reports_taxes_and_fiscal_menu" action="action_rebuild_account_declaration" sequence="0" groups="account.group_account_readonly"/>
    <menuitem id="menu_rebuild_account_declaration_rules" name="Rules and Official Sources" parent="account.account_reports_taxes_and_fiscal_menu" action="action_rebuild_account_declaration_rule" sequence="90" groups="account.group_account_readonly"/>
</odoo>
