<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_rebuild_einvoice_readiness_list" model="ir.ui.view">
        <field name="name">res.company.einvoice.readiness.list</field>
        <field name="model">res.company</field>
        <!-- This is an action-specific view. Keep native company views as the
             default for generic res.company actions such as Settings >
             Users & Companies > Companies. -->
        <field name="priority" eval="90"/>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="name"/>
                <field name="rebuild_einvoice_readiness_status" widget="badge"
                    decoration-success="rebuild_einvoice_readiness_status in ('ready_inactive', 'active')"
                    decoration-info="rebuild_einvoice_readiness_status == 'activation_required'"
                    decoration-warning="rebuild_einvoice_readiness_status == 'not_verified'"
                    decoration-danger="rebuild_einvoice_readiness_status in ('configuration_incomplete', 'needs_attention')"/>
                <field name="rebuild_einvoice_next_action" string="Next step"/>
                <field name="rebuild_einvoice_attention_count" string="Issues"
                    optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_company_rebuild_einvoice_readiness_form" model="ir.ui.view">
        <field name="name">res.company.einvoice.readiness.form</field>
        <field name="model">res.company</field>
        <field name="priority" eval="90"/>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button name="action_rebuild_run_einvoice_acceptance_test"
                        type="object" string="Run self-check"
                        class="oe_highlight"
                        title="Test the complete reception and bill-creation path without contacting a provider or keeping test accounting data."
                        groups="account.group_account_manager"
                        invisible="rebuild_einvoice_readiness_status != 'not_verified'"/>
                    <button name="action_rebuild_begin_einvoice_activation"
                        type="object" string="Activate reception"
                        class="oe_highlight"
                        title="Review and start the native Odoo Approved Platform registration. No e-reporting is enabled."
                        groups="account.group_account_manager"
                        invisible="rebuild_einvoice_readiness_status != 'activation_required' or rebuild_einvoice_connection_status not in ('inactive', 'registration_pending')"/>
                    <button name="action_rebuild_enable_einvoice_exchange"
                        type="object" string="Start receiving invoices"
                        class="oe_highlight"
                        title="Resume automatic incoming-invoice checks for this company."
                        groups="account.group_account_manager"
                        invisible="rebuild_einvoice_connection_status != 'connected_suspended'"/>
                    <button name="action_rebuild_check_einvoice_now"
                        type="object" string="Check now"
                        title="Ask the Approved Platform for new invoices and status updates now."
                        groups="account.group_account_manager"
                        invisible="rebuild_einvoice_readiness_status != 'active'"/>
                    <button name="action_rebuild_review_einvoice_issues"
                        type="object" string="Review issue"
                        class="oe_highlight"
                        title="Open incoming electronic invoices that need an accounting or technical decision."
                        groups="account.group_account_manager"
                        invisible="rebuild_einvoice_readiness_status != 'needs_attention'"/>
                    <button name="action_rebuild_suspend_einvoice_exchange"
                        type="object" string="Pause incoming invoices"
                        title="Stop automatic incoming-invoice checks for this company. Existing bills and documents remain available."
                        groups="account.group_account_manager"
                        invisible="rebuild_einvoice_readiness_status != 'active'"/>
                    <!-- Upgrade anchors for the previously installed guidance view.
                         They are never available to users and can be removed only
                         after every supported database has loaded the new child view. -->
                    <button name="action_rebuild_approve_einvoice_activation"
                        type="object" string="Legacy approval"
                        groups="base.group_no_one" invisible="1"/>
                    <button name="action_rebuild_revoke_einvoice_activation"
                        type="object" string="Legacy revocation"
                        groups="base.group_no_one" invisible="1"/>
                    <field name="rebuild_einvoice_readiness_status" widget="statusbar"
                        statusbar_visible="configuration_incomplete,not_verified,ready_inactive,activation_required,active,needs_attention"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                            name="action_rebuild_open_einvoice_history"
                            icon="fa-file-text-o">
                            <field name="rebuild_einvoice_reception_count"
                                widget="statinfo" string="Incoming"/>
                        </button>
                        <button class="oe_stat_button" type="object"
                            name="action_rebuild_review_einvoice_issues"
                            title="Open incoming electronic invoices that need an accounting or technical decision."
                            icon="fa-exclamation-triangle"
                            invisible="not rebuild_einvoice_attention_count">
                            <field name="rebuild_einvoice_attention_count"
                                widget="statinfo" string="Needs attention"/>
                        </button>
                    </div>

                    <widget name="web_ribbon" title="Ready for production"
                        bg_color="text-bg-success"
                        invisible="rebuild_einvoice_readiness_status != 'ready_inactive'"/>
                    <widget name="web_ribbon" title="Receiving"
                        bg_color="text-bg-success"
                        invisible="rebuild_einvoice_readiness_status != 'active'"/>
                    <widget name="web_ribbon" title="Needs attention"
                        bg_color="text-bg-danger"
                        invisible="rebuild_einvoice_readiness_status != 'needs_attention'"/>

                    <div class="oe_title">
                        <h1>Electronic invoicing</h1>
                        <h2><field name="name" readonly="1"/></h2>
                    </div>
                    <p class="text-muted">
                        Prepare incoming supplier invoices for the French reform.
                        The production connection remains a separate, deliberate step.
                    </p>

                    <div class="alert alert-danger mt-3" role="status"
                        invisible="rebuild_einvoice_readiness_status not in ('configuration_incomplete', 'needs_attention')">
                        <div class="fw-bold">
                            <field name="rebuild_einvoice_next_action"
                                nolabel="1" readonly="1"/>
                        </div>
                        <field name="rebuild_einvoice_next_steps"
                            widget="html" nolabel="1" readonly="1"/>
                    </div>
                    <div class="alert alert-info mt-3" role="status"
                        invisible="rebuild_einvoice_readiness_status in ('configuration_incomplete', 'needs_attention', 'active')">
                        <div class="fw-bold">
                            <field name="rebuild_einvoice_next_action"
                                nolabel="1" readonly="1"/>
                        </div>
                        <field name="rebuild_einvoice_next_steps"
                            widget="html" nolabel="1" readonly="1"/>
                    </div>
                    <div class="alert alert-success mt-3" role="status"
                        invisible="rebuild_einvoice_readiness_status != 'active'">
                        Incoming invoices are active. New documents become draft vendor
                        bills in the selected journal.
                    </div>

                    <separator string="Prepare reception"/>
                    <div class="row g-4">
                        <div class="col-12 col-lg-6">
                            <h4><span class="badge rounded-pill text-bg-light me-2">1</span>Company identity</h4>
                            <p class="text-muted small">
                                Used to identify the company in the French directory.
                            </p>
                            <group>
                                <field name="account_fiscal_country_id"
                                    string="Accounting country"/>
                                <field name="vat" string="French VAT number"/>
                                <field name="company_registry"
                                    string="SIREN or SIRET"/>
                            </group>
                        </div>
                        <div class="col-12 col-lg-6">
                            <h4><span class="badge rounded-pill text-bg-light me-2">2</span>Incoming bills</h4>
                            <p class="text-muted small">
                                Received invoices become draft bills in this journal.
                            </p>
                            <group>
                                <field name="peppol_purchase_journal_id"
                                    string="Incoming purchase journal"/>
                            </group>
                        </div>
                        <div class="col-12 col-lg-6">
                            <h4><span class="badge rounded-pill text-bg-light me-2">3</span>Accounting contact</h4>
                            <p class="text-muted small">
                                Used for platform onboarding and connection notices.
                            </p>
                            <group>
                                <field name="account_peppol_contact_email"
                                    string="Contact email"/>
                                <field name="account_peppol_phone_number"
                                    string="Phone"/>
                            </group>
                        </div>
                        <div class="col-12 col-lg-6">
                            <h4><span class="badge rounded-pill text-bg-light me-2">4</span>Reception self-check</h4>
                            <p class="text-muted small">
                                Validates the real decoder without contacting a provider
                                or retaining a test bill.
                            </p>
                            <group>
                                <field name="rebuild_einvoice_test_status"
                                    widget="badge" readonly="1"/>
                                <field name="rebuild_einvoice_tested_at"
                                    readonly="1"
                                    invisible="not rebuild_einvoice_tested_at"/>
                                <field name="rebuild_einvoice_test_summary"
                                    readonly="1"
                                    invisible="not rebuild_einvoice_test_summary"/>
                            </group>
                            <button name="action_rebuild_run_einvoice_acceptance_test"
                                type="object" string="Run self-check"
                                class="btn btn-secondary"
                                title="Test the complete reception and bill-creation path without contacting a provider or keeping test accounting data."
                                groups="account.group_account_manager"
                                invisible="rebuild_einvoice_readiness_status == 'configuration_incomplete'"/>
                        </div>
                    </div>

                    <div class="alert alert-light border mt-4" role="status">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge rounded-pill text-bg-secondary">Not enabled</span>
                            <strong>E-reporting and outgoing regulatory flows</strong>
                        </div>
                        <p class="text-muted small mb-0 mt-1">
                            This is a separate rollout planned for USL's later obligation.
                            Activating incoming invoices does not enable it.
                        </p>
                    </div>

                    <group string="Advanced" groups="base.group_no_one">
                        <group string="Directory and platform">
                            <field name="peppol_eas" string="Identifier scheme"/>
                            <field name="peppol_endpoint" string="Directory identifier"/>
                            <field name="rebuild_einvoice_provider" readonly="1"/>
                            <field name="rebuild_einvoice_provider_contract_status"
                                readonly="1"/>
                        </group>
                        <group string="Activation and diagnostics">
                            <field name="rebuild_einvoice_environment"/>
                            <field name="rebuild_einvoice_activation_approved"/>
                            <field name="rebuild_einvoice_approved_by_id"/>
                            <field name="rebuild_einvoice_approved_at"/>
                            <field name="rebuild_einvoice_connection_status"/>
                            <field name="rebuild_einvoice_exchange_enabled"/>
                            <field name="rebuild_einvoice_last_poll_status"/>
                            <field name="rebuild_einvoice_last_poll_at"/>
                            <field name="rebuild_einvoice_last_poll_message"/>
                            <field name="rebuild_einvoice_test_fingerprint"/>
                        </group>
                    </group>

                    <field name="rebuild_einvoice_capability_status" invisible="1"/>
                    <field name="rebuild_einvoice_blockers" invisible="1"/>
                    <field name="rebuild_einvoice_test_current" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rebuild_einvoice_readiness" model="ir.actions.act_window">
        <field name="name">Electronic Invoicing</field>
        <field name="res_model">res.company</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('id', 'in', allowed_company_ids)]</field>
        <field name="context">{'create': False, 'delete': False}</field>
    </record>
    <record id="view_company_rebuild_einvoice_readiness_list_action"
        model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_company_rebuild_einvoice_readiness_list"/>
        <field name="act_window_id" ref="action_rebuild_einvoice_readiness"/>
    </record>
    <record id="view_company_rebuild_einvoice_readiness_form_action"
        model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_company_rebuild_einvoice_readiness_form"/>
        <field name="act_window_id" ref="action_rebuild_einvoice_readiness"/>
    </record>

    <record id="view_rebuild_einvoice_reception_search" model="ir.ui.view">
        <field name="name">rebuild.einvoice.reception.search</field>
        <field name="model">rebuild.einvoice.reception</field>
        <field name="arch" type="xml">
            <search string="Incoming E-Invoices">
                <field name="document_reference"/>
                <field name="partner_id"/>
                <field name="move_id"/>
                <field name="company_id"/>
                <filter name="attention" string="Needs Attention"
                    domain="[('status', 'in', ['rejected', 'technical_error'])]"/>
                <filter name="duplicates" string="Duplicates"
                    domain="[('status', '=', 'duplicate')]"/>
                <filter name="received" string="Ready for Review"
                    domain="[('status', '=', 'bill_created')]"/>
                <group>
                    <filter name="group_status" string="Result"
                        context="{'group_by': 'status'}"/>
                    <filter name="group_company" string="Company"
                        context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_rebuild_einvoice_reception_list" model="ir.ui.view">
        <field name="name">rebuild.einvoice.reception.list</field>
        <field name="model">rebuild.einvoice.reception</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0"
                decoration-success="status == 'bill_created'"
                decoration-warning="status == 'duplicate'"
                decoration-danger="status in ('rejected', 'technical_error')">
                <field name="received_at" string="Received"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="partner_id" string="Supplier"/>
                <field name="document_reference" string="Reference"/>
                <field name="invoice_date" optional="hide"/>
                <field name="amount_total" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="status" string="Result" widget="badge"/>
                <field name="move_id" string="Vendor Bill"/>
                <field name="filename" string="Original document"
                    optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_rebuild_einvoice_reception_form" model="ir.ui.view">
        <field name="name">rebuild.einvoice.reception.form</field>
        <field name="model">rebuild.einvoice.reception</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="action_open_bill" type="object"
                        string="Open Vendor Bill"
                        class="oe_highlight"
                        title="Open the native draft vendor bill or credit note created from this document."
                        invisible="not move_id"/>
                    <button name="action_retry_processing" type="object"
                        string="Try Again"
                        title="Process the retained original document again after correcting the issue. This cannot create a duplicate bill."
                        groups="account.group_account_manager"
                        invisible="not can_retry"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="document_reference"
                                placeholder="Incoming electronic invoice"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Invoice">
                            <field name="company_id"/>
                            <field name="received_at"/>
                            <field name="partner_id"/>
                            <field name="invoice_date"/>
                        </group>
                        <group string="Result">
                            <field name="amount_total"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="move_id"/>
                            <field name="duplicate_of_id"
                                invisible="not duplicate_of_id"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="status"
                        invisible="not processing_summary">
                        <strong>What happened</strong>
                        <div><field name="processing_summary" nolabel="1"/></div>
                    </div>
                    <group string="Original document">
                        <field name="attachment_id"/>
                        <field name="filename"/>
                    </group>
                    <group string="Technical details" groups="base.group_no_one">
                        <field name="is_test"/>
                        <field name="document_kind"/>
                        <field name="document_format"/>
                        <field name="failure_code"/>
                        <field name="attempt_count"/>
                        <field name="last_attempt_at"/>
                        <field name="provider_message_uuid"/>
                        <field name="document_hash"/>
                        <field name="provider_state"/>
                        <field name="failure_kind"/>
                        <field name="technical_details"/>
                    </group>
                    <field name="can_retry" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rebuild_einvoice_reception" model="ir.actions.act_window">
        <field name="name">Incoming E-Invoices</field>
        <field name="res_model">rebuild.einvoice.reception</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_rebuild_einvoice_reception_search"/>
        <field name="context">{'search_default_attention': 1, 'create': False, 'delete': False}</field>
    </record>

    <record id="view_move_form_rebuild_einvoice_reception" model="ir.ui.view">
        <field name="name">account.move.form.einvoice.reception</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button"
                    type="object"
                    name="action_open_rebuild_einvoice_reception"
                    icon="fa-file-code-o"
                    invisible="not rebuild_einvoice_reception_ids">
                    <field name="rebuild_einvoice_reception_count"
                        widget="statinfo" string="Electronic invoice"/>
                </button>
            </xpath>
        </field>
    </record>

    <record id="view_move_list_rebuild_einvoice_reception" model="ir.ui.view">
        <field name="name">account.move.list.einvoice.reception</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_bill_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='status_in_payment']" position="before">
                <field name="rebuild_einvoice_reception_status"
                    string="Electronic invoice"
                    widget="badge"
                    optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_search_rebuild_einvoice_reception" model="ir.ui.view">
        <field name="name">account.move.search.einvoice.reception</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_bill_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search/separator[1]" position="before">
                <filter name="received_electronically"
                    string="Received Electronically"
                    domain="[('rebuild_einvoice_reception_ids', '!=', False)]"/>
            </xpath>
        </field>
    </record>

    <record id="view_settings_rebuild_einvoice_activation_gate" model="ir.ui.view">
        <field name="name">res.config.settings.einvoice.activation.gate</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="l10n_fr_pdp.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pdp']/div[@id='l10n_fr_pdp']/div" position="before">
                <div class="alert alert-info" role="alert">
                    <strong><field name="rebuild_einvoice_readiness_status"/></strong>
                    <p class="mb-0">
                        Complete and validate reception under
                        Accounting &gt; Configuration &gt; Invoicing &gt;
                        Electronic Invoicing before production activation.
                    </p>
                </div>
            </xpath>
            <xpath expr="//button[@name='action_open_peppol_form']" position="attributes">
                <attribute name="invisible">not rebuild_einvoice_activation_approved or rebuild_einvoice_environment != 'production'</attribute>
            </xpath>
            <xpath expr="//div[@id='l10n_fr_pdp_']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
            <xpath expr="//block[@id='pdp']" position="inside">
                <field name="rebuild_einvoice_environment" invisible="1"/>
                <field name="rebuild_einvoice_activation_approved" invisible="1"/>
                <field name="rebuild_einvoice_readiness_status" invisible="1"/>
            </xpath>
        </field>
    </record>

    <menuitem id="menu_rebuild_einvoice_readiness"
        name="Electronic Invoicing"
        parent="account.account_invoicing_menu"
        action="action_rebuild_einvoice_readiness"
        sequence="5"
        groups="account.group_account_manager"/>
    <menuitem id="menu_rebuild_einvoice_reception"
        name="Incoming E-Invoices"
        parent="account.menu_finance_payables"
        action="action_rebuild_einvoice_reception"
        sequence="4"
        groups="account.group_account_readonly"/>
</odoo>
