<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_form_entry_direction_guard" model="ir.ui.view">
        <field name="name">account.account.form.entry.direction.guard</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form"/>
        <field name="arch" type="xml">
            <field name="account_type" position="after">
                <field
                    name="rebuild_entry_direction_policy"
                    groups="account.group_account_manager"/>
            </field>
        </field>
    </record>

    <record id="view_account_list_entry_direction_guard" model="ir.ui.view">
        <field name="name">account.account.list.entry.direction.guard</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_list"/>
        <field name="arch" type="xml">
            <field name="account_type" position="after">
                <field
                    name="rebuild_entry_direction_policy"
                    optional="hide"
                    groups="account.group_account_manager"/>
            </field>
        </field>
    </record>

    <record id="view_move_form_entry_direction_guard" model="ir.ui.view">
        <field name="name">account.move.form.entry.direction.guard</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="before">
                <field name="rebuild_direction_exception_required" invisible="1"/>
                <field name="rebuild_direction_exception_confirmed" invisible="1"/>
                <div
                    class="alert alert-warning d-flex flex-wrap align-items-center gap-2"
                    role="alert"
                    invisible="not rebuild_direction_exception_required">
                    <div class="flex-grow-1">
                        <strong>Check exchange gain/loss direction</strong>
                        <div>
                            <field
                                name="rebuild_direction_exception_message"
                                nolabel="1"
                                readonly="1"/>
                        </div>
                    </div>
                    <button
                        name="action_rebuild_confirm_direction_exception"
                        type="object"
                        string="Confirm exceptional direction"
                        class="btn btn-outline-secondary"
                        groups="account.group_account_user"
                        invisible="rebuild_direction_exception_confirmed"
                        title="Acknowledge this unusual direction for the current draft. Changing the affected journal items requires a new confirmation."/>
                    <span
                        class="badge rounded-pill text-bg-success"
                        invisible="not rebuild_direction_exception_confirmed">
                        Confirmed
                    </span>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
