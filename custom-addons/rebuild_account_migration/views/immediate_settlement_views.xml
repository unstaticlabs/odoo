<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_settings_immediate_settlement" model="ir.ui.view">
        <field name="name">res.config.settings.foreign.currency.settlement</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']/block[@name='main_currency_setting_container']" position="after">
                <block title="Foreign-Currency Settlement" name="immediate_settlement_settings">
                    <setting
                        string="Exact amounts and immediate payment rates"
                        company_dependent="1"
                        help="Settle can replace a synthetic foreign estimate with the exact document amount. Use payment rate is additionally limited by the delay and reference-rate policies below.">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="immediate_settlement_max_days" class="col-lg-4 o_light_label"/>
                                <field name="immediate_settlement_max_days"/>
                            </div>
                            <div class="row">
                                <label for="immediate_settlement_max_rate_deviation" class="col-lg-4 o_light_label"/>
                                <field name="immediate_settlement_max_rate_deviation"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

    <record id="view_account_journal_form_immediate_settlement" model="ir.ui.view">
        <field name="name">account.journal.form.foreign.currency.settlement</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='advanced_settings']/group" position="inside">
                <group string="Payment-Rate Policy" groups="account.group_account_manager">
                    <field name="immediate_settlement_policy_override"/>
                    <field
                        name="immediate_settlement_max_days"
                        invisible="not immediate_settlement_policy_override"
                        required="immediate_settlement_policy_override"/>
                    <field
                        name="immediate_settlement_max_rate_deviation"
                        invisible="not immediate_settlement_policy_override"
                        required="immediate_settlement_policy_override"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_account_immediate_settlement_list" model="ir.ui.view">
        <field name="name">account.immediate.settlement.list</field>
        <field name="model">account.immediate.settlement</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="name"/>
                <field name="settlement_date"/>
                <field name="document_id"/>
                <field name="foreign_amount"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="company_amount"/>
                <field name="company_currency_id" column_invisible="True"/>
                <field name="synthetic_foreign_amount"/>
                <field name="preview_settlement_difference" optional="hide"/>
                <field name="settlement_difference"/>
                <field name="settlement_difference_type" widget="badge"/>
                <field name="economic_adjustment_amount"/>
                <field name="provenance"/>
                <field name="mechanism" optional="hide"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_account_immediate_settlement_form" model="ir.ui.view">
        <field name="name">account.immediate.settlement.form</field>
        <field name="model">account.immediate.settlement</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button
                        name="action_reverse"
                        type="object"
                        string="Reverse Settlement"
                        class="btn-primary"
                        groups="account.group_account_user"
                        invisible="state != 'settled'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="document_id"/>
                            <field name="statement_line_id"/>
                            <field name="bank_move_id"/>
                            <field name="mechanism"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="foreign_amount"/>
                            <field name="currency_id"/>
                            <field name="foreign_amount_source"/>
                            <field name="company_amount"/>
                            <field name="company_currency_id"/>
                        </group>
                    </group>
                    <group string="Settlement Result">
                        <group>
                            <field name="synthetic_foreign_amount"/>
                            <field name="reference_company_amount"/>
                            <field name="preview_settlement_difference"/>
                            <field name="settlement_difference"/>
                            <field name="settlement_difference_type"/>
                            <field name="exchange_account_id"/>
                            <field name="economic_adjustment_amount"/>
                        </group>
                        <group>
                            <field name="executed_rate"/>
                            <field name="reference_rate"/>
                            <field name="rate_deviation"/>
                            <field name="benchmark_company_amount"/>
                            <field name="policy_date_distance"/>
                            <field name="policy_warning"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="document_date"/>
                            <field name="payment_date"/>
                            <field name="settlement_date"/>
                        </group>
                        <group>
                            <field name="provenance"/>
                            <field name="trusted_source"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="reversed_user_id" invisible="state != 'reversed'"/>
                            <field name="reversed_at" invisible="state != 'reversed'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Accounting Trace">
                            <group>
                                <field name="document_line_ids" widget="many2many_tags"/>
                                <field name="exchange_move_ids" widget="many2many_tags"/>
                                <field name="exchange_move_names"/>
                                <field name="exchange_line_ids"/>
                                <field name="economic_adjustment_line_ids"/>
                                <field name="generated_line_ids"/>
                                <field name="partial_reconcile_ids"/>
                                <field name="source_line_id_snapshot"/>
                                <field name="provenance_details"/>
                            </group>
                        </page>
                        <page string="Economic Allocations" invisible="mechanism not in ('payment_rate', 'legacy_adjustment')">
                            <group>
                                <field name="payment_line_id"/>
                                <field name="payment_move_id"/>
                                <field name="adjustment_move_id"/>
                                <field name="reversal_move_id"/>
                                <field name="allocation_ids"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_account_immediate_settlement" model="ir.actions.act_window">
        <field name="name">Foreign-Currency Settlements</field>
        <field name="res_model">account.immediate.settlement</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False}</field>
    </record>

    <record id="view_move_form_immediate_settlement" model="ir.ui.view">
        <field name="name">account.move.form.foreign.currency.settlement</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_open_immediate_settlement"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-exchange"
                    invisible="not immediate_settlement_count">
                    <field name="immediate_settlement_count" widget="statinfo" string="Settlement"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
