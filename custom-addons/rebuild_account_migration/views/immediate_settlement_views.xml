<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_settings_immediate_settlement" model="ir.ui.view">
        <field name="name">res.config.settings.immediate.settlement</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']/block[@name='main_currency_setting_container']" position="after">
                <block title="Immediate Settlement" name="immediate_settlement_settings">
                    <setting
                        string="Payment-rate settlement"
                        company_dependent="1"
                        help="Allow eligible foreign-currency invoices and bills to be settled at an immediate payment's executed rate without booking an exchange gain or loss.">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="immediate_settlement_max_days" class="col-lg-4 o_light_label"/>
                                <field name="immediate_settlement_max_days"/>
                            </div>
                            <div class="row">
                                <label for="immediate_settlement_max_rate_deviation" class="col-lg-4 o_light_label"/>
                                <field name="immediate_settlement_max_rate_deviation"/>
                            </div>
                            <div class="row">
                                <label for="immediate_settlement_journal_id" class="col-lg-4 o_light_label"/>
                                <field
                                    name="immediate_settlement_journal_id"
                                    domain="[('type', '=', 'general'), ('company_id', '=', company_id)]"
                                    options="{'no_create': True}"/>
                            </div>
                            <div class="row">
                                <label for="immediate_settlement_fee_account_ids" class="col-lg-4 o_light_label"/>
                                <field
                                    name="immediate_settlement_fee_account_ids"
                                    widget="many2many_tags"
                                    domain="[('company_ids', 'in', company_id)]"
                                    options="{'no_create': True}"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

    <record id="view_account_journal_form_immediate_settlement" model="ir.ui.view">
        <field name="name">account.journal.form.immediate.settlement</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='advanced_settings']/group" position="inside">
                <group string="Immediate Settlement" groups="account.group_account_manager">
                    <field name="immediate_settlement_policy_override"/>
                    <field
                        name="immediate_settlement_max_days"
                        invisible="not immediate_settlement_policy_override"
                        required="immediate_settlement_policy_override"/>
                    <field
                        name="immediate_settlement_max_rate_deviation"
                        invisible="not immediate_settlement_policy_override"
                        required="immediate_settlement_policy_override"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_account_immediate_settlement_list" model="ir.ui.view">
        <field name="name">account.immediate.settlement.list</field>
        <field name="model">account.immediate.settlement</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="name"/>
                <field name="settlement_date"/>
                <field name="document_id"/>
                <field name="foreign_amount"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="company_amount"/>
                <field name="company_currency_id" column_invisible="True"/>
                <field name="executed_rate"/>
                <field name="rate_deviation"/>
                <field name="provenance"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_account_immediate_settlement_form" model="ir.ui.view">
        <field name="name">account.immediate.settlement.form</field>
        <field name="model">account.immediate.settlement</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button
                        name="action_reverse"
                        type="object"
                        string="Reverse Settlement"
                        class="btn-primary"
                        groups="account.group_account_user"
                        invisible="state != 'settled'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="document_id"/>
                            <field name="payment_move_id"/>
                            <field name="statement_line_id"/>
                            <field name="adjustment_move_id"/>
                            <field name="reversal_move_id" invisible="not reversal_move_id"/>
                        </group>
                        <group>
                            <field name="foreign_amount"/>
                            <field name="currency_id"/>
                            <field name="company_amount"/>
                            <field name="company_currency_id"/>
                            <field name="reference_company_amount"/>
                            <field name="executed_rate"/>
                            <field name="reference_rate"/>
                            <field name="rate_deviation"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="document_date"/>
                            <field name="payment_date"/>
                            <field name="settlement_date"/>
                        </group>
                        <group>
                            <field name="provenance"/>
                            <field name="trusted_source"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Economic Allocations">
                            <field name="allocation_ids">
                                <list create="0" edit="0" delete="0">
                                    <field name="original_line_id"/>
                                    <field name="account_id"/>
                                    <field name="company_amount"/>
                                    <field name="proportion"/>
                                    <field name="adjustment_line_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Technical Trace">
                            <group>
                                <field name="document_line_ids" widget="many2many_tags"/>
                                <field name="payment_line_id"/>
                                <field name="partial_reconcile_ids"/>
                                <field name="provenance_details"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_account_immediate_settlement" model="ir.actions.act_window">
        <field name="name">Immediate Settlements</field>
        <field name="res_model">account.immediate.settlement</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False}</field>
    </record>

    <record id="view_move_form_immediate_settlement" model="ir.ui.view">
        <field name="name">account.move.form.immediate.settlement</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_open_immediate_settlement"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-exchange"
                    invisible="not immediate_settlement_adjustment_id">
                    <field name="immediate_settlement_adjustment_id" invisible="1"/>
                    <div class="o_stat_info">
                        <span class="o_stat_text">Payment Rate</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
