<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_b2c_channel_list" model="ir.ui.view">
        <field name="name">b2c.channel.list</field>
        <field name="model">b2c.channel</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="analytic_account_id"/>
                <field name="default_fulfilment_mode"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_b2c_channel_form" model="ir.ui.view">
        <field name="name">b2c.channel.form</field>
        <field name="model">b2c.channel</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="analytic_account_id"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="default_fulfilment_mode"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Commercial-channel operating notes…"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_b2c_channel" model="ir.actions.act_window">
        <field name="name">Commercial Channels</field>
        <field name="res_model">b2c.channel</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Configure a commercial B2C channel</p>
            <p>Each channel links to the Accounting-owned analytic Channel plan.</p>
        </field>
    </record>
</odoo>
