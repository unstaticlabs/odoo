<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_b2c_product_alias_search" model="ir.ui.view">
        <field name="name">b2c.product.alias.search</field>
        <field name="model">b2c.product.alias</field>
        <field name="arch" type="xml">
            <search>
                <field name="original_sku"/>
                <field name="source_sku_is_unique" optional="hide"/>
                <field name="original_name"/>
                <field name="external_listing_id"/>
                <field name="product_id"/>
                <filter name="pending" string="Pending" domain="[('mapping_state', '=', 'pending')]"/>
                <filter name="verified" string="Verified" domain="[('mapping_state', '=', 'verified')]"/>
                <filter name="rejected" string="Rejected" domain="[('mapping_state', '=', 'rejected')]"/>
                <group>
                    <filter name="group_provider" string="Provider" context="{'group_by': 'source_provider'}"/>
                    <filter name="group_channel" string="Channel" context="{'group_by': 'channel_id'}"/>
                    <filter name="group_state" string="Mapping Status" context="{'group_by': 'mapping_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_b2c_product_alias_list" model="ir.ui.view">
        <field name="name">b2c.product.alias.list</field>
        <field name="model">b2c.product.alias</field>
        <field name="arch" type="xml">
            <list decoration-warning="mapping_state == 'pending'" decoration-success="mapping_state == 'verified'" decoration-muted="mapping_state == 'rejected'">
                <field name="source_provider"/>
                <field name="channel_id"/>
                <field name="original_sku"/>
                <field name="external_listing_id" optional="show"/>
                <field name="original_name" optional="show"/>
                <field name="suggested_product_id" optional="show"/>
                <field name="product_id"/>
                <field name="mapping_state" widget="badge"/>
                <field name="reviewed_by_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_b2c_product_alias_form" model="ir.ui.view">
        <field name="name">b2c.product.alias.form</field>
        <field name="model">b2c.product.alias</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_verify" type="object" string="Verify Mapping" title="Verify the selected product mapping while preserving the original provider identifiers and evidence." class="btn-primary" invisible="mapping_state == 'verified'" groups="usl_b2c.group_b2c_operator"/>
                    <button name="action_reject" type="object" string="Reject" title="Reject this SKU mapping while preserving the original provider identifiers and evidence." invisible="mapping_state == 'rejected'" groups="usl_b2c.group_b2c_operator"/>
                    <button name="action_reset_pending" type="object" string="Reset to Pending" title="Return this alias to pending review without verifying a product mapping." invisible="mapping_state == 'pending'" groups="usl_b2c.group_b2c_operator"/>
                    <field name="mapping_state" widget="statusbar" statusbar_visible="pending,verified,rejected"/>
                </header>
                <sheet>
                    <group>
                        <group string="Original Source Fact">
                            <field name="source_provider"/>
                            <field name="channel_id"/>
                            <field name="original_sku"/>
                            <field name="source_sku_is_unique"/>
                            <field name="external_listing_id"/>
                            <field name="original_name"/>
                            <field name="original_variation"/>
                        </group>
                        <group string="Reviewed Mapping">
                            <field name="suggested_product_id"/>
                            <field name="product_id"/>
                            <field name="reviewed_by_id"/>
                            <field name="reviewed_at"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="evidence_note" placeholder="State why this mapping is verified or rejected…"/>
                    <notebook>
                        <page string="Affected Order Lines">
                            <field name="line_ids" readonly="1">
                                <list>
                                    <field name="order_date"/>
                                    <field name="order_id"/>
                                    <field name="original_sku"/>
                                    <field name="original_name"/>
                                    <field name="quantity"/>
                                    <field name="product_id"/>
                                    <field name="mapping_state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_b2c_product_alias" model="ir.actions.act_window">
        <field name="name">Product and SKU Mappings</field>
        <field name="res_model">b2c.product.alias</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_b2c_product_alias_search"/>
        <field name="context">{'search_default_pending': 1}</field>
    </record>
</odoo>
