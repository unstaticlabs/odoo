<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_b2c" model="ir.ui.view">
        <field name="name">product.template.form.b2c</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']" position="after">
                <page name="b2c_operations" string="B2C Operations" groups="usl_b2c.group_b2c_reader">
                    <group>
                        <field name="b2c_catalog_classification"/>
                        <field name="b2c_fulfilment_mode"/>
                        <field name="b2c_opening_stock_state"/>
                    </group>
                    <div class="alert alert-warning" role="alert" invisible="b2c_opening_stock_state != 'not_evidenced'">
                        The source has no stock moves or quants. Physical opening stock remains a blocking, not-evidenced release item until an approved dated count is entered through a native inventory adjustment.
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <record id="product_template_list_b2c" model="ir.ui.view">
        <field name="name">product.template.list.b2c</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field name="b2c_catalog_classification" optional="hide" groups="usl_b2c.group_b2c_reader"/>
                <field name="b2c_fulfilment_mode" optional="hide" groups="usl_b2c.group_b2c_reader"/>
                <field name="b2c_opening_stock_state" optional="hide" groups="usl_b2c.group_b2c_reader"/>
            </field>
        </field>
    </record>
</odoo>
