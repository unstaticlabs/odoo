#. module: usl_documents
#. odoo-python
#: code:addons/usl_documents/models/business_record.py:0
msgid ""
"%(count)s attachment(s) will be checked in the background. Odoo files remain "
"available while Paperless processes them."
msgstr "Le traitement de %(count)s pièce(s) jointe(s) sera vérifié en arrière-plan. Les fichiers Odoo restent disponibles pendant leur traitement par Paperless."

#. module: usl_documents
#. odoo-python
#: code:addons/usl_documents/models/document.py:0
msgid "%(identity)s: %(error)s"
msgstr "%(identity)s : %(error)s"

#. module: usl_documents
#. odoo-python
#: code:addons/usl_documents/models/document.py:0
msgid ""
"%(user)s added %(relationship)s to My library. The archived file and its "
"versions were unchanged."
msgstr "%(user)s a ajouté %(relationship)s à Ma bibliothèque. Le fichier archivé et ses versions sont restés inchangés."

#. module: usl_documents
#. odoo-python
#: code:addons/usl_documents/models/document.py:0
msgid ""
"%(user)s moved this document to Paperless Trash. Its %(count)s active Odoo "
"relationship(s) were preserved."
msgstr ""
"%(user)s a déplacé ce document vers la corbeille Paperless. Ses relations "
"Odoo actives %(count)s ont été conservées."

#. module: usl_documents
#. odoo-python
#: code:addons/usl_documents/models/document.py:0
msgid ""
"%(user)s removed %(relationship)s from My library. The business link, "
"archived file, and versions were kept."
msgstr "%(user)s a retiré %(relationship)s de Ma bibliothèque. Le lien métier, le fichier archivé et ses versions ont été conservés."

#. module: usl_documents
#: model_terms:ir.ui.view,arch_db:usl_documents.view_usl_paperless_tag_form
msgid ""
"<b>Learn automatically</b> uses Paperless’s local classifier.\n"
"                        Correctly tag reviewed documents and remove inbox "
"tags; Paperless\n"
"                        retrains periodically and learns when to apply this "
"tag."
msgstr ""
"<b>Apprentissage automatique</b> utilise le moteur de classement local de "
"Paperless.\n"
"                        Étiquetez correctement les documents vérifiés et "
"retirez-les de la boîte de réception ; Paperless\n"
"                        réentraîne périodiquement son modèle et apprend "
"quand appliquer cette étiquette."

