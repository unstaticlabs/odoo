<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_usl_document_search" model="ir.ui.view">
        <field name="name">usl.document.search</field>
        <field name="model">usl.document</field>
        <field name="arch" type="xml">
            <search string="Archived Documents">
                <field name="name"/>
                <field name="paperless_id"/>
                <field name="correspondent_name"/>
                <field name="document_type_name"/>
                <field name="tag_names"/>
                <filter name="needs_attention" string="Needs attention" domain="[('review_state', '=', 'needs_attention')]"/>
                <filter name="accounting" string="Accounting evidence" domain="[('accounting_evidence', '=', True)]"/>
                <filter name="missing" string="Missing or trashed" domain="[('availability_state', 'in', ('missing', 'trashed'))]"/>
                <separator/>
                <filter name="company" string="Company" context="{'group_by': 'company_id'}"/>
                <filter name="document_type" string="Document type" context="{'group_by': 'document_type_name'}"/>
                <filter name="confidentiality" string="Confidentiality" context="{'group_by': 'confidentiality'}"/>
            </search>
        </field>
    </record>

    <record id="view_usl_document_list" model="ir.ui.view">
        <field name="name">usl.document.list</field>
        <field name="model">usl.document</field>
        <field name="arch" type="xml">
            <list string="Archived Documents"
                  decoration-warning="review_state == 'needs_attention'"
                  decoration-danger="availability_state in ('missing', 'trashed', 'failed', 'permission_error')">
                <field name="name"/>
                <field name="document_date"/>
                <field name="company_id"/>
                <field name="document_type_name"/>
                <field name="correspondent_name"/>
                <field name="confidentiality"/>
                <field name="review_state"/>
                <field name="availability_state"/>
                <field name="link_count"/>
                <field name="paperless_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_usl_document_kanban" model="ir.ui.view">
        <field name="name">usl.document.kanban</field>
        <field name="model">usl.document</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column" sample="1">
                <field name="name"/>
                <field name="document_date"/>
                <field name="company_id"/>
                <field name="document_type_name"/>
                <field name="correspondent_name"/>
                <field name="review_state"/>
                <field name="availability_state"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex gap-3">
                            <img t-att-src="'/usl_documents/' + record.id.raw_value + '/thumbnail'"
                                 class="rounded object-fit-cover"
                                 style="width:72px;height:96px"
                                 alt="Document thumbnail"/>
                            <div class="flex-grow-1 overflow-hidden">
                                <strong class="d-block text-truncate"><field name="name"/></strong>
                                <div class="text-muted"><field name="document_date"/></div>
                                <div class="text-muted text-truncate"><field name="correspondent_name"/></div>
                                <div class="mt-2">
                                    <span t-if="record.review_state.raw_value === 'needs_attention'" class="badge text-bg-warning">Needs attention</span>
                                    <span t-if="record.availability_state.raw_value !== 'available'" class="badge text-bg-danger"><field name="availability_state"/></span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_usl_document_form" model="ir.ui.view">
        <field name="name">usl.document.form</field>
        <field name="model">usl.document</field>
        <field name="arch" type="xml">
            <form string="Archived Document">
                <header>
                    <button name="action_mark_reviewed" type="object" string="Mark reviewed"
                            class="oe_highlight" invisible="review_state == 'reviewed'"/>
                    <button name="action_open_paperless" type="object" string="Open in Paperless"
                            icon="fa-external-link"/>
                    <button name="action_sync_permissions" type="object" string="Synchronize permissions"
                            icon="fa-shield" groups="usl_documents.group_documents_manager"
                            invisible="permission_sync_state == 'synchronized'"/>
                    <field name="review_state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_links" type="object" class="oe_stat_button" icon="fa-link">
                            <field name="link_count" widget="statinfo" string="Odoo records"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Unavailable" bg_color="text-bg-danger"
                            invisible="availability_state == 'available'"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="confidentiality"/>
                            <field name="accounting_evidence"/>
                            <field name="document_date"/>
                            <field name="source"/>
                        </group>
                        <group>
                            <field name="availability_state"/>
                            <field name="permission_sync_state"/>
                            <field name="paperless_id"/>
                            <field name="original_filename"/>
                            <field name="mime_type"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Preview and download" name="preview">
                            <div class="alert alert-warning" role="status" invisible="availability_state == 'available'">
                                The archived evidence is temporarily unavailable. The Odoo record remains usable.
                            </div>
                            <div class="d-flex gap-2" invisible="availability_state != 'available'">
                                <button name="action_preview" type="object" string="Open preview" class="btn-primary" icon="fa-eye"/>
                                <button name="action_download_original" type="object" string="Download received original" icon="fa-download"/>
                                <button name="action_download_archive" type="object" string="Download archival derivative" icon="fa-file-pdf-o"/>
                            </div>
                        </page>
                        <page string="Archive metadata" name="metadata">
                            <group>
                                <field name="correspondent_name"/>
                                <field name="document_type_name"/>
                                <field name="tag_names"/>
                                <field name="checksum"/>
                                <field name="archive_checksum"/>
                                <field name="current_version_label"/>
                                <field name="paperless_created"/>
                                <field name="paperless_modified"/>
                            </group>
                        </page>
                        <page string="Versions" name="versions">
                            <field name="version_ids" nolabel="1" readonly="1">
                                <list create="0" edit="0" delete="0"
                                      decoration-success="is_current">
                                    <field name="label"/>
                                    <field name="is_current"/>
                                    <field name="is_received_original"/>
                                    <field name="created_at"/>
                                    <field name="original_filename"/>
                                    <field name="mime_type"/>
                                    <field name="page_count"/>
                                    <field name="checksum"/>
                                    <button name="action_preview" type="object" icon="fa-eye"
                                            title="Preview this version"/>
                                    <button name="action_download_original" type="object" icon="fa-download"
                                            title="Download received version"/>
                                    <button name="action_download_archive" type="object" icon="fa-file-pdf-o"
                                            title="Download archival derivative"/>
                                </list>
                            </field>
                        </page>
                        <page string="Linked Odoo records" name="links">
                            <field name="link_ids" context="{'default_document_id': id}">
                                <list create="0" edit="0">
                                    <field name="record_name"/>
                                    <field name="res_model"/>
                                    <field name="company_id"/>
                                    <field name="version_id"/>
                                    <field name="linked_by_id"/>
                                    <field name="linked_at"/>
                                </list>
                            </field>
                        </page>
                        <page string="Diagnostics" name="diagnostics" groups="usl_documents.group_documents_manager">
                            <group>
                                <field name="permission_sync_error"/>
                                <field name="last_error"/>
                                <field name="custom_fields_json"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_usl_document_link_list" model="ir.ui.view">
        <field name="name">usl.document.link.list</field>
        <field name="model">usl.document.link</field>
        <field name="arch" type="xml">
            <list string="Document Relationships">
                <field name="document_id"/>
                <field name="record_name"/>
                <field name="res_model"/>
                <field name="company_id"/>
                <field name="version_id"/>
                <field name="linked_by_id"/>
                <field name="linked_at"/>
                <button name="action_open_record" type="object" icon="fa-external-link" title="Open Odoo record"/>
            </list>
        </field>
    </record>

    <record id="view_usl_document_link_form" model="ir.ui.view">
        <field name="name">usl.document.link.form</field>
        <field name="model">usl.document.link</field>
        <field name="arch" type="xml">
            <form string="Document Relationship">
                <header>
                    <button name="action_open_record" type="object" string="Open Odoo record" class="oe_highlight"/>
                </header>
                <sheet>
                    <group>
                        <field name="document_id"/>
                        <field name="record_name"/>
                        <field name="res_model"/>
                        <field name="res_id"/>
                        <field name="company_id"/>
                        <field name="version_id"/>
                        <field name="linked_by_id"/>
                        <field name="linked_at"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_usl_documents" model="ir.actions.act_window">
        <field name="name">Archive</field>
        <field name="res_model">usl.document</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_usl_document_search"/>
    </record>

    <record id="action_documents_workspace" model="ir.actions.client">
        <field name="name">Documents</field>
        <field name="tag">usl_documents.workspace</field>
    </record>

    <record id="action_usl_document_links" model="ir.actions.act_window">
        <field name="name">Relationships</field>
        <field name="res_model">usl.document.link</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_usl_paperless_user_mapping_list" model="ir.ui.view">
        <field name="name">usl.paperless.user.mapping.list</field>
        <field name="model">usl.paperless.user.mapping</field>
        <field name="arch" type="xml">
            <list string="Individual Paperless Identities"
                  decoration-danger="sync_state == 'failed'"
                  decoration-warning="sync_state == 'pending'">
                <field name="user_id"/>
                <field name="paperless_username"/>
                <field name="paperless_user_id"/>
                <field name="sync_state"/>
                <field name="last_verified_at"/>
                <field name="active"/>
                <button name="action_mark_verified" type="object" string="Mark verified"
                        invisible="sync_state == 'synchronized'"/>
            </list>
        </field>
    </record>

    <record id="view_usl_paperless_user_mapping_form" model="ir.ui.view">
        <field name="name">usl.paperless.user.mapping.form</field>
        <field name="model">usl.paperless.user.mapping</field>
        <field name="arch" type="xml">
            <form string="Paperless Identity">
                <header>
                    <button name="action_mark_verified" type="object" string="Mark verified"
                            class="oe_highlight" invisible="sync_state == 'synchronized'"/>
                    <field name="sync_state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="user_id"/>
                        <field name="paperless_username"/>
                        <field name="paperless_user_id"/>
                        <field name="active"/>
                        <field name="last_verified_at"/>
                        <field name="last_error"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_usl_paperless_user_mappings" model="ir.actions.act_window">
        <field name="name">Paperless identities</field>
        <field name="res_model">usl.paperless.user.mapping</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_archive_attachments_in_paperless" model="ir.actions.server">
        <field name="name">Archive in Paperless</field>
        <field name="model_id" ref="base.model_ir_attachment"/>
        <field name="binding_model_id" ref="base.model_ir_attachment"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_archive_in_paperless()</field>
        <field name="group_ids" eval="[Command.link(ref('group_documents_user'))]"/>
    </record>

    <menuitem id="menu_usl_documents_root" name="Documents" sequence="45"
              groups="usl_documents.group_documents_user,usl_documents.group_documents_accountant,usl_documents.group_documents_manager"/>
    <menuitem id="menu_usl_documents_workspace" name="Documents" parent="menu_usl_documents_root"
              action="action_documents_workspace" sequence="10"/>
    <menuitem id="menu_usl_documents_archive" name="Archive records" parent="menu_usl_documents_root"
              action="action_usl_documents" sequence="20"/>
    <menuitem id="menu_usl_documents_links" name="Relationships" parent="menu_usl_documents_root"
              action="action_usl_document_links" sequence="30"
              groups="usl_documents.group_documents_manager"/>
    <menuitem id="menu_usl_documents_identities" name="Paperless identities" parent="menu_usl_documents_root"
              action="action_usl_paperless_user_mappings" sequence="40"
              groups="usl_documents.group_documents_manager"/>
</odoo>
