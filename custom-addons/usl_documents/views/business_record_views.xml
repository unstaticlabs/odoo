<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_documents" model="ir.ui.view">
        <field name="name">account.move.form.archived.documents</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_documents_workspace" type="object" class="oe_stat_button"
                        icon="fa-cloud-upload" string="Upload"
                        invisible="archived_document_count != 0"
                        groups="usl_documents.group_documents_user"/>
                <button name="action_open_documents_workspace" type="object" class="oe_stat_button"
                        icon="fa-folder-open-o" invisible="archived_document_count == 0"
                        groups="usl_documents.group_documents_user,usl_documents.group_documents_accountant">
                    <field name="archived_document_count" widget="statinfo" string="Documents"/>
                </button>
            </xpath>
        </field>
    </record>

