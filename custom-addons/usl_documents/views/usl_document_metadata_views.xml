<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_usl_paperless_tag_list" model="ir.ui.view">
        <field name="name">usl.paperless.tag.list</field>
        <field name="model">usl.paperless.tag</field>
        <field name="arch" type="xml">
            <list string="Tags" decoration-muted="not active">
                <field name="color" widget="color"/>
                <field name="name"/>
                <field name="parent_id"/>
                <field name="matching_algorithm"/>
                <field name="is_inbox_tag" optional="show"/>
                <field name="document_count" optional="hide"
                       groups="usl_documents.group_documents_manager"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_usl_paperless_tag_form" model="ir.ui.view">
        <field name="name">usl.paperless.tag.form</field>
        <field name="model">usl.paperless.tag</field>
        <field name="arch" type="xml">
            <form string="Tag">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="For example: Banking"/></h1>
                    </div>
                    <group>
                        <group string="Appearance">
                            <field name="color" widget="color"/>
                            <field name="parent_id"
                                   domain="[('id', '!=', id), ('active', '=', True)]"/>
                            <field name="is_inbox_tag"/>
                            <field name="active" groups="usl_documents.group_documents_manager"/>
                        </group>
                        <group string="Smart matching">
                            <field name="matching_algorithm"/>
                            <field name="match" placeholder="Words or pattern to recognize"
                                   invisible="matching_algorithm in ('0', '6')"/>
                            <field name="is_insensitive"
                                   invisible="matching_algorithm == '0'"/>
                            <field name="document_count" readonly="1"
                                   groups="usl_documents.group_documents_manager"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="status">
                        Automatic matching learns from documents carrying this tag. Other
                        matching options use the words or pattern above.
                    </div>
                    <group string="Diagnostics" groups="usl_documents.group_documents_manager">
                        <field name="paperless_id"/>
                        <field name="last_synced_at"/>
                        <field name="last_error" invisible="not last_error"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_usl_paperless_correspondent_list" model="ir.ui.view">
        <field name="name">usl.paperless.correspondent.list</field>
        <field name="model">usl.paperless.correspondent</field>
        <field name="arch" type="xml">
            <list string="Correspondents" decoration-muted="not active">
                <field name="name"/>
                <field name="partner_id" optional="show"/>
                <field name="matching_algorithm"/>
                <field name="match" optional="hide"/>
                <field name="document_count" optional="hide"
                       groups="usl_documents.group_documents_manager"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_usl_paperless_correspondent_form" model="ir.ui.view">
        <field name="name">usl.paperless.correspondent.form</field>
        <field name="model">usl.paperless.correspondent</field>
        <field name="arch" type="xml">
            <form string="Correspondent">
                <header>
                    <button name="action_accept_suggested_partner" type="object"
                            string="Use suggested Contact" class="btn-primary"
                            invisible="not suggested_partner_id or partner_id"/>
                    <button name="action_reject_suggested_partner" type="object"
                            string="Not this Contact"
                            invisible="not suggested_partner_id or partner_id"/>
                    <button name="action_open_partner" type="object"
                            string="Open Contact"
                            invisible="not partner_id"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="For example: Acme Supplies"/></h1>
                    </div>
                    <group>
                        <group string="Business identity">
                            <field name="partner_id"
                                   placeholder="Map to an existing Odoo Contact"/>
                            <field name="suggested_partner_id" readonly="1"
                                   invisible="not suggested_partner_id or partner_id"/>
                            <div class="text-muted">
                                Optional. Mapping does not link documents or grant access.
                                Leave archive-only correspondents unmapped.
                            </div>
                        </group>
                        <group string="Smart matching">
                            <field name="matching_algorithm"/>
                            <field name="match" placeholder="Words or pattern to recognize"
                                   invisible="matching_algorithm in ('0', '6')"/>
                            <field name="is_insensitive"
                                   invisible="matching_algorithm == '0'"/>
                        </group>
                        <group>
                            <field name="document_count" readonly="1"
                                   groups="usl_documents.group_documents_manager"/>
                            <field name="active" groups="usl_documents.group_documents_manager"/>
                        </group>
                    </group>
                    <group string="Diagnostics" groups="usl_documents.group_documents_manager">
                        <field name="paperless_id"/>
                        <field name="last_synced_at"/>
                        <field name="last_error" invisible="not last_error"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_usl_paperless_document_type_list" model="ir.ui.view">
        <field name="name">usl.paperless.document.type.list</field>
        <field name="model">usl.paperless.document.type</field>
        <field name="arch" type="xml">
            <list string="Document Types" decoration-muted="not active">
                <field name="name"/>
                <field name="matching_algorithm"/>
                <field name="match" optional="hide"/>
                <field name="document_count" optional="hide"
                       groups="usl_documents.group_documents_manager"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_usl_paperless_document_type_form" model="ir.ui.view">
        <field name="name">usl.paperless.document.type.form</field>
        <field name="model">usl.paperless.document.type</field>
        <field name="arch" type="xml">
            <form string="Document Type">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="For example: Supplier invoice"/></h1>
                    </div>
                    <group>
                        <group string="Smart matching">
                            <field name="matching_algorithm"/>
                            <field name="match" placeholder="Words or pattern to recognize"
                                   invisible="matching_algorithm in ('0', '6')"/>
                            <field name="is_insensitive"
                                   invisible="matching_algorithm == '0'"/>
                        </group>
                        <group>
                            <field name="document_count" readonly="1"
                                   groups="usl_documents.group_documents_manager"/>
                            <field name="active" groups="usl_documents.group_documents_manager"/>
                        </group>
                    </group>
                    <group string="Diagnostics" groups="usl_documents.group_documents_manager">
                        <field name="paperless_id"/>
                        <field name="last_synced_at"/>
                        <field name="last_error" invisible="not last_error"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_usl_document_smart_view_list" model="ir.ui.view">
        <field name="name">usl.document.smart.view.list</field>
        <field name="model">usl.document.smart.view</field>
        <field name="arch" type="xml">
            <list string="Smart Views">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="system_rule"/>
                <field name="tag_ids" widget="many2many_tags" optional="show"/>
                <field name="document_type_ids" widget="many2many_tags" optional="show"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_usl_document_smart_view_form" model="ir.ui.view">
        <field name="name">usl.document.smart.view.form</field>
        <field name="model">usl.document.smart.view</field>
        <field name="arch" type="xml">
            <form string="Smart View">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="scope" readonly="1"/>
                            <field name="system_rule"/>
                            <field name="days" invisible="system_rule != 'recent'"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="icon"/>
                            <field name="sequence"/>
                            <field name="key" readonly="1"/>
                        </group>
                    </group>
                    <group string="Paperless metadata"
                           invisible="system_rule != 'metadata'">
                        <field name="tag_ids" widget="many2many_tags"/>
                        <field name="document_type_ids" widget="many2many_tags"/>
                        <field name="correspondent_ids" widget="many2many_tags"/>
                    </group>
                    <div class="alert alert-info" role="status"
                         invisible="system_rule != 'metadata'">
                        A document appears when it matches the configured Paperless
                        metadata. Archive-native views are available in both applications.
                    </div>
                    <group string="Shared archive view">
                        <field name="archive_native"
                               invisible="system_rule not in ('metadata', 'saved')"/>
                        <field name="paperless_id" readonly="1"
                               invisible="not archive_native"
                               groups="usl_documents.group_documents_manager"/>
                        <field name="paperless_sync_state" readonly="1"
                               invisible="not archive_native or paperless_sync_state == 'synchronized'"
                               groups="usl_documents.group_documents_manager"/>
                        <field name="paperless_sync_error" readonly="1"
                               invisible="not paperless_sync_error"
                               groups="usl_documents.group_documents_manager"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_usl_paperless_tags" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">usl.paperless.tag</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>
    <record id="action_usl_paperless_correspondents" model="ir.actions.act_window">
        <field name="name">Correspondents</field>
        <field name="res_model">usl.paperless.correspondent</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>
    <record id="action_usl_paperless_document_types" model="ir.actions.act_window">
        <field name="name">Document types</field>
        <field name="res_model">usl.paperless.document.type</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>
    <record id="action_usl_document_smart_views" model="ir.actions.act_window">
        <field name="name">Smart views</field>
        <field name="res_model">usl.document.smart.view</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('scope', '=', 'shared')]</field>
        <field name="context">{'default_scope': 'shared'}</field>
    </record>

    <menuitem id="menu_usl_documents_tags" name="Tags"
              parent="menu_usl_documents_root"
              action="action_usl_paperless_tags" sequence="20"
              groups="usl_documents.group_documents_user,usl_documents.group_documents_manager"/>
    <menuitem id="menu_usl_documents_correspondents" name="Correspondents"
              parent="menu_usl_documents_root"
              action="action_usl_paperless_correspondents" sequence="30"
              groups="usl_documents.group_documents_user,usl_documents.group_documents_manager"/>
    <menuitem id="menu_usl_documents_document_types" name="Document types"
              parent="menu_usl_documents_root"
              action="action_usl_paperless_document_types" sequence="40"
              groups="usl_documents.group_documents_user,usl_documents.group_documents_manager"/>
    <menuitem id="menu_usl_documents_smart_views" name="Smart views"
              parent="menu_usl_documents_configuration"
              action="action_usl_document_smart_views" sequence="40"
              groups="usl_documents.group_documents_manager"/>
</odoo>
