<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_usl_documents" model="ir.module.category">
        <field name="name">Documents</field>
        <field name="sequence">35</field>
    </record>

    <record id="res_groups_privilege_documents" model="res.groups.privilege">
        <field name="name">Documents</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_usl_documents"/>
    </record>

    <record id="res_groups_privilege_document_evidence" model="res.groups.privilege">
        <field name="name">Accounting Evidence</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="module_category_usl_documents"/>
    </record>

    <record id="group_documents_user" model="res.groups">
        <field name="name">Document User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_documents"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_documents_accountant" model="res.groups">
        <field name="name">Accounting Evidence Reader</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_document_evidence"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_documents_hr" model="res.groups">
        <field name="name">HR Document Reader</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_documents"/>
        <field name="implied_ids" eval="[Command.link(ref('group_documents_user'))]"/>
    </record>

    <record id="group_documents_manager" model="res.groups">
        <field name="name">Document Administrator</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_documents"/>
        <field name="implied_ids" eval="[
            Command.link(ref('group_documents_user')),
            Command.link(ref('group_documents_hr'))
        ]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    </record>

    <record id="rule_document_company" model="ir.rule">
        <field name="name">Archived documents: selected companies</field>
        <field name="model_id" ref="model_usl_document"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_document_user_policy" model="ir.rule">
        <field name="name">Archived documents: ordinary business access</field>
        <field name="model_id" ref="model_usl_document"/>
        <field name="groups" eval="[Command.link(ref('group_documents_user'))]"/>
        <field name="domain_force">[
            ('company_id', '!=', False),
            '|',
                '&amp;',
                    ('access_scope', '=', 'company'),
                    '|',
                        ('confidentiality', 'in', ('internal', 'accounting')),
                        '&amp;',
                            ('confidentiality', '=', 'private'),
                            ('create_uid', '=', user.id),
                '&amp;',
                    ('access_scope', '=', 'linked_record'),
                    ('permitted_user_ids', 'in', [user.id])
        ]</field>
    </record>

    <record id="rule_document_accountant_policy" model="ir.rule">
        <field name="name">Archived documents: approved accounting evidence only</field>
        <field name="model_id" ref="model_usl_document"/>
        <field name="groups" eval="[Command.link(ref('group_documents_accountant'))]"/>
        <field name="domain_force">[
            ('company_id', '!=', False),
            ('accounting_evidence', '=', True),
            ('confidentiality', '=', 'accounting'),
            '|',
                ('access_scope', '=', 'company'),
                '&amp;',
                    ('access_scope', '=', 'linked_record'),
                    ('permitted_user_ids', 'in', [user.id])
        ]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_document_hr_policy" model="ir.rule">
        <field name="name">Archived documents: HR access</field>
        <field name="model_id" ref="model_usl_document"/>
        <field name="groups" eval="[Command.link(ref('group_documents_hr'))]"/>
        <field name="domain_force">[
            ('company_id', '!=', False),
            ('confidentiality', '=', 'hr'),
            '|',
                ('access_scope', '=', 'company'),
                '&amp;',
                    ('access_scope', '=', 'linked_record'),
                    ('permitted_user_ids', 'in', [user.id])
        ]</field>
    </record>

    <record id="rule_document_manager_policy" model="ir.rule">
        <field name="name">Archived documents: administrator reconciliation access</field>
        <field name="model_id" ref="model_usl_document"/>
        <field name="groups" eval="[Command.link(ref('group_documents_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_document_user_state_owner" model="ir.rule">
        <field name="name">Private Documents state: current user only</field>
        <field name="model_id" ref="model_usl_document_user_state"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_document_link_company" model="ir.rule">
        <field name="name">Document links: selected companies</field>
        <field name="model_id" ref="model_usl_document_link"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_document_link_manager_policy" model="ir.rule">
        <field name="name">Document links: administrator reconciliation access</field>
        <field name="model_id" ref="model_usl_document_link"/>
        <field name="groups" eval="[Command.link(ref('group_documents_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_document_version_company" model="ir.rule">
        <field name="name">Document versions: selected companies</field>
        <field name="model_id" ref="model_usl_document_version"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('document_id.company_id', '=', False), ('document_id.company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_document_version_user_policy" model="ir.rule">
        <field name="name">Document versions: ordinary business access</field>
        <field name="model_id" ref="model_usl_document_version"/>
        <field name="groups" eval="[Command.link(ref('group_documents_user'))]"/>
        <field name="domain_force">[
            ('document_id.company_id', '!=', False),
            '|',
                '&amp;',
                    ('document_id.access_scope', '=', 'company'),
                    '|',
                        ('document_id.confidentiality', 'in', ('internal', 'accounting')),
                        '&amp;',
                            ('document_id.confidentiality', '=', 'private'),
                            ('document_id.create_uid', '=', user.id),
                '&amp;',
                    ('document_id.access_scope', '=', 'linked_record'),
                    ('document_id.permitted_user_ids', 'in', [user.id])
        ]</field>
    </record>

    <record id="rule_document_version_accountant_policy" model="ir.rule">
        <field name="name">Document versions: approved accounting evidence only</field>
        <field name="model_id" ref="model_usl_document_version"/>
        <field name="groups" eval="[Command.link(ref('group_documents_accountant'))]"/>
        <field name="domain_force">[
            ('document_id.accounting_evidence', '=', True),
            ('document_id.confidentiality', '=', 'accounting'),
            '|',
                ('document_id.access_scope', '=', 'company'),
                '&amp;',
                    ('document_id.access_scope', '=', 'linked_record'),
                    ('document_id.permitted_user_ids', 'in', [user.id])
        ]</field>
    </record>

    <record id="rule_document_version_hr_policy" model="ir.rule">
        <field name="name">Document versions: HR access</field>
        <field name="model_id" ref="model_usl_document_version"/>
        <field name="groups" eval="[Command.link(ref('group_documents_hr'))]"/>
        <field name="domain_force">[
            ('document_id.confidentiality', '=', 'hr'),
            '|',
                ('document_id.access_scope', '=', 'company'),
                '&amp;',
                    ('document_id.access_scope', '=', 'linked_record'),
                    ('document_id.permitted_user_ids', 'in', [user.id])
        ]</field>
    </record>

    <record id="rule_document_version_manager_policy" model="ir.rule">
        <field name="name">Document versions: administrator reconciliation access</field>
        <field name="model_id" ref="model_usl_document_version"/>
        <field name="groups" eval="[Command.link(ref('group_documents_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_document_download_grant_company" model="ir.rule">
        <field name="name">Document download grants: selected companies</field>
        <field name="model_id" ref="model_usl_document_download_grant"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_odoo_id', '=', False), ('company_odoo_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_document_download_grant_audit_company" model="ir.rule">
        <field name="name">Document download grant audit: selected companies</field>
        <field name="model_id" ref="model_usl_document_download_grant_audit"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('grant_id.company_odoo_id', '=', False), ('grant_id.company_odoo_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_document_operation_owner" model="ir.rule">
        <field name="name">Document operations: submitting user</field>
        <field name="model_id" ref="model_usl_document_operation"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_documents_user'))]"/>
    </record>

    <record id="rule_document_operation_company" model="ir.rule">
        <field name="name">Document operations: selected companies</field>
        <field name="model_id" ref="model_usl_document_operation"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_document_operation_manager" model="ir.rule">
        <field name="name">Document operations: administrator</field>
        <field name="model_id" ref="model_usl_document_operation"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_documents_manager'))]"/>
    </record>

    <record id="rule_document_context_tag_company" model="ir.rule">
        <field name="name">Document entity tags: selected companies</field>
        <field name="model_id" ref="model_usl_document_context_tag"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_document_smart_view_scope" model="ir.rule">
        <field name="name">Documents smart views: shared or personal</field>
        <field name="model_id" ref="model_usl_document_smart_view"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[
            '&amp;',
                '|', ('scope', '=', 'shared'), ('user_id', '=', user.id),
                '|', ('group_ids', '=', False), ('group_ids', 'in', user.group_ids.ids)
        ]</field>
    </record>
</odoo>
