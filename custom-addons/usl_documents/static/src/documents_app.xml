<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="usl_documents.DocumentsWorkspace">
        <div class="o_usl_documents d-flex h-100 bg-view">
            <aside class="o_usl_documents_sidebar border-end p-3">
                <div class="d-flex align-items-center gap-2 mb-4">
                    <i class="fa fa-folder-open-o fs-3 text-primary"/>
                    <div class="o_usl_sidebar_label">
                        <h4 class="mb-0">Documents</h4>
                        <small class="text-muted">Find what matters</small>
                    </div>
                </div>
                <nav class="nav nav-pills flex-column gap-1">
                    <button t-foreach="sharedViews" t-as="view" t-key="view.id"
                            type="button"
                            t-att-class="'nav-link text-start ' + (state.workspace === view.key ? 'active' : '')"
                            t-att-title="view.name"
                            t-att-aria-label="view.name"
                            t-on-click="() => this.selectWorkspace(view)">
                        <i t-att-class="'fa ' + view.icon + ' me-2'"/>
                        <span class="o_usl_sidebar_label" t-esc="view.name"/>
                    </button>
                </nav>
                <div t-if="personalViews.length" class="mt-4">
                    <small class="o_usl_sidebar_label text-uppercase text-muted fw-semibold px-2">
                        My views
                    </small>
                    <nav class="nav nav-pills flex-column gap-1 mt-1">
                        <button t-foreach="personalViews" t-as="view" t-key="view.id"
                                type="button"
                                t-att-class="'nav-link text-start d-flex align-items-center ' + (state.workspace === view.key ? 'active' : '')"
                                t-att-title="view.name"
                                t-att-aria-label="view.name"
                                t-on-click="() => this.selectWorkspace(view)">
                            <i class="fa fa-bookmark-o me-2"/>
                            <span class="o_usl_sidebar_label text-truncate flex-grow-1"
                                  t-esc="view.name"/>
                            <i class="fa fa-times o_usl_sidebar_remove"
                               title="Remove saved view"
                               t-on-click="(event) => this.removePersonalView(view, event)"/>
                        </button>
                    </nav>
                </div>
                <div class="mt-auto pt-4">
                    <div t-if="state.degraded" class="alert alert-warning small mb-0">
                        <strong>Archive unavailable</strong>
                        <div class="o_usl_sidebar_label">Your Odoo work is still available.</div>
                    </div>
                </div>
            </aside>

            <main class="flex-grow-1 min-w-0 d-flex flex-column">
                <header class="o_usl_documents_toolbar border-bottom bg-white p-3">
                    <div t-if="recordContext" class="alert alert-info py-2 mb-3">
                        Upload a document or choose one from the archive to link it to
                        this record.
                    </div>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <form class="input-group flex-grow-1 o_usl_documents_search"
                              t-on-submit="search">
                            <span class="input-group-text bg-white border-end-0">
                                <i class="fa fa-search"/>
                            </span>
                            <input class="form-control border-start-0"
                                   type="search"
                                   placeholder="Search document text, title, tags…"
                                   t-model="state.query"/>
                            <button t-if="state.query" type="button"
                                    class="btn btn-outline-secondary"
                                    t-on-click="clearSearch">Clear</button>
                            <button type="submit" class="btn btn-primary">Search</button>
                        </form>
                        <div class="btn-group">
                            <button type="button"
                                    t-att-class="'btn btn-outline-secondary ' + (state.view === 'cards' ? 'active' : '')"
                                    t-on-click="() => this.setView('cards')" title="Card view">
                                <i class="fa fa-th-large"/>
                            </button>
                            <button type="button"
                                    t-att-class="'btn btn-outline-secondary ' + (state.view === 'list' ? 'active' : '')"
                                    t-on-click="() => this.setView('list')" title="Compact list">
                                <i class="fa fa-list"/>
                            </button>
                        </div>
                        <label t-att-class="'btn btn-primary mb-0 ' + (state.uploading ? 'disabled' : '')">
                            <i class="fa fa-upload me-1"/>
                            <t t-if="state.uploading">Uploading…</t>
                            <t t-else="">Upload</t>
                            <input type="file" class="d-none" t-on-change="onFileChange"
                                   t-att-disabled="state.uploading"/>
                        </label>
                    </div>

                    <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
                        <select class="form-select form-select-sm o_usl_filter_pill"
                                t-model="state.companyId"
                                t-on-change="(event) => this.updateFilter('companyId', event)">
                            <option value="">All companies</option>
                            <option t-foreach="state.companies" t-as="company"
                                    t-key="company.id" t-att-value="company.id.toString()"
                                    t-esc="company.name"/>
                        </select>
                        <select class="form-select form-select-sm o_usl_filter_pill"
                                t-model="state.documentTypeId"
                                t-on-change="(event) => this.updateFilter('documentTypeId', event)">
                            <option value="">All types</option>
                            <option t-foreach="state.documentTypes" t-as="documentType"
                                    t-key="documentType.id"
                                    t-att-value="documentType.id.toString()"
                                    t-esc="documentType.name"/>
                        </select>
                        <select class="form-select form-select-sm o_usl_filter_pill"
                                t-model="state.correspondentId"
                                t-on-change="(event) => this.updateFilter('correspondentId', event)">
                            <option value="">All correspondents</option>
                            <option t-foreach="state.correspondents" t-as="correspondent"
                                    t-key="correspondent.id"
                                    t-att-value="correspondent.id.toString()"
                                    t-esc="correspondent.name"/>
                        </select>
                        <button type="button"
                                t-att-class="'btn btn-sm rounded-pill ' + (state.linkedState === 'linked' ? 'btn-primary' : 'btn-outline-secondary')"
                                t-on-click="toggleLinkedFilter">
                            <i class="fa fa-link me-1"/>Linked
                        </button>
                        <button type="button"
                                t-att-class="'btn btn-sm rounded-pill ' + (state.moreFilters ? 'btn-primary' : 'btn-outline-secondary')"
                                t-on-click="() => state.moreFilters = !state.moreFilters">
                            <i class="fa fa-sliders me-1"/>More filters
                            <span t-if="activeFilterCount" class="badge rounded-pill text-bg-light ms-1"
                                  t-esc="activeFilterCount"/>
                        </button>
                        <button t-if="activeFilterCount" type="button"
                                class="btn btn-sm btn-link text-decoration-none"
                                t-on-click="clearFilters">Clear filters</button>
                    </div>

                    <div t-if="state.tags.length" class="o_usl_quick_tags d-flex gap-2 mt-3 pb-1">
                        <button t-foreach="state.tags" t-as="tag" t-key="tag.id"
                                type="button"
                                t-att-class="'o_usl_tag_chip btn btn-sm ' + (state.tagIds.includes(tag.id) ? 'is-selected' : '')"
                                t-att-style="'--tag-color:' + tag.color + ';--tag-text:' + tag.text_color"
                                t-on-click="() => this.toggleTagFilter(tag.id)">
                            <span t-esc="tag.name"/>
                        </button>
                    </div>

                    <div t-if="state.moreFilters" class="o_usl_more_filters mt-3 p-3 rounded border">
                        <div class="row g-3">
                            <div class="col-12 col-md-6 col-xl-3">
                                <label class="form-label small fw-semibold">Document date</label>
                                <div class="input-group input-group-sm">
                                    <input type="date" class="form-control"
                                           t-model="state.dateFrom"
                                           t-on-change="(event) => this.updateFilter('dateFrom', event)"/>
                                    <span class="input-group-text">to</span>
                                    <input type="date" class="form-control"
                                           t-model="state.dateTo"
                                           t-on-change="(event) => this.updateFilter('dateTo', event)"/>
                                </div>
                            </div>
                            <div class="col-12 col-md-6 col-xl-3">
                                <label class="form-label small fw-semibold">Added to archive</label>
                                <div class="input-group input-group-sm">
                                    <input type="date" class="form-control"
                                           t-model="state.addedFrom"
                                           t-on-change="(event) => this.updateFilter('addedFrom', event)"/>
                                    <span class="input-group-text">to</span>
                                    <input type="date" class="form-control"
                                           t-model="state.addedTo"
                                           t-on-change="(event) => this.updateFilter('addedTo', event)"/>
                                </div>
                            </div>
                            <div class="col-6 col-md-3 col-xl-2">
                                <label class="form-label small fw-semibold">Source</label>
                                <select class="form-select form-select-sm"
                                        t-model="state.source"
                                        t-on-change="(event) => this.updateFilter('source', event)">
                                    <option value="">Any source</option>
                                    <option value="odoo_upload">Odoo upload</option>
                                    <option value="odoo_attachment">Odoo attachment</option>
                                    <option value="odoo_generated">Odoo-generated</option>
                                    <option value="paperless">Paperless intake</option>
                                </select>
                            </div>
                            <div class="col-6 col-md-3 col-xl-2">
                                <label class="form-label small fw-semibold">Review</label>
                                <select class="form-select form-select-sm"
                                        t-model="state.reviewState"
                                        t-on-change="(event) => this.updateFilter('reviewState', event)">
                                    <option value="">Any status</option>
                                    <option value="needs_attention">Needs review</option>
                                    <option value="classified">Classified</option>
                                    <option value="reviewed">Reviewed</option>
                                </select>
                            </div>
                            <div class="col-6 col-md-3 col-xl-2">
                                <label class="form-label small fw-semibold">Privacy</label>
                                <select class="form-select form-select-sm"
                                        t-model="state.confidentiality"
                                        t-on-change="(event) => this.updateFilter('confidentiality', event)">
                                    <option value="">Any privacy</option>
                                    <option value="internal">Internal</option>
                                    <option value="accounting">Accounting</option>
                                    <option value="hr">HR restricted</option>
                                    <option value="private">Private</option>
                                </select>
                            </div>
                            <div class="col-12 col-md-6 col-xl-4">
                                <label class="form-label small fw-semibold">Linked record</label>
                                <select class="form-select form-select-sm"
                                        t-model="state.linkedRecord"
                                        t-on-change="(event) => this.updateFilter('linkedRecord', event)">
                                    <option value="">Any business record</option>
                                    <option t-foreach="state.linkFacets" t-as="linkFacet"
                                            t-key="linkFacet.key" t-att-value="linkFacet.key"
                                            t-esc="linkFacet.label"/>
                                </select>
                            </div>
                            <div class="col-6 col-md-3 col-xl-2">
                                <label class="form-label small fw-semibold">Links</label>
                                <select class="form-select form-select-sm"
                                        t-model="state.linkedState"
                                        t-on-change="(event) => this.updateFilter('linkedState', event)">
                                    <option value="">Any</option>
                                    <option value="linked">Linked</option>
                                    <option value="unlinked">Not linked</option>
                                </select>
                            </div>
                            <div class="col-6 col-md-3 col-xl-2">
                                <label class="form-label small fw-semibold">Sort by</label>
                                <select class="form-select form-select-sm"
                                        t-model="state.sort"
                                        t-on-change="(event) => this.updateFilter('sort', event)">
                                    <option value="recent">Document date</option>
                                    <option value="ingested">Recently added</option>
                                    <option value="title">Title</option>
                                </select>
                            </div>
                            <div class="col-12 col-xl-4">
                                <label class="form-label small fw-semibold">Save these filters</label>
                                <div class="input-group input-group-sm">
                                    <input class="form-control" type="text"
                                           placeholder="My useful view"
                                           t-model="state.savedViewName"/>
                                    <button class="btn btn-outline-primary" type="button"
                                            t-att-disabled="state.savingView || !state.savedViewName.trim()"
                                            t-on-click="savePersonalView">
                                        <i class="fa fa-bookmark-o me-1"/>Save
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </header>

                <div t-if="state.operation" class="px-3 pt-3">
                    <div t-att-class="'alert mb-0 ' + (state.operation.state === 'failed' ? 'alert-danger' : state.operation.state === 'archived' ? 'alert-success' : 'alert-info')">
                        <div class="d-flex align-items-center gap-2">
                            <i t-att-class="'fa ' + (state.operation.state === 'failed' ? 'fa-times-circle' : state.operation.state === 'archived' ? 'fa-check-circle' : 'fa-circle-o-notch fa-spin')"/>
                            <strong t-esc="state.operation.name"/>
                            <span class="text-capitalize" t-esc="state.operation.state"/>
                            <span t-if="state.operation.error" t-esc="state.operation.error"/>
                        </div>
                    </div>
                </div>
                <div t-if="state.operations.length &amp;&amp; !state.operation" class="px-3 pt-3">
                    <details>
                        <summary class="small text-muted">
                            Recent uploads (<t t-esc="state.operations.length"/>)
                        </summary>
                        <div class="list-group mt-2">
                            <div t-foreach="state.operations" t-as="operation"
                                 t-key="operation.id"
                                 class="list-group-item py-2 d-flex justify-content-between gap-3">
                                <span class="text-truncate" t-esc="operation.name"/>
                                <span t-att-class="'badge text-capitalize ' + (operation.state === 'failed' ? 'text-bg-danger' : operation.state === 'archived' ? 'text-bg-success' : operation.state === 'duplicate' ? 'text-bg-warning' : 'text-bg-info')"
                                      t-esc="operation.state"/>
                                <span t-if="operation.error" class="small text-danger"
                                      t-esc="operation.error"/>
                            </div>
                        </div>
                    </details>
                </div>

                <section class="flex-grow-1 overflow-auto p-3"
                         t-att-class="state.dragged ? 'flex-grow-1 overflow-auto p-3 o_usl_documents_dragged' : 'flex-grow-1 overflow-auto p-3'"
                         t-on-dragover="onDragOver" t-on-dragleave="onDragLeave"
                         t-on-drop="onDrop">
                    <div t-if="state.loading"
                         class="h-100 d-flex flex-column align-items-center justify-content-center text-muted">
                        <i class="fa fa-circle-o-notch fa-spin fs-2 mb-3"/>
                        <span>Finding your documents…</span>
                    </div>
                    <div t-elif="state.error"
                         class="h-100 d-flex align-items-center justify-content-center">
                        <div class="o_usl_documents_empty text-center">
                            <i class="fa fa-plug fs-1 text-warning mb-3"/>
                            <h4>Documents are temporarily unavailable</h4>
                            <p class="text-muted" t-esc="state.error"/>
                            <button class="btn btn-primary" type="button"
                                    t-on-click="load">Try again</button>
                        </div>
                    </div>
                    <div t-elif="!state.documents.length"
                         class="h-100 d-flex align-items-center justify-content-center">
                        <div class="o_usl_documents_empty text-center">
                            <i class="fa fa-inbox fs-1 text-muted mb-3"/>
                            <h4>No documents found</h4>
                            <p class="text-muted" t-if="state.query || activeFilterCount">
                                Try changing the search or filters.
                            </p>
                            <p class="text-muted" t-else="">
                                Drop a file here or upload one. Paperless will classify it.
                            </p>
                            <button t-if="state.query || activeFilterCount"
                                    class="btn btn-outline-primary" type="button"
                                    t-on-click="clearAll">Clear search and filters</button>
                        </div>
                    </div>
                    <t t-else="">
                        <div t-if="state.truncated" class="alert alert-warning">
                            There are more matches than can be shown safely. Add a filter
                            to narrow the result.
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="text-muted">
                                <t t-esc="state.count"/> document<t t-if="state.count !== 1">s</t>
                            </span>
                            <span t-if="state.dragged"
                                  class="badge text-bg-primary fs-6">Drop to upload</span>
                        </div>
                        <div t-if="state.view === 'cards'" class="o_usl_documents_grid">
                            <article t-foreach="state.documents" t-as="document"
                                     t-key="document.id"
                                     class="card o_usl_document_card shadow-sm"
                                     t-on-click="() => this.select(document)">
                                <div class="o_usl_document_thumb">
                                    <img t-att-src="'/usl_documents/' + document.id + '/thumbnail'"
                                         alt="Document thumbnail"/>
                                    <span t-if="document.review_state === 'needs_attention'"
                                          class="badge text-bg-warning">Needs review</span>
                                    <span t-if="document.availability_state !== 'available'"
                                          class="badge text-bg-danger">Unavailable</span>
                                    <span t-if="document.access_error"
                                          class="badge text-bg-danger">Access needs attention</span>
                                </div>
                                <div class="card-body">
                                    <h6 class="card-title text-truncate mb-1"
                                        t-esc="document.name"/>
                                    <div class="small text-muted text-truncate">
                                        <t t-esc="document.correspondent || 'Unknown correspondent'"/>
                                        <t t-if="document.document_type">
                                            · <t t-esc="document.document_type"/>
                                        </t>
                                    </div>
                                    <div t-if="document.tags.length"
                                         class="d-flex flex-wrap gap-1 mt-2">
                                        <button t-foreach="document.tags.slice(0, 3)"
                                                t-as="tag" t-key="tag.id" type="button"
                                                class="o_usl_tag_chip btn btn-sm"
                                                t-att-style="'--tag-color:' + tag.color + ';--tag-text:' + tag.text_color"
                                                t-on-click.stop="() => this.toggleTagFilter(tag.id)"
                                                t-esc="tag.name"/>
                                        <span t-if="document.tags.length &gt; 3"
                                              class="badge rounded-pill text-bg-light">
                                            +<t t-esc="document.tags.length - 3"/>
                                        </span>
                                    </div>
                                    <div class="small text-muted mt-3 d-flex justify-content-between gap-2">
                                        <span t-esc="document.date || 'No date'"/>
                                        <span t-if="document.primary_link"
                                              class="text-truncate" style="max-width:55%">
                                            <i class="fa fa-link me-1"/>
                                            <t t-esc="document.primary_link.name"/>
                                        </span>
                                    </div>
                                </div>
                            </article>
                        </div>
                        <div t-else="" class="list-group shadow-sm">
                            <button t-foreach="state.documents" t-as="document"
                                    t-key="document.id" type="button"
                                    class="list-group-item list-group-item-action d-flex align-items-center gap-3"
                                    t-on-click="() => this.select(document)">
                                <img t-att-src="'/usl_documents/' + document.id + '/thumbnail'"
                                     class="o_usl_document_list_thumb" alt=""/>
                                <div class="flex-grow-1 min-w-0">
                                    <strong class="d-block text-truncate"
                                            t-esc="document.name"/>
                                    <small class="text-muted">
                                        <t t-esc="document.correspondent || 'Unknown correspondent'"/>
                                        <t t-if="document.document_type">
                                            · <t t-esc="document.document_type"/>
                                        </t>
                                    </small>
                                    <div t-if="document.tags.length"
                                         class="d-flex flex-wrap gap-1 mt-1">
                                        <span t-foreach="document.tags.slice(0, 3)"
                                              t-as="tag" t-key="tag.id"
                                              class="o_usl_tag_chip"
                                              t-att-style="'--tag-color:' + tag.color + ';--tag-text:' + tag.text_color"
                                              t-esc="tag.name"/>
                                    </div>
                                </div>
                                <span t-if="document.primary_link"
                                      class="small text-muted text-truncate d-none d-xl-inline"
                                      style="max-width:220px">
                                    <i class="fa fa-link me-1"/>
                                    <t t-esc="document.primary_link.name"/>
                                </span>
                                <span class="text-muted" t-esc="document.date"/>
                                <span t-if="document.review_state === 'needs_attention'"
                                      class="badge text-bg-warning">Needs review</span>
                                <span t-if="document.access_error"
                                      class="badge text-bg-danger">Access error</span>
                            </button>
                        </div>
                        <nav class="d-flex justify-content-center align-items-center gap-3 mt-4">
                            <button class="btn btn-outline-secondary" type="button"
                                    t-on-click="previousPage"
                                    t-att-disabled="state.page === 1">Previous</button>
                            <span>Page <t t-esc="state.page"/></span>
                            <button class="btn btn-outline-secondary" type="button"
                                    t-on-click="nextPage"
                                    t-att-disabled="state.page * state.pageSize >= state.count">
                                Next
                            </button>
                        </nav>
                    </t>
                </section>
            </main>

            <aside t-if="state.selected"
                   class="o_usl_documents_detail border-start bg-white d-flex flex-column">
                <header class="d-flex justify-content-between align-items-start p-3 border-bottom">
                    <div class="min-w-0">
                        <h5 class="text-truncate mb-1" t-esc="state.selected.name"/>
                        <small class="text-muted">
                            <t t-esc="state.selected.document_type || 'Unclassified'"/>
                            <t t-if="state.selected.date">
                                · <t t-esc="state.selected.date"/>
                            </t>
                        </small>
                    </div>
                    <button class="btn-close" type="button" t-on-click="closeDetail"
                            aria-label="Close"/>
                </header>
                <div class="flex-grow-1 overflow-auto">
                    <div t-if="state.selected.access_error"
                         class="alert alert-danger m-3 mb-0">
                        <strong>Document access needs attention.</strong>
                        <div>The file is blocked until an administrator verifies archive access.</div>
                    </div>
                    <iframe t-if="state.selected.availability_state === 'available' &amp;&amp; !state.selected.access_error"
                            t-att-src="state.selected.preview_url"
                            title="Document preview"/>
                    <div t-else="" class="alert alert-warning m-3">
                        Preview is unavailable. Its classification and links remain visible.
                    </div>

                    <section class="p-3">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <h6 class="mb-0">Classification</h6>
                            <button t-if="state.selected.can_edit &amp;&amp; !state.editingMetadata"
                                    class="btn btn-sm btn-link text-decoration-none"
                                    type="button" t-on-click="beginMetadataEdit">
                                <i class="fa fa-pencil me-1"/>Edit
                            </button>
                        </div>
                        <t t-if="state.editingMetadata">
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Title</label>
                                <input class="form-control form-control-sm" type="text"
                                       t-att-value="state.metadataDraft.name"
                                       t-on-input="(event) => this.updateMetadataDraft('name', event)"/>
                            </div>
                            <div class="row g-2">
                                <div class="col-6">
                                    <label class="form-label small fw-semibold">Document type</label>
                                    <select class="form-select form-select-sm o_usl_metadata_document_type"
                                            t-att-value="state.metadataDraft.document_type_id || ''"
                                            t-on-change="(event) => this.updateMetadataDraft('document_type_id', event)">
                                        <option value=""
                                                t-att-selected="!state.metadataDraft.document_type_id">
                                            Not set
                                        </option>
                                        <option t-foreach="state.documentTypes"
                                                t-as="documentType" t-key="documentType.id"
                                                t-att-value="documentType.id"
                                                t-att-selected="state.metadataDraft.document_type_id === documentType.id"
                                                t-esc="documentType.name"/>
                                    </select>
                                </div>
                                <div class="col-6">
                                    <label class="form-label small fw-semibold">Correspondent</label>
                                    <select class="form-select form-select-sm o_usl_metadata_correspondent"
                                            t-att-value="state.metadataDraft.correspondent_id || ''"
                                            t-on-change="(event) => this.updateMetadataDraft('correspondent_id', event)">
                                        <option value=""
                                                t-att-selected="!state.metadataDraft.correspondent_id">
                                            Not set
                                        </option>
                                        <option t-foreach="state.correspondents"
                                                t-as="correspondent" t-key="correspondent.id"
                                                t-att-value="correspondent.id"
                                                t-att-selected="state.metadataDraft.correspondent_id === correspondent.id"
                                                t-esc="correspondent.name"/>
                                    </select>
                                </div>
                                <div class="col-6">
                                    <label class="form-label small fw-semibold">Document date</label>
                                    <input class="form-control form-control-sm" type="date"
                                           t-att-value="state.metadataDraft.document_date || ''"
                                           t-on-change="(event) => this.updateMetadataDraft('document_date', event)"/>
                                </div>
                            </div>
                            <div class="mt-3">
                                <label class="form-label small fw-semibold">Tags</label>
                                <div class="d-flex flex-wrap gap-2">
                                    <button t-foreach="state.tags" t-as="tag" t-key="tag.id"
                                            type="button"
                                            t-att-class="'o_usl_tag_chip btn btn-sm ' + (state.metadataDraft.tag_ids.includes(tag.id) ? 'is-selected' : '')"
                                            t-att-style="'--tag-color:' + tag.color + ';--tag-text:' + tag.text_color"
                                            t-on-click="() => this.toggleMetadataTag(tag.id)"
                                            t-esc="tag.name"/>
                                </div>
                            </div>
                            <div class="d-flex justify-content-end gap-2 mt-3">
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        t-on-click="cancelMetadataEdit">Cancel</button>
                                <button type="button" class="btn btn-sm btn-primary"
                                        t-att-disabled="state.savingMetadata"
                                        t-on-click="saveMetadata">
                                    <t t-if="state.savingMetadata">Saving…</t>
                                    <t t-else="">Save</t>
                                </button>
                            </div>
                        </t>
                        <t t-else="">
                            <dl class="row small mb-2">
                                <dt class="col-4">Type</dt>
                                <dd class="col-8" t-esc="state.selected.document_type || 'Not set'"/>
                                <dt class="col-4">From</dt>
                                <dd class="col-8" t-esc="state.selected.correspondent || 'Not set'"/>
                                <dt class="col-4">Date</dt>
                                <dd class="col-8" t-esc="state.selected.date || 'Not set'"/>
                                <dt class="col-4">Company</dt>
                                <dd class="col-8" t-esc="state.selected.company || 'Needs review'"/>
                            </dl>
                            <div t-if="state.selected.tags.length"
                                 class="d-flex flex-wrap gap-2">
                                <button t-foreach="state.selected.tags" t-as="tag"
                                        t-key="tag.id" type="button"
                                        class="o_usl_tag_chip btn btn-sm"
                                        t-att-style="'--tag-color:' + tag.color + ';--tag-text:' + tag.text_color"
                                        t-on-click="() => this.toggleTagFilter(tag.id)"
                                        t-esc="tag.name"/>
                            </div>
                            <div t-else="" class="small text-muted">
                                No tags yet. Paperless can learn from the tags you add.
                            </div>
                        </t>
                    </section>

                    <section class="border-top p-3">
                        <h6>Linked records</h6>
                        <div t-if="state.selected.links?.length" class="list-group">
                            <button t-foreach="state.selected.links" t-as="link"
                                    t-key="link.id" type="button"
                                    class="list-group-item list-group-item-action"
                                    t-on-click="() => this.openLink(link)">
                                <strong t-esc="link.record_name"/>
                                <small class="d-block text-muted"
                                       t-esc="link.model_label"/>
                            </button>
                        </div>
                        <div t-else="" class="small text-muted">
                            This document is not linked to an Odoo record yet.
                        </div>
                    </section>

                    <details t-if="state.selected.versions?.length"
                             class="o_usl_detail_section border-top p-3">
                        <summary class="d-flex align-items-center justify-content-between">
                            <span class="fw-semibold">File versions</span>
                            <span class="badge rounded-pill text-bg-light"
                                  t-esc="state.selected.versions.length"/>
                        </summary>
                        <p class="small text-muted mt-2 mb-3">
                            New versions become current. Earlier files remain available.
                        </p>
                        <div class="list-group">
                            <div t-foreach="state.selected.versions" t-as="version"
                                 t-key="version.id"
                                 t-att-class="'list-group-item ' + (state.selected.selected_version_id === version.paperless_version_id || (!state.selected.selected_version_id &amp;&amp; version.is_current) ? 'border-primary' : '')">
                                <button type="button"
                                        class="btn btn-link text-start text-decoration-none p-0 w-100"
                                        t-on-click="() => this.selectVersion(version)">
                                    <div class="d-flex justify-content-between gap-2">
                                        <strong class="text-body" t-esc="version.label"/>
                                        <span>
                                            <span t-if="version.is_current"
                                                  class="badge text-bg-primary">Current</span>
                                            <span t-if="version.is_received_original"
                                                  class="badge text-bg-secondary ms-1">
                                                Received original
                                            </span>
                                        </span>
                                    </div>
                                    <small class="d-block text-muted text-truncate"
                                           t-esc="version.filename || 'Document file'"/>
                                    <small t-if="version.submitted_by"
                                           class="d-block text-muted">
                                        Added by <t t-esc="version.submitted_by"/>
                                    </small>
                                </button>
                                <div class="mt-2 d-flex flex-wrap gap-2">
                                    <a t-att-href="version.original_url"
                                       class="btn btn-sm btn-outline-primary"
                                       t-on-click.stop="() => {}">Download</a>
                                    <a t-att-href="version.archive_url"
                                       class="btn btn-sm btn-link text-decoration-none"
                                       title="Download Paperless's processed copy. The original is unchanged."
                                       t-on-click.stop="() => {}">Searchable PDF</a>
                                    <button t-if="state.selected.can_edit &amp;&amp; !version.is_current"
                                            type="button"
                                            class="btn btn-sm btn-link text-decoration-none"
                                            title="Makes this file current as a new version. Nothing is deleted."
                                            t-on-click="() => this.restoreVersion(version)">
                                        Restore as current
                                    </button>
                                </div>
                            </div>
                        </div>
                    </details>

                    <details t-if="state.selected.can_manage"
                             class="o_usl_detail_section border-top p-3">
                        <summary class="small text-muted">Technical details</summary>
                        <dl class="row small mt-3 mb-0">
                            <dt class="col-5">Paperless ID</dt>
                            <dd class="col-7" t-esc="state.selected.paperless_id"/>
                            <dt class="col-5">Source</dt>
                            <dd class="col-7" t-esc="state.selected.source"/>
                            <dt class="col-5">Filename</dt>
                            <dd class="col-7 text-break" t-esc="state.selected.filename"/>
                            <dt class="col-5">Checksum</dt>
                            <dd class="col-7 text-break font-monospace"
                                t-esc="state.selected.checksum"/>
                            <dt class="col-5">Access checked</dt>
                            <dd class="col-7"
                                t-esc="state.selected.permission_checked_at || 'Not yet checked'"/>
                        </dl>
                    </details>
                    <div t-if="state.selectedLoading" class="text-center text-muted p-3">
                        <i class="fa fa-circle-o-notch fa-spin me-2"/>
                        Loading document details…
                    </div>
                </div>

                <footer class="p-3 border-top">
                    <div class="d-flex gap-2">
                        <a t-att-href="'/usl_documents/' + state.selected.id + '/download?original=1'"
                           class="btn btn-primary flex-grow-1"
                           title="Download the file that was received or uploaded.">
                            <i class="fa fa-download me-1"/>Download original
                        </a>
                        <details class="o_usl_action_menu">
                            <summary class="btn btn-outline-secondary"
                                     title="More document actions">
                                More <i class="fa fa-caret-down ms-1"/>
                            </summary>
                            <div class="o_usl_action_menu_items shadow border rounded bg-white">
                                <a t-att-href="'/usl_documents/' + state.selected.id + '/download?original=0'"
                                   class="dropdown-item"
                                   title="Download Paperless's processed copy. The original is unchanged.">
                                    <i class="fa fa-file-pdf-o me-2"/>Download searchable PDF
                                </a>
                                <label t-if="state.selected.can_edit"
                                       class="dropdown-item mb-0"
                                       title="Adds a new current file. Earlier versions remain available.">
                                    <i class="fa fa-files-o me-2"/>Upload new version
                                    <input type="file" class="d-none"
                                           t-on-change="onVersionFileChange"
                                           t-att-disabled="state.uploading"/>
                                </label>
                                <a t-if="state.selected.paperless_url"
                                   t-att-href="state.selected.paperless_url"
                                   target="_blank" rel="noopener noreferrer"
                                   class="dropdown-item"
                                   title="Open advanced document tools in Paperless.">
                                    <i class="fa fa-external-link me-2"/>Open in Paperless
                                </a>
                                <button t-if="state.selected.can_manage" type="button"
                                        class="dropdown-item"
                                        t-on-click="() => this.openRecord(state.selected)">
                                    <i class="fa fa-wrench me-2"/>Open technical record
                                </button>
                            </div>
                        </details>
                    </div>
                    <button t-if="recordContext &amp;&amp; !this.isLinkedToCurrent()"
                            type="button" class="btn btn-success w-100 mt-2"
                            t-on-click="() => this.linkSelected()">
                        <i class="fa fa-link me-1"/>Link to this record
                    </button>
                    <button t-if="recordContext &amp;&amp; this.isLinkedToCurrent()"
                            type="button" class="btn btn-link text-danger w-100 mt-2"
                            t-on-click="() => this.unlinkCurrent()">
                        Remove link from this record
                    </button>
                </footer>
            </aside>
        </div>
    </t>
</templates>
