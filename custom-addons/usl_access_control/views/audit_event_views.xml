<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_usl_audit_event_list" model="ir.ui.view">
        <field name="name">usl.audit.event.list</field>
        <field name="model">usl.audit.event</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" default_order="occurred_at desc">
                <field name="occurred_at"/>
                <field name="actor_id"/>
                <field name="actor_is_agent"/>
                <field name="agent_id" optional="show"/>
                <field name="owner_id" optional="hide"/>
                <field name="credential_id" optional="hide"/>
                <field name="company_id" optional="show"/>
                <field name="event_type"/>
                <field name="outcome"/>
                <field name="model_name"/>
                <field name="action_name"/>
                <field name="action_key" optional="show"/>
                <field name="policy_digest" optional="hide"/>
                <field name="record_count" optional="hide"/>
                <field name="origin"/>
                <field name="correlation_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_usl_audit_event_form" model="ir.ui.view">
        <field name="name">usl.audit.event.form</field>
        <field name="model">usl.audit.event</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="occurred_at"/>
                            <field name="actor_id"/>
                            <field name="actor_is_agent"/>
                            <field name="agent_id"/>
                            <field name="owner_id"/>
                            <field name="credential_id"/>
                            <field name="company_id"/>
                            <field name="event_type"/>
                            <field name="outcome"/>
                        </group>
                        <group>
                            <field name="model_name"/>
                            <field name="record_ids"/>
                            <field name="operation"/>
                            <field name="action_name"/>
                            <field name="action_key"/>
                            <field name="policy_digest"/>
                            <field name="origin"/>
                            <field name="correlation_id"/>
                            <field name="request_id"/>
                            <field name="remote_address"/>
                            <field name="user_agent"/>
                        </group>
                    </group>
                    <group string="Change evidence" invisible="not changes_json">
                        <field name="changes_json" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_usl_audit_event" model="ir.actions.act_window">
        <field name="name">Distribution Audit</field>
        <field name="res_model">usl.audit.event</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_usl_distribution_audit"
              name="Distribution Audit"
              parent="base.menu_administration"
              action="action_usl_audit_event"
              sequence="90"
              groups="usl_access_control.group_audit_reader,usl_access_control.group_accounting_reviewer"/>
</odoo>
