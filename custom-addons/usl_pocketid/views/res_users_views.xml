<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_pocketid" model="ir.ui.view">
        <field name="name">res.users.form.usl.pocketid</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <field name="usl_sso_only_login" invisible="1"/>
            </xpath>
            <xpath expr="//div[@name='auth']" position="attributes">
                <attribute name="invisible">usl_sso_only_login</attribute>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page
                    name="usl_pocketid"
                    string="Pocket ID"
                    groups="base.group_system">
                    <group>
                        <group string="Login governance">
                            <field name="usl_identity_classification"/>
                            <field name="usl_pocketid_access"/>
                            <field
                                name="usl_pocketid_email_link"
                                invisible="not usl_pocketid_access"/>
                            <field name="usl_local_break_glass"/>
                        </group>
                    </group>
                    <field
                        name="usl_oidc_identity_ids"
                        context="{'default_user_id': id}">
                        <list>
                            <field name="issuer"/>
                            <field name="subject_fingerprint"/>
                            <field name="link_method"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="last_login_at"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_users_preferences_pocketid" model="ir.ui.view">
        <field name="name">res.users.preferences.usl.pocketid</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <field name="usl_sso_only_login" invisible="1"/>
            </xpath>
            <xpath expr="//div[@name='auth']" position="attributes">
                <attribute name="invisible">usl_sso_only_login</attribute>
            </xpath>
            <xpath expr="//div[@name='auth']" position="after">
                <div
                    name="usl_pocketid_security"
                    class="d-lg-flex mt-3"
                    invisible="not usl_sso_only_login">
                    <div class="col-7 col-sm-6 col-lg-3 d-flex flex-column">
                        <span class="o_form_label">Pocket ID</span>
                        <span class="text-muted">
                            Manages your sign-in and multi-factor security.
                        </span>
                    </div>
                    <div class="d-flex flex-column gap-2 flex-grow-1">
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <field
                                name="usl_pocketid_security_state"
                                widget="badge"
                                class="me-1"
                                decoration-success="usl_pocketid_security_state == 'connected'"
                                decoration-info="usl_pocketid_security_state == 'ready'"
                                decoration-muted="usl_pocketid_security_state == 'unavailable'"/>
                            <button
                                name="action_open_pocketid_account"
                                type="object"
                                string="Manage in Pocket ID"
                                icon="fa-external-link"
                                class="btn btn-secondary"/>
                        </div>
                        <div
                            class="text-muted"
                            invisible="not usl_pocketid_security_email">
                            Account:
                            <field
                                name="usl_pocketid_security_email"
                                class="d-inline-block ms-1"
                                readonly="1"/>
                        </div>
                        <div
                            class="text-muted"
                            invisible="not usl_pocketid_last_login_at">
                            Last sign-in:
                            <field
                                name="usl_pocketid_last_login_at"
                                class="d-inline-block ms-1"
                                readonly="1"/>
                        </div>
                        <span class="text-muted">
                            Change your password, passkeys, and second factor in Pocket ID.
                        </span>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_users_preferences_totp_pocketid" model="ir.ui.view">
        <field name="name">res.users.preferences.totp.usl.pocketid</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="auth_totp.view_totp_field"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='totp_enabled']/ancestor::div[hasclass('d-flex')][1]" position="attributes">
                <attribute name="invisible">usl_sso_only_login</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_users_passkeys_pocketid" model="ir.ui.view">
        <field name="name">res.users.passkeys.usl.pocketid</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="auth_passkey.auth_passkey_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='auth_passkey_key_ids']/ancestor::div[hasclass('d-md-flex')]" position="attributes">
                <attribute name="invisible">usl_sso_only_login</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_users_preferences_passkeys_pocketid" model="ir.ui.view">
        <field name="name">res.users.preferences.passkeys.usl.pocketid</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="auth_passkey.auth_passkey_users_preferences"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='auth_passkey_key_ids']/ancestor::div[hasclass('d-lg-flex')]" position="attributes">
                <attribute name="invisible">usl_sso_only_login</attribute>
            </xpath>
        </field>
    </record>
</odoo>
