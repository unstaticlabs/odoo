<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_usl_oidc_identity_list" model="ir.ui.view">
        <field name="name">usl.oidc.identity.list</field>
        <field name="model">usl.oidc.identity</field>
        <field name="arch" type="xml">
            <list>
                <field name="user_id"/>
                <field name="issuer"/>
                <field name="subject_fingerprint"/>
                <field name="link_method"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="last_login_at"/>
            </list>
        </field>
    </record>

    <record id="view_usl_oidc_identity_form" model="ir.ui.view">
        <field name="name">usl.oidc.identity.form</field>
        <field name="model">usl.oidc.identity</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Disabled"
                        bg_color="text-bg-danger"
                        invisible="active"/>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="provider_id"/>
                            <field name="issuer"/>
                            <field name="subject"/>
                            <field name="subject_fingerprint" readonly="1"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="link_method"/>
                            <field name="linked_by_id"/>
                            <field name="linked_at"/>
                            <field name="last_login_at"/>
                            <field name="last_email"/>
                            <field name="last_display_name"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_usl_oidc_identity" model="ir.actions.act_window">
        <field name="name">Pocket ID Identity Links</field>
        <field name="res_model">usl.oidc.identity</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <record id="view_usl_oidc_audit_event_list" model="ir.ui.view">
        <field name="name">usl.oidc.audit.event.list</field>
        <field name="model">usl.oidc.audit.event</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="occurred_at"/>
                <field name="event_type"/>
                <field name="reason_code"/>
                <field name="actor_id"/>
                <field name="user_id"/>
                <field name="subject_fingerprint"/>
                <field name="provider_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_usl_oidc_audit_event" model="ir.actions.act_window">
        <field name="name">Pocket ID Audit Events</field>
        <field name="res_model">usl.oidc.audit.event</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem
        id="menu_usl_oidc_identity"
        name="Pocket ID Identity Links"
        parent="base.menu_users"
        action="action_usl_oidc_identity"
        sequence="35"
        groups="base.group_system"/>
    <menuitem
        id="menu_usl_oidc_audit_event"
        name="Pocket ID Audit Events"
        parent="base.menu_users"
        action="action_usl_oidc_audit_event"
        sequence="36"
        groups="base.group_system"/>
</odoo>
