<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pocketid_provider_form" model="ir.ui.view">
        <field name="name">auth.oauth.provider.form.usl.pocketid</field>
        <field name="model">auth.oauth.provider</field>
        <field name="inherit_id" ref="auth_oidc.view_oidc_provider_form"/>
        <field name="arch" type="xml">
            <field name="flow" position="after">
                <field name="usl_pocketid" readonly="1"/>
                <field name="usl_oidc_issuer" readonly="usl_pocketid"/>
                <field name="usl_public_base_url" readonly="usl_pocketid"/>
                <field name="usl_required_group" readonly="usl_pocketid"/>
                <field name="usl_end_session_endpoint" readonly="1"/>
                <field name="usl_allow_unique_email_link" readonly="usl_pocketid"/>
                <field name="usl_token_auth_method" readonly="usl_pocketid"/>
            </field>
            <field name="client_secret" position="attributes">
                <attribute name="readonly">usl_pocketid</attribute>
                <attribute name="invisible">usl_pocketid</attribute>
            </field>
            <field name="name" position="attributes">
                <attribute name="readonly">usl_pocketid</attribute>
            </field>
            <field name="enabled" position="attributes">
                <attribute name="readonly">usl_pocketid</attribute>
            </field>
            <field name="body" position="attributes">
                <attribute name="readonly">usl_pocketid</attribute>
            </field>
            <field name="flow" position="attributes">
                <attribute name="readonly">usl_pocketid</attribute>
            </field>
            <field name="token_map" position="attributes">
                <attribute name="readonly">usl_pocketid</attribute>
            </field>
            <field name="client_id" position="attributes">
                <attribute name="readonly">usl_pocketid</attribute>
            </field>
            <field name="auth_endpoint" position="attributes">
                <attribute name="readonly">usl_pocketid</attribute>
            </field>
            <field name="scope" position="attributes">
                <attribute name="readonly">usl_pocketid</attribute>
            </field>
            <field name="validation_endpoint" position="attributes">
                <attribute name="readonly">usl_pocketid</attribute>
            </field>
            <field name="token_endpoint" position="attributes">
                <attribute name="readonly">usl_pocketid</attribute>
            </field>
            <field name="jwks_uri" position="attributes">
                <attribute name="readonly">usl_pocketid</attribute>
            </field>
        </field>
    </record>
</odoo>
