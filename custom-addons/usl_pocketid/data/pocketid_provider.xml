<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="provider_pocketid" model="auth.oauth.provider">
            <field name="name">Pocket ID (not configured)</field>
            <field name="flow">id_token_code</field>
            <field name="client_id">not-configured</field>
            <field name="client_secret" eval="False"/>
            <field name="enabled" eval="False"/>
            <field name="body">Log in with Pocket ID</field>
            <field name="scope">openid profile email groups</field>
            <field name="auth_endpoint">https://pocket-id.invalid/authorize</field>
            <field name="token_endpoint">https://pocket-id.invalid/token</field>
            <field name="jwks_uri">https://pocket-id.invalid/jwks</field>
            <field name="validation_endpoint" eval="False"/>
            <field name="usl_pocketid" eval="True"/>
            <field name="usl_token_auth_method">client_secret_basic</field>
        </record>
    </data>
    <function
        model="auth.oauth.provider"
        name="_usl_pocketid_apply_environment"/>
</odoo>
