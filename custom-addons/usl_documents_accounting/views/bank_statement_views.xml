<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bank_statement_review_documents" model="ir.ui.view">
        <field name="name">account.bank.statement.form.bank.evidence.archive</field>
        <field name="model">account.bank.statement</field>
        <field name="inherit_id" ref="usl_accounting.view_bank_statement_form_review"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_certify']" position="before">
                <button name="action_archive_bank_evidence" type="object" string="Save in Documents" groups="account.group_account_user,account.group_account_manager" invisible="not accepted_evidence_id or bank_evidence_archive_state not in ('not_requested', 'pending')" title="Send the exact received PDF to Documents, verify its checksum, and retain that Documents version for certification."/>
                <button name="action_archive_bank_evidence" type="object" string="Retry Documents" groups="account.group_account_user,account.group_account_manager" invisible="not accepted_evidence_id or bank_evidence_archive_state not in ('failed', 'unavailable')" title="Try saving the same PDF again after a temporary Documents outage. If the PDF is damaged, replace it instead."/>
                <button name="action_open_statement_pdf_upload" type="object" string="Replace statement PDF" class="btn-primary" groups="account.group_account_user,account.group_account_manager" invisible="not accepted_evidence_id or bank_evidence_archive_state not in ('failed', 'unavailable') or certification_state == 'certified'" title="Choose a valid original PDF from the bank. The damaged copy remains in the audit history and the replacement becomes the official statement."/>
            </xpath>
            <xpath expr="//button[@name='action_open_evidence']" position="attributes">
                <attribute name="string">Official statement</attribute>
                <attribute name="icon">fa-file-text-o</attribute>
                <attribute name="invisible">not accepted_evidence_id or bank_evidence_archive_state != 'archived'</attribute>
            </xpath>
            <xpath expr="//field[@name='accepted_evidence_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='accepted_evidence_id']" position="after">
                <field name="bank_evidence_document_id" string="Documents record" readonly="1" invisible="not bank_evidence_document_id"/>
                <field name="bank_evidence_document_version" string="Saved version" readonly="1" invisible="not bank_evidence_document_version"/>
                <field name="bank_evidence_archive_state" string="Documents status" widget="badge" readonly="1" decoration-danger="bank_evidence_archive_state in ('not_requested', 'failed', 'unavailable')" decoration-warning="bank_evidence_archive_state in ('pending', 'processing')" decoration-success="bank_evidence_archive_state == 'archived'"/>
            </xpath>
            <xpath expr="//div[@name='review_issues']" position="before">
                <div class="alert alert-danger" role="alert" invisible="not bank_evidence_archive_error">
                    <strong>Official statement is not safely stored in Documents.</strong>
                    <div><field name="bank_evidence_archive_error" readonly="1" nolabel="1"/></div>
                    <div class="mt-1">
                        Use <em>Retry Documents</em> after a temporary outage. If the message
                        reports conflicting Documents records, keep the accepted PDF and ask
                        a Documents administrator to resolve the links. Replace the PDF only
                        when the accepted file is damaged or incomplete.
                    </div>
                </div>
            </xpath>
            <xpath expr="//field[@name='certification_ids']/list/field[@name='evidence_sha256']" position="after">
                <field name="paperless_document_id" optional="hide"/>
                <field name="paperless_version" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_bank_ingestion_file_documents" model="ir.ui.view">
        <field name="name">account.bank.ingestion.file.form.documents</field>
        <field name="model">account.bank.ingestion.file</field>
        <field name="inherit_id" ref="usl_accounting.view_bank_ingestion_file_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='evidence_status']" position="after">
                <field name="paperless_archive_state" widget="badge" readonly="1"/>
                <field name="paperless_archive_error" readonly="1" invisible="not paperless_archive_error"/>
                <field name="paperless_document_id" readonly="1" invisible="not paperless_document_id"/>
                <field name="paperless_version" readonly="1" invisible="not paperless_version"/>
                <field name="paperless_requested_by_id" readonly="1" invisible="not paperless_requested_by_id"/>
                <field name="paperless_archived_at" readonly="1" invisible="not paperless_archived_at"/>
            </xpath>
        </field>
    </record>

</odoo>
