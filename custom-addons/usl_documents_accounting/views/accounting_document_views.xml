<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rebuild_account_declaration_documents" model="ir.ui.view">
        <field name="name">rebuild.account.declaration.archived.documents</field>
        <field name="model">rebuild.account.declaration</field>
        <field name="inherit_id" ref="rebuild_account_migration.view_rebuild_account_declaration_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_documents_workspace" type="object"
                        class="oe_stat_button" icon="fa-folder-open-o"
                        title="Open the declaration evidence and review any archive processing issue."
                        groups="usl_documents.group_documents_user,usl_documents.group_documents_accountant">
                    <div class="o_stat_info">
                        <span class="o_stat_value"><field name="archived_document_count"/></span>
                        <span class="o_stat_text">Documents</span>
                        <span class="badge rounded-pill text-bg-warning" invisible="document_archive_failure_count == 0"><field name="document_archive_failure_count"/> to review</span>
                        <span class="text-muted small" invisible="document_archive_pending_count == 0"><field name="document_archive_pending_count"/> processing</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

    <record id="view_rebuild_account_closing_documents" model="ir.ui.view">
        <field name="name">rebuild.account.closing.period.archived.documents</field>
        <field name="model">rebuild.account.closing.period</field>
        <field name="inherit_id" ref="rebuild_account_migration.view_rebuild_account_closing_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_documents_workspace" type="object"
                        class="oe_stat_button" icon="fa-folder-open-o"
                        title="Open the closing evidence and review any archive processing issue."
                        groups="usl_documents.group_documents_user,usl_documents.group_documents_accountant">
                    <div class="o_stat_info">
                        <span class="o_stat_value"><field name="archived_document_count"/></span>
                        <span class="o_stat_text">Documents</span>
                        <span class="badge rounded-pill text-bg-warning" invisible="document_archive_failure_count == 0"><field name="document_archive_failure_count"/> to review</span>
                        <span class="text-muted small" invisible="document_archive_pending_count == 0"><field name="document_archive_pending_count"/> processing</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

    <record id="view_account_asset_documents" model="ir.ui.view">
        <field name="name">account.asset.form.archived.documents</field>
        <field name="model">account.asset</field>
        <field name="inherit_id" ref="account_asset_management.account_asset_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <div class="oe_button_box" name="button_box">
                    <button name="action_open_documents_workspace" type="object"
                            class="oe_stat_button" icon="fa-folder-open-o"
                            title="Open the acquisition and depreciation evidence linked to this asset."
                            groups="usl_documents.group_documents_user,usl_documents.group_documents_accountant">
                        <div class="o_stat_info">
                            <span class="o_stat_value"><field name="archived_document_count"/></span>
                            <span class="o_stat_text">Documents</span>
                            <span class="badge rounded-pill text-bg-warning" invisible="document_archive_failure_count == 0"><field name="document_archive_failure_count"/> to review</span>
                            <span class="text-muted small" invisible="document_archive_pending_count == 0"><field name="document_archive_pending_count"/> processing</span>
                        </div>
                    </button>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
