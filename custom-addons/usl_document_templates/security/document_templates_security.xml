<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_official_documents" model="ir.module.category">
        <field name="name">Official Documents</field>
        <field name="sequence">36</field>
    </record>
    <record id="privilege_official_correspondence" model="res.groups.privilege">
        <field name="name">Official Correspondence</field>
        <field name="category_id" ref="module_category_official_documents"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_document_letter_user" model="res.groups">
        <field name="name">Official correspondence user</field>
        <field name="privilege_id" ref="privilege_official_correspondence"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>
    <record id="group_document_letter_manager" model="res.groups">
        <field name="name">Official correspondence manager</field>
        <field name="privilege_id" ref="privilege_official_correspondence"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[Command.link(ref('group_document_letter_user'))]"/>
    </record>

    <record id="rule_document_letter_company" model="ir.rule">
        <field name="name">Official letters by allowed company</field>
        <field name="model_id" ref="model_usl_document_letter"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
