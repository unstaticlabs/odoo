<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_document_template_list" model="ir.ui.view">
        <field name="name">usl.document.template.list</field>
        <field name="model">usl.document.template</field>
        <field name="arch" type="xml">
            <list string="Governed Templates" create="0" edit="0" delete="0">
                <field name="name"/>
                <field name="key"/>
                <field name="schema_version"/>
                <field name="family"/>
                <field name="output_profile"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_report_output_inventory_list" model="ir.ui.view">
        <field name="name">ir.actions.report.output.inventory.list</field>
        <field name="model">ir.actions.report</field>
        <field name="arch" type="xml">
            <list string="Report Output Inventory" create="0" edit="0" delete="0">
                <field name="name"/>
                <field name="model"/>
                <field name="report_type"/>
                <field name="usl_output_policy" widget="badge"
                       decoration-success="usl_output_policy == 'latex'"
                       decoration-warning="usl_output_policy == 'pending_migration'"
                       decoration-muted="usl_output_policy in ('machine', 'non_official', 'source_passthrough')"/>
                <field name="usl_document_template_id"/>
            </list>
        </field>
    </record>

    <record id="action_document_templates" model="ir.actions.act_window">
        <field name="name">Governed Templates</field>
        <field name="res_model">usl.document.template</field>
        <field name="view_mode">list</field>
    </record>
    <record id="action_report_output_inventory" model="ir.actions.act_window">
        <field name="name">Report Output Inventory</field>
        <field name="res_model">ir.actions.report</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_report_output_inventory_list"/>
    </record>

    <menuitem id="menu_document_governance"
              name="Governance"
              parent="menu_official_documents_root"
              sequence="90"
              groups="base.group_system"/>
    <menuitem id="menu_document_templates"
              name="Templates"
              parent="menu_document_governance"
              action="action_document_templates"
              sequence="10"
              groups="base.group_system"/>
    <menuitem id="menu_report_output_inventory"
              name="Output Inventory"
              parent="menu_document_governance"
              action="action_report_output_inventory"
              sequence="20"
              groups="base.group_system"/>
</odoo>
