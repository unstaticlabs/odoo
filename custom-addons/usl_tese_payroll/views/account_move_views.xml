<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_tese_payroll" model="ir.ui.view">
        <field name="name">account.move.form.tese.payroll</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_tese_payslip"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        type="object"
                        invisible="not tese_payslip_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">TESE Payroll</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='ref']" position="after">
                <field name="tese_payslip_id"
                       invisible="not tese_payslip_id"
                       readonly="1"/>
                <field name="tese_move_role"
                       invisible="not tese_payslip_id"
                       readonly="1"/>
                <field name="tese_attachment_id"
                       invisible="not tese_payslip_id"
                       readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
