<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tese_profile_list" model="ir.ui.view">
        <field name="name">usl.tese.profile.list</field>
        <field name="model">usl.tese.profile</field>
        <field name="arch" type="xml">
            <list string="TESE Payroll Profiles"
                  decoration-muted="not active"
                  decoration-warning="review_status in ('to_review', 'warning')"
                  decoration-success="review_status == 'ok'">
                <field name="name"/>
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="hr_version_id" optional="show"/>
                <field name="valid_from"/>
                <field name="valid_to"/>
                <field name="gross_salary" sum="Gross"/>
                <field name="net_paid" sum="Net Paid"/>
                <field name="review_status"
                       widget="badge"
                       decoration-warning="review_status in ('to_review', 'warning')"
                       decoration-success="review_status == 'ok'"/>
                <field name="active" optional="hide"/>
                <field name="company_id"
                       groups="base.group_multi_company"
                       optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_tese_profile_search" model="ir.ui.view">
        <field name="name">usl.tese.profile.search</field>
        <field name="model">usl.tese.profile</field>
        <field name="arch" type="xml">
            <search string="TESE Payroll Profiles">
                <field name="name"/>
                <field name="employee_id"/>
                <filter name="active_profiles"
                        string="Active"
                        domain="[('active', '=', True)]"/>
                <filter name="to_review"
                        string="To review"
                        domain="[('review_status', 'in', ('to_review', 'warning'))]"/>
                <separator/>
                <group>
                    <filter name="employee"
                            string="Employee"
                            context="{'group_by': 'employee_id'}"/>
                    <filter name="status"
                            string="Review Status"
                            context="{'group_by': 'review_status'}"/>
                    <filter name="company"
                            string="Company"
                            context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_tese_profile_form" model="ir.ui.view">
        <field name="name">usl.tese.profile.form</field>
        <field name="model">usl.tese.profile</field>
        <field name="arch" type="xml">
            <form string="TESE Payroll Profile" duplicate="false">
                <header>
                    <button name="action_load_french_defaults"
                            string="Load French Defaults"
                            type="object"
                            class="oe_highlight"
                            invisible="not can_configure"/>
                    <field name="review_status" widget="statusbar"/>
                </header>
                <sheet>
                    <field name="can_configure" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_payslips"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-file-text-o">
                            <field name="payslip_count"
                                   widget="statinfo"
                                   string="Payroll Records"/>
                        </button>
                    </div>
                    <widget name="web_ribbon"
                            text="Archived"
                            bg_color="text-bg-secondary"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="not can_configure"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="active" readonly="not can_configure"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"
                                   readonly="not can_configure"/>
                            <field name="employee_id"
                                   widget="many2one_avatar_employee"
                                   readonly="not can_configure"/>
                            <field name="hr_version_id"
                                   readonly="not can_configure"/>
                            <field name="employee_partner_id"/>
                            <field name="collector_partner_id"
                                   readonly="not can_configure"/>
                        </group>
                        <group>
                            <field name="valid_from" readonly="not can_configure"/>
                            <field name="valid_to" readonly="not can_configure"/>
                            <field name="default_hours" readonly="not can_configure"/>
                            <field name="hr_wage_reference"/>
                            <field name="hr_hours_reference"/>
                            <field name="last_used_date"/>
                        </group>
                    </group>
                    <div class="alert alert-warning"
                         role="alert"
                         invisible="not hr_mismatch_warning">
                        <field name="hr_mismatch_warning" nolabel="1"/>
                    </div>
                    <notebook>
                        <page name="provider_figures" string="Provider Figures">
                            <group>
                                <group string="Salary">
                                    <field name="gross_salary" readonly="not can_configure"/>
                                    <field name="employee_contribution_total"
                                           readonly="not can_configure"/>
                                    <field name="employer_contribution_total"
                                           readonly="not can_configure"/>
                                    <field name="net_social" readonly="not can_configure"/>
                                    <field name="net_before_tax" readonly="not can_configure"/>
                                </group>
                                <group string="Withholding and Payment">
                                    <field name="income_tax_base" readonly="not can_configure"/>
                                    <field name="income_tax_rate" readonly="not can_configure"/>
                                    <field name="income_tax_amount" readonly="not can_configure"/>
                                    <field name="net_paid" readonly="not can_configure"/>
                                </group>
                            </group>
                        </page>
                        <page name="accounting" string="Accounting Components">
                            <field name="component_line_ids"
                                   readonly="not can_configure">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="company_id" column_invisible="True"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="side"/>
                                    <field name="role"/>
                                    <field name="account_id"/>
                                    <field name="amount" sum="Total"/>
                                </list>
                            </field>
                        </page>
                        <page name="review" string="Review">
                            <group>
                                <field name="review_message"
                                       readonly="not can_configure"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_tese_profiles" model="ir.actions.act_window">
        <field name="name">Payroll Profiles</field>
        <field name="res_model">usl.tese.profile</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_tese_profile_search"/>
        <field name="context">{'search_default_active_profiles': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a TESE payroll profile</p>
            <p>Connect one employee record to provider figures and the French payroll accounts.</p>
        </field>
    </record>
</odoo>
