<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tese_profile_list" model="ir.ui.view">
        <field name="name">usl.tese.profile.list</field>
        <field name="model">usl.tese.profile</field>
        <field name="arch" type="xml">
            <list string="TESE Payroll Settings"
                  decoration-muted="not active"
                  decoration-warning="review_status in ('to_review', 'warning')"
                  decoration-success="review_status == 'ok'">
                <field name="currency_id" column_invisible="True"/>
                <field name="name"/>
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="hr_version_id"
                       string="Contract Version"
                       optional="show"/>
                <field name="valid_from"/>
                <field name="valid_to"/>
                <field name="gross_salary" sum="Gross"/>
                <field name="net_paid" sum="Net Paid"/>
                <field name="payslip_count"
                       string="Payrolls"
                       optional="show"/>
                <field name="last_used_date" optional="show"/>
                <field name="review_status"
                       widget="badge"
                       decoration-warning="review_status in ('to_review', 'warning')"
                       decoration-success="review_status == 'ok'"
                       decoration-muted="review_status == 'archived'"/>
                <field name="active" optional="hide"/>
                <field name="company_id"
                       groups="base.group_multi_company"
                       optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_tese_profile_search" model="ir.ui.view">
        <field name="name">usl.tese.profile.search</field>
        <field name="model">usl.tese.profile</field>
        <field name="arch" type="xml">
            <search string="TESE Payroll Settings">
                <field name="name"/>
                <field name="employee_id"/>
                <filter name="active_profiles"
                        string="Current"
                        domain="[('active', '=', True)]"/>
                <filter name="all_profiles"
                        string="All"
                        domain="[]"
                        context="{'active_test': False}"/>
                <filter name="archived_profiles"
                        string="Archived"
                        domain="[('active', '=', False)]"
                        context="{'active_test': False}"/>
                <filter name="to_review"
                        string="To Review"
                        domain="[('review_status', 'in', ('to_review', 'warning'))]"
                        context="{'active_test': False}"/>
                <separator/>
                <group>
                    <filter name="employee"
                            string="Employee"
                            context="{'group_by': 'employee_id'}"/>
                    <filter name="status"
                            string="Review Status"
                            context="{'group_by': 'review_status'}"/>
                    <filter name="company"
                            string="Company"
                            context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_tese_profile_form" model="ir.ui.view">
        <field name="name">usl.tese.profile.form</field>
        <field name="model">usl.tese.profile</field>
        <field name="arch" type="xml">
            <form string="TESE Payroll Settings" duplicate="false">
                <header>
                    <button name="action_open_settings_revision"
                            string="Revise Settings"
                            type="object"
                            class="oe_highlight"
                            help="Create a dated copy of these TESE settings. The previous version is archived, not deleted."
                            invisible="not can_configure"/>
                    <button name="action_load_french_defaults"
                            string="Load French Accounts"
                            type="object"
                            help="Load the fixed eleven French payroll accounts into this unused profile. Existing accounts are never created or renumbered."
                            invisible="not can_configure or payslip_count"/>
                    <field name="review_status" widget="statusbar"/>
                </header>
                <sheet>
                    <field name="can_configure" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_payslips"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-file-text-o">
                            <field name="payslip_count"
                                   widget="statinfo"
                                   string="Payroll Records"/>
                        </button>
                    </div>
                    <widget name="web_ribbon"
                            text="Archived"
                            bg_color="text-bg-secondary"
                            invisible="active"/>
                    <div class="oe_title mb-3">
                        <label for="name" string="Recurring TESE Settings"/>
                        <h1>
                            <field name="name"
                                   readonly="not can_configure or payslip_count"/>
                        </h1>
                        <h2 class="text-muted">
                            <field name="employee_id"
                                   widget="many2one_avatar_employee"
                                   readonly="not can_configure or payslip_count"
                                   nolabel="1"/>
                        </h2>
                    </div>

                    <div class="row g-2 mb-4">
                        <div class="col-12 col-lg-4">
                            <div class="border rounded p-3 h-100">
                                <div class="text-muted">Gross</div>
                                <div class="fs-4 fw-bold">
                                    <field name="gross_salary"
                                           widget="monetary"
                                           nolabel="1"
                                           readonly="not can_configure or payslip_count"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-4">
                            <div class="border rounded p-3 h-100">
                                <div class="text-muted">Net Paid</div>
                                <div class="fs-3 fw-bold">
                                    <field name="net_paid"
                                           widget="monetary"
                                           nolabel="1"
                                           readonly="not can_configure or payslip_count"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-4">
                            <div class="border rounded p-3 h-100">
                                <div class="text-muted">Applicable Period</div>
                                <div class="mt-2">
                                    <div class="d-flex flex-wrap gap-2 align-items-center">
                                        <span class="text-muted">From</span>
                                        <field name="valid_from"
                                               nolabel="1"
                                               readonly="not can_configure or payslip_count"/>
                                    </div>
                                    <div class="d-flex flex-wrap gap-2 align-items-center mt-1">
                                        <span class="text-muted">Until</span>
                                        <field name="valid_to"
                                               nolabel="1"
                                               widget="date_dynamic_min"
                                               options="{'min_date_field': 'valid_from'}"
                                               placeholder="Ongoing"
                                               readonly="not can_configure"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <group>
                        <group string="Employee Record">
                            <field name="company_id"
                                   groups="base.group_multi_company"
                                   readonly="not can_configure or payslip_count"/>
                            <field name="hr_version_id"
                                   string="HR Contract Version"
                                   readonly="not can_configure or payslip_count"/>
                            <field name="hr_wage_reference"
                                   string="HR Monthly Wage"/>
                            <field name="hr_hours_reference"
                                   string="HR Monthly Hours"/>
                        </group>
                        <group string="TESE Defaults">
                            <field name="default_hours"
                                   string="Declared Monthly Hours"
                                   readonly="not can_configure or payslip_count"/>
                            <field name="collector_partner_id"
                                   readonly="not can_configure or payslip_count"/>
                            <field name="last_used_date" readonly="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>

                    <div class="alert alert-warning"
                         role="alert"
                         invisible="not hr_mismatch_warning">
                        <field name="hr_mismatch_warning" nolabel="1"/>
                    </div>

                    <notebook>
                        <page name="provider_figures" string="TESE Figures">
                            <group>
                                <group string="Salary">
                                    <field name="gross_salary"
                                           readonly="not can_configure or payslip_count"/>
                                    <field name="employee_contribution_total"
                                           string="Employee Contributions"
                                           readonly="not can_configure or payslip_count"/>
                                    <field name="employer_contribution_total"
                                           string="Employer Contributions"
                                           readonly="not can_configure or payslip_count"/>
                                    <field name="net_social"
                                           readonly="not can_configure or payslip_count"/>
                                    <field name="net_before_tax"
                                           readonly="not can_configure or payslip_count"/>
                                </group>
                                <group string="Withholding and Net">
                                    <field name="income_tax_base"
                                           string="Withholding Base"
                                           readonly="not can_configure or payslip_count"/>
                                    <field name="income_tax_rate"
                                           string="Withholding Rate"
                                           readonly="not can_configure or payslip_count"/>
                                    <field name="income_tax_amount"
                                           string="Withholding Amount"
                                           readonly="not can_configure or payslip_count"/>
                                    <field name="net_paid"
                                           readonly="not can_configure or payslip_count"
                                           class="fw-bold"/>
                                </group>
                            </group>
                        </page>
                        <page name="accounting" string="Accounting Detail">
                            <field name="component_line_ids"
                                   readonly="not can_configure or payslip_count">
                                <list editable="bottom">
                                    <field name="sequence" column_invisible="True"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="company_id" column_invisible="True"/>
                                    <field name="code" optional="hide"/>
                                    <field name="name"/>
                                    <field name="side" optional="hide"/>
                                    <field name="role" optional="hide"/>
                                    <field name="account_id"/>
                                    <field name="amount" sum="Total"/>
                                </list>
                            </field>
                        </page>
                        <page name="review" string="History and Checks">
                            <group>
                                <field name="active" readonly="1"/>
                                <field name="valid_from" readonly="1"/>
                                <field name="valid_to" readonly="1"/>
                                <field name="last_used_date" readonly="1"/>
                                <field name="payslip_count" readonly="1"/>
                                <field name="review_message"
                                       readonly="not can_configure"/>
                                <field name="employee_partner_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_tese_profiles" model="ir.actions.act_window">
        <field name="name">Payroll Settings</field>
        <field name="res_model">usl.tese.profile</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_tese_profile_search"/>
        <field name="domain">['|', ('active', '=', True), ('active', '=', False)]</field>
        <field name="context">{'active_test': False, 'search_default_active_profiles': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create recurring TESE settings</p>
            <p>Keep one dated version for every change declared to TESE.</p>
        </field>
    </record>
</odoo>
