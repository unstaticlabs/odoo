<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_tese_payroll" model="ir.ui.view">
        <field name="name">res.company.form.tese.payroll</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="tese_payroll"
                      string="TESE Payroll"
                      groups="hr.group_hr_manager">
                    <group>
                        <field name="tese_payroll_journal_id"/>
                        <field name="tese_collector_partner_id"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        These settings select existing accounting and partner
                        records. TESE Payroll never creates or rewrites the
                        French chart of accounts.
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_tese_company_configuration" model="ir.actions.act_window">
        <field name="name">Company Configuration</field>
        <field name="res_model">res.company</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('id', 'in', allowed_company_ids)]</field>
        <field name="context">{'create': False}</field>
    </record>
</odoo>
