<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_tese_payroll" model="ir.ui.view">
        <field name="name">hr.employee.form.tese.payroll</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_tese_payslips"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        type="object"
                        groups="hr.group_hr_manager"
                        invisible="tese_payslip_count == 0">
                    <field name="tese_payslip_count"
                           widget="statinfo"
                           string="TESE Payroll"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
