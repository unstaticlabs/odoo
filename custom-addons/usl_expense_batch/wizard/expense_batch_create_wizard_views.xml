<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_expense_batch_create_wizard_form" model="ir.ui.view">
        <field name="name">usl.expense.batch.create.wizard.form</field>
        <field name="model">usl.expense.batch.create.wizard</field>
        <field name="arch" type="xml">
            <form string="Create expense batch">
                <field name="company_id" invisible="1"/>
                <field name="employee_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <field name="draft_count" invisible="1"/>
                <field name="draft_incomplete_count" invisible="1"/>
                <div class="alert alert-warning" role="alert" invisible="incomplete_count == 0">
                    <strong>
                        <field name="incomplete_count" class="oe_inline"/>
                        expense(s) need information.
                    </strong>
                    You can create the batch now; only incomplete draft expenses block submission.
                </div>
                <group>
                    <group string="Claim">
                        <field name="name" required="1" placeholder="e.g. Toronto trip — June/July 2026"/>
                        <field name="purpose" required="1" placeholder="Common business purpose and review context"/>
                        <field name="main_analytic_activity" readonly="1"/>
                    </group>
                    <group string="Preview">
                        <field name="expense_count"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="total_amount"/>
                        <field name="employee_paid_total"/>
                        <field name="company_paid_total"/>
                        <field name="readiness_state"
                               widget="badge"
                               decoration-success="readiness_state == 'ready'"
                               decoration-warning="readiness_state == 'incomplete'"/>
                        <field name="incomplete_count"
                               invisible="incomplete_count == 0"/>
                    </group>
                </group>
                <field name="expense_ids" nolabel="1"
                       domain="[('state', 'in', ['draft', 'approved', 'posted']), ('expense_batch_id', '=', False)]">
                    <list create="false" edit="false" delete="true"
                          decoration-warning="batch_incomplete_reason">
                        <field name="date"/>
                        <field name="name"/>
                        <field name="product_id"/>
                        <field name="payment_mode"/>
                        <field name="batch_attachment_status"
                               widget="badge"
                               decoration-success="batch_attachment_status in ('attached', 'not_required')"
                               decoration-warning="batch_attachment_status == 'missing'"/>
                        <field name="state" string="Expense status" widget="badge"/>
                        <field name="batch_incomplete_reason"
                               string="Missing information"
                               optional="hide"/>
                        <field name="total_amount" sum="Total"/>
                        <field name="company_currency_id" column_invisible="True"/>
                    </list>
                </field>
                <footer>
                    <button name="action_create_and_submit"
                            string="Submit batch"
                            type="object"
                            class="btn-primary"
                            data-hotkey="q"
                            title="Create the batch and send only its draft expenses for manager approval. This does not post or pay them."
                            invisible="draft_incomplete_count != 0 or draft_count == 0"/>
                    <button name="action_create_batch"
                            string="Create batch"
                            type="object"
                            title="Group the selected expenses without submitting, posting, or paying them."
                            class="btn-secondary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
