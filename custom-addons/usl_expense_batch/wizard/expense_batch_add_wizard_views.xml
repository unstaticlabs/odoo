<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_expense_batch_add_wizard_form" model="ir.ui.view">
        <field name="name">usl.expense.batch.add.wizard.form</field>
        <field name="model">usl.expense.batch.add.wizard</field>
        <field name="arch" type="xml">
            <form string="Add expenses">
                <field name="batch_id"/>
                <field name="employee_id" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <field name="expense_ids"
                       nolabel="1"
                       options="{'no_create': True}">
                    <list create="false" edit="false" delete="true">
                        <field name="date"/>
                        <field name="name"/>
                        <field name="product_id"/>
                        <field name="state" widget="badge"/>
                        <field name="total_amount"/>
                    </list>
                </field>
                <footer>
                    <button name="action_add"
                            string="Add expenses"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
