<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_expense_list_batch" model="ir.ui.view">
        <field name="name">hr.expense.list.batch</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_expenses_analysis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="batch_attachment_status"
                       widget="badge"
                       optional="show"
                       decoration-success="batch_attachment_status in ('attached', 'not_required')"
                       decoration-warning="batch_attachment_status == 'missing'"/>
                <field name="expense_batch_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_hr_expense_search_batch" model="ir.ui.view">
        <field name="name">hr.expense.search.batch</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='draft']" position="before">
                <filter name="needs_batching"
                        string="Needs batching"
                        domain="[('expense_batch_id', '=', False), ('state', 'in', ['draft', 'approved', 'posted'])]"/>
                <filter name="batch_ready"
                        string="Ready to submit"
                        domain="[('state', '=', 'draft'), ('batch_readiness', '=', 'ready')]"/>
                <filter name="batch_incomplete"
                        string="Needs information"
                        domain="[('state', '=', 'draft'), ('batch_readiness', '=', 'incomplete')]"/>
                <filter name="already_batched"
                        string="Already in a batch"
                        domain="[('batch_readiness', '=', 'batched')]"/>
                <separator/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter name="expense_batch"
                        string="Expense Batch"
                        domain="[]"
                        context="{'group_by': 'expense_batch_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="hr_expense.hr_expense_actions_my_all" model="ir.actions.act_window">
        <field name="context">
            {
                'search_default_my_open_expenses': 1,
                'search_default_needs_batching': 1,
            }
        </field>
    </record>

    <record id="view_hr_expense_form_batch" model="ir.ui.view">
        <field name="name">hr.expense.form.batch</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_expense_batch"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-folder-open"
                        invisible="not expense_batch_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Expense Batch</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='nb_attachment'][@invisible='1']" position="after">
                <field name="expense_batch_id" invisible="1"/>
                <field name="batch_readiness" invisible="1"/>
                <field name="batch_incomplete_reason" invisible="1"/>
                <field name="batch_attachment_status" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='employee_id']" position="after">
                <field name="expense_batch_id"
                       readonly="state != 'draft'"
                       domain="[('employee_id', '=', employee_id), ('company_id', '=', company_id), ('active', '=', True)]"/>
            </xpath>
            <xpath expr="//field[@name='analytic_distribution']" position="after">
                <field name="analytic_context_source"
                       readonly="1"
                       invisible="not expense_batch_id"/>
                <field name="batch_context_status"
                       widget="badge"
                       readonly="1"
                       invisible="not expense_batch_id"/>
                <field name="batch_warning_reason"
                       readonly="1"
                       invisible="not batch_warning_reason"/>
            </xpath>
            <xpath expr="//field[@name='account_id']" position="after">
                <field name="account_context_source"
                       readonly="1"
                       invisible="not expense_batch_id"/>
            </xpath>
        </field>
    </record>
</odoo>
