<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_expense_batch_list" model="ir.ui.view">
        <field name="name">usl.expense.batch.list</field>
        <field name="model">usl.expense.batch</field>
        <field name="arch" type="xml">
            <list string="Expense Batches"
                  decoration-info="state == 'draft'"
                  decoration-warning="state == 'submitted'"
                  decoration-success="state in ('approved', 'posted', 'paid')">
                <field name="currency_id" column_invisible="True"/>
                <field name="name"/>
                <field name="context_type" optional="show"/>
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="purpose" optional="show"/>
                <field name="date_from"/>
                <field name="date_to" optional="hide"/>
                <field name="expense_count"/>
                <field name="total_amount" sum="Total"/>
                <field name="readiness_state"
                       widget="badge"
                       decoration-success="readiness_state == 'ready'"
                       decoration-warning="readiness_state == 'incomplete'"/>
                <field name="exception_count" optional="show"/>
                <field name="warning_count" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'submitted'"
                       decoration-success="state in ('approved', 'posted', 'paid')"
                       decoration-danger="state == 'refused'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_expense_batch_search" model="ir.ui.view">
        <field name="name">usl.expense.batch.search</field>
        <field name="model">usl.expense.batch</field>
        <field name="arch" type="xml">
            <search string="Expense Batches">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="purpose"/>
                <field name="context_type"/>
                <filter name="my_batches"
                        string="My expense batches"
                        domain="[('employee_id.user_id', '=', uid)]"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="submitted" string="Waiting approval" domain="[('state', '=', 'submitted')]"/>
                <filter name="approved" string="Ready to post" domain="[('state', '=', 'approved')]"/>
                <filter name="date" string="Expense period" date="date_from"/>
                <group>
                    <filter name="employee" string="Employee" domain="[]" context="{'group_by': 'employee_id'}"/>
                    <filter name="state" string="Status" domain="[]" context="{'group_by': 'state'}"/>
                    <filter name="group_context_type" string="Context" domain="[]" context="{'group_by': 'context_type'}"/>
                    <filter name="company" string="Company" domain="[]" context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_expense_batch_form" model="ir.ui.view">
        <field name="name">usl.expense.batch.form</field>
        <field name="model">usl.expense.batch</field>
        <field name="arch" type="xml">
            <form string="Expense Batch">
                <header>
                    <button name="action_open_context_wizard"
                            string="Apply shared context"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'draft' or (not account_override_id and not analytic_distribution)"/>
                    <button name="action_submit"
                            string="Submit batch"
                            type="object"
                            class="oe_highlight"
                            title="Send only the draft expenses in this batch for manager approval. This does not post or pay them."
                            invisible="state != 'draft'"/>
                    <button name="action_approve"
                            string="Approve batch"
                            type="object"
                            class="oe_highlight"
                            title="Approve the submitted expenses in this batch. Nothing is posted or paid."
                            groups="hr_expense.group_hr_expense_team_approver"
                            invisible="state != 'submitted'"/>
                    <button name="action_post"
                            string="Post batch"
                            type="object"
                            class="oe_highlight"
                            title="Post the approved expenses in this batch to Accounting."
                            groups="account.group_account_invoice"
                            invisible="state != 'approved'"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,submitted,approved,posted,paid"/>
                </header>
                <sheet>
                    <field name="account_override_id" invisible="1"/>
                    <field name="analytic_distribution" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_moves"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-book"
                                invisible="move_count == 0"
                                groups="account.group_account_readonly">
                            <field name="move_count" widget="statinfo" string="Journal Entries"/>
                        </button>
                        <button name="action_open_expenses"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-file-text-o">
                            <field name="expense_count" widget="statinfo" string="Expenses"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" text="Needs information" bg_color="text-bg-warning"
                            invisible="incomplete_count == 0"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="state != 'draft'"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="context_type" readonly="state != 'draft'"/>
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                            <field name="purpose" readonly="state != 'draft'"/>
                            <field name="analytic_context_summary" readonly="1"/>
                        </group>
                        <group>
                            <field name="context_date_from" readonly="state != 'draft'"/>
                            <field name="context_date_to" readonly="state != 'draft'"/>
                            <field name="date_from" string="First expense" readonly="1"/>
                            <field name="date_to" string="Last expense" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="total_amount"/>
                            <field name="employee_paid_total"/>
                            <field name="company_paid_total"/>
                            <field name="attachment_count"/>
                            <field name="readiness_state"
                                   widget="badge"
                                   decoration-success="readiness_state == 'ready'"
                                   decoration-warning="readiness_state == 'incomplete'"/>
                            <field name="incomplete_count"
                                   invisible="incomplete_count == 0"/>
                            <field name="exception_count"
                                   invisible="exception_count == 0"/>
                            <field name="stale_context_count"
                                   invisible="stale_context_count == 0"/>
                            <field name="warning_count"
                                   invisible="warning_count == 0"/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert" invisible="stale_context_count == 0">
                        The shared context changed after it was applied. Review and apply the current revision before submission.
                    </div>
                    <div class="alert alert-info" role="status" invisible="exception_count == 0">
                        Explicit expense exceptions are preserved and remain visible in the expense list.
                    </div>
                    <notebook>
                        <page name="expenses" string="Expenses">
                            <field name="expense_ids" readonly="state not in ('draft', 'submitted', 'approved')">
                                <list create="false" edit="false"
                                      decoration-warning="batch_incomplete_reason">
                                    <field name="company_currency_id" column_invisible="True"/>
                                    <field name="date"/>
                                    <field name="name"/>
                                    <field name="product_id"/>
                                    <field name="payment_mode"/>
                                    <field name="batch_context_status"
                                           widget="badge"
                                           decoration-info="batch_context_status == 'inherited'"
                                           decoration-warning="batch_context_status == 'stale'"
                                           decoration-danger="batch_context_status == 'exception'"
                                           optional="show"/>
                                    <field name="batch_attachment_status"
                                           widget="badge"
                                           decoration-success="batch_attachment_status in ('attached', 'not_required')"
                                           decoration-warning="batch_attachment_status == 'missing'"/>
                                    <field name="state" string="Expense status" widget="badge"/>
                                    <field name="analytic_distribution"
                                           widget="analytic_distribution"
                                           optional="hide"
                                           groups="analytic.group_analytic_accounting"/>
                                    <field name="batch_incomplete_reason"
                                           string="Missing information"
                                           optional="hide"/>
                                    <field name="batch_warning_reason"
                                           string="Review warning"
                                           optional="show"/>
                                    <field name="account_id"
                                           optional="hide"
                                           groups="account.group_account_readonly"/>
                                    <field name="total_amount" sum="Total"/>
                                    <button name="action_return_from_batch"
                                            string="Remove"
                                            type="object"
                                            icon="fa-undo"
                                            title="Remove this expense from the batch and return it for individual correction."
                                            invisible="state not in ('draft', 'submitted', 'approved')"/>
                                </list>
                            </field>
                        </page>
                        <page name="review" string="Review">
                            <group string="Shared context">
                                <field name="context_revision"/>
                                <field name="analytic_distribution"
                                       widget="analytic_distribution"
                                       readonly="state != 'draft'"
                                       groups="analytic.group_analytic_accounting"/>
                                <field name="account_override_id"
                                       readonly="state != 'draft'"
                                       groups="hr_expense.group_hr_expense_manager,account.group_account_manager"/>
                                <field name="notes" readonly="state != 'draft'"/>
                            </group>
                            <group string="Breakdown and remaining work">
                                <field name="product_summary"/>
                                <field name="employee_paid_open_count"/>
                                <field name="company_paid_open_count"/>
                                <field name="exception_count"/>
                                <field name="warning_count"/>
                            </group>
                            <group string="Accounting traceability" groups="account.group_account_readonly">
                                <field name="accounting_reconciliation_state" widget="badge"
                                       decoration-success="accounting_reconciliation_state == 'matched'"
                                       decoration-warning="accounting_reconciliation_state == 'pending'"
                                       decoration-danger="accounting_reconciliation_state == 'difference'"/>
                                <field name="accounted_expense_count"/>
                                <field name="accounting_difference"
                                       invisible="accounting_reconciliation_state != 'difference'"/>
                            </group>
                            <group>
                                <field name="submitted_by_id"/>
                                <field name="submitted_date"/>
                                <field name="approved_by_id"/>
                                <field name="approved_date"/>
                                <field name="incomplete_count"/>
                            </group>
                            <field name="incomplete_expense_ids" readonly="1">
                                <list create="false" edit="false">
                                    <field name="name"/>
                                    <field name="batch_attachment_status"
                                           widget="badge"
                                           decoration-success="batch_attachment_status in ('attached', 'not_required')"
                                           decoration-warning="batch_attachment_status == 'missing'"/>
                                    <field name="state" string="Expense status" widget="badge"/>
                                    <field name="batch_incomplete_reason"
                                           string="Missing information"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_expense_batches" model="ir.actions.act_window">
        <field name="name">Expense Batches</field>
        <field name="res_model">usl.expense.batch</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_expense_batch_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create an expense batch</p>
            <p>Group related receipts into one clear submission and accounting context.</p>
        </field>
    </record>

    <!-- Keep the app title as the shortest route to the user's own expenses,
         while exposing the operational workspaces directly in the navbar. -->
    <record id="hr_expense.menu_hr_expense_root" model="ir.ui.menu">
        <field name="action" ref="hr_expense.hr_expense_actions_my_all"/>
    </record>
    <record id="hr_expense.menu_hr_expense_my_expenses" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="hr_expense.menu_hr_expense_my_expenses_all" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="hr_expense.menu_hr_expense_expenses_to_process" model="ir.ui.menu">
        <field name="parent_id" ref="hr_expense.menu_hr_expense_root"/>
    </record>

    <menuitem id="menu_expense_batches"
              name="Expense Batches"
              parent="hr_expense.menu_hr_expense_root"
              action="action_expense_batches"
              sequence="2"
              groups="base.group_user"/>
</odoo>
