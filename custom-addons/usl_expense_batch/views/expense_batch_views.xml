<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_expense_batch_list" model="ir.ui.view">
        <field name="name">usl.expense.batch.list</field>
        <field name="model">usl.expense.batch</field>
        <field name="arch" type="xml">
            <list string="Expense Batches"
                  class="o_usl_expense_batch_list"
                  js_class="usl_expense_batch_list">
                <field name="active" column_invisible="True"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="expense_progress" column_invisible="True"/>
                <field name="name"/>
                <field name="context_type" optional="show"/>
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="purpose" optional="hide"/>
                <field name="period_summary" string="Period"/>
                <field name="expense_count" string="Expenses"/>
                <field name="total_amount" string="Total" sum="Total"/>
                <field name="expense_progress_summary"
                       string="Expense Progress"
                       widget="badge"
                       decoration-info="expense_progress == 'draft'"
                       decoration-warning="expense_progress == 'submitted'"
                       decoration-success="expense_progress in ('approved', 'posted', 'paid')"
                       decoration-danger="expense_progress == 'refused'"/>
                <field name="readiness_state"
                       string="Readiness"
                       widget="badge"
                       decoration-success="readiness_state == 'ready'"
                       decoration-warning="readiness_state == 'incomplete'"/>
                <field name="exception_count"
                       string="Issues"
                       optional="show"
                       decoration-danger="exception_count &gt; 0"/>
                <field name="warning_count" optional="hide"/>
                <field name="batch_state"
                       widget="badge"
                       decoration-info="batch_state == 'open'"
                       decoration-muted="batch_state == 'archived'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_expense_batch_search" model="ir.ui.view">
        <field name="name">usl.expense.batch.search</field>
        <field name="model">usl.expense.batch</field>
        <field name="arch" type="xml">
            <search string="Expense Batches">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="purpose"/>
                <field name="context_type"/>
                <filter name="open_batches" string="Open" domain="[('active', '=', True)]"/>
                <filter name="needs_information"
                        string="Needs information"
                        domain="[('expense_ids.batch_readiness', '=', 'incomplete')]"/>
                <filter name="my_batches"
                        string="My batches"
                        domain="[('employee_id.user_id', '=', uid)]"/>
                <filter name="exceptions"
                        string="Exceptions"
                        domain="[('has_exceptions', '=', True)]"/>
                <separator/>
                <filter name="draft" string="Has drafts" domain="[('expense_progress', '=', 'draft')]"/>
                <filter name="submitted" string="Waiting approval" domain="[('expense_progress', '=', 'submitted')]"/>
                <filter name="approved" string="Ready to post" domain="[('expense_progress', '=', 'approved')]"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <filter name="date" string="Expense period" date="date_from"/>
                <group>
                    <filter name="employee" string="Employee" domain="[]" context="{'group_by': 'employee_id'}"/>
                    <filter name="expense_progress" string="Expense progress" domain="[]" context="{'group_by': 'expense_progress'}"/>
                    <filter name="group_context_type" string="Context" domain="[]" context="{'group_by': 'context_type'}"/>
                    <filter name="company" string="Company" domain="[]" context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_expense_batch_form" model="ir.ui.view">
        <field name="name">usl.expense.batch.form</field>
        <field name="model">usl.expense.batch</field>
        <field name="arch" type="xml">
            <form string="Expense Batch">
                <header>
                    <button name="action_open_add_expenses_wizard"
                            string="Add expenses"
                            type="object"
                            class="btn-secondary"
                            icon="fa-plus"
                            invisible="not active"/>
                    <button name="action_open_context_wizard"
                            string="Apply context"
                            type="object"
                            class="btn-secondary"
                            title="Preview changes to draft expenses. Line-specific choices stay unchanged unless a manager explicitly replaces them."
                            invisible="not active or draft_expense_count == 0 or (not account_override_id and not analytic_distribution)"/>
                    <button name="action_submit"
                            string="Submit batch"
                            type="object"
                            class="oe_highlight"
                            title="Send only the draft expenses in this batch for manager approval. This does not post or pay them."
                            invisible="not active or draft_expense_count == 0"/>
                    <button name="action_approve"
                            string="Approve batch"
                            type="object"
                            class="oe_highlight"
                            title="Approve the submitted expenses in this batch. Nothing is posted or paid."
                            groups="hr_expense.group_hr_expense_team_approver"
                            invisible="not active or draft_expense_count != 0 or submitted_expense_count == 0"/>
                    <button name="action_post"
                            string="Post batch"
                            type="object"
                            class="oe_highlight"
                            title="Post the approved expenses in this batch to Accounting."
                            groups="account.group_account_invoice"
                            invisible="not active or draft_expense_count != 0 or submitted_expense_count != 0 or approved_expense_count == 0"/>
                </header>
                <sheet class="o_usl_expense_batch_form">
                    <field name="active" invisible="1"/>
                    <field name="draft_expense_count" invisible="1"/>
                    <field name="submitted_expense_count" invisible="1"/>
                    <field name="approved_expense_count" invisible="1"/>
                    <widget name="web_ribbon" text="Archived" bg_color="text-bg-secondary" invisible="active"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_documents_workspace"
                                type="object" class="oe_stat_button"
                                icon="fa-folder-open-o"
                                title="Open the evidence linked to this expense batch and review any archive processing issue."
                                groups="usl_documents.group_documents_user,usl_documents.group_documents_accountant">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="archived_document_count"/></span>
                                <span class="o_stat_text">Documents</span>
                                <span class="badge rounded-pill text-bg-warning" invisible="document_archive_failure_count == 0"><field name="document_archive_failure_count"/> to review</span>
                                <span class="text-muted small" invisible="document_archive_pending_count == 0"><field name="document_archive_pending_count"/> processing</span>
                            </div>
                        </button>
                        <button name="action_open_moves"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-book"
                                invisible="move_count == 0"
                                groups="account.group_account_readonly">
                            <field name="move_count" widget="statinfo" string="Journal Entries"/>
                        </button>
                    </div>
                    <div class="oe_title o_usl_expense_batch_title">
                        <h1 class="d-flex flex-wrap align-items-center gap-2">
                            <field name="name" readonly="not active"/>
                            <field name="batch_state"
                                   nolabel="1"
                                   widget="badge"
                                   class="fs-6"
                                   decoration-info="batch_state == 'open'"
                                   decoration-muted="batch_state == 'archived'"/>
                        </h1>
                        <field name="purpose"
                               class="text-muted"
                               nolabel="1"
                               placeholder="What are these expenses for?"
                               readonly="not active"/>
                    </div>
                    <field name="currency_id" invisible="1"/>
                    <div class="o_usl_batch_summary mt-3 mb-4" role="group" aria-label="Batch summary">
                        <div class="o_usl_batch_metric">
                            <div class="o_usl_batch_metric_label small">Total</div>
                            <field name="total_amount" nolabel="1" class="fw-semibold"/>
                        </div>
                        <div class="o_usl_batch_metric">
                            <div class="o_usl_batch_metric_label small">Expenses</div>
                            <field name="expense_count" nolabel="1" class="oe_inline"/>
                            <div class="o_usl_batch_metric_detail small">
                                <field name="expense_progress_summary" nolabel="1"/>
                            </div>
                        </div>
                        <div class="o_usl_batch_metric">
                            <div class="o_usl_batch_metric_label small">Expense period</div>
                            <field name="date_from" nolabel="1" class="oe_inline"/>
                            <span class="text-muted"> — </span>
                            <field name="date_to" nolabel="1" class="oe_inline"/>
                        </div>
                        <div class="o_usl_batch_metric">
                            <div class="o_usl_batch_metric_label small">Paid by employee / company</div>
                            <field name="employee_paid_total" nolabel="1" class="oe_inline"/>
                            <span class="text-muted"> / </span>
                            <field name="company_paid_total" nolabel="1" class="oe_inline"/>
                        </div>
                        <div class="o_usl_batch_metric">
                            <div class="o_usl_batch_metric_label small">Readiness</div>
                            <field name="readiness_state"
                                   nolabel="1"
                                   widget="badge"
                                   decoration-success="readiness_state == 'ready'"
                                   decoration-warning="readiness_state == 'incomplete'"/>
                            <div class="o_usl_batch_metric_detail small"
                                 invisible="not incomplete_count and not exception_count and not stale_context_count and not warning_count">
                                <field name="incomplete_count" nolabel="1" class="oe_inline"/> incomplete ·
                                <field name="exception_count" nolabel="1" class="oe_inline"/> exceptions
                            </div>
                        </div>
                    </div>

                    <group string="Shared context" col="4" class="o_usl_batch_context">
                        <field name="employee_id" readonly="not active or expense_count != 0"/>
                        <field name="company_id"
                               groups="base.group_multi_company"
                               readonly="not active or expense_count != 0"/>
                        <field name="context_type" readonly="not active"/>
                        <newline/>
                        <label for="context_date_from" string="Context period"/>
                        <div name="context_period" class="o_row">
                            <field name="context_date_from"
                                   nolabel="1"
                                   readonly="not active"/>
                            <i class="fa fa-long-arrow-right mx-2"
                               aria-label="To"
                               title="To"/>
                            <field name="context_date_to"
                                   nolabel="1"
                                   readonly="not active"/>
                        </div>
                        <field name="analytic_distribution"
                               widget="analytic_distribution"
                               readonly="not active"
                               colspan="4"/>
                    </group>

                    <div class="alert alert-warning py-2 mb-2"
                         role="status"
                         invisible="not incomplete_count and not exception_count and not stale_context_count and not warning_count">
                        <i class="fa fa-exclamation-triangle me-1"
                           title="Needs attention"
                           aria-hidden="true"/>
                        <strong>Some expenses need attention.</strong>
                        Point to a line warning for details.
                    </div>
                    <div class="text-muted small mb-3" invisible="not product_summary">
                        <span class="fw-semibold">Expense types:</span>
                        <field name="product_summary" nolabel="1" class="oe_inline"/>
                    </div>

                    <notebook>
                        <page name="expenses" string="Expenses">
                            <field name="expense_ids" readonly="not active">
                                <list create="false" edit="false" delete="false" open_form_view="true"
                                      decoration-warning="batch_incomplete_reason">
                                    <field name="company_currency_id" column_invisible="True"/>
                                    <field name="batch_attention_message" column_invisible="True"/>
                                    <field name="date"/>
                                    <field name="batch_attention_level"
                                           string=""
                                           widget="expense_batch_attention"/>
                                    <field name="name"/>
                                    <field name="product_id"/>
                                    <field name="payment_mode"/>
                                    <field name="batch_attachment_status"
                                           widget="badge"
                                           decoration-success="batch_attachment_status in ('attached', 'not_required')"
                                           decoration-warning="batch_attachment_status == 'missing'"/>
                                    <field name="state" string="Expense status" widget="badge"/>
                                    <field name="analytic_distribution"
                                           widget="analytic_distribution"
                                           optional="hide"
                                           groups="analytic.group_analytic_accounting"/>
                                    <field name="batch_incomplete_reason"
                                           string="Missing information"
                                           optional="hide"/>
                                    <field name="account_id"
                                           optional="hide"
                                           groups="account.group_account_readonly"/>
                                    <field name="total_amount" sum="Total"/>
                                    <button name="action_return_from_batch"
                                            string="Remove from Batch"
                                            type="object"
                                            icon="fa-unlink"
                                            title="Remove this draft expense from the Batch without deleting it."
                                            invisible="state != 'draft'"/>
                                    <button name="action_return_from_batch"
                                            string="Return for correction"
                                            type="object"
                                            icon="fa-undo"
                                            title="Return this expense to draft and remove it from the Batch."
                                            invisible="state not in ('submitted', 'approved')"/>
                                </list>
                            </field>
                        </page>
                        <page name="accounting_history"
                              string="Accounting and history"
                              groups="account.group_account_readonly,hr_expense.group_hr_expense_manager">
                            <group string="Accounting treatment">
                                <field name="account_override_id"
                                       readonly="not active"
                                       groups="hr_expense.group_hr_expense_manager,account.group_account_manager"/>
                                <field name="notes" readonly="not active"/>
                                <field name="accounting_reconciliation_state" widget="badge"
                                       decoration-success="accounting_reconciliation_state == 'matched'"
                                       decoration-warning="accounting_reconciliation_state == 'pending'"
                                       decoration-danger="accounting_reconciliation_state == 'difference'"/>
                                <field name="accounted_expense_count"/>
                                <field name="accounting_difference"
                                       invisible="accounting_reconciliation_state != 'difference'"/>
                            </group>
                            <group string="History">
                                <field name="context_revision"/>
                                <field name="submitted_by_id"/>
                                <field name="submitted_date"/>
                                <field name="approved_by_id"/>
                                <field name="approved_date"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_expense_batches" model="ir.actions.act_window">
        <field name="name">Expense Batches</field>
        <field name="res_model">usl.expense.batch</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_expense_batch_search"/>
        <field name="context">{'search_default_open_batches': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create an expense batch</p>
            <p>Group related receipts into one clear submission and accounting context.</p>
        </field>
    </record>

    <!-- Keep the app title as the shortest route to the user's own expenses,
         while exposing the operational workspaces directly in the navbar. -->
    <record id="hr_expense.menu_hr_expense_root" model="ir.ui.menu">
        <field name="action" ref="hr_expense.hr_expense_actions_my_all"/>
    </record>
    <record id="hr_expense.menu_hr_expense_my_expenses" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="hr_expense.menu_hr_expense_my_expenses_all" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="hr_expense.menu_hr_expense_expenses_to_process" model="ir.ui.menu">
        <field name="parent_id" ref="hr_expense.menu_hr_expense_root"/>
    </record>

    <menuitem id="menu_expense_batches"
              name="Expense Batches"
              parent="hr_expense.menu_hr_expense_root"
              action="action_expense_batches"
              sequence="2"
              groups="base.group_user"/>
</odoo>
