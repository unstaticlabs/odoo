<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="usl_expense_batch.ListButtons"
       t-inherit="hr_expense.ListButtons"
       t-inherit-mode="extension">
        <xpath expr="//button[@t-if='displaySubmit()']" position="replace">
            <button t-if="displaySubmit()"
                    class="d-none d-md-block btn btn-primary text-nowrap"
                    t-on-click="onOpenExpenseBatchWizard">
                Create expense batch
            </button>
        </xpath>
    </t>
</templates>
