<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="usl_expense_batch.ListButtons"
       t-inherit="hr_expense.ListButtons"
       t-inherit-mode="extension">
        <xpath expr="//button[@t-if='this.displaySubmit()']" position="before">
            <button t-if="this.displayCreateExpenseBatch()"
                    t-att-class="{'btn-primary': this.batchActionIsPrimary(), 'btn-secondary': !this.batchActionIsPrimary()}"
                    class="btn text-nowrap"
                    t-on-click="() => this.onOpenExpenseBatchWizard()">
                Add to a Batch
            </button>
        </xpath>
    </t>
</templates>
