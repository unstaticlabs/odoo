<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="usl_expense_batch.ListButtons"
       t-inherit="hr_expense.ListButtons"
       t-inherit-mode="extension">
        <xpath expr="//button[@t-if='displaySubmit()']" position="before">
            <button t-if="displayCreateExpenseBatch()"
                    t-att-class="{'btn-primary': batchActionIsPrimary(), 'btn-secondary': !batchActionIsPrimary()}"
                    class="d-none d-md-block btn text-nowrap"
                    t-on-click="onOpenExpenseBatchWizard">
                Add to a Batch
            </button>
        </xpath>
    </t>
</templates>
