<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="usl_expense_batch.ExpenseBatchAddDialog">
        <Dialog title="this.props.title"
                size="'xl'"
                withBodyPadding="false"
                contentClass="'o_usl_add_expenses_dialog'">
            <t t-set-slot="header" t-slot-scope="scope">
                <t t-call="web.Dialog.header">
                    <t t-set="dismiss" t-value="scope.close"/>
                    <t t-set="fullscreen" t-value="scope.isFullscreen"/>
                </t>
            </t>
            <View t-props="this.viewProps"/>
            <t t-set-slot="footer">
                <button class="btn btn-primary o_select_button"
                        t-att-disabled="this.state.resIds.length === 0"
                        data-hotkey="v"
                        t-on-click="() => this.select(this.state.resIds)">
                    Add selected expenses
                </button>
                <button class="btn btn-secondary o_form_button_cancel"
                        data-hotkey="z"
                        t-on-click="() => this.props.close()">
                    Cancel
                </button>
            </t>
        </Dialog>
    </t>
</templates>
