<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_company_form_interface_theme" model="ir.ui.view">
        <field name="name">res.company.form.interface.theme</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <field name="color" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="color" position="after">
                <label for="usl_ui_theme_color"/>
                <div class="o_row">
                    <field name="usl_ui_theme_color" widget="color" nolabel="1"/>
                    <button name="action_use_automatic_usl_ui_theme_color"
                            type="object"
                            string="Use automatic color"
                            title="Remove the custom color and inherit from the parent company or use the approved automatic palette."
                            class="btn-link"
                            invisible="not usl_ui_theme_color"/>
                    <span class="text-muted" invisible="usl_ui_theme_color or not parent_id">
                        Inherited from parent company
                    </span>
                    <span class="text-muted" invisible="usl_ui_theme_color or parent_id">
                        Assigned automatically from the approved palette
                    </span>
                </div>
            </field>
        </field>
    </record>
</odoo>
