#. module: usl_locale
#: model:ir.model.fields,field_description:usl_locale.field_res_company__usl_ui_theme_color
msgid "Color"
msgstr "Couleur"

#. module: usl_locale
#: model:ir.model.fields,help:usl_locale.field_res_company__usl_ui_theme_color
msgid "Identifies this company in the Odoo interface. Leave empty to inherit the parent company's color or use the approved automatic palette."
msgstr "Identifie cette société dans l’interface Odoo. Laissez ce champ vide pour hériter de la couleur de la société parente ou utiliser la palette automatique approuvée."

#. module: usl_locale
#: model:ir.model.fields,field_description:usl_locale.field_res_company__usl_resolved_ui_theme_color
msgid "Resolved color"
msgstr "Couleur effective"

#. module: usl_locale
#: model:ir.model.fields,field_description:usl_locale.field_res_company__color
msgid "Technical color index"
msgstr "Indice de couleur technique"

#. module: usl_locale
#: model_terms:ir.ui.view,arch_db:usl_locale.view_company_form_interface_theme
msgid "Use automatic color"
msgstr "Utiliser la couleur automatique"

#. module: usl_locale
#: model_terms:ir.ui.view,arch_db:usl_locale.view_company_form_interface_theme
msgid "Remove the custom color and inherit from the parent company or use the approved automatic palette."
msgstr "Supprime la couleur personnalisée pour hériter de la société parente ou utiliser la palette automatique approuvée."

#. module: usl_locale
#: model_terms:ir.ui.view,arch_db:usl_locale.view_company_form_interface_theme
