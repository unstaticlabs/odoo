msgstr "Héritée de la société parente"

#. module: usl_locale
#: model_terms:ir.ui.view,arch_db:usl_locale.view_company_form_interface_theme
msgid "Assigned automatically from the approved palette"
msgstr "Attribuée automatiquement depuis la palette approuvée"

