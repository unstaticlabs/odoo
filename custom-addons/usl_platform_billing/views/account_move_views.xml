<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_platform_billing" model="ir.ui.view">
        <field name="name">account.move.form.platform.billing</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other_info']//group" position="inside">
                <group string="Platform Billing"
                       invisible="not platform_billing_session_id">
                    <field name="platform_billing_session_id" readonly="1"/>
                    <field name="platform_billing_platform_id" readonly="1"/>
                    <field name="platform_billing_payout_ids" widget="many2many_tags" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_move_list_platform_billing" model="ir.ui.view">
        <field name="name">account.move.list.platform.billing</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list string="Platform Billing Journal Entries" create="false" edit="false">
                <field name="move_type"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="invoice_date"/>
                <field name="currency_id"/>
                <field name="amount_total"/>
                <field name="amount_residual"/>
                <field name="state" widget="badge"/>
                <field name="payment_state" widget="badge"/>
                <field name="platform_billing_platform_id"/>
                <field name="platform_billing_payout_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="action_platform_billing_moves" model="ir.actions.act_window">
        <field name="name">Platform Billing Journal Entries</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_move_list_platform_billing"/>
        <field name="domain">[('platform_billing_session_id', '!=', False)]</field>
    </record>
</odoo>
