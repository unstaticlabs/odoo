<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_platform_billing_post_confirm_wizard_form" model="ir.ui.view">
        <field name="name">usl.platform.billing.post.confirm.wizard.form</field>
        <field name="model">usl.platform.billing.post.confirm.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm Incomplete Platform Coverage">
                <div class="alert alert-warning" role="alert">
                    <field name="warning_message" nolabel="1" readonly="1"/>
                </div>
                <group>
                    <field name="session_id"/>
                    <field name="missing_platform_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Post Anyway"
                            type="object" class="btn-primary"/>
                    <button string="Go Back" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
