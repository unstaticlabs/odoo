<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_b2c_import_row_search" model="ir.ui.view">
        <field name="name">b2c.import.row.search</field>
        <field name="model">b2c.import.row</field>
        <field name="arch" type="xml">
            <search>
                <field name="external_order_id"/>
                <field name="external_line_id"/>
                <field name="order_id"/>
                <filter name="new" string="New" domain="[('resolution', '=', 'new')]"/>
                <filter name="known" string="Already in Odoo" domain="[('resolution', '=', 'known')]"/>
                <filter name="conflicting" string="Conflicting" domain="[('resolution', '=', 'conflicting')]"/>
                <group>
                    <filter name="group_resolution" string="Resolution" context="{'group_by': 'resolution'}"/>
                    <filter name="group_provider" string="Channel" context="{'group_by': 'provider'}"/>
                    <filter name="group_grain" string="Grain" context="{'group_by': 'grain'}"/>
                    <filter name="group_format" string="Export" context="{'group_by': 'format_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_b2c_import_row_list" model="ir.ui.view">
        <field name="name">b2c.import.row.list</field>
        <field name="model">b2c.import.row</field>
        <field name="arch" type="xml">
            <list decoration-success="resolution == 'new'" decoration-muted="resolution == 'known'"
                  decoration-danger="resolution in ('conflicting', 'orphan_line')">
                <field name="occurred_at"/>
                <field name="provider"/>
                <field name="grain"/>
                <field name="external_order_id"/>
                <field name="external_line_id" optional="show"/>
                <field name="format_id" optional="hide"/>
                <field name="resolution" widget="badge"/>
                <field name="order_id" optional="show"/>
                <field name="note" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_b2c_import_row" model="ir.actions.act_window">
        <field name="name">Imported Rows</field>
        <field name="res_model">b2c.import.row</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_b2c_import_row_search"/>
    </record>
</odoo>
