<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="rule_b2c_import_batch_company" model="ir.rule">
        <field name="name">B2C import batches: allowed companies</field>
        <field name="model_id" ref="model_b2c_import_batch"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_b2c_oss_return_company" model="ir.rule">
        <field name="name">B2C destination VAT returns: allowed companies</field>
        <field name="model_id" ref="model_b2c_oss_return"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_b2c_oss_return_line_company" model="ir.rule">
        <field name="name">B2C destination VAT return lines: allowed companies</field>
        <field name="model_id" ref="model_b2c_oss_return_line"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_b2c_supply_settlement_company" model="ir.rule">
        <field name="name">B2C supplier settlements: allowed companies</field>
        <field name="model_id" ref="model_b2c_supply_settlement"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
