+func TestClientCanDisableRefreshTokens(t *testing.T) {
+	client := Client{OidcClient: model.OidcClient{DisableRefreshTokens: true}}
+	require.NotContains(t, client.GetGrantTypes(), string(fosite.GrantTypeRefreshToken))
+	require.NotContains(t, client.GetScopes(), "offline_access")
+
+	client.DisableRefreshTokens = false
+	require.Contains(t, client.GetGrantTypes(), string(fosite.GrantTypeRefreshToken))
+	require.Contains(t, client.GetScopes(), "offline_access")
+}
+
