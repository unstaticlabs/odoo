diff --git a/backend/internal/oidc/fresh_passkey_usl_test.go b/backend/internal/oidc/fresh_passkey_usl_test.go
new file mode 100644
index 0000000..f1b207d
--- /dev/null
+++ b/backend/internal/oidc/fresh_passkey_usl_test.go
@@ -0,0 +1,180 @@
+package oidc
+
+// Tests for the USL fresh-passkey patch: clients listed in
+// USL_FRESH_PASSKEY_CLIENT_IDS must be authorized right after a passkey.
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/pocket-id/fosite"
+	"github.com/stretchr/testify/require"
+	"gorm.io/gorm"
+
+	"github.com/pocket-id/pocket-id/backend/internal/appconfig"
+	"github.com/pocket-id/pocket-id/backend/internal/apperror"
+	"github.com/pocket-id/pocket-id/backend/internal/common"
+	"github.com/pocket-id/pocket-id/backend/internal/model"
+	datatype "github.com/pocket-id/pocket-id/backend/internal/model/types"
+	testutils "github.com/pocket-id/pocket-id/backend/internal/utils/testing"
+)
+
+const freshPasskeyClientID = "usl-sign-authorization"
+
+func withFreshPasskeyClients(t *testing.T, ids string) {
+	t.Helper()
+	previous := common.EnvConfig.FreshPasskeyClientIDs
+	common.EnvConfig.FreshPasskeyClientIDs = ids
+	t.Cleanup(func() { common.EnvConfig.FreshPasskeyClientIDs = previous })
+}
+
+type trackingReauthenticationConsumer struct {
+	called bool
+	when   time.Time
+}
+
+func (f *trackingReauthenticationConsumer) ConsumeReauthenticationToken(_ context.Context, _ *gorm.DB, _ string, _ string) (time.Time, error) {
+	f.called = true
+	return f.when, nil
+}
+
+func TestFreshPasskeyClientIsConfiguredByEnvironment(t *testing.T) {
+	withFreshPasskeyClients(t, " other , "+freshPasskeyClientID)
+
+	require.True(t, model.OidcClient{Base: model.Base{ID: freshPasskeyClientID}}.RequiresFreshPasskey())
+	require.False(t, model.OidcClient{Base: model.Base{ID: "tailscale"}}.RequiresFreshPasskey())
+	require.False(t, model.OidcClient{}.RequiresFreshPasskey())
+}
+
+func TestFreshPasskeyClientOnlyAllowsAuthorizationCode(t *testing.T) {
+	withFreshPasskeyClients(t, freshPasskeyClientID)
+
+	strict := Client{OidcClient: model.OidcClient{Base: model.Base{ID: freshPasskeyClientID}}}
+	require.Equal(t, fosite.Arguments{string(fosite.GrantTypeAuthorizationCode)}, strict.GetGrantTypes())
+	require.NotContains(t, strict.GetScopes(), "offline_access")
+
+	// Every other client keeps upstream behaviour
+	regular := Client{OidcClient: model.OidcClient{Base: model.Base{ID: "regular"}}}
+	require.Contains(t, regular.GetGrantTypes(), string(fosite.GrantTypeRefreshToken))
+	require.Contains(t, regular.GetScopes(), "offline_access")
+}
+
+func TestFreshPasskeyReauthenticationStepRejectsSessionProof(t *testing.T) {
+	withFreshPasskeyClients(t, freshPasskeyClientID)
+	db := testutils.NewDatabaseForTest(t)
+	consumer := &trackingReauthenticationConsumer{when: time.Now().UTC()}
+	service := newAuthorizationService(db, newInteractionSessionService(db), newClaimsService(db, nil, "", nil, appconfig.StaticResolver{}), consumer, nil, nil)
+	userID := "fresh-passkey-user"
+	interaction := &InteractionSession{
+		UserID:                   &userID,
+		ReauthenticationRequired: true,
+		Client:                   model.OidcClient{Base: model.Base{ID: freshPasskeyClientID}},
+	}
+
+	err := service.completeReauthenticationStep(t.Context(), interaction, userID, "session.recent-login")
+	require.Error(t, err)
+	require.True(t, apperror.IsCode(err, apperror.CodeReauthenticationRequired))
+	require.False(t, consumer.called)
+	require.True(t, interaction.ReauthenticationRequired)
+
+	err = service.completeReauthenticationStep(t.Context(), interaction, userID, "phr.credential-backed")
+	require.NoError(t, err)
+	require.True(t, consumer.called)
+	require.False(t, interaction.ReauthenticationRequired)
+}
+
+func TestFreshPasskeyClientAlwaysRequiresReauthentication(t *testing.T) {
+	withFreshPasskeyClients(t, freshPasskeyClientID)
+	db := testutils.NewDatabaseForTest(t)
+	service := newAuthorizationService(db, newInteractionSessionService(db), newClaimsService(db, nil, "", nil, appconfig.StaticResolver{}), nil, nil, nil)
+	const userID = "fresh-passkey-user"
+	require.NoError(t, db.Create(&model.User{Base: model.Base{ID: userID}}).Error)
+	require.NoError(t, db.Create(&model.OidcClient{Base: model.Base{ID: freshPasskeyClientID}, Name: "USL Sign"}).Error)
+	require.NoError(t, db.Create(&model.UserAuthorizedOidcClient{
+		UserID: userID, ClientID: freshPasskeyClientID, Scope: datatype.StringList{"openid"},
+	}).Error)
+
+	// A login one second ago, already consented: upstream would authorize silently
+	authorization, err := service.authorize(t.Context(), authorizeInput{
+		userID:             userID,
+		authenticationTime: time.Now().Add(-time.Second).UTC(),
+		requester:          newTestAuthorizeRequester("fresh-passkey-request", freshPasskeyClientID, ""),
+	})
+	require.NoError(t, err)
+	require.True(t, authorization.RequiresInteraction)
+
+	interaction, err := service.getInteractionSession(t.Context(), authorization.InteractionID)
+	require.NoError(t, err)
+	require.Equal(t, interactionStepReauthenticate, interaction.CurrentStep)
+}
+
+func TestFreshPasskeySessionReportsPhishingResistantMethod(t *testing.T) {
+	withFreshPasskeyClients(t, freshPasskeyClientID)
+	service := &authorizationService{}
+	reauthenticatedAt := datatype.DateTime(time.Now().UTC())
+	request := func(clientID string) authorizeRequest {
+		return authorizeRequest{
+			authorizeInput: authorizeInput{
+				userID:               "u",
+				authenticationMethod: "otp",
+				requester:            newTestAuthorizeRequester("amr-request", clientID, ""),
+			},
+			client: Client{OidcClient: model.OidcClient{Base: model.Base{ID: clientID}}},
+			now:    time.Now().UTC(),
+		}
+	}
+
+	strict := &InteractionSession{Client: model.OidcClient{Base: model.Base{ID: freshPasskeyClientID}}, ReauthenticatedAt: &reauthenticatedAt}
+	session := service.buildAuthorizedSession(request(freshPasskeyClientID), strict, time.Now().UTC())
+	require.Equal(t, "phr", session.AuthenticationMethod)
+
+	regular := &InteractionSession{Client: model.OidcClient{Base: model.Base{ID: "regular"}}, ReauthenticatedAt: &reauthenticatedAt}
+	session = service.buildAuthorizedSession(request("regular"), regular, time.Now().UTC())
+	require.Equal(t, "otp", session.AuthenticationMethod)
+}
+
+func TestFreshPasskeyAuthorizeIgnoresSessionProofCookie(t *testing.T) {
+	withFreshPasskeyClients(t, freshPasskeyClientID)
+
+	authorizeWith := func(t *testing.T, token string) (authorizationResult, *trackingReauthenticationConsumer) {
+		t.Helper()
+		db := testutils.NewDatabaseForTest(t)
+		consumer := &trackingReauthenticationConsumer{when: time.Now().UTC()}
+		service := newAuthorizationService(db, newInteractionSessionService(db), newClaimsService(db, nil, "", nil, appconfig.StaticResolver{}), consumer, nil, nil)
+		const userID = "fresh-passkey-user"
+		require.NoError(t, db.Create(&model.User{Base: model.Base{ID: userID}}).Error)
+		require.NoError(t, db.Create(&model.OidcClient{Base: model.Base{ID: freshPasskeyClientID}, Name: "USL Sign"}).Error)
+		require.NoError(t, db.Create(&model.UserAuthorizedOidcClient{
+			UserID: userID, ClientID: freshPasskeyClientID, Scope: datatype.StringList{"openid"},
+		}).Error)
+		authorization, err := service.authorize(t.Context(), authorizeInput{
+			userID:                userID,
+			authenticationTime:    time.Now().Add(-time.Second).UTC(),
+			requester:             newTestAuthorizeRequester("cookie-request", freshPasskeyClientID, ""),
+			reauthenticationToken: token,
+		})
+		require.NoError(t, err)
+		return authorization, consumer
+	}
+
+	// A session proof in the cookie must neither be consumed nor clear reauthentication
+	authorization, consumer := authorizeWith(t, "session.recent-login")
+	require.True(t, authorization.RequiresInteraction)
+	require.False(t, consumer.called)
+
+	// A passkey proof completes the authorization directly
+	authorization, consumer = authorizeWith(t, "phr.credential-backed")
+	require.False(t, authorization.RequiresInteraction)
+	require.True(t, consumer.called)
+	require.Equal(t, "phr", authorization.Session.AuthenticationMethod)
+}
+
+func TestDiscoveryAdvertisesFreshPasskeyOnlyWhenConfigured(t *testing.T) {
+	withFreshPasskeyClients(t, "")
+	require.False(t, common.HasFreshPasskeyClients())
+	withFreshPasskeyClients(t, " , ")
+	require.False(t, common.HasFreshPasskeyClients())
+	withFreshPasskeyClients(t, freshPasskeyClientID)
+	require.True(t, common.HasFreshPasskeyClients())
+}
