@@ -0,0 +1,21 @@
+package common
+
+import "strings"
+
+// IsFreshPasskeyClient reports whether the client ID is listed in USL_FRESH_PASSKEY_CLIENT_IDS
+func IsFreshPasskeyClient(clientID string) bool {
+	if clientID == "" {
+		return false
+	}
+	for _, listed := range strings.Split(EnvConfig.FreshPasskeyClientIDs, ",") {
+		if strings.TrimSpace(listed) == clientID {
+			return true
+		}
+	}
+	return false
+}
+
+// HasFreshPasskeyClients reports whether any client is configured, so discovery only advertises enforcement that exists
+func HasFreshPasskeyClients() bool {
+	return strings.Trim(EnvConfig.FreshPasskeyClientIDs, ", ") != ""
+}
