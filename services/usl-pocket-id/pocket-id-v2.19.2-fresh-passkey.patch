@@ -0,0 +1,39 @@
+package webauthn
+
+// Tests for the USL fresh-passkey patch: a reauthentication token records the
+// proof that minted it, and only a WebAuthn assertion yields a "phr." token.
+
+import (
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/pocket-id/pocket-id/backend/internal/model"
+	testutils "github.com/pocket-id/pocket-id/backend/internal/utils/testing"
+)
+
+func TestReauthenticationTokenRecordsItsProof(t *testing.T) {
+	db := testutils.NewDatabaseForTest(t)
+	user := model.User{Base: model.Base{ID: "reauth-user"}, Username: "reauth-user"}
+	require.NoError(t, db.Create(&user).Error)
+	signer := newFakeSigner()
+	service := &Service{db: db, signer: signer}
+
+	// A recent passkey login session is not a fresh passkey assertion
+	accessToken, err := signer.GenerateAccessToken(user, authenticationMethodPhishingResistant, time.Hour)
+	require.NoError(t, err)
+	sessionToken, err := service.CreateReauthenticationTokenWithAccessToken(t.Context(), accessToken)
+	require.NoError(t, err)
+	require.True(t, strings.HasPrefix(sessionToken, "session."), sessionToken)
+
+	passkeyToken, err := service.createReauthenticationToken(t.Context(), db, user.ID, authenticationMethodPhishingResistant)
+	require.NoError(t, err)
+	require.True(t, strings.HasPrefix(passkeyToken, "phr."), passkeyToken)
+
+	// The prefixed value is what the consumer receives back, so it must round-trip
+	consumedAt, err := service.ConsumeReauthenticationToken(t.Context(), db, passkeyToken, user.ID)
+	require.NoError(t, err)
+	require.False(t, consumedAt.IsZero())
+}
