diff --git a/backend/internal/oidc/authorization_service_test.go b/backend/internal/oidc/authorization_service_test.go
index ddf0826..9cabb94 100644
--- a/backend/internal/oidc/authorization_service_test.go
+++ b/backend/internal/oidc/authorization_service_test.go
@@ -23,0 +24,32 @@ type fakeAuditLogger struct {
+type trackingReauthenticationConsumer struct {
+	called bool
+	when   time.Time
+}
+
+func (f *trackingReauthenticationConsumer) ConsumeReauthenticationToken(_ context.Context, _ *gorm.DB, _ string, _ string) (time.Time, error) {
+	f.called = true
+	return f.when, nil
+}
+
+func TestStrictFreshPasskeyRejectsSessionProof(t *testing.T) {
+	db := testutils.NewDatabaseForTest(t)
+	consumer := &trackingReauthenticationConsumer{when: time.Now().UTC()}
+	service := newAuthorizationService(db, newInteractionSessionService(db), newClaimsService(db, nil, "", nil), consumer, nil, nil)
+	userID := "fresh-passkey-user"
+	interaction := &InteractionSession{
+		UserID:                   &userID,
+		ReauthenticationRequired: true,
+		Client:                   model.OidcClient{RequiresFreshPasskey: true},
+	}
+
+	err := service.completeReauthenticationStep(t.Context(), interaction, userID, "session.recent-login")
+	require.Error(t, err)
+	require.ErrorAs(t, err, new(*common.ReauthenticationRequiredError))
+	require.False(t, consumer.called)
+
+	err = service.completeReauthenticationStep(t.Context(), interaction, userID, "phr.credential-backed")
+	require.NoError(t, err)
+	require.True(t, consumer.called)
+	require.False(t, interaction.ReauthenticationRequired)
+}
+
@@ -878,0 +911,31 @@ func TestAuthorizationServiceAuthorizeRequiresReauthenticationWhenMaxAgeExceeded
+func TestStrictFreshPasskeyCountsAnInitialLoginOnce(t *testing.T) {
+	db := testutils.NewDatabaseForTest(t)
+	service := newAuthorizationService(db, newInteractionSessionService(db), newClaimsService(db, nil, "", nil), nil, nil, nil)
+
+	const (
+		userID   = "fresh-passkey-user"
+		clientID = "fresh-passkey-client"
+	)
+	requestedAt := time.Now().Add(-2 * time.Second).UTC()
+	require.NoError(t, db.Create(&model.User{Base: model.Base{ID: userID}}).Error)
+	require.NoError(t, db.Create(&model.OidcClient{Base: model.Base{ID: clientID}, Name: "Fresh passkey client"}).Error)
+	require.NoError(t, db.Create(&model.UserAuthorizedOidcClient{
+		UserID: userID, ClientID: clientID, Scope: datatype.StringList{"openid"},
+	}).Error)
+
+	interaction := &InteractionSession{
+		Scopes:      datatype.StringList{"openid"},
+		ClientID:    clientID,
+		Client:      model.OidcClient{Base: model.Base{ID: clientID}, RequiresFreshPasskey: true},
+		RequestedAt: datatype.DateTime(requestedAt),
+		Parameters:  map[string]string{},
+	}
+	fresh, err := service.interactionRequirementsForUser(t.Context(), userID, interaction, requestedAt.Add(time.Second))
+	require.NoError(t, err)
+	require.False(t, fresh.ReauthenticationRequired)
+
+	stale, err := service.interactionRequirementsForUser(t.Context(), userID, interaction, requestedAt.Add(-time.Second))
+	require.NoError(t, err)
+	require.True(t, stale.ReauthenticationRequired)
+}
